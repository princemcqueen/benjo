	Golden = { Main = C(222, 186, 76), Dark = C(170, 127, 46), Belly = C(255, 236, 160), Membrane = C(245, 205, 47), Horn = C(255, 248, 220), Accent = C(255, 220, 120), Eye = C(255, 255, 230), Saddle = C(123, 46, 47) },
