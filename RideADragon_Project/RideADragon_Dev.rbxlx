		{ 98.16, 29.77, 13.82, 0 },
		{ 134.55, 30.14, 1.34, 0 },
		{ 165.4, 30.55, 24.31, 0 },
		{ 201.79, 31.18, 11.83, 0 },
		{ 232.34, 31.64, 35.23, 0 },
