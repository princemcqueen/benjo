			<Item class="ModuleScript" referent="RBX000035">
				<Properties>
					<string name="Name">GameConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	GameConfig
	Global tuning: movement curves, riding physics, camera, ranges, saving.
	All riding/camera numbers live here so feel can be tuned in one place.
]]

local GameConfig = {}

GameConfig.Version = "1.0.0"
GameConfig.DataStoreName = "RideADragon_PlayerData_v1"
GameConfig.AutosaveInterval = 90
GameConfig.SessionLockTimeout = 30 * 60

-- Movement speed curves (studs/second) from the UI power stats.
GameConfig.Movement = {
	WalkSpeed = 17,
	RunBase = 34,
	RunPerLog = 10,
	RunCap = 110,
	FlightBase = 60,
	FlightPerLog = 32,
	FlightCap = 300,
	BoostMultiplier = 1.6,
}

function GameConfig.groundRunSpeed(speedStat: number): number
	local m = GameConfig.Movement
	return math.min(m.RunCap, m.RunBase + m.RunPerLog * math.log10(1 + math.max(0, speedStat) / 40))
end

function GameConfig.flightCruiseSpeed(flightStat: number): number
	local m = GameConfig.Movement
	return math.min(m.FlightCap, m.FlightBase + m.FlightPerLog * math.log10(1 + math.max(0, flightStat) / 60))
end

-- Riding physics. Distances are for scale 1 (Green Drake) and are multiplied
-- by the species Scale where it makes sense (hip height, clearances).
GameConfig.Riding = {
	Gravity = 115,
	JumpVelocity = 44,
	CrouchTime = 0.16,
	TakeoffHoldTime = 0.2,
	TakeoffLiftVelocity = 58,
	TakeoffDuration = 0.65,

	GroundAccel = 55,
	GroundDecel = 70,
	GroundTurnRate = 3.4, -- rad/s at low speed
	GroundTurnRateFast = 2.1, -- rad/s at full run
	GroundTurnResponse = 9, -- how quickly turn rate itself ramps (damping)
	SlopeAlignRate = 7,
	HoverHeightOverWater = 0.5,

	AirAccel = 42,
	AirBrake = 70,
	AirTurnResponse = 3.2, -- heading follows desired heading (exp rate)
	AirMaxYawRate = 1.9, -- rad/s
	VerticalSpeed = 38, -- ascend/descend studs/s
	VerticalAccel = 6, -- response rate
	HoverDrag = 2.2,
	DiveAccel = 60,
	ClimbPenalty = 0.35,
	MaxPitch = math.rad(55),
	MaxBank = math.rad(48),
	BankResponse = 5.5,
	PitchResponse = 5,
	Ceiling = 1500,
	SoftCeilingBand = 120,

	BoostDuration = 5,
	BoostRegenPerSecond = 0.22, -- fraction of full meter per second when not boosting
	BoostMinToStart = 0.15,

	LandingStartHeight = 16,
	TouchdownHeight = 1.2,
	LandingDuration = 0.42,
	AutoLandMaxSpeed = 70,
}

GameConfig.Camera = {
	BaseFOV = 70,
	BoostFOV = 82,
	SpeedFOVBonus = 4, -- extra FOV at max cruise (without boost)
	FOVRate = 4,
	DistanceGround = 24, -- at scale 1
	DistanceAir = 28,
	DistanceSpeedBonus = 5,
	MinZoom = 0.55,
	MaxZoom = 1.9,
	HeightOffset = 7.5,
	LookAheadAir = 3.5,
	LagCompensation = 0.85, -- fraction of the focus spring's steady-state lag removed
	PositionFrequency = 5.2, -- spring Hz for the focus point
	ZoomFrequency = 2.6,
	CollisionPullIn = 22, -- fast when pulling in (avoid clipping)
	CollisionPushOut = 3.5, -- slow when easing back out
	CollisionRadius = 1.4,
	MouseSensitivity = 0.0042,
	GamepadSensitivity = 3.2,
	TouchSensitivity = 0.0065,
	PitchMin = math.rad(-70),
	PitchMax = math.rad(60),
	AutoAlignDelay = 1.4,
	AutoAlignRate = 1.6,
	BankRoll = 0.14, -- fraction of dragon bank applied to the camera
}

GameConfig.Interaction = {
	EggPickupRange = 18, -- client prompt range (studs)
	EggPickupServerRange = 34, -- server validation range (includes dragon size slack)
	NestRange = 22,
	NestServerRange = 40,
	CollectorRange = 16,
}

-- Sanctuary display dragons (resting on perches)
GameConfig.Sanctuary = {
	PerchScale = 0.62, -- display size relative to the riding size
	ViewDistance = 620, -- perch dragons are built within this camera distance
	ViewDistanceLow = 260, -- on the Low graphics preset
	NameplateDistance = 110,
	PromptRange = 16,
}

GameConfig.StarterCash = 250

return table.freeze(GameConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000036">
				<Properties>
					<string name="Name">HatchConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	HatchConfig
	Timing of the hatching cinematic and the server-wide announcements for
	ultra-rare hatches. The result itself is always decided by the server
	(EggService); the cinematic only plays it.
]]

local HatchConfig = {}

-- A hatch whose "1 in N" odds reach MinOdds is announced to every player on the
-- server; from Mega on the banner is bigger and louder.
HatchConfig.Announce = {
	MinOdds = 25000,
	Mega = 1000000,
	BannerSeconds = 7,
	MegaBannerSeconds = 10,
	-- the banner waits for the hatcher's reveal (the cinematic runs ~9 s) so nobody is spoiled
	Delay = 8.5,
}

-- Cinematic beats in seconds. Rare results (high rarity or rare "1 in N") get a
-- longer charge and extra cracks - the same egg always feels the same, the reveal
-- grows with what is inside.
HatchConfig.Cinematic = {
	Approach = 0.8, -- camera glides to the egg
	Charge = 2.3, -- cracks appear, the roll strip spins
	ChargeRare = 3.4,
	Cracks = 4,
	CracksRare = 6,
	Walk = 2.6, -- the dragon walks towards the camera
	Roar = 1.7,
	SkipAfter = 0.5, -- the SKIP button appears after this long
}

-- A result is "rare" for the cinematic when the dragon's rarity rank is at least
-- RareRank (Epic) or its odds reach RareOdds.
HatchConfig.RareRank = 4
HatchConfig.RareOdds = 2500

return table.freeze(HatchConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000037">
				<Properties>
					<string name="Name">LeaderboardConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	LeaderboardConfig
	Global top-10 boards shown in the hub plaza (and the Teleport menu's
	"Spawn" destination looks straight at them).

	Board.Stat: which player value is ranked
	  Earned   - lifetime cash earned (data.TotalEarned)
	  Hatched  - eggs hatched (data.Stats.Hatched)
	  Income   - current sanctuary income per second (live)
	  PlayTime - seconds played (data.Stats.PlayTime)
	Board.Format: how values are printed (Cash, Count, PerSecond, Time)
]]

local LeaderboardConfig = {}

LeaderboardConfig.Boards = {
	{
		Id = "Earned",
		Title = "TOP EARNERS",
		Subtitle = "Total cash earned",
		Stat = "Earned",
		Format = "Cash",
		Color = Color3.fromRGB(255, 196, 48),
		Dark = Color3.fromRGB(150, 96, 10),
		Store = "LB_Earned_v1",
	},
	{
		Id = "Hatched",
		Title = "TOP HATCHERS",
		Subtitle = "Eggs hatched",
		Stat = "Hatched",
		Format = "Count",
		Color = Color3.fromRGB(110, 208, 104),
		Dark = Color3.fromRGB(32, 110, 46),
		Store = "LB_Hatched_v1",
	},
	{
		Id = "Income",
		Title = "RICHEST SANCTUARIES",
		Subtitle = "Income per second",
		Stat = "Income",
		Format = "PerSecond",
		Color = Color3.fromRGB(77, 163, 255),
		Dark = Color3.fromRGB(20, 70, 150),
		Store = "LB_Income_v1",
	},
	{
		Id = "PlayTime",
		Title = "MOST DEDICATED",
		Subtitle = "Time played",
		Stat = "PlayTime",
		Format = "Time",
		Color = Color3.fromRGB(190, 120, 255),
		Dark = Color3.fromRGB(86, 40, 150),
		Store = "LB_PlayTime_v1",
	},
}

LeaderboardConfig.TopCount = 10
LeaderboardConfig.RefreshSeconds = 60 -- read the global tops
LeaderboardConfig.WriteSeconds = 120 -- write each player's values
LeaderboardConfig.PlayTimeTick = 30 -- seconds added to PlayTime per tick

-- Plaza placement: angles (degrees, 0 = north/-Z, 90 = east) on a ring
-- around the hub centre; each board faces the centre. The south road
-- (between 160 and 200 degrees) stays open.
LeaderboardConfig.Ring = 54
LeaderboardConfig.Angles = { 222, 196, 164, 138 }
-- Teleport "Spawn" arrival: south of the statue, looking at the boards.
LeaderboardConfig.Arrival = Vector3.new(0, 0, 28)

return table.freeze(LeaderboardConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000038">
				<Properties>
					<string name="Name">MonetizationConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	MonetizationConfig
	Robux items. Create each one on create.roblox.com (your experience ->
	Monetization -> Passes / Developer Products) with the same price, then
	paste its ID here. Id = 0 means "not created yet": in Studio the BUY
	button then grants the item as a free TEST purchase so everything can be
	tried; in a live game it shows "coming soon".

	GamePasses: bought once, owned forever.
	Products:   consumables (potions, cash packs), bought any number of times.
]]

local MonetizationConfig = {}

MonetizationConfig.GamePasses = {
	OwnerDragon = {
		Id = 0,
		Price = 3000,
		Name = "Owner Dragon",
		Description = "The strongest dragon in the game + x2 LUCK forever on every roll (eggs and the Spin Wheel).",
		Icon = "Dragon",
		Grants = "OwnerDragon", -- species added to the collection
		Luck = 2, -- permanent luck multiplier while owned
		Perks = { "x2 LUCK on every roll, forever", "Fastest & strongest dragon", "EXCLUSIVE rarity + golden aura", "$1B per second on a perch" },
		Featured = true,
		Order = 3,
	},
	PrinceDragon = {
		Id = 0,
		Price = 8999,
		Name = "PRINCE",
		Description = "The strongest dragon in the game: every mutation at once and x3 LUCK forever.",
		Icon = "Trophy",
		Grants = "PrinceDragon",
		Mutation = "Omni",
		Luck = 3,
		Perks = { "x3 LUCK on every roll, forever", "ALL MUTATIONS at once (Omni x25)", "$10T per second on a perch", "Royal halo, crown and golden aura" },
		Featured = true,
		Order = 1,
	},
	N2RC1SDragon = {
		Id = 0,
		Price = 8999,
		Name = "N2RC1S",
		Description = "The strongest dragon in the game: every mutation at once and x3 LUCK forever.",
		Icon = "Star",
		Grants = "N2RC1SDragon",
		Mutation = "Omni",
		Luck = 3,
		Perks = { "x3 LUCK on every roll, forever", "ALL MUTATIONS at once (Omni x25)", "$10T per second on a perch", "Crystal crown, stars and neon aura" },
		Featured = true,
		Order = 2,
	},
}

-- Featured passes in shop order.
function MonetizationConfig.passOrder(): { string }
	local list = {}
	for id in MonetizationConfig.GamePasses do
		table.insert(list, id)
	end
	table.sort(list, function(a, b)
		return (MonetizationConfig.GamePasses[a].Order or 99) < (MonetizationConfig.GamePasses[b].Order or 99)
	end)
	return list
end

-- Is a pass owned according to replicated/saved data?
function MonetizationConfig.ownsPass(data, itemId: string): boolean
	local flags = data and data.Flags
	if not flags then
		return false
	end
	if itemId == "OwnerDragon" and flags.OwnerPass == true then
		return true
	end
	return type(flags.Passes) == "table" and flags.Passes[itemId] == true
end

-- Product of the luck multipliers of every owned pass.
function MonetizationConfig.passLuck(data): number
	local m = 1
	for id, pass in MonetizationConfig.GamePasses do
		if pass.Luck and MonetizationConfig.ownsPass(data, id) then
			m *= pass.Luck
		end
	end
	return m
end

MonetizationConfig.Products = {
	LuckPotion = {
		Id = 0,
		Price = 49,
		Name = "Luck Potion",
		Description = "x2 luck on egg rolls for 15 minutes.",
		Icon = "Clover",
		Kind = "Boost",
		Boost = "Luck",
		Seconds = 15 * 60,
		Color = Color3.fromRGB(110, 208, 104),
	},
	SuperLuckPotion = {
		Id = 0,
		Price = 149,
		Name = "Super Luck Potion",
		Description = "x3 luck on egg rolls for 30 minutes.",
		Icon = "Star",
		Kind = "Boost",
		Boost = "SuperLuck",
		Seconds = 30 * 60,
		Color = Color3.fromRGB(64, 236, 214),
	},
	CashPotion = {
		Id = 0,
		Price = 49,
		Name = "Cash Potion",
		Description = "x2 income from your sanctuary for 15 minutes.",
		Icon = "Coin",
		Kind = "Boost",
		Boost = "Cash",
		Seconds = 15 * 60,
		Color = Color3.fromRGB(255, 196, 48),
	},
	LevelPotion = {
		Id = 0,
		Price = 39,
		Name = "Level Potion",
		Description = "+5 levels for the dragon you have equipped.",
		Icon = "Ascend",
		Kind = "DragonLevel",
		Levels = 5,
		Color = Color3.fromRGB(77, 163, 255),
	},
	MutationPotion = {
		Id = 0,
		Price = 99,
		Name = "Mutation Potion",
		Description = "Upgrades the mutation of your equipped dragon (always better).",
		Icon = "Sparkle",
		Kind = "DragonMutation",
		Color = Color3.fromRGB(190, 120, 255),
	},
	SpinPack = {
		Id = 0,
		Price = 49,
		Name = "5 Spins",
		Description = "+5 spins for the wheel on Spin Island.",
		Icon = "Star",
		Kind = "Spins",
		Count = 5,
		Color = Color3.fromRGB(255, 110, 190),
	},
	SpinPackBig = {
		Id = 0,
		Price = 199,
		Name = "25 Spins",
		Description = "+25 spins for the wheel on Spin Island.",
		Icon = "Gift",
		Kind = "Spins",
		Count = 25,
		Color = Color3.fromRGB(255, 70, 150),
	},
	CashPackSmall = {
		Id = 0,
		Price = 25,
		Name = "Pouch of Cash",
		Description = "30 minutes of your income (at least $5K).",
		Icon = "Coin",
		Kind = "Cash",
		IncomeSeconds = 30 * 60,
		Minimum = 5000,
		Color = Color3.fromRGB(255, 196, 48),
	},
	CashPackMedium = {
		Id = 0,
		Price = 99,
		Name = "Chest of Cash",
		Description = "3 hours of your income (at least $50K).",
		Icon = "Chest",
		Kind = "Cash",
		IncomeSeconds = 3 * 3600,
		Minimum = 50000,
		Color = Color3.fromRGB(255, 160, 40),
	},
	CashPackLarge = {
		Id = 0,
		Price = 249,
		Name = "Vault of Cash",
		Description = "12 hours of your income (at least $250K).",
		Icon = "Trophy",
		Kind = "Cash",
		IncomeSeconds = 12 * 3600,
		Minimum = 250000,
		Color = Color3.fromRGB(255, 120, 40),
	},
}

-- Shop order (ROBUX tab)
MonetizationConfig.ProductOrder = {
	"LuckPotion",
	"SuperLuckPotion",
	"CashPotion",
	"LevelPotion",
	"MutationPotion",
	"SpinPack",
	"SpinPackBig",
	"CashPackSmall",
	"CashPackMedium",
	"CashPackLarge",
}

-- Boosts (timed): luck multipliers stack by multiplying.
MonetizationConfig.Boosts = {
	Luck = { Name = "x2 LUCK", Luck = 2, Color = Color3.fromRGB(110, 208, 104), Icon = "Clover" },
	SuperLuck = { Name = "x3 LUCK", Luck = 3, Color = Color3.fromRGB(64, 236, 214), Icon = "Star" },
	Cash = { Name = "x2 CASH", Cash = 2, Color = Color3.fromRGB(255, 196, 48), Icon = "Coin" },
}

function MonetizationConfig.find(itemId: string)
	local pass = MonetizationConfig.GamePasses[itemId]
	if pass then
		return pass, "Pass"
	end
	local product = MonetizationConfig.Products[itemId]
	if product then
		return product, "Product"
	end
	return nil, nil
end

-- itemId for a developer product id / game pass id (receipts, prompts)
function MonetizationConfig.byProductId(id: number): string?
	if id == 0 then
		return nil
	end
	for itemId, p in MonetizationConfig.Products do
		if p.Id == id then
			return itemId
		end
	end
	return nil
end

function MonetizationConfig.byPassId(id: number): string?
	if id == 0 then
		return nil
	end
	for itemId, p in MonetizationConfig.GamePasses do
		if p.Id == id then
			return itemId
		end
	end
	return nil
end

return MonetizationConfig
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000039">
				<Properties>
					<string name="Name">MutationConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	MutationConfig
	Mutations multiply Speed/FlightSpeed/Income and really change how the dragon looks
	(palette, materials, particles, light, trails, halo - see BrickBuilder.MutationFx).

	Order is from common to rare; the rank of a mutation is its position in Order, so
	"better" always means "later". Rolling at hatch time goes through the list from the
	rarest down (EggService.rollMutation), the MUTATE action only ever improves.
]]

local MutationConfig = {}

MutationConfig.Order = {
	"None", "Shiny", "Neon", "Golden", "Frost", "Toxic", "Lava", "Infernal", "Shadow", "Corrupted",
	"Diamond", "Crystal", "Lightning", "Angelic", "Galaxy", "Rainbow", "Void", "Omni",
}

-- HatchChance: per hatch (rarest rolled first), shown to players as "1 in N" titles
-- (Shiny 1 in 20 ... Void 1 in 2,500,000). Multiplier: speed / flight speed / income.
-- Fx: visual effect family used by BrickBuilder (sparkle, glow, fire, smoke...).
-- Blurb: one line for the Index / inventory.
MutationConfig.Mutations = {
	None = { Rank = 0, Name = "Normal", Multiplier = 1, Color = Color3.fromRGB(150, 146, 136), HatchChance = 0, Blurb = "A dragon just as nature made it." },
	Shiny = { Rank = 1, Name = "Shiny", Multiplier = 1.5, Color = Color3.fromRGB(150, 230, 255), HatchChance = 0.05, Fx = "Sparkle", Blurb = "Sparkles all over." },
	Neon = { Rank = 2, Name = "Neon", Multiplier = 1.75, Color = Color3.fromRGB(80, 255, 230), HatchChance = 1 / 45, Fx = "Neon", Blurb = "Glows in electric colours and leaves a light trail." },
	Golden = { Rank = 3, Name = "Golden", Multiplier = 2, Color = Color3.fromRGB(255, 205, 80), HatchChance = 1 / 75, Fx = "Gold", Blurb = "Scales of shining gold." },
	Frost = { Rank = 4, Name = "Frost", Multiplier = 2.5, Color = Color3.fromRGB(150, 220, 255), HatchChance = 1 / 200, Fx = "Snow", Blurb = "Ice-blue skin and a swirl of snowflakes." },
	Toxic = { Rank = 5, Name = "Toxic", Multiplier = 3, Color = Color3.fromRGB(150, 255, 80), HatchChance = 1 / 500, Fx = "Toxic", Blurb = "Glowing green venom bubbles around it." },
	Lava = { Rank = 6, Name = "Lava", Multiplier = 4, Color = Color3.fromRGB(255, 120, 30), HatchChance = 1 / 1500, Fx = "Fire", Blurb = "Dark stone skin with molten cracks." },
	Infernal = { Rank = 7, Name = "Infernal", Multiplier = 4.5, Color = Color3.fromRGB(255, 70, 40), HatchChance = 1 / 3000, Fx = "Infernal", Blurb = "Burning red, shedding embers and hellfire." },
	Shadow = { Rank = 8, Name = "Shadow", Multiplier = 5, Color = Color3.fromRGB(170, 90, 255), HatchChance = 1 / 5000, Fx = "Smoke", Blurb = "Wrapped in violet shadow smoke." },
	Corrupted = { Rank = 9, Name = "Corrupted", Multiplier = 5.75, Color = Color3.fromRGB(255, 40, 140), HatchChance = 1 / 9000, Fx = "Glitch", Blurb = "Something is wrong with it: it flickers and glitches." },
	Diamond = { Rank = 10, Name = "Diamond", Multiplier = 6.5, Color = Color3.fromRGB(200, 245, 255), HatchChance = 1 / 20000, Fx = "Diamond", Blurb = "Brilliant white, hard as a diamond." },
	Crystal = { Rank = 11, Name = "Crystal", Multiplier = 7, Color = Color3.fromRGB(190, 140, 255), HatchChance = 1 / 35000, Fx = "Crystal", Blurb = "A body of living amethyst with crystal spikes." },
	Lightning = { Rank = 12, Name = "Lightning", Multiplier = 7.4, Color = Color3.fromRGB(255, 240, 90), HatchChance = 1 / 50000, Fx = "Zap", Blurb = "Crackling with electricity, wings trailing sparks." },
	Angelic = { Rank = 13, Name = "Angelic", Multiplier = 7.7, Color = Color3.fromRGB(255, 240, 200), HatchChance = 1 / 70000, Fx = "Holy", Blurb = "A glowing halo, white feathers and wings of light." },
	Galaxy = { Rank = 14, Name = "Galaxy", Multiplier = 8, Color = Color3.fromRGB(120, 140, 255), HatchChance = 1 / 100000, Fx = "Stars", Blurb = "A night sky wrapped around a dragon." },
	Rainbow = { Rank = 15, Name = "Rainbow", Multiplier = 10, Color = Color3.fromRGB(255, 120, 200), HatchChance = 1 / 500000, Fx = "Rainbow", Blurb = "Every colour at once." },
	Void = { Rank = 16, Name = "Void", Multiplier = 15, Color = Color3.fromRGB(190, 120, 255), HatchChance = 1 / 2500000, Fx = "Void", Blurb = "A hole in the world shaped like a dragon." },
	-- every mutation at once: only on the Robux exclusives (N2RC1S, PRINCE)
	Omni = { Rank = 17, Name = "Omni", Multiplier = 25, Color = Color3.fromRGB(255, 130, 230), HatchChance = 0, Fx = "Omni", Blurb = "All mutations at once." },
}

-- Weights used by the MUTATE action (a roll that can only improve the dragon).
MutationConfig.MutateWeights = {
	{ Id = "Shiny", Weight = 40 },
	{ Id = "Neon", Weight = 30 },
	{ Id = "Golden", Weight = 24 },
	{ Id = "Frost", Weight = 14 },
	{ Id = "Toxic", Weight = 9 },
	{ Id = "Lava", Weight = 6 },
	{ Id = "Infernal", Weight = 4.5 },
	{ Id = "Shadow", Weight = 3.5 },
	{ Id = "Corrupted", Weight = 2.6 },
	{ Id = "Diamond", Weight = 2 },
	{ Id = "Crystal", Weight = 1.5 },
	{ Id = "Lightning", Weight = 1.2 },
	{ Id = "Angelic", Weight = 1 },
	{ Id = "Galaxy", Weight = 0.8 },
	{ Id = "Rainbow", Weight = 0.4 },
	{ Id = "Void", Weight = 0.1 },
}

-- Cost of one mutation attempt: minutes of the dragon's own base income, scaled.
MutationConfig.CostIncomeMinutes = 12
MutationConfig.CostRankFactor = 0.6 -- each mutation rank already owned makes the next try pricier
MutationConfig.MinCost = 750
MutationConfig.MaxRank = MutationConfig.Mutations.Void.Rank -- the best mutation a roll / the MUTATE action can give

function MutationConfig.rank(id: string?): number
	local m = MutationConfig.Mutations[id or "None"]
	return m and m.Rank or 0
end

function MutationConfig.multiplier(id: string?): number
	local m = MutationConfig.Mutations[id or "None"]
	return m and m.Multiplier or 1
end

-- Price of one MUTATE attempt for a species base income and current mutation.
function MutationConfig.cost(baseIncome: number, current: string?): number
	local rank = MutationConfig.rank(current)
	local c = baseIncome * 60 * MutationConfig.CostIncomeMinutes * (1 + rank * MutationConfig.CostRankFactor)
	return math.max(MutationConfig.MinCost, math.floor(c + 0.5))
end

-- Chance that one attempt improves a dragon that currently has `current`.
function MutationConfig.improveChance(current: string?): number
	local rank = MutationConfig.rank(current)
	local total, better = 0, 0
	for _, e in MutationConfig.MutateWeights do
		total += e.Weight
		if MutationConfig.rank(e.Id) > rank then
			better += e.Weight
		end
	end
	return total > 0 and better / total or 0
end

return table.freeze(MutationConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000040">
				<Properties>
					<string name="Name">QuestConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	QuestConfig
	First-time tutorial steps and repeatable quest templates.
]]

local QuestConfig = {}

-- Tutorial: Step index -> definition. The server advances steps when the
-- matching event happens (see QuestService). Target kinds drive waypoints.
QuestConfig.Tutorial = {
	{ Id = "Ride", Text = "RIDE YOUR DRAGON", Hint = "Press R or tap RIDE", Target = "None" },
	{ Id = "ReachEgg", Text = "FLY TO THE GLOWING EGG", Hint = "SPACE to take off, SHIFT to boost", Target = "TutorialEgg" },
	{ Id = "PickUpEgg", Text = "PICK UP THE EGG", Hint = "Hold E near the egg", Target = "TutorialEgg" },
	{ Id = "ReturnHome", Text = "RETURN TO YOUR SANCTUARY", Hint = "Follow the marker", Target = "Sanctuary" },
	{ Id = "PlaceEgg", Text = "PLACE THE EGG IN A NEST", Hint = "Hold E at an empty nest", Target = "Nest" },
	{ Id = "Hatch", Text = "WATCH YOUR EGG HATCH", Hint = "", Target = "None" },
	{ Id = "EquipNew", Text = "EQUIP YOUR NEW DRAGON", Hint = "Open DRAGONS (G) and press EQUIP", Target = "None" },
	{ Id = "PlaceDragon", Text = "PLACE A DRAGON TO EARN CASH", Hint = "Select a dragon and press PLACE", Target = "None", Reward = 650 },
	{ Id = "BuyUpgrade", Text = "BUY YOUR FIRST UPGRADE", Hint = "Open the SHOP (B)", Target = "None", Reward = 250 },
}

QuestConfig.ActiveCount = 3

-- Repeatable quests. Goal/Reward scale with player level.
QuestConfig.Templates = {
	FindEggs = { Text = "Find %d eggs", Goal = 3, GoalPerLevel = 0.25, Reward = 300, Stat = "EggsFound" },
	HatchDragons = { Text = "Hatch %d dragons", Goal = 2, GoalPerLevel = 0.2, Reward = 450, Stat = "Hatched" },
	FlyDistance = { Text = "Fly %s studs", Goal = 6000, GoalPerLevel = 900, Reward = 350, Stat = "DistanceFlown", Big = true },
	CollectIncome = { Text = "Collect %s from your sanctuary", Goal = 1500, GoalPerLevel = 1.0, Reward = 400, Stat = "Collected", Cash = true, Scales = true },
	FeedDragons = { Text = "Feed dragons %d times", Goal = 3, GoalPerLevel = 0.15, Reward = 300, Stat = "Fed" },
	BoostTime = { Text = "Boost for %d seconds", Goal = 30, GoalPerLevel = 2, Reward = 250, Stat = "BoostSeconds" },
}

QuestConfig.TemplateOrder = { "FindEggs", "HatchDragons", "FlyDistance", "CollectIncome", "FeedDragons", "BoostTime" }

return table.freeze(QuestConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000041">
				<Properties>
					<string name="Name">RegionConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	RegionConfig
	World regions, unlock gates and per-region atmosphere.
	Bounds are horizontal circles (Center X/Z, Radius) used for region
	detection, lighting blends and egg spawns.
]]

local RegionConfig = {}

RegionConfig.Order = { "Haven", "Frostpeak", "EmberCaldera", "Skyreach" }

RegionConfig.Regions = {
	Haven = {
		Name = "Dragon Haven",
		Center = Vector2.new(0, 0),
		Radius = 1050,
		RequiredLevel = 1,
		Cost = 0,
		Music = "MusicHaven",
		Atmosphere = {
			Density = 0.3,
			Haze = 1.4,
			Color = Color3.fromRGB(205, 214, 232),
			Decay = Color3.fromRGB(120, 132, 156),
			Tint = Color3.fromRGB(255, 251, 244),
			Saturation = 0.08,
		},
	},
	Frostpeak = {
		Name = "Frostpeak Highlands",
		Center = Vector2.new(-150, -1650),
		Radius = 640,
		RequiredLevel = 5,
		Cost = 25000,
		Music = "MusicFrost",
		GatePosition = Vector3.new(-120, 132, -1010),
		Atmosphere = {
			Density = 0.38,
			Haze = 2.1,
			Color = Color3.fromRGB(214, 228, 245),
			Decay = Color3.fromRGB(150, 175, 205),
			Tint = Color3.fromRGB(236, 246, 255),
			Saturation = -0.02,
		},
	},
	EmberCaldera = {
		Name = "Ember Caldera",
		Center = Vector2.new(1700, 300),
		Radius = 620,
		RequiredLevel = 12,
		Cost = 5000000,
		Music = "MusicEmber",
		GatePosition = Vector3.new(1080, 96, 220),
		Atmosphere = {
			Density = 0.42,
			Haze = 2.4,
			Color = Color3.fromRGB(240, 190, 160),
			Decay = Color3.fromRGB(150, 80, 60),
			Tint = Color3.fromRGB(255, 236, 222),
			Saturation = 0.1,
		},
	},
	Skyreach = {
		Name = "Skyreach Isles",
		Center = Vector2.new(-1600, 450),
		Radius = 600,
		RequiredLevel = 20,
		Cost = 1000000000,
		Music = "MusicSky",
		MinHeight = 380,
		GatePosition = Vector3.new(-1060, 420, 330),
		Atmosphere = {
			Density = 0.24,
			Haze = 0.9,
			Color = Color3.fromRGB(220, 232, 250),
			Decay = Color3.fromRGB(160, 180, 230),
			Tint = Color3.fromRGB(250, 248, 255),
			Saturation = 0.05,
		},
	},
}

-- Returns region id for a world position (closest region whose circle contains it).
function RegionConfig.regionAt(position: Vector3): string
	local best, bestDist = "Haven", math.huge
	for id, r in RegionConfig.Regions do
		local d = (Vector2.new(position.X, position.Z) - r.Center).Magnitude
		if d <= r.Radius and d / r.Radius < bestDist then
			if not r.MinHeight or position.Y >= r.MinHeight - 120 then
				best, bestDist = id, d / r.Radius
			end
		end
	end
	return best
end

return table.freeze(RegionConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000042">
				<Properties>
					<string name="Name">SpinConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	SpinConfig
	Spin Island: a floating toy island south of the plaza with a giant prize
	wheel. One free spin every FreeSpinSeconds, plus spin tickets (start
	bonus, Robux packs, rewards). Luck (Owner Dragon, potions) multiplies the
	weights of the rare segments.

	Wheel geometry: Wheel is the rotor's centre CFrame; its LookVector points
	toward the players (and the hub). Segment 1 starts at the top and the
	segments go clockwise as seen by players.
]]

local SpinConfig = {}

SpinConfig.Island = {
	Center = Vector3.new(0, 140, 240), -- top surface centre
	Radius = 36,
}

-- Rotor centre: on the island, toward the back, facing the hub (-Z).
SpinConfig.WheelRadius = 13
SpinConfig.Wheel = CFrame.lookAt(Vector3.new(0, 140 + 18, 240 + 10), Vector3.new(0, 140 + 18, 0))

SpinConfig.FreeSpinSeconds = 15 * 60
SpinConfig.StartTickets = 3
SpinConfig.MaxDistance = 110 -- must stand near the wheel to spin
SpinConfig.SpinSeconds = 5.4
SpinConfig.Turns = 5
SpinConfig.RareFrom = 6 -- segments >= this get the luck multiplier

-- Kind: Cash (Minutes of income, at least Min), Egg, Spin (+Count tickets), Boost
SpinConfig.Segments = {
	{ Kind = "Cash", Minutes = 2, Min = 500, Label = "CASH", Weight = 22, Color = Color3.fromRGB(75, 151, 74) },
	{ Kind = "Egg", Egg = "HavenEgg", Count = 1, Label = "HAVEN EGG", Weight = 18, Color = Color3.fromRGB(13, 105, 172) },
	{ Kind = "Cash", Minutes = 10, Min = 2500, Label = "CASH x5", Weight = 14, Color = Color3.fromRGB(245, 205, 47) },
	{ Kind = "Egg", Egg = "GroveEgg", Count = 1, Label = "GROVE EGG", Weight = 12, Color = Color3.fromRGB(218, 120, 46) },
	{ Kind = "Spin", Count = 1, Label = "+1 SPIN", Weight = 9, Color = Color3.fromRGB(196, 40, 27) },
	{ Kind = "Egg", Egg = "FrostEgg", Count = 1, Label = "FROST EGG", Weight = 8, Color = Color3.fromRGB(110, 153, 202) },
	{ Kind = "Boost", Boost = "Luck", Seconds = 600, Label = "x2 LUCK", Weight = 6, Color = Color3.fromRGB(0, 150, 110) },
	{ Kind = "Egg", Egg = "EmberEgg", Count = 1, Label = "EMBER EGG", Weight = 5, Color = Color3.fromRGB(123, 46, 47) },
	{ Kind = "Cash", Minutes = 60, Min = 20000, Label = "CASH x30", Weight = 4, Color = Color3.fromRGB(170, 40, 140) },
	{ Kind = "Egg", Egg = "SkyEgg", Count = 1, Label = "SKY EGG!", Weight = 2, Color = Color3.fromRGB(222, 186, 76), Jackpot = true },
}

-- Probabilities with a luck multiplier (rare segments x luck).
function SpinConfig.odds(luck: number?): { number }
	local k = math.max(1, luck or 1)
	local weights, total = {}, 0
	for i, s in SpinConfig.Segments do
		local w = s.Weight * (i >= SpinConfig.RareFrom and k or 1)
		weights[i] = w
		total += w
	end
	for i, w in weights do
		weights[i] = w / total
	end
	return weights
end

-- Segment centre angle (degrees, clockwise from the top as players see it).
function SpinConfig.segmentAngle(i: number): number
	local n = #SpinConfig.Segments
	return (i - 0.5) * 360 / n
end

-- Where Travel "SpinIsland" puts the player: in front of the podium, facing the wheel.
function SpinConfig.arrival(): CFrame
	local w = SpinConfig.Wheel
	local front = w.Position + w.LookVector * 32
	local p = Vector3.new(front.X, SpinConfig.Island.Center.Y + 3.4, front.Z)
	return CFrame.lookAt(p, Vector3.new(w.Position.X, p.Y, w.Position.Z))
end

return table.freeze(SpinConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000043">
				<Properties>
					<string name="Name">TreeConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	TreeConfig
	The Great Tree in the plaza: permanent upgrades bought with cash.
	20 branches in 5 categories, 8-12 levels each (about 190 levels). A level
	needs the one below it. Level.Bonus is the TOTAL bonus at that level (not
	added per level); Level.Price is the price of that level.

	Levels are generated from a few numbers per branch (how many, the bonus at
	the last level, the price of the first and last level; prices grow
	geometrically), so balancing is a matter of editing one line.

	Where each bonus is applied (server unless noted):
	  RollLuck       x(1+b) luck on every egg roll                BoostService.LuckMultiplier
	  MutationLuck   x(1+b) mutation chance when hatching         EggService.Hatch
	  FindLuck       x(1+b) luck of eggs found in the world       EggService (spawn)
	  SpinLuck       x(1+b) luck on the Spin Wheel rare prizes    SpinService
	  SpinSpeed      free spin comes back b faster                SpinService
	  Income         x(1+b) perch income                          BoostService.Multiplier("Coins")
	  Offline        x(1+b) offline earning rate and cap          EconomyService
	  Wisdom         x(1+b) player XP                             LevelService
	  Recycler       x(1+b) cash refunded when releasing          DragonService.Release
	  FlySpeed       x(1+b) cruise speed                          MountService / DragonController
	  BoostLong      x(1+b) boost duration                        Locomotion (client stats)
	  BoostRegen     x(1+b) boost refill speed                    Locomotion (client stats)
	  RunSpeed       x(1+b) ground run speed                      MountService / DragonController
	  HatchSpeed     eggs incubate b faster                       EggService.Place
	  EggBag         +b egg bag slots                             EggService (+ UI)
	  EggMagnet      x(1+b) egg pickup range                      EggController / EggService
	  EggRespawn     new eggs appear b faster                     EggService
	  BondGrowth     x(1+b) bond points                           BondService
	  QuickFeathers  bond ability cooldowns -b                    BondService / BondController
	  Dragonfire     x(1+b) fire breath range                     BondService
]]

local EconomyConfig = require(script.Parent:WaitForChild("EconomyConfig"))

local TreeConfig = {}

local C3 = Color3.fromRGB

TreeConfig.Categories = {
	{ Id = "Luck", Name = "Luck", Icon = "Clover", Color = C3(110, 208, 104) },
	{ Id = "Wealth", Name = "Wealth", Icon = "Coin", Color = C3(255, 196, 48) },
	{ Id = "Flight", Name = "Flight", Icon = "Wind", Color = C3(77, 163, 255) },
	{ Id = "Nest", Name = "Nest", Icon = "Egg", Color = C3(255, 140, 60) },
	{ Id = "Bond", Name = "Bond", Icon = "Flame", Color = C3(255, 96, 96) },
}

-- 2 significant digits: 25200 -> 25000
local function nice(x: number): number
	if x < 100 then
		return math.floor(x + 0.5)
	end
	local e = math.floor(math.log10(x))
	local m = 10 ^ (e - 1)
	return math.floor(x / m + 0.5) * m
end

-- Def: Levels (count), Max (bonus at the last level), Curve (1 = linear),
-- Price = { first, last }, Integer (whole-number bonuses)
local function generate(def)
	local n = def.Levels
	local levels = {}
	for k = 1, n do
		local t = (k - 1) / math.max(1, n - 1)
		local price = nice(def.Price[1] * (def.Price[2] / def.Price[1]) ^ t)
		local raw = def.Max * (k / n) ^ (def.Curve or 1)
		local bonus = def.Integer and math.ceil(raw - 1e-9) or math.floor(raw * 1000 + 0.5) / 1000
		levels[k] = { Bonus = bonus, Price = price }
	end
	return levels
end

-- Id, Name, Icon, Color, Description, Format ("Luck" xN | "Percent" +N% | "Faster" N% faster |
-- "Slots" +N | "Range" +N% range | "Less" -N%)
local DEFS = {
	-- LUCK
	{ Cat = "Luck", Id = "RollLuck", Name = "Roll Luck", Icon = "Clover", Color = C3(110, 208, 104), Description = "More luck on every egg roll.", Format = "Luck", Levels = 12, Max = 2.0, Price = { 6e3, 6e10 } },
	{ Cat = "Luck", Id = "MutationLuck", Name = "Mutation Luck", Icon = "Sparkle", Color = C3(190, 120, 255), Description = "Mutations appear more often when hatching.", Format = "Luck", Levels = 12, Max = 3.0, Price = { 1.2e4, 1.2e11 } },
	{ Cat = "Luck", Id = "FindLuck", Name = "Lucky Finds", Icon = "Star", Color = C3(255, 220, 90), Description = "Eggs you find in the world carry more luck.", Format = "Luck", Levels = 10, Max = 1.5, Price = { 1e4, 2e10 } },
	{ Cat = "Luck", Id = "SpinLuck", Name = "Lucky Wheel", Icon = "Gift", Color = C3(255, 120, 170), Description = "Better odds for the rare Spin Wheel prizes.", Format = "Luck", Levels = 8, Max = 1.0, Price = { 1.5e4, 5e9 } },
	{ Cat = "Luck", Id = "SpinSpeed", Name = "Quick Spin", Icon = "Speed", Color = C3(120, 220, 220), Description = "Your free spin comes back sooner.", Format = "Faster", Levels = 8, Max = 0.6, Price = { 2e4, 8e9 } },
	-- WEALTH
	{ Cat = "Wealth", Id = "Income", Name = "Golden Roots", Icon = "Coin", Color = C3(255, 196, 48), Description = "More income from every perch.", Format = "Percent", Levels = 12, Max = 2.0, Price = { 8e3, 8e10 } },
	{ Cat = "Wealth", Id = "Offline", Name = "Dream Dens", Icon = "Home", Color = C3(170, 140, 255), Description = "Your dragons earn more while you are away.", Format = "Percent", Levels = 10, Max = 1.0, Price = { 2.5e4, 3e10 } },
	{ Cat = "Wealth", Id = "Wisdom", Name = "Ancient Wisdom", Icon = "Book", Color = C3(120, 190, 255), Description = "You earn player XP faster.", Format = "Percent", Levels = 10, Max = 1.0, Price = { 1.5e4, 1.5e10 } },
	{ Cat = "Wealth", Id = "Recycler", Name = "Gentle Goodbye", Icon = "Release", Color = C3(150, 230, 170), Description = "Releasing a dragon refunds more cash.", Format = "Percent", Levels = 8, Max = 4.0, Price = { 5e3, 2e9 } },
	-- FLIGHT
	{ Cat = "Flight", Id = "FlySpeed", Name = "Wind Wings", Icon = "Wind", Color = C3(77, 163, 255), Description = "Your dragons fly faster.", Format = "Percent", Levels = 12, Max = 0.5, Price = { 6e3, 4e10 } },
	{ Cat = "Flight", Id = "BoostLong", Name = "Deep Breath", Icon = "Speed", Color = C3(255, 150, 70), Description = "Your boost lasts longer.", Format = "Percent", Levels = 10, Max = 1.5, Price = { 1e4, 1.2e10 } },
	{ Cat = "Flight", Id = "BoostRegen", Name = "Second Wind", Icon = "Ascend", Color = C3(100, 230, 200), Description = "The boost meter refills faster.", Format = "Percent", Levels = 10, Max = 1.5, Price = { 1e4, 1.2e10 } },
	{ Cat = "Flight", Id = "RunSpeed", Name = "Swift Paws", Icon = "Dragon", Color = C3(230, 200, 120), Description = "Your dragons run faster on the ground.", Format = "Percent", Levels = 8, Max = 0.4, Price = { 5e3, 3e9 } },
	-- NEST
	{ Cat = "Nest", Id = "HatchSpeed", Name = "Warm Nest", Icon = "Egg", Color = C3(255, 140, 60), Description = "Eggs hatch faster in your nest.", Format = "Faster", Levels = 12, Max = 0.6, Price = { 5e3, 3e10 } },
	{ Cat = "Nest", Id = "EggBag", Name = "Deep Pockets", Icon = "Bag", Color = C3(200, 160, 110), Description = "Carry more eggs in your bag.", Format = "Slots", Levels = 10, Max = 10, Integer = true, Price = { 8e3, 1e10 } },
	{ Cat = "Nest", Id = "EggMagnet", Name = "Egg Magnet", Icon = "Radar", Color = C3(255, 90, 120), Description = "Pick up eggs from farther away.", Format = "Range", Levels = 8, Max = 1.0, Price = { 6e3, 2e9 } },
	{ Cat = "Nest", Id = "EggRespawn", Name = "Fertile Soil", Icon = "Plus", Color = C3(140, 220, 110), Description = "New eggs appear sooner.", Format = "Faster", Levels = 8, Max = 0.6, Price = { 8e3, 3e9 } },
	-- BOND
	{ Cat = "Bond", Id = "BondGrowth", Name = "Soul Bond", Icon = "Dragon", Color = C3(255, 96, 96), Description = "Dragon Bond grows faster while you ride.", Format = "Percent", Levels = 10, Max = 2.0, Price = { 1e4, 1.5e10 } },
	{ Cat = "Bond", Id = "QuickFeathers", Name = "Quick Feathers", Icon = "Wing", Color = C3(130, 200, 255), Description = "Dash, fire and dance recharge sooner.", Format = "Less", Levels = 8, Max = 0.5, Price = { 1.2e4, 8e9 } },
	{ Cat = "Bond", Id = "Dragonfire", Name = "Dragonfire", Icon = "Flame", Color = C3(255, 120, 40), Description = "Your fire breath reaches farther.", Format = "Range", Levels = 8, Max = 0.8, Price = { 1.5e4, 6e9 } },
}

TreeConfig.Branches = {}
TreeConfig.ById = {}
TreeConfig.CategoryById = {}
for _, cat in TreeConfig.Categories do
	cat.Branches = {}
	TreeConfig.CategoryById[cat.Id] = cat
end
for _, def in DEFS do
	local branch = {
		Id = def.Id,
		Name = def.Name,
		Icon = def.Icon,
		Color = def.Color,
		Description = def.Description,
		Format = def.Format,
		Category = def.Cat,
		Levels = generate(def),
	}
	table.insert(TreeConfig.Branches, branch)
	TreeConfig.ById[branch.Id] = branch
	table.insert(TreeConfig.CategoryById[def.Cat].Branches, branch)
end

function TreeConfig.level(data, id: string): number
	local t = data and data.Tree
	return t and math.max(0, math.floor(tonumber(t[id]) or 0)) or 0
end

-- Total bonus (0 when not bought).
function TreeConfig.bonus(data, id: string): number
	local branch = TreeConfig.ById[id]
	local lvl = TreeConfig.level(data, id)
	if not branch or lvl <= 0 then
		return 0
	end
	return branch.Levels[math.min(lvl, #branch.Levels)].Bonus
end

-- Egg bag capacity: Egg Storage upgrade + Deep Pockets (the one formula everybody uses).
function TreeConfig.eggCapacity(data): number
	local level = data and data.Upgrades and tonumber(data.Upgrades.EggStorage) or 0
	return EconomyConfig.upgradeValue("EggStorage", level) + math.floor(TreeConfig.bonus(data, "EggBag") + 0.5)
end

-- Seconds of the dragon's income refunded when it is released (Gentle Goodbye).
function TreeConfig.refundSeconds(data): number
	return EconomyConfig.ReleaseRefundSeconds * (1 + TreeConfig.bonus(data, "Recycler"))
end

-- Levels bought / levels available inside a category (0..1).
function TreeConfig.categoryProgress(data, categoryId: string): number
	local cat = TreeConfig.CategoryById[categoryId]
	if not cat then
		return 0
	end
	local have, total = 0, 0
	for _, branch in cat.Branches do
		have += math.min(TreeConfig.level(data, branch.Id), #branch.Levels)
		total += #branch.Levels
	end
	return total > 0 and have / total or 0
end

-- Levels bought in total, and available in total.
function TreeConfig.totals(data): (number, number)
	local have, total = 0, 0
	for _, branch in TreeConfig.Branches do
		have += math.min(TreeConfig.level(data, branch.Id), #branch.Levels)
		total += #branch.Levels
	end
	return have, total
end

local function pct(x: number): number
	return math.floor(x * 100 + 0.5)
end

function TreeConfig.formatBonus(branch, bonus: number): string
	local f = branch.Format
	if f == "Luck" then
		return "x" .. tostring(math.floor((1 + bonus) * 100 + 0.5) / 100)
	elseif f == "Faster" then
		return pct(bonus) .. "% faster"
	elseif f == "Slots" then
		return "+" .. tostring(math.floor(bonus + 0.5)) .. " slots"
	elseif f == "Range" then
		return "+" .. pct(bonus) .. "% range"
	elseif f == "Less" then
		return "-" .. pct(bonus) .. "% wait"
	end
	return "+" .. pct(bonus) .. "%"
end

-- Great Tree position (plaza, north-east of the statue).
TreeConfig.WorldAngle = 62 -- degrees from north, clockwise
TreeConfig.WorldRing = 46

return table.freeze(TreeConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000044">
				<Properties>
					<string name="Name">WildEggConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	WildEggConfig
	Lucky Wild Eggs: every few minutes ONE special egg appears somewhere in the world for
	everybody on the server ("A MYTHIC EGG HAS SPAWNED!  02:00"). It is a race: the first
	player (or ridden dragon) to reach it takes it - straight into their hand, with a big luck
	multiplier that applies when it hatches. Nobody there in time: it vanishes.
]]

local WildEggConfig = {}

WildEggConfig.FirstDelay = { Min = 90, Max = 180 } -- seconds after the server started
WildEggConfig.Interval = { Min = 600, Max = 1200 } -- seconds between two wild eggs
WildEggConfig.Lifetime = 120 -- seconds to find it
WildEggConfig.PickupRange = 14 -- studs (character or ridden dragon)
WildEggConfig.ClaimThrottle = 0.6 -- the client asks at most this often

-- Egg: one entry, or a list to pick from. Luck: { min, max } multiplier applied when it hatches.
WildEggConfig.Tiers = {
	{ Id = "Lucky", Name = "LUCKY EGG", Eggs = { "FrostEgg" }, Luck = { 25, 50 }, Weight = 52, Color = Color3.fromRGB(110, 230, 120) },
	{ Id = "Epic", Name = "EPIC EGG", Eggs = { "InfernoEgg", "SkyEgg", "StormEgg" }, Luck = { 60, 150 }, Weight = 30, Color = Color3.fromRGB(190, 120, 255) },
	{ Id = "Mythic", Name = "MYTHIC EGG", Eggs = { "CelestialEgg" }, Luck = { 200, 500 }, Weight = 14, Color = Color3.fromRGB(255, 80, 160) },
	{ Id = "Rainbow", Name = "RAINBOW EGG", Eggs = { "RainbowEgg" }, Luck = { 800, 2000 }, Weight = 4, Color = Color3.fromRGB(255, 150, 225) },
}

WildEggConfig.ById = {}
for _, t in WildEggConfig.Tiers do
	WildEggConfig.ById[t.Id] = t
end

-- Picks a tier (optionally forced), an egg type and a luck value.
function WildEggConfig.roll(rng: Random, forcedTier: string?)
	local tier = forcedTier and WildEggConfig.ById[forcedTier]
	if not tier then
		local total = 0
		for _, t in WildEggConfig.Tiers do
			total += t.Weight
		end
		local r = rng:NextNumber() * total
		for _, t in WildEggConfig.Tiers do
			r -= t.Weight
			if r <= 0 then
				tier = t
				break
			end
		end
		tier = tier or WildEggConfig.Tiers[1]
	end
	local egg = tier.Eggs[rng:NextInteger(1, #tier.Eggs)]
	local luck = rng:NextInteger(tier.Luck[1], tier.Luck[2])
	return tier, egg, luck
end

return table.freeze(WildEggConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000045">
				<Properties>
					<string name="Name">WorldConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	WorldConfig
	Shared layout of Dragon Haven (server builds it, clients use it for
	markers, objectives and region checks). Coordinates are studs; the valley
	is centered at the origin, north is -Z.

	Composition (top-down):
	                 Frostpeak pass (N)
	      ruins (NW)        waterfall + caves (NE)
	   west forest   HUB (village, statue)   river  east forest -> Ember pass (E)
	  sky pillar (W)    sanctuary ring (8 plots)
	                    lake + grove (S)
]]

local WorldConfig = {}

WorldConfig.MaxPlots = 8

WorldConfig.Hub = {
	Center = Vector3.new(0, 30, 0),
	PlazaRadius = 64,
	VillageRadius = 175,
	Height = 30,
}

WorldConfig.Spawn = CFrame.new(0, 34, 46) * CFrame.Angles(0, 0, 0)

-- Interactable stations around the plaza. Facing = yaw (radians) the
-- building front looks toward (the plaza).
local function yawToward(from: Vector3, to: Vector3): number
	local d = to - from
	return math.atan2(-d.X, -d.Z)
end
WorldConfig.yawToward = yawToward

WorldConfig.Stations = {
	Shop = { Name = "Dragon Market", Position = Vector3.new(0, 30, -118), Window = "Shop", Prompt = "Shop", Radius = 22 },
	Forge = { Name = "Dragonsmith Forge", Position = Vector3.new(-104, 30, -66), Window = "Shop", Tab = "Upgrades", Prompt = "Upgrades", Radius = 22 },
	Library = { Name = "Hall of Dragons", Position = Vector3.new(-122, 30, 32), Window = "Index", Prompt = "Dragon Index", Radius = 22 },
	Quests = { Name = "Elder Rowan", Position = Vector3.new(116, 30, -28), Window = "Quests", Prompt = "Quests", Radius = 20 },
}
for _, s in WorldConfig.Stations do
	s.Facing = yawToward(s.Position, WorldConfig.Hub.Center)
end

-- Personal sanctuary plots (assigned per player). Each plot faces the hub.
WorldConfig.PlotRing = 335
WorldConfig.PlotSize = Vector2.new(124, 104) -- width (across), depth (radial)
WorldConfig.Plots = {}
for i = 1, WorldConfig.MaxPlots do
	local a = math.rad(22.5 + (i - 1) * 45)
	local center = Vector3.new(math.sin(a) * WorldConfig.PlotRing, 0, -math.cos(a) * WorldConfig.PlotRing)
	local height = 34 + ((i % 3) - 1) * 4
	center = Vector3.new(center.X, height, center.Z)
	WorldConfig.Plots[i] = {
		Id = i,
		Center = center,
		Height = height,
		Facing = yawToward(center, WorldConfig.Hub.Center),
	}
end

-- Sanctuary layout in plot-local space: origin on the terrace centre at
-- ground level, -Z toward the gate (and the hub). Perches form a horseshoe
-- around the nest, open toward the gate; unlock order fills from the back
-- centre outward so the first dragons are the most visible.
WorldConfig.Sanctuary = {
	Nest = Vector3.new(0, 0, -6),
	PerchCount = 8,
	PerchRadius = 38,
	PerchSurface = 2.0, -- standing surface height of a perch
	PerchAngles = { -15, 15, -45, 45, -75, 75, -105, 105 }, -- degrees around the nest (0 = back)
	Shrine = Vector3.new(40, 0, -38),
}

-- World frame of a plot (terrace centre at ground level, -Z facing the hub).
function WorldConfig.plotFrame(plotId: number): CFrame?
	local p = WorldConfig.Plots[plotId]
	if not p then
		return nil
	end
	return CFrame.new(p.Center.X, p.Height, p.Center.Z) * CFrame.Angles(0, p.Facing, 0)
end

-- Plot-local frame of perch i at its standing surface; -Z faces the nest.
function WorldConfig.perchLocal(i: number): CFrame
	local s = WorldConfig.Sanctuary
	local a = math.rad(s.PerchAngles[i] or 0)
	local nest = s.Nest
	local pos = Vector3.new(nest.X + math.sin(a) * s.PerchRadius, s.PerchSurface, nest.Z + math.cos(a) * s.PerchRadius)
	return CFrame.lookAt(pos, Vector3.new(nest.X, s.PerchSurface, nest.Z))
end

function WorldConfig.perchWorld(plotId: number, i: number): CFrame?
	local f = WorldConfig.plotFrame(plotId)
	return f and f * WorldConfig.perchLocal(i) or nil
end

-- River (polyline in XZ, source -> lake) with water levels at both ends.
WorldConfig.River = {
	Points = {
		Vector2.new(424, -742),
		Vector2.new(452, -600),
		Vector2.new(486, -430),
		Vector2.new(470, -220),
		Vector2.new(452, -20),
		Vector2.new(474, 170),
		Vector2.new(430, 380),
		Vector2.new(330, 560),
		Vector2.new(214, 676),
	},
	WaterStart = 37,
	WaterEnd = 25,
	HalfWidthStart = 13,
	HalfWidthEnd = 20,
	Depth = 8,
	Bank = 20,
}

-- Upper stream on the cliff plateau that feeds the waterfall.
WorldConfig.UpperStream = {
	Points = { Vector2.new(400, -1010), Vector2.new(416, -900), Vector2.new(424, -786) },
	Water = 176,
	HalfWidth = 11,
	Depth = 6,
}

WorldConfig.Waterfall = {
	Top = Vector3.new(424, 176, -786),
	Bottom = Vector3.new(424, 37, -748),
	Width = 34,
	CliffZ = -774, -- cliff face line (plateau north of it)
	CliffX = { 300, 560 },
	PlateauHeight = 182,
}

WorldConfig.Lake = {
	Center = Vector2.new(150, 742),
	Radius = 196,
	Water = 25,
	Island = { Center = Vector2.new(196, 790), Radius = 34, Height = 33 },
}

WorldConfig.Ruins = { Center = Vector3.new(-500, 0, -540), Radius = 120, Height = 78 }
WorldConfig.Caves = { Mouth = Vector3.new(706, 0, -600), Facing = math.rad(220), Depth = 150 }
WorldConfig.SkyPillar = { Center = Vector3.new(-905, 0, 300), Radius = 48, Height = 360 }

WorldConfig.Forests = {
	{ Name = "Westwood", Center = Vector2.new(-560, -40), Radius = 330, Density = 1 },
	{ Name = "Eastwood", Center = Vector2.new(690, 60), Radius = 250, Density = 0.85 },
	{ Name = "Lakeside Grove", Center = Vector2.new(-120, 640), Radius = 200, Density = 0.6 },
	{ Name = "North Pines", Center = Vector2.new(-180, -720), Radius = 210, Density = 0.75 },
}

-- Region gates (positions from RegionConfig)
WorldConfig.Passes = {
	North = { Angle = math.rad(-7), Width = math.rad(9), Height = 128 }, -- toward Frostpeak
	East = { Angle = math.rad(78), Width = math.rad(8), Height = 92 }, -- toward Ember Caldera
}

-- Roads (XZ polylines) drawn as dirt paths; village streets are cobblestone.
WorldConfig.Roads = {
	North = { Vector2.new(-34, -58), Vector2.new(-62, -150), Vector2.new(-52, -300), Vector2.new(-90, -620), Vector2.new(-120, -1000) },
	East = { Vector2.new(70, 0), Vector2.new(300, 40), Vector2.new(455, 96), Vector2.new(700, 160), Vector2.new(1060, 220) },
	South = { Vector2.new(0, 70), Vector2.new(30, 300), Vector2.new(110, 520) },
	West = { Vector2.new(-70, 0), Vector2.new(-320, 60), Vector2.new(-620, 180), Vector2.new(-860, 290) },
	Ruins = { Vector2.new(-60, -60), Vector2.new(-300, -330), Vector2.new(-470, -500) },
	Falls = { Vector2.new(60, -60), Vector2.new(280, -420), Vector2.new(400, -700) },
}

WorldConfig.Bridges = {
	{ Name = "East Bridge", Road = "East" },
}

return WorldConfig
]]></ProtectedString>
