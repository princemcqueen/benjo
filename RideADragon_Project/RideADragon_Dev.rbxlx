	Void = { Main = C(16, 14, 22), Dark = C(4, 4, 8), Belly = C(50, 10, 70), Membrane = C(26, 8, 40), Horn = C(242, 243, 242), Accent = C(255, 255, 255), Eye = C(255, 255, 255), Glow = C(230, 200, 255) },
