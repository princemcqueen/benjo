	Neon = { Main = C(40, 255, 225), Dark = C(255, 60, 200), Belly = C(255, 255, 140), Membrane = C(150, 90, 255), Horn = C(255, 255, 255), Accent = C(255, 70, 210), Eye = C(255, 255, 255), Glow = C(80, 255, 230), Saddle = C(40, 20, 80) },
	Infernal = { Main = C(150, 18, 18), Dark = C(54, 8, 8), Belly = C(255, 96, 20), Membrane = C(104, 10, 10), Horn = C(28, 18, 18), Accent = C(255, 170, 40), Eye = C(255, 240, 120), Glow = C(255, 110, 30), Saddle = C(30, 18, 18) },
	Corrupted = { Main = C(40, 10, 52), Dark = C(10, 2, 18), Belly = C(190, 20, 100), Membrane = C(70, 0, 84), Horn = C(220, 220, 230), Accent = C(255, 20, 120), Eye = C(255, 40, 40), Glow = C(255, 40, 160), Saddle = C(20, 6, 30) },
	Crystal = { Main = C(150, 100, 235), Dark = C(94, 56, 180), Belly = C(215, 195, 255), Membrane = C(190, 150, 255), Horn = C(255, 255, 255), Accent = C(110, 255, 225), Eye = C(255, 255, 255), Glow = C(200, 160, 255), Crystal = C(120, 255, 230), Saddle = C(60, 36, 120) },
	Lightning = { Main = C(32, 44, 110), Dark = C(14, 18, 52), Belly = C(255, 240, 130), Membrane = C(70, 96, 190), Horn = C(255, 250, 210), Accent = C(255, 240, 60), Eye = C(255, 255, 210), Glow = C(255, 240, 90), Saddle = C(20, 24, 70) },
	Angelic = { Main = C(250, 250, 255), Dark = C(206, 216, 238), Belly = C(255, 246, 205), Membrane = C(255, 253, 240), Horn = C(255, 222, 120), Accent = C(255, 218, 100), Eye = C(110, 195, 255), Glow = C(255, 240, 190), Saddle = C(255, 224, 140) },
}

function Species.mutatePalette(p, mutation: string)
	local out = table.clone(p)
	if mutation == "Shiny" then
		for k, v in p do
			if k ~= "Pupil" and typeof(v) == "Color3" then
				out[k] = shift(v, 0.035, 0.9, 1.22)
			end
		end
		out.Eye = C(140, 240, 255)
		return out
	end
	local over = MUTATION_PALETTES[mutation]
	if over then
		for k, v in over do
			out[k] = v
		end
	end
	return out
end

function Species.statuePalette(color: Color3?)
	local base = color or C(176, 170, 158)
	return {
		Main = base,
		Dark = lerp(base, C(0, 0, 0), 0.18),
		Belly = lerp(base, C(255, 255, 255), 0.12),
		Horn = lerp(base, C(255, 255, 255), 0.2),
		Membrane = lerp(base, C(0, 0, 0), 0.08),
		Accent = base,
		Eye = lerp(base, C(255, 220, 140), 0.4),
		Pupil = lerp(base, C(0, 0, 0), 0.4),
		Claw = lerp(base, C(0, 0, 0), 0.25),
		Tooth = lerp(base, C(255, 255, 255), 0.3),
		Saddle = base,
		Glow = lerp(base, C(255, 230, 160), 0.5),
		Crystal = lerp(base, C(255, 255, 255), 0.2),
	}
end

-- Unique feature builders (filled in with the other species).
Species.FeatureBuilders = {}

return Species
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBX000016">
				<Properties>
					<string name="Name">EggReach</string>
					<ProtectedString name="Source"><![CDATA[--[[
	EggReach
	How far an egg can be grabbed from, whether the Egg Radar is on and how fast the nest
	hatches. The server (pickup / incubation) and the client (when to ask, what to show) use
	the same numbers.

	Pickup range bonus (fraction, 0.5 = +50%) =
	      Great Tree "Egg Magnet" branch
	    + every running boost with a Magnet value   (Egg Magnet potion)
	    + every owned pass with a Magnet value      (Egg Hunter)
	Egg Radar range (studs) = the Forge upgrade "Egg Radar" (250 / 600 / 1200 / whole map),
	unlimited while a Radar boost runs or with a pass that has Radar = true.  0 = no radar.
	Hatch factor = product of the HatchFactor of every running boost (Fast Hatch: 0.5).

	Boosts live in data.Boosts[id] = expiry (os.time); `now` is os.time() on the server and
	Workspace:GetServerTimeNow() on the client.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))
local MonetizationConfig = require(Configs:WaitForChild("MonetizationConfig"))
local EconomyConfig = require(Configs:WaitForChild("EconomyConfig"))

local EggReach = {}

local function boostLeft(data, boostId: string, now: number): number
	local boosts = data and data.Boosts
	local t = boosts and tonumber(boosts[boostId]) or 0
	return math.max(0, t - now)
end

-- Seconds left of the boost with the longest time among the ones that have `flag`.
local function flagLeft(data, flag: string, now: number): number
	local best = 0
	for id, def in MonetizationConfig.Boosts do
		if def[flag] then
			best = math.max(best, boostLeft(data, id, now))
		end
	end
	return best
end

local function passWith(data, flag: string): boolean
	for id, pass in MonetizationConfig.GamePasses do
		if pass[flag] and MonetizationConfig.ownsPass(data, id) then
			return true
		end
	end
	return false
end

-- Extra pickup range as a fraction (0.5 = +50%).
function EggReach.bonus(data, now: number?): number
	local t = now or os.time()
	local b = TreeConfig.bonus(data, "EggMagnet")
	for id, def in MonetizationConfig.Boosts do
		if def.Magnet and boostLeft(data, id, t) > 0 then
			b += def.Magnet
		end
	end
	for id, pass in MonetizationConfig.GamePasses do
		if pass.Magnet and MonetizationConfig.ownsPass(data, id) then
			b += pass.Magnet
		end
	end
	return b
end

-- Pickup range in studs for a base range.
function EggReach.range(data, base: number, now: number?): number
	return base * (1 + EggReach.bonus(data, now))
end

-- How far the radar sees (0 = off, math.huge = everything).
function EggReach.radarRange(data, now: number?): number
	local t = now or os.time()
	if flagLeft(data, "Radar", t) > 0 or passWith(data, "Radar") then
		return math.huge
	end
	local level = data and data.Upgrades and tonumber(data.Upgrades.Radar) or 0
	return EconomyConfig.upgradeValue("Radar", level)
end

function EggReach.radarActive(data, now: number?): boolean
	return EggReach.radarRange(data, now) > 0
end

-- Seconds of the Egg Radar BOOST left (math.huge with a radar pass, 0 otherwise).
function EggReach.radarSeconds(data, now: number?): number
	if passWith(data, "Radar") then
		return math.huge
	end
	return flagLeft(data, "Radar", now or os.time())
end

-- Incubation time factor (1 = normal, 0.5 = twice as fast).
function EggReach.hatchFactor(data, now: number?): number
	local t = now or os.time()
	local f = 1
	for id, def in MonetizationConfig.Boosts do
		if def.HatchFactor and boostLeft(data, id, t) > 0 then
			f *= def.HatchFactor
		end
	end
	return f
end

return EggReach
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000017">
				<Properties>
					<string name="Name">EggVisual</string>
					<ProtectedString name="Source"><![CDATA[--[[
	EggVisual
	Builds dragon egg models (client-side, never replicated): a glossy shell,
	speckles in the egg's spot colour, soft inner glow, optional light pillar
	(so world eggs are visible from the air) and sparkles.

	EggVisual.build(eggType, opts) -> Model (PrimaryPart = Shell)
	  opts: Scale, Beam (bool), Sparkles (bool), Light (bool)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local EggConfig = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("EggConfig"))

local EggVisual = {}

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

local function sphere(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material, parent: Instance): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	p.Parent = parent
	return p
end

function EggVisual.build(eggType: string, opts: { [string]: any }?): Model
	local o = opts or {}
	local def = EggConfig.Eggs[eggType] or EggConfig.Eggs.HavenEgg
	local s = o.Scale or 1
	local model = Instance.new("Model")
	model.Name = "Egg"
	model:SetAttribute("EggType", eggType)
	local size = Vector3.new(2.4, 3.1, 2.4) * s
	local shell = sphere(size, CFrame.new(), def.Shell, Enum.Material.SmoothPlastic, model)
	shell.Name = "Shell"
	shell.Reflectance = 0.04
	model.PrimaryPart = shell
	-- surface pattern (deterministic per egg type)
	local rng = Random.new(#eggType * 97 + def.Tier)
	local pattern = def.Pattern or "Spots"
	local function onShell(u: number, a: number): (Vector3, Vector3)
		local r = math.sqrt(math.max(0, 1 - u * u))
		local n = Vector3.new(math.cos(a) * r, u, math.sin(a) * r)
		return Vector3.new(n.X * size.X / 2, n.Y * size.Y / 2, n.Z * size.Z / 2) * 0.97, n
	end
	local function spot(i: number, u: number, a: number, k: number, color: Color3, material: Enum.Material?)
		local p, n = onShell(u, a)
		local part = sphere(Vector3.new(k, k * 0.35, k), CFrame.lookAt(p, p + n) * CFrame.Angles(math.rad(90), 0, 0), color, material or Enum.Material.SmoothPlastic, model)
		part.Name = "Spot" .. i
		part.CastShadow = false
		return part
	end
	local function band(i: number, y: number, thick: number, color: Color3, material: Enum.Material?)
		-- a ring around the shell at height y (ellipsoid slice)
		local u = math.clamp(y, -0.95, 0.95)
		local r = math.sqrt(1 - u * u)
		local part = sphere(Vector3.new(size.X * r * 1.025, thick * s, size.Z * r * 1.025), CFrame.new(0, u * size.Y / 2, 0), color, material or Enum.Material.SmoothPlastic, model)
		part.Name = "Band" .. i
		part.CastShadow = false
		return part
	end
	if pattern == "Stripes" or pattern == "Cracks" then
		for i, y in { -0.45, -0.05, 0.38 } do
			local b = band(i, y, pattern == "Cracks" and 0.22 or 0.42, def.Spots, pattern == "Cracks" and Enum.Material.Neon or nil)
			if pattern == "Cracks" then
				b.Transparency = 0.15
			end
		end
		for i = 1, 4 do
			spot(10 + i, rng:NextNumber(-0.6, 0.7), rng:NextNumber(0, math.pi * 2), rng:NextNumber(0.3, 0.5) * s, def.Spots, pattern == "Cracks" and Enum.Material.Neon or nil)
		end
	elseif pattern == "Rainbow" then
		local cols = { Color3.fromRGB(255, 90, 90), Color3.fromRGB(255, 170, 60), Color3.fromRGB(255, 230, 70), Color3.fromRGB(110, 220, 100), Color3.fromRGB(80, 170, 255), Color3.fromRGB(170, 110, 255) }
		for i, col in cols do
			band(i, -0.75 + (i - 1) * 0.3, 0.5, col)
		end
	elseif pattern == "Stars" or pattern == "Flowers" or pattern == "Crystal" then
		for i = 1, 11 do
			local u = rng:NextNumber(-0.7, 0.85)
			local a = rng:NextNumber(0, math.pi * 2)
			local k = rng:NextNumber(0.3, 0.55) * s
			if pattern == "Crystal" then
				local part = spot(i, u, a, k * 1.2, def.Spots)
				part.Material = Enum.Material.Glass
				part.Transparency = 0.3
			elseif pattern == "Stars" then
				local part = spot(i, u, a, k * 0.7, def.Spots, Enum.Material.Neon)
				part.Transparency = 0.1
			else
				-- tiny flower: five petals + centre
				for j = 0, 4 do
					local aa = a + (j / 5) * math.pi * 2 * 0.05
					spot(i * 10 + j, u + math.sin(j * 1.256) * 0.06, aa + math.cos(j * 1.256) * 0.07, k * 0.55, def.Spots)
				end
				spot(i * 10 + 9, u, a, k * 0.4, Color3.fromRGB(255, 230, 90))
			end
		end
	elseif pattern == "Gold" then
		shell.Reflectance = 0.35
		for i = 1, 6 do
			spot(i, rng:NextNumber(-0.6, 0.8), rng:NextNumber(0, math.pi * 2), rng:NextNumber(0.3, 0.5) * s, def.Spots, Enum.Material.Neon)
		end
	else
		for i = 1, 9 do
			spot(i, rng:NextNumber(-0.75, 0.85), rng:NextNumber(0, math.pi * 2), rng:NextNumber(0.35, 0.7) * s, def.Spots)
		end
	end
	-- inner glow band (rare eggs shine brighter)
	local glow = sphere(size * 1.04, CFrame.new(), def.Glow, Enum.Material.Neon, model)
	glow.Name = "Glow"
	glow.Transparency = 0.86 - math.min(def.Tier, 5) * 0.025
	glow.CastShadow = false
	if o.Light ~= false then
		local light = Instance.new("PointLight")
		light.Color = def.Glow
		light.Range = 10 + def.Tier * 2
		light.Brightness = 0.9 + def.Tier * 0.2
		light.Shadows = false
		light.Parent = shell
	end
	if o.Sparkles ~= false then
		local att = Instance.new("Attachment")
		att.Name = "SparkleAtt"
		att.Parent = shell
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "Sparkles"
		pe.Texture = SPARKLE
		pe.Color = ColorSequence.new(def.Glow)
		pe.LightEmission = 1
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.35 * s), NumberSequenceKeypoint.new(1, 0) })
		pe.Transparency = NumberSequence.new(0.15)
		pe.Lifetime = NumberRange.new(0.8, 1.4)
		pe.Rate = 5 + def.Tier * 2
		pe.Speed = NumberRange.new(0.6, 1.6)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Shape = Enum.ParticleEmitterShape.Sphere
		pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Surface
		pe.Acceleration = Vector3.new(0, 1.5, 0)
		pe.Parent = att
	end
	if o.Beam then
		local a0 = Instance.new("Attachment")
		a0.Name = "BeamBase"
		a0.Position = Vector3.new(0, -size.Y * 0.2, 0)
		a0.Parent = shell
		local a1 = Instance.new("Attachment")
		a1.Name = "BeamTop"
		a1.Position = Vector3.new(0, 70 + def.Tier * 10, 0)
		a1.Parent = shell
		local beam = Instance.new("Beam")
		beam.Name = "Pillar"
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Color = ColorSequence.new(def.Glow)
		beam.LightEmission = 1
		beam.LightInfluence = 0
		beam.FaceCamera = true
		beam.Width0 = 2.6 * s
		beam.Width1 = 0.6 * s
		beam.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(0.25, 0.6),
			NumberSequenceKeypoint.new(1, 1),
		})
		beam.Segments = 4
		beam.Parent = shell
	end
	return model
end

-- Moves an egg model (all parts keep their offsets from the shell).
function EggVisual.place(model: Model, cf: CFrame)
	model:PivotTo(cf)
end

return EggVisual
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000018">
				<Properties>
					<string name="Name">InventoryQuery</string>
					<ProtectedString name="Source"><![CDATA[--[[
	InventoryQuery
	Search / filter / sort over the player's actual dragon records.
	Pure function: same input -> same ordered list of UniqueIds.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))
local DragonStats = require(script.Parent:WaitForChild("DragonStats"))

local InventoryQuery = {}

InventoryQuery.Filters = { "All", "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret", "Exclusive" }
InventoryQuery.Sorts = { "Best", "Speed", "Income", "Level", "Rarity", "Newest" }

local function lower(s: string): string
	return string.lower(s)
end

local function matchesSearch(record, terms: { string }): boolean
	if #terms == 0 then
		return true
	end
	local species = DragonConfig.Species[record.SpeciesId]
	local mutation = MutationConfig.Mutations[record.Mutation]
	local haystack = lower(table.concat({
		record.Name or "",
		species and species.Name or "",
		record.Rarity or "",
		mutation and mutation.Name or "",
		record.Mutation or "",
	}, " "))
	for _, term in terms do
		if not string.find(haystack, term, 1, true) then
			return false
		end
	end
	return true
end

local comparators = {
	Best = function(a, b)
		return DragonStats.score(a), DragonStats.score(b)
	end,
	Speed = function(a, b)
		return a.FlightSpeed, b.FlightSpeed
	end,
	Income = function(a, b)
		return a.IncomePerSecond, b.IncomePerSecond
	end,
	Level = function(a, b)
		return a.Level + a.XP * 1e-9, b.Level + b.XP * 1e-9
	end,
	Rarity = function(a, b)
		return DragonConfig.rarityRank(a.Rarity) * 1e15 + a.IncomePerSecond,
			DragonConfig.rarityRank(b.Rarity) * 1e15 + b.IncomePerSecond
	end,
	Newest = function(a, b)
		return a.CreatedAt, b.CreatedAt
	end,
}

function InventoryQuery.splitTerms(search: string?): { string }
	local terms = {}
	if search then
		for term in string.gmatch(lower(search), "%S+") do
			table.insert(terms, term)
		end
	end
	return terms
end

-- dragons: { [uid]: DragonRecord }
-- opts: { Search: string?, Filter: string?, Sort: string? }
function InventoryQuery.run(dragons: { [string]: any }, opts: { Search: string?, Filter: string?, Sort: string? }): { string }
	local filter = opts.Filter or "All"
	local sortKey = opts.Sort or "Best"
	local terms = InventoryQuery.splitTerms(opts.Search)
	local list = {}
	for _, record in dragons do
		if (filter == "All" or record.Rarity == filter) and matchesSearch(record, terms) then
			table.insert(list, record)
		end
	end
	local cmp = comparators[sortKey] or comparators.Best
	table.sort(list, function(a, b)
		local va, vb = cmp(a, b)
		if va ~= vb then
			return va > vb
		end
		return a.UniqueId < b.UniqueId
	end)
	local out = table.create(#list)
	for i, record in list do
		out[i] = record.UniqueId
	end
	return out
end

return InventoryQuery
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000019">
				<Properties>
					<string name="Name">Net</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Net
	Single networking layer for the whole game.

	Client -> Server:  Net.request(domain, action, payload) -> { ok, err, msg, data }
	                   Net.fire(eventName, payload)          (low-frequency state events)
	Server -> Client:  Net.notify(player, kind, text, extra)
	                   Net.signal(player, name, payload) / Net.broadcast(name, payload)
	                   DataSync is handled by PlayerDataService.

	Server handlers are registered with Net.handle(domain, action, fn, rate).
	Every request is type-checked, rate limited and pcall-protected.
	RemoteEvents are never used for per-frame data.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local IS_SERVER = RunService:IsServer()
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local RequestRemote: RemoteFunction = Remotes:WaitForChild("Request")
local NotifyRemote: RemoteEvent = Remotes:WaitForChild("Notify")
local SignalRemote: RemoteEvent = Remotes:WaitForChild("Signal")
local ClientEventRemote: RemoteEvent = Remotes:WaitForChild("ClientEvent")

local Net = {}

local MAX_KEY_LENGTH = 40

-- ============================================================== validation helpers
Net.check = {}

function Net.check.str(v: any, maxLen: number?): boolean
	return type(v) == "string" and #v > 0 and #v <= (maxLen or 64)
end

function Net.check.num(v: any, min: number?, max: number?): boolean
	if type(v) ~= "number" or v ~= v or v == math.huge or v == -math.huge then
		return false
	end
	if min and v < min then
		return false
	end
	if max and v > max then
		return false
	end
	return true
end

function Net.check.int(v: any, min: number?, max: number?): boolean
	return Net.check.num(v, min, max) and math.floor(v) == v
end

function Net.check.bool(v: any): boolean
	return type(v) == "boolean"
end

-- ============================================================== server
if IS_SERVER then
	local Players = game:GetService("Players")

	local handlers = {}
	local eventHandlers = {}
	local buckets = {} -- [player][key] = { tokens, last }

	local DEFAULT_RATE = { Burst = 8, PerSecond = 4 }

	local function allow(player: Player, key: string, rate): boolean
		local pb = buckets[player]
		if not pb then
			pb = {}
			buckets[player] = pb
		end
		local now = os.clock()
		local b = pb[key]
		if not b then
			b = { tokens = rate.Burst, last = now }
			pb[key] = b
		end
		b.tokens = math.min(rate.Burst, b.tokens + (now - b.last) * rate.PerSecond)
		b.last = now
		if b.tokens < 1 then
			return false
		end
		b.tokens -= 1
		return true
	end

	-- fn(player, payload) -> (ok: boolean, errOrData: any?, msg: string?)
	function Net.handle(domain: string, action: string, fn, rate)
		local key = domain .. "." .. action
		assert(handlers[key] == nil, "Duplicate Net handler " .. key)
		handlers[key] = { fn = fn, rate = rate or DEFAULT_RATE }
	end

	-- fn(player, payload)
	function Net.onEvent(name: string, fn, rate)
		assert(eventHandlers[name] == nil, "Duplicate Net event " .. name)
		eventHandlers[name] = { fn = fn, rate = rate or DEFAULT_RATE }
	end

	function Net.notify(player: Player, kind: string, text: string, extra: { [string]: any }?)
		NotifyRemote:FireClient(player, kind, text, extra)
	end

	function Net.notifyAll(kind: string, text: string, extra: { [string]: any }?)
		NotifyRemote:FireAllClients(kind, text, extra)
	end

	function Net.signal(player: Player, name: string, payload: any)
		SignalRemote:FireClient(player, name, payload)
	end

	function Net.broadcast(name: string, payload: any)
		SignalRemote:FireAllClients(name, payload)
	end

	local function fail(err: string, msg: string?)
		return { ok = false, err = err, msg = msg }
	end

	function Net.start()
		RequestRemote.OnServerInvoke = function(player: Player, domain: any, action: any, payload: any)
			if type(domain) ~= "string" or type(action) ~= "string" or #domain > MAX_KEY_LENGTH or #action > MAX_KEY_LENGTH then
				return fail("BAD_REQUEST")
			end
			if payload ~= nil and type(payload) ~= "table" then
				return fail("BAD_REQUEST")
			end
			local key = domain .. "." .. action
			local h = handlers[key]
			if not h then
				return fail("UNKNOWN_ACTION")
			end
			if not allow(player, key, h.rate) then
				return fail("RATE_LIMITED", "Slow down!")
			end
			local okCall, ok, data, msg = pcall(h.fn, player, payload or {})
			if not okCall then
				warn(string.format("[Net] %s failed for %s: %s", key, player.Name, tostring(ok)))
				return fail("SERVER_ERROR", "Something went wrong. Try again.")
			end
			if ok then
				return { ok = true, data = data }
			end
			return fail(tostring(data or "FAILED"), msg)
		end

		ClientEventRemote.OnServerEvent:Connect(function(player: Player, name: any, payload: any)
			if type(name) ~= "string" or #name > MAX_KEY_LENGTH then
				return
			end
			if payload ~= nil and type(payload) ~= "table" then
				return
			end
			local h = eventHandlers[name]
			if not h or not allow(player, "evt." .. name, h.rate) then
				return
			end
			local ok, err = pcall(h.fn, player, payload or {})
			if not ok then
				warn(string.format("[Net] event %s failed for %s: %s", name, player.Name, tostring(err)))
			end
		end)

		Players.PlayerRemoving:Connect(function(player)
			buckets[player] = nil
		end)
	end
else
	-- ========================================================== client
	local Signal = require(script.Parent:WaitForChild("Util"):WaitForChild("Signal"))

	local signalListeners = {}
	Net.Notified = Signal.new()

	function Net.request(domain: string, action: string, payload: { [string]: any }?)
		local ok, result = pcall(RequestRemote.InvokeServer, RequestRemote, domain, action, payload)
		if not ok then
			return { ok = false, err = "NETWORK", msg = "Connection problem. Try again." }
		end
		if type(result) ~= "table" then
			return { ok = false, err = "BAD_RESPONSE" }
		end
		return result
	end

	function Net.fire(name: string, payload: { [string]: any }?)
		ClientEventRemote:FireServer(name, payload)
	end

	function Net.onSignal(name: string, fn)
		local list = signalListeners[name]
		if not list then
			list = {}
			signalListeners[name] = list
		end
		table.insert(list, fn)
		return function()
			local i = table.find(list, fn)
			if i then
				table.remove(list, i)
			end
		end
	end

	SignalRemote.OnClientEvent:Connect(function(name, payload)
		local list = signalListeners[name]
		if list then
			for _, fn in table.clone(list) do
				task.spawn(fn, payload)
			end
		end
	end)

	NotifyRemote.OnClientEvent:Connect(function(kind, text, extra)
		Net.Notified:Fire(kind, text, extra)
	end)
end

return Net
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000020">
				<Properties>
					<string name="Name">Odds</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Odds
	"1 in N" rarity titles (RNG style).

	A hatched dragon stores its true odds in record.Odds (egg table x luck x
	mutation chance at the moment it hatched). Dragons from other sources
	(starter, rewards, tests) get the base odds: species from its best egg x
	the mutation's hatch chance.

	Odds.format(n)  -> "1 in 12,500,000,000"
	Odds.color(n)   -> title colour by magnitude (white -> green -> blue ->
	                   purple -> orange -> pink -> red -> cyan)
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local EggConfig = require(Configs:WaitForChild("EggConfig"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))

local Odds = {}

local speciesCache: { [string]: number } = {}

-- P(species) from one egg's table (no luck).
function Odds.speciesChanceInEgg(eggType: string, speciesId: string): number
	local egg = EggConfig.Eggs[eggType]
	if not egg then
		return 0
	end
	local total, w = 0, 0
	for _, e in egg.Hatch do
		total += e.Weight
		if e.Id == speciesId then
			w += e.Weight
		end
	end
	return total > 0 and w / total or 0
end

-- Best chance of a species across all eggs (0 for exclusives).
function Odds.speciesChance(speciesId: string): number
	local cached = speciesCache[speciesId]
	if cached then
		return cached
	end
	local best = 0
	for eggType in EggConfig.Eggs do
		best = math.max(best, Odds.speciesChanceInEgg(eggType, speciesId))
	end
	speciesCache[speciesId] = best
	return best
end

function Odds.mutationChance(mutation: string?): number
	if mutation == nil or mutation == "None" then
		local miss = 1
		for i = 2, #MutationConfig.Order do
			local m = MutationConfig.Mutations[MutationConfig.Order[i]]
			miss *= 1 - (m.HatchChance or 0)
		end
		return miss
	end
	local m = MutationConfig.Mutations[mutation]
	return m and m.HatchChance or 1
end

local function oneIn(p: number): number
	if p <= 0 then
		return 0
	end
	return math.max(1, math.floor(1 / p + 0.5))
end
Odds.oneIn = oneIn

-- Base odds of a species + mutation (0 = not obtainable by rolling).
function Odds.base(speciesId: string, mutation: string?): number
	return oneIn(Odds.speciesChance(speciesId) * Odds.mutationChance(mutation))
end

-- Odds of one roll from a given egg (used by the roll animation).
function Odds.fromEgg(eggType: string, speciesId: string, mutation: string?): number
	return oneIn(Odds.speciesChanceInEgg(eggType, speciesId) * Odds.mutationChance(mutation))
end

function Odds.ofRecord(record): number
	if not record then
		return 0
	end
	local stored = tonumber(record.Odds)
	if stored and stored >= 1 then
		return stored
	end
	return Odds.base(record.SpeciesId, record.Mutation)
end

local function commas(n: number): string
	local s = string.format("%.0f", n)
	local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if out:sub(1, 1) == "," then
		out = out:sub(2)
	end
	return out
end

local SUFFIX = { "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

-- "1 in 12,500,000,000"; numbers beyond 15 digits are shortened ("1 in 2.5Qi").
function Odds.format(n: number, exclusive: boolean?): string
	if exclusive then
		return "EXCLUSIVE"
	end
	if not n or n <= 0 then
		return "1 in ???"
	end
	if n < 1e15 then
		return "1 in " .. commas(n)
	end
	local i = 0
	local v = n
	while v >= 1000 and i < #SUFFIX do
		v /= 1000
		i += 1
	end
	return "1 in " .. string.format("%.2f", v):gsub("%.?0+$", "") .. SUFFIX[i]
end

-- Title colour by how rare the roll is.
local TIERS = {
	{ 10, Color3.fromRGB(235, 235, 235) },
	{ 100, Color3.fromRGB(140, 230, 120) },
	{ 1000, Color3.fromRGB(90, 180, 255) },
	{ 10000, Color3.fromRGB(190, 120, 255) },
	{ 100000, Color3.fromRGB(255, 170, 50) },
	{ 1000000, Color3.fromRGB(255, 100, 190) },
	{ 1000000000, Color3.fromRGB(255, 70, 70) },
	{ math.huge, Color3.fromRGB(80, 255, 230) },
}

function Odds.color(n: number): Color3
	for _, t in TIERS do
		if (n or 0) < t[1] then
			return t[2]
		end
	end
	return TIERS[#TIERS][2]
end

-- 0..7 tier index (bigger = rarer), used for effects intensity.
function Odds.tier(n: number): number
	for i, t in TIERS do
		if (n or 0) < t[1] then
			return i - 1
		end
	end
	return #TIERS - 1
end

function Odds.isExclusive(speciesId: string): boolean
	local sp = DragonConfig.Species[speciesId]
	return sp ~= nil and sp.Exclusive == true
end

-- Display text for a record (handles exclusives).
function Odds.title(record): string
	if not record then
		return ""
	end
	if Odds.isExclusive(record.SpeciesId) then
		return "EXCLUSIVE"
	end
	return Odds.format(Odds.ofRecord(record))
end

return Odds
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000021">
				<Properties>
					<string name="Name">Types</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Types
	Shared data shapes. Server data is the source of truth; the client holds
	a read-only mirror kept in sync by DataSync.
]]

export type DragonRecord = {
	UniqueId: string,
	SpeciesId: string,
	Name: string,
	Rarity: string,
	Level: number,
	XP: number,
	Mutation: string, -- "None" | "Shiny" | "Golden" | "Shadow" | "Rainbow"
	Speed: number,
	FlightSpeed: number,
	IncomePerSecond: number,
	Locked: boolean,
	PlacedNestId: string, -- "" when not placed, otherwise nest index as string
	CreatedAt: number,
}

export type EggRecord = {
	Id: string,
	Type: string,
	FoundAt: number,
}

export type RequestResult = {
	ok: boolean,
	err: string?,
	msg: string?,
	data: any?,
}

return {}
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX000022">
				<Properties>
					<string name="Name">Util</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX000023">
					<Properties>
						<string name="Name">Format</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Format
	Number/cash/time formatting used by every UI surface so values look the
	same everywhere ($97.49M, 2.4M, 1 in 500,000, 4m 32s).
]]

local Format = {}

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local function trimZeros(s: string): string
	if string.find(s, "%.") then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, "%.$", "")
	end
	return s
end

-- Abbreviates with at most 2 decimals. Values are floored so a player is
-- never shown more than they actually have.
function Format.abbreviate(n: number, maxDecimals: number?): string
	if n ~= n then
		return "0"
	end
	local decimals = maxDecimals or 2
	local negative = n < 0
	n = math.abs(n)
	local result
	if n < 1000 then
		if n == math.floor(n) then
			result = tostring(math.floor(n))
		else
			result = trimZeros(string.format("%.1f", math.floor(n * 10) / 10))
		end
	else
		local tier = math.min(math.floor(math.log10(n) / 3), #SUFFIXES - 1)
		local scaled = n / 10 ^ (tier * 3)
		local factor = 10 ^ decimals
		scaled = math.floor(scaled * factor + 1e-7) / factor
		if scaled >= 1000 and tier < #SUFFIXES - 1 then
			tier += 1
			scaled = math.floor(n / 10 ^ (tier * 3) * factor + 1e-7) / factor
		end
		result = trimZeros(string.format("%." .. decimals .. "f", scaled)) .. SUFFIXES[tier + 1]
	end
	return (negative and "-" or "") .. result
end

function Format.cash(n: number): string
	if n < 0 then
		return "-$" .. Format.abbreviate(-n)
	end
	return "$" .. Format.abbreviate(n)
end

function Format.perSecond(n: number): string
	return Format.cash(n) .. "/s"
end

function Format.commas(n: number): string
	local negative = n < 0
	local s = tostring(math.floor(math.abs(n) + 0.5))
	local out = s
	while true do
		local replaced, count = string.gsub(out, "^(%d+)(%d%d%d)", "%1,%2")
		out = replaced
		if count == 0 then
			break
		end
	end
	return (negative and "-" or "") .. out
end

-- "1 in 500,000" from a probability in [0, 1].
function Format.odds(p: number): string
	if p <= 0 then
		return "1 in ∞"
	end
	if p >= 0.5 then
		return string.format("%d%%", math.floor(p * 100 + 0.5))
	end
	local inv = 1 / p
	if inv < 10 then
		return "1 in " .. trimZeros(string.format("%.1f", inv))
	end
	return "1 in " .. Format.commas(inv)
end

function Format.percent(p: number): string
	local v = p * 100
	if v >= 10 then
		return string.format("%d%%", math.floor(v + 0.5))
	elseif v >= 1 then
		return trimZeros(string.format("%.1f", v)) .. "%"
	elseif v >= 0.01 then
		return trimZeros(string.format("%.2f", v)) .. "%"
	end
	return trimZeros(string.format("%.4f", v)) .. "%"
end

function Format.duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local h = math.floor(seconds / 3600)
	local m = math.floor(seconds % 3600 / 60)
	local s = seconds % 60
	if h > 0 then
		return string.format("%dh %02dm", h, m)
	elseif m > 0 then
		return string.format("%dm %02ds", m, s)
	end
	return string.format("%ds", s)
end

-- 1 stud ~= 0.28 m
function Format.kmh(studsPerSecond: number): number
	return math.floor(studsPerSecond * 0.28 * 3.6 + 0.5)
end

function Format.level(level: number): string
	return "LV " .. tostring(math.floor(level))
end

return Format
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000024">
					<Properties>
						<string name="Name">MathUtil</string>
						<ProtectedString name="Source"><![CDATA[--[[
	MathUtil
	Frame-rate independent smoothing helpers. Every function that blends
	toward a target takes dt so behaviour is identical at 30, 60 or 240 FPS.
]]

local MathUtil = {}

local TAU = math.pi * 2

-- Alpha for exponential smoothing: fraction of the remaining distance
-- covered this frame. rate = 1/time-constant.
function MathUtil.expAlpha(rate: number, dt: number): number
	return 1 - math.exp(-rate * dt)
end

function MathUtil.expDecay(current: number, target: number, rate: number, dt: number): number
	return target + (current - target) * math.exp(-rate * dt)
end

function MathUtil.expDecayVec(current: Vector3, target: Vector3, rate: number, dt: number): Vector3
	return target + (current - target) * math.exp(-rate * dt)
end

function MathUtil.lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

function MathUtil.inverseLerp(a: number, b: number, v: number): number
	if a == b then
		return 0
	end
	return math.clamp((v - a) / (b - a), 0, 1)
end

function MathUtil.remap(v: number, a0: number, a1: number, b0: number, b1: number): number
	return b0 + (b1 - b0) * MathUtil.inverseLerp(a0, a1, v)
end

-- Wrap an angle to (-pi, pi].
function MathUtil.wrapAngle(a: number): number
	a = (a + math.pi) % TAU
	if a <= 0 then
		a += TAU
	end
	return a - math.pi
end

function MathUtil.angleDelta(from: number, to: number): number
	return MathUtil.wrapAngle(to - from)
end

function MathUtil.expDecayAngle(current: number, target: number, rate: number, dt: number): number
	local delta = MathUtil.angleDelta(current, target)
	return MathUtil.wrapAngle(current + delta * MathUtil.expAlpha(rate, dt))
end

-- Moves current toward target by at most maxDelta.
function MathUtil.approach(current: number, target: number, maxDelta: number): number
	if current < target then
		return math.min(current + maxDelta, target)
	end
	return math.max(current - maxDelta, target)
end

function MathUtil.approachAngle(current: number, target: number, maxDelta: number): number
	local delta = MathUtil.angleDelta(current, target)
	if math.abs(delta) <= maxDelta then
		return MathUtil.wrapAngle(target)
	end
	return MathUtil.wrapAngle(current + math.sign(delta) * maxDelta)
end

function MathUtil.smoothstep(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

function MathUtil.flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

function MathUtil.safeUnit(v: Vector3, fallback: Vector3?): Vector3
	local m = v.Magnitude
	if m < 1e-6 then
		return fallback or Vector3.zero
	end
	return v / m
end

-- Yaw (radians) of a horizontal direction; 0 = facing -Z (Roblox forward).
function MathUtil.yawOf(dir: Vector3): number
	return math.atan2(-dir.X, -dir.Z)
end

function MathUtil.dirFromYaw(yaw: number): Vector3
	return Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
end

function MathUtil.round(v: number, step: number?): number
	local s = step or 1
	return math.floor(v / s + 0.5) * s
end

return MathUtil
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000025">
					<Properties>
						<string name="Name">PromptGate</string>
						<ProtectedString name="Source"><![CDATA[--[[
	PromptGate
	World prompts (ProximityPrompt: the "E / F" bubbles) are switched off while something else
	owns the screen: riding a dragon, the hatch cinematic... Several reasons can be active at
	once; the prompts come back only when the last one is released.

	  PromptGate.set(reason, on)   on = true hides the prompts for that reason, false releases it
	  PromptGate.hidden()          true while any reason is active
]]

local ProximityPromptService = game:GetService("ProximityPromptService")

local PromptGate = {}

local reasons: { [string]: boolean } = {}

local function apply()
	ProximityPromptService.Enabled = next(reasons) == nil
end

function PromptGate.set(reason: string, on: boolean)
	reasons[reason] = on or nil
	apply()
end

function PromptGate.hidden(): boolean
	return next(reasons) ~= nil
end

return PromptGate
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000026">
					<Properties>
						<string name="Name">Signal</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Signal
	Lightweight script signal. Handlers run via task.spawn so one failing
	handler can never break the code that fired the signal.
]]

local Signal = {}
Signal.__index = Signal

export type Connection = {
	Connected: boolean,
	Disconnect: (self: Connection) -> (),
}

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false
	local handlers = self._signal._handlers
	local index = table.find(handlers, self)
	if index then
		table.remove(handlers, index)
	end
end
Connection.Destroy = Connection.Disconnect

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(fn: (...any) -> ())
	assert(type(fn) == "function", "Signal:Connect expects a function")
	local connection = setmetatable({ Connected = true, _signal = self, _fn = fn }, Connection)
	table.insert(self._handlers, connection)
	return connection
end

function Signal:Once(fn: (...any) -> ())
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		fn(...)
	end)
	return connection
end

function Signal:Fire(...)
	-- Snapshot so handlers can connect/disconnect while firing.
	local snapshot = table.clone(self._handlers)
	for _, connection in snapshot do
		if connection.Connected then
			task.spawn(connection._fn, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for _, connection in table.clone(self._handlers) do
		connection.Connected = false
	end
	table.clear(self._handlers)
end
Signal.Destroy = Signal.DisconnectAll

return Signal
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000027">
					<Properties>
						<string name="Name">Spring</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Spring
	Critically damped spring solved analytically, so it is exactly frame-rate
	independent (no integration error, no jitter at uneven frame times).
	Works for numbers and Vector3.

	frequency: response speed in Hz. ~1.5 = soft, ~4 = responsive, ~10 = snappy.
]]

local Spring = {}
Spring.__index = Spring

function Spring.new(initial: any, frequency: number)
	return setmetatable({
		Position = initial,
		Velocity = initial * 0,
		Target = initial,
		Omega = 2 * math.pi * frequency,
	}, Spring)
end

function Spring:SetFrequency(frequency: number)
	self.Omega = 2 * math.pi * frequency
end

function Spring:Reset(value: any)
	self.Position = value
	self.Target = value
	self.Velocity = value * 0
end

function Spring:Impulse(velocity: any)
	self.Velocity += velocity
end

function Spring:Update(dt: number)
	local w = self.Omega
	local x0 = self.Position - self.Target
	local v0 = self.Velocity
	local e = math.exp(-w * dt)
	local c2 = v0 + x0 * w
	self.Position = self.Target + (x0 + c2 * dt) * e
	self.Velocity = (v0 - c2 * (w * dt)) * e
	return self.Position
end

return Spring
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000028">
					<Properties>
						<string name="Name">TableUtil</string>
						<ProtectedString name="Source"><![CDATA[--[[
	TableUtil
]]

local TableUtil = {}

function TableUtil.deepCopy<T>(value: T): T
	if type(value) ~= "table" then
		return value
	end
	local out = {}
	for k, v in value :: any do
		out[TableUtil.deepCopy(k)] = TableUtil.deepCopy(v)
	end
	return (out :: any) :: T
end

function TableUtil.shallowCopy<T>(t: T): T
	return table.clone(t :: any) :: any
end

-- Fills keys missing from `target` with deep copies from `template`.
function TableUtil.reconcile(target: { [any]: any }, template: { [any]: any })
	for key, value in template do
		if target[key] == nil then
			target[key] = TableUtil.deepCopy(value)
		elseif type(value) == "table" and type(target[key]) == "table" and next(value) ~= nil and #value == 0 then
			TableUtil.reconcile(target[key], value)
		end
	end
	return target
end

function TableUtil.count(t: { [any]: any }): number
	local n = 0
	for _ in t do
		n += 1
	end
	return n
end

function TableUtil.keys(t: { [any]: any }): { any }
	local out = {}
	for k in t do
		table.insert(out, k)
	end
	return out
end

function TableUtil.values(t: { [any]: any }): { any }
	local out = {}
	for _, v in t do
		table.insert(out, v)
	end
	return out
end

function TableUtil.filter<T>(list: { T }, predicate: (T) -> boolean): { T }
	local out = {}
	for _, v in list do
		if predicate(v) then
			table.insert(out, v)
		end
	end
	return out
end

function TableUtil.map<T, U>(list: { T }, fn: (T) -> U): { U }
	local out = {}
	for i, v in list do
		out[i] = fn(v)
	end
	return out
end

function TableUtil.findWhere<T>(list: { T }, predicate: (T) -> boolean): T?
	for _, v in list do
		if predicate(v) then
			return v
		end
	end
	return nil
end

return TableUtil
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000029">
					<Properties>
						<string name="Name">Trove</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Trove
	Collects cleanup tasks (connections, instances, functions, objects with
	Destroy/Disconnect) and releases them all at once. Prevents leaks.
]]

local Trove = {}
Trove.__index = Trove

function Trove.new()
	return setmetatable({ _items = {} }, Trove)
end

function Trove:Add<T>(item: T): T
	table.insert(self._items, item)
	return item
end

function Trove:Connect(signal: any, fn: (...any) -> ())
	return self:Add(signal:Connect(fn))
end

local function cleanup(item: any)
	local kind = typeof(item)
	if kind == "function" then
		item()
	elseif kind == "RBXScriptConnection" then
		item:Disconnect()
	elseif kind == "Instance" then
		item:Destroy()
	elseif kind == "thread" then
		pcall(task.cancel, item)
	elseif kind == "table" then
		if type(item.Destroy) == "function" then
			item:Destroy()
		elseif type(item.Disconnect) == "function" then
			item:Disconnect()
		end
	end
end

function Trove:Remove(item: any)
	local index = table.find(self._items, item)
	if index then
		table.remove(self._items, index)
		cleanup(item)
	end
end

function Trove:Clean()
	local items = self._items
	self._items = {}
	for i = #items, 1, -1 do
		cleanup(items[i])
	end
end
Trove.Destroy = Trove.Clean

return Trove
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000030">
					<Properties>
						<string name="Name">WeightedRandom</string>
						<ProtectedString name="Source"><![CDATA[--[[
	WeightedRandom
	pick(entries, rng) where entries = { { Id = any, Weight = number }, ... }
]]

local WeightedRandom = {}

function WeightedRandom.total(entries: { { Weight: number } }): number
	local sum = 0
	for _, e in entries do
		sum += math.max(0, e.Weight)
	end
	return sum
end

function WeightedRandom.pick<T>(entries: { T }, rng: Random): T
	local total = WeightedRandom.total(entries :: any)
	assert(total > 0, "WeightedRandom.pick: total weight must be > 0")
	local roll = rng:NextNumber(0, total)
	local acc = 0
	for _, e in entries do
		acc += math.max(0, (e :: any).Weight)
		if roll < acc then
			return e
		end
	end
	return entries[#entries]
end

return WeightedRandom
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX000031">
			<Properties>
				<string name="Name">Configs</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX000032">
				<Properties>
					<string name="Name">AdminConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
    AdminConfig
    Live-server admin permissions for chat commands.

    The experience shown in Studio is group-owned, so CreatorId may be a group id.
    "Bendzaminoo" is included explicitly so the owner can use the commands immediately.
    Add additional Roblox usernames or numeric UserIds here when needed.
]]

return {
    -- Exact Roblox usernames (case-insensitive). Display names are NOT used for permissions.
    AdminUsernames = {
        "Bendzaminoo",
    },

    -- Prefer UserIds for any additional admins because usernames can change.
    AdminUserIds = {
        -- 123456789,
    },

    -- If the experience is personally owned (not group-owned), its creator is also an admin.
    AllowUserCreator = true,

    -- Anyone is allowed to use the commands while testing inside Roblox Studio.
    AllowEveryoneInStudio = true,

    -- Safety limits for one command.
    MaxItemCount = 100,
    MaxSpins = 1000000,
    MaxCash = 1000000000000000,
}
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000033">
				<Properties>
					<string name="Name">AudioConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	AudioConfig
	Every sound the game plays is referenced by key. Ids that ship with the
	Roblox client (rbxasset://sounds/...) are used where suitable; the rest are
	left empty so you can paste Creator Store audio ids without code changes.
	An empty Id is skipped silently (no errors, no load warnings).

	Suggested Creator Store searches are in the comments.
]]

local AudioConfig = {}

AudioConfig.Groups = {
	Music = { Volume = 0.45 },
	Ambient = { Volume = 0.6 },
	SFX = { Volume = 0.8 },
	UI = { Volume = 0.6 },
}

AudioConfig.Sounds = {
	-- Music (search: "fantasy orchestral loop", "calm adventure")
	MusicHaven = { Id = "", Group = "Music", Volume = 0.5, Looped = true },
	MusicFrost = { Id = "", Group = "Music", Volume = 0.5, Looped = true },
	MusicEmber = { Id = "", Group = "Music", Volume = 0.5, Looped = true },
	MusicSky = { Id = "", Group = "Music", Volume = 0.5, Looped = true },

	-- Ambience
	Wind = { Id = "rbxasset://sounds/action_falling.mp3", Group = "Ambient", Volume = 0, Looped = true },
	Waterfall = { Id = "", Group = "Ambient", Volume = 0.6, Looped = true, RollOffMax = 260 }, -- "waterfall loop"
	Birds = { Id = "", Group = "Ambient", Volume = 0.3, Looped = true }, -- "forest birds ambience"

	-- Dragon (3D)
	Footstep = { Id = "rbxasset://sounds/action_jump_land.mp3", Group = "SFX", Volume = 0.35, Pitch = 0.55, RollOffMax = 120 },
	WingFlap = { Id = "", Group = "SFX", Volume = 0.7, RollOffMax = 180 }, -- "wing flap"
	Roar = { Id = "", Group = "SFX", Volume = 0.9, RollOffMax = 400 }, -- "dragon roar"
	Takeoff = { Id = "rbxasset://sounds/action_jump.mp3", Group = "SFX", Volume = 0.6, Pitch = 0.5, RollOffMax = 200 },
	Landing = { Id = "rbxasset://sounds/action_jump_land.mp3", Group = "SFX", Volume = 0.9, Pitch = 0.42, RollOffMax = 200 },
	Splash = { Id = "rbxasset://sounds/impact_water.mp3", Group = "SFX", Volume = 0.7, RollOffMax = 200 },
	Eat = { Id = "", Group = "SFX", Volume = 0.6 }, -- "munch"

	-- Eggs & hatching
	EggPickup = { Id = "", Group = "SFX", Volume = 0.7 }, -- "pickup chime"
	CoinPickup = { Id = "", Group = "SFX", Volume = 0.55 }, -- "coin clink"
	CoinChain = { Id = "", Group = "UI", Volume = 0.5 }, -- "rising chime" (3+ coins in a chain)
	EggPlace = { Id = "", Group = "SFX", Volume = 0.6 }, -- "soft thud" / "wood tap" (egg set into the nest)
	EggShake = { Id = "", Group = "SFX", Volume = 0.5 }, -- "wood creak" / "egg wobble"
	EggCrack = { Id = "", Group = "SFX", Volume = 0.8 }, -- "egg crack"
	Hatch = { Id = "", Group = "SFX", Volume = 0.9 }, -- "magic burst"
	RareHatch = { Id = "", Group = "SFX", Volume = 1 }, -- "epic reveal fanfare"

	-- Race & duels (Race Island)
	RaceCount = { Id = "", Group = "UI", Volume = 0.8 }, -- "countdown beep"
	RaceGo = { Id = "", Group = "UI", Volume = 0.9 }, -- "race start horn"
	RaceGate = { Id = "", Group = "UI", Volume = 0.4 }, -- "checkpoint ding"
	RaceBoost = { Id = "", Group = "SFX", Volume = 0.7 }, -- "speed boost whoosh"
	RaceFinish = { Id = "", Group = "UI", Volume = 0.9 }, -- "finish fanfare"
	Strike = { Id = "", Group = "SFX", Volume = 0.8, RollOffMax = 200 }, -- "claw swipe" / "bite"
	Blast = { Id = "", Group = "SFX", Volume = 0.9, RollOffMax = 260 }, -- "fireball cast"
	Hit = { Id = "", Group = "SFX", Volume = 0.8, RollOffMax = 200 }, -- "punch impact"
	Knockout = { Id = "", Group = "UI", Volume = 0.9 }, -- "knockout sting"
	DuelStart = { Id = "", Group = "UI", Volume = 0.8 }, -- "battle start sting"

	-- Economy & UI
	Collect = { Id = "", Group = "SFX", Volume = 0.7 }, -- "coins collect"
	Purchase = { Id = "", Group = "UI", Volume = 0.7 }, -- "purchase success"
	Click = { Id = "", Group = "UI", Volume = 0.5 }, -- "ui click soft"
	Hover = { Id = "", Group = "UI", Volume = 0.25 }, -- "ui hover tick"
	Open = { Id = "", Group = "UI", Volume = 0.45 }, -- "ui whoosh soft"
	Close = { Id = "", Group = "UI", Volume = 0.4 },
	Error = { Id = "", Group = "UI", Volume = 0.5 }, -- "ui error"
	Notify = { Id = "", Group = "UI", Volume = 0.45 },
	LevelUp = { Id = "", Group = "UI", Volume = 0.8 }, -- "level up"
}

return table.freeze(AudioConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000034">
				<Properties>
					<string name="Name">BondConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	BondConfig
	Dragon Bond: the longer you ride ONE dragon, the stronger your bond with it
	(data.Dragons[uid].BondXP, stored per dragon, so everyone has "their" main
	dragon). Bond level is derived from the points; perks unlock by level:

	  level  5   Wind Dash        Q / B       burst of speed
	  level 10   Fire Breath      E (hold)    flames you can aim, burns Burnable things
	  level 20   Sky Dance        Z           showy barrel roll / rear-up flourish
	  level 50   Bond Aura        (automatic) exclusive golden aura around the dragon

	Points: 1 per second ridden on the ground-or-air, more in flight; the server
	only counts seconds in which the dragon actually moved (no AFK farming).
]]

local BondConfig = {}

BondConfig.MaxLevel = 50
BondConfig.PointsScale = 30 -- points needed to REACH level n = PointsScale * n^2
BondConfig.TickSeconds = 5
BondConfig.MinMove = 4 -- studs a dragon must have moved during a tick to earn points

-- Points per second while riding.
BondConfig.Rate = { Ground = 0.6, Fly = 1.0, Boost = 1.5 }

BondConfig.Perks = {
	{ Id = "Dash", Level = 5, Name = "Wind Dash", Key = "Q", Gamepad = "B", Text = "Burst forward in a blink of wind." },
	{ Id = "Fire", Level = 10, Name = "Fire Breath", Key = "E", Gamepad = "LB", Text = "Hold to breathe fire. Burns Burnable things." },
	{ Id = "Flourish", Level = 20, Name = "Sky Dance", Key = "Z", Gamepad = "RB", Text = "A show-off dance: barrel roll in the air, rear up on the ground." },
	{ Id = "Aura", Level = 50, Name = "Bond Aura", Key = nil, Gamepad = nil, Text = "An exclusive golden aura that follows your dragon." },
}

BondConfig.PerkById = {}
for _, p in BondConfig.Perks do
	BondConfig.PerkById[p.Id] = p
end

-- Ability tuning (server validates cooldowns and duration; clients animate).
BondConfig.Abilities = {
	Dash = { Cooldown = 6, Duration = 0.45, Multiplier = 2.7, Allowance = 1.4 },
	Fire = { Cooldown = 3.5, MaxSeconds = 3.5, Range = 46, Tick = 0.25 },
	Flourish = { Cooldown = 7, Duration = 1.7 },
}

function BondConfig.threshold(level: number): number
	return math.floor(BondConfig.PointsScale * level * level)
end

function BondConfig.levelFor(points: number?): number
	local p = math.max(0, tonumber(points) or 0)
	return math.clamp(math.floor(math.sqrt(p / BondConfig.PointsScale)), 0, BondConfig.MaxLevel)
end

-- level, points into the level, points needed for the next one (0 at max)
function BondConfig.progress(points: number?): (number, number, number)
	local p = math.max(0, tonumber(points) or 0)
	local level = BondConfig.levelFor(p)
	if level >= BondConfig.MaxLevel then
		return level, 0, 0
	end
	local base = BondConfig.threshold(level)
	return level, p - base, BondConfig.threshold(level + 1) - base
end

function BondConfig.has(points: number?, perkId: string): boolean
	local perk = BondConfig.PerkById[perkId]
	return perk ~= nil and BondConfig.levelFor(points) >= perk.Level
end

-- Next perk the bond level has not reached yet (nil when all are unlocked).
function BondConfig.nextPerk(level: number)
	for _, p in BondConfig.Perks do
		if level < p.Level then
			return p
		end
	end
	return nil
end

-- Perks unlocked when going from level `from` (exclusive) to `to` (inclusive).
function BondConfig.unlockedBetween(from: number, to: number)
	local out = {}
	for _, p in BondConfig.Perks do
		if p.Level > from and p.Level <= to then
			table.insert(out, p)
		end
	end
	return out
end

return table.freeze(BondConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000035">
				<Properties>
					<string name="Name">CoinConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	CoinConfig
	Coins to collect on the map (CoinService / CoinController / CoinLayout).

	Three kinds:
	  Copper  small coins on trails along the roads: for walkers and low flyers
	  Gold    big sky coins in arcs above the roads: for riders
	  Gem     treasure piles at the landmarks (ruins, waterfall, caves, pillar, island, forests,
	          the ends of the roads): rare and rich

	A coin is worth some seconds of the player's income (so it stays worth picking up as the
	game goes on) with a floor for new players. Coins collected within a short time of each other
	build a CHAIN: every coin in the chain pays a bit more (up to x3). Every player has their
	own coins: they come back on their own timer.
]]

local CoinConfig = {}

CoinConfig.Kinds = {
	Copper = {
		Name = "Coin",
		Code = "c",
		Seconds = 0.6, -- worth this many seconds of income...
		Min = 6, -- ...but at least this much cash
		Respawn = 75, -- seconds until the player sees it again
		Radius = 9, -- pickup radius (studs, client)
		Size = 2.8, -- coin diameter
		Color = Color3.fromRGB(255, 196, 48),
		Rim = Color3.fromRGB(214, 150, 20),
	},
	Gold = {
		Name = "Sky Coin",
		Code = "g",
		Seconds = 2,
		Min = 20,
		Respawn = 100,
		Radius = 16,
		Size = 4.6,
		Color = Color3.fromRGB(255, 226, 90),
		Rim = Color3.fromRGB(255, 160, 30),
	},
	Gem = {
		Name = "Treasure",
		Code = "j",
		Seconds = 30,
		Min = 150,
		Respawn = 600,
		Radius = 14,
		Size = 4.2,
		Color = Color3.fromRGB(90, 230, 255),
		Rim = Color3.fromRGB(190, 110, 255),
	},
}

-- layout string code -> kind id
CoinConfig.KindOfCode = {}
for id, kind in CoinConfig.Kinds do
	CoinConfig.KindOfCode[kind.Code] = id
end

-- Coins collected within `Window` seconds of the previous one extend the chain; each coin of the
-- chain pays (1 + Step * (n - 1)) times its value, at most Max.
CoinConfig.Chain = { Window = 2.5, Step = 0.25, Max = 3 }

-- How far (studs) from a coin the server still accepts the pickup: the radius the client uses
-- plus this slack for lag and the speed of a dragon.
CoinConfig.ServerSlack = 42

-- The client builds the coins within this many studs of the camera / player.
CoinConfig.ViewRadius = 460

-- The client sends the touched coins in batches.
CoinConfig.Batch = { Size = 12, Interval = 0.2 }

-- Layout (the trails and arcs are generated from WorldConfig; see CoinLayout)
CoinConfig.Layout = {
	Spacing = 22, -- studs between the coins of a trail
	Weave = 5, -- the trail swings this far (studs) left and right of the road
	FromHub = 110, -- no coins closer than this to the village centre
	Lift = 3.4, -- height above the ground of a ground coin
	ArcCoins = 9, -- coins in a sky arc
	ArcSpacing = 36, -- studs between the coins of an arc
	ArcLift = { 62, 104 }, -- height above the ground at the ends / the top of an arc
	ArcEvery = 340, -- one arc per this many studs of road
	MaxSlope = 0.55, -- no ground coins where the ground is steeper than this (normal.Y below it)
}

-- Cash a coin is worth right now.
function CoinConfig.value(kindId: string, incomePerSecond: number): number
	local kind = CoinConfig.Kinds[kindId]
	if not kind then
		return 0
	end
	return math.max(kind.Min, math.floor(incomePerSecond * kind.Seconds + 0.5))
end

-- Pay multiplier of the n-th coin of a chain (n = 1 is the first coin).
function CoinConfig.multiplier(n: number): number
	local c = CoinConfig.Chain
	return math.min(c.Max, 1 + c.Step * (math.max(1, n) - 1))
end

return CoinConfig
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000036">
				<Properties>
					<string name="Name">CombatConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	CombatConfig
	Dragon duels in the arena of the Race & Battle Island. Inside the arena (and only there)
	riders can hit each other:

	  STRIKE (F / tap)   a bite and tail slam in front of you: short range, quick, reliable
	  BLAST  (G / tap)   a fireball: long range, slow to recharge, needs aiming

	Everybody has hit points from their dragon (level and rarity, not from how much it earns), so a
	fresh dragon is never helpless against a legend but the better dragon has the edge.
	The server decides hits, damage, knockouts and respawns; clients only ask and draw.
]]

local RaceConfig = require(script.Parent:WaitForChild("RaceConfig"))

local CombatConfig = {}

-- Island-local arena cylinder (the dragons fly inside it as well).
CombatConfig.Arena = {
	Center = Vector3.new(0, 0, 98),
	Radius = 46,
	Height = 150, -- the top of the cylinder above the floor
}
CombatConfig.Entrance = Vector3.new(0, 0, 36) -- the prompt "Enter the Arena" (a walkway towards it)
CombatConfig.Respawns = { -- island-local spots (floor level), facing the centre
	Vector3.new(-34, 0, 98),
	Vector3.new(34, 0, 98),
	Vector3.new(0, 0, 64),
	Vector3.new(0, 0, 132),
}

-- Hit points: Base + PerLevel * level + PerRank * rarity rank (rank 1..8)
CombatConfig.HP = { Base = 800, PerLevel = 14, PerRank = 150 }
-- Damage per hit: Base + PerLevel * level + PerRank * rarity rank, multiplied per attack
CombatConfig.Damage = { Base = 70, PerLevel = 0.9, PerRank = 14 }

CombatConfig.Strike = {
	Multiplier = 1.0,
	Cooldown = 0.75,
	Reach = 17, -- studs from the dragon's centre (plus its body radius)
	Cone = 78, -- degrees either side of where you look
	Crit = 0.1, -- chance of a x1.5 hit
}

CombatConfig.Blast = {
	Multiplier = 1.7,
	Cooldown = 3.6,
	Speed = 170, -- studs per second
	Radius = 5.5, -- hit radius around the fireball (plus the target's body radius)
	Lifetime = 1.5,
	Step = 0.05, -- server simulation step
}

-- The training dummy in the middle of the arena: a target on a pole for trying your damage out.
-- Hits count like duel hits (crits, cooldowns) but it pays nothing and does not hit back.
CombatConfig.Dummy = {
	Name = "Training Dummy",
	Position = Vector3.new(0, 0, 98), -- island-local, on the arena floor
	Height = 13, -- the target's centre above the island surface
	Radius = 7,
	HP = 4000,
	Respawn = 4,
}

CombatConfig.RespawnDelay = 3
CombatConfig.Invulnerable = 3 -- seconds of protection after a respawn / after entering
CombatConfig.RegenPerSecond = 0.012 -- fraction of max HP, only when nobody hit you for 6 s
CombatConfig.RegenDelay = 6
CombatConfig.MaxAimSlack = 45 -- degrees the claimed look direction may differ from the dragon's heading

-- A kill pays minutes of the killer's sanctuary income (at least Min) + XP.
CombatConfig.KillReward = { Minutes = 4, Min = 4000, XP = 30 }

-- The server samples who is inside the arena this often.
CombatConfig.ZoneSeconds = 0.25

function CombatConfig.arenaWorld(): (Vector3, number, number)
	local a = CombatConfig.Arena
	return RaceConfig.toWorld(a.Center), a.Radius, a.Height
end

-- World position of the dummy's target (what strikes and fireballs aim at).
function CombatConfig.dummyWorld(): Vector3
	local d = CombatConfig.Dummy
	local p = RaceConfig.toWorld(d.Position)
	return Vector3.new(p.X, p.Y + d.Height, p.Z)
end

-- Max hit points / damage of a dragon record.
function CombatConfig.maxHP(level: number, rank: number): number
	local c = CombatConfig.HP
	return math.floor(c.Base + c.PerLevel * level + c.PerRank * rank + 0.5)
end

function CombatConfig.baseDamage(level: number, rank: number): number
	local c = CombatConfig.Damage
	return c.Base + c.PerLevel * level + c.PerRank * rank
end

return CombatConfig
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000037">
				<Properties>
					<string name="Name">DailyConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DailyConfig
	The daily reward calendar (DailyService / DailyWindow). One reward a day (UTC days); claiming on
	consecutive days builds a streak that walks through the 7 days of the calendar and starts again.
	Missing a whole day resets the streak. Every full week adds 10% to the cash of the calendar
	(at most +100%).

	A day lists any of:
	  Cash   = { Seconds, Min }       worth that many seconds of the player's income (at least Min)
	  Spins  = n                      spin tickets
	  Boost  = { Id, Seconds }        a timed boost (MonetizationConfig.Boosts)
	  Egg    = { Type, Luck }         an egg straight into the bag (never refused)
]]

local DailyConfig = {}

DailyConfig.Cycle = 7
DailyConfig.WeekBonus = 0.1 -- per completed week
DailyConfig.MaxBonus = 1.0

DailyConfig.Days = {
	{ Cash = { Seconds = 120, Min = 1000 } },
	{ Spins = 2 },
	{ Boost = { Id = "Luck", Seconds = 300 } },
	{ Cash = { Seconds = 300, Min = 3000 } },
	{ Spins = 3, Cash = { Seconds = 120, Min = 1500 } },
	{ Egg = { Type = "GoldenEgg", Luck = 5 } },
	{ Cash = { Seconds = 900, Min = 10000 }, Spins = 5, Egg = { Type = "CelestialEgg", Luck = 10 } },
}

DailyConfig.SecondsPerDay = 86400

-- UTC day number of a time stamp.
function DailyConfig.dayOf(t: number): number
	return math.floor(t / DailyConfig.SecondsPerDay)
end

-- Cash multiplier of the streak (1 + 10% per completed week).
function DailyConfig.bonus(streak: number): number
	return 1 + math.min(DailyConfig.MaxBonus, math.floor(math.max(0, streak) / DailyConfig.Cycle) * DailyConfig.WeekBonus)
end

-- Cash of one calendar day for a given income and streak.
function DailyConfig.cash(day: number, incomePerSecond: number, streak: number): number
	local def = DailyConfig.Days[day]
	if not def or not def.Cash then
		return 0
	end
	return math.floor(math.max(def.Cash.Min, incomePerSecond * def.Cash.Seconds) * DailyConfig.bonus(streak) + 0.5)
end

return DailyConfig
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000038">
				<Properties>
					<string name="Name">DragonConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DragonConfig
	Species definitions, rarity table, level curve and stat formulas.
	Stats here are BASE values at level 1 with no mutation.

	INCOME LADDER (base $/s at level 1, no mutation): Common 2-4.5, Uncommon 9-19, Rare 60-160, Epic 520-1,100,
	Legendary 6.5K-12.5K, Mythic 55K-85K, Secret 650K-1.1M (about x5-x12 per rarity). Level adds +8% per level,
	mutations x1.5 to x25. FeedCost = 4 x base income (see EconomyConfig.feedCost). The four Robux exclusives
	keep their own scale (they are the paid, strongest dragons).

	Speed / FlightSpeed are "power" stats shown in the UI (can reach millions).
	Actual movement speed in studs/s is derived with a log curve in GameConfig
	so higher tiers always feel faster without breaking streaming/physics.
]]

local DragonConfig = {}

DragonConfig.RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret", "Exclusive" }

DragonConfig.Rarities = {
	Common = { Rank = 1, Color = Color3.fromRGB(184, 192, 200), Glow = Color3.fromRGB(220, 226, 232), HatchXP = 20 },
	Uncommon = { Rank = 2, Color = Color3.fromRGB(110, 208, 104), Glow = Color3.fromRGB(150, 240, 140), HatchXP = 45 },
	Rare = { Rank = 3, Color = Color3.fromRGB(77, 163, 255), Glow = Color3.fromRGB(130, 195, 255), HatchXP = 110 },
	Epic = { Rank = 4, Color = Color3.fromRGB(178, 102, 255), Glow = Color3.fromRGB(205, 150, 255), HatchXP = 260 },
	Legendary = { Rank = 5, Color = Color3.fromRGB(255, 176, 32), Glow = Color3.fromRGB(255, 210, 110), HatchXP = 700 },
	Mythic = { Rank = 6, Color = Color3.fromRGB(255, 79, 154), Glow = Color3.fromRGB(255, 140, 190), HatchXP = 1800 },
	Secret = { Rank = 7, Color = Color3.fromRGB(64, 236, 214), Glow = Color3.fromRGB(150, 255, 240), HatchXP = 5000 },
	-- not hatchable: Robux exclusives (Owner Dragon)
	Exclusive = { Rank = 8, Color = Color3.fromRGB(255, 64, 64), Glow = Color3.fromRGB(255, 190, 90), HatchXP = 0 },
}

DragonConfig.MaxLevel = 50

-- XP needed to go from `level` to `level + 1`.
function DragonConfig.xpToNext(level: number): number
	return math.floor(80 * level ^ 1.45 + 0.5)
end

-- Stat multiplier from level (linear, +8% of base per level).
function DragonConfig.levelMultiplier(level: number): number
	return 1 + 0.08 * (math.clamp(level, 1, DragonConfig.MaxLevel) - 1)
end

