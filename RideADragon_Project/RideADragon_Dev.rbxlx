			<Item class="ModuleScript" referent="RBX000104">
				<Properties>
					<string name="Name">HavenTerrainData</string>
					<ProtectedString name="Source"><![CDATA[-- GENERATED by toolchain/worldgen/terrain_data.py - do not edit by hand.
