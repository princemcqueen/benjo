builders.Wing = function(root, col, acc)
	rect(root, 0.52, 0.32, 0.84, 0.15, col, 0.5, -22)
	rect(root, 0.46, 0.52, 0.7, 0.15, col, 0.5, -16)
	rect(root, 0.4, 0.71, 0.52, 0.15, acc, 0.5, -10)
