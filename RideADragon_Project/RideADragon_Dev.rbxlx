end

builders.Wind = function(root, col, acc)
	rect(root, 0.46, 0.3, 0.72, 0.12, col, 0.5)
	rect(root, 0.56, 0.5, 0.72, 0.12, acc, 0.5)
	rect(root, 0.42, 0.7, 0.56, 0.12, col, 0.5)
end

builders.Home = function(root, col, acc, ink)
	rect(root, 0.33, 0.36, 0.5, 0.13, col, 0.5, -40)
	rect(root, 0.67, 0.36, 0.5, 0.13, col, 0.5, 40)
	rect(root, 0.5, 0.68, 0.6, 0.46, col, 0.08)
	rect(root, 0.5, 0.76, 0.18, 0.3, ink, 0.2)
end

builders.Plus = function(root, col)
	rect(root, 0.5, 0.5, 0.74, 0.15, col, 0.5)
	rect(root, 0.5, 0.5, 0.15, 0.74, col, 0.5)
end

builders.Trophy = function(root, col, acc)
	rect(root, 0.5, 0.36, 0.56, 0.5, col, 0.35)
	ring(root, root, 0.24, 0.34, 0.24, 0.26, 0.06, col)
	ring(root, root, 0.76, 0.34, 0.24, 0.26, 0.06, col)
	rect(root, 0.5, 0.68, 0.12, 0.22, col, 0)
	rect(root, 0.5, 0.84, 0.46, 0.1, acc, 0.3)
end

builders.Info = function(root, col, acc, ink)
	circle(root, 0.5, 0.5, 0.9, col)
	circle(root, 0.5, 0.3, 0.13, ink)
	rect(root, 0.5, 0.62, 0.13, 0.36, ink, 0.4)
end

builders.Warning = function(root, col, acc, ink)
	circle(root, 0.5, 0.5, 0.9, col)
	rect(root, 0.5, 0.42, 0.13, 0.4, ink, 0.4)
	circle(root, 0.5, 0.73, 0.13, ink)
end

builders.Map = function(root, col, acc)
	rect(root, 0.26, 0.5, 0.26, 0.76, col, 0.1, -4)
	rect(root, 0.5, 0.5, 0.26, 0.76, acc, 0.1, 4)
	rect(root, 0.74, 0.5, 0.26, 0.76, col, 0.1, -4)
end

builders.Flame = function(root, col, acc)
	rect(root, 0.5, 0.6, 0.62, 0.62, acc, 0.5)
	rect(root, 0.5, 0.42, 0.36, 0.36, acc, 0.15, 45)
	rect(root, 0.5, 0.66, 0.3, 0.36, col, 0.5)
end

function Icons.make(name: string, colors: { Color: Color3?, Accent: Color3?, Ink: Color3? }?): Frame
	local opts = colors or {}
	local root = box()
	root.Name = "Icon_" .. name
	local builder = builders[name] or builders.Info
	builder(root, opts.Color or C.Text, opts.Accent or C.Accent, opts.Ink or C.Panel)
	return root
end

function Icons.has(name: string): boolean
	return builders[name] ~= nil
end

-- Recolors the primary color of an icon (primitives using `from` become `to`).
function Icons.recolor(icon: Frame, from: Color3, to: Color3)
	for _, d in icon:GetDescendants() do
		if d:IsA("Frame") and d.BackgroundColor3 == from then
			d.BackgroundColor3 = to
		elseif d:IsA("UIStroke") and d.Color == from then
			d.Color = to
		end
	end
end

Icons.Names = {}
for name in builders do
	table.insert(Icons.Names, name)
end
table.sort(Icons.Names)

return Icons
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000128">
					<Properties>
						<string name="Name">Kit</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Kit
	The component library every menu is built from. One look, one behaviour:
	consistent radii, strokes, typography, hover/press feedback.

	All primary geometry is Scale/AnchorPoint based. Offsets are only used for
	padding, corner radius, stroke width and text size - and those are bound
	to the Responsive unit so they keep their relative size from 720p to 4K.
]]

local TweenService = game:GetService("TweenService")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)

local UI = script.Parent
local Theme = require(UI:WaitForChild("Theme"))
local Responsive = require(UI:WaitForChild("Responsive"))
local Create = require(UI:WaitForChild("Create"))
local Icons = require(UI:WaitForChild("Icons"))

local C = Theme.Colors
local T = Theme.Transparency

local Kit = {}

-- Hooks set by UIController (sounds, tooltips).
Kit.hooks = {
	Click = function() end,
	Hover = function() end,
	ShowTooltip = function(_text: string, _anchor: GuiObject) end,
	HideTooltip = function() end,
}

-- ============================================================== helpers
local function tween(inst: Instance, time: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local t = TweenService:Create(inst, TweenInfo.new(time, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	t:Play()
	return t
end
Kit.tween = tween

function Kit.corner(parent: Instance, radius: number | string)
	local c = Instance.new("UICorner")
	if radius == "pill" then
		c.CornerRadius = UDim.new(0.5, 0)
	else
		local px = type(radius) == "number" and radius or Theme.Radius[radius] or Theme.Radius.Button
		Responsive.bind(c, "CornerRadius", function(R)
			return UDim.new(0, R.px(px))
		end)
	end
	c.Parent = parent
	return c
end

function Kit.stroke(parent: Instance, color: Color3, thickness: number?, transparency: number?)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Transparency = transparency or 0
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	local th = thickness or Theme.Stroke.Normal
	Responsive.bind(s, "Thickness", function(R)
		return math.max(1, R.pxf(th))
	end)
	s.Parent = parent
	return s
end

function Kit.padding(parent: Instance, top: number, right: number?, bottom: number?, left: number?)
	local p = Instance.new("UIPadding")
	local r, b, l = right or top, bottom or top, left or right or top
	Responsive.bind(p, "PaddingTop", function(R)
		return UDim.new(0, R.px(top))
	end)
	Responsive.bind(p, "PaddingRight", function(R)
		return UDim.new(0, R.px(r))
	end)
	Responsive.bind(p, "PaddingBottom", function(R)
		return UDim.new(0, R.px(b))
	end)
	Responsive.bind(p, "PaddingLeft", function(R)
		return UDim.new(0, R.px(l))
	end)
	p.Parent = parent
	return p
end

-- Padding as a fraction of the parent's size (pure scale).
function Kit.scalePadding(parent: Instance, top: number, right: number?, bottom: number?, left: number?)
	return Create("UIPadding", {
		PaddingTop = UDim.new(top, 0),
		PaddingRight = UDim.new(right or top, 0),
		PaddingBottom = UDim.new(bottom or top, 0),
		PaddingLeft = UDim.new(left or right or top, 0),
		Parent = parent,
	})
end

function Kit.list(parent: Instance, direction: "H" | "V", gapPx: number?, hAlign: Enum.HorizontalAlignment?, vAlign: Enum.VerticalAlignment?)
	local l = Instance.new("UIListLayout")
	l.FillDirection = direction == "H" and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical
	l.SortOrder = Enum.SortOrder.LayoutOrder
	l.HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left
	l.VerticalAlignment = vAlign or Enum.VerticalAlignment.Top
	if gapPx then
		Responsive.bind(l, "Padding", function(R)
			return UDim.new(0, R.px(gapPx))
		end)
	end
	l.Parent = parent
	return l
end

function Kit.aspect(parent: Instance, ratio: number)
	return Create("UIAspectRatioConstraint", { AspectRatio = ratio, Parent = parent })
end

function Kit.frame(props: { [any]: any }?)
	local p = props or {}
	local f = Create("Frame", {
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	for k, v in p do
		if k ~= "Parent" then
			(f :: any)[k] = v
		end
	end
	if p.Parent then
		f.Parent = p.Parent
	end
	return f
end

-- ============================================================== text
function Kit.text(opts: { [string]: any })
	local role = opts.Role or "Body"
	local label = Create("TextLabel", {
		Name = opts.Name or "Text",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = opts.Text or "",
		Font = opts.Font or Theme.Fonts[role] or Theme.Fonts.Body,
		TextColor3 = opts.Color or C.Text,
		TextXAlignment = opts.XAlign or Enum.TextXAlignment.Left,
		TextYAlignment = opts.YAlign or Enum.TextYAlignment.Center,
		TextWrapped = opts.Wrapped == true,
		RichText = opts.RichText == true,
		TextTruncate = opts.Truncate and Enum.TextTruncate.AtEnd or Enum.TextTruncate.None,
		Size = opts.Size or UDim2.fromScale(1, 1),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		AutomaticSize = opts.AutoSize or Enum.AutomaticSize.None,
		LayoutOrder = opts.LayoutOrder or 0,
		TextTransparency = opts.Transparency or 0,
		ZIndex = opts.ZIndex or 1,
	})
	if opts.Scaled then
		label.TextScaled = true
		local maxSize = opts.MaxRole or role
		local tsc = Instance.new("UITextSizeConstraint")
		Responsive.bind(tsc, "MaxTextSize", function(R)
			return R.text(maxSize)
		end)
		tsc.MinTextSize = opts.MinTextSize or 8
		tsc.Parent = label
	else
		Responsive.bind(label, "TextSize", function(R)
			return R.text(role)
		end)
	end
	if opts.Parent then
		label.Parent = opts.Parent
	end
	return label
end

-- ============================================================== panels
-- Glass window: returns { Root, Body } (Root holds soft shadow layers).
function Kit.window(opts: { [string]: any })
	local root = Kit.frame({
		Name = opts.Name or "Window",
		AnchorPoint = opts.AnchorPoint or Vector2.new(0.5, 0.5),
		Position = opts.Position or UDim2.fromScale(0.5, 0.5),
		Size = opts.Size or UDim2.fromScale(0.66, 0.76),
	})
	-- soft shadow: three expanding layers
	for i, spread in { 8, 18, 34 } do
		local sh = Kit.frame({
			Name = "Shadow" .. i,
			-- decorative; allowed to bleed past the screen edge

			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			BackgroundColor3 = C.Black,
			BackgroundTransparency = ({ 0.8, 0.88, 0.94 })[i],
			ZIndex = 0,
			Parent = root,
		})
		sh:SetAttribute("QAAllowOffscreen", true)
		Responsive.bind(sh, "Size", function(R)
			return UDim2.new(1, R.px(spread), 1, R.px(spread))
		end)
		Responsive.bind(sh, "Position", function(R)
			return UDim2.new(0.5, 0, 0.5, R.px(spread * 0.25))
		end)
		Kit.corner(sh, Theme.Radius.Window + spread * 0.5)
	end
	local body = Create("Frame", {
		Name = "Body",
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = T.Panel,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		ClipsDescendants = false,
		ZIndex = 1,
		Parent = root,
	})
	Kit.corner(body, "Window")
	Kit.stroke(body, C.Gold, Theme.Stroke.Normal, 0.45)
	Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(196, 200, 210)),
		}),
		Parent = body,
	})
	-- top inner highlight for the glass look
	local hl = Kit.frame({
		Name = "Highlight",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.new(0.92, 0, 0, 1),
		BackgroundColor3 = C.GoldBright,
		BackgroundTransparency = 0.55,
		Parent = body,
	})
	Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.5, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = hl,
	})
	if opts.Parent then
		root.Parent = opts.Parent
	end
	return { Root = root, Body = body }
end

-- Card surface (no shadow).
function Kit.surface(opts: { [string]: any })
	local f = Create("Frame", {
		Name = opts.Name or "Surface",
		BackgroundColor3 = opts.Color or C.Surface,
		BackgroundTransparency = opts.Transparency or T.Surface,
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.fromScale(1, 1),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		LayoutOrder = opts.LayoutOrder or 0,
		ZIndex = opts.ZIndex or 1,
	})
	Kit.corner(f, opts.Radius or "Card")
	if opts.Stroke ~= false then
		Kit.stroke(f, opts.StrokeColor or C.Gold, Theme.Stroke.Hairline, opts.StrokeTransparency or 0.72)
	end
	if opts.Parent then
		f.Parent = opts.Parent
	end
	return f
end

function Kit.divider(parent: Instance, props: { [string]: any }?)
	local p = props or {}
	local d = Kit.frame({
		Name = "Divider",
		BackgroundColor3 = p.Color or C.Gold,
		BackgroundTransparency = p.Transparency or 0.55,
		Size = p.Size or UDim2.new(1, 0, 0, 1),
		Position = p.Position or UDim2.new(),
		AnchorPoint = p.AnchorPoint or Vector2.zero,
		LayoutOrder = p.LayoutOrder or 0,
		Parent = parent,
	})
	Create("UIGradient", {
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.15, 0),
			NumberSequenceKeypoint.new(0.85, 0),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = d,
	})
	return d
end

-- ============================================================== buttons
local STYLES = {
	Primary = { Bg = C.Accent, Hover = C.AccentHover, Text = C.Ink, Stroke = nil, Grad = true },
	Gold = { Bg = C.Gold, Hover = C.GoldBright, Text = C.Ink, Stroke = nil, Grad = true },
	Secondary = { Bg = C.Surface, Hover = C.SurfaceHover, Text = C.Text, Stroke = C.Gold, StrokeT = 0.55 },
	Danger = { Bg = C.Danger, Hover = C.DangerHover, Text = C.Text, Stroke = nil, Grad = true },
	Success = { Bg = C.Success, Hover = Color3.fromRGB(130, 220, 136), Text = C.Ink, Grad = true },
	Ghost = { Bg = C.Surface, Hover = C.SurfaceHover, Text = C.TextMuted, Stroke = nil, BgT = 0.6 },
	Blue = { Bg = C.BlueDeep, Hover = C.Blue, Text = C.Text, Grad = true },
}
Kit.ButtonStyles = STYLES

function Kit.button(opts: { [string]: any })
	local self = {}
	self.Activated = Signal.new()
	self.Style = opts.Style or "Primary"
	self.Enabled = opts.Enabled ~= false
	self.Busy = false

	local root = Create("TextButton", {
		Name = opts.Name or "Button",
		AutoButtonColor = false,
		Text = "",
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.fromScale(1, 1),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		LayoutOrder = opts.LayoutOrder or 0,
		ZIndex = opts.ZIndex or 1,
		Selectable = true,
	})
	self.Instance = root
	Kit.corner(root, opts.Radius or "Button")
	local stroke = Kit.stroke(root, C.Gold, Theme.Stroke.Hairline, 1)
	local grad = Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(214, 214, 214)),
		Parent = root,
	})
	local scale = Create("UIScale", { Parent = root })

	local content = Kit.frame({ Name = "Content", Size = UDim2.fromScale(1, 1), Parent = root })
	Kit.list(content, "H", 7, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)

	local icon: Frame? = nil
	if opts.Icon then
		local holder = Kit.frame({ Name = "IconHolder", Size = UDim2.fromScale(0.5, 0.5), SizeConstraint = Enum.SizeConstraint.RelativeYY, LayoutOrder = 1, Parent = content })
		icon = Icons.make(opts.Icon, { Color = C.Text, Accent = C.Accent, Ink = C.Panel })
		icon.Parent = holder
		self.IconHolder = holder
	end
	local label = Kit.text({
		Name = "Label",
		Text = opts.Text or "",
		Role = opts.TextRole or "Label",
		Font = Theme.Fonts.Title,
		XAlign = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(0, 0.7),
		AutoSize = Enum.AutomaticSize.X,
		LayoutOrder = 2,
		Parent = content,
	})
	self.Label = label
	if (opts.Text or "") == "" then
		label.Visible = false
	end

	local hovering = false
	local function paint(animated: boolean)
		local st = STYLES[self.Style] or STYLES.Primary
		local bg, txt
		if not self.Enabled then
			bg, txt = C.Disabled, C.TextDim
		else
			bg = hovering and st.Hover or st.Bg
			txt = st.Text
		end
		local bgT = self.Enabled and (st.BgT or 0) or 0.2
		if animated then
			tween(root, Theme.Motion.Hover, { BackgroundColor3 = bg, BackgroundTransparency = bgT })
		else
			root.BackgroundColor3 = bg
			root.BackgroundTransparency = bgT
		end
		label.TextColor3 = txt
		grad.Enabled = st.Grad == true and self.Enabled
		if st.Stroke and self.Enabled then
			stroke.Color = st.Stroke
			stroke.Transparency = hovering and 0.2 or (st.StrokeT or 0.5)
		else
			stroke.Transparency = 1
		end
		if icon then
			local ic = self.Enabled and txt or C.TextDim
			if self._iconColor ~= ic then
				local prev = self._iconColor or C.Text
				Icons.recolor(icon, prev, ic)
				self._iconColor = ic
			end
		end
	end
	self._paint = paint

	root.MouseEnter:Connect(function()
		hovering = true
		if self.Enabled and not self.Busy then
			Kit.hooks.Hover()
		end
		paint(true)
		if opts.Tooltip then
			Kit.hooks.ShowTooltip(opts.Tooltip, root)
		end
	end)
	root.MouseLeave:Connect(function()
		hovering = false
		paint(true)
		tween(scale, Theme.Motion.Press, { Scale = 1 })
		if opts.Tooltip then
			Kit.hooks.HideTooltip()
		end
	end)
	root.MouseButton1Down:Connect(function()
		if self.Enabled and not self.Busy then
			tween(scale, Theme.Motion.Press, { Scale = Theme.Motion.PressScale })
		end
	end)
	root.MouseButton1Up:Connect(function()
		tween(scale, Theme.Motion.Press * 1.6, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	root.Activated:Connect(function()
		if not self.Enabled or self.Busy then
			return
		end
		Kit.hooks.Click()
		self.Activated:Fire()
	end)

	function self:SetText(text: string)
		label.Text = text
		label.Visible = text ~= ""
	end
	function self:SetStyle(style: string)
		self.Style = style
		paint(false)
	end
	function self:SetEnabled(enabled: boolean)
		self.Enabled = enabled
		paint(false)
	end
	function self:SetBusy(busy: boolean)
		self.Busy = busy
		root.Active = not busy
		label.TextTransparency = busy and 0.45 or 0
	end
	function self:SetVisible(v: boolean)
		root.Visible = v
	end
	function self:Destroy()
		self.Activated:Destroy()
		root:Destroy()
	end

	paint(false)
	if opts.OnClick then
		self.Activated:Connect(opts.OnClick)
	end
	if opts.Parent then
		root.Parent = opts.Parent
	end
	return self
end

-- Square glass icon button with a caption (HUD).
function Kit.hudButton(opts: { [string]: any })
	local self = {}
	self.Activated = Signal.new()
	local root = Create("TextButton", {
		Name = opts.Name or "HudButton",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = Theme.Hud.Panel,
		BackgroundTransparency = Theme.Hud.Transparency,
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.fromScale(1, 1),
		LayoutOrder = opts.LayoutOrder or 0,
		Selectable = true,
	})
	self.Instance = root
	Kit.aspect(root, opts.Aspect or 0.92)
	Kit.corner(root, 14)
	local stroke = Kit.stroke(root, Theme.Hud.Stroke, Theme.Stroke.Normal, Theme.Hud.StrokeTransparency)
	Create("UIGradient", {
		Rotation = 90,
		Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Theme.Hud.Shade),
		Parent = root,
	})
	local scale = Create("UIScale", { Parent = root })
	local iconHolder = Kit.frame({
		Name = "IconHolder",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.13),
		Size = UDim2.fromScale(0.5, 0.5),
		Parent = root,
	})
	Kit.aspect(iconHolder, 1)
	local icon = Icons.make(opts.Icon, { Color = Theme.Hud.Icon, Accent = C.Accent, Ink = Theme.Hud.Panel })
	icon.Parent = iconHolder
	local caption = Kit.text({
		Name = "Caption",
		Text = opts.Text or "",
		Role = "Micro",
		Font = Theme.Fonts.Micro,
		Color = Theme.Hud.TextMuted,
		XAlign = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.93),
		Size = UDim2.fromScale(0.96, 0.24),
		Parent = root,
	})
	self.Caption = caption
	-- notification badge
	local badge = Create("Frame", {
		Name = "Badge",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.9, 0.1),
		Size = UDim2.fromScale(0.3, 0.3),
		BackgroundColor3 = C.Danger,
		BorderSizePixel = 0,
		Visible = false,
		ZIndex = 3,
		Parent = root,
	})
	Kit.aspect(badge, 1)
	Kit.corner(badge, "pill")
	Kit.stroke(badge, Theme.Hud.Panel, 2, 0)
	local badgeText = Kit.text({
		Text = "",
		Role = "Micro",
		XAlign = Enum.TextXAlignment.Center,
		ZIndex = 4,
		Parent = badge,
	})

	local hovering = false
	root.MouseEnter:Connect(function()
		hovering = true
		Kit.hooks.Hover()
		tween(stroke, Theme.Motion.Hover, { Transparency = 0 })
		tween(root, Theme.Motion.Hover, { BackgroundTransparency = 0 })
		caption.TextColor3 = Theme.Hud.Text
		if opts.Tooltip then
			Kit.hooks.ShowTooltip(opts.Tooltip, root)
		end
	end)
	root.MouseLeave:Connect(function()
		hovering = false
		tween(stroke, Theme.Motion.Hover, { Transparency = self.Active and 0 or Theme.Hud.StrokeTransparency })
		tween(root, Theme.Motion.Hover, { BackgroundTransparency = Theme.Hud.Transparency })
		tween(scale, Theme.Motion.Press, { Scale = 1 })
		caption.TextColor3 = self.Active and C.AccentDeep or Theme.Hud.TextMuted
		Kit.hooks.HideTooltip()
	end)
	root.MouseButton1Down:Connect(function()
		tween(scale, Theme.Motion.Press, { Scale = 0.93 })
	end)
	root.MouseButton1Up:Connect(function()
		tween(scale, 0.1, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	root.Activated:Connect(function()
		Kit.hooks.Click()
		self.Activated:Fire()
	end)

	function self:SetActive(active: boolean)
		self.Active = active
		stroke.Color = active and C.Accent or Theme.Hud.Stroke
		stroke.Transparency = active and 0.05 or (hovering and 0.1 or 0.62)
		caption.TextColor3 = active and C.AccentDeep or (hovering and Theme.Hud.Text or Theme.Hud.TextMuted)
	end
	function self:SetBadge(count: number?)
		if count and count > 0 then
			badge.Visible = true
			badgeText.Text = count > 9 and "9+" or tostring(count)
		else
			badge.Visible = false
		end
	end
	if opts.OnClick then
		self.Activated:Connect(opts.OnClick)
	end
	if opts.Parent then
		root.Parent = opts.Parent
	end
	return self
end

function Kit.closeButton(opts: { [string]: any })
	local self = {}
	self.Activated = Signal.new()
	local root = Create("TextButton", {
		Name = "Close",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.Surface,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		AnchorPoint = opts.AnchorPoint or Vector2.new(1, 0.5),
		Position = opts.Position or UDim2.fromScale(1, 0.5),
		Size = opts.Size or UDim2.fromScale(0.62, 0.62),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		ZIndex = opts.ZIndex or 2,
		Selectable = true,
	})
	self.Instance = root
	Kit.corner(root, "pill")
	local stroke = Kit.stroke(root, C.Gold, Theme.Stroke.Hairline, 0.55)
	local holder = Kit.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.42, 0.42), Parent = root })
	local icon = Icons.make("Close", { Color = C.TextMuted })
	icon.Parent = holder
	local scale = Create("UIScale", { Parent = root })
	root.MouseEnter:Connect(function()
		Kit.hooks.Hover()
		tween(root, Theme.Motion.Hover, { BackgroundColor3 = C.Accent })
		Icons.recolor(icon, C.TextMuted, C.Ink)
		stroke.Transparency = 1
	end)
	root.MouseLeave:Connect(function()
		tween(root, Theme.Motion.Hover, { BackgroundColor3 = C.Surface })
		Icons.recolor(icon, C.Ink, C.TextMuted)
		stroke.Transparency = 0.55
		tween(scale, Theme.Motion.Press, { Scale = 1 })
	end)
	root.MouseButton1Down:Connect(function()
		tween(scale, Theme.Motion.Press, { Scale = 0.9 })
	end)
	root.Activated:Connect(function()
		Kit.hooks.Click()
		self.Activated:Fire()
	end)
	if opts.Parent then
		root.Parent = opts.Parent
	end
	return self
end

-- ============================================================== chips / segmented
function Kit.chip(opts: { [string]: any })
	local self = {}
	self.Activated = Signal.new()
	self.ActiveState = false
	local root = Create("TextButton", {
		Name = opts.Name or "Chip",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.SurfaceDeep,
		BackgroundTransparency = 0.25,
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.fromScale(0, 1),
		AutomaticSize = opts.Size and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
		LayoutOrder = opts.LayoutOrder or 0,
		Selectable = true,
	})
	self.Instance = root
	Kit.corner(root, "pill")
	local stroke = Kit.stroke(root, C.Gold, Theme.Stroke.Hairline, 0.75)
	local content = Kit.frame({ Size = UDim2.fromScale(0, 1), AutomaticSize = Enum.AutomaticSize.X, Parent = root })
	if not opts.Size then
		Kit.padding(content, 0, 14, 0, 14)
	else
		content.Size = UDim2.fromScale(1, 1)
		content.AutomaticSize = Enum.AutomaticSize.None
	end
	Kit.list(content, "H", 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	if opts.Dot then
		local dot = Create("Frame", {
			Name = "Dot",
			BackgroundColor3 = opts.Dot,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(0.28, 0.28),
			SizeConstraint = Enum.SizeConstraint.RelativeYY,
			LayoutOrder = 1,
			Parent = content,
		})
		Kit.corner(dot, "pill")
	end
	local label = Kit.text({
		Text = opts.Text or "",
		Role = opts.Role or "Micro",
		Font = Theme.Fonts.Label,
		Color = C.TextMuted,
		XAlign = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(0, 1),
		AutoSize = Enum.AutomaticSize.X,
		LayoutOrder = 2,
		Parent = content,
	})
	self.Label = label
	local function paint()
		if self.ActiveState then
			root.BackgroundColor3 = C.Accent
			root.BackgroundTransparency = 0
			label.TextColor3 = C.Ink
			stroke.Transparency = 1
		else
			root.BackgroundColor3 = C.SurfaceDeep
			root.BackgroundTransparency = 0.25
			label.TextColor3 = C.TextMuted
			stroke.Transparency = 0.75
		end
	end
	root.MouseEnter:Connect(function()
		if not self.ActiveState then
			label.TextColor3 = C.Text
			stroke.Transparency = 0.35
		end
	end)
	root.MouseLeave:Connect(paint)
	root.Activated:Connect(function()
		Kit.hooks.Click()
		self.Activated:Fire()
	end)
	function self:SetActive(active: boolean)
		self.ActiveState = active
		paint()
	end
	paint()
	if opts.Parent then
		root.Parent = opts.Parent
	end
	return self
end

function Kit.segmented(opts: { [string]: any })
	local self = {}
	self.Changed = Signal.new()
	self.Value = opts.Value or opts.Options[1]
	local root = Create("Frame", {
		Name = opts.Name or "Segmented",
		BackgroundColor3 = C.SurfaceDeep,
		BackgroundTransparency = 0.2,
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.fromScale(1, 1),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		LayoutOrder = opts.LayoutOrder or 0,
	})
	self.Instance = root
	Kit.corner(root, "pill")
	Kit.padding(root, 3)
	Kit.list(root, "H", 3, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local n = #opts.Options
	local chips = {}
	for i, option in opts.Options do
		local chip = Kit.chip({
			Text = (opts.Labels and opts.Labels[i]) or string.upper(option),
			Size = UDim2.new(1 / n, -4, 1, 0),
			LayoutOrder = i,
			Parent = root,
		})
		chips[option] = chip
		chip.Activated:Connect(function()
			if self.Value ~= option then
				self:Set(option)
				self.Changed:Fire(option)
			end
		end)
	end
	function self:Set(value: string)
		self.Value = value
		for opt, chip in chips do
			chip:SetActive(opt == value)
		end
	end
	self:Set(self.Value)
	if opts.Parent then
		root.Parent = opts.Parent
	end
	return self
end

-- ============================================================== progress / toggle / slider
function Kit.progress(opts: { [string]: any })
	local self = {}
	local track = Create("Frame", {
		Name = opts.Name or "Progress",
		BackgroundColor3 = opts.Track or C.SurfaceDeep,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.fromScale(1, 1),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		LayoutOrder = opts.LayoutOrder or 0,
		ClipsDescendants = true,
	})
	self.Instance = track
	Kit.corner(track, "pill")
	local fill = Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = C.White,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	})
	Kit.corner(fill, "pill")
	local c0 = opts.Color or C.Accent
	local c1 = opts.Color2 or C.GoldBright
	local grad = Create("UIGradient", { Color = ColorSequence.new(c0, c1), Parent = fill })
	self.Fill = fill
	self.Value = 0
	function self:SetValue(v: number, animated: boolean?)
		v = math.clamp(v, 0, 1)
		self.Value = v
		local target = UDim2.fromScale(v, 1)
		if animated then
			tween(fill, 0.25, { Size = target })
		else
			fill.Size = target
		end
	end
	function self:SetColors(a: Color3, b: Color3?)
		grad.Color = ColorSequence.new(a, b or a)
	end
	if opts.Parent then
		track.Parent = opts.Parent
	end
	return self
end

function Kit.toggle(opts: { [string]: any })
	local self = {}
	self.Changed = Signal.new()
	self.Value = opts.Value == true
	local root = Create("TextButton", {
		Name = opts.Name or "Toggle",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.SurfaceDeep,
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.fromScale(1, 1),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		LayoutOrder = opts.LayoutOrder or 0,
		Selectable = true,
	})
	self.Instance = root
	Kit.aspect(root, 1.9)
	Kit.corner(root, "pill")
	Kit.stroke(root, C.Gold, Theme.Stroke.Hairline, 0.6)
	local knob = Create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0, 0.5),
		Size = UDim2.fromScale(0.42, 0.8),
		BackgroundColor3 = C.Text,
		BorderSizePixel = 0,
		Parent = root,
	})
	Kit.corner(knob, "pill")
	local function paint(animated)
		local pos = self.Value and UDim2.fromScale(0.54, 0.5) or UDim2.fromScale(0.04, 0.5)
		local bg = self.Value and C.Accent or C.SurfaceDeep
		if animated then
			tween(knob, 0.12, { Position = pos })
			tween(root, 0.12, { BackgroundColor3 = bg })
		else
			knob.Position = pos
			root.BackgroundColor3 = bg
		end
		knob.BackgroundColor3 = self.Value and C.Ink or C.TextMuted
	end
	root.Activated:Connect(function()
		Kit.hooks.Click()
		self.Value = not self.Value
		paint(true)
		self.Changed:Fire(self.Value)
	end)
	function self:Set(v: boolean)
		self.Value = v
		paint(false)
	end
	paint(false)
	if opts.Parent then
		root.Parent = opts.Parent
	end
	return self
end

function Kit.slider(opts: { [string]: any })
	local UserInputService = game:GetService("UserInputService")
	local self = {}
	self.Changed = Signal.new()
	self.Value = opts.Value or 0.5
	local min, max, step = opts.Min or 0, opts.Max or 1, opts.Step or 0.05
	local root = Create("TextButton", {
		Name = opts.Name or "Slider",
		AutoButtonColor = false,
		Text = "",
		BackgroundTransparency = 1,
		Size = opts.Size or UDim2.fromScale(1, 1),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		LayoutOrder = opts.LayoutOrder or 0,
		Selectable = true,
	})
	self.Instance = root
	local track = Create("Frame", {
		Name = "Track",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromScale(1, 0.22),
		BackgroundColor3 = C.SurfaceDeep,
		BorderSizePixel = 0,
		Parent = root,
	})
	Kit.corner(track, "pill")
	local fill = Create("Frame", {
		Name = "Fill",
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
		Parent = track,
	})
	Kit.corner(fill, "pill")
	local knob = Create("Frame", {
		Name = "Knob",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Size = UDim2.fromScale(0.7, 0.7),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundColor3 = C.Text,
		BorderSizePixel = 0,
		Parent = root,
	})
	Kit.corner(knob, "pill")
	Kit.stroke(knob, C.Accent, Theme.Stroke.Normal, 0)
	local function render()
		local a = (self.Value - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
	end
	local function setFromX(x: number)
		local abs = track.AbsolutePosition.X
		local w = math.max(1, track.AbsoluteSize.X)
		local a = math.clamp((x - abs) / w, 0, 1)
		local v = min + (max - min) * a
		v = math.floor(v / step + 0.5) * step
		v = math.clamp(v, min, max)
		if v ~= self.Value then
			self.Value = v
			render()
			self.Changed:Fire(v)
		end
	end
	local dragging = false
	root.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			setFromX(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
	function self:Set(v: number)
		self.Value = math.clamp(v, min, max)
		render()
	end
	render()
	if opts.Parent then
		root.Parent = opts.Parent
	end
	return self
end

-- ============================================================== badges / stats
function Kit.badge(opts: { [string]: any })
	local root = Create("Frame", {
		Name = opts.Name or "Badge",
		BackgroundColor3 = opts.Color or C.Accent,
		BackgroundTransparency = opts.Transparency or 0,
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.fromScale(0, 1),
		AutomaticSize = opts.Size and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		LayoutOrder = opts.LayoutOrder or 0,
		ZIndex = opts.ZIndex or 1,
	})
	Kit.corner(root, opts.Radius or "pill")
	if not opts.Size then
		Kit.padding(root, 0, 8, 0, 8)
	end
	local label = Kit.text({
		Name = "Label",
		Text = opts.Text or "",
		Role = opts.Role or "Micro",
		Font = Theme.Fonts.Label,
		Color = opts.TextColor or C.Ink,
		XAlign = Enum.TextXAlignment.Center,
		Size = opts.Size and UDim2.fromScale(1, 1) or UDim2.fromScale(0, 1),
		AutoSize = opts.Size and Enum.AutomaticSize.None or Enum.AutomaticSize.X,
		ZIndex = (opts.ZIndex or 1) + 1,
		Parent = root,
	})
	if opts.Parent then
		root.Parent = opts.Parent
	end
	return root, label
end

-- icon + label (muted) ........ value (bright)
function Kit.statRow(opts: { [string]: any })
	local root = Kit.frame({
		Name = opts.Name or "Stat",
		Size = opts.Size or UDim2.fromScale(1, 0.1),
		LayoutOrder = opts.LayoutOrder or 0,
	})
	local iconBox = Kit.frame({
		Name = "IconBox",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0, 0.5),
		Size = UDim2.fromScale(0.72, 0.72),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		Parent = root,
	})
	if opts.Icon then
		local icon = Icons.make(opts.Icon, { Color = opts.IconColor or C.TextMuted, Accent = C.Accent, Ink = C.Panel })
		icon.Parent = iconBox
	end
	local label = Kit.text({
		Name = "Label",
		Text = opts.Label or "",
		Role = opts.LabelRole or "Label",
		Font = Theme.Fonts.Label,
		Color = C.TextMuted,
		Position = UDim2.fromScale(0.11, 0),
		Size = UDim2.fromScale(0.5, 1),
		Parent = root,
	})
	local value = Kit.text({
		Name = "Value",
		Text = opts.Value or "",
		Role = opts.ValueRole or "Heading",
		Font = Theme.Fonts.Number,
		Color = opts.ValueColor or C.Text,
		XAlign = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromScale(0.5, 1),
		Parent = root,
	})
	if opts.Parent then
		root.Parent = opts.Parent
	end
	return root, value, label
end

-- ============================================================== inputs
function Kit.searchBox(opts: { [string]: any })
	local self = {}
	self.Changed = Signal.new()
	local field = Create("Frame", {
		Name = opts.Name or "Search",
		BackgroundColor3 = C.SurfaceDeep,
		BackgroundTransparency = T.Field,
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.fromScale(1, 1),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		LayoutOrder = opts.LayoutOrder or 0,
	})
	self.Instance = field
	Kit.corner(field, "pill")
	local stroke = Kit.stroke(field, C.Gold, Theme.Stroke.Hairline, 0.7)
	local iconBox = Kit.frame({
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		Size = UDim2.fromScale(0.46, 0.46),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		Parent = field,
	})
	Responsive.bind(iconBox, "Position", function(R)
		return UDim2.new(0, R.px(14), 0.5, 0)
	end)
	Icons.make("Search", { Color = C.TextMuted }).Parent = iconBox
	local box = Create("TextBox", {
		Name = "Input",
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		Text = "",
		PlaceholderText = opts.Placeholder or "Search...",
		PlaceholderColor3 = C.TextDim,
		TextColor3 = C.Text,
		Font = Theme.Fonts.Body,
		TextXAlignment = Enum.TextXAlignment.Left,
		Size = UDim2.new(1, 0, 1, 0),
		Parent = field,
	})
	Responsive.bind(box, "TextSize", function(R)
		return R.text("Body")
	end)
	Responsive.bind(box, "Position", function(R)
		return UDim2.new(0, R.px(40), 0, 0)
	end)
	Responsive.bind(box, "Size", function(R)
		return UDim2.new(1, -R.px(40 + 36), 1, 0)
	end)
	local clear = Create("TextButton", {
		Name = "Clear",
		AutoButtonColor = false,
		Text = "",
		BackgroundTransparency = 1,
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.fromScale(0.5, 0.5),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		Visible = false,
		Parent = field,
	})
	Responsive.bind(clear, "Position", function(R)
		return UDim2.new(1, -R.px(12), 0.5, 0)
	end)
	Icons.make("Close", { Color = C.TextMuted }).Parent = clear
	self.TextBox = box
	local pendingThread = nil
	box:GetPropertyChangedSignal("Text"):Connect(function()
		clear.Visible = box.Text ~= ""
		if pendingThread then
			task.cancel(pendingThread)
		end
		pendingThread = task.delay(0.12, function()
			pendingThread = nil
			self.Changed:Fire(box.Text)
		end)
	end)
	box.Focused:Connect(function()
		stroke.Transparency = 0.15
		stroke.Color = C.Accent
	end)
	box.FocusLost:Connect(function()
		stroke.Transparency = 0.7
		stroke.Color = C.Gold
	end)
	clear.Activated:Connect(function()
		box.Text = ""
	end)
	function self:Get(): string
		return box.Text
	end
	function self:Set(text: string)
		box.Text = text
	end
	if opts.Parent then
		field.Parent = opts.Parent
	end
	return self
end

-- Dropdown: overlayParent must be a top-level frame of the window so the
-- popover is never covered by siblings.
function Kit.dropdown(opts: { [string]: any })
	local self = {}
	self.Changed = Signal.new()
	self.Value = opts.Value or opts.Options[1]
	local button = Kit.button({
		Name = opts.Name or "Dropdown",
		Text = (opts.Prefix or "") .. string.upper(self.Value),
		Style = "Secondary",
		Icon = nil,
		Size = opts.Size,
		Position = opts.Position,
		AnchorPoint = opts.AnchorPoint,
		LayoutOrder = opts.LayoutOrder,
		Radius = "pill",
	})
	self.Instance = button.Instance
	local chevBox = Kit.frame({ Size = UDim2.fromScale(0.34, 0.34), SizeConstraint = Enum.SizeConstraint.RelativeYY, LayoutOrder = 3, Parent = button.Instance.Content })
	Icons.make("ChevronDown", { Color = C.TextMuted }).Parent = chevBox

	local popover: Frame? = nil
	local function close()
		if popover then
			popover:Destroy()
			popover = nil
		end
	end
	self.Close = close
	local function open()
		close()
		local overlay: GuiObject = opts.OverlayParent
		local b = button.Instance
		local rel = b.AbsolutePosition - overlay.AbsolutePosition
		local n = #opts.Options
		local pop = Create("Frame", {
			Name = "Popover",
			BackgroundColor3 = C.Panel,
			BorderSizePixel = 0,
			Position = UDim2.fromScale(rel.X / math.max(1, overlay.AbsoluteSize.X), (rel.Y + b.AbsoluteSize.Y) / math.max(1, overlay.AbsoluteSize.Y)),
			Size = UDim2.fromScale(b.AbsoluteSize.X / math.max(1, overlay.AbsoluteSize.X), (b.AbsoluteSize.Y * 0.95 * n) / math.max(1, overlay.AbsoluteSize.Y)),
			ZIndex = 50,
			Parent = overlay,
		})
		Kit.corner(pop, "Button")
		Kit.stroke(pop, C.Gold, Theme.Stroke.Hairline, 0.4)
		Kit.list(pop, "V", 0)
		for i, option in opts.Options do
			local item = Create("TextButton", {
				Name = option,
				AutoButtonColor = false,
				Text = "",
				BackgroundColor3 = C.Surface,
				BackgroundTransparency = option == self.Value and 0 or 1,
				BorderSizePixel = 0,
				Size = UDim2.fromScale(1, 1 / n),
				LayoutOrder = i,
				ZIndex = 51,
				Parent = pop,
			})
			Kit.corner(item, "Small")
			Kit.text({
				Text = string.upper(option),
				Role = "Label",
				Font = Theme.Fonts.Label,
				Color = option == self.Value and C.Accent or C.Text,
				Position = UDim2.fromScale(0.1, 0),
				Size = UDim2.fromScale(0.85, 1),
				ZIndex = 52,
				Parent = item,
			})
			item.MouseEnter:Connect(function()
				item.BackgroundTransparency = 0.2
			end)
			item.MouseLeave:Connect(function()
				item.BackgroundTransparency = option == self.Value and 0 or 1
			end)
			item.Activated:Connect(function()
				Kit.hooks.Click()
				close()
				if option ~= self.Value then
					self:Set(option)
					self.Changed:Fire(option)
				end
			end)
		end
		popover = pop
	end
	button.Activated:Connect(function()
		if popover then
			close()
		else
			open()
		end
	end)
	function self:Set(value: string)
		self.Value = value
		button:SetText((opts.Prefix or "") .. string.upper(value))
	end
	function self:IsOpen()
		return popover ~= nil
	end
	if opts.Parent then
		button.Instance.Parent = opts.Parent
	end
	return self
end

-- Styled vertical scrolling frame.
function Kit.scroll(opts: { [string]: any })
	local sf = Create("ScrollingFrame", {
		Name = opts.Name or "Scroll",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.fromScale(1, 1),
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = opts.AutoCanvas == false and Enum.AutomaticSize.None or Enum.AutomaticSize.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarImageColor3 = C.Gold,
		ScrollBarImageTransparency = 0.35,
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
		VerticalScrollBarInset = Enum.ScrollBarInset.None,
		LayoutOrder = opts.LayoutOrder or 0,
		Selectable = false,
	})
	Responsive.bind(sf, "ScrollBarThickness", function(R)
		return math.max(3, R.px(5))
	end)
	if opts.Parent then
		sf.Parent = opts.Parent
	end
	return sf
end

-- Keyboard key cap ("G", "E") used in hints and prompts.
function Kit.keycap(opts: { [string]: any })
	local root = Create("Frame", {
		Name = "Keycap",
		BackgroundColor3 = C.Text,
		BorderSizePixel = 0,
		Size = opts.Size or UDim2.fromScale(1, 1),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		Position = opts.Position or UDim2.new(),
		AnchorPoint = opts.AnchorPoint or Vector2.zero,
		LayoutOrder = opts.LayoutOrder or 0,
		ZIndex = opts.ZIndex or 1,
	})
	Kit.corner(root, 6)
	Kit.text({
		Text = opts.Key or "E",
		Role = opts.Role or "Label",
		Font = Theme.Fonts.Title,
		Color = C.Ink,
		XAlign = Enum.TextXAlignment.Center,
		ZIndex = (opts.ZIndex or 1) + 1,
		Parent = root,
	})
	if opts.Parent then
		root.Parent = opts.Parent
	end
	return root
end

return Kit
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="Folder" referent="RBX000129">
					<Properties>
						<string name="Name">Overlays</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX000130">
						<Properties>
							<string name="Name">Modal</string>
							<ProtectedString name="Source"><![CDATA[--[[
	Modal
	Reusable confirmation dialog on the highest interactive layer.
	Modal:Confirm({ Title, Body, ConfirmText, CancelText, Danger }) -> boolean
	(yields until the player answers; Esc / B / clicking outside = cancel)
]]

local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Create = require(UI.Create)
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local Fade = require(UI.Fade)

local C = Theme.Colors

local Modal = {}
Modal.__index = Modal

function Modal.new(layerRoot: Frame)
	local self = setmetatable({}, Modal)
	self.Root = layerRoot
	self.Open = false
	self._resolve = nil

	local dim = Create("TextButton", {
		Name = "Dim",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.Black,
		BackgroundTransparency = 0.45,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = layerRoot,
	})
	self.Dim = dim
	dim.Activated:Connect(function()
		self:_answer(false)
	end)

	local win = Kit.window({ Name = "ConfirmDialog", Parent = dim })
	self.Window = win
	local body = win.Body
	Kit.padding(body, 26, 30, 24, 30)

	self.IconBg = Create("Frame", {
		Name = "IconBg",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(0.2, 0.2),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundColor3 = C.Danger,
		BorderSizePixel = 0,
		Parent = body,
	})
	Kit.corner(self.IconBg, "pill")
	local iconBox = Kit.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.56, 0.56), Parent = self.IconBg })
	self.Icon = Icons.make("Warning", { Color = C.Text, Ink = C.Danger })
	self.Icon.Parent = iconBox

	self.Title = Kit.text({
		Name = "Title",
		Text = "",
		Role = "Title",
		XAlign = Enum.TextXAlignment.Center,
		Position = UDim2.fromScale(0, 0.25),
		Size = UDim2.fromScale(1, 0.18),
		Scaled = true,
		MaxRole = "Title",
		Parent = body,
	})
	self.Body = Kit.text({
		Name = "Message",
		Text = "",
		Role = "Body",
		Color = C.TextMuted,
		XAlign = Enum.TextXAlignment.Center,
		YAlign = Enum.TextYAlignment.Top,
		Wrapped = true,
		Position = UDim2.fromScale(0, 0.45),
		Size = UDim2.fromScale(1, 0.24),
		Parent = body,
	})
	local row = Kit.frame({ Name = "Buttons", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.fromScale(1, 0.22), Parent = body })
	self.Cancel = Kit.button({ Name = "Cancel", Text = "CANCEL", Style = "Secondary", Size = UDim2.fromScale(0.48, 1), Parent = row })
	self.ConfirmButton = Kit.button({ Name = "Confirm", Text = "CONFIRM", Style = "Danger", AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromScale(0.48, 1), Parent = row })
	self.Cancel.Activated:Connect(function()
		self:_answer(false)
	end)
	self.ConfirmButton.Activated:Connect(function()
		self:_answer(true)
	end)

	-- block clicks on the panel from reaching the dim button
	Create("TextButton", {
		Name = "Blocker",
		AutoButtonColor = false,
		Text = "",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		ZIndex = 0,
		Parent = body,
	})

	self.Scale = Create("UIScale", { Parent = win.Root })
	self:Layout()
	Responsive.Changed:Connect(function()
		self:Layout()
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not self.Open then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
			self:_answer(false)
		elseif not processed and (input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.ButtonA) then
			self:_answer(true)
		end
	end)
	return self
end

function Modal:Layout()
	local R = Responsive
	local root = self.Window.Root
	local ar = root:FindFirstChildOfClass("UIAspectRatioConstraint") or Create("UIAspectRatioConstraint", { Parent = root })
	if R.Device == "Phone" then
		root.Size = UDim2.fromScale(R.Portrait and 0.9 or 0.56, R.Portrait and 0.4 or 0.74)
		ar.AspectRatio = 1.7
	else
		root.Size = UDim2.fromScale(0.34, 0.36)
		ar.AspectRatio = 1.75
	end
end

function Modal:_answer(value: boolean)
	if not self.Open then
		return
	end
	self.Open = false
	local resolve = self._resolve
	self._resolve = nil
	local state = Fade.capture(self.Dim)
	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - start) / Theme.Motion.Close, 0, 1)
		Fade.apply(state, 1 - a)
		self.Scale.Scale = 1 - 0.04 * a
		if a >= 1 then
			conn:Disconnect()
			self.Dim.Visible = false
			Fade.restore(state)
		end
	end)
	if resolve then
		resolve(value)
	end
end

function Modal:Confirm(opts: { [string]: any }): boolean
	if self.Open then
		self:_answer(false)
	end
	local danger = opts.Danger ~= false
	self.Title.Text = string.upper(opts.Title or "ARE YOU SURE?")
	self.Body.Text = opts.Body or ""
	self.ConfirmButton:SetText(string.upper(opts.ConfirmText or "CONFIRM"))
	self.ConfirmButton:SetStyle(danger and "Danger" or "Primary")
	self.Cancel:SetText(string.upper(opts.CancelText or "CANCEL"))
	self.IconBg.BackgroundColor3 = danger and C.Danger or C.Accent
	Icons.recolor(self.Icon, danger and C.Accent or C.Danger, danger and C.Danger or C.Accent)
	self.Open = true
	self.Dim.Visible = true
	local state = Fade.capture(self.Dim)
	Fade.apply(state, 0)
	self.Scale.Scale = Theme.Motion.StartScale
	local start = os.clock()
	local conn
	conn = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - start) / Theme.Motion.Open, 0, 1)
		local e = 1 - (1 - a) ^ 4
		Fade.apply(state, e)
		self.Scale.Scale = Theme.Motion.StartScale + (1 - Theme.Motion.StartScale) * e
		if a >= 1 then
			conn:Disconnect()
		end
	end)
	local thread = coroutine.running()
	local answered = false
	self._resolve = function(v)
		if answered then
			return
		end
		answered = true
		task.spawn(thread, v)
	end
	return coroutine.yield()
end

function Modal:IsOpen(): boolean
	return self.Open
end

return Modal
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX000131">
						<Properties>
							<string name="Name">Notifications</string>
							<ProtectedString name="Source"><![CDATA[--[[
	Notifications
	Centralized toast stack (top-center, below the cash display).
	- max 4 visible, extra ones queue
	- identical messages within a short window merge into "x2", "x3"
	- slide + fade in/out, never overlapping (UIListLayout stack)

	Kinds: "success" | "info" | "warning" | "error" | "rare"
]]

local TweenService = game:GetService("TweenService")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Create = require(UI.Create)
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)

local C = Theme.Colors

local Notifications = {}
Notifications.__index = Notifications

local MAX_VISIBLE = 4
local LIFETIME = 2.8
local MERGE_WINDOW = 1.5

local KINDS = {
	success = { Icon = "Check", Color = C.Success },
	info = { Icon = "Info", Color = C.Blue },
	warning = { Icon = "Warning", Color = C.Warning },
	error = { Icon = "Close", Color = C.Danger },
	rare = { Icon = "Sparkle", Color = C.GoldBright },
	cash = { Icon = "Coin", Color = C.GoldBright },
	egg = { Icon = "Egg", Color = C.Success },
}

function Notifications.new(layerRoot: Frame, onSound: ((string) -> ())?)
	local self = setmetatable({}, Notifications)
	self.OnSound = onSound
	self.Active = {} -- { { text, frame, count, born, countLabel } }
	self.Queue = {}
	self.Holder = Kit.frame({
		Name = "Notifications",
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.fromScale(0.5, 0.3),
		Parent = layerRoot,
	})
	Kit.list(self.Holder, "V", 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
	self:Layout()
	Responsive.Changed:Connect(function()
		self:Layout()
	end)
	return self
end

function Notifications:Layout()
	-- Sits below the cash row on every device.
	local R = Responsive
	local short = math.min(R.Width, R.Height)
	local top
	if R.Device == "Phone" then
		top = R.TopInset + short * 0.2
		self.Holder.Size = UDim2.fromScale(R.Portrait and 0.92 or 0.6, 0.3)
	else
		top = R.TopInset + short * 0.145
		self.Holder.Size = UDim2.fromScale(0.5, 0.3)
	end
	self.Holder.Position = UDim2.new(0.5, 0, 0, math.floor(top))
end

function Notifications:Push(kind: string, text: string, extra: { [string]: any }?)
	local now = os.clock()
	for _, entry in self.Active do
		if entry.text == text and now - entry.born < MERGE_WINDOW + entry.count then
			entry.count += 1
			entry.countLabel.Text = "x" .. entry.count
			entry.countLabel.Visible = true
			entry.born = now
			return
		end
	end
	if #self.Active >= MAX_VISIBLE then
		table.insert(self.Queue, { kind, text, extra })
		if #self.Queue > 12 then
			table.remove(self.Queue, 1)
		end
		return
	end
	self:_show(kind, text, extra)
end

function Notifications:_show(kind: string, text: string, extra: { [string]: any }?)
	local spec = KINDS[kind] or KINDS.info
	local accent = (extra and extra.Color) or spec.Color
	local toast = Create("Frame", {
		Name = "Toast",
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.X,
		LayoutOrder = math.floor(os.clock() * 1000) % 1000000,
		Parent = self.Holder,
	})
	Responsive.bind(toast, "Size", function(R)
		return UDim2.fromOffset(0, R.px(R.Device == "Phone" and 34 or 42))
	end)
	Kit.corner(toast, "pill")
	local stroke = Kit.stroke(toast, accent, Theme.Stroke.Normal, 0.35)
	Kit.padding(toast, 0, 18, 0, 8)
	Kit.list(toast, "H", 10, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local iconBg = Create("Frame", {
		Name = "IconBg",
		BackgroundColor3 = accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0.72, 0.72),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		LayoutOrder = 1,
		Parent = toast,
	})
	Kit.corner(iconBg, "pill")
	local iconBox = Kit.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.6, 0.6), Parent = iconBg })
	Icons.make(spec.Icon, { Color = C.Ink, Accent = C.Ink, Ink = accent }).Parent = iconBox
	local label = Kit.text({
		Name = "Message",
		Text = string.upper(text),
		Role = "Label",
		Font = Theme.Fonts.Label,
		Color = kind == "rare" and C.GoldBright or C.Text,
		Size = UDim2.fromScale(0, 1),
		AutoSize = Enum.AutomaticSize.X,
		LayoutOrder = 2,
		Parent = toast,
	})
	local countLabel = Kit.text({
		Name = "Count",
		Text = "x2",
		Role = "Label",
		Font = Theme.Fonts.Number,
		Color = accent,
		Size = UDim2.fromScale(0, 1),
		AutoSize = Enum.AutomaticSize.X,
		LayoutOrder = 3,
		Parent = toast,
	})
	countLabel.Visible = false
	local scale = Create("UIScale", { Scale = 0.9, Parent = toast })

	local entry = { text = text, frame = toast, count = 1, born = os.clock(), countLabel = countLabel }
	table.insert(self.Active, entry)
	if self.OnSound then
		self.OnSound(kind == "error" and "Error" or "Notify")
	end

	-- entrance
	toast.BackgroundTransparency = 1
	label.TextTransparency = 1
	stroke.Transparency = 1
	iconBg.BackgroundTransparency = 1
	local info = TweenInfo.new(0.18, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
	TweenService:Create(scale, info, { Scale = 1 }):Play()
	TweenService:Create(toast, info, { BackgroundTransparency = 0.08 }):Play()
	TweenService:Create(label, info, { TextTransparency = 0 }):Play()
	TweenService:Create(stroke, info, { Transparency = 0.35 }):Play()
	TweenService:Create(iconBg, info, { BackgroundTransparency = 0 }):Play()

	task.spawn(function()
		while os.clock() - entry.born < LIFETIME do
			task.wait(0.1)
		end
		local outInfo = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		TweenService:Create(toast, outInfo, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(label, outInfo, { TextTransparency = 1 }):Play()
		TweenService:Create(countLabel, outInfo, { TextTransparency = 1 }):Play()
		TweenService:Create(stroke, outInfo, { Transparency = 1 }):Play()
		TweenService:Create(iconBg, outInfo, { BackgroundTransparency = 1 }):Play()
		TweenService:Create(scale, outInfo, { Scale = 0.92 }):Play()
		task.wait(0.17)
		local i = table.find(self.Active, entry)
		if i then
			table.remove(self.Active, i)
		end
		toast:Destroy()
		if #self.Queue > 0 then
			local nxt = table.remove(self.Queue, 1)
			self:_show(nxt[1], nxt[2], nxt[3])
		end
	end)
end

function Notifications:Clear()
	for _, entry in self.Active do
		entry.frame:Destroy()
	end
	self.Active = {}
	self.Queue = {}
end

return Notifications
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX000132">
						<Properties>
							<string name="Name">Tooltip</string>
							<ProtectedString name="Source"><![CDATA[--[[
	Tooltip
	Small hover label next to an anchor element (desktop only).
]]

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Create = require(UI.Create)
local Kit = require(UI.Kit)

local C = Theme.Colors

local Tooltip = {}
Tooltip.__index = Tooltip

function Tooltip.new(layerRoot: Frame)
	local self = setmetatable({}, Tooltip)
	self.Root = layerRoot
	local frame = Create("Frame", {
		Name = "Tooltip",
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.04,
		BorderSizePixel = 0,
		AutomaticSize = Enum.AutomaticSize.X,
		Visible = false,
		Parent = layerRoot,
	})
	Responsive.bind(frame, "Size", function(R)
		return UDim2.fromOffset(0, R.px(30))
	end)
	Kit.corner(frame, "Small")
	Kit.stroke(frame, C.Gold, Theme.Stroke.Hairline, 0.4)
	Kit.padding(frame, 0, 12, 0, 12)
	self.Label = Kit.text({
		Text = "",
		Role = "Label",
		Font = Theme.Fonts.Label,
		Size = UDim2.fromScale(0, 1),
		AutoSize = Enum.AutomaticSize.X,
		Parent = frame,
	})
	self.Frame = frame
	return self
end

function Tooltip:Show(text: string, anchor: GuiObject)
	if Responsive.isMobile() then
		return
	end
	self.Label.Text = text
	local rootPos = self.Root.AbsolutePosition
	local rootSize = self.Root.AbsoluteSize
	local p = anchor.AbsolutePosition - rootPos
	local s = anchor.AbsoluteSize
	local gap = Responsive.px(10)
	local centerX = p.X + s.X / 2
	local f = self.Frame
	if centerX < rootSize.X * 0.33 then
		f.AnchorPoint = Vector2.new(0, 0.5)
		f.Position = UDim2.fromOffset(p.X + s.X + gap, p.Y + s.Y / 2)
	elseif centerX > rootSize.X * 0.67 then
		f.AnchorPoint = Vector2.new(1, 0.5)
		f.Position = UDim2.fromOffset(p.X - gap, p.Y + s.Y / 2)
	else
		f.AnchorPoint = Vector2.new(0.5, 1)
		f.Position = UDim2.fromOffset(centerX, p.Y - gap)
	end
	-- UIScale on the root (virtual preview) scales offsets; compensate.
	local scale = self.Root:FindFirstChildOfClass("UIScale")
	if scale and scale.Scale ~= 1 then
		local k = 1 / scale.Scale
		f.Position = UDim2.fromOffset(f.Position.X.Offset * k, f.Position.Y.Offset * k)
	end
	f.Visible = true
end

function Tooltip:Hide()
	self.Frame.Visible = false
end

return Tooltip
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="ModuleScript" referent="RBX000133">
					<Properties>
						<string name="Name">Responsive</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Responsive
	Screen metrics + device classification + the "unit" used for small offset
	details (padding, corner radius, stroke, text size).

	Primary layout (positions/sizes of panels, HUD clusters, windows) is done
	with Scale + AnchorPoint + aspect-ratio constraints. The unit only drives
	minor details so they keep the same *relative* size from 720p to 4K.

	A virtual resolution can be forced (Dev UI Lab) to preview any device:
	the whole UI root is laid out at that pixel size and scaled to fit.
]]

local GuiService = game:GetService("GuiService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)
local Theme = require(script.Parent:WaitForChild("Theme"))

local Responsive = {}
Responsive.Changed = Signal.new()

Responsive.Width = 1920
Responsive.Height = 1080
Responsive.Device = "Desktop" -- "Desktop" | "Tablet" | "Phone"
Responsive.Portrait = false
Responsive.IsTouch = false
Responsive.Unit = 1
Responsive.TopInset = 58
Responsive.UserScale = 1
Responsive.Virtual = nil -- { Width, Height, Device, Touch } when previewing

-- Weak keys: destroyed/unreferenced instances are collected automatically.
local bindings: { [Instance]: { { any } } } = setmetatable({}, { __mode = "k" }) :: any
local roots = {} -- { { Frame, UIScale } }

local function realViewport(): Vector2
	local cam = Workspace.CurrentCamera
	if cam then
		local v = cam.ViewportSize
		if v.X > 1 and v.Y > 1 then
			return v
		end
	end
	return Vector2.new(1920, 1080)
end

local function compute()
	local v = Responsive.Virtual
	local w, h, touch
	if v then
		w, h, touch = v.Width, v.Height, v.Touch
	else
		local vp = realViewport()
		w, h = vp.X, vp.Y
		touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	end
	local shortSide = math.min(w, h)
	local device
	if v and v.Device then
		device = v.Device
	elseif touch then
		device = shortSide < 600 and "Phone" or "Tablet"
	else
		device = "Desktop"
	end
	local unit
	if device == "Phone" then
		unit = math.clamp(shortSide / 520, 0.62, 1.15)
	elseif device == "Tablet" then
		unit = math.clamp(shortSide / 900, 0.75, 1.6)
	else
		unit = math.clamp(math.min(w / 1920, h / 1080), 0.6, 2.4)
	end
	unit *= Responsive.UserScale

	local inset = 58
	if not v then
		local ok, tb = pcall(function()
			return GuiService.TopbarInset
		end)
		if ok and tb and tb.Height > 0 then
			inset = tb.Height
		end
	elseif device == "Phone" then
		inset = 44
	end

	local changed = w ~= Responsive.Width or h ~= Responsive.Height or device ~= Responsive.Device
		or math.abs(unit - Responsive.Unit) > 1e-4 or inset ~= Responsive.TopInset or touch ~= Responsive.IsTouch
	Responsive.Width = w
	Responsive.Height = h
	Responsive.Device = device
	Responsive.Portrait = h > w
	Responsive.IsTouch = touch or device ~= "Desktop"
	Responsive.Unit = unit
	Responsive.TopInset = inset
	return changed
end

-- Integer pixels for a 1080p design value.
function Responsive.px(n: number): number
	local v = n * Responsive.Unit
	if v > 0 and v < 1 then
		return 1
	end
	return math.floor(v + 0.5)
end

-- Fractional pixels (strokes look better unrounded).
function Responsive.pxf(n: number): number
	return n * Responsive.Unit
end

function Responsive.text(role: string): number
	local spec = Theme.TextSizes[role] or Theme.TextSizes.Body
	local size = spec[1] * Responsive.Unit
	if Responsive.Device == "Phone" then
		size *= 1.06
	end
	return math.max(spec[2], math.floor(size + 0.5))
end

function Responsive.isMobile(): boolean
	return Responsive.Device ~= "Desktop"
end

-- Re-evaluates fn(Responsive) into inst[prop] now and on every change.
function Responsive.bind(inst: Instance, prop: string, fn)
	local list = bindings[inst]
	if not list then
		list = {}
		bindings[inst] = list
	end
	-- replace an existing binding for the same property
	for _, b in list do
		if b[1] == prop then
			b[2] = fn
			local target: any = inst
			target[prop] = fn(Responsive)
			return inst
		end
	end
	table.insert(list, { prop, fn })
	local ok, err = pcall(function()
		(inst :: any)[prop] = fn(Responsive)
	end)
	if not ok then
		warn("[Responsive] bind failed: " .. tostring(err))
	end
	return inst
end

function Responsive.unbind(inst: Instance)
	bindings[inst] = nil
end

function Responsive.registerRoot(frame: Frame, scale: UIScale)
	table.insert(roots, { frame, scale })
	Responsive.applyRoot(frame, scale)
end

function Responsive.applyRoot(frame: Frame, scale: UIScale)
	local v = Responsive.Virtual
	if v then
		local real = realViewport()
		local fit = math.min(real.X / v.Width, real.Y / v.Height)
		frame.AnchorPoint = Vector2.new(0.5, 0.5)
		frame.Position = UDim2.fromScale(0.5, 0.5)
		frame.Size = UDim2.fromOffset(v.Width, v.Height)
		scale.Scale = fit
	else
		frame.AnchorPoint = Vector2.zero
		frame.Position = UDim2.fromScale(0, 0)
		frame.Size = UDim2.fromScale(1, 1)
		scale.Scale = 1
	end
end

local function refresh(force: boolean?)
	local changed = compute()
	if not changed and not force then
		return
	end
	for inst, list in bindings do
		for _, b in list do
			local ok, err = pcall(function()
				(inst :: any)[b[1]] = b[2](Responsive)
			end)
			if not ok then
				warn("[Responsive] binding error: " .. tostring(err))
			end
		end
	end
	for _, r in roots do
		Responsive.applyRoot(r[1], r[2])
	end
	Responsive.Changed:Fire()
end

function Responsive.refresh()
	refresh(true)
end

function Responsive.setVirtual(width: number, height: number, device: string?, touch: boolean?)
	Responsive.Virtual = {
		Width = width,
		Height = height,
		Device = device,
		Touch = touch == true or device == "Phone" or device == "Tablet",
	}
	refresh(true)
end

function Responsive.clearVirtual()
	Responsive.Virtual = nil
	refresh(true)
end

function Responsive.setUserScale(s: number)
	Responsive.UserScale = math.clamp(s, 0.8, 1.25)
	refresh(true)
end

function Responsive.Init()
	compute()
	local function hookCamera()
		local cam = Workspace.CurrentCamera
		if cam then
			cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
				refresh(false)
			end)
		end
	end
	hookCamera()
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		hookCamera()
		refresh(false)
	end)
	UserInputService.LastInputTypeChanged:Connect(function()
		refresh(false)
	end)
	pcall(function()
		GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(function()
			refresh(false)
		end)
	end)
end

return Responsive
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000134">
					<Properties>
						<string name="Name">Theme</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Theme
	The single visual system for every menu: colors, type scale, radii,
	strokes, layering and motion. Nothing in the UI hardcodes its own colors.
]]

local Theme = {}

Theme.Colors = {
	-- glass panels
	Panel = Color3.fromRGB(19, 21, 27),
	PanelLight = Color3.fromRGB(30, 33, 41),
	Surface = Color3.fromRGB(29, 32, 40),
	SurfaceHover = Color3.fromRGB(38, 42, 52),
	SurfaceDeep = Color3.fromRGB(12, 14, 18),
	Divider = Color3.fromRGB(64, 58, 46),

	-- brand
	Gold = Color3.fromRGB(206, 170, 98),
	GoldBright = Color3.fromRGB(242, 208, 134),
	GoldDeep = Color3.fromRGB(140, 108, 52),
	Accent = Color3.fromRGB(246, 144, 44),
	AccentHover = Color3.fromRGB(255, 170, 80),
	AccentDeep = Color3.fromRGB(200, 102, 22),
	Blue = Color3.fromRGB(96, 178, 240),
	BlueDeep = Color3.fromRGB(46, 112, 176),

	-- text
	Text = Color3.fromRGB(246, 238, 221),
	TextMuted = Color3.fromRGB(180, 172, 156),
	TextDim = Color3.fromRGB(124, 119, 108),
	Ink = Color3.fromRGB(36, 22, 8), -- dark text on bright buttons

	-- states
	Danger = Color3.fromRGB(212, 72, 56),
	DangerHover = Color3.fromRGB(232, 96, 78),
	Success = Color3.fromRGB(108, 200, 116),
	Warning = Color3.fromRGB(240, 196, 76),
	Disabled = Color3.fromRGB(58, 61, 70),

	Black = Color3.new(0, 0, 0),
	White = Color3.new(1, 1, 1),
}

-- HUD (always-on-screen elements): white toy-like panels with dark text.
Theme.Hud = {
	Panel = Color3.fromRGB(255, 255, 255),
	Shade = Color3.fromRGB(228, 232, 240), -- bottom of the panel gradient
	Transparency = 0.04,
	Stroke = Color3.fromRGB(176, 184, 202),
	StrokeTransparency = 0.25,
	Text = Color3.fromRGB(32, 36, 52),
	TextMuted = Color3.fromRGB(98, 104, 124),
	Icon = Color3.fromRGB(40, 44, 62),
	Track = Color3.fromRGB(214, 219, 230),
}

Theme.Transparency = {
	Panel = 0.06,
	Surface = 0.12,
	Field = 0.25,
	Backdrop = 0.55,
	Stroke = 0.5,
	StrokeStrong = 0.15,
}

-- Design sizes in px at 1920x1080. Multiplied by the responsive unit.
Theme.Radius = {
	Window = 18,
	Card = 12,
	Button = 10,
	Small = 7,
}

Theme.Stroke = {
	Hairline = 1,
	Normal = 1.5,
	Bold = 2.5,
}

Theme.Fonts = {
	Display = Enum.Font.GothamBlack,
	Title = Enum.Font.GothamBlack,
	Heading = Enum.Font.GothamBold,
	Body = Enum.Font.GothamMedium,
	Label = Enum.Font.GothamBold,
	Caption = Enum.Font.GothamMedium,
	Number = Enum.Font.GothamBlack,
	Micro = Enum.Font.GothamBold,
}

-- Type scale at 1080p (px) and the minimum readable size on any screen.
Theme.TextSizes = {
	Display = { 36, 20 },
	Title = { 25, 16 },
	Heading = { 18, 13 },
	Body = { 15, 12 },
	Label = { 13, 11 },
	Caption = { 12, 10 },
	Micro = { 10.5, 9 },
	Number = { 30, 18 },
}

-- ScreenGui DisplayOrder per layer (deliberate layering, never random ZIndex).
Theme.Layers = {
	World = 5,
	Hud = 10,
	Tooltip = 30,
	Window = 50,
	Notification = 70,
	Modal = 100,
	Loading = 200,
}

Theme.Motion = {
	Open = 0.19,
	Close = 0.14,
	StartScale = 0.96,
	Hover = 0.09,
	Press = 0.06,
	PressScale = 0.95,
}

return Theme
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000135">
					<Properties>
						<string name="Name">WindowBase</string>
						<ProtectedString name="Source"><![CDATA[--[[
	WindowBase
	Shared frame for every major window: glass panel, header (icon, title,
	subtitle, close/back button), content area, responsive sizing per device.

	Spec per device: { Width, Height, Aspect? } as fractions of the screen.
	Desktop windows keep their aspect ratio (FitWithinMaxSize) so the inner
	Scale layout never stretches on ultrawide / 16:10 / 4K.
]]

local UI = script.Parent
local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Create = require(UI.Create)
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)

local C = Theme.Colors

local WindowBase = {}
WindowBase.__index = WindowBase

local DEFAULT_SPEC = {
	Desktop = { Width = 0.66, Height = 0.78, Aspect = 1.6 },
	Tablet = { Width = 0.9, Height = 0.84, Aspect = 1.5 },
	Phone = { Width = 0.96, Height = 1, Aspect = nil },
	PhonePortrait = { Width = 0.96, Height = 1, Aspect = nil },
}

function WindowBase.new(opts: { [string]: any })
	local self = setmetatable({}, WindowBase)
	self.Name = opts.Name
	self.Spec = opts.Spec or DEFAULT_SPEC
	self.OnClose = nil -- set by UIController
	self.OnBack = nil -- window may override (mobile sub-panels)

	local win = Kit.window({ Name = opts.Name .. "Window" })
	self.Root = win.Root
	self.Body = win.Body
	self.Scale = Create("UIScale", { Parent = self.Root })
	self.Aspect = Create("UIAspectRatioConstraint", { AspectRatio = 1.6, Parent = self.Root })

	-- header
	local header = Kit.frame({ Name = "Header", Size = UDim2.fromScale(1, 0.1), Parent = self.Body })
	self.Header = header
	local headerPad = Kit.frame({ Name = "HeaderPad", Size = UDim2.fromScale(1, 1), Parent = header })
	Kit.padding(headerPad, 0, 18, 0, 22)
	self.HeaderPad = headerPad

	local titleRow = Kit.frame({ Name = "TitleRow", Size = UDim2.fromScale(0.86, 1), Parent = headerPad })
	Kit.list(titleRow, "H", 14, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	local iconBg = Create("Frame", {
		Name = "IconBg",
		Size = UDim2.fromScale(0.6, 0.6),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundColor3 = C.Accent,
		BorderSizePixel = 0,
		LayoutOrder = 1,
		Parent = titleRow,
	})
	Kit.corner(iconBg, 9)
	Create("UIGradient", { Rotation = 90, Color = ColorSequence.new(C.AccentHover, C.AccentDeep), Parent = iconBg })
	local iconBox = Kit.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.64, 0.64), Parent = iconBg })
	Icons.make(opts.Icon or "Dragon", { Color = C.Ink, Accent = C.Text, Ink = C.Accent }).Parent = iconBox
	self.IconBg = iconBg

	self.Title = Kit.text({
		Name = "Title",
		Text = string.upper(opts.Title or opts.Name),
		Role = "Title",
		Size = UDim2.fromScale(0, 0.6),
		AutoSize = Enum.AutomaticSize.X,
		LayoutOrder = 2,
		Parent = titleRow,
	})
	self.Subtitle = Kit.text({
		Name = "Subtitle",
		Text = opts.Subtitle or "",
		Role = "Label",
		Font = Theme.Fonts.Label,
		Color = C.TextMuted,
		Size = UDim2.fromScale(0, 0.5),
		AutoSize = Enum.AutomaticSize.X,
		LayoutOrder = 3,
		Parent = titleRow,
	})

	self.Close = Kit.closeButton({ Parent = headerPad })
	self.Close.Activated:Connect(function()
		if self.OnBack and self.OnBack() then
			return
		end
		if self.OnClose then
			self.OnClose()
		end
	end)
	self.BackIcon = nil

	Kit.divider(self.Body, {
		Name = "HeaderDivider",
		Position = UDim2.fromScale(0.5, 0.1),
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(0.96, 0, 0, 1),
	})

	-- content area under the header
	self.Content = Kit.frame({
		Name = "Content",
		Position = UDim2.fromScale(0, 0.1),
		Size = UDim2.fromScale(1, 0.9),
		Parent = self.Body,
	})
	self.ContentPad = Kit.padding(self.Content, 14, 22, 20, 22)

	-- overlay for popovers (always above content)
	self.Overlay = Kit.frame({ Name = "Overlay", Size = UDim2.fromScale(1, 1), ZIndex = 40, Parent = self.Body })

	self:ApplySize()
	return self
end

function WindowBase:SetSubtitle(text: string)
	self.Subtitle.Text = text
end

function WindowBase:DeviceSpec()
	local R = Responsive
	local key = R.Device
	if key == "Phone" and R.Portrait then
		key = "PhonePortrait"
	end
	return self.Spec[key] or self.Spec[R.Device] or DEFAULT_SPEC[key] or DEFAULT_SPEC.Desktop
end

function WindowBase:ApplySize()
	local R = Responsive
	local spec = self:DeviceSpec()
	local root = self.Root
	if R.Device == "Phone" then
		-- fill the safe area below the Roblox top bar
		local margin = R.px(8)
		root.AnchorPoint = Vector2.new(0.5, 1)
		root.Position = UDim2.new(0.5, 0, 1, -margin)
		root.Size = UDim2.new(spec.Width, 0, spec.Height, -(R.TopInset + margin * 2))
	else
		root.AnchorPoint = Vector2.new(0.5, 0.5)
		root.Position = UDim2.fromScale(0.5, 0.52)
		root.Size = UDim2.fromScale(spec.Width, spec.Height)
	end
	if spec.Aspect then
		self.Aspect.AspectRatio = spec.Aspect
		self.Aspect.Parent = root
	else
		self.Aspect.Parent = nil
	end
	-- header proportions
	local headerScale = R.Device == "Phone" and (R.Portrait and 0.075 or 0.14) or 0.1
	self.Header.Size = UDim2.fromScale(1, headerScale)
	self.Content.Position = UDim2.fromScale(0, headerScale)
	self.Content.Size = UDim2.fromScale(1, 1 - headerScale)
	local divider = self.Body:FindFirstChild("HeaderDivider")
	if divider then
		divider.Position = UDim2.fromScale(0.5, headerScale)
	end
	if self.ApplyLayout then
		self:ApplyLayout()
	end
end

return WindowBase
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="Folder" referent="RBX000136">
					<Properties>
						<string name="Name">Windows</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX000137">
						<Properties>
							<string name="Name">EggStorageWindow</string>
							<ProtectedString name="Source"><![CDATA[--[[
	EggStorageWindow ("Egg Bag")
	Carried eggs as 3D cards (ViewportFrames), nest status, and actions:
	take a chosen egg in your hand (HOLD - then place it in the nest yourself), or
	put the egg in hand / the best egg into the nest in one click.
	Data: data.Eggs (list), data.Incubator, data.Upgrades.EggStorage.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Kit = require(UI.Kit)
local WindowBase = require(UI.WindowBase)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local EggVisual = require(Shared:WaitForChild("EggVisual"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local C = Theme.Colors

local EggStorageWindow = {}
EggStorageWindow.__index = EggStorageWindow
setmetatable(EggStorageWindow, { __index = WindowBase })

local TIER_NAMES = { "Tier I", "Tier II", "Tier III", "Tier IV", "Tier V", "Tier VI" }

function EggStorageWindow.new(ui, registry)
	local self = WindowBase.new({
		Name = "EggStorage",
		Title = "Egg Bag",
		Icon = "Egg",
		Spec = {
			Desktop = { Width = 0.56, Height = 0.7, Aspect = 1.5 },
			Tablet = { Width = 0.84, Height = 0.8, Aspect = 1.45 },
			Phone = { Width = 0.9, Height = 1 },
			PhonePortrait = { Width = 0.96, Height = 1 },
		},
	})
	setmetatable(self, EggStorageWindow)
	self.UIC = ui
	self.Registry = registry
	self.Cards = {}
	self:Build()
	return self
end

function EggStorageWindow:Build()
	-- status strip
	local strip = Kit.surface({ Name = "Status", Size = UDim2.fromScale(1, 0.13), Parent = self.Content })
	local sp = Kit.frame({ Size = UDim2.fromScale(1, 1), Parent = strip })
	Kit.scalePadding(sp, 0.12, 0.02, 0.12, 0.02)
	self.BagText = Kit.text({ Name = "Bag", Text = "", Role = "Heading", Size = UDim2.fromScale(0.34, 1), Parent = sp })
	self.NestText = Kit.text({
		Name = "Nest",
		Text = "",
		Role = "Body",
		Color = C.TextMuted,
		XAlign = Enum.TextXAlignment.Center,
		Position = UDim2.fromScale(0.34, 0),
		Size = UDim2.fromScale(0.32, 1),
		Parent = sp,
	})
	local placeBest = Kit.button({
		Name = "PlaceBest",
		Text = "PLACE IN NEST",
		Icon = "Home",
		Style = "Primary",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromScale(0.32, 0.9),
		Parent = sp,
	})
	placeBest.Activated:Connect(function()
		self:Place(nil)
	end)
	self.PlaceBest = placeBest

	-- grid of egg cards
	local scroll = Kit.scroll({ Name = "Grid", Position = UDim2.fromScale(0, 0.16), Size = UDim2.fromScale(1, 0.72), Parent = self.Content })
	Kit.padding(scroll, 4, 10, 4, 4)
	local grid = Instance.new("UIGridLayout")
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Left
	grid.Parent = scroll
	Responsive.bind(grid, "CellSize", function(R)
		local cols = R.Device == "Phone" and (R.Portrait and 2 or 4) or 5
		return UDim2.new(1 / cols, -R.px(10), 0, R.px(R.Device == "Phone" and 170 or 196))
	end)
	Responsive.bind(grid, "CellPadding", function(R)
		return UDim2.fromOffset(R.px(10), R.px(10))
	end)
	self.Grid = scroll
	self.Empty = Kit.text({
		Name = "Empty",
		Text = "Your bag is empty.\nFly around Dragon Haven and grab the glowing eggs!",
		Role = "Body",
		Color = C.TextMuted,
		Wrapped = true,
		XAlign = Enum.TextXAlignment.Center,
		Position = UDim2.fromScale(0.1, 0.35),
		Size = UDim2.fromScale(0.8, 0.3),
		Parent = self.Content,
	})
	self.Hint = Kit.text({
		Name = "Hint",
		Text = "Eggs hatch in your sanctuary nest. Bigger bag: Egg Storage upgrade at the Forge.",
		Role = "Caption",
		Color = C.TextDim,
		Scaled = true,
		Wrapped = true,
		MinTextSize = 9,
		XAlign = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0.08),
		Parent = self.Content,
	})
end

local function eggCard(egg, order: number, held: boolean, onHold: () -> ())
	local def = EggConfig.Eggs[egg.Type] or EggConfig.Eggs.HavenEgg
	local card = Kit.surface({ Name = "Egg_" .. egg.Id, LayoutOrder = order })
	-- 3D egg preview
	local vp = Instance.new("ViewportFrame")
	vp.Name = "Preview"
	vp.BackgroundTransparency = 1
	vp.Size = UDim2.fromScale(1, 0.58)
	vp.Ambient = Color3.fromRGB(150, 150, 160)
	vp.LightColor = Color3.fromRGB(255, 244, 230)
	vp.LightDirection = Vector3.new(-0.4, -1, -0.6)
	vp.Parent = card
	local model = EggVisual.build(egg.Type, { Beam = false, Sparkles = false, Light = false })
	EggVisual.place(model, CFrame.new(0, 0, 0) * CFrame.Angles(0, math.rad(25), math.rad(-8)))
	model.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 0.6, 8.4), Vector3.new(0, 0.1, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	-- glow chip
	local glow = Kit.frame({
		Name = "Glow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.fromScale(0.55, 0.45),
		BackgroundColor3 = def.Glow,
		BackgroundTransparency = 0.82,
		ZIndex = 0,
		Parent = card,
	})
	Kit.corner(glow, "pill")
	-- luck badge (top-left)
	local luck = math.max(1, tonumber(egg.Luck) or 1)
	local lb = Kit.text({
		Name = "Luck",
		Text = "x" .. tostring(luck) .. " LUCK",
		Role = "Label",
		Font = Theme.Fonts.Title,
		Color = EggConfig.luckColor(luck),
		XAlign = Enum.TextXAlignment.Left,
		Position = UDim2.fromScale(0.06, 0.03),
		Size = UDim2.fromScale(0.88, 0.1),
		ZIndex = 3,
		Parent = card,
	})
	lb.TextStrokeTransparency = 0.4
	Kit.text({
		Name = "Name",
		Text = def.Name,
		Role = "Label",
		Font = Theme.Fonts.Title,
		XAlign = Enum.TextXAlignment.Center,
		Position = UDim2.fromScale(0.05, 0.58),
		Size = UDim2.fromScale(0.9, 0.12),
		Truncate = true,
		Parent = card,
	})
	Kit.text({
		Name = "Info",
		Text = string.format("%s  -  %s", TIER_NAMES[def.Tier] or "", Format.duration(def.HatchTime)),
		Role = "Caption",
		Color = C.TextMuted,
		XAlign = Enum.TextXAlignment.Center,
		Position = UDim2.fromScale(0.05, 0.7),
		Size = UDim2.fromScale(0.9, 0.1),
		Parent = card,
	})
	local btn = Kit.button({
		Name = "Hold",
		Text = held and "IN HAND" or "HOLD",
		Style = held and "Primary" or "Secondary",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.96, 0),
		Size = UDim2.fromScale(0.8, 0.14),
		Parent = card,
	})
	btn:SetEnabled(not held)
	btn.Activated:Connect(onHold)
	return card
end

function EggStorageWindow:Place(id: string?)
	self.PlaceBest:SetBusy(true)
	task.spawn(function()
		local res = Net.request("Egg", "Place", id and { Id = id } or {})
		self.PlaceBest:SetBusy(false)
		if self.UIC.HandleResult(res, "Egg placed in your nest!") then
			self:Refresh()
		end
	end)
end

function EggStorageWindow:Refresh()
	local D = self.Registry and self.Registry.DataController
	local data = D and D.all()
	if not data then
		return
	end
	local eggs = data.Eggs or {}
	local cap = TreeConfig.eggCapacity(data)
	self.BagText.Text = string.format("BAG  %d / %d", #eggs, cap)
	self.BagText.TextColor3 = #eggs >= cap and C.Warning or C.Text
	local inc = data.Incubator or { Unlocked = 0, Slots = {} }
	local used, ready = 0, 0
	local now = workspace:GetServerTimeNow()
	for _, s in inc.Slots or {} do
		used += 1
		if s.Ready <= now then
			ready += 1
		end
	end
	self.NestText.Text = string.format("Nest  %d / %d%s", used, inc.Unlocked, ready > 0 and ("  -  " .. ready .. " ready!") or "")
	self.NestText.TextColor3 = ready > 0 and C.Success or C.TextMuted
	self.PlaceBest:SetEnabled(#eggs > 0 and used < inc.Unlocked)
	for _, c in self.Cards do
		c:Destroy()
	end
	table.clear(self.Cards)
	local heldId = Players.LocalPlayer:GetAttribute("HeldEggId")
	for i, egg in eggs do
		local card = eggCard(egg, i, egg.Id == heldId, function()
			local hc = self.Registry and self.Registry.HeldEggController
			if hc then
				hc.hold(egg.Id)
			end
		end)
		card.Parent = self.Grid
		table.insert(self.Cards, card)
	end
	self.Empty.Visible = #eggs == 0
	self:SetSubtitle(string.format("%d egg%s", #eggs, #eggs == 1 and "" or "s"))
end

function EggStorageWindow:OnOpen()
	self:Refresh()
	if not self._observing then
		self._observing = true
		local D = self.Registry and self.Registry.DataController
		Players.LocalPlayer:GetAttributeChangedSignal("HeldEggId"):Connect(function()
			if self.Root.Visible then
				self:Refresh()
			end
		end)
		if D then
			D.changed("Eggs"):Connect(function()
				if self.Root.Visible then
					self:Refresh()
				end
			end)
			D.changed("Incubator"):Connect(function()
				if self.Root.Visible then
					self:Refresh()
				end
			end)
		end
	end
end

return EggStorageWindow
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX000138">
						<Properties>
							<string name="Name">InventoryWindow</string>
							<ProtectedString name="Source"><![CDATA[--[[
	InventoryWindow ("Dragons")
	The player's dragon collection.

	  * virtualized card grid: only the rows on screen (+1 buffer row) exist;
	    cards are pooled and re-bound while scrolling, 3D previews are built
	    through a small per-frame queue and cached per card
	  * search / rarity filter / sort (InventoryQuery - same rules as server)
	  * details panel: turntable 3D preview, rarity / mutation / state tags,
	    level + XP, stats, and every action:
	      RIDE, EQUIP, FEED, MUTATE, PLACE / TAKE BACK, LOCK, RELEASE
	  * place mode (from a sanctuary perch prompt): pick a dragon for perch n
	  * desktop / tablet: grid + details side by side; phones: the details
	    slide over the grid and the close button becomes "back"

	Open args: { SelectId?, SelectFirst?, ShowDetails?, PlaceSlot? }
	Every action is a server request; the window only renders the mirror.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Create = require(UI.Create)
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local WindowBase = require(UI.WindowBase)

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local InventoryQuery = require(Shared:WaitForChild("InventoryQuery"))
local DragonVisual = require(Shared:WaitForChild("Dragons"):WaitForChild("DragonVisual"))
local Animator = require(Shared:WaitForChild("Dragons"):WaitForChild("Animator"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))
local Odds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Odds"))
local EconomyConfig = require(Configs:WaitForChild("EconomyConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local C = Theme.Colors

local InventoryWindow = {}
InventoryWindow.__index = InventoryWindow
setmetatable(InventoryWindow, { __index = WindowBase })

local CARD_GAP = 10 -- px at 1080p
local FILTER_LABELS = { "All", "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Secret", "Exclusive" }

-- ============================================================== 3D previews
-- Builds a posed, static dragon for a ViewportFrame. Returns model, bbox cf, size.
local function buildPreview(speciesId: string, mutation: string?, yaw: number)
	local ok, model = pcall(function()
		local m = DragonVisual.build(speciesId, { Mutation = mutation, Saddle = false, Detail = "Medium" })
		local pose = Animator.samplePose(m, "Idle", 0.35)
		DragonVisual.pose(m, pose, CFrame.Angles(0, yaw, 0))
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") then
				d.CastShadow = false
			end
		end
		return m
	end)
	if not ok then
		warn("[Inventory] preview failed: " .. tostring(model))
		return nil
	end
	return model
end

local function frameCamera(cam: Camera, model: Model, tightness: number, orbit: number?)
	local cf, size = model:GetBoundingBox()
	local center = cf.Position
	local radius = math.max(size.X, size.Y, size.Z) * 0.5 * tightness
	local dist = radius / math.tan(math.rad(cam.FieldOfView) * 0.5)
	local a = orbit or 0
	local offset = Vector3.new(math.sin(a) * dist, size.Y * 0.18 + dist * 0.12, math.cos(a) * dist)
	cam.CFrame = CFrame.lookAt(center + offset, center + Vector3.new(0, -size.Y * 0.04, 0))
	return center, dist, size
end

-- Shared build queue so scrolling never builds more than a couple of models per frame.
local buildQueue: { () -> () } = {}
local queueConn: RBXScriptConnection? = nil
local function enqueue(fn: () -> ())
	table.insert(buildQueue, fn)
	if not queueConn then
		queueConn = RunService.Heartbeat:Connect(function()
			for _ = 1, 2 do
				local job = table.remove(buildQueue, 1)
				if not job then
					break
				end
				job()
			end
			if #buildQueue == 0 and queueConn then
				queueConn:Disconnect()
				queueConn = nil
			end
		end)
	end
end

-- ============================================================== card
local Card = {}
Card.__index = Card

function Card.new(window)
	local self = setmetatable({}, Card)
	self.Window = window
	self.Uid = nil
	self.ModelKey = nil
	self.Token = 0
	local root = Create("TextButton", {
		Name = "Card",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = C.Surface,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
		Selectable = true,
		ClipsDescendants = false,
	})
	self.Root = root
	Kit.corner(root, "Card")
	self.Stroke = Kit.stroke(root, C.Gold, Theme.Stroke.Normal, 0.6)
	self.Scale = Create("UIScale", { Parent = root })
	-- rarity backlight
	local glow = Create("Frame", {
		Name = "Glow",
		BackgroundColor3 = C.Gold,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 0.72),
		Parent = root,
	})
	Kit.corner(glow, "Card")
	self.GlowGrad = Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Parent = glow,
	})
	self.Glow = glow
	local vp = Create("ViewportFrame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Position = UDim2.fromScale(0.03, 0.03),
		Size = UDim2.fromScale(0.94, 0.62),
		Ambient = Color3.fromRGB(150, 146, 140),
		LightColor = Color3.fromRGB(255, 244, 226),
		LightDirection = Vector3.new(-0.5, -1, -0.7),
		Parent = root,
	})
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	cam.Parent = vp
	vp.CurrentCamera = cam
	self.Viewport = vp
	self.Camera = cam
	-- placeholder icon while the 3D model builds
	local ph = Kit.frame({ Name = "Placeholder", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.fromScale(0.34, 0.34), SizeConstraint = Enum.SizeConstraint.RelativeXX, Parent = root })
	Icons.make("Dragon", { Color = C.TextDim, Accent = C.SurfaceHover, Ink = C.Surface }).Parent = ph
	self.Placeholder = ph
	-- level badge (top-left)
	local lvl, lvlLabel = Kit.badge({ Name = "Level", Text = "LV 1", Color = C.Panel, TextColor = C.Text, Transparency = 0.15, Size = UDim2.fromScale(0.36, 0.11), Position = UDim2.fromScale(0.05, 0.04), Parent = root })
	self.LevelLabel = lvlLabel
	self.LevelBadge = lvl
	-- state icons (top-right): equipped / placed / locked
	local icons = Kit.frame({ Name = "StateIcons", AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(0.95, 0.04), Size = UDim2.fromScale(0.5, 0.11), Parent = root })
	Kit.list(icons, "H", 3, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local function stateIcon(name: string, icon: string, bg: Color3, order: number)
		local f = Create("Frame", {
			Name = name,
			BackgroundColor3 = bg,
			BorderSizePixel = 0,
			Size = UDim2.fromScale(1, 1),
			SizeConstraint = Enum.SizeConstraint.RelativeYY,
			LayoutOrder = order,
			Visible = false,
			Parent = icons,
		})
		Kit.corner(f, "pill")
		local holder = Kit.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.62, 0.62), Parent = f })
		Icons.make(icon, { Color = C.Ink, Accent = C.Ink, Ink = bg }).Parent = holder
		return f
	end
	self.EquippedIcon = stateIcon("Equipped", "Check", C.Accent, 1)
	self.PlacedIcon = stateIcon("Placed", "Home", C.Blue, 2)
	self.LockedIcon = stateIcon("Locked", "Lock", C.GoldBright, 3)
	-- mutation chip (over the preview, bottom)
	local mut, mutLabel = Kit.badge({ Name = "Mutation", Text = "", Color = C.Gold, Size = UDim2.fromScale(0.5, 0.1), AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.645), Parent = root })
	self.MutationBadge = mut
	self.MutationLabel = mutLabel
	-- name + rarity / income
	self.Name = Kit.text({
		Name = "DragonName",
		Text = "",
		Role = "Label",
		Font = Theme.Fonts.Title,
		Truncate = true,
		XAlign = Enum.TextXAlignment.Center,
		Position = UDim2.fromScale(0.05, 0.67),
		Size = UDim2.fromScale(0.9, 0.14),
		Parent = root,
	})
	self.Rarity = Kit.text({
		Name = "Rarity",
		Text = "",
		Role = "Micro",
		Font = Theme.Fonts.Micro,
		Position = UDim2.fromScale(0.06, 0.82),
		Size = UDim2.fromScale(0.43, 0.12),
		Truncate = true,
		Parent = root,
	})
	self.Income = Kit.text({
		Name = "Income",
		Text = "",
		Role = "Micro",
		Font = Theme.Fonts.Micro,
		Color = C.GoldBright,
		XAlign = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(0.94, 0.82),
		Size = UDim2.fromScale(0.43, 0.12),
		Truncate = true,
		Parent = root,
	})
	root.MouseEnter:Connect(function()
		if self.Uid ~= window.SelectedId then
			self.Stroke.Transparency = 0.25
		end
		Kit.tween(self.Scale, Theme.Motion.Hover, { Scale = 1.025 })
	end)
	root.MouseLeave:Connect(function()
		self:PaintSelection()
		Kit.tween(self.Scale, Theme.Motion.Hover, { Scale = 1 })
	end)
	root.Activated:Connect(function()
		if self.Uid then
			Kit.hooks.Click()
			window:Select(self.Uid, true)
		end
	end)
	return self
end

function Card:PaintSelection()
	local selected = self.Uid ~= nil and self.Uid == self.Window.SelectedId
	local rarity = self.Record and DragonConfig.Rarities[self.Record.Rarity] or DragonConfig.Rarities.Common
	if selected then
		self.Stroke.Color = C.Accent
		self.Stroke.Transparency = 0
		self.Stroke.Thickness = math.max(2, Responsive.pxf(Theme.Stroke.Bold))
	else
		self.Stroke.Color = rarity.Color
		self.Stroke.Transparency = 0.55
		self.Stroke.Thickness = math.max(1, Responsive.pxf(Theme.Stroke.Normal))
	end
end

function Card:SetModel(record)
	local mkey = record.SpeciesId .. "|" .. (record.Mutation or "None")
	if self.ModelKey == mkey and self.Model then
		return
	end
	self.ModelKey = mkey
	if self.Model then
		self.Model:Destroy()
		self.Model = nil
	end
	self.Placeholder.Visible = true
	self.Token += 1
	local token = self.Token
	enqueue(function()
		if self.Token ~= token or not self.Root.Parent then
			return
		end
		local model = buildPreview(record.SpeciesId, record.Mutation, math.rad(180 - 32))
		if not model then
			return
		end
		if self.Token ~= token then
			model:Destroy()
			return
		end
		model.Parent = self.Viewport
		frameCamera(self.Camera, model, 0.78, 0)
		self.Model = model
		self.Placeholder.Visible = false
	end)
end

function Card:Bind(record, state)
	self.Uid = record.UniqueId
	self.Record = record
	local rarity = DragonConfig.Rarities[record.Rarity] or DragonConfig.Rarities.Common
	self.Glow.BackgroundColor3 = rarity.Color
	self.Name.Text = record.Name
	self.Rarity.Text = string.upper(record.Rarity)
	self.Rarity.TextColor3 = rarity.Glow
	self.Income.Text = "$" .. Format.abbreviate(record.IncomePerSecond, record.IncomePerSecond >= 1000 and 0 or 1) .. "/s"
	self.LevelLabel.Text = "LV " .. tostring(record.Level)
	local mutation = MutationConfig.Mutations[record.Mutation]
	if mutation and record.Mutation ~= "None" then
		self.MutationBadge.Visible = true
		self.MutationBadge.BackgroundColor3 = mutation.Color
		self.MutationLabel.Text = string.upper(mutation.Name)
	else
		self.MutationBadge.Visible = false
	end
	self.EquippedIcon.Visible = state.Equipped
	self.PlacedIcon.Visible = record.PlacedNestId ~= ""
	self.LockedIcon.Visible = record.Locked == true
	self.Root.Name = "Card_" .. record.UniqueId
	self:PaintSelection()
	self:SetModel(record)
end

function Card:Unbind()
	self.Uid = nil
	self.Record = nil
	self.Root.Visible = false
end

function Card:Destroy()
	self.Token += 1
	self.Root:Destroy()
end

-- ============================================================== window
function InventoryWindow.new(ui, registry)
	local self = WindowBase.new({
		Name = "Inventory",
		Title = "Dragons",
		Icon = "Dragon",
		Spec = {
			Desktop = { Width = 0.76, Height = 0.82, Aspect = 1.72 },
			Tablet = { Width = 0.95, Height = 0.88, Aspect = 1.58 },
			Phone = { Width = 0.97, Height = 1 },
			PhonePortrait = { Width = 0.97, Height = 1 },
		},
	})
	setmetatable(self, InventoryWindow)
	self.UIC = ui
	self.Registry = registry
	self.Data = registry.DataController
	self.Query = { Search = "", Filter = "All", Sort = "Best" }
	self.List = {} -- ordered uids
	self.Cards = {} -- index -> Card (bound)
	self.Pool = {} -- free Card objects
	self.SelectedId = nil
	self.PlaceSlot = nil
	self.ShowingDetails = false
	self.Busy = false
	self:Build()
	self.OnBack = function()
		if self.Compact and self.ShowingDetails then
			self:ShowDetails(false)
			return true
		end
		return false
	end
	return self
end

-- ============================================================== build
function InventoryWindow:Build()
	local content = self.Content

	-- left: list pane
	local listPane = Kit.frame({ Name = "ListPane", Parent = content })
	self.ListPane = listPane

	local toolbar = Kit.frame({ Name = "Toolbar", Parent = listPane })
	self.Toolbar = toolbar
	self.Search = Kit.searchBox({ Name = "Search", Placeholder = "Search dragons...", Parent = toolbar })
	self.Search.Changed:Connect(function(text)
		self.Query.Search = text
		self:Rebuild(true)
	end)
	self.Filter = Kit.dropdown({
		Name = "Filter",
		Options = FILTER_LABELS,
		Value = "All",
		OverlayParent = self.Overlay,
		Parent = toolbar,
	})
	self.Filter.Changed:Connect(function(v)
		self.Query.Filter = v
		self:Rebuild(true)
	end)
	self.Sort = Kit.dropdown({
		Name = "Sort",
		Options = InventoryQuery.Sorts,
		Value = "Best",
		Prefix = "SORT: ",
		OverlayParent = self.Overlay,
		Parent = toolbar,
	})
	self.Sort.Changed:Connect(function(v)
		self.Query.Sort = v
		self:Rebuild(true)
	end)

	-- virtualized grid
	local grid = Kit.scroll({ Name = "Grid", AutoCanvas = false, Parent = listPane })
	grid.ClipsDescendants = true
	self.Grid = grid
	self.Canvas = Kit.frame({ Name = "Canvas", Size = UDim2.fromScale(1, 1), Parent = grid })
	grid:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
		self:UpdateVisible()
	end)
	grid:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:Relayout()
	end)
	self.Empty = Kit.text({
		Name = "Empty",
		Text = "",
		Role = "Body",
		Color = C.TextMuted,
		Wrapped = true,
		XAlign = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromScale(0.8, 0.3),
		Visible = false,
		Parent = listPane,
	})

	-- footer: capacity, perches, auto place / place mode banner
	local footer = Kit.surface({ Name = "Footer", Parent = listPane })
	self.Footer = footer
	local fpad = Kit.frame({ Name = "Pad", Size = UDim2.fromScale(1, 1), Parent = footer })
	Kit.scalePadding(fpad, 0.14, 0.015, 0.14, 0.025)
	self.CapacityText = Kit.text({ Name = "Capacity", Text = "", Role = "Label", Font = Theme.Fonts.Label, Size = UDim2.fromScale(0.3, 1), Truncate = true, Parent = fpad })
	self.PerchText = Kit.text({ Name = "Perches", Text = "", Role = "Label", Font = Theme.Fonts.Label, Color = C.TextMuted, Position = UDim2.fromScale(0.3, 0), Size = UDim2.fromScale(0.34, 1), Truncate = true, Parent = fpad })
	self.AutoPlace = Kit.button({
		Name = "AutoPlace",
		Text = "FILL PERCHES",
		Icon = "Home",
		Style = "Secondary",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromScale(1, 0.5),
		Size = UDim2.fromScale(0.34, 1),
		Tooltip = "Rest your best free dragons on every empty perch",
		Parent = fpad,
	})
	self.AutoPlace.Activated:Connect(function()
		self:Request("AutoPlace", {}, function(res)
			self.UIC.Notify("success", string.format("%d dragon%s now resting in your sanctuary", res.data.Placed, res.data.Placed == 1 and " is" or "s are"))
		end)
	end)
	-- place mode banner (replaces the footer contents)
	local banner = Kit.frame({ Name = "PlaceBanner", Size = UDim2.fromScale(1, 1), Visible = false, Parent = fpad })
	self.PlaceBanner = banner
	self.PlaceText = Kit.text({ Name = "Text", Text = "", Role = "Label", Font = Theme.Fonts.Label, Color = C.Accent, Size = UDim2.fromScale(0.64, 1), Truncate = true, Parent = banner })
	local cancel = Kit.button({ Name = "CancelPlace", Text = "CANCEL", Style = "Ghost", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromScale(0.3, 1), Parent = banner })
	cancel.Activated:Connect(function()
		self:SetPlaceSlot(nil)
	end)

	self:BuildDetails()
end

function InventoryWindow:BuildDetails()
	local details = Kit.surface({ Name = "Details", Color = C.PanelLight, Transparency = 0.1, Parent = self.Content })
	self.Details = details
	-- preview
	local pv = Kit.frame({ Name = "PreviewBox", Parent = details })
	self.PreviewBox = pv
	local glow = Create("Frame", { Name = "Glow", BackgroundColor3 = C.Gold, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Parent = pv })
	Kit.corner(glow, "Card")
	Create("UIGradient", {
		Rotation = 90,
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(0.55, 0.62),
			NumberSequenceKeypoint.new(1, 0.9),
		}),
		Parent = glow,
	})
	self.PreviewGlow = glow
	local vp = Create("ViewportFrame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(150, 146, 140),
		LightColor = Color3.fromRGB(255, 244, 226),
		LightDirection = Vector3.new(-0.5, -1, -0.7),
		Parent = pv,
	})
	local cam = Instance.new("Camera")
	cam.FieldOfView = 32
	cam.Parent = vp
	vp.CurrentCamera = cam
	self.Preview = vp
	self.PreviewCam = cam
	self.Orbit = 0
	self.OrbitVel = 0.35
	-- drag to spin
	local dragging = false
	local lastX = 0
	vp.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			lastX = input.Position.X
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local dx = input.Position.X - lastX
			lastX = input.Position.X
			self.Orbit -= dx * 0.012
			self.OrbitVel = 0
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			if dragging then
				dragging = false
				self.OrbitVel = 0.35
			end
		end
	end)
	-- tags over the preview
	local tags = Kit.frame({ Name = "Tags", Position = UDim2.fromScale(0.04, 0.04), Size = UDim2.fromScale(0.92, 0.1), Parent = pv })
	Kit.list(tags, "H", 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	-- RNG title ("1 in 12,500,000") along the bottom of the preview
	self.OddsTitle = Kit.text({
		Name = "OddsTitle",
		Text = "",
		Role = "Title",
		Scaled = true,
		XAlign = Enum.TextXAlignment.Left,
		Position = UDim2.fromScale(0.04, 0.85),
		Size = UDim2.fromScale(0.92, 0.11),
		ZIndex = 3,
		Parent = pv,
	})
	self.OddsTitle.TextStrokeTransparency = 0.4
	local rb, rl = Kit.badge({ Name = "RarityTag", Text = "COMMON", LayoutOrder = 1, Parent = tags })
	rb.Size = UDim2.fromScale(0, 1)
	self.RarityTag, self.RarityTagLabel = rb, rl
	local mb, ml = Kit.badge({ Name = "MutationTag", Text = "", LayoutOrder = 2, Parent = tags })
	mb.Size = UDim2.fromScale(0, 1)
	self.MutationTag, self.MutationTagLabel = mb, ml
	local sb, sl = Kit.badge({ Name = "StateTag", Text = "", Color = C.Panel, TextColor = C.Text, Transparency = 0.2, LayoutOrder = 3, Parent = tags })
	sb.Size = UDim2.fromScale(0, 1)
	self.StateTag, self.StateTagLabel = sb, sl

	-- info
	local info = Kit.frame({ Name = "InfoBox", Parent = details })
	self.InfoBox = info
	self.DName = Kit.text({ Name = "DragonName", Text = "", Role = "Title", Truncate = true, Size = UDim2.fromScale(1, 0.1), Parent = info })
	self.DSpecies = Kit.text({ Name = "Species", Text = "", Role = "Caption", Font = Theme.Fonts.Caption, Color = C.TextMuted, Truncate = true, Position = UDim2.fromScale(0, 0.1), Size = UDim2.fromScale(1, 0.065), Parent = info })
	-- level row
	local lvlRow = Kit.frame({ Name = "LevelRow", Position = UDim2.fromScale(0, 0.18), Size = UDim2.fromScale(1, 0.075), Parent = info })
	self.LevelRow = lvlRow
	local lb, ll = Kit.badge({ Name = "LevelBadge", Text = "LV 1", Color = C.Gold, Size = UDim2.fromScale(0.2, 1), Parent = lvlRow })
	self.DLevelBadge, self.DLevel = lb, ll
	self.DXPBar = Kit.progress({ Name = "XPBar", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0.23, 0.5), Size = UDim2.fromScale(0.45, 0.42), Color = C.Accent, Color2 = C.GoldBright, Parent = lvlRow })
	self.DXPText = Kit.text({ Name = "XP", Text = "", Role = "Micro", Font = Theme.Fonts.Micro, Color = C.TextMuted, XAlign = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromScale(0.3, 1), Truncate = true, Parent = lvlRow })
	-- stats
	local stats = Kit.frame({ Name = "Stats", Position = UDim2.fromScale(0, 0.28), Size = UDim2.fromScale(1, 0.27), Parent = info })
	self.StatsBox = stats
	local _, sv = Kit.statRow({ Name = "SpeedStat", Icon = "Speed", Label = "SPEED", Value = "0", Size = UDim2.fromScale(1, 0.333), Parent = stats })
	local fRow, fv = Kit.statRow({ Name = "FlightStat", Icon = "Wing", Label = "FLIGHT", Value = "0", Size = UDim2.fromScale(1, 0.333), Parent = stats })
	fRow.Position = UDim2.fromScale(0, 0.333)
	local iRow, iv = Kit.statRow({ Name = "IncomeStat", Icon = "Income", Label = "INCOME", Value = "0", ValueColor = C.GoldBright, Size = UDim2.fromScale(1, 0.333), Parent = stats })
	iRow.Position = UDim2.fromScale(0, 0.666)
	self.DSpeed, self.DFlight, self.DIncome = sv, fv, iv
	for _, t in { sv, fv, iv } do
		t.TextScaled = true
		local tsc = Instance.new("UITextSizeConstraint")
		Responsive.bind(tsc, "MaxTextSize", function(R)
			return R.text("Heading")
		end)
		tsc.MinTextSize = 9
		tsc.Parent = t
	end

	-- actions
	local actions = Kit.frame({ Name = "Actions", Position = UDim2.fromScale(0, 0.58), Size = UDim2.fromScale(1, 0.42), Parent = info })
	self.Actions = actions
	local function row(y: number)
		local r = Kit.frame({ Position = UDim2.fromScale(0, y), Size = UDim2.fromScale(1, 0.3), Parent = actions })
		return r
	end
	local r1, r2, r3 = row(0), row(0.35), row(0.7)
	r1.Name, r2.Name, r3.Name = "Row1", "Row2", "Row3"
	local function btn(parent, name, text, icon, style, x, w)
		return Kit.button({ Name = name, Text = text, Icon = icon, Style = style, Position = UDim2.fromScale(x, 0), Size = UDim2.fromScale(w, 1), Parent = parent })
	end
	self.RideBtn = btn(r1, "Ride", "RIDE", "Wing", "Primary", 0, 0.49)
	self.EquipBtn = btn(r1, "Equip", "EQUIP", "Check", "Secondary", 0.51, 0.49)
	self.FeedBtn = btn(r2, "Feed", "FEED", "Food", "Secondary", 0, 0.49)
	self.MutateBtn = btn(r2, "Mutate", "MUTATE", "Sparkle", "Secondary", 0.51, 0.49)
	self.PlaceBtn = btn(r3, "Place", "PLACE", "Home", "Blue", 0, 0.38)
	self.LockBtn = btn(r3, "Lock", "", "Lock", "Secondary", 0.4, 0.2)
	self.ReleaseBtn = btn(r3, "Release", "RELEASE", "Release", "Danger", 0.62, 0.38)
	local lockHolder = self.LockBtn.IconHolder
	if lockHolder then
		self.LockIcon = lockHolder:FindFirstChildWhichIsA("Frame")
		self.UnlockIcon = Icons.make("Unlock", { Color = C.Text, Accent = C.Accent, Ink = C.Panel })
		self.UnlockIcon.Parent = lockHolder
		self.UnlockIcon.Visible = false
	end
	self.RideBtn.Activated:Connect(function()
		self:DoRide()
	end)
	self.EquipBtn.Activated:Connect(function()
		self:DoEquip()
	end)
	self.FeedBtn.Activated:Connect(function()
		self:DoFeed()
	end)
	self.MutateBtn.Activated:Connect(function()
		self:DoMutate()
	end)
	self.PlaceBtn.Activated:Connect(function()
		self:DoPlace()
	end)
	self.LockBtn.Activated:Connect(function()
		self:DoLock()
	end)
	self.ReleaseBtn.Activated:Connect(function()
		self:DoRelease()
	end)

	-- nothing selected
	self.NoSelection = Kit.text({
		Name = "NoSelection",
		Text = "Select a dragon to see its details.",
		Role = "Body",
		Color = C.TextMuted,
		Wrapped = true,
		XAlign = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(0.8, 0.2),
		Visible = false,
		Parent = details,
	})
end

-- ============================================================== layout
function InventoryWindow:ApplyLayout()
	if not self.ListPane then
		return
	end
	local R = Responsive
	local phone = R.Device == "Phone"
	local portrait = phone and R.Portrait
	self.Compact = phone
	-- panes
	if phone then
		self.ListPane.Position = UDim2.fromScale(0, 0)
		self.ListPane.Size = UDim2.fromScale(1, 1)
		self.Details.Position = UDim2.fromScale(0, 0)
		self.Details.Size = UDim2.fromScale(1, 1)
		self.Details.ZIndex = 5
		self.Details.Visible = self.ShowingDetails
		self.ListPane.Visible = not self.ShowingDetails
	else
		self.ListPane.Position = UDim2.fromScale(0, 0)
		self.ListPane.Size = UDim2.fromScale(0.615, 1)
		self.Details.Position = UDim2.fromScale(0.635, 0)
		self.Details.Size = UDim2.fromScale(0.365, 1)
		self.Details.Visible = true
		self.ListPane.Visible = true
	end
	-- toolbar
	local tbH = portrait and 0.12 or (phone and 0.15 or 0.075)
	self.Toolbar.Size = UDim2.fromScale(1, tbH)
	local search, filter, sort = self.Search.Instance, self.Filter.Instance, self.Sort.Instance
	if portrait then
		search.Position = UDim2.fromScale(0, 0)
		search.Size = UDim2.fromScale(1, 0.46)
		filter.Position = UDim2.fromScale(0, 0.54)
		filter.Size = UDim2.fromScale(0.43, 0.46)
		sort.Position = UDim2.fromScale(0.45, 0.54)
		sort.Size = UDim2.fromScale(0.55, 0.46)
	else
		search.Position = UDim2.fromScale(0, 0)
		search.Size = UDim2.fromScale(0.4, 1)
		filter.Position = UDim2.fromScale(0.42, 0)
		filter.Size = UDim2.fromScale(0.26, 1)
		sort.Position = UDim2.fromScale(0.7, 0)
		sort.Size = UDim2.fromScale(0.3, 1)
	end
	-- footer + grid
	local footH = portrait and 0.075 or (phone and 0.18 or 0.085)
	self.CapacityText.Visible = not phone and self.PlaceSlot == nil
	self.PerchText.Position = phone and UDim2.fromScale(0, 0) or UDim2.fromScale(0.3, 0)
	self.PerchText.Size = phone and UDim2.fromScale(0.6, 1) or UDim2.fromScale(0.34, 1)
	local fpad = self.Footer:FindFirstChild("Pad")
	local padding = fpad and fpad:FindFirstChildOfClass("UIPadding")
	if padding then
		local v = (phone and not portrait) and 0.08 or 0.14
		padding.PaddingTop = UDim.new(v, 0)
		padding.PaddingBottom = UDim.new(v, 0)
	end
	self.Footer.AnchorPoint = Vector2.new(0, 1)
	self.Footer.Position = UDim2.fromScale(0, 1)
	self.Footer.Size = UDim2.fromScale(1, footH)
	local gap = portrait and 0.015 or 0.02
	self.Grid.Position = UDim2.fromScale(0, tbH + gap)
	self.Grid.Size = UDim2.fromScale(1, 1 - tbH - footH - gap * 2)
	-- grid metrics
	if portrait then
		self.Cols, self.CardAspect = 3, 0.78
	elseif phone then
		self.Cols, self.CardAspect = 5, 0.95
	elseif R.Device == "Tablet" then
		self.Cols, self.CardAspect = 4, 0.8
	else
		self.Cols, self.CardAspect = 4, 0.8
	end
	-- details inner layout
	local function info(nameH, speciesH, levelY, levelH, statsY, statsH, actionsY, actionsH)
		self.DName.Size = UDim2.fromScale(1, nameH)
		self.DSpecies.Visible = speciesH > 0
		self.DSpecies.Position = UDim2.fromScale(0, nameH)
		self.DSpecies.Size = UDim2.fromScale(1, math.max(speciesH, 0.01))
		self.LevelRow.Position = UDim2.fromScale(0, levelY)
		self.LevelRow.Size = UDim2.fromScale(1, levelH)
		self.StatsBox.Position = UDim2.fromScale(0, statsY)
		self.StatsBox.Size = UDim2.fromScale(1, statsH)
		self.Actions.Position = UDim2.fromScale(0, actionsY)
		self.Actions.Size = UDim2.fromScale(1, actionsH)
	end
	if phone and not portrait then
		info(0.1, 0, 0.11, 0.07, 0.2, 0.24, 0.46, 0.54)
	else
		info(0.1, 0.065, 0.18, 0.075, 0.28, 0.27, 0.58, 0.42)
	end
	if phone and not portrait then
		self.PreviewBox.Position = UDim2.fromScale(0.02, 0.04)
		self.PreviewBox.Size = UDim2.fromScale(0.4, 0.92)
		self.InfoBox.Position = UDim2.fromScale(0.45, 0.04)
		self.InfoBox.Size = UDim2.fromScale(0.53, 0.92)
	elseif portrait then
		self.PreviewBox.Position = UDim2.fromScale(0.03, 0.02)
		self.PreviewBox.Size = UDim2.fromScale(0.94, 0.36)
		self.InfoBox.Position = UDim2.fromScale(0.05, 0.4)
		self.InfoBox.Size = UDim2.fromScale(0.9, 0.58)
	else
		self.PreviewBox.Position = UDim2.fromScale(0.03, 0.02)
		self.PreviewBox.Size = UDim2.fromScale(0.94, 0.4)
		self.InfoBox.Position = UDim2.fromScale(0.06, 0.44)
		self.InfoBox.Size = UDim2.fromScale(0.88, 0.54)
	end
	self:Relayout()
end

-- Recomputes card size / canvas height and rebinds visible cards.
function InventoryWindow:Relayout()
	local grid = self.Grid
	if not grid or not self.Cols then
		return
	end
	local width = grid.AbsoluteSize.X - grid.ScrollBarThickness - 2
	if width <= 0 then
		return
	end
	local gap = Responsive.px(CARD_GAP)
	local cols = self.Cols
	local cw = (width - gap * (cols - 1)) / cols
	local ch = math.floor(cw / self.CardAspect + 0.5)
	self.CellW, self.CellH, self.Gap = cw, ch, gap
	local rows = math.ceil(#self.List / cols)
	local total = math.max(0, rows * (ch + gap) - gap) + gap
	grid.CanvasSize = UDim2.fromOffset(0, total)
	self.Canvas.Size = UDim2.new(1, -(grid.ScrollBarThickness + 2), 0, total)
	-- force full rebind (positions changed)
	for i, card in self.Cards do
		self.Cards[i] = nil
		card:Unbind()
		table.insert(self.Pool, card)
	end
	self:UpdateVisible()
end

function InventoryWindow:UpdateVisible()
	if not self.CellH then
		return
	end
	local grid = self.Grid
	local stride = self.CellH + self.Gap
	local maxScroll = math.max(0, grid.CanvasSize.Y.Offset - grid.AbsoluteSize.Y)
	local y0 = math.clamp(grid.CanvasPosition.Y, 0, maxScroll)
	local y1 = y0 + grid.AbsoluteSize.Y
	local cols = self.Cols
	local firstRow = math.max(0, math.floor(y0 / stride) - 1)
	local lastRow = math.floor(y1 / stride) + 1
	local first = firstRow * cols + 1
	local last = math.min(#self.List, (lastRow + 1) * cols)
	-- recycle cards leaving the window
	for i, card in self.Cards do
		if i < first or i > last or self.List[i] ~= card.Uid then
			self.Cards[i] = nil
			card:Unbind()
			table.insert(self.Pool, card)
		end
	end
	local data = self.Data.all()
	if not data then
		return
	end
	for i = first, last do
		local uid = self.List[i]
		local record = uid and data.Dragons[uid]
		if record then
			local card = self.Cards[i]
			if not card then
				card = table.remove(self.Pool) or Card.new(self)
				self.Cards[i] = card
			end
			local idx = i - 1
			local row, col = idx // cols, idx % cols
			local root = card.Root
			root.Size = UDim2.new(1 / cols, -self.Gap * (cols - 1) / cols, 0, self.CellH)
			root.Position = UDim2.new(col / cols, col * self.Gap / cols, 0, row * stride)
			root.LayoutOrder = i
			root.Visible = true
			root.Parent = self.Canvas
			card:Bind(record, { Equipped = data.EquippedDragon == uid })
		end
	end
end

-- ============================================================== data
function InventoryWindow:Rebuild(resetScroll: boolean?)
	local data = self.Data.all()
	if not data then
		return
	end
	local dragons = data.Dragons
	if self.PlaceSlot then
		-- place mode: only dragons that can go to a perch
		local free = {}
		for uid, rec in dragons do
			if rec.PlacedNestId == "" then
				free[uid] = rec
			end
		end
		dragons = free
	end
	self.List = InventoryQuery.run(dragons, self.Query)
	if resetScroll then
		self.Grid.CanvasPosition = Vector2.zero
	end
	-- keep a valid selection
	if self.SelectedId and not data.Dragons[self.SelectedId] then
		self.SelectedId = nil
	end
	if not self.SelectedId and not self.Compact and #self.List > 0 then
		self.SelectedId = self.List[1]
	end
	local cap = EconomyConfig.upgradeValue("DragonStorage", data.Upgrades and data.Upgrades.DragonStorage or 0)
	local count = 0
	for _ in data.Dragons do
		count += 1
	end
	self.CapacityText.Text = string.format("DRAGONS  %d / %d", count, cap)
	self.CapacityText.TextColor3 = count >= cap and C.Warning or C.Text
	local unlocked = data.Nests and data.Nests.Unlocked or 0
	local used = 0
	for _ in (data.Nests and data.Nests.Slots or {}) do
		used += 1
	end
	self.PerchText.Text = string.format("PERCHES  %d / %d", used, unlocked)
	self.AutoPlace:SetEnabled(used < unlocked and count > 1)
	self:SetSubtitle(string.format("%d / %d", count, cap))
	if #self.List == 0 then
		self.Empty.Visible = true
		if count == 0 then
			self.Empty.Text = "No dragons yet. Hatch eggs in your sanctuary nest!"
		elseif self.PlaceSlot then
			self.Empty.Text = "Every dragon is already resting on a perch."
		else
			self.Empty.Text = "No dragons match your search."
		end
	else
		self.Empty.Visible = false
	end
	self:Relayout()
	self:RefreshDetails()
end

-- ============================================================== selection / details
function InventoryWindow:Select(uid: string?, fromUser: boolean?)
	self.SelectedId = uid
	for _, card in self.Cards do
		card:PaintSelection()
	end
	self:RefreshDetails()
	if self.Compact and uid and fromUser then
		self:ShowDetails(true)
	end
end

function InventoryWindow:ShowDetails(show: boolean)
	self.ShowingDetails = show
	if self.Compact then
		self.Details.Visible = show
		self.ListPane.Visible = not show
	end
end

function InventoryWindow:SetPreview(record)
	local key = record and (record.SpeciesId .. "|" .. record.Mutation) or nil
	if key == self.PreviewKey then
		return
	end
	self.PreviewKey = key
	if self.PreviewModel then
		self.PreviewModel:Destroy()
		self.PreviewModel = nil
	end
	if not record then
		return
	end
	self.PreviewToken = (self.PreviewToken or 0) + 1
	local token = self.PreviewToken
	enqueue(function()
		if self.PreviewToken ~= token then
			return
		end
		local model = buildPreview(record.SpeciesId, record.Mutation, math.rad(180 - 30))
		if not model then
			return
		end
		if self.PreviewToken ~= token then
			model:Destroy()
			return
		end
		model.Parent = self.Preview
		self.PreviewModel = model
		self.PreviewFocus, self.PreviewDist, self.PreviewSize = frameCamera(self.PreviewCam, model, 0.66, self.Orbit)
	end)
end

local function setCost(button, base: string, cost: number?, affordable: boolean)
	if cost then
		button:SetText(base .. "  " .. Format.cash(cost))
	else
		button:SetText(base)
	end
	local _ = affordable
end

function InventoryWindow:RefreshDetails()
	local data = self.Data.all()
	local record = data and self.SelectedId and data.Dragons[self.SelectedId] or nil
	local hasRecord = record ~= nil
	self.PreviewBox.Visible = hasRecord
	self.InfoBox.Visible = hasRecord
	self.NoSelection.Visible = not hasRecord
	if not record then
		self:SetPreview(nil)
		return
	end
	local rarity = DragonConfig.Rarities[record.Rarity] or DragonConfig.Rarities.Common
	local species = DragonConfig.Species[record.SpeciesId]
	local mutation = MutationConfig.Mutations[record.Mutation] or MutationConfig.Mutations.None
	local equipped = data.EquippedDragon == record.UniqueId
	local placed = record.PlacedNestId ~= ""
	local riding = Players.LocalPlayer:GetAttribute("Riding") == true and equipped

	self:SetPreview(record)
	self.PreviewGlow.BackgroundColor3 = rarity.Color
	self.RarityTag.BackgroundColor3 = rarity.Color
	self.RarityTagLabel.Text = string.upper(record.Rarity)
	local odds = Odds.ofRecord(record)
	local exclusive = Odds.isExclusive(record.SpeciesId)
	self.OddsTitle.Text = Odds.format(odds, exclusive)
	self.OddsTitle.TextColor3 = exclusive and rarity.Glow or Odds.color(odds)
	if record.Mutation ~= "None" then
		self.MutationTag.Visible = true
		self.MutationTag.BackgroundColor3 = mutation.Color
		self.MutationTagLabel.Text = string.upper(mutation.Name) .. "  x" .. tostring(mutation.Multiplier)
	else
		self.MutationTag.Visible = false
	end
	local stateText = nil
	if riding then
		stateText = "RIDING"
	elseif equipped then
		stateText = "EQUIPPED"
	elseif placed then
		stateText = "ON PERCH " .. record.PlacedNestId
	end
	self.StateTag.Visible = stateText ~= nil
	self.StateTagLabel.Text = stateText or ""

	self.DName.Text = record.Name
	self.DName.TextColor3 = C.Text
	self.DSpecies.Text = species and species.Description or ""
	self.DLevel.Text = "LV " .. record.Level
	local maxed = record.Level >= DragonConfig.MaxLevel
	if maxed then
		self.DXPBar:SetValue(1)
		self.DXPText.Text = "MAX LEVEL"
	else
		local need = DragonConfig.xpToNext(record.Level)
		self.DXPBar:SetValue(record.XP / need, true)
		self.DXPText.Text = Format.abbreviate(record.XP) .. " / " .. Format.abbreviate(need) .. " XP"
	end
	self.DSpeed.Text = Format.abbreviate(record.Speed)
	self.DFlight.Text = Format.abbreviate(record.FlightSpeed)
	self.DIncome.Text = Format.perSecond(record.IncomePerSecond)

	local cash = data.Cash or 0
	-- ride / equip
	self.RideBtn:SetText(riding and "RIDING" or "RIDE")
	self.RideBtn:SetEnabled(not riding)
	self.EquipBtn:SetText(equipped and "EQUIPPED" or "EQUIP")
	self.EquipBtn:SetEnabled(not equipped)
	-- feed
	local feedCost = not maxed and EconomyConfig.feedCost(species.FeedCost, record.Level) or nil
	setCost(self.FeedBtn, maxed and "MAX LEVEL" or "FEED", feedCost, feedCost ~= nil and cash >= feedCost)
	self.FeedBtn:SetEnabled(feedCost ~= nil and cash >= feedCost)
	-- mutate
	local maxMut = MutationConfig.rank(record.Mutation) >= MutationConfig.MaxRank
	local mutCost = not maxMut and MutationConfig.cost(species.Income, record.Mutation) or nil
	setCost(self.MutateBtn, maxMut and "MAX MUTATION" or "MUTATE", mutCost, mutCost ~= nil and cash >= mutCost)
	self.MutateBtn:SetEnabled(mutCost ~= nil and cash >= mutCost)
	-- place / take back
	if placed then
		self.PlaceBtn:SetText("TAKE BACK")
		self.PlaceBtn:SetStyle("Secondary")
	elseif self.PlaceSlot then
		self.PlaceBtn:SetText("PLACE HERE")
		self.PlaceBtn:SetStyle("Gold")
	else
		self.PlaceBtn:SetText("PLACE")
		self.PlaceBtn:SetStyle("Blue")
	end
	self.PlaceBtn:SetEnabled(not riding)
	-- lock / release
	self.LockBtn:SetStyle(record.Locked and "Gold" or "Secondary")
	if self.LockIcon and self.UnlockIcon then
		self.LockIcon.Visible = record.Locked == true
		self.UnlockIcon.Visible = record.Locked ~= true
	end
	self.ReleaseBtn:SetEnabled(not record.Locked and not riding)
end

-- ============================================================== actions
-- Sends a Dragon request with busy handling; onOk(res) runs on success.
function InventoryWindow:Request(action: string, payload, onOk: ((any) -> ())?, domain: string?)
	if self.Busy then
		return
	end
	self.Busy = true
	task.spawn(function()
		local res = Net.request(domain or "Dragon", action, payload)
		self.Busy = false
		if self.UIC.HandleResult(res) and onOk then
			onOk(res)
		end
		self:RefreshDetails()
	end)
end

function InventoryWindow:Selected()
	local data = self.Data.all()
	return data and self.SelectedId and data.Dragons[self.SelectedId] or nil, data
end

function InventoryWindow:DoEquip()
	local record = self:Selected()
	if not record then
		return
	end
	local uid = record.UniqueId
	if record.PlacedNestId ~= "" then
		self:Request("TakeBack", { Id = uid }, function()
			self:Request("Equip", { Id = uid }, function()
				self.UIC.Notify("success", record.Name .. " equipped")
			end)
		end)
		return
	end
	self:Request("Equip", { Id = uid }, function()
		self.UIC.Notify("success", record.Name .. " equipped")
	end)
end

function InventoryWindow:DoRide()
	local record, data = self:Selected()
	if not record then
		return
	end
	local uid = record.UniqueId
	local function ride()
		self:Request("Ride", {}, function()
			self.UIC.Close()
		end, "Mount")
	end
	local function equipThenRide()
		if data.EquippedDragon == uid then
			ride()
		else
			self:Request("Equip", { Id = uid }, ride)
		end
	end
	if record.PlacedNestId ~= "" then
		self:Request("TakeBack", { Id = uid }, equipThenRide)
	else
		equipThenRide()
	end
end

function InventoryWindow:DoFeed()
	local record = self:Selected()
	if not record then
		return
	end
	self:Request("Feed", { Id = record.UniqueId }, function(res)
		local audio = self.Registry.AudioController
		if audio then
			audio.playUI("Click")
		end
		if res.data and res.data.Levels and res.data.Levels > 0 then
			self.UIC.Notify("rare", string.format("%s reached level %d!", record.Name, res.data.Level))
			self.DLevelBadge.Size = UDim2.fromScale(0.24, 1.2)
			Kit.tween(self.DLevelBadge, 0.35, { Size = UDim2.fromScale(0.2, 1) }, Enum.EasingStyle.Back)
		end
	end)
end

function InventoryWindow:DoMutate()
	local record, data = self:Selected()
	if not record then
		return
	end
	local species = DragonConfig.Species[record.SpeciesId]
	local cost = MutationConfig.cost(species.Income, record.Mutation)
	local chance = MutationConfig.improveChance(record.Mutation)
	local uid = record.UniqueId
	task.spawn(function()
		if cost >= EconomyConfig.ConfirmMinimum and cost >= (data.Cash or 0) * EconomyConfig.ConfirmFraction then
			local yes = self.UIC.Confirm({
				Title = "Mutate " .. record.Name .. "?",
				Body = string.format("Costs %s. %s chance of a better mutation - it can never get worse.", Format.cash(cost), Format.percent(chance)),
				ConfirmText = "Mutate",
			})
			if not yes then
				return
			end
		end
		self:Request("Mutate", { Id = uid }, function(res)
			local d = res.data or {}
			if d.Improved then
				local m = MutationConfig.Mutations[d.Mutation]
				self.UIC.Notify("rare", string.format("%s mutation! %s is now x%s", m and m.Name or d.Mutation, record.Name, tostring(m and m.Multiplier or 1)))
			else
				self.UIC.Notify("info", "No new mutation this time - try again!")
			end
		end)
	end)
end

function InventoryWindow:DoPlace()
	local record = self:Selected()
	if not record then
		return
	end
	if record.PlacedNestId ~= "" then
		self:Request("TakeBack", { Id = record.UniqueId }, function()
			self.UIC.Notify("success", record.Name .. " is back in your collection")
		end)
		return
	end
	local payload = { Id = record.UniqueId, Slot = self.PlaceSlot }
	self:Request("Place", payload, function(res)
		local slot = res.data and res.data.Slot
		self.UIC.Notify("success", string.format("%s is resting on perch %s", record.Name, tostring(slot or "")))
		if self.PlaceSlot then
			self:SetPlaceSlot(nil)
			self.UIC.Close()
		end
	end)
end

function InventoryWindow:DoLock()
	local record = self:Selected()
	if not record then
		return
	end
	self:Request("Lock", { Id = record.UniqueId, Locked = not record.Locked })
end

function InventoryWindow:DoRelease()
	local record = self:Selected()
	if not record then
		return
	end
	local refund = math.floor(record.IncomePerSecond * TreeConfig.refundSeconds(self.Data and self.Data.all()) + 0.5)
	local uid = record.UniqueId
	task.spawn(function()
		local yes = self.UIC.Confirm({
			Title = "Release " .. record.Name .. "?",
			Body = string.format("It flies back to the wild for good. You receive %s.", Format.cash(refund)),
			ConfirmText = "Release",
			Danger = true,
		})
		if yes then
			self:Request("Release", { Id = uid }, function(res)
				self.UIC.Notify("info", string.format("%s flew away  (+%s)", record.Name, Format.cash(res.data and res.data.Refund or 0)))
			end)
		end
	end)
end

function InventoryWindow:SetPlaceSlot(slot: number?)
	self.PlaceSlot = slot
	self.PlaceBanner.Visible = slot ~= nil
	self.CapacityText.Visible = slot == nil and not self.Compact
	self.PerchText.Visible = slot == nil
	self.AutoPlace:SetVisible(slot == nil)
	if slot then
		self.PlaceText.Text = string.format("CHOOSE A DRAGON FOR PERCH %d", slot)
	end
	self:Rebuild(true)
end

-- ============================================================== lifecycle
function InventoryWindow:ApplyArgs(args)
	args = args or {}
	self:SetPlaceSlot(args.PlaceSlot)
	if args.SelectId then
		self.SelectedId = args.SelectId
	elseif args.SelectFirst then
		self.SelectedId = self.List[1]
	end
	self:Rebuild(false)
	if args.SelectId then
		-- scroll the selected card into view
		local idx = table.find(self.List, args.SelectId)
		if idx and self.CellH then
			local row = (idx - 1) // self.Cols
			self.Grid.CanvasPosition = Vector2.new(0, math.max(0, row * (self.CellH + self.Gap) - self.Gap))
		end
	end
	self:Select(self.SelectedId, false)
	self:ShowDetails(self.Compact and args.ShowDetails == true and self.SelectedId ~= nil)
	if not self.Compact then
		self:ShowDetails(false)
	end
end

function InventoryWindow:OnOpen(args)
	self:ApplyLayout()
	self:ApplyArgs(args)
	task.defer(function()
		if self.Root.Visible then
			self:Relayout()
		end
	end)
	if not self._observing then
		self._observing = true
		local D = self.Data
		local pending = false
		local function changed()
			if pending or not self.Root.Visible then
				return
			end
			pending = true
			task.defer(function()
				pending = false
				if self.Root.Visible then
					self:Rebuild(false)
				end
			end)
		end
		for _, k in { "Dragons", "EquippedDragon", "Nests", "Cash", "Upgrades" } do
			D.changed(k):Connect(changed)
		end
		Players.LocalPlayer:GetAttributeChangedSignal("Riding"):Connect(function()
			if self.Root.Visible then
				self:RefreshDetails()
			end
		end)
		-- turntable
		RunService.RenderStepped:Connect(function(dt)
			if not self.Root.Visible or not self.PreviewModel or not self.PreviewFocus then
				return
			end
			if not self.Details.Visible then
				return
			end
			self.Orbit += self.OrbitVel * dt
			local cam = self.PreviewCam
			local d = self.PreviewDist
			local size = self.PreviewSize
			local a = self.Orbit
			cam.CFrame = CFrame.lookAt(self.PreviewFocus + Vector3.new(math.sin(a) * d, size.Y * 0.18 + d * 0.12, math.cos(a) * d), self.PreviewFocus + Vector3.new(0, -size.Y * 0.04, 0))
		end)
	end
end

function InventoryWindow:OnReopen(args)
	self:ApplyArgs(args)
end

function InventoryWindow:OnHidden()
	for _, d in { self.Filter, self.Sort } do
		d.Close()
	end
end

return InventoryWindow
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX000139">
						<Properties>
							<string name="Name">SettingsWindow</string>
							<ProtectedString name="Source"><![CDATA[--[[
	SettingsWindow
	Graphics preset, audio volumes, camera options, UI size, controls help.
	Changes apply instantly on the client and are saved on the server
	(validated + rate-limited) via Settings.Set.
]]

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Kit = require(UI.Kit)
local WindowBase = require(UI.WindowBase)

local C = Theme.Colors

local SettingsWindow = {}
SettingsWindow.__index = SettingsWindow
setmetatable(SettingsWindow, { __index = WindowBase })

local CONTROLS = {
	{ "Move", "W A S D" },
	{ "Jump / Take off / Fly up", "SPACE (hold to take off)" },
	{ "Fly down / Land", "CTRL or C" },
	{ "Sprint / Boost", "SHIFT" },
	{ "Ride / Dismount", "R" },
	{ "Roar", "F" },
	{ "Interact", "E (hold)" },
	{ "Rotate camera", "Right mouse / V to lock" },
	{ "Dragons / Index / Quests", "G / X / Q" },
	{ "Shop / Daily / Settings", "B / J / P" },
}

function SettingsWindow.new(ui, registry)
	local self = WindowBase.new({
		Name = "Settings",
		Title = "Settings",
		Icon = "Gear",
		Spec = {
			Desktop = { Width = 0.42, Height = 0.74, Aspect = 1.08 },
			Tablet = { Width = 0.7, Height = 0.84, Aspect = 1.1 },
			Phone = { Width = 0.8, Height = 1 },
			PhonePortrait = { Width = 0.96, Height = 1 },
		},
	})
	setmetatable(self, SettingsWindow)
	self.UIC = ui
	self.Registry = registry
	self.Controls = {}
	self:Build()
	return self
end

function SettingsWindow:Row(parent: Instance, order: number, label: string, sub: string?)
	local row = Kit.frame({ Name = "Row_" .. label, LayoutOrder = order, Parent = parent })
	Responsive.bind(row, "Size", function(R)
		return UDim2.new(1, 0, 0, R.px(R.Device == "Phone" and 64 or 54))
	end)
	Kit.text({
		Name = "Label",
		Text = label,
		Role = "Body",
		Font = Theme.Fonts.Label,
		Position = UDim2.fromScale(0, sub and 0.08 or 0),
		Size = UDim2.fromScale(0.5, sub and 0.5 or 1),
		Parent = row,
	})
	if sub then
		Kit.text({
			Name = "Sub",
			Text = sub,
			Role = "Caption",
			Color = C.TextDim,
			Position = UDim2.fromScale(0, 0.55),
			Size = UDim2.fromScale(0.5, 0.38),
			Truncate = true,
			Parent = row,
		})
	end
	local slot = Kit.frame({ Name = "Control", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromScale(0.46, 0.62), Parent = row })
	Kit.divider(row, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Transparency = 0.82 })
	return slot
end

function SettingsWindow:Section(parent: Instance, order: number, title: string)
	local f = Kit.frame({ Name = "Section_" .. title, LayoutOrder = order, Parent = parent })
	Responsive.bind(f, "Size", function(R)
		return UDim2.new(1, 0, 0, R.px(40))
	end)
	Kit.text({
		Text = title,
		Role = "Label",
		Font = Theme.Fonts.Title,
		Color = C.Gold,
		YAlign = Enum.TextYAlignment.Bottom,
		Size = UDim2.fromScale(1, 0.8),
		Parent = f,
	})
end

function SettingsWindow:Build()
	local scroll = Kit.scroll({ Name = "List", Parent = self.Content })
	Kit.padding(scroll, 0, 14, 10, 2)
	Kit.list(scroll, "V", 2)
	self.List = scroll
	local order = 0
	local function nextOrder()
		order += 1
		return order
	end

	local function toggleRow(key: string, label: string, sub: string?)
		local slot = self:Row(scroll, nextOrder(), label, sub)
		local t = Kit.toggle({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(1, 0.5), Size = UDim2.fromScale(1, 0.9), Parent = slot })
		t.Changed:Connect(function(v)
			self:Set(key, v)
		end)
		self.Controls[key] = t
	end

	self:Section(scroll, nextOrder(), "GRAPHICS")
	local quality = Kit.segmented({ Options = { "Max", "High", "Medium" }, Value = "Max", Parent = self:Row(scroll, nextOrder(), "Quality", "MAX looks best on gaming PCs") })
	quality.Changed:Connect(function(v)
		self:Set("Graphics", v)
	end)
	self.Controls.Graphics = quality
	toggleRow("MenuBlur", "Menu blur", "Soft blur behind menus (off keeps the world sharp)")

	self:Section(scroll, nextOrder(), "AUDIO")
	local music = Kit.slider({ Value = 0.6, Min = 0, Max = 1, Step = 0.05, Parent = self:Row(scroll, nextOrder(), "Music") })
	music.Changed:Connect(function(v)
		self:Set("Music", v)
	end)
	self.Controls.Music = music
	local sfx = Kit.slider({ Value = 0.8, Min = 0, Max = 1, Step = 0.05, Parent = self:Row(scroll, nextOrder(), "Effects") })
	sfx.Changed:Connect(function(v)
		self:Set("SFX", v)
	end)
	self.Controls.SFX = sfx

	self:Section(scroll, nextOrder(), "CAMERA")
	local sens = Kit.slider({ Value = 1, Min = 0.4, Max = 2, Step = 0.05, Parent = self:Row(scroll, nextOrder(), "Sensitivity") })
	sens.Changed:Connect(function(v)
		self:Set("Sensitivity", v)
	end)
	self.Controls.Sensitivity = sens
	toggleRow("CameraShake", "Camera shake", "Landings and boosts")
	toggleRow("SpeedFOV", "Speed effects", "Field of view widens when boosting")
	toggleRow("MouseLock", "Mouse steering", "Lock the cursor while riding (V)")
	toggleRow("InvertY", "Invert camera Y")

	self:Section(scroll, nextOrder(), "INTERFACE")
	local uiSize = Kit.segmented({ Options = { "0.9", "1", "1.1" }, Labels = { "SMALL", "NORMAL", "LARGE" }, Value = "1", Parent = self:Row(scroll, nextOrder(), "Interface size") })
	uiSize.Changed:Connect(function(v)
		self:Set("UIScale", tonumber(v))
	end)
	self.Controls.UIScale = uiSize

	self:Section(scroll, nextOrder(), "CONTROLS")
	for _, pair in CONTROLS do
		local row = Kit.frame({ Name = "Key_" .. pair[1], LayoutOrder = nextOrder(), Parent = scroll })
		Responsive.bind(row, "Size", function(R)
			return UDim2.new(1, 0, 0, R.px(34))
		end)
		Kit.text({ Text = pair[1], Role = "Label", Color = C.TextMuted, Size = UDim2.fromScale(0.55, 1), Parent = row })
		Kit.text({ Text = pair[2], Role = "Label", Font = Theme.Fonts.Label, XAlign = Enum.TextXAlignment.Right, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromScale(0.45, 1), Parent = row })
	end

	self.SaveNote = Kit.text({
		Name = "SaveNote",
		Text = "",
		Role = "Caption",
		Color = C.Warning,
		Wrapped = true,
		LayoutOrder = nextOrder(),
		Size = UDim2.new(1, 0, 0, 0),
		AutoSize = Enum.AutomaticSize.Y,
		Parent = scroll,
	})
end

function SettingsWindow:Set(key: string, value: any)
	local settings = self.Registry.SettingsController
	if settings then
		settings.set(key, value)
	end
end

function SettingsWindow:OnOpen()
	local data = self.Registry.DataController.all()
	if not data then
		return
	end
	local s = data.Settings
	self.Controls.Graphics:Set(s.Graphics)
	self.Controls.MenuBlur:Set(s.MenuBlur == true)
	self.Controls.Music:Set(s.Music)
	self.Controls.SFX:Set(s.SFX)
	self.Controls.Sensitivity:Set(s.Sensitivity)
	self.Controls.CameraShake:Set(s.CameraShake)
	self.Controls.SpeedFOV:Set(s.SpeedFOV)
	self.Controls.MouseLock:Set(s.MouseLock)
	self.Controls.InvertY:Set(s.InvertY)
	local uiValue = s.UIScale >= 1.05 and "1.1" or (s.UIScale <= 0.95 and "0.9" or "1")
	self.Controls.UIScale:Set(uiValue)
	self.SaveNote.Text = self.Registry.DataController.Temporary
		and "Studio: DataStore access is off, so changes will not be saved. Enable 'Studio Access to API Services' to test saving."
		or ""
end

return SettingsWindow
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX000140">
						<Properties>
							<string name="Name">ShopWindow</string>
							<ProtectedString name="Source"><![CDATA[--[[
	ShopWindow
	ROBUX tab: the Owner Dragon game pass (featured, 3D preview) + potions and
	cash packs (developer products). UPGRADES tab: cash upgrades (Forge).

	Buying: real items prompt MarketplaceService; items whose Id is still 0
	are free TEST purchases in Studio (server grants them), "coming soon"
	in a live game.
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local MonetizationConfig = require(Configs:WaitForChild("MonetizationConfig"))
local EconomyConfig = require(Configs:WaitForChild("EconomyConfig"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local DragonVisual = require(Shared:WaitForChild("Dragons"):WaitForChild("DragonVisual"))
local Animator = require(Shared:WaitForChild("Dragons"):WaitForChild("Animator"))

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Create = require(UI.Create)
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local WindowBase = require(UI.WindowBase)

local C = Theme.Colors
local LocalPlayer = Players.LocalPlayer

local ShopWindow = {}
ShopWindow.__index = ShopWindow
setmetatable(ShopWindow, { __index = WindowBase })

local function robux(n: number): string
	return "R$ " .. Format.commas(n)
end

local function iconDisc(parent: Instance, icon: string, color: Color3, props)
	local disc = Kit.frame({
		Name = "IconDisc",
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		Parent = parent,
	})
	for k, v in props do
		(disc :: any)[k] = v
	end
	Kit.corner(disc, 999)
	Create("UIGradient", { Rotation = 90, Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.25), color:Lerp(Color3.new(0, 0, 0), 0.2)), Parent = disc })
	local box = Kit.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.6, 0.6), Parent = disc })
	Icons.make(icon, { Color = C.Ink, Accent = C.Text, Ink = color }).Parent = box
	return disc
end

function ShopWindow.new(ui, registry)
	local self = WindowBase.new({
		Name = "Shop",
		Title = "Shop",
		Subtitle = "Potions, packs and upgrades",
		Icon = "Bag",
	})
	setmetatable(self, ShopWindow)
	self.UIC = ui
	self.Registry = registry
	self.Data = registry.DataController
	self.Pages = {}
	self.UpgradeRows = {}
	self.Busy = false
	self:Build()
	return self
end

-- ============================================================== layout
function ShopWindow:Build()
	local tabs = Kit.segmented({
		Name = "Tabs",
		Options = { "Robux", "Upgrades" },
		Labels = { "ROBUX", "UPGRADES" },
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0),
		Size = UDim2.fromScale(0.44, 0.085),
		Parent = self.Content,
	})
	self.Tabs = tabs
	tabs.Changed:Connect(function(v)
		self:ShowTab(v)
	end)
	for _, name in { "Robux", "Upgrades" } do
		self.Pages[name] = Kit.frame({ Name = name .. "Page", Position = UDim2.fromScale(0, 0.11), Size = UDim2.fromScale(1, 0.89), Parent = self.Content })
	end
	self:BuildRobux(self.Pages.Robux)
	self:BuildUpgrades(self.Pages.Upgrades)
	self:ShowTab("Robux")
end

function ShopWindow:ShowTab(name: string)
	self.Tab = name
	self.Tabs:Set(name)
	for k, page in self.Pages do
		page.Visible = k == name
	end
	if name == "Upgrades" then
		self:RefreshUpgrades()
	end
end

-- ============================================================== robux tab
function ShopWindow:BuildRobux(page: Instance)
	local scroll = Kit.scroll({ Name = "Scroll", Size = UDim2.fromScale(1, 1), Parent = page })
	Kit.padding(scroll, 2, 10, 6, 2)
	Kit.list(scroll, "V", 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)

	-- featured: exclusive dragons (game passes)
	self.PassButtons = {}
	self.PassViews = {}
	for order, itemId in MonetizationConfig.passOrder() do
		self:BuildPassCard(scroll, itemId, order)
	end

	-- potions & packs
	local header = Kit.text({ Name = "PotionsHeader", Text = "POTIONS & PACKS", Role = "Heading", Color = C.Gold, LayoutOrder = 20, Parent = scroll })
	Responsive.bind(header, "Size", function(R)
		return UDim2.new(1, 0, 0, R.px(26))
	end)
	local gridHost = Kit.frame({ Name = "Products", LayoutOrder = 21, AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromScale(1, 0), Parent = scroll })
	local grid = Instance.new("UIGridLayout")
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Left
	grid.Parent = gridHost
	Responsive.bind(grid, "CellSize", function(R)
		local cols = R.Device == "Phone" and (R.Portrait and 2 or 3) or 4
		return UDim2.new(1 / cols, -R.px(10), 0, R.px(R.Device == "Phone" and 200 or 196))
	end)
	Responsive.bind(grid, "CellPadding", function(R)
		return UDim2.fromOffset(R.px(10), R.px(10))
	end)
	for i, itemId in MonetizationConfig.ProductOrder do
		local def = MonetizationConfig.Products[itemId]
		local cell = Kit.surface({ Name = itemId, LayoutOrder = i, StrokeColor = def.Color, StrokeTransparency = 0.5, Parent = gridHost })
		iconDisc(cell, def.Icon, def.Color, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.06), Size = UDim2.fromScale(0.3, 0.3) })
		Kit.text({ Name = "Name", Text = string.upper(def.Name), Role = "Heading", Scaled = true, XAlign = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0.05, 0.38), Size = UDim2.fromScale(0.9, 0.12), Parent = cell })
		Kit.text({
			Name = "Desc",
			Text = def.Description,
			Role = "Caption",
			Color = C.TextMuted,
			Wrapped = true,
			Scaled = true,
			XAlign = Enum.TextXAlignment.Center,
			Position = UDim2.fromScale(0.06, 0.51),
			Size = UDim2.fromScale(0.88, 0.22),
			Parent = cell,
		})
		local b = Kit.button({
			Name = "Buy",
			Text = robux(def.Price),
			Style = "Success",
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.fromScale(0.5, 0.95),
			Size = UDim2.fromScale(0.8, 0.17),
			Parent = cell,
		})
		b.Activated:Connect(function()
			self:Buy(itemId)
		end)
	end
	local note = Kit.text({
		Name = "Note",
		Text = "Potions stack time when bought again. Level and Mutation potions apply to your equipped dragon.",
		Role = "Caption",
		Color = C.TextDim,
		Wrapped = true,
		XAlign = Enum.TextXAlignment.Center,
		LayoutOrder = 22,
		Parent = scroll,
	})
	Responsive.bind(note, "Size", function(R)
		return UDim2.new(1, 0, 0, R.px(34))
	end)
end

function ShopWindow:BuildPassCard(parent: Instance, itemId: string, order: number)
	local pass = MonetizationConfig.GamePasses[itemId]
	local rarity = DragonConfig.Rarities.Exclusive
	local top = (pass.Price or 0) >= 5000
	local accent = top and Color3.fromRGB(255, 205, 60) or rarity.Color
	local card = Kit.surface({ Name = itemId, LayoutOrder = order, StrokeColor = accent, StrokeTransparency = 0.1, Color = Color3.fromRGB(34, 20, 26), Transparency = 0.02, Parent = parent })
	Responsive.bind(card, "Size", function(R)
		return UDim2.new(1, 0, 0, R.px(R.Device == "Phone" and (R.Portrait and 330 or 230) or 250))
	end)
	Create("UIGradient", {
		Rotation = 0,
		Color = top and ColorSequence.new(Color3.fromRGB(110, 70, 20), Color3.fromRGB(40, 24, 60)) or ColorSequence.new(Color3.fromRGB(90, 30, 30), Color3.fromRGB(30, 22, 40)),
		Parent = card,
	})
	local pv = Kit.frame({ Name = "PreviewBox", Position = UDim2.fromScale(0.01, 0.04), Size = UDim2.fromScale(0.4, 0.92), Parent = card })
	local glow = Kit.frame({ Name = "Glow", BackgroundTransparency = 0.55, BackgroundColor3 = accent, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.55), Size = UDim2.fromScale(0.8, 0.8), SizeConstraint = Enum.SizeConstraint.RelativeYY, Parent = pv })
	Kit.corner(glow, 999)
	Create("UIGradient", {
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) }),
		Parent = glow,
	})
	local vp = Create("ViewportFrame", {
		Name = "Preview",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Ambient = Color3.fromRGB(160, 150, 150),
		LightColor = Color3.fromRGB(255, 240, 220),
		LightDirection = Vector3.new(-0.5, -1, -0.7),
		Parent = pv,
	})
	local cam = Instance.new("Camera")
	cam.FieldOfView = 30
	cam.Parent = vp
	vp.CurrentCamera = cam
	self.PassViews[itemId] = { Viewport = vp, Camera = cam, Species = pass.Grants, Mutation = pass.Mutation or "None" }

	local info = Kit.frame({ Name = "Info", Position = UDim2.fromScale(0.43, 0.06), Size = UDim2.fromScale(0.55, 0.88), Parent = card })
	local tags = Kit.frame({ Name = "Tags", Size = UDim2.fromScale(1, 0.12), Parent = info })
	Kit.list(tags, "H", 6, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Center)
	Kit.badge({ Text = "EXCLUSIVE", Color = rarity.Color, LayoutOrder = 1, Parent = tags })
	Kit.badge({ Text = "x" .. tostring(pass.Luck or 1) .. " LUCK", Color = C.Success, LayoutOrder = 2, Parent = tags })
	if pass.Mutation == "Omni" then
		Kit.badge({ Text = "ALL MUTATIONS", Color = Color3.fromRGB(190, 90, 255), LayoutOrder = 3, Parent = tags })
	end
	local title = Kit.text({ Name = "Title", Text = string.upper(pass.Name) .. (pass.Grants == "OwnerDragon" and "" or " DRAGON"), Role = "Display", Scaled = true, Position = UDim2.fromScale(0, 0.14), Size = UDim2.fromScale(1, 0.2), Parent = info })
	Create("UIGradient", { Rotation = 90, Color = top and ColorSequence.new(Color3.fromRGB(255, 245, 190), Color3.fromRGB(255, 180, 40)) or ColorSequence.new(rarity.Glow, rarity.Color), Parent = title })
	local perks = Kit.frame({ Name = "Perks", Position = UDim2.fromScale(0, 0.37), Size = UDim2.fromScale(1, 0.4), Parent = info })
	Kit.list(perks, "V", 2, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)
	for i, perk in pass.Perks do
		local row = Kit.frame({ Name = "Perk" .. i, Size = UDim2.fromScale(1, 1 / #pass.Perks - 0.02), LayoutOrder = i, Parent = perks })
		local chk = Kit.frame({ Size = UDim2.fromScale(0.8, 0.8), Position = UDim2.fromScale(0, 0.1), SizeConstraint = Enum.SizeConstraint.RelativeYY, Parent = row })
		Icons.make("Check", { Color = C.Success, Accent = C.Success, Ink = C.Ink }).Parent = chk
		Kit.text({ Text = perk, Role = "Body", Scaled = true, Position = UDim2.fromScale(0.08, 0.05), Size = UDim2.fromScale(0.92, 0.9), Parent = row })
	end
	local buy = Kit.button({
		Name = "Buy",
		Text = robux(pass.Price),
		Style = "Success",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(0.62, 0.18),
		Parent = info,
	})
	buy.Activated:Connect(function()
		self:Buy(itemId)
	end)
	self.PassButtons[itemId] = buy
end

function ShopWindow:BuildPassPreviews()
	if self._previewsBuilt then
		return
	end
	self._previewsBuilt = true
	for _, view in self.PassViews do
		task.defer(function()
			local ok, model = pcall(function()
				local m = DragonVisual.build(view.Species, { Saddle = false, Detail = "Medium", Mutation = view.Mutation })
				local pose = Animator.samplePose(m, "Roar", 0.85)
				DragonVisual.pose(m, pose, CFrame.Angles(0, math.rad(150), 0))
				return m
			end)
			if not ok or not model then
				return
			end
			model.Parent = view.Viewport
			local cf, size = model:GetBoundingBox()
			local radius = math.max(size.X, size.Y, size.Z) * 0.5 * 0.62
			local dist = radius / math.tan(math.rad(view.Camera.FieldOfView) * 0.5)
			view.Camera.CFrame = CFrame.lookAt(cf.Position + Vector3.new(dist * 0.35, size.Y * 0.2, dist), cf.Position)
		end)
	end
end

-- ============================================================== upgrades tab
function ShopWindow:BuildUpgrades(page: Instance)
	local scroll = Kit.scroll({ Name = "Scroll", Size = UDim2.fromScale(1, 1), Parent = page })
	Kit.padding(scroll, 2, 10, 6, 2)
	Kit.list(scroll, "V", 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
	local colors = {
		EggStorage = Color3.fromRGB(110, 208, 104),
		DragonStorage = Color3.fromRGB(77, 163, 255),
		HatchLuck = Color3.fromRGB(64, 236, 214),
		Radar = Color3.fromRGB(255, 140, 60),
	}
	for i, id in EconomyConfig.UpgradeOrder do
		local def = EconomyConfig.Upgrades[id]
		local color = colors[id] or C.Gold
		local row = Kit.surface({ Name = id, LayoutOrder = i, StrokeColor = color, StrokeTransparency = 0.55, Parent = scroll })
		Responsive.bind(row, "Size", function(R)
			return UDim2.new(1, 0, 0, R.px(R.Device == "Phone" and 92 or 84))
		end)
		iconDisc(row, def.Icon, color, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0.015, 0.5), Size = UDim2.fromScale(0.7, 0.7) })
		Kit.text({ Name = "Name", Text = string.upper(def.Name), Role = "Heading", Position = UDim2.fromScale(0.13, 0.12), Size = UDim2.fromScale(0.46, 0.34), Truncate = true, Parent = row })
		Kit.text({ Name = "Desc", Text = def.Description, Role = "Caption", Color = C.TextMuted, Position = UDim2.fromScale(0.13, 0.5), Size = UDim2.fromScale(0.46, 0.3), Truncate = true, Parent = row })
		local level = Kit.text({ Name = "Level", Text = "", Role = "Label", Color = color, XAlign = Enum.TextXAlignment.Right, Position = UDim2.fromScale(0.5, 0.2), Size = UDim2.fromScale(0.2, 0.6), Parent = row })
		local buy = Kit.button({
			Name = "Buy",
			Text = "BUY",
			Style = "Gold",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(0.985, 0.5),
			Size = UDim2.fromScale(0.25, 0.62),
			Parent = row,
		})
		buy.Activated:Connect(function()
			self:BuyUpgrade(id)
		end)
		self.UpgradeRows[id] = { Level = level, Buy = buy }
	end
end

local function fmtValue(def, v: number): string
	if def.Format == "Percent" then
		return "+" .. math.floor(v * 100 + 0.5) .. "%"
	elseif def.Format == "Range" then
		return v >= 100000 and "MAP" or (tostring(v) .. "m")
	end
	return tostring(v)
end

function ShopWindow:RefreshUpgrades()
	local data = self.Data and self.Data.all()
	if not data then
		return
	end
	for id, row in self.UpgradeRows do
		local def = EconomyConfig.Upgrades[id]
		local level = tonumber(data.Upgrades and data.Upgrades[id]) or 0
		local cur = def.Levels[level + 1]
		local nxt = def.Levels[level + 2]
		if nxt then
			row.Level.Text = string.format("%s  >  %s", fmtValue(def, cur.Value), fmtValue(def, nxt.Value))
			row.Buy:SetText(Format.cash(nxt.Price))
			row.Buy:SetEnabled((data.Cash or 0) >= nxt.Price)
		else
			row.Level.Text = fmtValue(def, cur.Value)
			row.Buy:SetText("MAXED")
			row.Buy:SetEnabled(false)
		end
	end
end

function ShopWindow:BuyUpgrade(id: string)
	if self.Busy then
		return
	end
	self.Busy = true
	task.spawn(function()
		local res = Net.request("Shop", "BuyUpgrade", { Id = id })
		self.Busy = false
		if self.UIC.HandleResult(res, EconomyConfig.Upgrades[id].Name .. " upgraded!") then
			self:RefreshUpgrades()
		end
	end)
end

-- ============================================================== buying
function ShopWindow:Buy(itemId: string)
	local def, kind = MonetizationConfig.find(itemId)
	if not def or self.Busy then
		return
	end
	if kind == "Pass" and self:OwnsPass(itemId) then
		self.UIC.Notify("info", "You already own the " .. def.Name .. "!")
		return
	end
	if def.Id ~= 0 then
		local ok, err = pcall(function()
			if kind == "Pass" then
				MarketplaceService:PromptGamePassPurchase(LocalPlayer, def.Id)
			else
				MarketplaceService:PromptProductPurchase(LocalPlayer, def.Id)
			end
		end)
		if not ok then
			warn("[Shop] prompt failed: " .. tostring(err))
		end
		return
	end
	if not (RunService:IsStudio() or ReplicatedStorage:GetAttribute("TestPurchases")) then
		self.UIC.Notify("info", def.Name .. " is coming soon!")
		return
	end
	-- Studio: free test purchase (the item is not created on Roblox yet)
	self.Busy = true
	task.spawn(function()
		local res = Net.request("Shop", "TestBuy", { Item = itemId })
		self.Busy = false
		if res.ok then
			self.UIC.Notify("rare", (res.data and res.data.Text or def.Name) .. "  (TEST)")
			self:Refresh()
		else
			self.UIC.HandleResult(res)
		end
	end)
end

function ShopWindow:OwnsPass(itemId: string): boolean
	local data = self.Data and self.Data.all()
	return MonetizationConfig.ownsPass(data, itemId)
end

function ShopWindow:Refresh()
	for itemId, button in self.PassButtons do
		local owned = self:OwnsPass(itemId)
		button:SetText(owned and "OWNED" or robux(MonetizationConfig.GamePasses[itemId].Price))
		button:SetStyle(owned and "Secondary" or "Success")
	end
	if self.Tab == "Upgrades" then
		self:RefreshUpgrades()
	end
end

function ShopWindow:OnOpen(args)
	self:BuildPassPreviews()
	self:ShowTab(args and args.Tab == "Upgrades" and "Upgrades" or "Robux")
	self:Refresh()
	if not self._observing and self.Data then
		self._observing = true
		for _, key in { "Flags", "Upgrades", "Cash" } do
			self.Data.changed(key):Connect(function()
				if self.Root.Visible then
					self:Refresh()
				end
			end)
		end
	end
end

return ShopWindow
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX000141">
						<Properties>
							<string name="Name">SpinWindow</string>
							<ProtectedString name="Source"><![CDATA[--[[
	SpinWindow (Spin Island panel)
	Opening it frames the giant 3D wheel with the camera (no dark window
	over it). UI: a white bar at the bottom (spins left, free spin timer,
	big SPIN button, x5 auto spin, buy spins, close) and a slim prize card
	on the side with your current odds (luck applied).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local SpinConfig = require(Configs:WaitForChild("SpinConfig"))
local MonetizationConfig = require(Configs:WaitForChild("MonetizationConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Create = require(UI.Create)
local Kit = require(UI.Kit)

local C = Theme.Colors
local H = Theme.Hud
local LocalPlayer = Players.LocalPlayer

local SpinWindow = {}
SpinWindow.__index = SpinWindow

local function whitePanel(props): Frame
	local f = Create("Frame", {
		BackgroundColor3 = H.Panel,
		BackgroundTransparency = H.Transparency,
		BorderSizePixel = 0,
	})
	for k, v in props do
		if k ~= "Parent" then
			(f :: any)[k] = v
		end
	end
	Kit.corner(f, 18)
	Kit.stroke(f, H.Stroke, Theme.Stroke.Normal, H.StrokeTransparency)
	Create("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), H.Shade), Parent = f })
	f.Parent = props.Parent
	return f :: Frame
end

local function segmentText(seg): string
	return seg.Label .. (seg.Jackpot and "  JACKPOT" or "")
end

function SpinWindow.new(ui, registry)
	local self = setmetatable({}, SpinWindow)
	self.UIC = ui
	self.Registry = registry
	self.Data = registry.DataController
	self.Name = "Spin"
	self.NoBackdrop = true
	self.Rows = {}
	self.Busy = false
	self.Auto = 0
	self.Root = Kit.frame({ Name = "SpinPanel", Size = UDim2.fromScale(1, 1) })
	self.Scale = Create("UIScale", { Parent = self.Root })
	self:Build()
	return self
end

function SpinWindow:Build()
	local root = self.Root
	-- ======================== bottom bar
	local bar = whitePanel({ Name = "Bar", AnchorPoint = Vector2.new(0.5, 1), Parent = root })
	self.Bar = bar
	-- spins block (left)
	local left = Kit.frame({ Name = "Spins", Position = UDim2.fromScale(0.03, 0.12), Size = UDim2.fromScale(0.27, 0.76), Parent = bar })
	Kit.text({ Name = "Caption", Text = "SPINS", Role = "Micro", Scaled = true, Color = H.TextMuted, Size = UDim2.fromScale(1, 0.24), Parent = left })
	self.SpinsText = Kit.text({ Name = "Count", Text = "0", Role = "Display", Scaled = true, Font = Theme.Fonts.Number, Color = H.Text, Position = UDim2.fromScale(0, 0.22), Size = UDim2.fromScale(1, 0.48), Parent = left })
	self.FreeText = Kit.text({ Name = "Free", Text = "", Role = "Label", Scaled = true, Color = H.TextMuted, Position = UDim2.fromScale(0, 0.72), Size = UDim2.fromScale(1, 0.26), Parent = left })
	-- SPIN (centre)
	local spin = Kit.button({ Name = "SpinButton", Text = "SPIN!", Icon = "Star", Style = "Primary", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.34, 0.72), Parent = bar })
	spin.Activated:Connect(function()
		self.Auto = 0
		self:Spin()
	end)
	self.SpinButton = spin
	self.SpinScale = Create("UIScale", { Parent = spin.Instance })
	-- right: auto x5, buy, close
	local right = Kit.frame({ Name = "Actions", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.fromScale(0.975, 0.5), Size = UDim2.fromScale(0.28, 0.76), Parent = bar })
	Kit.list(right, "V", 6, Enum.HorizontalAlignment.Right, Enum.VerticalAlignment.Center)
	local auto = Kit.button({ Name = "Auto", Text = "AUTO x5", Style = "Blue", Size = UDim2.fromScale(1, 0.46), LayoutOrder = 1, Parent = right })
	auto.Activated:Connect(function()
		self.Auto = 5
		self:Spin()
	end)
	self.AutoButton = auto
	local buy = Kit.button({ Name = "Buy", Text = "BUY SPINS", Style = "Success", Size = UDim2.fromScale(1, 0.46), LayoutOrder = 2, Parent = right })
	buy.Activated:Connect(function()
		self.Packs.Visible = not self.Packs.Visible
	end)
	-- close (top-right corner of the bar)
	local close = Kit.closeButton({ Parent = root })
	close.Instance.AnchorPoint = Vector2.new(1, 0)
	close.Instance.SizeConstraint = Enum.SizeConstraint.RelativeYY
	close.Instance.Size = UDim2.fromScale(0.075, 0.075)
	self.CloseButton = close.Instance
	close.Activated:Connect(function()
		self.Auto = 0
		self.UIC.Close()
	end)
	-- buy popover (above the bar, right side)
	local packs = whitePanel({ Name = "Packs", AnchorPoint = Vector2.new(1, 1), Visible = false, Parent = root })
	self.Packs = packs
	Kit.padding(packs, 8)
	Kit.list(packs, "V", 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	for i, id in { "SpinPack", "SpinPackBig" } do
		local def = MonetizationConfig.Products[id]
		local b = Kit.button({ Name = id, Text = def.Name .. "   R$ " .. def.Price, Style = "Success", Size = UDim2.fromScale(1, 0.46), LayoutOrder = i, Parent = packs })
		b.Activated:Connect(function()
			packs.Visible = false
			local shop = self.UIC.GetWindow and self.UIC.GetWindow("Shop")
			if shop and shop.Buy then
				shop:Buy(id)
				task.delay(0.8, function()
					self:Refresh()
				end)
			end
		end)
	end
	-- ======================== prize card (side)
	local card = whitePanel({ Name = "Prizes", AnchorPoint = Vector2.new(1, 0.5), Parent = root })
	self.Card = card
	local title = Kit.text({ Name = "Title", Text = "PRIZES", Role = "Heading", Scaled = true, Color = H.Text, Position = UDim2.fromScale(0.08, 0.02), Size = UDim2.fromScale(0.5, 0.07), Parent = card })
	local _ = title
	self.LuckTag = Kit.text({ Name = "Luck", Text = "", Role = "Label", Scaled = true, Color = Color3.fromRGB(46, 150, 70), XAlign = Enum.TextXAlignment.Right, Position = UDim2.fromScale(0.5, 0.025), Size = UDim2.fromScale(0.42, 0.06), Parent = card })
	local list = Kit.frame({ Name = "List", Position = UDim2.fromScale(0.05, 0.11), Size = UDim2.fromScale(0.9, 0.86), Parent = card })
	Kit.list(list, "V", 3, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
	local n = #SpinConfig.Segments
	for i, seg in SpinConfig.Segments do
		local row = Kit.frame({ Name = "Prize" .. i, Size = UDim2.new(1, 0, 1 / n, -3), LayoutOrder = i, Parent = list })
		local dot = Kit.frame({ BackgroundTransparency = 0, BackgroundColor3 = seg.Color, Position = UDim2.fromScale(0, 0.18), Size = UDim2.fromScale(0.64, 0.64), SizeConstraint = Enum.SizeConstraint.RelativeYY, Parent = row })
		Kit.corner(dot, 999)
		Kit.text({ Text = segmentText(seg), Role = "Label", Scaled = true, Color = seg.Jackpot and C.AccentDeep or H.Text, Position = UDim2.fromScale(0.14, 0.14), Size = UDim2.fromScale(0.6, 0.72), Parent = row })
		self.Rows[i] = Kit.text({ Text = "", Role = "Label", Scaled = true, Color = H.TextMuted, XAlign = Enum.TextXAlignment.Right, Position = UDim2.fromScale(0.72, 0.14), Size = UDim2.fromScale(0.28, 0.72), Parent = row })
	end
	-- ======================== pulse the SPIN button while a spin is ready
	RunService.RenderStepped:Connect(function()
		if not self.Root.Visible then
			return
		end
		local ready = self.Ready and not self.Busy
		local s = ready and (1 + 0.04 * math.sin(os.clock() * 5)) or 1
		self.SpinScale.Scale = s
	end)
end

function SpinWindow:ApplySize()
	local R = Responsive
	local phone = R.Device == "Phone"
	local margin = R.px(phone and 10 or 18)
	if phone then
		self.Bar.Size = UDim2.new(0.96, 0, 0.22, 0)
		self.Bar.Position = UDim2.new(0.5, 0, 1, -margin)
		self.Card.Visible = not R.Portrait
		self.Card.Size = UDim2.fromScale(0.26, 0.56)
		self.Card.Position = UDim2.new(1, -margin, 0.36, 0)
		self.Packs.Size = UDim2.fromScale(0.5, 0.18)
	else
		self.Bar.Size = UDim2.new(0.56, 0, 0.13, 0)
		self.Bar.Position = UDim2.new(0.5, 0, 1, -margin)
		self.Card.Visible = true
		self.Card.Size = UDim2.fromScale(0.2, 0.52)
		self.Card.Position = UDim2.new(1, -margin, 0.42, 0)
		self.Packs.Size = UDim2.fromScale(0.2, 0.13)
	end
	self.Packs.Position = UDim2.new(0.5 + self.Bar.Size.X.Scale / 2, 0, 1, -(margin * 2 + math.floor(self.Root.AbsoluteSize.Y * self.Bar.Size.Y.Scale)))
	self.CloseButton.Position = UDim2.new(1, -margin, 0, R.TopInset + margin)
end

function SpinWindow:Refresh()
	local data = self.Data and self.Data.all()
	if not data then
		return
	end
	local s = data.Spin or { NextFree = 0, Tickets = 0 }
	local left = (tonumber(s.NextFree) or 0) - workspace:GetServerTimeNow()
	local tickets = tonumber(s.Tickets) or 0
	local freeReady = left <= 0
	local total = tickets + (freeReady and 1 or 0)
	self.SpinsText.Text = Format.commas(total)
	self.FreeText.Text = freeReady and "FREE SPIN READY!" or ("Free spin in " .. Format.duration(left))
	self.FreeText.TextColor3 = freeReady and Color3.fromRGB(46, 150, 70) or H.TextMuted
	self.Ready = total > 0
	self.SpinButton:SetEnabled(total > 0 and not self.Busy)
	self.AutoButton:SetEnabled(total > 1 and not self.Busy)
	local luck = (tonumber(LocalPlayer:GetAttribute("Luck")) or 1) * (1 + TreeConfig.bonus(data, "SpinLuck"))
	luck = math.floor(luck * 100 + 0.5) / 100
	for i, p in SpinConfig.odds(luck) do
		self.Rows[i].Text = Format.percent(p)
	end
	self.LuckTag.Text = luck > 1 and string.format("x%s LUCK", tostring(luck)) or ""
end

-- Result card: a white HUD card that sits just above the bottom bar (never over the wheel or
-- its sign), pops in, holds and shrinks away. Replaces the old giant text over the scene.
function SpinWindow:ShowPrize(text: string, color: Color3, jackpot: boolean?)
	if self.PrizeCard then
		self.PrizeCard:Destroy()
		self.PrizeCard = nil
	end
	local phone = Responsive.Device == "Phone"
	local margin = Responsive.px(phone and 10 or 18)
	local barH = math.floor(self.Root.AbsoluteSize.Y * self.Bar.Size.Y.Scale)
	local card = whitePanel({
		Name = "PrizeResult",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -(margin * 2 + barH)),
		Size = phone and UDim2.fromScale(0.62, 0.17) or UDim2.fromScale(0.3, 0.115),
		ZIndex = 5,
		Parent = self.Root,
	})
	self.PrizeCard = card
	if jackpot then
		Kit.stroke(card, C.Accent, Theme.Stroke.Bold, 0)
	end
	local dot = Kit.frame({
		Name = "Dot",
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0.05, 0.5),
		Size = UDim2.fromScale(0.62, 0.62),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		Parent = card,
	})
	Kit.corner(dot, 999)
	Kit.text({ Name = "Caption", Text = jackpot and "JACKPOT!" or "YOU WON", Role = "Micro", Scaled = true, Color = jackpot and C.AccentDeep or H.TextMuted, Position = UDim2.fromScale(0.27, 0.12), Size = UDim2.fromScale(0.68, 0.24), Parent = card })
	Kit.text({ Name = "Prize", Text = text, Role = "Display", Scaled = true, Font = Theme.Fonts.Number, Color = H.Text, Position = UDim2.fromScale(0.27, 0.36), Size = UDim2.fromScale(0.68, 0.52), Parent = card })
	local scale = Create("UIScale", { Scale = 0.6, Parent = card })
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(2.8, function()
		if self.PrizeCard == card then
			TweenService:Create(scale, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 0 }):Play()
			task.delay(0.22, function()
				card:Destroy()
				if self.PrizeCard == card then
					self.PrizeCard = nil
				end
			end)
		end
	end)
end

function SpinWindow:Spin()
	if self.Busy then
		return
	end
	local spinner = self.Registry.SpinController
	if spinner and spinner.isSpinning() then
		return
	end
	self.Busy = true
	self.Packs.Visible = false
	self:Refresh()
	task.spawn(function()
		local res = Net.request("Spin", "Roll", {})
		if not res.ok then
			self.Busy = false
			self.Auto = 0
			self:Refresh()
			self.UIC.HandleResult(res)
			return
		end
		if spinner then
			spinner.play(res.data)
		end
		self.Busy = false
		self:Refresh()
		if self.Auto > 1 and self.Root.Visible and self.Ready then
			self.Auto -= 1
			self:Spin()
		else
			self.Auto = 0
		end
	end)
end

function SpinWindow:OnOpen()
	local spinner = self.Registry.SpinController
	if spinner then
		spinner.enterView()
	end
	-- entrance: bar slides up
	self.Bar.Position = UDim2.new(0.5, 0, 1.3, 0)
	self:ApplySize()
	local target = self.Bar.Position
	self.Bar.Position = UDim2.new(target.X.Scale, target.X.Offset, 1.3, 0)
	TweenService:Create(self.Bar, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = target }):Play()
	self:Refresh()
	if not self._ticking then
		self._ticking = true
		task.spawn(function()
			while true do
				task.wait(1)
				if self.Root.Visible then
					pcall(function()
						self:Refresh()
					end)
				end
			end
		end)
	end
end

function SpinWindow:OnHidden()
	self.Auto = 0
	local spinner = self.Registry.SpinController
	if spinner then
		spinner.exitView()
	end
end

return SpinWindow
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX000142">
						<Properties>
							<string name="Name">TeleportWindow</string>
							<ProtectedString name="Source"><![CDATA[--[[
	TeleportWindow
	Fast travel: one big button per destination (server validates the place
	and the cooldown; riding players travel with their dragon).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local WindowBase = require(UI.WindowBase)

local C = Theme.Colors

local TeleportWindow = {}
TeleportWindow.__index = TeleportWindow
setmetatable(TeleportWindow, { __index = WindowBase })

TeleportWindow.Places = {
	{ Id = "Sanctuary", Title = "MY SANCTUARY", Sub = "Your plot, nests and perches", Icon = "Home", Color = Color3.fromRGB(110, 208, 104) },
	{ Id = "Spawn", Title = "SPAWN", Sub = "Leaderboards and the fountain", Icon = "Trophy", Color = Color3.fromRGB(255, 196, 48) },
	{ Id = "SpinIsland", Title = "SPIN ISLAND", Sub = "Spin the wheel, win eggs", Icon = "Star", Color = Color3.fromRGB(255, 110, 190) },
	{ Id = "Shop", Title = "DRAGON MARKET", Sub = "Potions, boosts and eggs", Icon = "Bag", Color = Color3.fromRGB(77, 163, 255) },
	{ Id = "Forge", Title = "DRAGONSMITH FORGE", Sub = "Upgrades", Icon = "Flame", Color = Color3.fromRGB(255, 140, 60) },
	{ Id = "Quests", Title = "ELDER ROWAN", Sub = "Quests and rewards", Icon = "Scroll", Color = Color3.fromRGB(205, 164, 222) },
	{ Id = "Library", Title = "HALL OF DRAGONS", Sub = "Dragon Index", Icon = "Book", Color = Color3.fromRGB(64, 236, 214) },
}

function TeleportWindow.new(ui, registry)
	local self = WindowBase.new({
		Name = "Teleport",
		Title = "Teleport",
		Subtitle = "Fly there instantly",
		Icon = "Map",
		Spec = {
			Desktop = { Width = 0.46, Height = 0.8, Aspect = 0.95 },
			Tablet = { Width = 0.72, Height = 0.86, Aspect = 0.95 },
			Phone = { Width = 0.7, Height = 1 },
			PhonePortrait = { Width = 0.96, Height = 1 },
		},
	})
	setmetatable(self, TeleportWindow)
	self.UIC = ui
	self.Registry = registry
	self.Buttons = {}
	self.Busy = false
	self:Build()
	return self
end

function TeleportWindow:Build()
	local scroll = Kit.scroll({ Name = "List", Size = UDim2.fromScale(1, 1), Parent = self.Content })
	Kit.padding(scroll, 2, 8, 2, 2)
	Kit.list(scroll, "V", 10, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
	for i, place in TeleportWindow.Places do
		local row = Kit.surface({ Name = place.Id, LayoutOrder = i, StrokeColor = place.Color, StrokeTransparency = 0.45, Parent = scroll })
		Responsive.bind(row, "Size", function(R)
			return UDim2.new(1, 0, 0, R.px(R.Device == "Phone" and 78 or 74))
		end)
		-- icon disc
		local disc = Kit.frame({
			Name = "IconDisc",
			BackgroundTransparency = 0,
			BackgroundColor3 = place.Color,
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.fromScale(0.025, 0.5),
			Size = UDim2.fromScale(0.72, 0.72),
			SizeConstraint = Enum.SizeConstraint.RelativeYY,
			Parent = row,
		})
		Kit.corner(disc, 999)
		local iconBox = Kit.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.62, 0.62), Parent = disc })
		Icons.make(place.Icon, { Color = C.Ink, Accent = C.Text, Ink = place.Color }).Parent = iconBox
		Kit.text({
			Name = "Title",
			Text = place.Title,
			Role = "Heading",
			Position = UDim2.fromScale(0.2, 0.14),
			Size = UDim2.fromScale(0.52, 0.42),
			Truncate = true,
			Parent = row,
		})
		Kit.text({
			Name = "Sub",
			Text = place.Sub,
			Role = "Caption",
			Color = C.TextMuted,
			Position = UDim2.fromScale(0.2, 0.56),
			Size = UDim2.fromScale(0.52, 0.3),
			Truncate = true,
			Parent = row,
		})
		local go = Kit.button({
			Name = "Go",
			Text = "GO",
			Style = i == 1 and "Success" or "Primary",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.fromScale(0.975, 0.5),
			Size = UDim2.fromScale(0.22, 0.66),
			Parent = row,
		})
		go.Activated:Connect(function()
			self:Go(place)
		end)
		self.Buttons[place.Id] = go
	end
end

-- Quick dark "blink" so the jump does not feel like a glitch.
function TeleportWindow:Blink()
	local layer = self.UIC.Layers.GameModal and self.UIC.Layers.GameModal.Root
	if not layer then
		return
	end
	local f = Instance.new("Frame")
	f.Name = "TeleportBlink"
	f.BackgroundColor3 = Color3.fromRGB(10, 12, 24)
	f.BackgroundTransparency = 0.05
	f.BorderSizePixel = 0
	f.Size = UDim2.fromScale(1, 1)
	f.ZIndex = 50
	f.Parent = layer
	local tw = TweenService:Create(f, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { BackgroundTransparency = 1 })
	tw.Completed:Connect(function()
		f:Destroy()
	end)
	tw:Play()
end

function TeleportWindow:Go(place)
	if self.Busy then
		return
	end
	self.Busy = true
	local button = self.Buttons[place.Id]
	if button then
		button:SetBusy(true)
	end
	task.spawn(function()
		local res = Net.request("Travel", "To", { Place = place.Id })
		if button then
			button:SetBusy(false)
		end
		self.Busy = false
		if res.ok then
			self:Blink()
			self.UIC.Close()
			self.UIC.Notify("success", "Welcome to " .. place.Title:sub(1, 1) .. place.Title:sub(2):lower() .. "!")
		else
			self.UIC.HandleResult(res)
		end
	end)
end

function TeleportWindow:OnOpen() end

return TeleportWindow
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX000143">
						<Properties>
							<string name="Name">TreeWindow</string>
							<ProtectedString name="Source"><![CDATA[--[[
	TreeWindow (the Great Tree skill tree)
	Five categories (tabs: Luck, Wealth, Flight, Nest, Bond) with 3-5 branches each.
	Every branch is a row: its icon, name and current bonus, then a scrolling strip
	of 8-12 level nodes joined by a vine. Levels are bought strictly in order:
	owned nodes are filled with the branch colour and a check, the next node pulses
	when you can afford it, later nodes are locked. Tap a node to inspect it; the
	strip at the bottom shows what it gives and buys it. All prices and bonuses
	come from TreeConfig; the server validates every purchase (TreeService).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Create = require(UI.Create)
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local WindowBase = require(UI.WindowBase)

local C = Theme.Colors

local TreeWindow = {}
TreeWindow.__index = TreeWindow
setmetatable(TreeWindow, { __index = WindowBase })

local SPEC = {
	Desktop = { Width = 0.7, Height = 0.8, Aspect = 1.55 },
	Tablet = { Width = 0.92, Height = 0.86, Aspect = 1.5 },
	Phone = { Width = 0.98, Height = 1 },
	PhonePortrait = { Width = 0.98, Height = 1 },
}

local WHITE = Color3.new(1, 1, 1)
local CELL = 84 -- design px of one level cell
local ROW = 104 -- design px of one branch row
local HEAD = 214 -- design px of the branch head (icon + name)

local function px(n: number)
	return Responsive.px(n)
end

local function iconDisc(parent: Instance, icon: string, color: Color3, props)
	local disc = Kit.frame({
		Name = "IconDisc",
		BackgroundTransparency = 0,
		BackgroundColor3 = color,
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		Parent = parent,
	})
	for k, v in props do
		(disc :: any)[k] = v
	end
	Kit.corner(disc, 999)
	Create("UIGradient", { Rotation = 90, Color = ColorSequence.new(color:Lerp(WHITE, 0.25), color:Lerp(Color3.new(0, 0, 0), 0.2)), Parent = disc })
	local box = Kit.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.6, 0.6), Parent = disc })
	Icons.make(icon, { Color = C.Ink, Accent = C.Text, Ink = color }).Parent = box
	return disc
end

function TreeWindow.new(ui, registry)
	local self = WindowBase.new({
		Name = "Tree",
		Title = "Great Tree",
		Subtitle = "Permanent upgrades",
		Icon = "Clover",
		Spec = SPEC,
	})
	setmetatable(self, TreeWindow)
	self.UIC = ui
	self.Registry = registry
	self.Data = registry.DataController
	self.Rows = {} -- [branchId] = { Row, Strip, Nodes, Now, Next, Branch }
	self.Category = TreeConfig.Categories[1].Id
	self.Selected = nil -- { Id, Level }
	self.Busy = false
	self:Build()
	return self
end

-- ============================================================== build
function TreeWindow:Build()
	local content = self.Content

	-- top strip: category tabs + progress + cash
	local top = Kit.frame({ Name = "Top", Parent = content })
	Responsive.bind(top, "Size", function(R)
		return UDim2.new(1, 0, 0, R.px(34))
	end)
	local ids, labels = {}, {}
	for _, cat in TreeConfig.Categories do
		table.insert(ids, cat.Id)
		table.insert(labels, string.upper(cat.Name))
	end
	self.Tabs = Kit.segmented({
		Name = "Tabs",
		Options = ids,
		Labels = labels,
		Position = UDim2.fromScale(0, 0),
		Size = UDim2.fromScale(0.56, 1),
		Parent = top,
	})
	self.Tabs.Changed:Connect(function(v)
		self:ShowCategory(v)
	end)
	self.TotalText = Kit.text({
		Name = "Total",
		Text = "",
		Role = "Caption",
		Color = C.TextMuted,
		XAlign = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(0.77, 0),
		Size = UDim2.fromScale(0.2, 1),
		Truncate = true,
		Parent = top,
	})
	self.CashText = Kit.text({
		Name = "Cash",
		Text = "$0",
		Role = "Heading",
		Color = C.GoldBright,
		XAlign = Enum.TextXAlignment.Right,
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.fromScale(1, 0),
		Size = UDim2.fromScale(0.22, 1),
		Truncate = true,
		Parent = top,
	})

	-- branch rows (vertical scroll when the window is short, e.g. phones)
	local scroll = Kit.scroll({ Name = "Branches", Parent = content })
	self.Scroll = scroll
	Kit.list(scroll, "V", 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
	Responsive.bind(scroll, "Position", function(R)
		return UDim2.new(0, 0, 0, R.px(42))
	end)
	Responsive.bind(scroll, "Size", function(R)
		return UDim2.new(1, 0, 1, -(R.px(42) + R.px(86)))
	end)
	for _, cat in TreeConfig.Categories do
		for i, branch in cat.Branches do
			self:BuildRow(scroll, branch, i)
		end
	end

	-- detail strip
	local detail = Kit.surface({ Name = "Detail", AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Parent = content })
	self.Detail = detail
	Responsive.bind(detail, "Size", function(R)
		return UDim2.new(1, 0, 0, R.px(78))
	end)
	self.DetailDisc = iconDisc(detail, "Clover", C.Gold, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 10, 0.5, 0), Size = UDim2.fromScale(0.62, 0.62) })
	self.DetailTitle = Kit.text({ Name = "Title", Text = "", Role = "Heading", Position = UDim2.fromScale(0.085, 0.12), Size = UDim2.fromScale(0.56, 0.36), Truncate = true, Parent = detail })
	self.DetailBody = Kit.text({ Name = "Body", Text = "", Role = "Caption", Color = C.TextMuted, Position = UDim2.fromScale(0.085, 0.5), Size = UDim2.fromScale(0.56, 0.36), Truncate = true, Parent = detail })
	self.BuyButton = Kit.button({
		Name = "Buy",
		Text = "BUY",
		Style = "Gold",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromScale(0.3, 0.64),
		Parent = detail,
	})
	self.BuyButton.Activated:Connect(function()
		self:Buy()
	end)

	-- the node of the next purchasable level pulses while you can afford it
	RunService.RenderStepped:Connect(function()
		if not self.Root.Visible then
			return
		end
		local k = 0.5 + 0.5 * math.sin(os.clock() * 4)
		for _, row in self.Rows do
			local node = row.Next
			if node and node.Pulse and row.Row.Visible then
				node.Stroke.Thickness = px(3) + px(2.2) * k
			end
		end
	end)
end

function TreeWindow:BuildRow(parent: Instance, branch, order: number)
	local row = Kit.surface({ Name = branch.Id, LayoutOrder = order, StrokeColor = branch.Color, StrokeTransparency = 0.55, Parent = parent })
	row.Visible = false
	Responsive.bind(row, "Size", function(R)
		return UDim2.new(1, 0, 0, R.px(ROW))
	end)
	local info = { Row = row, Nodes = {}, Branch = branch }
	self.Rows[branch.Id] = info

	-- head: icon + name + current bonus
	local head = Kit.frame({ Name = "Head", Position = UDim2.fromOffset(8, 0), Parent = row })
	Responsive.bind(head, "Size", function(R)
		return UDim2.new(0, R.px(HEAD), 1, 0)
	end)
	iconDisc(head, branch.Icon, branch.Color, { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromScale(0.56, 0.56) })
	local text = Kit.frame({ Name = "Text", Position = UDim2.fromScale(0.3, 0), Size = UDim2.fromScale(0.7, 1), Parent = head })
	Kit.text({ Name = "Name", Text = string.upper(branch.Name), Role = "Label", Font = Theme.Fonts.Heading, Wrapped = true, YAlign = Enum.TextYAlignment.Bottom, Position = UDim2.fromScale(0, 0.04), Size = UDim2.fromScale(1, 0.5), Parent = text })
	info.Now = Kit.text({ Name = "Now", Text = "", Role = "Caption", Color = branch.Color, YAlign = Enum.TextYAlignment.Top, Position = UDim2.fromScale(0, 0.55), Size = UDim2.fromScale(1, 0.3), Truncate = true, Parent = text })

	-- level strip (scrolls sideways when the levels do not fit)
	local strip = Create("ScrollingFrame", {
		Name = "Strip",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.None,
		ScrollBarImageColor3 = branch.Color,
		ScrollBarImageTransparency = 0.3,
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable,
		Selectable = false,
		Parent = row,
	})
	info.Strip = strip
	local n = #branch.Levels
	Responsive.bind(strip, "Position", function(R)
		return UDim2.new(0, R.px(HEAD) + 12, 0, 0)
	end)
	Responsive.bind(strip, "Size", function(R)
		return UDim2.new(1, -(R.px(HEAD) + 18), 1, 0)
	end)
	Responsive.bind(strip, "CanvasSize", function(R)
		return UDim2.fromOffset(R.px(CELL) * n, 0)
	end)
	Responsive.bind(strip, "ScrollBarThickness", function(R)
		return math.max(3, R.px(4))
	end)
	Kit.list(strip, "H", 0, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Top)

	for k, entry in branch.Levels do
		local cell = Kit.frame({ Name = "Level" .. k, LayoutOrder = k, Parent = strip })
		Responsive.bind(cell, "Size", function(R)
			return UDim2.new(0, R.px(CELL), 1, 0)
		end)
		-- vine halves (left joins the previous node, right joins the next)
		local halves = {}
		for _, side in { "L", "R" } do
			if (side == "L" and k > 1) or (side == "R" and k < n) then
				local h = Kit.frame({ Name = "Vine" .. side, BackgroundTransparency = 0, BackgroundColor3 = C.Disabled, AnchorPoint = Vector2.new(0, 0.5), Parent = cell })
				Responsive.bind(h, "Size", function(R)
					return UDim2.new(0.5, 0, 0, R.px(5))
				end)
				Responsive.bind(h, "Position", function(R)
					return UDim2.new(side == "L" and 0 or 0.5, 0, 0, R.px(33))
				end)
				halves[side] = h
			end
		end
		local btn = Create("TextButton", {
			Name = "Node",
			AutoButtonColor = false,
			Text = "",
			BackgroundColor3 = C.Surface,
			BorderSizePixel = 0,
			AnchorPoint = Vector2.new(0.5, 0),
			ZIndex = 3,
			Parent = cell,
		})
		Responsive.bind(btn, "Size", function(R)
			return UDim2.fromOffset(R.px(46), R.px(46))
		end)
		Responsive.bind(btn, "Position", function(R)
			return UDim2.new(0.5, 0, 0, R.px(10))
		end)
		Kit.corner(btn, 999)
		local stroke = Kit.stroke(btn, branch.Color, 3, 0)
		local scale = Create("UIScale", { Parent = btn })
		local numeral = Kit.text({ Name = "Numeral", Text = tostring(k), Role = "Heading", Font = Theme.Fonts.Number, Color = branch.Color, XAlign = Enum.TextXAlignment.Center, ZIndex = 4, Parent = btn })
		local checkBox = Kit.frame({ Name = "Check", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.58, 0.58), ZIndex = 4, Visible = false, Parent = btn })
		Icons.make("Check", { Color = C.Ink, Accent = C.Ink, Ink = branch.Color }).Parent = checkBox
		local lockBox = Kit.frame({ Name = "Lock", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.5, 0.5), ZIndex = 4, Visible = false, Parent = btn })
		Icons.make("Lock", { Color = C.TextDim, Accent = C.TextDim, Ink = C.Surface }).Parent = lockBox
		local bonus = Kit.text({ Name = "Bonus", Text = TreeConfig.formatBonus(branch, entry.Bonus), Role = "Label", XAlign = Enum.TextXAlignment.Center, Truncate = true, Parent = cell })
		Responsive.bind(bonus, "Position", function(R)
			return UDim2.new(0, 0, 0, R.px(62))
		end)
		Responsive.bind(bonus, "Size", function(R)
			return UDim2.new(1, 0, 0, R.px(18))
		end)
		local price = Kit.text({ Name = "Price", Text = Format.cash(entry.Price), Role = "Caption", XAlign = Enum.TextXAlignment.Center, Truncate = true, Parent = cell })
		Responsive.bind(price, "Position", function(R)
			return UDim2.new(0, 0, 0, R.px(80))
		end)
		Responsive.bind(price, "Size", function(R)
			return UDim2.new(1, 0, 0, R.px(16))
		end)
		local node = { Button = btn, Stroke = stroke, Scale = scale, Numeral = numeral, Check = checkBox, Lock = lockBox, Bonus = bonus, Price = price, Halves = halves, Level = k, Id = branch.Id }
		info.Nodes[k] = node
		btn.Activated:Connect(function()
			self.UIC.sound("Click")
			self:Select(branch.Id, k)
		end)
	end
end

-- ============================================================== state
function TreeWindow:Snapshot()
	local data = self.Data and self.Data.all()
	return data, data and (tonumber(data.Cash) or 0) or 0
end

function TreeWindow:LevelOf(id: string): number
	local data = self:Snapshot()
	return TreeConfig.level(data, id)
end

function TreeWindow:Select(id: string, level: number)
	self.Selected = { Id = id, Level = level }
	self:Refresh()
end

-- default selection in a category: an affordable next level, else the first open next level
function TreeWindow:PickDefault(categoryId: string)
	local data, cash = self:Snapshot()
	local cat = TreeConfig.CategoryById[categoryId]
	local firstOpen
	for _, branch in cat.Branches do
		local lvl = TreeConfig.level(data, branch.Id)
		local nxt = branch.Levels[lvl + 1]
		if nxt then
			firstOpen = firstOpen or { Id = branch.Id, Level = lvl + 1 }
			if cash >= nxt.Price then
				return { Id = branch.Id, Level = lvl + 1 }
			end
		end
	end
	local b = cat.Branches[1]
	return firstOpen or { Id = b.Id, Level = #b.Levels }
end

-- Scrolls every visible strip so its next purchasable node is in the middle.
function TreeWindow:ScrollToNext()
	local data = self:Snapshot()
	for id, info in self.Rows do
		if info.Row.Visible then
			local nextIndex = math.min(TreeConfig.level(data, id) + 1, #info.Branch.Levels)
			local cell = px(CELL)
			local view = info.Strip.AbsoluteSize.X
			info.Strip.CanvasPosition = Vector2.new(math.max(0, (nextIndex - 0.5) * cell - view / 2), 0)
		end
	end
end

function TreeWindow:ShowCategory(categoryId: string)
	if not TreeConfig.CategoryById[categoryId] then
		return
	end
	self.Category = categoryId
	self.Tabs:Set(categoryId)
	for _, info in self.Rows do
		info.Row.Visible = info.Branch.Category == categoryId
	end
	self.Scroll.CanvasPosition = Vector2.zero
	if not self.Selected or TreeConfig.ById[self.Selected.Id].Category ~= categoryId then
		self.Selected = self:PickDefault(categoryId)
	end
	self:Refresh()
	task.defer(function()
		self:ScrollToNext()
	end)
end

function TreeWindow:Refresh()
	local data, cash = self:Snapshot()
	if not data then
		return
	end
	self.CashText.Text = Format.cash(cash)
	local have, total = TreeConfig.totals(data)
	self.TotalText.Text = string.format("%d / %d LEVELS", have, total)
	for _, branch in TreeConfig.Branches do
		local info = self.Rows[branch.Id]
		local cur = TreeConfig.level(data, branch.Id)
		info.Next = nil
		if cur > 0 then
			info.Now.Text = TreeConfig.formatBonus(branch, TreeConfig.bonus(data, branch.Id)) .. string.format("   LV %d/%d", cur, #branch.Levels)
		else
			info.Now.Text = string.format("NOT GROWN   LV 0/%d", #branch.Levels)
		end
		for k, node in info.Nodes do
			local entry = branch.Levels[k]
			local owned = k <= cur
			local isNext = k == cur + 1
			local affordable = isNext and cash >= entry.Price
			local selected = self.Selected and self.Selected.Id == branch.Id and self.Selected.Level == k
			node.Pulse = affordable
			if owned then
				node.Button.BackgroundColor3 = branch.Color
				node.Stroke.Color = WHITE
				node.Stroke.Thickness = px(2)
				node.Numeral.Visible = false
				node.Check.Visible = true
				node.Lock.Visible = false
				node.Bonus.TextColor3 = C.Text
				node.Price.Text = "OWNED"
				node.Price.TextColor3 = C.Success
			elseif isNext then
				node.Button.BackgroundColor3 = C.Surface
				node.Stroke.Color = branch.Color
				node.Stroke.Thickness = px(3)
				node.Numeral.Visible = true
				node.Check.Visible = false
				node.Lock.Visible = false
				node.Bonus.TextColor3 = branch.Color
				node.Price.Text = Format.cash(entry.Price)
				node.Price.TextColor3 = affordable and C.GoldBright or C.Danger
				info.Next = node
			else
				node.Button.BackgroundColor3 = C.SurfaceDeep
				node.Stroke.Color = C.Disabled
				node.Stroke.Thickness = px(2)
				node.Numeral.Visible = false
				node.Check.Visible = false
				node.Lock.Visible = true
				node.Bonus.TextColor3 = C.TextDim
				node.Price.Text = Format.cash(entry.Price)
				node.Price.TextColor3 = C.TextDim
			end
			if selected then
				node.Stroke.Color = WHITE
				node.Stroke.Thickness = px(4)
				node.Pulse = false
			end
			if node.Halves.L then
				node.Halves.L.BackgroundColor3 = (cur >= k) and branch.Color or C.Disabled
			end
			if node.Halves.R then
				node.Halves.R.BackgroundColor3 = (cur >= k + 1) and branch.Color or C.Disabled
			end
		end
	end
	self:UpdateDetail()
end

function TreeWindow:UpdateDetail()
	local sel = self.Selected
	local data, cash = self:Snapshot()
	local branch = sel and TreeConfig.ById[sel.Id]
	if not branch or not data then
		return
	end
	local cur = TreeConfig.level(data, sel.Id)
	local entry = branch.Levels[sel.Level]
	self.DetailDisc.BackgroundColor3 = branch.Color
	self.DetailTitle.Text = string.format("%s  -  LEVEL %d / %d", string.upper(branch.Name), sel.Level, #branch.Levels)
	local after = TreeConfig.formatBonus(branch, entry.Bonus)
	local body = branch.Description .. "  "
	if cur > 0 and sel.Level > cur then
		body ..= TreeConfig.formatBonus(branch, TreeConfig.bonus(data, sel.Id)) .. " > " .. after
	else
		body ..= after
	end
	self.DetailBody.Text = body
	if sel.Level <= cur then
		self.BuyButton:SetText("OWNED")
		self.BuyButton:SetStyle("Secondary")
		self.BuyButton:SetEnabled(false)
	elseif sel.Level == cur + 1 then
		self.BuyButton:SetText("BUY  " .. Format.cash(entry.Price))
		self.BuyButton:SetStyle("Gold")
		self.BuyButton:SetEnabled(cash >= entry.Price)
	else
		self.BuyButton:SetText("LOCKED")
		self.BuyButton:SetStyle("Secondary")
		self.BuyButton:SetEnabled(false)
	end
end

-- ============================================================== buying
function TreeWindow:Buy()
	local sel = self.Selected
	if not sel or self.Busy then
		return
	end
	self.Busy = true
	self.BuyButton:SetBusy(true)
	task.spawn(function()
		local res = Net.request("Tree", "Buy", { Id = sel.Id })
		self.Busy = false
		self.BuyButton:SetBusy(false)
		local branch = TreeConfig.ById[sel.Id]
		if self.UIC.HandleResult(res, branch.Name .. " level " .. tostring(res.data and res.data.Level or "") .. "!") then
			self.UIC.sound("Purchase")
			local level = res.data and res.data.Level or sel.Level
			local node = self.Rows[sel.Id].Nodes[level]
			if node then
				TweenService:Create(node.Scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.4 }):Play()
				task.delay(0.18, function()
					TweenService:Create(node.Scale, TweenInfo.new(0.22, Enum.EasingStyle.Quad), { Scale = 1 }):Play()
				end)
			end
			-- move on to the next level of this branch
			local nextLevel = math.min(level + 1, #branch.Levels)
			self.Selected = { Id = sel.Id, Level = nextLevel }
			self:Refresh()
		end
	end)
end

-- ============================================================== lifecycle
function TreeWindow:OnOpen(args)
	local branchId = args and args.Branch
	if branchId and TreeConfig.ById[branchId] then
		local branch = TreeConfig.ById[branchId]
		self.Category = branch.Category
		self.Selected = { Id = branchId, Level = math.min(self:LevelOf(branchId) + 1, #branch.Levels) }
	elseif args and args.Category and TreeConfig.CategoryById[args.Category] then
		self.Category = args.Category
		self.Selected = nil
	end
	self:ShowCategory(self.Category)
	if not self._observing and self.Data then
		self._observing = true
		for _, key in { "Tree", "Cash" } do
			self.Data.changed(key):Connect(function()
				if self.Root.Visible then
					self:Refresh()
				end
			end)
		end
	end
end

return TreeWindow
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
			</Item>
		</Item>
	</Item>
	<Item class="Workspace" referent="RBX000144">
		<Properties>
			<string name="Name">Workspace</string>
			<bool name="StreamingEnabled">true</bool>
