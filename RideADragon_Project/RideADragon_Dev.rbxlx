-- water levels (RLE uint16 pairs count,value /64), 3D cave carves.
return {
	Grid = 8,
	Extent = 1152,
	N = 289,
	Materials = { "Grass", "LeafyGrass", "Ground", "Mud", "Sand", "Rock", "Slate", "Snow", "Cobblestone", "Limestone", "Basalt" },
	SubMaterials = { "Rock", "Rock", "Ground", "Ground", "Sand", "Rock", "Slate", "Rock", "Ground", "Limestone", "Basalt" },
	Colors = {
		Grass = { 92, 124, 64 },
		LeafyGrass = { 78, 108, 54 },
		Ground = { 118, 98, 72 },
		Mud = { 82, 66, 50 },
