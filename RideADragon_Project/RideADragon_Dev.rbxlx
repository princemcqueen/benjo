local TEX = {
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
}

local function seq(points: { { number } }): NumberSequence
	local kps = {}
	for _, p in points do
		table.insert(kps, NumberSequenceKeypoint.new(p[1], p[2]))
	end
	return NumberSequence.new(kps)
end

local RAINBOW_SEQ = ColorSequence.new({
	ColorSequenceKeypoint.new(0, C3(255, 90, 90)),
	ColorSequenceKeypoint.new(0.2, C3(255, 200, 60)),
	ColorSequenceKeypoint.new(0.4, C3(120, 255, 100)),
	ColorSequenceKeypoint.new(0.6, C3(80, 200, 255)),
	ColorSequenceKeypoint.new(0.8, C3(170, 110, 255)),
	ColorSequenceKeypoint.new(1, C3(255, 110, 200)),
})

local function emitter(c, spec)
	local host = c.Bones.Body
	local S = c.S
	local k = c:detail("High") and 1 or 0.5
	local e = Instance.new("ParticleEmitter")
	e.Name = "MutationFx"
	e.Color = spec.Rainbow and RAINBOW_SEQ or ColorSequence.new(spec.Color or Color3.new(1, 1, 1))
	e.LightEmission = 1
	e.LightInfluence = 0
	e.SpreadAngle = Vector2.new(180, 180)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-60, 60)
	if spec.Kind == "Sparkle" then
		e.Texture = TEX.Sparkle
		e.Rate = 10 * k
		e.Lifetime = NumberRange.new(0.8, 1.5)
		e.Speed = NumberRange.new(0.5, 2)
		e.Drag = 2
		e.Size = seq({ { 0, 0 }, { 0.3, 0.7 * S }, { 1, 0 } })
	elseif spec.Kind == "Snow" then
		e.Texture = TEX.Sparkle
		e.Rate = 9 * k
		e.Lifetime = NumberRange.new(1.8, 2.8)
		e.Speed = NumberRange.new(0.3, 1)
		e.Acceleration = Vector3.new(0, -2.5, 0)
		e.Size = seq({ { 0, 0.35 * S }, { 1, 0.15 * S } })
		e.Transparency = seq({ { 0, 0.1 }, { 0.8, 0.3 }, { 1, 1 } })
	elseif spec.Kind == "Bubbles" then
		e.Texture = TEX.Sparkle
		e.Rate = 8 * k
		e.Lifetime = NumberRange.new(1, 1.8)
		e.Speed = NumberRange.new(0.5, 1.5)
		e.Acceleration = Vector3.new(0, 3, 0)
		e.Size = seq({ { 0, 0.2 * S }, { 0.6, 0.55 * S }, { 1, 0 } })
		e.Transparency = seq({ { 0, 0.2 }, { 1, 0.6 } })
	elseif spec.Kind == "Fire" then
		e.Texture = TEX.Fire
		e.Rate = 16 * k
		e.Lifetime = NumberRange.new(0.5, 0.9)
		e.Speed = NumberRange.new(1, 3)
		e.SpreadAngle = Vector2.new(25, 25)
		e.Acceleration = Vector3.new(0, 7, 0)
		e.Color = ColorSequence.new(C3(255, 200, 80), C3(255, 70, 20))
		e.Size = seq({ { 0, 1.0 * S }, { 1, 0.1 * S } })
		e.Transparency = seq({ { 0, 0.3 }, { 1, 1 } })
	elseif spec.Kind == "Smoke" then
		e.Texture = TEX.Smoke
		e.Rate = 5 * k
		e.Lifetime = NumberRange.new(1.5, 2.5)
		e.Speed = NumberRange.new(0.3, 1)
		e.Acceleration = Vector3.new(0, 1.2, 0)
		e.LightEmission = 0.2
		e.Size = seq({ { 0, 1.0 * S }, { 1, 2.6 * S } })
		e.Transparency = seq({ { 0, 0.55 }, { 1, 1 } })
	elseif spec.Kind == "Embers" then
		-- glowing sparks drifting up (Infernal)
		e.Texture = TEX.Sparkle
		e.Rate = 14 * k
		e.Lifetime = NumberRange.new(1.2, 2.2)
		e.Speed = NumberRange.new(2, 5)
		e.SpreadAngle = Vector2.new(40, 40)
		e.Acceleration = Vector3.new(0, 6, 0)
		e.Color = ColorSequence.new(C3(255, 200, 80), C3(255, 70, 20))
		e.Size = seq({ { 0, 0.4 * S }, { 1, 0 } })
		e.Transparency = seq({ { 0, 0 }, { 0.7, 0.3 }, { 1, 1 } })
	elseif spec.Kind == "Glitch" then
		-- flickering static blocks (Corrupted): magenta, cyan and black in fast succession
		e.Texture = TEX.Sparkle
		e.Rate = 26 * k
		e.Lifetime = NumberRange.new(0.2, 0.45)
		e.Speed = NumberRange.new(0, 3)
		e.RotSpeed = NumberRange.new(-400, 400)
		e.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, C3(255, 30, 160)),
			ColorSequenceKeypoint.new(0.5, C3(40, 240, 255)),
			ColorSequenceKeypoint.new(1, C3(20, 0, 30)),
		})
		e.Size = seq({ { 0, 0.55 * S }, { 0.5, 0.3 * S }, { 1, 0.7 * S } })
		e.Shape = Enum.ParticleEmitterShape.Box
	elseif spec.Kind == "Zap" then
		-- fast, short-lived electric sparks (Lightning)
		e.Texture = TEX.Sparkle
		e.Rate = 34 * k
		e.Lifetime = NumberRange.new(0.12, 0.28)
		e.Speed = NumberRange.new(12, 26)
		e.Drag = 0
		e.Size = seq({ { 0, 0.45 * S }, { 1, 0 } })
		e.Transparency = seq({ { 0, 0 }, { 1, 0.6 } })
	elseif spec.Kind == "Feathers" then
		-- white feathers floating down (Angelic)
		e.Texture = TEX.Sparkle
		e.Rate = 5 * k
		e.Lifetime = NumberRange.new(2.4, 3.4)
		e.Speed = NumberRange.new(0.3, 1)
		e.Acceleration = Vector3.new(0, -1.6, 0)
		e.LightEmission = 0.5
		e.RotSpeed = NumberRange.new(-120, 120)
		e.Color = ColorSequence.new(Color3.new(1, 1, 1))
		e.Size = seq({ { 0, 0.55 * S }, { 1, 0.4 * S } })
		e.Transparency = seq({ { 0, 0.1 }, { 0.7, 0.3 }, { 1, 1 } })
		e.Shape = Enum.ParticleEmitterShape.Box
	end
	e.Parent = host
	return e
end

local function rainbowColors(c)
	local zmin, zmax, xmax = math.huge, -math.huge, 1
	for part, cf in c.Build do
		if part ~= c.Bones.Root then
			local p = cf.Position
			zmin = math.min(zmin, p.Z)
			zmax = math.max(zmax, p.Z)
			if part.Name == "Membrane" then
				xmax = math.max(xmax, math.abs(p.X))
			end
		end
	end
	local span = math.max(1, zmax - zmin)
	for part, cf in c.Build do
		local role = roleOf(part.Name)
		local t = (cf.Position.Z - zmin) / span
		local h = (t * 0.85) % 1
		if role == "Main" then
			part.Color = Color3.fromHSV(h, 0.62, 1)
		elseif role == "Dark" then
			part.Color = Color3.fromHSV(h, 0.85, 0.82)
		elseif role == "Accent" or role == "Glow" then
			part.Color = Color3.fromHSV((h + 0.4) % 1, 0.7, 1)
		elseif role == "Membrane" then
			part.Color = Color3.fromHSV((math.abs(cf.Position.X) / xmax * 0.8) % 1, 0.5, 1)
		end
	end
end

local function applyFx(c, mutation: string?)
	if c.Statue then
		return
	end
	if c.Features.Aura and c:detail("Medium") then
		for _, spec in AURA_SPECS do
			emitter(c, spec)
		end
	end
	if c.BondAura and c:detail("Medium") then
		for _, spec in BOND_AURA_SPECS do
			local e = emitter(c, spec)
			e.Name = "BondAura"
			e.Rate *= 1.6
		end
		local glow = Instance.new("PointLight")
		glow.Name = "BondGlow"
		glow.Color = Color3.fromRGB(255, 214, 140)
		glow.Range = 16 * c.S
		glow.Brightness = 1.1
		glow.Shadows = false
		glow.Parent = c.Bones.Body
	end
	local shine = c.Brick.Shine
	local fx = mutation and MUTATION_FX[mutation]
	if not fx and not shine then
		return
	end
	if fx and fx.Stars and not c.Features.Stars then
		FEATURES.Stars(c, nil, fx.Stars)
	end
	if fx and fx.Rainbow then
		rainbowColors(c)
	end
	for part in c.Build do
		local role = roleOf(part.Name)
		if role then
			if shine and (role == "Main" or role == "Dark" or role == "Horn") then
				part.Reflectance = shine
			end
			if fx then
				if fx.Reflect and fx.Reflect[role] then
					part.Reflectance = fx.Reflect[role]
				end
				if fx.Glass and fx.Glass[role] then
					glassy(part, 0.15)
				end
				if fx.Neon and fx.Neon[role] then
					neon(part)
				end
			end
		end
	end
	if fx and fx.Particles and c:detail("Medium") then
		for _, spec in fx.Particles do
			emitter(c, spec)
		end
	end
	if fx and fx.Light and c:detail("Medium") then
		-- the dragon lights up its surroundings in its mutation colour
		local light = Instance.new("PointLight")
		light.Name = "MutationLight"
		light.Color = fx.Light.Color
		light.Range = fx.Light.Range * c.S
		light.Brightness = fx.Light.Brightness
		light.Shadows = false
		light.Parent = c.Bones.Body
	end
	if fx and fx.Trail and c:detail("Medium") then
		-- ribbons of light behind both wing tips (only visible while the wings move)
		for _, side in { "L", "R" } do
			local tip = c.Bones["Wing" .. side .. "3"]
			local a0 = tip and tip:FindFirstChild("WingTip" .. side)
			local a1 = tip and tip:FindFirstChild("WingTipInner" .. side)
			if a0 and a1 then
				local trail = Instance.new("Trail")
				trail.Name = "MutationTrail"
				trail.Attachment0 = a0
				trail.Attachment1 = a1
				trail.Color = ColorSequence.new(fx.Trail.Color, fx.Trail.Color2)
				trail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
				trail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.1) })
				trail.Lifetime = 0.6
				trail.MinLength = 0.05
				trail.LightEmission = 1
				trail.LightInfluence = 0
				trail.FaceCamera = true
				trail.Parent = tip
			end
		end
	end
end

-- ============================================================== public
local function buildRoot(c, existing: BasePart?)
	local root = existing
	if root then
		c.Build[root] = CFrame.identity
	else
		root = require(script.Parent:WaitForChild("Builder")).makeRoot(c.SpeciesId, c.ScaleOverride)
		c.Build[root] = CFrame.identity
		root.Parent = c.Model
		c.Model.PrimaryPart = root
	end
	c.Bones.Root = root
	c.Model:SetAttribute("HipHeight", c.Def.HipHeight * c.S)
end

function BrickBuilder.build(speciesId: string, opts: { [string]: any }?)
	local o = table.clone(opts or {})
	o.SpeciesId = speciesId
	local def = Species.get(speciesId)
	local c = newCtx(def, o)
	if o.Mutation and o.Mutation ~= "None" then
		c.Palette = Species.mutatePalette(def.Palette, o.Mutation)
	end
	if o.Statue then
		c.Palette = Species.statuePalette(o.StatueColor)
	end
	local mfx = o.Mutation and MUTATION_FX[o.Mutation]
	if mfx and mfx.Features then
		for _, f in mfx.Features do
			-- (a mutation's crystals replace the spines like the species' own do)
			c.MutationFeatures = c.MutationFeatures or {}
			c.MutationFeatures[f] = not c.Features[f]
			c.Features[f] = true
		end
	end
	buildRoot(c, o.Root)
	buildTorso(c)
	local neckEnd = buildNeck(c)
	local head = buildHead(c, neckEnd)
	buildHorns(c, head)
	buildTail(c)
	buildLegs(c)
	buildWings(c)
	if not (c.Features.BackFlames or c.Features.Crystals) then
		buildSpines(c)
	end
	if not o.Statue and o.Saddle ~= false then
		buildSaddle(c)
	end
	for _, feature in def.Features or {} do
		local fn = FEATURES[feature]
		if fn then
			fn(c, head)
		end
	end
	-- features the mutation brings along (halo, crystals) unless the species has them already
	for feature, extra in c.MutationFeatures or {} do
		local fn = FEATURES[feature]
		if fn and extra then
			fn(c, head)
		end
	end
	applyFx(c, o.Mutation)
	c:attach("Jaw", "Mouth", head.Skull + head.Fwd * (2.6 * head.Hs * c.S) + head.Up * (-0.5 * head.Hs * c.S))
	local model = c.Model
	model.Name = def.Name or speciesId
	model:SetAttribute("SpeciesId", speciesId)
	model:SetAttribute("Scale", c.S)
	model:SetAttribute("BodyRadius", (def.BodyRadius or 4.2) * c.S)
	model:SetAttribute("Parts", c.PartCount)
	model:SetAttribute("Rig", def.Rig or "Quadruped")
	model:SetAttribute("Style", "Brick")
	if o.Mutation then
		model:SetAttribute("Mutation", o.Mutation)
	end
	return model
end

return BrickBuilder
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000008">
					<Properties>
						<string name="Name">Builder</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Dragon Builder
	Parametric, code-built dragons with a Motor6D skeleton.

	build(speciesId, { Mutation, Detail = "High"|"Medium"|"Low", Statue = bool,
	                   Material = Enum.Material? }) -> Model

	Model layout:
	  Root (invisible physics body, PrimaryPart)
	    Motor6D chain: Body, Chest, Pelvis, Neck1..n, Head, Jaw, Tail1..n,
	    ArmL1/2/HandL (+R), LegL1/2/FootL (+R), WingL1/2/3 (+R)
	  Decorations are Welded to their bone.
	  Seat "Saddle" welded to Body (riders sit here).

	All joints use model-aligned pivot frames so animation rotations are
	authored in a consistent space: X = pitch, Y = yaw, Z = roll.
	Coordinates are authored for scale 1 (Green Drake) and multiplied by the
	species Scale.
]]

local Primitives = require(script.Parent:WaitForChild("Primitives"))
local Species = require(script.Parent:WaitForChild("Species"))
local Membranes = require(script.Parent:WaitForChild("Membranes"))

local Builder = {}

local V3 = Vector3.new
local rad = math.rad

-- ============================================================== context
local Ctx = {}
Ctx.__index = Ctx

local function newCtx(def, opts)
	local self = setmetatable({}, Ctx)
	self.Def = def
	self.S = (def.Scale or 1) * (opts.ScaleOverride or 1)
	self.ScaleOverride = opts.ScaleOverride or 1
	self.SpeciesId = opts.SpeciesId or "GreenDrake"
	self.Detail = opts.Detail or "High"
	self.Statue = opts.Statue == true
	self.Palette = def.Palette
	self.Model = Instance.new("Model")
	self.Bones = {}
	self.Build = {} -- [part] = build-space CFrame (root at the origin)
	self.PartCount = 0
	self.Material = opts.Material
	return self
end

function Ctx:v(x: number, y: number, z: number): Vector3
	return V3(x * self.S, y * self.S, z * self.S)
end

function Ctx:sc(v: Vector3): Vector3
	return v * self.S
end

function Ctx:color(key: string | Color3): Color3
	if typeof(key) == "Color3" then
		return key
	end
	return self.Palette[key] or self.Palette.Main
end

function Ctx:mat(key: string?): Enum.Material
	if self.Material then
		return self.Material
	end
	if key then
		local m = self.Def.Materials and self.Def.Materials[key]
		if m then
			return m
		end
	end
	return Enum.Material.SmoothPlastic
end

function Ctx:detail(minLevel: string): boolean
	local order = { Low = 1, Medium = 2, High = 3 }
	return order[self.Detail] >= order[minLevel]
end

function Ctx:add(part: BasePart, name: string?): BasePart
	part.Name = name or part.Name
	if self.Build[part] == nil then
		self.Build[part] = part.CFrame
	end
	part.Parent = self.Model
	self.PartCount += 1
	return part
end

-- Bone: a visible part that animation joints drive.
function Ctx:bone(name: string, part: BasePart, parentName: string, pivot: Vector3)
	self:add(part, name)
	self.Bones[name] = part
	local parent = self.Bones[parentName]
	assert(parent, "missing parent bone " .. parentName)
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = parent
	m.Part1 = part
	local pivotCF = CFrame.new(pivot)
	m.C0 = self.Build[parent]:ToObjectSpace(pivotCF)
	m.C1 = self.Build[part]:ToObjectSpace(pivotCF)
	m.Parent = part
	return part
end

-- Decoration welded to a bone.
function Ctx:deco(boneName: string, part: BasePart, name: string?): BasePart
	self:add(part, name or "Deco")
	local bone = self.Bones[boneName]
	local w = Instance.new("Weld")
	w.Name = "Weld"
	w.Part0 = bone
	w.Part1 = part
	w.C0 = self.Build[bone]:ToObjectSpace(self.Build[part])
	w.Parent = part
	return part
end

function Ctx:decoMany(boneName: string, parts: { BasePart }, name: string?)
	for _, p in parts do
		self:deco(boneName, p, name)
	end
end

function Ctx:attach(boneName: string, name: string, worldPos: Vector3)
	local bone = self.Bones[boneName]
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = self.Build[bone]:ToObjectSpace(CFrame.new(worldPos))
	a.Parent = bone
	return a
end

local E = Primitives.ellipsoid
local EB = Primitives.ellipsoidBetween

-- ============================================================== body parts
local function buildTorso(c)
	local d = c.Def.Body
	local L, W, H = d.Length, d.Width, d.Height
	local cs, hs = d.ChestScale or 1.05, d.HipScale or 0.9
	c:bone("Body", E(c:v(W, H, L), CFrame.new(c:v(0, 0.1, 0.4)), c:color("Main"), c:mat("Main")), "Root", c:v(0, 0.1, 0.4))
	c:bone("Chest", E(c:v(W * cs, H * cs, L * 0.6), CFrame.new(c:v(0, 0.35, -L * 0.36)), c:color("Main"), c:mat("Main")), "Body", c:v(0, 0.3, -L * 0.2))
	c:bone("Pelvis", E(c:v(W * hs, H * hs, L * 0.55), CFrame.new(c:v(0, 0.2, L * 0.43)), c:color("Main"), c:mat("Main")), "Body", c:v(0, 0.2, L * 0.3))
	-- belly plates (lighter underside)
	c:deco("Body", E(c:v(W * 0.74, H * 0.42, L * 0.86), CFrame.new(c:v(0, -H * 0.27, 0.3)), c:color("Belly"), c:mat("Belly")), "Belly")
	c:deco("Chest", E(c:v(W * 0.72, H * 0.62, L * 0.44), CFrame.new(c:v(0, -H * 0.12, -L * 0.48)), c:color("Belly"), c:mat("Belly")), "Belly")
	-- darker back ridge for depth
	if c:detail("Medium") then
		c:deco("Body", E(c:v(W * 0.55, H * 0.35, L * 0.92), CFrame.new(c:v(0, H * 0.36, 0.3)), c:color("Dark"), c:mat("Main")), "Ridge")
	end
end

local function neckPoints(c)
	local d = c.Def.Neck
	local pts = {}
	local L = c.Def.Body.Length
	local p = V3(0, 0.9 + (d.BaseRaise or 0), -L * 0.56)
	pts[1] = p
	local n = d.Segments
	local segLen = d.Length / n
	for i = 1, n do
		local a = rad(d.Rise + (i - 1) * (d.Curve or 8))
		local dir = V3(0, math.sin(a), -math.cos(a))
		p = p + dir * segLen
		pts[i + 1] = p
	end
	return pts
end

local function buildNeck(c)
	local d = c.Def.Neck
	local pts = neckPoints(c)
	local parent = "Chest"
	for i = 1, d.Segments do
		local t = (i - 1) / math.max(1, d.Segments - 1)
		local th = d.Thickness * (1 - (1 - (d.Taper or 0.75)) * t)
		local a, b = c:sc(pts[i]), c:sc(pts[i + 1])
		local name = "Neck" .. i
		c:bone(name, EB(a, b, th * c.S, th * c.S * 0.98, c:color("Main"), c:mat("Main"), 1.6), parent, a)
		-- joint filler keeps the neck continuous while it bends
		c:deco(name, Primitives.ball(th * 0.98 * c.S, CFrame.new(a), c:color("Main"), c:mat("Main")), "NeckJoint")
		-- throat plate
		c:deco(name, EB(a + V3(0, -th * 0.28 * c.S, -0.1 * c.S), b + V3(0, -th * 0.28 * c.S, -0.1 * c.S), th * 0.62 * c.S, th * 0.5 * c.S, c:color("Belly"), c:mat("Belly"), 1.2), "Throat")
		parent = name
	end
	return pts[#pts]
end

local function buildHead(c, neckEnd: Vector3)
	local d = c.Def.Head
	local hs = d.Size or 1
	local S = c.S
	local base = neckEnd * S
	local tilt = rad(d.Tilt or -8)
	local fwd = V3(0, math.sin(tilt), -math.cos(tilt))
	local up = V3(0, math.cos(tilt), math.sin(tilt))
	local skullC = base + fwd * (0.95 * hs * S) + up * (0.25 * hs * S)
	local skullCF = CFrame.lookAt(skullC, skullC + fwd, up)
	local skullSize = V3(2.5, 2.1, 2.8) * hs * S * (d.SkullScale or 1)
	c:bone("Head", E(skullSize, skullCF, c:color("Main"), c:mat("Main")), "Neck" .. c.Def.Neck.Segments, base)

	local snoutLen = (d.Snout or 1) * 2.6 * hs * S
	local snoutC = skullC + fwd * (1.45 * hs * S + snoutLen * 0.18) + up * (-0.28 * hs * S)
	c:deco("Head", E(V3(1.75 * hs * S * (d.SnoutWidth or 1), 1.28 * hs * S, snoutLen), CFrame.lookAt(snoutC, snoutC + fwd, up), c:color("Main"), c:mat("Main")), "Snout")
	-- upper lip / nose bridge in darker tone
	c:deco("Head", E(V3(1.1 * hs * S, 0.7 * hs * S, snoutLen * 0.8), CFrame.lookAt(snoutC + up * 0.42 * hs * S, snoutC + up * 0.42 * hs * S + fwd, up), c:color("Dark"), c:mat("Main")), "Bridge")

	-- jaw (separate bone for roar / eat)
	local hinge = skullC + up * (-0.6 * hs * S) + fwd * (-0.1 * hs * S)
	local jawC = hinge + fwd * (1.35 * hs * S) + up * (-0.22 * hs * S)
	c:bone("Jaw", E(V3(1.45 * hs * S, 0.62 * hs * S, 2.5 * hs * S * (d.Snout or 1)), CFrame.lookAt(jawC, jawC + fwd, up), c:color("Belly"), c:mat("Belly")), "Head", hinge)
	if c:detail("Medium") then
		-- teeth
		for _, side in { -1, 1 } do
			for i = 0, 1 do
				local tp = snoutC + fwd * ((0.4 - i * 0.7) * hs * S) + up * (-0.62 * hs * S) + V3(side * 0.55 * hs * S, 0, 0)
				c:deco("Head", Primitives.spike(tp, tp + up * (-0.32 * hs * S), 0.18 * hs * S, 0.12 * hs * S, c:color("Tooth")), "Tooth")
			end
		end
	end

	-- eyes: amber glow + slit pupil + brow ridge
	for _, side in { -1, 1 } do
		local eyeC = skullC + up * (0.36 * hs * S) + fwd * (0.62 * hs * S) + V3(side * 0.86 * hs * S * (d.EyeSpread or 1), 0, 0)
		local eyeCF = CFrame.lookAt(eyeC, eyeC + V3(side, 0, 0) + fwd * 0.6, up)
		c:deco("Head", E(V3(0.62, 0.52, 0.3) * hs * S, eyeCF, c:color("Eye"), Enum.Material.Neon), "Eye")
		if c:detail("Medium") then
			c:deco("Head", Primitives.block(V3(0.07, 0.4, 0.1) * hs * S, eyeCF * CFrame.new(0, 0, -0.1 * hs * S), c:color("Pupil")), "Pupil")
		end
		local browC = eyeC + up * (0.3 * hs * S) + fwd * (-0.05 * hs * S)
		c:deco("Head", E(V3(0.5, 0.36, 1.2) * hs * S, CFrame.lookAt(browC, browC + fwd, up) * CFrame.Angles(0, 0, rad(side * 18)), c:color("Dark"), c:mat("Main")), "Brow")
		if c:detail("High") then
			local nos = snoutC + fwd * (snoutLen * 0.44) + up * (0.32 * hs * S) + V3(side * 0.34 * hs * S, 0, 0)
			c:deco("Head", Primitives.ball(0.24 * hs * S, CFrame.new(nos), c:color("Pupil")), "Nostril")
		end
	end
	return { Skull = skullC, Fwd = fwd, Up = up, Hs = hs }
end

local function buildHorns(c, head)
	local d = c.Def.Head
	local style = d.Horns or "Swept"
	local S, hs = c.S, head.Hs
	local fwd, up = head.Fwd, head.Up
	if style == "None" then
		return
	end
	for _, side in { -1, 1 } do
		local root = head.Skull + up * (0.82 * hs * S) + fwd * (-0.55 * hs * S) + V3(side * 0.62 * hs * S, 0, 0)
		local segs
		if style == "Swept" then
			segs = { V3(side * 0.25, 0.55, 1.15), V3(side * 0.12, 0.35, 1.0) }
		elseif style == "Long" then
			segs = { V3(side * 0.2, 0.7, 1.3), V3(side * 0.15, 0.45, 1.4), V3(side * 0.05, 0.2, 1.1) }
		elseif style == "Ram" then
			segs = { V3(side * 0.6, 0.45, 0.6), V3(side * 0.35, -0.6, 0.55), V3(side * -0.1, -0.5, -0.4) }
		elseif style == "Crown" then
			segs = { V3(side * 0.35, 1.0, 0.35), V3(side * 0.25, 0.9, 0.5) }
		else
			segs = { V3(side * 0.25, 0.55, 1.15), V3(side * 0.12, 0.35, 1.0) }
		end
		local p = root
		local thick = (d.HornThickness or 0.55) * hs * S
		for _, seg in segs do
			local dv = (fwd * -seg.Z + up * seg.Y + V3(seg.X, 0, 0)) * hs * S * (d.HornLength or 1)
			local q = p + dv
			c:deco("Head", EB(p, q, thick, thick, c:color("Horn"), c:mat("Horn"), 1.3), "Horn")
			thick *= 0.62
			p = q
		end
		c:deco("Head", EB(p - (p - root).Unit * thick * 0.5, p + (p - root).Unit * thick * 1.6, thick, thick, c:color("Horn"), c:mat("Horn"), 1.0), "HornTip")
	end
	-- small cheek frills
	if c:detail("Medium") and (d.Frills ~= false) then
		for _, side in { -1, 1 } do
			local fc = head.Skull + up * (-0.05 * hs * S) + fwd * (-0.75 * hs * S) + V3(side * 1.05 * hs * S, 0, 0)
			c:deco("Head", Primitives.spike(fc, fc + V3(side * 0.6 * hs * S, 0.1 * hs * S, 0) + fwd * (-0.6 * hs * S), 0.5 * hs * S, 0.12 * hs * S, c:color("Accent")), "Frill")
		end
	end
end

local function tailPoints(c)
	local d = c.Def.Tail
	local L = c.Def.Body.Length
	local pts = { V3(0, 0.25, L * 0.62) }
	local n = d.Segments
	local segLen = d.Length / n
	local p = pts[1]
	for i = 1, n do
		local t = (i - 1) / math.max(1, n - 1)
		local droop = rad((d.Droop or 8) * (1 - t) + (d.Lift or 0) * t)
		local dir = V3(0, -math.sin(droop), math.cos(droop))
		p = p + dir * segLen
		pts[i + 1] = p
	end
	return pts
end

local function buildTail(c)
	local d = c.Def.Tail
	local pts = tailPoints(c)
	local parent = "Pelvis"
	local n = d.Segments
	for i = 1, n do
		local t = (i - 1) / math.max(1, n - 1)
		local th = d.Thickness * (1 - (1 - (d.Taper or 0.3)) * t)
		local a, b = c:sc(pts[i]), c:sc(pts[i + 1])
		local name = "Tail" .. i
		c:bone(name, EB(a, b, th * c.S, th * 0.92 * c.S, c:color("Main"), c:mat("Main"), 1.55), parent, a)
		if i > 1 then
			c:deco(name, E(V3(th, th * 0.92, th) * c.S, CFrame.new(a), c:color("Main"), c:mat("Main")), "TailJoint")
		end
		if c:detail("Medium") then
			c:deco(name, EB(a + V3(0, -th * 0.3 * c.S, 0), b + V3(0, -th * 0.3 * c.S, 0), th * 0.6 * c.S, th * 0.45 * c.S, c:color("Belly"), c:mat("Belly"), 1.2), "TailBelly")
		end
		parent = name
	end
	-- tip
	local last = "Tail" .. n
	local e = c:sc(pts[n + 1])
	local tip = d.Tip or "Spade"
	local S = c.S
	if tip == "Spade" then
		local back = e + V3(0, 0, 1.35 * S)
		local l = e + V3(-0.78 * S, 0, 0.3 * S)
		local r = e + V3(0.78 * S, 0, 0.3 * S)
		local f = e + V3(0, 0, -0.75 * S)
		c:decoMany(last, Primitives.triangle(f, l, back, 0.16 * S, c:color("Dark")), "TailTip")
		c:decoMany(last, Primitives.triangle(f, r, back, 0.16 * S, c:color("Dark")), "TailTip")
	elseif tip == "Club" then
		c:deco(last, E(V3(1.6, 1.3, 2.0) * S, CFrame.new(e + V3(0, 0, 0.6 * S)), c:color("Horn"), c:mat("Horn")), "TailClub")
		for _, a in { 0, 120, 240 } do
			local o = V3(math.cos(rad(a)) * 0.6, math.sin(rad(a)) * 0.6 + 0.2, 0.5) * S
			c:deco(last, Primitives.spike(e + o, e + o * 2.1 + V3(0, 0, 0.4 * S), 0.4 * S, 0.3 * S, c:color("Horn")), "TailSpike")
		end
	elseif tip == "Fin" then
		local back = e + V3(0, 0, 2.2 * S)
		c:decoMany(last, Primitives.triangle(e + V3(0, 0, -0.6 * S), e + V3(0, 1.6 * S, 0.6 * S), back, 0.14 * S, c:color("Membrane")), "TailFin")
		c:decoMany(last, Primitives.triangle(e + V3(0, 0, -0.6 * S), e + V3(0, -1.3 * S, 0.6 * S), back, 0.14 * S, c:color("Membrane")), "TailFin")
	elseif tip == "Leaf" then
		local back = e + V3(0, 0, 2.4 * S)
		c:decoMany(last, Primitives.triangle(e + V3(0, 0, -0.4 * S), e + V3(-0.9 * S, 0.1 * S, 0.9 * S), back, 0.12 * S, c:color("Accent")), "TailLeaf")
		c:decoMany(last, Primitives.triangle(e + V3(0, 0, -0.4 * S), e + V3(0.9 * S, 0.1 * S, 0.9 * S), back, 0.12 * S, c:color("Accent")), "TailLeaf")
	elseif tip == "Crystal" then
		for i, o in { V3(0, 0.3, 0.8), V3(-0.5, 0.1, 0.5), V3(0.5, 0.1, 0.5) } do
			local base = e + o * S
			c:deco(last, Primitives.spike(base, base + V3(o.X * 1.2, 1.2 + (i == 1 and 0.6 or 0), 0.9) * S, 0.5 * S, 0.45 * S, c:color("Crystal"), Enum.Material.Glass), "Crystal")
		end
	elseif tip == "Flame" then
		c:deco(last, E(V3(1.0, 1.0, 1.6) * S, CFrame.new(e + V3(0, 0, 0.5 * S)), c:color("Glow"), Enum.Material.Neon), "TailFlame")
	elseif tip == "Plume" then
		for i = -1, 1 do
			local back = e + V3(i * 0.7 * S, 0, 2.6 * S)
			c:decoMany(last, Primitives.triangle(e, e + V3(i * 1.2 * S, 0.2 * S, 1.2 * S), back, 0.12 * S, c:color(i == 0 and "Accent" or "Membrane")), "TailPlume")
		end
	end
	return pts
end

local function buildLegs(c)
	local d = c.Def.Legs
	local L = c.Def.Body.Length
	local hip = c.Def.HipHeight
	local thick = d.Thickness or 1
	local groundY = -hip
	local function foot(boneName, parentName, pivot: Vector3, center: Vector3, size: Vector3, sideName: string)
		c:bone(boneName, E(c:sc(size), CFrame.new(c:sc(center)), c:color("Dark"), c:mat("Main")), parentName, c:sc(pivot))
		if c:detail("High") then
			for i = -1, 1 do
				local cp = c:sc(center + V3(i * size.X * 0.32, -size.Y * 0.1, -size.Z * 0.45))
				c:deco(boneName, Primitives.spike(cp, cp + c:sc(V3(i * 0.06, -0.25, -0.55)), 0.22 * c.S, 0.18 * c.S, c:color("Claw")), "Claw")
			end
		end
		c:attach(boneName, "Foot" .. sideName, c:sc(center + V3(0, -size.Y * 0.5, 0)))
	end
	for _, side in { -1, 1 } do
		local sn = side < 0 and "L" or "R"
		if d.Front then
			local sh = V3(side * c.Def.Body.Width * 0.4, -0.2, -L * 0.36)
			local el = sh + V3(side * 0.15, -(hip * 0.45), 0.25)
			local wr = el + V3(0, -(hip * 0.4), -0.15)
			local fc = V3(wr.X, groundY + 0.35, wr.Z - 0.35)
			c:bone("Arm" .. sn .. "1", EB(c:sc(sh), c:sc(el), 1.35 * thick * c.S, 1.45 * thick * c.S, c:color("Main"), c:mat("Main"), 1.3), "Chest", c:sc(sh))
			c:bone("Arm" .. sn .. "2", EB(c:sc(el), c:sc(wr), 1.05 * thick * c.S, 1.05 * thick * c.S, c:color("Main"), c:mat("Main"), 1.3), "Arm" .. sn .. "1", c:sc(el))
			c:deco("Arm" .. sn .. "2", Primitives.ball(1.12 * thick * c.S, CFrame.new(c:sc(el)), c:color("Main"), c:mat("Main")), "Elbow")
			c:deco("Arm" .. sn .. "1", E(c:sc(V3(1.7 * thick, 1.9, 1.9 * thick)), CFrame.new(c:sc(sh + V3(side * 0.05, -0.35, 0))), c:color("Main"), c:mat("Main")), "Shoulder")
			foot("Hand" .. sn, "Arm" .. sn .. "2", wr, fc, V3(1.3 * thick, 0.7, 1.85 * thick), "F" .. sn)
		end
		if d.Back then
			local hp = V3(side * c.Def.Body.Width * 0.38, 0.1, L * 0.4)
			local kn = hp + V3(side * 0.25, -(hip * 0.4), -0.65)
			local an = kn + V3(0, -(hip * 0.45), 1.0)
			local fc = V3(an.X, groundY + 0.35, an.Z - 0.45)
			local thighC = (hp + kn) / 2 + V3(0, 0.2, 0.25)
			c:bone("Leg" .. sn .. "1", E(c:sc(V3(2.0 * thick, hip * 0.66, 2.6 * thick)), CFrame.lookAt(c:sc(thighC), c:sc(thighC + V3(0, 0, -1))) * CFrame.Angles(rad(-14), 0, 0), c:color("Main"), c:mat("Main")), "Pelvis", c:sc(hp))
			c:bone("Leg" .. sn .. "2", EB(c:sc(kn), c:sc(an), 1.08 * thick * c.S, 1.08 * thick * c.S, c:color("Main"), c:mat("Main"), 1.3), "Leg" .. sn .. "1", c:sc(kn))
			c:deco("Leg" .. sn .. "2", Primitives.ball(1.2 * thick * c.S, CFrame.new(c:sc(kn)), c:color("Main"), c:mat("Main")), "Knee")
			foot("Foot" .. sn, "Leg" .. sn .. "2", an, fc, V3(1.4 * thick, 0.72, 2.0 * thick), "B" .. sn)
		end
	end
end

-- Bat-style wing: 5-bone skeleton per side (humerus, forearm, hand + main
-- finger, finger 2, finger 3). Membranes are dynamic (see Membranes.luau):
-- thin wedge meshes re-stretched between anchor attachments, so the wing can
-- fold tightly against the body and flex through every wing beat.
local function buildWings(c)
	local d = c.Def.Wings
	if not d or d.Type == "None" then
		return
	end
	local span = d.Span or 13
	local chord = d.Chord or 5.5
	local L = c.Def.Body.Length
	local W = c.Def.Body.Width
	local S = c.S
	local k = span / 13
	local kc = chord / 5.5
	local boneCol = c:color(d.BoneColor or "Dark")
	local memColor = c:color("Membrane")
	local memMat = c:mat("Membrane")
	local depth = d.Type == "Tattered" and 0.42 or (d.Scallop or 0.2)
	local thickness = 0.14 * S
	c.Model:SetAttribute("WingType", d.Type or "Bat")
	c.Model:SetAttribute("MembraneScallop", depth)
	c.Model:SetAttribute("MembraneThickness", thickness)
	for _, side in { -1, 1 } do
		local sn = side < 0 and "L" or "R"
		local function m(x, y, z)
			return V3(side * x, y, z)
		end
		local sh = m(W * 0.36, 1.6, -L * 0.27)
		local el = sh + m(4.0 * k, 0.8 * k, 0.5 * k)
		local wr = el + m(4.2 * k, 0.5 * k, 1.2 * k)
		local f1 = wr + m(3.6 * k, -0.2 * k, 1.3 * kc)
		local f2 = wr + m(1.8 * k, -0.6 * k, 4.0 * kc)
		local f3 = wr + m(-1.6 * k, -0.9 * k, 5.3 * kc)
		local bodyAttach = m(W * 0.36, 1.0, L * 0.36)
		local n = "Wing" .. sn
		-- bones
		c:bone(n .. "1", EB(c:sc(sh), c:sc(el), 0.8 * S, 0.72 * S, boneCol, c:mat("Main"), 1.15), "Chest", c:sc(sh))
		c:bone(n .. "2", EB(c:sc(el), c:sc(wr), 0.62 * S, 0.56 * S, boneCol, c:mat("Main"), 1.12), n .. "1", c:sc(el))
		c:bone(n .. "3", EB(c:sc(wr), c:sc(f1), 0.36 * S, 0.32 * S, boneCol, c:mat("Main"), 1.05), n .. "2", c:sc(wr))
		c:bone(n .. "4", EB(c:sc(wr), c:sc(f2), 0.32 * S, 0.3 * S, boneCol, c:mat("Main"), 1.04), n .. "3", c:sc(wr))
		c:bone(n .. "5", EB(c:sc(wr), c:sc(f3), 0.3 * S, 0.28 * S, boneCol, c:mat("Main"), 1.04), n .. "3", c:sc(wr))
		-- joint knuckles keep the arm continuous while folding
		c:deco(n .. "2", Primitives.ball(0.7 * S, CFrame.new(c:sc(el)), boneCol, c:mat("Main")), "Knuckle")
		c:deco(n .. "3", Primitives.ball(0.56 * S, CFrame.new(c:sc(wr)), boneCol, c:mat("Main")), "Knuckle")
		-- wing thumb claw
		if c:detail("Medium") then
			c:deco(n .. "2", Primitives.spike(c:sc(wr), c:sc(wr + m(0.25, 0.35, -0.85)), 0.26 * S, 0.2 * S, c:color("Claw")), "WingClaw")
		end
		-- glowing veins (crystal / celestial variants)
		if d.Glow then
			c:deco(n .. "3", EB(c:sc(wr), c:sc(f1), 0.16 * S, 0.16 * S, c:color("Glow"), Enum.Material.Neon, 1.0), "Glow")
			c:deco(n .. "4", EB(c:sc(wr), c:sc(f2), 0.14 * S, 0.14 * S, c:color("Glow"), Enum.Material.Neon, 1.0), "Glow")
			c:deco(n .. "5", EB(c:sc(wr), c:sc(f3), 0.12 * S, 0.12 * S, c:color("Glow"), Enum.Material.Neon, 1.0), "Glow")
		end
		-- membrane anchor points
		c:attach(n .. "1", "MemS" .. sn, c:sc(sh + m(-0.1, -0.15, 0.25)))
		c:attach(n .. "2", "MemE" .. sn, c:sc(el))
		c:attach(n .. "3", "MemW" .. sn, c:sc(wr))
		c:attach(n .. "3", "MemF1" .. sn, c:sc(f1))
		c:attach(n .. "4", "MemF2" .. sn, c:sc(f2))
		c:attach(n .. "5", "MemF3" .. sn, c:sc(f3))
		c:attach("Body", "MemB" .. sn, c:sc(bodyAttach))
		-- trail attachments
		c:attach(n .. "3", "WingTip" .. sn, c:sc(f1))
		c:attach(n .. "3", "WingTipInner" .. sn, c:sc(f1 + (wr - f1) * 0.18))
		-- membranes at the rest (spread) pose
		local P = {
			S = c:sc(sh + m(-0.1, -0.15, 0.25)),
			E = c:sc(el),
			W = c:sc(wr),
			F1 = c:sc(f1),
			F2 = c:sc(f2),
			F3 = c:sc(f3),
			B = c:sc(bodyAttach),
		}
		Membranes.buildPieces(c.Bones.Root, sn, P, thickness, depth, memColor, memMat, function(part)
			c:add(part, "Membrane")
		end)
	end
end

local function buildSpines(c)
	local d = c.Def.Spines
	if not d or d.Style == "None" or not c:detail("Medium") then
		return
	end
	local S = c.S
	local h0 = d.Height or 0.9
	local col = c:color(d.Color or "Dark")
	local mat = d.Material
	local function spineOn(boneName: string, base: Vector3, height: number)
		local tip = base + V3(0, height, height * 0.55)
		if d.Style == "Crystal" then
			c:deco(boneName, Primitives.spike(base, base + V3(0, height * 1.3, height * 0.2), height * 0.7, height * 0.55, c:color("Crystal"), Enum.Material.Glass), "Spine")
		else
			c:deco(boneName, Primitives.spike(base, tip, height * 1.0, 0.22 * S, col, mat), "Spine")
		end
	end
	-- neck
	local npts = neckPoints(c)
	for i = 1, c.Def.Neck.Segments do
		local a, b = npts[i], npts[i + 1]
		local th = c.Def.Neck.Thickness
		local p = (a + b) / 2 + V3(0, th * 0.42, 0.1)
		spineOn("Neck" .. i, c:sc(p), h0 * 0.8 * S)
	end
	-- back
	local L = c.Def.Body.Length
	local H = c.Def.Body.Height
	for i, z in { -L * 0.32, -L * 0.08, L * 0.16, L * 0.4 } do
		if c:detail("High") or i % 2 == 1 then
			local bone = z < -L * 0.2 and "Chest" or (z > L * 0.3 and "Pelvis" or "Body")
			if not (c.Def.Saddle ~= false and z > -L * 0.3 and z < L * 0.05) then
				spineOn(bone, c:sc(V3(0, H * 0.48 + 0.15, z)), h0 * S)
			end
		end
	end
	-- tail
	local tpts = tailPoints(c)
	for i = 1, c.Def.Tail.Segments - 1 do
		local a, b = tpts[i], tpts[i + 1]
		local t = (i - 1) / math.max(1, c.Def.Tail.Segments - 1)
		local th = c.Def.Tail.Thickness * (1 - (1 - (c.Def.Tail.Taper or 0.3)) * t)
		spineOn("Tail" .. i, c:sc((a + b) / 2 + V3(0, th * 0.42, 0)), h0 * (1 - t * 0.6) * S)
	end
end

local function buildSaddle(c)
	if c.Def.Saddle == false then
		return
	end
	local H = c.Def.Body.Height
	local L = c.Def.Body.Length
	local y = H * 0.5 + 0.05
	local z = -L * 0.16
	local leather = Color3.fromRGB(96, 58, 34)
	local cloth = c.Palette.Saddle or Color3.fromRGB(150, 36, 40)
	local gold = Color3.fromRGB(214, 172, 86)
	if c:detail("Medium") then
		c:deco("Body", Primitives.block(c:sc(V3(c.Def.Body.Width * 0.95, 0.16, 3.0)), CFrame.new(c:sc(V3(0, y - 0.18, z))), cloth, Enum.Material.Fabric), "SaddleCloth")
		c:deco("Body", Primitives.block(c:sc(V3(c.Def.Body.Width * 0.97, 0.12, 0.18)), CFrame.new(c:sc(V3(0, y - 0.16, z - 1.45))), gold, Enum.Material.Metal), "SaddleTrim")
		c:deco("Body", Primitives.block(c:sc(V3(c.Def.Body.Width * 0.97, 0.12, 0.18)), CFrame.new(c:sc(V3(0, y - 0.16, z + 1.45))), gold, Enum.Material.Metal), "SaddleTrim")
	end
	c:deco("Body", E(c:sc(V3(2.4, 0.62, 2.8)), CFrame.new(c:sc(V3(0, y + 0.08, z))), leather, Enum.Material.Leather), "Saddle")
	c:deco("Body", E(c:sc(V3(1.1, 0.9, 0.7)), CFrame.new(c:sc(V3(0, y + 0.35, z - 1.2))), leather, Enum.Material.Leather), "Pommel")
	c:deco("Body", E(c:sc(V3(2.0, 0.8, 0.6)), CFrame.new(c:sc(V3(0, y + 0.3, z + 1.25))), leather, Enum.Material.Leather), "Cantle")
	-- riders are jointed to the physics root (see Builder.mountInfo); this
	-- attachment marks the saddle surface on the animated body
	c:attach("Body", "SaddlePoint", c:sc(V3(0, y + 0.2, z)))
end

-- Physics root shared by server and client: invisible, non-colliding body.
function Builder.makeRoot(speciesId: string, scaleOverride: number?): BasePart
	local def = Species.get(speciesId)
	local S = (def.Scale or 1) * (scaleOverride or 1)
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = V3(def.Body.Width * 0.7, 3, def.Body.Length * 0.8) * S
	root.CFrame = CFrame.new()
	root.Transparency = 1
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.Massless = false
	root.Anchored = false
	root.RootPriority = 127
	root.CastShadow = false
	local att = Instance.new("Attachment")
	att.Name = "RootAttachment"
	att.Parent = root
	return root
end

local function buildRoot(c, existing: BasePart?)
	local root = existing
	if root then
		c.Build[root] = CFrame.identity
	else
		root = Builder.makeRoot(c.SpeciesId, c.ScaleOverride)
		c.Build[root] = CFrame.identity
		root.Parent = c.Model
		c.Model.PrimaryPart = root
	end
	c.Bones.Root = root
	c.Model:SetAttribute("HipHeight", c.Def.HipHeight * c.S)
end

-- ============================================================== public
-- Mount/physics numbers for a species without building any instances
-- (used by the server, which only owns the physics root).
function Builder.mountInfo(speciesId: string, scaleOverride: number?)
	local def = Species.get(speciesId)
	local S = (def.Scale or 1) * (scaleOverride or 1)
	local H, L = def.Body.Height, def.Body.Length
	return {
		Scale = S,
		HipHeight = def.HipHeight * S,
		BodyRadius = (def.BodyRadius or 4.2) * S,
		RootSize = V3(def.Body.Width * 0.7, 3, L * 0.8) * S,
		-- saddle seat surface in root space (matches buildSaddle)
		Saddle = CFrame.new(0, (H * 0.5 + 0.05 + 0.36) * S, -L * 0.16 * S),
		Length = (L + def.Tail.Length + def.Neck.Length) * S,
		WingSpan = def.Wings and (def.Wings.Span or 13) * 2 * S or 0,
	}
end

function Builder.build(speciesId: string, opts: { [string]: any }?)
	local o = table.clone(opts or {})
	o.SpeciesId = speciesId
	local def = Species.get(speciesId)
	local c = newCtx(def, o)
	if o.Mutation and o.Mutation ~= "None" then
		c.Palette = Species.mutatePalette(def.Palette, o.Mutation)
	end
	if o.Statue then
		c.Palette = Species.statuePalette(o.StatueColor)
	end
	buildRoot(c, o.Root)
	buildTorso(c)
	local neckEnd = buildNeck(c)
	local head = buildHead(c, neckEnd)
	buildHorns(c, head)
	buildTail(c)
	buildLegs(c)
	buildWings(c)
	buildSpines(c)
	if not o.Statue and o.Saddle ~= false then
		buildSaddle(c)
	end
	-- mouth attachment for breath / roar FX
	c:attach("Jaw", "Mouth", head.Skull + head.Fwd * (2.6 * head.Hs * c.S) + head.Up * (-0.5 * head.Hs * c.S))
	if def.Features then
		for _, feature in def.Features do
			local fn = Species.FeatureBuilders[feature.Kind]
			if fn then
				fn(c, feature, head)
			end
		end
	end
	local model = c.Model
	model.Name = def.Name or speciesId
	model:SetAttribute("SpeciesId", speciesId)
	model:SetAttribute("Scale", c.S)
	model:SetAttribute("BodyRadius", (def.BodyRadius or 4.2) * c.S)
	model:SetAttribute("Parts", c.PartCount)
	model:SetAttribute("Rig", def.Rig or "Quadruped")
	if o.Mutation then
		model:SetAttribute("Mutation", o.Mutation)
	end
	return model
end

-- Static pose for previews, statues and ViewportFrames. Computes forward
-- kinematics from the joint data, anchors every part, removes the joints,
-- places the parts and stretches the wing membranes to match.
-- pose: { [jointName] = CFrame } (missing joints stay at rest).
function Builder.pose(model: Model, pose: { [string]: CFrame }?, rootCF: CFrame?)
	local root = model.PrimaryPart :: BasePart
	local rc = rootCF or root.CFrame
	local children: { [BasePart]: { any } } = {}
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") or d:IsA("Weld") then
			local j = d :: any
			if j.Part0 and j.Part1 then
				children[j.Part0] = children[j.Part0] or {}
				table.insert(children[j.Part0], j)
			end
		end
	end
	local cfs: { [BasePart]: CFrame } = { [root] = rc }
	local boneCF: { [string]: CFrame } = { Root = rc }
	local function walk(part: BasePart, depth: number)
		if depth > 64 then
			return
		end
		for _, j in children[part] or {} do
			local p1 = j.Part1
			if not cfs[p1] then
				local isBone = j:IsA("Motor6D") and j.Name ~= "MemJoint"
				local tr = (isBone and pose and pose[j.Name]) or CFrame.identity
				local cf = cfs[part] * j.C0 * tr * j.C1:Inverse()
				cfs[p1] = cf
				if isBone then
					boneCF[p1.Name] = cf
				end
				walk(p1, depth + 1)
			end
		end
	end
	walk(root, 0)
	Builder.freeze(model)
	for part, cf in cfs do
		part.CFrame = cf
	end
	Membranes.new(model):Solve(boneCF, true)
end
Builder.bakePose = Builder.pose

-- Anchors everything (for static displays inside ViewportFrames).
function Builder.freeze(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = true
		elseif d:IsA("JointInstance") then
			d:Destroy()
		end
	end
end

return Builder
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000009">
					<Properties>
						<string name="Name">DragonVisual</string>
						<ProtectedString name="Source"><![CDATA[--[[
	DragonVisual
	Creates the visual model for a dragon.

	Preferred: a skinned mesh template imported from Blender-style .glb files
	(one MeshPart + Bones, textures baked offline). Templates live in
	ReplicatedStorage.DragonModels.<SpeciesId>. When a species has no template
	yet, the procedural part-built dragon (Builder) is used instead, so the game
	always works.

	Mesh visuals:
	  * the MeshPart is welded to the server physics Root so that the template's
	    "Root" bone coincides with the Root (whatever offset/rotation the importer
	    gave the bone), which makes every bone's rest frame model-aligned;
	  * Animator drives Bone.Transform exactly like Motor6D.Transform;
	  * sockets (MemF1L, WingTipL, Mouth, SaddlePoint, ...) are Bones too, and a
	    Bone is an Attachment, so effects can use them directly.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Builder = require(script.Parent:WaitForChild("Builder"))
local BrickBuilder = require(script.Parent:WaitForChild("BrickBuilder"))
local Species = require(script.Parent:WaitForChild("Species"))

local DragonVisual = {}

local MUTATION_TINT = {
	Shiny = Color3.fromRGB(200, 240, 255),
	Golden = Color3.fromRGB(255, 214, 120),
	Shadow = Color3.fromRGB(120, 92, 170),
	Rainbow = Color3.fromRGB(255, 190, 235),
	Neon = Color3.fromRGB(160, 255, 240),
	Infernal = Color3.fromRGB(255, 130, 100),
	Corrupted = Color3.fromRGB(190, 90, 170),
	Crystal = Color3.fromRGB(205, 175, 255),
	Lightning = Color3.fromRGB(255, 244, 150),
	Angelic = Color3.fromRGB(255, 250, 235),
}

local function modelsFolder(): Instance?
	return ReplicatedStorage:FindFirstChild("DragonModels")
end

-- Finds the skinned MeshPart and its root bone inside a template/clone.
function DragonVisual.findRig(model: Instance): (MeshPart?, Bone?)
	for _, d in model:GetDescendants() do
		if d:IsA("MeshPart") then
			local root = d:FindFirstChild("Root")
			if root and root:IsA("Bone") then
				return d, root
			end
		end
	end
	return nil, nil
end

function DragonVisual.template(speciesId: string): Model?
	local folder = modelsFolder()
	local t = folder and folder:FindFirstChild(speciesId)
	if t and t:IsA("Model") then
		local mesh = DragonVisual.findRig(t)
		if mesh then
			return t
		end
	end
	return nil
end

function DragonVisual.hasMesh(speciesId: string): boolean
	return DragonVisual.template(speciesId) ~= nil
end

local function stripImporterExtras(model: Model)
	for _, d in model:GetDescendants() do
		if d:IsA("AnimationController") or d:IsA("Humanoid") or d:IsA("Animator") then
			d:Destroy()
		elseif d:IsA("Folder") and d.Name == "InitialPoses" then
			d:Destroy()
		elseif d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
end

local function applyMutation(mesh: MeshPart, mutation: string?)
	if not mutation or mutation == "None" then
		return
	end
	-- a pre-made SurfaceAppearance variant (Mutations/<id>) wins when present
	local variants = mesh:FindFirstChild("Mutations")
	local variant = variants and variants:FindFirstChild(mutation)
	if variant and variant:IsA("SurfaceAppearance") then
		local current = mesh:FindFirstChildWhichIsA("SurfaceAppearance")
		if current then
			current:Destroy()
		end
		variant:Clone().Parent = mesh
		return
	end
	local tint = MUTATION_TINT[mutation]
	if tint then
		local sa = mesh:FindFirstChildWhichIsA("SurfaceAppearance")
		if sa then
			pcall(function()
				(sa :: any).Color = tint
			end)
		else
			mesh.Color = tint
		end
	end
	if mutation == "Golden" then
		mesh.Reflectance = 0.06
	end
end

-- Attaches a cloned template to the physics root (rest pose aligned).
local function attachMesh(model: Model, mesh: MeshPart, rootBone: Bone, root: BasePart)
	mesh.Anchored = false
	mesh.CanCollide = false
	mesh.CanQuery = false
	mesh.CanTouch = false
	mesh.Massless = true
	mesh.CastShadow = true
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d ~= mesh then
			d.Anchored = false
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
			d.Massless = true
		end
	end
	local weld = Instance.new("Weld")
	weld.Name = "RootWeld"
	weld.Part0 = root
	weld.Part1 = mesh
	weld.C0 = rootBone.CFrame:Inverse()
	weld.C1 = CFrame.identity
	weld.Parent = mesh
	mesh.CFrame = root.CFrame * weld.C0
end

-- Rest position of a bone relative to the template's Root bone.
local function restPos(bone: Instance): Vector3
	local cf = CFrame.identity
	local b: Instance? = bone
	while b and b:IsA("Bone") and b.Name ~= "Root" do
		cf = (b :: Bone).CFrame * cf
		b = b.Parent
	end
	return cf.Position
end

local warned: { [string]: boolean } = {}
local function checkOrientation(speciesId: string, rootBone: Bone)
	if warned[speciesId] then
		return
	end
	local head = rootBone:FindFirstChild("Head", true)
	local tail = rootBone:FindFirstChild("Tail1", true)
	if head and tail and restPos(head).Z > restPos(tail).Z then
		warned[speciesId] = true
		warn(("[DragonVisual] %s template faces +Z (head behind tail); re-export it facing -Z"):format(speciesId))
	end
end

-- opts: Root (BasePart, required for animated dragons), Mutation, Scale
-- (extra scale multiplier), Detail, Saddle. Returns the visual Model.
function DragonVisual.build(speciesId: string, opts: { [string]: any }?): Model
	local o = opts or {}
	if Species.Style == "Brick" and not o.ForceMesh then
		return BrickBuilder.build(speciesId, o)
	end
	local template = DragonVisual.template(speciesId)
	if not template or o.ForceParts then
		return Builder.build(speciesId, o)
	end
	local def = Species.get(speciesId)
	local model = template:Clone()
	stripImporterExtras(model)
	local mesh, rootBone = DragonVisual.findRig(model)
	assert(mesh and rootBone, "dragon template without a skinned MeshPart")
	checkOrientation(speciesId, rootBone)
	local baseScale = def.Scale or 1
	local extra = o.ScaleOverride or 1
	if extra ~= 1 then
		model:ScaleTo(model:GetScale() * extra)
	end
	local S = baseScale * extra
	if o.Root then
		attachMesh(model, mesh, rootBone, o.Root)
	end
	model.PrimaryPart = mesh
	applyMutation(mesh, o.Mutation)
	model.Name = def.Name or speciesId
	model:SetAttribute("SpeciesId", speciesId)
	model:SetAttribute("Scale", S)
	model:SetAttribute("BodyRadius", (def.BodyRadius or 4.2) * S)
	model:SetAttribute("HipHeight", def.HipHeight * S)
	model:SetAttribute("Rig", def.Rig or "Quadruped")
	model:SetAttribute("MeshRig", true)
	if o.Mutation then
		model:SetAttribute("Mutation", o.Mutation)
	end
	return model
end

-- Static pose for displays / viewports. Mesh rigs pose through their bones.
function DragonVisual.pose(model: Model, pose: { [string]: CFrame }?, rootCF: CFrame?)
	if not model:GetAttribute("MeshRig") then
		Builder.pose(model, pose, rootCF)
		return
	end
	local mesh, rootBone = DragonVisual.findRig(model)
	if not mesh or not rootBone then
		return
	end
	for _, d in mesh:GetDescendants() do
		if d:IsA("Bone") and pose and pose[d.Name] then
			d.Transform = pose[d.Name]
		end
	end
	local weld = mesh:FindFirstChild("RootWeld")
	if weld then
		weld:Destroy()
	end
	mesh.Anchored = true
	mesh.CFrame = (rootCF or CFrame.identity) * rootBone.CFrame:Inverse()
end

return DragonVisual
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000010">
					<Properties>
						<string name="Name">Locomotion</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Locomotion
	Pure, deterministic dragon movement model (no instance access). The
	client feeds it input + world queries every frame and applies the result
	to physics constraints (LinearVelocity / AlignOrientation), so movement
	is simulated by the engine at its own rate and replicates smoothly.

	Modes:
	  Ground   walking/running on terrain, ground-following spring, slopes
	  Air      ballistic (jump / falling), limited air control
	  Takeoff  crouch + leap + powerful wing beats into flight
	  Fly      3D flight: speed dynamics, rate-limited turning, dive/climb,
	           boost meter, banking, hover
	  Landing  flare + controlled descent + touchdown

	Conventions: Yaw 0 faces -Z, +Yaw turns left. Pitch + = nose up.
	Roll + = rolling left (left wing down). All smoothing is exponential in
	dt and every rate is limited per second, so results are frame-rate
	independent.

	world = {
	  ground = function(pos: Vector3, maxDown: number) -> (hit, y, normal, isWater)
	  sweep  = function(origin: Vector3, delta: Vector3, radius: number) -> (hit, fraction, normal)
	}
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GameConfig = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("GameConfig"))

local Locomotion = {}

local R = GameConfig.Riding
local M = GameConfig.Movement
local TAU = math.pi * 2
local clamp, exp, abs, sqrt, atan2, sin, cos, min, max = math.clamp, math.exp, math.abs, math.sqrt, math.atan2, math.sin, math.cos, math.min, math.max

local function wrap(a: number): number
	return (a + math.pi) % TAU - math.pi
end

local function approach(current: number, target: number, rate: number, dt: number): number
	-- exponential approach (frame-rate independent)
	return current + (target - current) * (1 - exp(-rate * dt))
end

local function moveToward(current: number, target: number, maxDelta: number): number
	if current < target then
		return min(current + maxDelta, target)
	end
	return max(current - maxDelta, target)
end

local function yawOf(v: Vector3): number
	return atan2(-v.X, -v.Z)
end

local function flatForward(yaw: number): Vector3
	return Vector3.new(-sin(yaw), 0, -cos(yaw))
end

local function dirFrom(yaw: number, pitch: number): Vector3
	local c = cos(pitch)
	return Vector3.new(-sin(yaw) * c, sin(pitch), -cos(yaw) * c)
end
Locomotion.dirFrom = dirFrom
Locomotion.yawOf = yawOf

--[[
	stats = {
	  RunSpeed, CruiseSpeed   studs/s (from the dragon's stats)
	  Scale, HipHeight, BodyRadius
	  Turn, Accel, Agility    species handling multipliers
	}
]]
function Locomotion.new(stats: { [string]: number }, position: Vector3, yaw: number?)
	return {
		Mode = "Ground",
		ModeTime = 0,
		Position = position,
		Velocity = Vector3.zero,
		Yaw = yaw or 0,
		YawRate = 0,
		Pitch = 0,
		Roll = 0,
		Speed = 0, -- forward speed scalar
		FlightPitch = 0, -- direction-of-travel pitch in flight
		Boost = 1,
		Boosting = false,
		BoostLock = false,
		Grounded = true,
		GroundY = position.Y - (stats.HipHeight or 4.8),
		GroundNormal = Vector3.yAxis,
		OnWater = false,
		AirTime = 0,
		JumpHeldTime = 0,
		JumpConsumed = false,
		CoyoteTime = 0,
		LandingFrom = 0,
		Stats = stats,
		Events = {},
	}
end

function Locomotion.setStats(s, stats)
	s.Stats = stats
end

-- Wind Dash (Dragon Bond level 5): for `duration` seconds the dragon surges forward at
-- `multiplier` x its cruise (flight) or run (ground) speed, with or without steering input.
function Locomotion.dash(s, duration: number, multiplier: number)
	s.DashLeft = duration
	s.DashMult = multiplier
	table.insert(s.Events, { Kind = "Dash" })
end

local function setMode(s, mode: string)
	if s.Mode ~= mode then
		s.Mode = mode
		s.ModeTime = 0
		table.insert(s.Events, { Kind = "Mode", Mode = mode })
	end
end
Locomotion.setMode = setMode

local function event(s, kind: string, data: any?)
	table.insert(s.Events, { Kind = kind, Data = data })
end

-- Desired yaw rate toward a target heading, smoothed (turns accelerate and
-- settle instead of snapping).
local function steerYaw(s, targetYaw: number, maxRate: number, response: number, dt: number, gain: number?)
	local diff = wrap(targetYaw - s.Yaw)
	local desired = clamp(diff * (gain or 4), -maxRate, maxRate)
	s.YawRate = approach(s.YawRate, desired, response, dt)
	s.Yaw = wrap(s.Yaw + s.YawRate * dt)
	return diff
end

local function hip(s): number
	return s.Stats.HipHeight or 4.8
end

-- Sample ground under the dragon (center + slope along heading).
local function probeGround(s, world, maxDown: number)
	local hit, y, normal, water = world.ground(s.Position, maxDown)
	if hit then
		s.GroundY = y
		s.GroundNormal = normal
		s.OnWater = water == true
	end
	return hit, y, normal, water
end

local function slopePitch(s, world): number
	local L = (s.Stats.BodyRadius or 4.2) * 1.1
	local f = flatForward(s.Yaw)
	local hitF, yF = world.ground(s.Position + f * L, hip(s) + 8)
	local hitB, yB = world.ground(s.Position - f * L, hip(s) + 8)
	if hitF and hitB then
		return clamp(atan2(yF - yB, 2 * L), -0.6, 0.6)
	end
	return 0
end

local function finite(v: Vector3): boolean
	return v.X == v.X and v.Y == v.Y and v.Z == v.Z and abs(v.X) < 1e6 and abs(v.Y) < 1e6 and abs(v.Z) < 1e6
end

-- Slides a velocity along obstacles found by a sphere sweep. Walls are
-- anticipated with a small look-ahead margin (smooth slides); floor-like
-- hits only stop real penetration, since each mode follows the ground itself.
local function collide(s, world, vel: Vector3, dt: number, radius: number): Vector3
	for _ = 1, 2 do
		local speed = vel.Magnitude
		if speed < 0.01 then
			break
		end
		local dir = vel / speed
		local travel = speed * dt
		local margin = radius * 0.35
		local hit, frac, normal = world.sweep(s.Position, dir * (travel + margin), radius)
		if not hit or not finite(normal) or normal.Magnitude < 0.5 then
			break
		end
		local into = vel:Dot(normal)
		if into >= 0 then
			break
		end
		local contact = frac * (travel + margin)
		if normal.Y > 0.7 and contact >= travel then
			break
		end
		vel = vel - normal * into
		vel *= (1 - 0.25 * clamp(-into / max(1, vel.Magnitude + abs(into)), 0, 1))
		if frac < 0.05 then
			-- already touching: push out gently
			vel += normal * 6
		end
		event(s, "Bump", -into)
	end
	return vel
end

-- ============================================================== ground
local function stepGround(s, input, dt: number, world)
	local st = s.Stats
	local h = hip(s)
	local hit, gy, _, water = probeGround(s, world, h + 3.5)
	if not hit or s.Position.Y - (gy + h) > 2.6 then
		-- stepped off a ledge: start falling (coyote time keeps jumps fair)
		s.CoyoteTime = 0.15
		setMode(s, "Air")
		return
	end

	local move = input.MoveFlat or Vector3.zero
	local mag = min(1, move.Magnitude)
	local sprint = input.Sprint and 1.32 or 1
	local runSpeed = st.RunSpeed * (water and 0.65 or 1)
	local targetSpeed = 0
	if mag > 0.08 then
		local desiredYaw = yawOf(move)
		local speedK = clamp(abs(s.Speed) / max(1, runSpeed), 0, 1)
		local maxRate = (R.GroundTurnRate + (R.GroundTurnRateFast - R.GroundTurnRate) * speedK) * (st.Turn or 1)
		local diff = steerYaw(s, desiredYaw, maxRate, R.GroundTurnResponse, dt)
		-- slow down while turning hard (big creature)
		local align = clamp(cos(diff), 0, 1)
		targetSpeed = runSpeed * mag * sprint * (0.35 + 0.65 * align)
	else
		s.YawRate = approach(s.YawRate, 0, R.GroundTurnResponse, dt)
		s.Yaw = wrap(s.Yaw + s.YawRate * dt)
	end
	local accel = (targetSpeed > s.Speed and R.GroundAccel * (st.Accel or 1) or R.GroundDecel)
	if (s.DashLeft or 0) > 0 then
		targetSpeed = math.max(targetSpeed, runSpeed * (s.DashMult or 2.2) * 0.9)
		accel = math.max(accel, runSpeed * 10)
	end
	s.Speed = moveToward(s.Speed, targetSpeed, accel * dt)

	local horiz = flatForward(s.Yaw) * s.Speed
	horiz = collide(s, world, horiz, dt, (st.BodyRadius or 4.2) * 0.8)
	horiz = Vector3.new(horiz.X, 0, horiz.Z)
	s.Speed = min(s.Speed, horiz.Magnitude + 0.01)

	-- ground-following spring (critically damped toward hip height)
	local targetY = gy + h * (water and 0.6 or 1)
	local err = targetY - s.Position.Y
	local vy = clamp(err * 14, -70, 55)
	s.Velocity = Vector3.new(horiz.X, vy, horiz.Z)

	-- body attitude: follow slope, lean slightly into turns
	s.Pitch = approach(s.Pitch, slopePitch(s, world), R.SlopeAlignRate, dt)
	local lean = clamp(s.YawRate * s.Speed * 0.0035, -0.14, 0.14)
	s.Roll = approach(s.Roll, lean, 6, dt)
	s.FlightPitch = 0
	s.Grounded = true
	s.AirTime = 0

	-- jump
	if input.JumpPressed then
		s.JumpConsumed = true
		s.JumpHeldTime = 0
		s.Velocity = Vector3.new(s.Velocity.X, R.JumpVelocity * sqrt(max(0.6, st.Scale or 1)), s.Velocity.Z)
		s.Grounded = false
		setMode(s, "Air")
		event(s, "Jump")
	end

	-- boost regenerates on the ground (Great Tree "Second Wind" speeds it up)
	s.Boosting = false
	s.Boost = min(1, s.Boost + R.BoostRegenPerSecond * (st.BoostRegen or 1) * dt)
end

-- ============================================================== air (ballistic)
local function stepAir(s, input, dt: number, world)
	local st = s.Stats
	local h = hip(s)
	s.AirTime += dt
	s.CoyoteTime = max(0, s.CoyoteTime - dt)
	s.Grounded = false

	-- air control
	local move = input.MoveFlat or Vector3.zero
	local mag = min(1, move.Magnitude)
	if mag > 0.08 then
		steerYaw(s, yawOf(move), R.GroundTurnRateFast * 0.8 * (st.Turn or 1), R.GroundTurnResponse * 0.6, dt)
		s.Speed = moveToward(s.Speed, st.RunSpeed * mag, R.GroundAccel * 0.5 * dt)
	else
		s.YawRate = approach(s.YawRate, 0, 4, dt)
		s.Yaw = wrap(s.Yaw + s.YawRate * dt)
	end
	local vy = s.Velocity.Y - R.Gravity * dt
	local horiz = flatForward(s.Yaw) * s.Speed
	local vel = collide(s, world, Vector3.new(horiz.X, vy, horiz.Z), dt, (st.BodyRadius or 4.2) * 0.8)
	s.Velocity = vel
	s.Speed = Vector3.new(vel.X, 0, vel.Z).Magnitude

	s.Pitch = approach(s.Pitch, clamp(vel.Y / 120, -0.25, 0.2), 4, dt)
	s.Roll = approach(s.Roll, 0, 5, dt)

	-- hold jump through the leap, or press again, to take off
	if input.JumpHeld and s.JumpConsumed then
		s.JumpHeldTime += dt
	end
	local pressedAgain = input.JumpPressed and (s.AirTime > 0.05 or s.CoyoteTime <= 0)
	if s.CoyoteTime > 0 and input.JumpPressed and s.JumpConsumed == false then
		-- late jump right after stepping off a ledge
		s.JumpConsumed = true
		s.Velocity = Vector3.new(vel.X, R.JumpVelocity, vel.Z)
		event(s, "Jump")
		return
	end
	if pressedAgain or s.JumpHeldTime >= R.TakeoffHoldTime + 0.12 or input.FlyToggle then
		setMode(s, "Takeoff")
		event(s, "Takeoff")
		return
	end
	-- falling fast: the dragon catches itself and starts flying
	if vel.Y < -55 and s.AirTime > 0.5 then
		setMode(s, "Fly")
		s.FlightPitch = -0.3
		event(s, "CatchFall")
		return
	end

	-- touchdown
	if vel.Y <= 0 then
		local hit, gy = probeGround(s, world, h + max(2, -vel.Y * dt * 2))
		if hit and s.Position.Y - (gy + h) <= 0.6 then
			local impact = -vel.Y
			s.JumpConsumed = false
			s.JumpHeldTime = 0
			setMode(s, "Ground")
			s.Velocity = Vector3.new(vel.X, 0, vel.Z)
			event(s, "Land", impact)
		end
	end
end

-- ============================================================== takeoff
local function stepTakeoff(s, input, dt: number, world)
	local st = s.Stats
	local t = s.ModeTime
	local horiz = Vector3.new(s.Velocity.X, 0, s.Velocity.Z)
	local cap = st.CruiseSpeed * 0.55
	if horiz.Magnitude > cap then
		horiz = horiz.Unit * cap
	end
	local vy
	if t < R.CrouchTime and s.Grounded then
		-- gather: settle down before the leap
		vy = -6
		horiz *= (1 - min(1, dt * 4))
	else
		local k = clamp((t - R.CrouchTime) / max(0.01, R.TakeoffDuration - R.CrouchTime), 0, 1)
		-- strong initial lift that eases out
		vy = R.TakeoffLiftVelocity * (1 - k * k * 0.75)
		s.Grounded = false
	end
	-- allow steering during the climb
	local move = input.MoveFlat or Vector3.zero
	if move.Magnitude > 0.08 then
		steerYaw(s, yawOf(move), R.AirMaxYawRate * (st.Turn or 1), R.AirTurnResponse, dt)
	else
		s.YawRate = approach(s.YawRate, 0, 4, dt)
		s.Yaw = wrap(s.Yaw + s.YawRate * dt)
	end
	local fwd = flatForward(s.Yaw)
	local hs = horiz.Magnitude
	horiz = fwd * hs
	s.Velocity = collide(s, world, Vector3.new(horiz.X, vy, horiz.Z), dt, st.BodyRadius or 4.2)
	s.Speed = hs
	s.Pitch = approach(s.Pitch, t < R.CrouchTime and -0.08 or 0.32, 7, dt)
	s.Roll = approach(s.Roll, 0, 6, dt)
	if t >= R.TakeoffDuration then
		s.FlightPitch = atan2(s.Velocity.Y, max(1, hs)) * 0.6
		setMode(s, "Fly")
	end
end

-- ============================================================== flight
local function stepFly(s, input, dt: number, world)
	local st = s.Stats
	local h = hip(s)
	s.Grounded = false
	local agility = st.Agility or 1
	local turn = st.Turn or 1

	local move = input.Move or Vector3.zero
	local mag = min(1, move.Magnitude)
	local vIn = (input.Ascend and 1 or 0) - (input.Descend and 1 or 0)

	-- boost meter
	local wantBoost = input.Sprint and mag > 0.2
	if wantBoost and not s.Boosting and s.Boost >= R.BoostMinToStart and not s.BoostLock then
		s.Boosting = true
		event(s, "BoostStart")
	end
	if s.Boosting then
		s.Boost = max(0, s.Boost - dt / (R.BoostDuration * (st.BoostLong or 1))) -- Great Tree "Deep Breath"
		if not wantBoost or s.Boost <= 0 then
			s.Boosting = false
			s.BoostLock = s.Boost <= 0 -- must release before boosting again
			event(s, "BoostEnd")
		end
	else
		if not input.Sprint then
			s.BoostLock = false
		end
		s.Boost = min(1, s.Boost + R.BoostRegenPerSecond * (st.BoostRegen or 1) * dt)
	end

	-- desired direction and speed
	local cruise = st.CruiseSpeed
	local desiredSpeed = 0
	local desiredDir: Vector3
	if mag > 0.05 then
		desiredDir = move.Unit + Vector3.new(0, vIn * 0.85, 0)
		desiredDir = desiredDir.Unit
		desiredSpeed = cruise * mag * (s.Boosting and M.BoostMultiplier or 1)
	else
		desiredDir = dirFrom(s.Yaw, 0)
	end
	if input.Brake then
		-- pulling back: air brake (turning still allowed with strafe input)
		desiredSpeed = 0
	end
	local dashing = (s.DashLeft or 0) > 0
	if dashing then
		-- Wind Dash: surge forward (replaces boost, never stacks with it)
		desiredSpeed = cruise * (s.DashMult or 2.5)
		if mag <= 0.05 then
			desiredDir = dirFrom(s.Yaw, s.FlightPitch)
		end
	end
	local desiredPitch = clamp(math.asin(clamp(desiredDir.Y, -1, 1)), -R.MaxPitch, R.MaxPitch)

	-- dive gains speed, climbing costs speed
	local travelPitch = s.FlightPitch
	local speedCap = desiredSpeed
	if desiredSpeed > 0 then
		if travelPitch < -0.2 then
			speedCap *= 1 + (-travelPitch - 0.2) * 0.9
		elseif travelPitch > 0.2 then
			speedCap *= 1 - (travelPitch - 0.2) * R.ClimbPenalty
		end
	end
	local accel
	if speedCap > s.Speed then
		accel = R.AirAccel * (st.Accel or 1)
		if travelPitch < -0.2 then
			accel += R.DiveAccel * (-travelPitch)
		end
		if s.Boosting then
			accel *= 1.8
		end
	else
		accel = (mag < 0.05 or input.Brake) and R.AirBrake or R.AirBrake * 0.6
	end
	if dashing then
		accel = math.max(accel, cruise * 9)
	end
	s.Speed = moveToward(s.Speed, speedCap, accel * dt)

	-- heading: rate-limited, smoothed yaw; travel pitch follows desired pitch
	local hovering = s.Speed < 14 and mag < 0.05
	if mag > 0.05 then
		local maxRate = R.AirMaxYawRate * turn * (s.Boosting and 0.8 or 1)
		steerYaw(s, yawOf(desiredDir), maxRate, R.AirTurnResponse * agility, dt, 3)
	elseif hovering and input.CamYaw then
		-- hovering: slowly face where the camera looks
		steerYaw(s, input.CamYaw, 0.9, 2.5, dt, 2)
	else
		s.YawRate = approach(s.YawRate, 0, 3, dt)
		s.Yaw = wrap(s.Yaw + s.YawRate * dt)
	end
	if mag > 0.05 then
		s.FlightPitch = approach(s.FlightPitch, desiredPitch, R.PitchResponse * agility, dt)
	else
		s.FlightPitch = approach(s.FlightPitch, 0, 3, dt)
	end

	-- velocity: travel direction * speed + direct vertical control when slow
	local dir = dirFrom(s.Yaw, s.FlightPitch)
	local vel = dir * s.Speed
	local slow = clamp(1 - s.Speed / 30, 0, 1)
	local vy = vel.Y + vIn * R.VerticalSpeed * (slow * 0.9 + 0.1)
	if hovering then
		vy = approach(s.Velocity.Y, vIn * R.VerticalSpeed, R.VerticalAccel, dt)
	end
	-- soft ceiling
	local over = s.Position.Y - (R.Ceiling - R.SoftCeilingBand)
	if over > 0 and vy > 0 then
		vy *= clamp(1 - over / R.SoftCeilingBand, 0, 1)
	end
	vel = Vector3.new(vel.X, vy, vel.Z)

	-- ground: never sink into terrain while flying; auto-land when settling down
	local hit, gy, _, water = probeGround(s, world, h + 40)
	if hit then
		local height = s.Position.Y - (gy + h)
		if height < 1.5 and vel.Y < 0 then
			vel = Vector3.new(vel.X, max(vel.Y, (1.5 - height) * 8), vel.Z)
		end
		local settling = vIn < 0 or (mag < 0.05 and vel.Y <= 0.5)
		if settling and height < R.LandingStartHeight * (st.Scale or 1) and s.Speed < R.AutoLandMaxSpeed and not water then
			s.LandingFrom = height
			setMode(s, "Landing")
			event(s, "LandingStart")
		end
	end

	vel = collide(s, world, vel, dt, st.BodyRadius or 4.2)
	s.Velocity = vel

	-- visual attitude: pitch follows travel, bank follows turn rate
	local visualPitch = clamp(s.FlightPitch * 0.9, -R.MaxPitch, R.MaxPitch)
	if hovering then
		visualPitch = 0.08
	end
	s.Pitch = approach(s.Pitch, visualPitch, R.PitchResponse, dt)
	local bankTarget = clamp(s.YawRate * (14 + s.Speed) * 0.011 * agility, -R.MaxBank, R.MaxBank)
	s.Roll = approach(s.Roll, bankTarget, R.BankResponse, dt)
end

-- ============================================================== landing
local function stepLanding(s, input, dt: number, world)
	local st = s.Stats
	local h = hip(s)
	local hit, gy = probeGround(s, world, h + R.LandingStartHeight * 2 + 10)
	if not hit then
		setMode(s, "Fly")
		return
	end
	-- abort if the rider climbs or pushes forward hard
	if input.Ascend or (input.Move and input.Move.Magnitude > 0.5 and input.Sprint) then
		setMode(s, "Fly")
		return
	end
	local height = s.Position.Y - (gy + h)
	-- critically damped descent toward touchdown height
	local vy = clamp(-height * 3.2 - 4, -45, 2)
	local horiz = Vector3.new(s.Velocity.X, 0, s.Velocity.Z)
	horiz *= exp(-2.6 * dt)
	local move = input.MoveFlat or Vector3.zero
	if move.Magnitude > 0.08 then
		steerYaw(s, yawOf(move), 1.2 * (st.Turn or 1), 4, dt)
		horiz = flatForward(s.Yaw) * horiz.Magnitude
	else
		s.YawRate = approach(s.YawRate, 0, 5, dt)
		s.Yaw = wrap(s.Yaw + s.YawRate * dt)
	end
	s.Velocity = collide(s, world, Vector3.new(horiz.X, vy, horiz.Z), dt, st.BodyRadius or 4.2)
	s.Speed = horiz.Magnitude
	s.FlightPitch = 0
	-- flare: nose up while braking, level on touchdown
	s.Pitch = approach(s.Pitch, height > 2 and 0.22 or 0, 6, dt)
	s.Roll = approach(s.Roll, 0, 6, dt)
	if height <= R.TouchdownHeight then
		s.JumpConsumed = false
		s.JumpHeldTime = 0
		setMode(s, "Ground")
		event(s, "Touchdown", -vy)
	end
end

local STEP = {
	Ground = stepGround,
	Air = stepAir,
	Takeoff = stepTakeoff,
	Fly = stepFly,
	Landing = stepLanding,
}

--[[
	input = {
	  Move: Vector3        camera-relative desired direction (flight: includes pitch)
	  MoveFlat: Vector3    same, flattened to the ground plane
	  JumpPressed, JumpHeld, Ascend, Descend, Sprint, FlyToggle, Brake: boolean
	  CamYaw: number?      camera yaw (hover facing)
	}
	Returns the state; s.Events lists what happened this step.
]]
function Locomotion.step(s, input, dt: number, world)
	if (s.DashLeft or 0) > 0 then
		s.DashLeft = math.max(0, s.DashLeft - dt)
	end
	table.clear(s.Events)
	if dt <= 0 then
		return s
	end
	dt = min(dt, 1 / 15)
	s.ModeTime += dt
	if input.FlyToggle and s.Mode == "Ground" then
		setMode(s, "Takeoff")
		event(s, "Takeoff")
	elseif input.FlyToggle and s.Mode == "Fly" then
		input.Descend = true
	end
	local fn = STEP[s.Mode] or stepGround
	fn(s, input, dt, world)
	if not input.JumpHeld then
		s.JumpHeldTime = 0
	end
	-- safety net: never hand a non-finite value to physics
	if not finite(s.Velocity) or s.Yaw ~= s.Yaw or s.Pitch ~= s.Pitch or s.Roll ~= s.Roll or s.Speed ~= s.Speed then
		s.Velocity = Vector3.zero
		s.Speed = 0
		s.Yaw = s.Yaw == s.Yaw and s.Yaw or 0
		s.Pitch, s.Roll, s.YawRate, s.FlightPitch = 0, 0, 0, 0
		event(s, "Recovered")
	end
	return s
end

-- Orientation (rotation only) for AlignOrientation.
function Locomotion.orientation(s): CFrame
	return CFrame.Angles(0, s.Yaw, 0) * CFrame.Angles(s.Pitch, 0, 0) * CFrame.Angles(0, 0, s.Roll)
end

-- Animator parameters derived from the state.
function Locomotion.animParams(s)
	local v = s.Velocity
	local horiz = Vector3.new(v.X, 0, v.Z).Magnitude
	local mode = s.Mode
	local animMode
	if mode == "Ground" then
		animMode = "Ground"
	elseif mode == "Air" then
		animMode = "Air"
	else
		animMode = "Fly"
	end
	return {
		Speed = mode == "Fly" and s.Speed or horiz,
		Vertical = v.Y,
		TurnRate = s.YawRate,
		Bank = s.Roll,
		Pitch = s.Pitch,
		Mode = animMode,
		Boost = s.Boosting,
		RunSpeed = s.Stats.RunSpeed,
		WalkSpeed = M.WalkSpeed,
	}
end

return Locomotion
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000011">
					<Properties>
						<string name="Name">Membranes</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Membranes
	Dynamic wing membranes. Each membrane is a set of thin wedge meshes that
	are re-stretched between named anchor points on the wing bones whenever
	the pose changes, so wings fold tightly against the body, flex during
	flaps and never tear apart (rigid membrane panels cannot fold).

	Bat wing topology (per side):
	  S shoulder, E elbow, W wrist, F1..F3 finger tips, B body anchor.
	  Q12 / Q23 / Q3B are derived scallop points that curve the trailing edge.

	Pieces are Parts with a Wedge SpecialMesh joined to the Root by a Motor6D
	("MemJoint"). Updates write Motor6D.Transform and SpecialMesh.Scale only
	(render-side properties), never Part.Size.
]]

local Primitives = require(script.Parent:WaitForChild("Primitives"))

local Membranes = {}
Membranes.__index = Membranes

local TRIS = {
	{ "S", "E", "B" },
	{ "E", "Q3B", "B" },
	{ "E", "F3", "Q3B" },
	{ "E", "W", "F3" },
	{ "W", "F3", "Q23" },
	{ "W", "Q23", "F2" },
	{ "W", "F2", "Q12" },
	{ "W", "Q12", "F1" },
}
Membranes.Tris = TRIS

local KEYS = { "S", "E", "W", "F1", "F2", "F3", "B" }
Membranes.Keys = KEYS

local triangleFrames = Primitives.triangleFrames
local TINY = Vector3.new(0.001, 0.001, 0.001)

local function scallop(p: Vector3, q: Vector3, toward: Vector3, depth: number): Vector3
	local mid = (p + q) * 0.5
	return mid + (toward - mid) * depth
end

-- Adds the derived scallop points to a point table (in place).
function Membranes.derive(P: { [string]: Vector3 }, depth: number)
	P.Q12 = scallop(P.F1, P.F2, P.W, depth)
	P.Q23 = scallop(P.F2, P.F3, P.W, depth)
	P.Q3B = scallop(P.F3, P.B, P.E, depth * 0.8)
	return P
end

-- Build-time: creates the membrane pieces for one side at the rest pose.
-- P holds rest-pose points (model space, root at identity).
function Membranes.buildPieces(root: BasePart, side: string, P: { [string]: Vector3 }, thickness: number, depth: number, color: Color3, material: Enum.Material, addPart: (BasePart) -> ())
	Membranes.derive(P, depth)
	for i, tri in TRIS do
		local cf1, s1, cf2, s2 = triangleFrames(P[tri[1]], P[tri[2]], P[tri[3]], thickness)
		for half = 1, 2 do
			local cf = if half == 1 then cf1 else cf2
			local s = if half == 1 then s1 else s2
			if not cf or not s then
				cf = CFrame.new(P[tri[1]])
				s = TINY
			end
			-- generous part bounds so culling never clips a stretched mesh
			local size = Vector3.new(math.max(s.X * 1.3, 0.2), math.max(s.Y * 1.3, 0.4), math.max(s.Z * 1.3, 0.4))
			local part = Primitives.meshWedge(size, cf, color, material)
			part.Name = "Membrane"
			part.CastShadow = true
			part:SetAttribute("MSide", side)
			part:SetAttribute("MTri", i)
			part:SetAttribute("MHalf", half)
			local mesh = part:FindFirstChildOfClass("SpecialMesh") :: SpecialMesh
			mesh.Scale = s / size
			addPart(part)
			local motor = Instance.new("Motor6D")
			motor.Name = "MemJoint"
			motor.Part0 = root
			motor.Part1 = part
			motor.C0 = cf -- build space: the root sits at the origin
			motor.C1 = CFrame.identity
			motor.Parent = part
		end
	end
end

-- ============================================================== runtime
function Membranes.new(model: Model)
	local self = setmetatable({}, Membranes)
	self.Model = model
	self.Depth = model:GetAttribute("MembraneScallop") or 0.18
	self.Thickness = model:GetAttribute("MembraneThickness") or 0.14
	self.Sides = {}
	self.Count = 0
	for _, sn in { "L", "R" } do
		local side = { Points = {}, P = {}, Pieces = {} }
		local ok = true
		for _, key in KEYS do
			local att = model:FindFirstChild("Mem" .. key .. sn, true)
			if not att or not att:IsA("Attachment") or not att.Parent then
				ok = false
				break
			end
			side.Points[key] = { Bone = (att.Parent :: Instance).Name, Local = (att :: Attachment).Position }
		end
		if ok then
			self.Sides[sn] = side
		end
	end
	for _, d in model:GetDescendants() do
		if d.Name == "Membrane" and d:IsA("BasePart") then
			local sd = self.Sides[d:GetAttribute("MSide")]
			local i, half = d:GetAttribute("MTri"), d:GetAttribute("MHalf")
			if sd and i and half then
				local motor = d:FindFirstChild("MemJoint") :: Motor6D?
				local mesh = d:FindFirstChildOfClass("SpecialMesh")
				sd.Pieces[i] = sd.Pieces[i] or {}
				sd.Pieces[i][half] = {
					Part = d,
					Motor = motor,
					Mesh = mesh,
					C0inv = motor and motor.C0:Inverse() or CFrame.identity,
					InvSize = Vector3.one / d.Size,
				}
				self.Count += 1
			end
		end
	end
	self.Valid = next(self.Sides) ~= nil and self.Count > 0
	return self
end

-- Bones the solver needs (for partial forward kinematics).
function Membranes:RequiredBones(): { [string]: boolean }
	local out = {}
	for _, side in self.Sides do
		for _, src in side.Points do
			out[src.Bone] = true
		end
	end
	return out
end

local function setPiece(piece, cf: CFrame?, size: Vector3?, world: boolean)
	if not piece then
		return
	end
	if cf and size then
		if world then
			piece.Part.CFrame = cf
		elseif piece.Motor then
			piece.Motor.Transform = piece.C0inv * cf
		end
		if piece.Mesh then
			piece.Mesh.Scale = size * piece.InvSize
		end
	elseif piece.Mesh then
		piece.Mesh.Scale = TINY
	end
end

-- boneCF: { [boneName] = CFrame } in Root space (runtime, writes Motor
-- transforms) or world space with world = true (static/anchored models).
function Membranes:Solve(boneCF: { [string]: CFrame }, world: boolean?)
	if not self.Valid then
		return
	end
	local th = self.Thickness
	for _, side in self.Sides do
		local P = side.P
		for key, src in side.Points do
			local cf = boneCF[src.Bone]
			if not cf then
				return
			end
			P[key] = cf * src.Local
		end
		Membranes.derive(P, self.Depth)
		for i, tri in TRIS do
			local pieces = side.Pieces[i]
			if pieces then
				local cf1, s1, cf2, s2 = triangleFrames(P[tri[1]], P[tri[2]], P[tri[3]], th)
				setPiece(pieces[1], cf1, s1, world == true)
				setPiece(pieces[2], cf2, s2, world == true)
			end
		end
	end
end

return Membranes
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000012">
					<Properties>
						<string name="Name">Primitives</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Primitives
	Part factories for code-built creatures. Every visual part is massless,
	non-colliding, non-queryable and non-touchable (the rig's invisible Root
	is the only physics body), so dragons never snag on the world or
	interfere with raycasts.
]]

local Primitives = {}

local function base(className: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	local p = Instance.new(className) :: BasePart
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = true
	p.Material = material or Enum.Material.SmoothPlastic
	p.Color = color
	p.Size = size
	p.CFrame = cf
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	return p
end

function Primitives.block(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	return base("Part", size, cf, color, material)
end

-- Smooth ellipsoid: a part with a Sphere SpecialMesh fills its Size exactly.
function Primitives.ellipsoid(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	local p = base("Part", size, cf, color, material)
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	return p
end

function Primitives.ball(diameter: number, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	local p = base("Part", Vector3.new(diameter, diameter, diameter), cf, color, material)
	;(p :: Part).Shape = Enum.PartType.Ball
	return p
end

-- Cylinder whose axis runs from a to b.
function Primitives.cylinderBetween(a: Vector3, b: Vector3, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local len = (b - a).Magnitude
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b) * CFrame.Angles(0, math.rad(90), 0)
	local p = base("Part", Vector3.new(len, diameter, diameter), cf, color, material)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	return p
end

-- Ellipsoid stretched between two points (good for bones, horns, limbs).
function Primitives.ellipsoidBetween(a: Vector3, b: Vector3, width: number, height: number?, color: Color3, material: Enum.Material?, overlap: number?): BasePart
	local dir = b - a
	local len = dir.Magnitude * (overlap or 1.15)
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(mid, b)
	return Primitives.ellipsoid(Vector3.new(width, height or width, len), cf, color, material)
end

function Primitives.wedge(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	return base("WedgePart", size, cf, color, material)
end

-- Pure math for a flat triangle a-b-c built from two wedges.
-- Returns cf1, size1, cf2, size2 (or nil for a degenerate triangle).
function Primitives.triangleFrames(a: Vector3, b: Vector3, c: Vector3, thickness: number): (CFrame?, Vector3?, CFrame?, Vector3?)
	local ab, ac, bc = b - a, c - a, c - b
	local abd, acd, bcd = ab:Dot(ab), ac:Dot(ac), bc:Dot(bc)
	if abd > acd and abd > bcd then
		c, a = a, c
	elseif acd > bcd and acd > abd then
		a, b = b, a
	end
	ab, ac, bc = b - a, c - a, c - b
	local right = ac:Cross(ab)
	if right.Magnitude < 1e-5 or bc.Magnitude < 1e-4 then
		return nil, nil, nil, nil
	end
	right = right.Unit
	local up = bc:Cross(right).Unit
	local back = bc.Unit
	local height = math.abs(ab:Dot(up))
	local d1 = math.abs(ab:Dot(back))
	local d2 = math.abs(ac:Dot(back))
	return CFrame.fromMatrix((a + b) / 2, right, up, back), Vector3.new(thickness, height, d1),
		CFrame.fromMatrix((a + c) / 2, -right, up, -back), Vector3.new(thickness, height, d2)
end

-- Flat triangle a-b-c made from two WedgeParts (thickness along the normal).
function Primitives.triangle(a: Vector3, b: Vector3, c: Vector3, thickness: number, color: Color3, material: Enum.Material?): { BasePart }
	local cf1, s1, cf2, s2 = Primitives.triangleFrames(a, b, c, thickness)
	if not cf1 then
		return {}
	end
	return { base("WedgePart", s1 :: Vector3, cf1, color, material), base("WedgePart", s2 :: Vector3, cf2 :: CFrame, color, material) }
end

-- Resizable wedge: a Part whose SpecialMesh (Wedge) is scaled at runtime, so
-- animated membranes never touch Part.Size (render-only updates).
function Primitives.meshWedge(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): BasePart
	local p = base("Part", size, cf, color, material)
	p.CastShadow = true
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Wedge
	m.Scale = Vector3.one
	m.Parent = p
	return p
end

-- Spike (single wedge) standing on `basePos`, pointing toward `tipDir`,
-- with its flat side facing `side` (usually the creature's right vector).
function Primitives.spike(basePos: Vector3, tip: Vector3, width: number, thickness: number, color: Color3, material: Enum.Material?): BasePart
	local up = (tip - basePos)
	local h = up.Magnitude
	local upU = up.Unit
	local right = Vector3.xAxis
	if math.abs(upU:Dot(right)) > 0.95 then
		right = Vector3.zAxis
	end
	local back = right:Cross(upU).Unit
	right = upU:Cross(back).Unit
	local cf = CFrame.fromMatrix(basePos + upU * (h / 2), right, upU, back)
	return base("WedgePart", Vector3.new(thickness, h, width), cf, color, material)
end

return Primitives
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000013">
					<Properties>
						<string name="Name">RiderPose</string>
						<ProtectedString name="Source"><![CDATA[--[[
	RiderPose
	Procedural straddle pose for a mounted character (R15 and R6), written
	to Motor6D.Transform after the character's own animations each frame.

	RiderPose.apply(character, params)
	  params.Lean   0..1  forward lean (boost / speed)
	  params.Bounce -1..1 small vertical absorb from the dragon's gait
	  params.Bank   radians, counter-lean against the dragon's roll
	RiderPose.clear(character) restores identity transforms.
]]

local RiderPose = {}

local rad = math.rad
local Angles = CFrame.Angles

local cache = setmetatable({}, { __mode = "k" }) :: { [Model]: any }

local R15 = {
	"Root", "Waist", "Neck", "LeftHip", "RightHip", "LeftKnee", "RightKnee", "LeftAnkle", "RightAnkle",
	"LeftShoulder", "RightShoulder", "LeftElbow", "RightElbow", "LeftWrist", "RightWrist",
}
local R6 = { "RootJoint", "Neck", "Left Hip", "Right Hip", "Left Shoulder", "Right Shoulder" }

local function collect(character: Model)
	local entry = cache[character]
	if entry and entry.Valid then
		return entry
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local isR15 = humanoid ~= nil and humanoid.RigType == Enum.HumanoidRigType.R15
	local motors = {}
	for _, d in character:GetDescendants() do
		if d:IsA("Motor6D") then
			motors[d.Name] = d
		end
	end
	entry = { Motors = motors, R15 = isR15, Valid = true }
	cache[character] = entry
	character.DescendantRemoving:Once(function()
		entry.Valid = false
	end)
	return entry
end

local function set(motors, name: string, cf: CFrame)
	local m = motors[name]
	if m then
		m.Transform = cf
	end
end

function RiderPose.apply(character: Model, params: { [string]: number }?)
	local p = params or {}
	local lean = p.Lean or 0
	local bounce = p.Bounce or 0
	local bank = p.Bank or 0
	local e = collect(character)
	local m = e.Motors
	if e.R15 then
		set(m, "Root", CFrame.new(0, bounce * 0.08, 0) * Angles(0, 0, -bank * 0.25))
		set(m, "Waist", Angles(rad(-8 - 20 * lean) + bounce * 0.04, 0, -bank * 0.15))
		set(m, "Neck", Angles(rad(6 + 16 * lean), 0, 0))
		-- legs straddle the saddle: thighs forward and out, shins back
		set(m, "LeftHip", Angles(rad(62), 0, rad(-30)))
		set(m, "RightHip", Angles(rad(62), 0, rad(30)))
		set(m, "LeftKnee", Angles(rad(-88), 0, 0))
		set(m, "RightKnee", Angles(rad(-88), 0, 0))
		set(m, "LeftAnkle", Angles(rad(20), 0, 0))
		set(m, "RightAnkle", Angles(rad(20), 0, 0))
		-- hands forward on the saddle horn
		set(m, "LeftShoulder", Angles(rad(38 + 14 * lean), 0, rad(10)))
		set(m, "RightShoulder", Angles(rad(38 + 14 * lean), 0, rad(-10)))
		set(m, "LeftElbow", Angles(rad(42), 0, 0))
		set(m, "RightElbow", Angles(rad(42), 0, 0))
		set(m, "LeftWrist", CFrame.identity)
		set(m, "RightWrist", CFrame.identity)
	else
		-- R6 motors rotate about their joint's Z axis (DesiredAngle convention)
		set(m, "RootJoint", Angles(rad(8 + 18 * lean), 0, 0))
		set(m, "Neck", Angles(rad(-6 - 14 * lean), 0, 0))
		set(m, "Left Hip", Angles(rad(-18), 0, rad(-72)))
		set(m, "Right Hip", Angles(rad(-18), 0, rad(72)))
		set(m, "Left Shoulder", Angles(0, 0, rad(-48 - 12 * lean)))
		set(m, "Right Shoulder", Angles(0, 0, rad(48 + 12 * lean)))
	end
end

function RiderPose.clear(character: Model)
	local e = cache[character]
	if not e then
		return
	end
	for _, name in (e.R15 and R15 or R6) do
		set(e.Motors, name, CFrame.identity)
	end
	cache[character] = nil
end

return RiderPose
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000014">
					<Properties>
						<string name="Name">Species</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Species (visual definitions)
	Each species is a parameter set for the Builder plus optional unique
	features, giving every dragon its own silhouette (not a recolor).
]]

local Species = {}

-- Visual style for every dragon: "Brick" (toy bricks, BrickBuilder) or
-- "Classic" (smooth part-built / imported skinned meshes).
Species.Style = "Brick"

local C = Color3.fromRGB

Species.Defs = {
	GreenDrake = {
		Name = "Green Drake",
		Scale = 1.3,
		HipHeight = 5.0,
		BodyRadius = 3.9,
		Rig = "Quadruped",
		-- toy-brick plastic colours (bright, saturated, high contrast)
		Palette = {
			Main = C(75, 151, 74), -- bright green
			Dark = C(39, 112, 62), -- dark green
			Belly = C(245, 205, 47), -- bright yellow
			Horn = C(242, 243, 242), -- white
			HornTip = C(99, 95, 98), -- dark bluish grey
			Membrane = C(164, 189, 70), -- lime
			Accent = C(218, 120, 46), -- bright orange
			Eye = C(245, 205, 47),
			Pupil = C(27, 42, 52),
			Claw = C(242, 243, 242),
			Tooth = C(250, 250, 246),
			Saddle = C(196, 40, 27),
		},
		Brick = { HeadScale = 1.25, EyeScale = 1.25, HornScale = 1.6, HornTip = "HornTip", TailTip = "Accent", SpineColor = "Accent" },
		Body = { Length = 7.0, Width = 3.8, Height = 3.5, ChestScale = 1.15, HipScale = 0.9 },
		Neck = { Segments = 4, Length = 5.6, Rise = 30, Curve = 6, Thickness = 2.0, Taper = 0.68 },
		Head = { Size = 1, Snout = 1.08, Tilt = -6, Horns = "Swept", HornLength = 1.55, HornThickness = 0.55 },
		Tail = { Segments = 7, Length = 14.5, Thickness = 2.3, Taper = 0.14, Droop = 7, Lift = -2, Tip = "Spade" },
		Legs = { Front = true, Back = true, Thickness = 1.12 },
		Wings = { Type = "Bat", Span = 15, Chord = 6.4 },
		Spines = { Style = "Wedge", Height = 0.95, Color = "Dark" },
		-- mesh sculpt / texture parameters (used by the offline mesh generator)
		Mesh = {
			ScaleSize = 0.42, -- body scale size (studs at scale 1)
			Pattern = "Dapples", -- back markings
		},
	},
}

-- ============================================================== brick species
-- Toy-brick colours.
local B = {
