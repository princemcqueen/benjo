			<Item class="ModuleScript" referent="RBX000084">
				<Properties>
					<string name="Name">Kit</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Kit - building toolkit for world structures.

	A Builder places anchored parts in a local frame (Origin CFrame; local -Z
	is the building's front). Recipes stay readable:
	    local b = Kit.new(parent, CFrame.new(x, y, z) * CFrame.Angles(0, yaw, 0), "Cottage")
	    b:box(Vector3.new(12, 1, 10), V(0, 0.5, 0), Kit.C.Stone, Kit.M.Slate)
	All positions given to a Builder are in its local frame.
]]

local Kit = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local C3 = Color3.fromRGB
Kit.V = V

Kit.M = Enum.Material

-- One cohesive palette for Dragon Haven (stone, timber, plaster, slate, gold).
Kit.C = {
	Stone = C3(128, 124, 116),
	StoneDark = C3(92, 90, 86),
	StoneWarm = C3(150, 138, 118),
	Cobble = C3(112, 106, 98),
	Plaster = C3(222, 210, 186),
	PlasterWarm = C3(214, 192, 158),
	Timber = C3(84, 60, 42),
	TimberLight = C3(124, 92, 62),
	Planks = C3(132, 100, 70),
	RoofSlate = C3(70, 78, 92),
	RoofSlateDark = C3(52, 58, 70),
	RoofClay = C3(150, 84, 58),
	RoofMoss = C3(88, 96, 70),
	Gold = C3(206, 166, 86),
	Iron = C3(62, 62, 66),
	BannerRed = C3(126, 30, 38),
	BannerBlue = C3(38, 62, 126),
	BannerGreen = C3(40, 96, 62),
	Window = C3(255, 196, 120),
	Fabric = C3(176, 150, 112),
	Leaf = C3(70, 108, 52),
	Water = C3(70, 140, 170),
}

local Builder = {}
Builder.__index = Builder

function Kit.new(parent: Instance, origin: CFrame, name: string?): any
	local model = Instance.new("Model")
	model.Name = name or "Structure"
	model.Parent = parent
	local self = setmetatable({ Model = model, Origin = origin, Count = 0 }, Builder)
	return self
end

-- Child builder (same frame unless offset) in a sub-model.
function Builder:sub(name: string, offset: CFrame?)
	local m = Instance.new("Model")
	m.Name = name
	m.Parent = self.Model
	return setmetatable({ Model = m, Origin = self.Origin * (offset or CFrame.identity), Count = 0, Root = self.Root or self }, Builder)
end

function Builder:world(localCF: CFrame): CFrame
	return self.Origin * localCF
end

local function finish(self, p: BasePart, color: Color3?, material: Enum.Material?, props: { [string]: any }?)
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if color then
		p.Color = color
	end
	p.Material = material or Enum.Material.SmoothPlastic
	if props then
		for k, v in props do
			(p :: any)[k] = v
		end
	end
	p.Parent = self.Model
	self.Count += 1
	local root = self.Root or self
	root.Total = (root.Total or 0) + 1
	return p
end

local function toCF(at: any): CFrame
	if typeof(at) == "Vector3" then
		return CF(at)
	end
	return at
end

-- Axis-aligned (in local frame) box. `at` = Vector3 center or local CFrame.
function Builder:box(size: Vector3, at: any, color: Color3?, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Size = size
	p.CFrame = self.Origin * toCF(at)
	return finish(self, p, color, material, props) :: Part
end

-- Wedge: slope rises toward local -Z... (Roblox wedge: high at back (+Z), low at front (-Z)).
function Builder:wedge(size: Vector3, at: any, color: Color3?, material: Enum.Material?, props: { [string]: any }?): WedgePart
	local p = Instance.new("WedgePart")
	p.Size = size
	p.CFrame = self.Origin * toCF(at)
	return finish(self, p, color, material, props) :: WedgePart
end

-- Cylinder standing upright (height along local Y).
function Builder:cyl(height: number, diameter: number, at: any, color: Color3?, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = V(height, diameter, diameter)
	p.CFrame = self.Origin * toCF(at) * ANG(0, 0, math.rad(90))
	return finish(self, p, color, material, props) :: Part
end

-- Cylinder lying along local X.
function Builder:cylX(length: number, diameter: number, at: any, color: Color3?, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Cylinder
	p.Size = V(length, diameter, diameter)
	p.CFrame = self.Origin * toCF(at)
	return finish(self, p, color, material, props) :: Part
end

function Builder:ball(diameter: number, at: any, color: Color3?, material: Enum.Material?, props: { [string]: any }?): Part
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = V(diameter, diameter, diameter)
	p.CFrame = self.Origin * toCF(at)
	return finish(self, p, color, material, props) :: Part
end

-- Beam between two local points (square cross-section).
function Builder:beam(a: Vector3, b: Vector3, thickness: number, color: Color3?, material: Enum.Material?, props: { [string]: any }?): Part?
	local d = b - a
	local len = d.Magnitude
	if len < 1e-3 then
		return nil
	end
	local cf = CFrame.lookAt((a + b) / 2, b, math.abs(d.Unit.Y) > 0.99 and Vector3.zAxis or Vector3.yAxis)
	return self:box(V(thickness, thickness, len), cf, color, material, props)
end

-- Gable roof centred at `at` (local), ridge along local Z.
-- w = width across (X), d = depth (Z), h = ridge height above eaves, o = overhang.
function Builder:gableRoof(w: number, d: number, h: number, o: number, at: Vector3, color: Color3, material: Enum.Material?, thick: number?)
	local t = thick or 0.8
	local half = w / 2 + o
	local ang = math.atan2(h, w / 2)
	local L = half / math.cos(ang)
	local mat = material or Enum.Material.RoofShingles
	for _, s in { -1, 1 } do
		local cx = at.X + s * (half / 2)
		local cy = at.Y + h / 2 - (o / 2) * math.tan(ang) + t * 0.5
		local cf = CF(cx, cy, at.Z) * ANG(0, 0, s * -ang)
		self:box(V(L + 0.4, t, d + o * 2), cf, color, mat)
	end
	-- ridge cap
	self:box(V(0.9, 0.9, d + o * 2 + 0.2), CF(at.X, at.Y + h + t * 0.35, at.Z) * ANG(0, 0, math.rad(45)), color:Lerp(Color3.new(0, 0, 0), 0.2), mat)
end

-- Triangular gable wall (two wedges) at local z, spanning width w, height h.
function Builder:gableWall(w: number, h: number, thickness: number, at: Vector3, color: Color3, material: Enum.Material?)
	local half = w / 2
	-- a wedge is full height at its local +Z face; yaw +90 points that face to +X
	-- (the ridge) for the left half, yaw -90 to -X for the right half
	self:wedge(V(thickness, h, half), CF(at.X - half / 2, at.Y + h / 2, at.Z) * ANG(0, math.rad(90), 0), color, material)
	self:wedge(V(thickness, h, half), CF(at.X + half / 2, at.Y + h / 2, at.Z) * ANG(0, math.rad(-90), 0), color, material)
end

-- Warm window: glass pane + light glow + frame.
function Builder:window(at: CFrame, w: number, h: number, frameColor: Color3?, lit: boolean?)
	local fc = frameColor or Kit.C.Timber
	self:box(V(w, h, 0.25), at, Kit.C.Window, Enum.Material.Glass, { Transparency = 0.35, CastShadow = false })
	local glow = self:box(V(w - 0.3, h - 0.3, 0.12), at * CF(0, 0, 0.18), Kit.C.Window, Enum.Material.Neon,
		{ Transparency = lit == false and 1 or 0.55, CastShadow = false, CanCollide = false })
	glow.Name = "WindowGlow"
	self:box(V(w + 0.5, 0.35, 0.5), at * CF(0, -h / 2 - 0.1, -0.05), fc, Enum.Material.Wood)
	self:box(V(w + 0.5, 0.3, 0.45), at * CF(0, h / 2 + 0.1, -0.05), fc, Enum.Material.Wood)
	self:box(V(0.3, h, 0.45), at * CF(-w / 2 - 0.1, 0, -0.05), fc, Enum.Material.Wood)
	self:box(V(0.3, h, 0.45), at * CF(w / 2 + 0.1, 0, -0.05), fc, Enum.Material.Wood)
	self:box(V(0.18, h, 0.3), at * CF(0, 0, -0.08), fc, Enum.Material.Wood)
end

function Builder:door(at: CFrame, w: number, h: number)
	self:box(V(w, h, 0.4), at, Kit.C.Planks, Enum.Material.WoodPlanks)
	self:box(V(w + 0.8, 0.5, 0.6), at * CF(0, h / 2 + 0.25, -0.1), Kit.C.Timber, Enum.Material.Wood)
	self:box(V(0.4, h, 0.6), at * CF(-w / 2 - 0.2, 0, -0.1), Kit.C.Timber, Enum.Material.Wood)
	self:box(V(0.4, h, 0.6), at * CF(w / 2 + 0.2, 0, -0.1), Kit.C.Timber, Enum.Material.Wood)
	self:ball(0.35, at * CF(w * 0.32, 0, -0.3), Kit.C.Gold, Enum.Material.Metal)
end

-- Lantern on a post with a warm PointLight.
function Builder:lampPost(at: Vector3, height: number?)
	local h = height or 9
	self:cyl(h, 0.6, at + V(0, h / 2, 0), Kit.C.Iron, Enum.Material.Metal)
	self:box(V(1.8, 0.3, 0.3), at + V(0.6, h - 0.4, 0), Kit.C.Iron, Enum.Material.Metal)
	local lamp = self:box(V(1.0, 1.3, 1.0), at + V(1.3, h - 1.3, 0), Kit.C.Window, Enum.Material.Neon,
		{ Transparency = 0.15, CastShadow = false })
	lamp.Name = "Lamp"
	self:box(V(1.3, 0.25, 1.3), at + V(1.3, h - 0.55, 0), Kit.C.Iron, Enum.Material.Metal)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 190, 120)
	light.Range = 20
	light.Brightness = 1.4
	light.Shadows = false
	light.Parent = lamp
	return lamp
end

function Builder:banner(at: CFrame, w: number, h: number, color: Color3)
	self:box(V(w + 1, 0.35, 0.35), at * CF(0, h / 2 + 0.2, 0), Kit.C.Timber, Enum.Material.Wood)
	self:box(V(w, h, 0.12), at, color, Enum.Material.Fabric, { CastShadow = false })
	self:box(V(w, 0.22, 0.16), at * CF(0, -h / 2 + 0.6, -0.02), Kit.C.Gold, Enum.Material.Foil, { CastShadow = false })
	self:box(V(w * 0.42, w * 0.42, 0.14), at * CF(0, h * 0.12, -0.03) * ANG(0, 0, math.rad(45)), Kit.C.Gold, Enum.Material.Foil, { CastShadow = false })
end

function Builder:crate(at: CFrame, s: number?)
	local k = s or 3
	self:box(V(k, k, k), at, Kit.C.Planks, Enum.Material.WoodPlanks)
	self:box(V(k + 0.1, 0.3, k + 0.1), at * CF(0, k / 2 - 0.25, 0), Kit.C.Timber, Enum.Material.Wood)
	self:box(V(k + 0.1, 0.3, k + 0.1), at * CF(0, -k / 2 + 0.25, 0), Kit.C.Timber, Enum.Material.Wood)
end

function Builder:barrel(at: Vector3, s: number?)
	local k = s or 1
	self:cyl(3.2 * k, 2.4 * k, at + V(0, 1.6 * k, 0), Kit.C.TimberLight, Enum.Material.Wood)
	self:cyl(0.3, 2.55 * k, at + V(0, 0.6 * k, 0), Kit.C.Iron, Enum.Material.Metal)
	self:cyl(0.3, 2.55 * k, at + V(0, 2.6 * k, 0), Kit.C.Iron, Enum.Material.Metal)
end

-- Low stone wall segment between two local points (on the ground).
function Builder:stoneWall(a: Vector3, b: Vector3, height: number, thickness: number, color: Color3?)
	local d = b - a
	local len = Vector3.new(d.X, 0, d.Z).Magnitude
	if len < 0.5 then
		return
	end
	local mid = (a + b) / 2
	local cf = CFrame.lookAt(V(mid.X, mid.Y + height / 2, mid.Z), V(b.X, mid.Y + height / 2, b.Z))
	self:box(V(thickness, height, len), cf, color or Kit.C.Stone, Enum.Material.Cobblestone)
	self:box(V(thickness + 0.6, 0.6, len + 0.4), cf * CF(0, height / 2 + 0.3, 0), (color or Kit.C.Stone):Lerp(Color3.new(1, 1, 1), 0.08), Enum.Material.Slate)
end

function Builder:fence(a: Vector3, b: Vector3, height: number?)
	local h = height or 3.2
	local d = b - a
	local len = d.Magnitude
	local n = math.max(1, math.floor(len / 6))
	for i = 0, n do
		local p = a + d * (i / n)
		self:box(V(0.6, h, 0.6), p + V(0, h / 2, 0), Kit.C.Timber, Enum.Material.Wood)
	end
	for _, y in { h * 0.45, h * 0.85 } do
		self:beam(a + V(0, y, 0), b + V(0, y, 0), 0.35, Kit.C.TimberLight, Enum.Material.Wood)
	end
end

-- ============================================================== LEGO-style bricks
-- Chunky toy bricks with round studs on top (the game's building-block look).
Kit.STUD_PITCH = 4
Kit.STUD_D = 2.4
Kit.STUD_H = 0.8

local function studFinish(p: BasePart)
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
end

-- Rectangular brick: size (w, h, d) centred at `at`; studs on a 4-stud grid unless opts.NoStuds.
function Builder:brick(size: Vector3, at: any, color: Color3, opts: { [string]: any }?): Part
	local o = opts or {}
	local cf = toCF(at)
	local p = self:box(size, cf, color, Enum.Material.SmoothPlastic, o.Props)
	if not o.NoStuds then
		local nx = math.max(1, math.floor(size.X / Kit.STUD_PITCH + 0.5))
		local nz = math.max(1, math.floor(size.Z / Kit.STUD_PITCH + 0.5))
		for ix = 1, nx do
			for iz = 1, nz do
				local sx = (ix - (nx + 1) / 2) * Kit.STUD_PITCH
				local sz = (iz - (nz + 1) / 2) * Kit.STUD_PITCH
				local stud = self:cyl(Kit.STUD_H, Kit.STUD_D, cf * CF(sx, size.Y / 2 + Kit.STUD_H / 2, sz), color, Enum.Material.SmoothPlastic)
				studFinish(stud)
			end
		end
	end
	return p
end

-- Round brick (upright cylinder). opts.Studs: "Top" (centre cluster), "Ring" (ring of studs at
-- opts.RingRadius), "None". Returns the part.
function Builder:roundBrick(height: number, diameter: number, at: any, color: Color3, opts: { [string]: any }?): Part
	local o = opts or {}
	local cf = toCF(at)
	local p = self:cyl(height, diameter, cf, color, Enum.Material.SmoothPlastic, o.Props)
	local mode = o.Studs or "None"
	local topY = height / 2 + Kit.STUD_H / 2
	if mode == "Top" then
		local radius = diameter / 2 - Kit.STUD_D
		local n = radius > 1.5 and math.max(1, math.floor(2 * math.pi * radius / (Kit.STUD_PITCH * 1.05))) or 0
		studFinish(self:cyl(Kit.STUD_H, Kit.STUD_D, cf * CF(0, topY, 0), color, Enum.Material.SmoothPlastic))
		for i = 1, n do
			local a = (i - 0.5) / n * math.pi * 2
			studFinish(self:cyl(Kit.STUD_H, Kit.STUD_D, cf * CF(math.cos(a) * radius, topY, math.sin(a) * radius), color, Enum.Material.SmoothPlastic))
		end
	elseif mode == "Ring" then
		local radius = o.RingRadius or (diameter / 2 - Kit.STUD_D)
		local n = math.max(3, math.floor(2 * math.pi * radius / (Kit.STUD_PITCH * 1.05)))
		for i = 1, n do
			local a = (i - 0.5) / n * math.pi * 2
			studFinish(self:cyl(Kit.STUD_H, Kit.STUD_D, cf * CF(math.cos(a) * radius, topY, math.sin(a) * radius), o.StudColor or color, Enum.Material.SmoothPlastic))
		end
	end
	return p
end

function Builder:prompt(attachTo: BasePart, action: string, object: string, attrs: { [string]: any }?)
	local p = Instance.new("ProximityPrompt")
	p.ActionText = action
	p.ObjectText = object
	p.HoldDuration = 0
	p.MaxActivationDistance = 14
	p.RequiresLineOfSight = false
	p.KeyboardKeyCode = Enum.KeyCode.E
	for k, v in attrs or {} do
		p:SetAttribute(k, v)
	end
	p.Parent = attachTo
	return p
end

return Kit
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000085">
				<Properties>
					<string name="Name">Landmarks</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Landmarks - plaza statue + fountain, stone bridges, the Ruins of Aldermere,
	the Silverfall waterfall, Emberdeep cave decor and the Sky Pillar islands.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent:WaitForChild("Kit"))

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local C = Kit.C
local M = Kit.M

local Landmarks = {}

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

-- ============================================================== statue
-- Central dragon statue on a tiered plinth inside a fountain basin.
function Landmarks.statue(parent: Instance, at: Vector3, speciesId: string?)
	local b = Kit.new(parent, CF(at), "DragonStatue")
	local marble = Color3.fromRGB(206, 200, 188)
	-- fountain basin
	b:cyl(1.6, 40, V(0, 0.8, 0), C.Stone, M.Cobblestone)
	b:cyl(2.4, 41.5, V(0, 1.2, 0), C.StoneDark, M.Slate, { Transparency = 0 })
	b:cyl(0.6, 37.5, V(0, 2.1, 0), C.Water, M.Glass, { Transparency = 0.35, CanCollide = false })
	-- inner pool rim (hollow look: dark ring)
	b:cyl(2.5, 37, V(0, 1.15, 0), Color3.fromRGB(46, 70, 80), M.Slate)
	-- plinth tiers
	b:cyl(2, 20, V(0, 3, 0), marble, M.Limestone)
	b:cyl(2, 16, V(0, 5, 0), marble, M.Marble)
	b:box(V(11, 7, 11), V(0, 9.5, 0), marble, M.Marble)
	b:box(V(12.4, 1, 12.4), V(0, 13.5, 0), C.Gold, M.Foil)
	for _, sx in { -1, 1 } do
		for _, sz in { -1, 1 } do
			b:box(V(1.4, 7, 1.4), V(sx * 5.5, 9.5, sz * 5.5), C.Gold, M.Foil)
		end
	end
	-- water jets
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local spout = b:box(V(1.2, 1.2, 1.2), V(math.cos(a) * 10.5, 4.6, math.sin(a) * 10.5), marble, M.Marble)
		local att = Instance.new("Attachment")
		att.Parent = spout
		local pe = Instance.new("ParticleEmitter")
		pe.Texture = SPARKLE
		pe.Color = ColorSequence.new(Color3.fromRGB(200, 236, 255))
		pe.LightEmission = 0.4
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
		pe.Size = NumberSequence.new(0.6, 0.2)
		pe.Lifetime = NumberRange.new(0.7, 0.9)
		pe.Rate = 30
		pe.Speed = NumberRange.new(9, 11)
		pe.SpreadAngle = Vector2.new(4, 4)
		pe.Acceleration = V(0, -24, 0)
		pe.EmissionDirection = Enum.NormalId.Top
		pe.Parent = att
		att.CFrame = CF(0, 0.6, 0) * ANG(0, 0, -math.cos(a) * 0.5) * ANG(math.sin(a) * 0.5, 0, 0)
	end
	-- the dragon: skinned mesh template in stone if available, else part statue
	local top = at + V(0, 14, 0)
	local ok = pcall(function()
		local DragonVisual = require(ReplicatedStorage.Shared.Dragons.DragonVisual)
		local id = speciesId or "GreenDrake"
		if DragonVisual.hasMesh(id) then
			local model = DragonVisual.build(id, { ScaleOverride = 1.15 })
			local mesh = model:FindFirstChildWhichIsA("MeshPart", true)
			for _, d in model:GetDescendants() do
				if d:IsA("SurfaceAppearance") then
					d:Destroy()
				end
			end
			if mesh then
				mesh.TextureID = ""
				mesh.Material = Enum.Material.Marble
				mesh.Color = Color3.fromRGB(196, 190, 178)
			end
			model.Name = "StatueDragon"
			model.Parent = b.Model
			local Species = require(ReplicatedStorage.Shared.Dragons.Species)
			local def = Species.get(id)
			local hip = def.HipHeight * (def.Scale or 1) * 1.15
			DragonVisual.pose(model, nil, CF(top + V(0, hip, 0)) * ANG(0, math.pi, 0))
		else
			local Builder = require(ReplicatedStorage.Shared.Dragons.Builder)
			local Species = require(ReplicatedStorage.Shared.Dragons.Species)
			local model = Builder.build(id, { Statue = true, StatueColor = Color3.fromRGB(196, 190, 178), Saddle = false })
			local def = Species.get(id)
			local hip = def.HipHeight * (def.Scale or 1)
			Builder.pose(model, nil, CF(top + V(0, hip, 0)) * ANG(0, math.pi, 0))
			model.Name = "StatueDragon"
			model.Parent = b.Model
		end
	end)
	if not ok then
		warn("[World] statue dragon failed")
	end
	return b.Model
end

-- ============================================================== bridge
-- Stone arch bridge; local -Z runs along the road. data: Span, Deck, Water, Width.
function Landmarks.bridge(parent: Instance, data)
	local origin = CF(data.X, data.Deck, data.Z) * ANG(0, data.Yaw, 0)
	local b = Kit.new(parent, origin, "Bridge")
	local span, wdt = data.Span, data.Width
	local depth = data.Deck - (data.Water - 9)
	-- deck
	b:box(V(wdt, 1.6, span), V(0, -0.8, 0), C.Stone, M.Cobblestone)
	b:box(V(wdt - 2, 0.3, span), V(0, 0.15, 0), C.Planks, M.WoodPlanks)
	-- arch made of segments under the deck
	local n = 9
	for i = 0, n - 1 do
		local t0, t1 = i / n, (i + 1) / n
		local z0 = -span / 2 + span * t0
		local z1 = -span / 2 + span * t1
		local a0 = math.sin(t0 * math.pi)
		local a1 = math.sin(t1 * math.pi)
		local y0 = -depth + a0 * (depth - 2.5)
		local y1 = -depth + a1 * (depth - 2.5)
		b:beam(V(0, y0, z0), V(0, y1, z1), 1, C.StoneDark, M.Slate, { Size = V(wdt, 2.2, math.abs(z1 - z0) + 0.6) })
		-- spandrel fill between the arch and the deck
		local zm = (z0 + z1) / 2
		local ym = (y0 + y1) / 2
		local hfill = -1.6 - ym
		if hfill > 0.5 then
			b:box(V(wdt - 0.6, hfill, math.abs(z1 - z0)), V(0, ym + hfill / 2, zm), C.Stone, M.Cobblestone)
		end
	end
	-- parapets with posts and lanterns
	for _, sx in { -1, 1 } do
		b:box(V(1.2, 2.6, span), V(sx * (wdt / 2 - 0.6), 1.3, 0), C.StoneWarm, M.Cobblestone)
		b:box(V(1.6, 0.5, span + 0.4), V(sx * (wdt / 2 - 0.6), 2.85, 0), C.Stone, M.Slate)
		for _, sz in { -1, 1 } do
			b:box(V(2.2, 4.2, 2.2), V(sx * (wdt / 2 - 0.6), 2.1, sz * (span / 2 - 1.1)), C.StoneDark, M.Cobblestone)
			b:lampPost(V(sx * (wdt / 2 - 0.6), 4.2, sz * (span / 2 - 1.1)), 5)
		end
	end
	-- piers into the river bed
	for _, sz in { -1, 1 } do
		b:box(V(wdt + 1, depth + 4, 4), V(0, -depth / 2 - 2, sz * (span / 2 - 2)), C.StoneDark, M.Slate)
	end
	return b.Model
end

-- ============================================================== ruins
function Landmarks.ruins(parent: Instance, center: Vector3, groundAt: (number, number) -> number)
	local b = Kit.new(parent, CF(center), "RuinsOfAldermere")
	local rng = Random.new(1337)
	local stone = Color3.fromRGB(176, 168, 150)
	local moss = Color3.fromRGB(96, 118, 70)
	local function gy(x: number, z: number): number
		return groundAt(center.X + x, center.Z + z) - center.Y
	end
	-- ring colonnade
	local R = 34
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2
		local x, z = math.cos(a) * R, math.sin(a) * R
		local y = gy(x, z)
		local broken = rng:NextNumber()
		local h = broken < 0.35 and rng:NextNumber(4, 9) or 18
		b:box(V(3.6, 1.2, 3.6), V(x, y + 0.2, z), stone, M.Limestone)
		if broken < 0.12 then
			-- fallen column lying on the ground
			local fa = rng:NextNumber(0, math.pi * 2)
			b:cylX(14, 2.6, CF(x + math.cos(fa) * 7, y + 1.3, z + math.sin(fa) * 7) * ANG(0, fa, 0), stone, M.Limestone)
		else
			b:cyl(h, 2.6, V(x, y + 0.8 + h / 2, z), stone, M.Limestone)
			if h >= 18 then
				b:box(V(3.8, 1.2, 3.8), V(x, y + 0.8 + h + 0.6, z), stone, M.Limestone)
			end
			b:box(V(2.7, 0.3, 2.7), V(x, y + 0.8 + h - 0.1, z), moss, M.LeafyGrass, { CastShadow = false })
		end
	end
	-- lintels connecting standing column tops on one side
	for i = 0, 5 do
		local a0 = (i + 1) / 16 * math.pi * 2
		local a1 = (i + 2) / 16 * math.pi * 2
		local p0 = V(math.cos(a0) * R, gy(math.cos(a0) * R, math.sin(a0) * R) + 20.6, math.sin(a0) * R)
		local p1 = V(math.cos(a1) * R, gy(math.cos(a1) * R, math.sin(a1) * R) + 20.6, math.sin(a1) * R)
		if i ~= 3 then
			b:beam(p0, p1, 1, stone, M.Limestone, { Size = V(3, 2, (p1 - p0).Magnitude + 2) })
		end
	end
	-- central altar with a rune circle
	local ay = gy(0, 0)
	b:cyl(1, 22, V(0, ay + 0.4, 0), stone:Lerp(Color3.new(0, 0, 0), 0.15), M.Slate)
	b:cyl(1, 16, V(0, ay + 1.2, 0), stone, M.Limestone)
	b:box(V(8, 4, 5), V(0, ay + 3.6, 0), stone, M.Marble)
	local rune = b:cyl(0.2, 21, V(0, ay + 0.95, 0), Color3.fromRGB(110, 210, 255), M.Neon, { Transparency = 0.55, CastShadow = false, CanCollide = false })
	rune.Name = "RuneCircle"
	local orb = b:ball(2.2, V(0, ay + 7.4, 0), Color3.fromRGB(140, 220, 255), M.Neon, { CastShadow = false })
	local pl = Instance.new("PointLight")
	pl.Color = Color3.fromRGB(140, 220, 255)
	pl.Range = 30
	pl.Brightness = 2
	pl.Parent = orb
	-- broken arches + scattered blocks
	for k = 1, 3 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(48, 70)
		local x, z = math.cos(a) * r, math.sin(a) * r
		local y = gy(x, z)
		local yaw = rng:NextNumber(0, math.pi)
		local arch = b:sub("Arch" .. k, CF(x, y, z) * ANG(0, yaw, 0))
		arch:box(V(4, 16, 4), V(-7, 8, 0), stone, M.Limestone)
		arch:box(V(4, k == 2 and 9 or 16, 4), V(7, (k == 2 and 9 or 16) / 2, 0), stone, M.Limestone)
		if k ~= 2 then
			arch:box(V(18, 3, 4.2), V(0, 17.5, 0), stone, M.Limestone)
		end
	end
	for _ = 1, 22 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(20, 80)
		local x, z = math.cos(a) * r, math.sin(a) * r
		local s = rng:NextNumber(2, 5)
		b:box(V(s * 1.4, s, s), CF(x, gy(x, z) + s * 0.35, z) * ANG(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), rng:NextNumber(-0.3, 0.3)),
			stone:Lerp(moss, rng:NextNumber(0, 0.25)), M.Limestone)
	end
	return b.Model
end

-- ============================================================== waterfall
function Landmarks.waterfall(parent: Instance, top: Vector3, bottom: Vector3, width: number)
	local folder = Instance.new("Model")
	folder.Name = "Silverfall"
	folder.Parent = parent
	local anchor = Instance.new("Part")
	anchor.Name = "FallAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = V(1, 1, 1)
	anchor.CFrame = CF(top)
	anchor.Parent = folder
	local n = 7
	for i = 0, n - 1 do
		local off = (i / (n - 1) - 0.5) * width
		local a0 = Instance.new("Attachment")
		a0.WorldPosition = top + V(off, 0, 0)
		a0.Parent = anchor
		local a1 = Instance.new("Attachment")
		a1.WorldPosition = bottom + V(off * 1.15, 0, 0)
		a1.Parent = anchor
		local beam = Instance.new("Beam")
		beam.Attachment0 = a0
		beam.Attachment1 = a1
		beam.Texture = SMOKE
		beam.TextureMode = Enum.TextureMode.Wrap
		beam.TextureLength = 18
		beam.TextureSpeed = 2.2 + (i % 3) * 0.35
		beam.Width0 = width / n * 1.6
		beam.Width1 = width / n * 2.1
		beam.LightEmission = 0.35
		beam.LightInfluence = 0.6
		beam.Color = ColorSequence.new(Color3.fromRGB(226, 242, 255))
		beam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(0.85, 0.35), NumberSequenceKeypoint.new(1, 0.7) })
		beam.FaceCamera = true
		beam.Segments = 12
		beam.CurveSize0 = -6
		beam.CurveSize1 = 4
		beam.Parent = anchor
	end
	-- mist at the foot
	local mistPart = Instance.new("Part")
	mistPart.Name = "Mist"
	mistPart.Anchored = true
	mistPart.CanCollide = false
	mistPart.CanQuery = false
	mistPart.Transparency = 1
	mistPart.Size = V(width, 2, 12)
	mistPart.CFrame = CF(bottom + V(0, 2, 0))
	mistPart.Parent = folder
	local mist = Instance.new("ParticleEmitter")
	mist.Texture = SMOKE
	mist.Color = ColorSequence.new(Color3.fromRGB(240, 248, 255))
	mist.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 8), NumberSequenceKeypoint.new(1, 22) })
	mist.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 1) })
	mist.Lifetime = NumberRange.new(3, 5)
	mist.Rate = 14
	mist.Speed = NumberRange.new(4, 8)
	mist.SpreadAngle = Vector2.new(60, 60)
	mist.Acceleration = V(0, 2, 0)
	mist.LightEmission = 0.2
	mist.Parent = mistPart
	return folder
end

-- ============================================================== cave decor
function Landmarks.caveDecor(parent: Instance, path: { Vector3 })
	local b = Kit.new(parent, CFrame.identity, "Emberdeep")
	local rng = Random.new(77)
	for i, p in path do
		if i > 1 then
			for _ = 1, 4 do
				local off = V(rng:NextNumber(-12, 12), rng:NextNumber(-12, -6), rng:NextNumber(-12, 12))
				local h = rng:NextNumber(3, 8)
				local col = (i % 2 == 0) and Color3.fromRGB(255, 120, 60) or Color3.fromRGB(150, 110, 255)
				local gem = b:box(V(1.4, h, 1.4), CF(p + off) * ANG(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, 6), rng:NextNumber(-0.4, 0.4)),
					col, M.Neon, { CastShadow = false, Transparency = 0.05 })
				gem.Name = "Crystal"
			end
			local light = b:box(V(1, 1, 1), p + V(0, -4, 0), Color3.new(1, 1, 1), M.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false })
			local pl = Instance.new("PointLight")
			pl.Color = (i % 2 == 0) and Color3.fromRGB(255, 140, 80) or Color3.fromRGB(170, 130, 255)
			pl.Range = 34
			pl.Brightness = 1.8
			pl.Parent = light
		end
	end
	return b.Model
end

-- ============================================================== sky pillar islands
function Landmarks.skyIslands(parent: Instance, terrain: Terrain, center: Vector3, height: number)
	local rng = Random.new(2024)
	local b = Kit.new(parent, CFrame.identity, "SkyPillar")
	for i = 1, 6 do
		local a = i / 6 * math.pi * 2 + rng:NextNumber(-0.3, 0.3)
		local r = rng:NextNumber(90, 150)
		local y = rng:NextNumber(height * 0.45, height * 0.95)
		local p = center + V(math.cos(a) * r, y, math.sin(a) * r)
		local s = rng:NextNumber(10, 18)
		pcall(function()
			terrain:FillBall(p, s, Enum.Material.Rock)
			terrain:FillBall(p + V(0, s * 0.45, 0), s * 0.9, Enum.Material.Grass)
			terrain:FillBall(p + V(0, -s * 0.6, 0), s * 0.6, Enum.Material.Rock)
		end)
		for _ = 1, 3 do
			local off = V(rng:NextNumber(-s * 0.5, s * 0.5), -s * 0.9, rng:NextNumber(-s * 0.5, s * 0.5))
			b:box(V(1.2, 5, 1.2), CF(p + off) * ANG(math.pi + rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6), 0),
				Color3.fromRGB(120, 210, 255), M.Neon, { CastShadow = false })
		end
	end
	-- shrine on top of the pillar
	local topP = center + V(0, height + 2, 0)
	b:cyl(2, 26, topP + V(0, 1, 0), Color3.fromRGB(176, 168, 150), M.Limestone)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		b:cyl(10, 2, topP + V(math.cos(a) * 11, 6, math.sin(a) * 11), Color3.fromRGB(196, 190, 178), M.Marble)
	end
	local orb = b:ball(3.6, topP + V(0, 7, 0), Color3.fromRGB(150, 230, 255), M.Neon, { CastShadow = false })
	local pl = Instance.new("PointLight")
	pl.Color = Color3.fromRGB(150, 230, 255)
	pl.Range = 40
	pl.Brightness = 2.5
	pl.Parent = orb
	return b.Model
end

return Landmarks
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000086">
				<Properties>
					<string name="Name">Props</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Props - trees, bushes and rocks from the generated layout.

	Uses mesh templates from ReplicatedStorage.WorldProps (imported
	HavenProps.glb: Oak*, Pine*, Birch*, Bush*, Rock*) when present, otherwise
	builds light part-based stand-ins so the world is never bare.
	Instances are grouped per 256-stud cell (streaming friendly).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Props = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles

local CELL = 256

local function cellFolder(root: Instance, cells: { [string]: Instance }, x: number, z: number): Instance
	local key = math.floor(x / CELL) .. "_" .. math.floor(z / CELL)
	local f = cells[key]
	if not f then
		f = Instance.new("Model")
		f.Name = "Cell_" .. key
		f.Parent = root
		pcall(function()
			(f :: any).ModelStreamingMode = Enum.ModelStreamingMode.Default
		end)
		cells[key] = f
	end
	return f
end

-- templates: { [prefix] = { Model|BasePart } } collected from ReplicatedStorage.WorldProps
local function collectTemplates(): { [string]: { Instance } }
	local out = {}
	local folder = ReplicatedStorage:FindFirstChild("WorldProps")
	if not folder then
		return out
	end
	for _, d in folder:GetDescendants() do
		if d:IsA("MeshPart") then
			local prefix = string.match(d.Name, "^(%a+)")
			if prefix then
				out[prefix] = out[prefix] or {}
				table.insert(out[prefix], d)
			end
		end
	end
	return out
end

local function placeMesh(template: BasePart, parent: Instance, cf: CFrame, scale: number)
	local p = template:Clone()
	p.Anchored = true
	-- foliage is walk/fly-through (no invisible hull walls); rocks are solid
	local solid = string.sub(template.Name, 1, 4) == "Rock"
	p.CanCollide = solid
	p.CanQuery = solid
	p.CanTouch = false
	p.Size = template.Size * scale
	-- template pivot = bottom centre (stored by the importer helper) or the part centre
	local base = template:GetAttribute("BaseOffset") or (template.Size.Y / 2)
	p.CFrame = cf * CF(0, base * scale, 0)
	p.Parent = parent
	return p
end

-- ============================================================== fallbacks
local LEAF = { Oak = Color3.fromRGB(66, 104, 50), Pine = Color3.fromRGB(46, 78, 52), Birch = Color3.fromRGB(116, 150, 70) }
local BARK = { Oak = Color3.fromRGB(88, 66, 48), Pine = Color3.fromRGB(78, 58, 44), Birch = Color3.fromRGB(214, 210, 198) }

local function ellipsoid(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CastShadow = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	p.Parent = parent
	return p
end

local function fallbackTree(parent: Instance, kind: string, cf: CFrame, s: number, rng: Random)
	local model = Instance.new("Model")
	model.Name = kind
	local h = (kind == "Pine" and 22 or (kind == "Birch" and 18 or 16)) * s
	local trunk = Instance.new("Part")
	trunk.Anchored = true
	trunk.Shape = Enum.PartType.Cylinder
	trunk.Size = V(h * 0.75, 1.6 * s, 1.6 * s)
	trunk.CFrame = cf * CF(0, h * 0.375, 0) * ANG(0, 0, math.rad(90))
	trunk.Color = BARK[kind]
	trunk.Material = Enum.Material.Wood
	trunk.Parent = model
	local leaf = LEAF[kind]
	local mat = Enum.Material.LeafyGrass
	if kind == "Pine" then
		for i = 0, 2 do
			local k = 1 - i * 0.28
			ellipsoid(model, V(10 * k * s, 9 * s, 10 * k * s), cf * CF(0, h * (0.38 + i * 0.2), 0), leaf:Lerp(Color3.new(0, 0, 0), i * 0.05), mat)
		end
	else
		ellipsoid(model, V(13 * s, 10 * s, 13 * s), cf * CF(0, h * 0.78, 0), leaf, mat)
		for i = 1, 2 do
			local a = rng:NextNumber(0, math.pi * 2)
			ellipsoid(model, V(9 * s, 7.5 * s, 9 * s), cf * CF(math.cos(a) * 4 * s, h * (0.62 + 0.1 * i), math.sin(a) * 4 * s),
				leaf:Lerp(Color3.fromRGB(150, 160, 70), 0.12 * i), mat)
		end
	end
	model.Parent = parent
	return model
end

local function fallbackRock(parent: Instance, cf: CFrame, s: number, rng: Random)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = V(6, 4, 5) * s * V(rng:NextNumber(0.8, 1.3), rng:NextNumber(0.7, 1.1), rng:NextNumber(0.8, 1.3))
	p.CFrame = cf * CF(0, p.Size.Y * 0.35, 0) * ANG(rng:NextNumber(-0.3, 0.3), 0, rng:NextNumber(-0.3, 0.3))
	p.Color = Color3.fromRGB(116, 114, 108)
	p.Material = Enum.Material.Rock
	p.Parent = parent
	return p
end

-- ============================================================== build
function Props.build(parent: Instance, layout, opts: { [string]: any }?)
	local o = opts or {}
	local root = Instance.new("Folder")
	root.Name = "Nature"
	root.Parent = parent
	local cells = {}
	local templates = collectTemplates()
	local useMesh = next(templates) ~= nil
	local rng = Random.new(99)
	local stride = useMesh and 1 or (o.FallbackStride or 2)
	local kinds = layout.TreeKinds
	local count = 0
	for i, t in layout.Trees do
		if i % stride == 0 or stride == 1 then
			local kind = kinds[t[1]]
			local cf = CF(t[2], t[3] - 0.4, t[4]) * ANG(0, t[5], 0)
			local f = cellFolder(root, cells, t[2], t[4])
			local list = templates[kind]
			if list then
				placeMesh(list[(i % #list) + 1] :: BasePart, f, cf, t[6])
			else
				fallbackTree(f, kind, cf, t[6], rng)
			end
			count += 1
			if count % 200 == 0 then
				task.wait()
			end
		end
	end
	for i, b in layout.Bushes do
		local list = templates.Bush
		if list then
			local f = cellFolder(root, cells, b[1], b[3])
			placeMesh(list[(i % #list) + 1] :: BasePart, f, CF(b[1], b[2] - 0.3, b[3]) * ANG(0, b[4], 0), b[5])
		elseif i % 3 == 0 then
			local f = cellFolder(root, cells, b[1], b[3])
			ellipsoid(f, V(6, 3.6, 6) * b[5], CF(b[1], b[2] + 1, b[3]), LEAF.Oak:Lerp(Color3.fromRGB(120, 140, 60), 0.3), Enum.Material.LeafyGrass)
		end
	end
	for i, r in layout.Rocks do
		local f = cellFolder(root, cells, r[1], r[3])
		local list = templates.Rock
		local cf = CF(r[1], r[2], r[3]) * ANG(0, r[4], 0)
		if list then
			placeMesh(list[(r[6] % #list) + 1] :: BasePart, f, cf, r[5])
		else
			fallbackRock(f, cf, r[5], rng)
		end
		if i % 200 == 0 then
			task.wait()
		end
	end
	root:SetAttribute("MeshProps", useMesh)
	return root
end

return Props
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000087">
				<Properties>
					<string name="Name">Sanctuaries</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Sanctuaries - the 8 personal dragon sanctuaries (plots) around the hub.
	Each plot: stone-walled terrace, gate arch with the owner's banner and
	sign, central nest (eggs), eight dragon perches, income shrine, lanterns.

	Logic-bearing pieces are tagged with attributes so services can find them:
	  plot model attributes: PlotId, OwnerUserId (0 = free)
	  "Nest" part, "Perch1".."Perch8" parts (dragon display slots, layout in
	  WorldConfig.Sanctuary), "PerchGem1".."PerchGem8" (lit when unlocked),
	  "Shrine" part (income collector), "Sign" part (SurfaceGui text),
	  "BannerCloth" parts (tinted with the owner's colour).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent:WaitForChild("Kit"))
local WorldConfig = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("WorldConfig"))

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local C = Kit.C
local M = Kit.M

local Sanctuaries = {}

local W, D = 124, 104 -- matches WorldConfig.PlotSize

local function signGui(part: BasePart, text: string)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "SignGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 36
	gui.LightInfluence = 0.8
	gui.Parent = part
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.Fondamento
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(250, 228, 170)
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(36, 24, 14)
	stroke.Parent = label
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.05, 0)
	pad.PaddingRight = UDim.new(0.05, 0)
	pad.PaddingTop = UDim.new(0.1, 0)
	pad.PaddingBottom = UDim.new(0.1, 0)
	pad.Parent = label
	label.Parent = gui
	return label
end

-- Big floating name plate above the gate (BillboardGui, constant pixel size) so
-- every player can see from the hub whose sanctuary this is.
local TAG_FREE = Color3.fromRGB(150, 160, 178)
local TAG_HEIGHT = 44 -- above the plot floor; the gate arch tops out at ~22

local function nameGui(part: BasePart, plotId: number)
	local gui = Instance.new("BillboardGui")
	gui.Name = "NameGui"
	gui.Size = UDim2.fromOffset(300, 74)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 1600
	gui.LightInfluence = 0
	gui.Adornee = part
	local pill = Instance.new("Frame")
	pill.Name = "Pill"
	pill.Size = UDim2.fromScale(1, 1)
	pill.BackgroundColor3 = Color3.fromRGB(18, 22, 32)
	pill.BackgroundTransparency = 0.1
	pill.BorderSizePixel = 0
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.28, 0)
	corner.Parent = pill
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Stroke"
	stroke.Thickness = 3
	stroke.Color = TAG_FREE
	stroke.Parent = pill
	local name = Instance.new("TextLabel")
	name.Name = "OwnerLabel"
	name.BackgroundTransparency = 1
	name.AnchorPoint = Vector2.new(0.5, 0)
	name.Position = UDim2.fromScale(0.5, 0.08)
	name.Size = UDim2.fromScale(0.9, 0.54)
	name.Font = Enum.Font.GothamBlack
	name.TextScaled = true
	name.TextColor3 = Color3.fromRGB(190, 198, 212)
	name.Text = "FREE"
	local limit = Instance.new("UITextSizeConstraint")
	limit.MaxTextSize = 34
	limit.MinTextSize = 10
	limit.Parent = name
	name.Parent = pill
	local sub = Instance.new("TextLabel")
	sub.Name = "PlotLabel"
	sub.BackgroundTransparency = 1
	sub.AnchorPoint = Vector2.new(0.5, 0)
	sub.Position = UDim2.fromScale(0.5, 0.64)
	sub.Size = UDim2.fromScale(0.9, 0.24)
	sub.Font = Enum.Font.GothamBold
	sub.TextScaled = true
	sub.TextColor3 = TAG_FREE
	sub.Text = "SANCTUARY " .. plotId
	local subLimit = Instance.new("UITextSizeConstraint")
	subLimit.MaxTextSize = 15
	subLimit.MinTextSize = 8
	subLimit.Parent = sub
	sub.Parent = pill
	pill.Parent = gui
	gui.Parent = part
	return gui
end

local function nest(b, at: Vector3)
	-- stone dais + woven twig ring + soft bedding
	b:cyl(1.6, 22, at + V(0, 0.8, 0), C.StoneDark, M.Slate)
	b:cyl(0.6, 23, at + V(0, 1.7, 0), C.Stone, M.Cobblestone)
	local n = 22
	for i = 0, n - 1 do
		local a = i / n * math.pi * 2
		local r = 8.2
		local p = at + V(math.cos(a) * r, 3.0, math.sin(a) * r)
		local seg = b:box(V(1.6, 1.4, 3.0), CF(p) * ANG(0, -a, 0) * ANG(math.rad(10 * ((i % 2) * 2 - 1)), 0, 0),
			(i % 3 == 0) and C.TimberLight or C.Timber, M.Wood)
		seg.Name = "Twig"
		local p2 = at + V(math.cos(a + 0.14) * (r - 1.2), 2.4, math.sin(a + 0.14) * (r - 1.2))
		b:box(V(1.2, 1.0, 2.6), CF(p2) * ANG(0, -a - 0.14, 0), C.TimberLight, M.Wood)
	end
	local bed = b:cyl(0.8, 15, at + V(0, 2.2, 0), Color3.fromRGB(176, 150, 104), M.Fabric)
	bed.Name = "Nest"
	return bed
end

-- Gem colours: lit when the owner has unlocked the perch, dark glass otherwise
-- (SanctuaryService.setPerchGem).
local GEM_LIT = Color3.fromRGB(120, 210, 255)
local GEM_DARK = Color3.fromRGB(70, 74, 86)

-- cf: plot-local perch frame at the standing surface (-Z faces the nest).
local function perch(b, cf: CFrame, i: number)
	local at = Vector3.new(cf.Position.X, 0, cf.Position.Z)
	local surface = cf.Position.Y
	b:cyl(surface - 0.6, 13.5, at + V(0, (surface - 0.6) / 2, 0), C.StoneDark, M.Slate)
	b:cyl(0.6, 12.4, at + V(0, surface - 0.3, 0), C.Stone, M.Cobblestone)
	-- soft bedding ring the dragon rests on
	b:cyl(0.22, 9.6, at + V(0, surface + 0.02, 0), Color3.fromRGB(146, 122, 82), M.Fabric, { CanCollide = false })
	local top = b:box(V(10, 0.4, 10), CF(at + V(0, surface - 0.2, 0)) * cf.Rotation, C.StoneWarm, M.Limestone,
		{ Transparency = 1, CanCollide = false, CanQuery = false })
	top.Name = "Perch" .. i
	top:SetAttribute("Slot", i)
	-- rune crystal on the outer rim (beside the tail, never under it)
	local out = -cf.LookVector
	local right = cf.RightVector
	local rim = at + (out * 0.55 + right * 0.83).Unit * 6.0
	b:box(V(1.7, 0.9, 1.7), CF(rim + V(0, surface + 0.35, 0)) * cf.Rotation, C.StoneDark, M.Slate)
	local gem = b:box(V(0.9, 2.4, 0.9), CF(rim + V(0, surface + 1.9, 0)) * cf.Rotation * ANG(0, 0.6, 0.18),
		GEM_DARK, M.Glass, { CastShadow = false, Transparency = 0.15 })
	gem.Name = "PerchGem" .. i
	gem:SetAttribute("Slot", i)
end

-- Lights or dims a perch crystal (unlocked / locked).
function Sanctuaries.setPerchGem(model: Model, i: number, lit: boolean)
	local gem = model:FindFirstChild("PerchGem" .. i, true)
	if gem and gem:IsA("BasePart") then
		gem.Color = lit and GEM_LIT or GEM_DARK
		gem.Material = lit and M.Neon or M.Glass
		gem.Transparency = lit and 0.1 or 0.15
	end
end

function Sanctuaries.build(parent: Instance, plot: { [string]: any })
	local cx, cz = plot.Center.X, plot.Center.Z
	local y = plot.Height
	local origin = CF(cx, y, cz) * ANG(0, plot.Facing, 0)
	local b = Kit.new(parent, origin, "Plot" .. plot.Id)
	b.Model:SetAttribute("PlotId", plot.Id)
	b.Model:SetAttribute("OwnerUserId", 0)
	-- low stone wall around the terrace with a gate gap at the front
	local hw, hd = W / 2, D / 2
	local wallH = 3.6
	local corners = { V(-hw, 0, -hd), V(hw, 0, -hd), V(hw, 0, hd), V(-hw, 0, hd) }
	b:stoneWall(V(-hw, 0, -hd), V(-11, 0, -hd), wallH, 2.2)
	b:stoneWall(V(11, 0, -hd), V(hw, 0, -hd), wallH, 2.2)
	b:stoneWall(corners[2], corners[3], wallH, 2.2)
	b:stoneWall(corners[3], corners[4], wallH, 2.2)
	b:stoneWall(corners[4], corners[1], wallH, 2.2)
	for _, p in corners do
		b:box(V(4, wallH + 2.4, 4), p + V(0, (wallH + 2.4) / 2, 0), C.StoneDark, M.Cobblestone)
		b:lampPost(p + V(p.X > 0 and -5 or 5, 0, p.Z > 0 and -5 or 5), 8)
	end
	-- gate arch with banners and the owner sign
	for _, sx in { -1, 1 } do
		b:box(V(4.4, 18, 4.4), V(sx * 11, 9, -hd), C.Stone, M.Cobblestone)
		b:box(V(5.2, 1.2, 5.2), V(sx * 11, 18.6, -hd), C.StoneDark, M.Slate)
		local banner = b:sub("Banner")
		banner:banner(CF(sx * 11, 10, -hd - 2.4), 3.6, 9, C.BannerBlue)
		for _, d in banner.Model:GetDescendants() do
			if d:IsA("BasePart") and d.Material == Enum.Material.Fabric then
				d.Name = "BannerCloth"
			end
		end
	end
	b:box(V(26, 2.6, 4.6), V(0, 19.8, -hd), C.StoneWarm, M.Cobblestone)
	b:box(V(27, 0.8, 5.2), V(0, 21.5, -hd), C.StoneDark, M.Slate)
	local sign = b:box(V(16, 3.2, 0.6), V(0, 15.4, -hd - 2.1), C.Planks, M.WoodPlanks)
	sign.Name = "Sign"
	b:box(V(16.8, 0.4, 0.8), V(0, 17.2, -hd - 2.1), C.Gold, M.Foil)
	b:box(V(16.8, 0.4, 0.8), V(0, 13.6, -hd - 2.1), C.Gold, M.Foil)
	b:box(V(0.4, 3.2, 0.4), V(-4, 18.6, -hd - 2.1), C.Iron, M.Metal)
	b:box(V(0.4, 3.2, 0.4), V(4, 18.6, -hd - 2.1), C.Iron, M.Metal)
	signGui(sign, "Free Sanctuary")
	local tag = b:box(V(1, 1, 1), V(0, TAG_HEIGHT, -hd), C.Stone, M.SmoothPlastic,
		{ Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false })
	tag.Name = "NameTag"
	nameGui(tag, plot.Id)
	-- path from the gate to the nest
	for i = 0, 6 do
		b:box(V(9 - (i % 2) * 1.5, 0.4, 5), V(((i % 2) - 0.5) * 1.2, 0.05, -hd + 6 + i * 6.4), C.Stone, M.Slate)
	end
	-- nest (centre) and the horseshoe of dragon perches around it
	local layout = WorldConfig.Sanctuary
	nest(b, layout.Nest)
	for i = 1, layout.PerchCount do
		perch(b, WorldConfig.perchLocal(i), i)
	end
	-- income shrine (front-right, beside the gate path)
	local shrineAt = layout.Shrine
	b:cyl(1.2, 10, shrineAt + V(0, 0.6, 0), C.StoneDark, M.Slate)
	b:box(V(4.6, 6, 4.6), shrineAt + V(0, 4.2, 0), C.StoneWarm, M.Limestone)
	b:box(V(5.6, 0.8, 5.6), shrineAt + V(0, 7.6, 0), C.Gold, M.Foil)
	local orb = b:ball(3.2, shrineAt + V(0, 9.8, 0), Color3.fromRGB(255, 214, 110), M.Neon, { CastShadow = false })
	orb.Name = "Shrine"
	local pl = Instance.new("PointLight")
	pl.Color = Color3.fromRGB(255, 210, 120)
	pl.Range = 18
	pl.Brightness = 1.4
	pl.Parent = orb
	-- flower beds along the side walls
	local rng = Random.new(plot.Id * 31)
	for _, sx in { -1, 1 } do
		for i = 0, 5 do
			local p = V(sx * (hw - 6), 0.4, -hd + 14 + i * 14)
			b:box(V(4, 0.8, 9), p, C.Timber, M.Wood)
			for k = 0, 4 do
				local col = ({ Color3.fromRGB(214, 70, 90), Color3.fromRGB(240, 200, 80), Color3.fromRGB(150, 110, 220) })[rng:NextInteger(1, 3)]
				b:ball(1.1, p + V(rng:NextNumber(-1.2, 1.2), 0.9, -3.6 + k * 1.8), col, M.SmoothPlastic, { CanCollide = false, CastShadow = false })
			end
		end
	end
	return b.Model
end

-- Owner visuals: gate sign, floating name plate and banner colour (called by SanctuaryService).
function Sanctuaries.setOwner(model: Model, ownerName: string?, color: Color3?)
	local sign = model:FindFirstChild("Sign", true)
	local label = sign and sign:FindFirstChild("SignGui") and (sign :: any).SignGui:FindFirstChild("Text")
	if label then
		label.Text = ownerName and (ownerName .. "'s Sanctuary") or "Free Sanctuary"
	end
	local tag = model:FindFirstChild("NameTag", true)
	local pill = tag and tag:FindFirstChild("NameGui") and (tag :: any).NameGui:FindFirstChild("Pill")
	if pill then
		local accent = color and color:Lerp(Color3.new(1, 1, 1), 0.35) or TAG_FREE
		local ownerLabel = pill:FindFirstChild("OwnerLabel") :: TextLabel
		local plotLabel = pill:FindFirstChild("PlotLabel") :: TextLabel
		local stroke = pill:FindFirstChild("Stroke") :: UIStroke
		ownerLabel.Text = ownerName or "FREE"
		ownerLabel.TextColor3 = ownerName and Color3.new(1, 1, 1) or Color3.fromRGB(190, 198, 212)
		plotLabel.TextColor3 = accent
		stroke.Color = accent
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name == "BannerCloth" then
			d.Color = color or C.BannerBlue
		end
	end
end

return Sanctuaries
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000088">
				<Properties>
					<string name="Name">TerrainWriter</string>
					<ProtectedString name="Source"><![CDATA[--[[
	TerrainWriter
	Writes Roblox smooth terrain from compact generated map data
	(HavenTerrainData: 8-stud uint16 heightmap, material indices, RLE water
	levels, cave carve capsules).

	Column function (identical to toolchain/worldgen/terrain_data.py):
	  height   = bilinear(heightmap) + hash detail (+-0.6 studs)
	  material = one of the 4 surrounding map materials, chosen with
	             probability equal to its bilinear weight (dithered borders)
	  water    = bilinear water level where all 4 samples are wet, else max
	Each column is filled from just below its lowest neighbour (closes cliff
	faces) up to its surface; deeper only where caves are carved.

	Uses WriteVoxelChannels (solid + liquid in one voxel = clean shorelines)
	when available, otherwise WriteVoxels.
]]

local TerrainWriter = {}

local M32 = 4294967296
local bxor, rshift, band, lshift, bor = bit32.bxor, bit32.rshift, bit32.band, bit32.lshift, bit32.bor
local floor, ceil, min, max, clamp, sqrt = math.floor, math.ceil, math.min, math.max, math.clamp, math.sqrt

-- ============================================================== decoding
local B64 = {}
do
	local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for i = 1, 64 do
		B64[string.byte(alphabet, i)] = i - 1
	end
end

local function decode(chunks: { string }): buffer
	local s = table.concat(chunks)
	local n = #s
	local pad = 0
	if string.sub(s, -1) == "=" then
		pad += 1
	end
	if string.sub(s, -2, -2) == "=" then
		pad += 1
	end
	local outLen = (n // 4) * 3 - pad
	local out = buffer.create(outLen)
	local o = 0
	for i = 1, n, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local v = bor(lshift(B64[a] or 0, 18), lshift(B64[b] or 0, 12), lshift(B64[c] or 0, 6), B64[d] or 0)
		if o < outLen then
			buffer.writeu8(out, o, rshift(v, 16))
		end
		if o + 1 < outLen then
			buffer.writeu8(out, o + 1, band(rshift(v, 8), 255))
		end
		if o + 2 < outLen then
			buffer.writeu8(out, o + 2, band(v, 255))
		end
		o += 3
	end
	return out
end
TerrainWriter.decode = decode

local function hash01(ix: number, iy: number, seed: number): number
	local h = (ix * 73856093) % M32
	h = bxor(h, (iy * 19349663) % M32)
	h = bxor(h, seed % M32)
	h = (h * 69069 + 1013904223) % M32
	h = bxor(h, rshift(h, 15))
	h = (h * 40503 + 12345) % M32
	h = bxor(h, rshift(h, 13))
	return (h % 16777216) / 16777216
end
TerrainWriter.hash01 = hash01

-- ============================================================== map
export type Map = {
	N: number,
	Grid: number,
	Extent: number,
	H: buffer,
	M: buffer,
	W: buffer,
	Materials: { Enum.Material },
	Sub: { Enum.Material },
	Carves: { { number } },
}

function TerrainWriter.load(data): Map
	local N = data.N
	local H = decode(data.Heights)
	local M = decode(data.Mats)
	-- water: RLE (count, value) uint16 pairs -> full uint16 grid
	local rle = decode(data.Water)
	local W = buffer.create(N * N * 2)
	local o = 0
	for i = 0, buffer.len(rle) - 4, 4 do
		local count = buffer.readu16(rle, i)
		local value = buffer.readu16(rle, i + 2)
		if value ~= 0 then
			for k = o, o + count - 1 do
				buffer.writeu16(W, k * 2, value)
			end
		end
		o += count
	end
	local mats, subs = {}, {}
	for i, name in data.Materials do
		mats[i] = (Enum.Material :: any)[name]
	end
	for i, name in data.SubMaterials do
		subs[i] = (Enum.Material :: any)[name]
	end
	return {
		N = N,
		Grid = data.Grid,
		Extent = data.Extent,
		H = H,
		M = M,
		W = W,
		Materials = mats,
		Sub = subs,
		Carves = data.Carves or {},
	}
end

-- Column sample at world (x, z): height, material index (1-based), water level (0 = dry).
function TerrainWriter.sample(map: Map, x: number, z: number): (number, number, number)
	local N, G, E = map.N, map.Grid, map.Extent
	local fx = clamp((x + E) / G, 0, N - 1.000001)
	local fz = clamp((z + E) / G, 0, N - 1.000001)
	local ix, iz = floor(fx), floor(fz)
	local tx, tz = fx - ix, fz - iz
	local H, M, W = map.H, map.M, map.W
	local i00 = iz * N + ix
	local i10 = i00 + 1
	local i01 = i00 + N
	local i11 = i01 + 1
	local h00, h10 = buffer.readu16(H, i00 * 2) / 64, buffer.readu16(H, i10 * 2) / 64
	local h01, h11 = buffer.readu16(H, i01 * 2) / 64, buffer.readu16(H, i11 * 2) / 64
	local h = (h00 * (1 - tx) + h10 * tx) * (1 - tz) + (h01 * (1 - tx) + h11 * tx) * tz
	local cx, cz = floor(x / 4), floor(z / 4)
	h += (hash01(cx, cz, 977) - 0.5) * 1.2
	local rnd = hash01(cx, cz, 433)
	local w00 = (1 - tx) * (1 - tz)
	local w10 = tx * (1 - tz)
	local w01 = (1 - tx) * tz
	local mi
	if rnd < w00 then
		mi = buffer.readu8(M, i00)
	elseif rnd < w00 + w10 then
		mi = buffer.readu8(M, i10)
	elseif rnd < w00 + w10 + w01 then
		mi = buffer.readu8(M, i01)
	else
		mi = buffer.readu8(M, i11)
	end
	local a, b = buffer.readu16(W, i00 * 2) / 64, buffer.readu16(W, i10 * 2) / 64
	local c, d = buffer.readu16(W, i01 * 2) / 64, buffer.readu16(W, i11 * 2) / 64
	local water = 0
	if a > 0 and b > 0 and c > 0 and d > 0 then
		water = (a * (1 - tx) + b * tx) * (1 - tz) + (c * (1 - tx) + d * tx) * tz
	else
		water = max(a, b, c, d)
	end
	return h, mi + 1, water
end

function TerrainWriter.heightAt(map: Map, x: number, z: number): number
	local h = TerrainWriter.sample(map, x, z)
	return h
end

-- ============================================================== caves
local function segDist(px, py, pz, c): (number, number)
	local ax, ay, az, bx, by, bz, r0, r1 = c[1], c[2], c[3], c[4], c[5], c[6], c[7], c[8]
	local dx, dy, dz = bx - ax, by - ay, bz - az
	local l2 = dx * dx + dy * dy + dz * dz
	local t = l2 > 1e-9 and clamp(((px - ax) * dx + (py - ay) * dy + (pz - az) * dz) / l2, 0, 1) or 0
	local qx, qy, qz = ax + dx * t - px, ay + dy * t - py, az + dz * t - pz
	return sqrt(qx * qx + qy * qy + qz * qz), r0 + (r1 - r0) * t
end

-- horizontal distance from (px, pz) to a carve segment and its radius there
local function segDist2D(px, pz, c): (number, number)
	local ax, az, bx, bz, r0, r1 = c[1], c[3], c[4], c[6], c[7], c[8]
	local dx, dz = bx - ax, bz - az
	local l2 = dx * dx + dz * dz
	local t = l2 > 1e-9 and clamp(((px - ax) * dx + (pz - az) * dz) / l2, 0, 1) or 0
	local qx, qz = ax + dx * t - px, az + dz * t - pz
	return sqrt(qx * qx + qz * qz), r0 + (r1 - r0) * t
end

local function carvesNear(map: Map, x0: number, z0: number, x1: number, z1: number)
	local out = {}
	for _, c in map.Carves do
		local r = max(c[7], c[8]) + 12
		local cx0, cx1 = min(c[1], c[4]) - r, max(c[1], c[4]) + r
		local cz0, cz1 = min(c[3], c[6]) - r, max(c[3], c[6]) + r
		if cx1 >= x0 and cx0 <= x1 and cz1 >= z0 and cz0 <= z1 then
			table.insert(out, c)
		end
	end
	return out
end

-- ============================================================== writing
local AIR = Enum.Material.Air
local WATER = Enum.Material.Water

-- Builds voxel arrays for one chunk (CHUNK x CHUNK studs at x0, z0).
local function buildChunk(map: Map, x0: number, z0: number, size: number)
	local n = size // 4
	-- column samples incl. a 1-column border for neighbour minima
	local hs, ms, ws = {}, {}, {}
	for i = 0, n + 1 do
		local hrow, mrow, wrow = {}, {}, {}
		for k = 0, n + 1 do
			local x = x0 + (i - 0.5) * 4
			local z = z0 + (k - 0.5) * 4
			local h, mi, w = TerrainWriter.sample(map, x, z)
			hrow[k] = h
			mrow[k] = mi
			wrow[k] = w
		end
		hs[i], ms[i], ws[i] = hrow, mrow, wrow
	end
	local carves = carvesNear(map, x0, z0, x0 + size, z0 + size)
	local bottoms = {}
	local yLo, yHi = math.huge, -math.huge
	for i = 1, n do
		local brow = {}
		for k = 1, n do
			local h = hs[i][k]
			local lo = min(h, hs[i - 1][k], hs[i + 1][k], hs[i][k - 1], hs[i][k + 1]) - 8
			if #carves > 0 then
				local x = x0 + (i - 0.5) * 4
				local z = z0 + (k - 0.5) * 4
				for _, c in carves do
					-- columns over a tunnel stay solid down below its floor
					local d, r = segDist2D(x, z, c)
					if d < r + 12 then
						lo = min(lo, min(c[2], c[5]) - r - 10)
					end
				end
			end
			brow[k] = lo
			yLo = min(yLo, lo)
			yHi = max(yHi, h + 4, ws[i][k] + 4)
		end
		bottoms[i] = brow
	end
	yLo = floor(yLo / 4) * 4
	yHi = ceil(yHi / 4) * 4
	local ny = (yHi - yLo) // 4
	local mats = table.create(n)
	local occ = table.create(n)
	local liq = table.create(n)
	local hasLiquid = false
	for i = 1, n do
		local mi_, oi, li = table.create(ny), table.create(ny), table.create(ny)
		for j = 1, ny do
			mi_[j] = table.create(n, AIR)
			oi[j] = table.create(n, 0)
			li[j] = table.create(n, 0)
		end
		for k = 1, n do
			local h = hs[i][k]
			local w = ws[i][k]
			local idx = ms[i][k]
			local surf = map.Materials[idx] or Enum.Material.Grass
			local sub = map.Sub[idx] or Enum.Material.Rock
			local bottom = bottoms[i][k]
			local x = x0 + (i - 0.5) * 4
			local z = z0 + (k - 0.5) * 4
			for j = 1, ny do
				local y0 = yLo + (j - 1) * 4
				local y1 = y0 + 4
				if y1 > bottom then
					local o = clamp((h - y0) / 4, 0, 1)
					if o > 0 then
						mi_[j][k] = (h - y1 < 5) and surf or sub
						oi[j][k] = o
					end
					if w > 0 and w > y0 and o < 1 then
						local lo = clamp((w - y0) / 4, 0, 1)
						li[j][k] = lo
						hasLiquid = true
					end
				end
				if #carves > 0 and oi[j][k] > 0 then
					local yc = y0 + 2
					for _, c in carves do
						local d, r = segDist(x, yc, z, c)
						if d < r + 4 then
							local keep = clamp((d - r) / 4 + 0.5, 0, 1)
							if keep < oi[j][k] then
								oi[j][k] = keep
								if keep <= 0 then
									mi_[j][k] = AIR
								else
									mi_[j][k] = Enum.Material.Rock
								end
							end
						end
					end
				end
			end
		end
		mats[i], occ[i], liq[i] = mi_, oi, li
	end
	return Region3.new(Vector3.new(x0, yLo, z0), Vector3.new(x0 + size, yHi, z0 + size)), mats, occ, liq, hasLiquid
end
TerrainWriter.buildChunk = buildChunk

local channelsSupported: boolean? = nil

local function writeChunk(terrain: Terrain, region: Region3, mats, occ, liq, hasLiquid: boolean)
	if channelsSupported ~= false then
		local ok = pcall(function()
			(terrain :: any):WriteVoxelChannels(region, 4, {
				SolidMaterial = mats,
				SolidOccupancy = occ,
				LiquidOccupancy = liq,
			})
		end)
		if ok then
			channelsSupported = true
			return
		end
		channelsSupported = false
	end
	-- fallback: one material per voxel; liquid wins over air and partial solids
	if hasLiquid then
		for i, plane in mats do
			for j, row in plane do
				local orow, lrow = occ[i][j], liq[i][j]
				for k = 1, #row do
					local l = lrow[k]
					if l > 0 and orow[k] < 0.5 then
						row[k] = WATER
						orow[k] = l
					end
				end
			end
		end
	end
	terrain:WriteVoxels(region, 4, mats, occ)
end

-- Writes the whole map (yields between chunks). progress(fraction) optional.
function TerrainWriter.write(terrain: Terrain, map: Map, opts: { [string]: any }?)
	local o = opts or {}
	local size = o.ChunkSize or 128
	local E = map.Extent
	local lo = -E
	local hi = E
	local x0s = {}
	local x = lo
	while x < hi do
		table.insert(x0s, x)
		x += size
	end
	local total = #x0s * #x0s
	local done = 0
	local budget = o.FrameBudget or 0.012
	local t0 = os.clock()
	for _, cx in x0s do
		for _, cz in x0s do
			local region, mats, occ, liq, hasLiquid = buildChunk(map, cx, cz, size)
			writeChunk(terrain, region, mats, occ, liq, hasLiquid)
			done += 1
			if o.Progress then
				o.Progress(done / total)
			end
			if os.clock() - t0 > budget then
				task.wait()
				t0 = os.clock()
			end
		end
	end
	return done
end

function TerrainWriter.applyLook(terrain: Terrain, data)
	for name, rgb in data.Colors or {} do
		local mat = (Enum.Material :: any)[name]
		if mat and name ~= "Water" then
			pcall(function()
				terrain:SetMaterialColor(mat, Color3.fromRGB(rgb[1], rgb[2], rgb[3]))
			end)
		end
	end
	local w = data.Colors and data.Colors.Water
	if w then
		terrain.WaterColor = Color3.fromRGB(w[1], w[2], w[3])
	end
	terrain.WaterReflectance = 0.6
	terrain.WaterTransparency = 0.72
	terrain.WaterWaveSize = 0.12
	terrain.WaterWaveSpeed = 9
	pcall(function()
		(terrain :: any).Decoration = true
	end)
end

return TerrainWriter
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000089">
				<Properties>
					<string name="Name">Village</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Village - Dragon Haven hub: plaza, dragon statue, stations (market,
	forge, hall of dragons, elder), cottages, lamps, market details.
	Every recipe builds in a local frame whose -Z faces the street/plaza.
]]


local Kit = require(script.Parent:WaitForChild("Kit"))

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local C = Kit.C
local M = Kit.M

local Village = {}

-- ============================================================== cottage
-- opts: W, D, Stories, Seed, Roof ("Slate" | "Clay" | "Moss")
function Village.cottage(parent: Instance, origin: CFrame, opts: { [string]: any }?)
	local o = opts or {}
	local rng = Random.new(o.Seed or 1)
	local w = o.W or rng:NextInteger(12, 16)
	local d = o.D or rng:NextInteger(11, 15)
	local stories = o.Stories or (rng:NextNumber() < 0.55 and 2 or 1)
	local storyH = 9
	local b = Kit.new(parent, origin, o.Name or "Cottage")
	local plaster = rng:NextNumber() < 0.5 and C.Plaster or C.PlasterWarm
	local roofColor = ({ Slate = C.RoofSlate, Clay = C.RoofClay, Moss = C.RoofMoss })[o.Roof or (rng:NextNumber() < 0.6 and "Slate" or "Clay")]
	-- foundation
	b:box(V(w + 1.2, 2.2, d + 1.2), V(0, 1.1, 0), C.StoneDark, M.Slate)
	b:box(V(w + 1.6, 0.5, d + 1.6), V(0, 2.25, 0), C.Stone, M.Cobblestone)
	local y = 2.4
	for s = 1, stories do
		local jetty = (s == 2) and 0.8 or 0
		local ww, dd = w + jetty * 0.0, d + jetty * 2
		local cy = y + storyH / 2
		-- walls (plaster), 1 stud thick
		b:box(V(ww, storyH, 1), V(0, cy, -dd / 2 + 0.5), plaster, M.Plaster)
		b:box(V(ww, storyH, 1), V(0, cy, dd / 2 - 0.5), plaster, M.Plaster)
		b:box(V(1, storyH, dd - 2), V(-ww / 2 + 0.5, cy, 0), plaster, M.Plaster)
		b:box(V(1, storyH, dd - 2), V(ww / 2 - 0.5, cy, 0), plaster, M.Plaster)
		-- timber frame: corner posts, sill + head beams, braces
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				b:box(V(1.2, storyH, 1.2), V(sx * (ww / 2 - 0.4), cy, sz * (dd / 2 - 0.4)), C.Timber, M.Wood)
			end
		end
		for _, sz in { -1, 1 } do
			b:box(V(ww + 0.4, 0.9, 1.25), V(0, y + 0.45, sz * (dd / 2 - 0.35)), C.Timber, M.Wood)
			b:box(V(ww + 0.4, 0.9, 1.25), V(0, y + storyH - 0.45, sz * (dd / 2 - 0.35)), C.Timber, M.Wood)
		end
		for _, sx in { -1, 1 } do
			b:box(V(1.25, 0.9, dd + 0.4), V(sx * (ww / 2 - 0.35), y + storyH - 0.45, 0), C.Timber, M.Wood)
		end
		-- mid posts on front/back
		for _, sz in { -1, 1 } do
			for _, px in { -w * 0.18, w * 0.18 } do
				b:box(V(0.8, storyH - 1.6, 1.15), V(px, cy, sz * (dd / 2 - 0.35)), C.Timber, M.Wood)
			end
		end
		-- windows
		local wy = y + storyH * 0.55
		if s == 1 then
			b:door(CF(0, y + 3.6, -dd / 2 - 0.05), 3.6, 7.2)
			b:window(CF(-w * 0.34, wy, -dd / 2 - 0.1), 2.6, 3.2)
			b:window(CF(w * 0.34, wy, -dd / 2 - 0.1), 2.6, 3.2)
			-- flower boxes
			for _, px in { -w * 0.34, w * 0.34 } do
				b:box(V(3.2, 0.8, 1.0), V(px, wy - 2.2, -dd / 2 - 0.6), C.Timber, M.Wood)
				for k = -1, 1 do
					local col = rng:NextNumber() < 0.5 and Color3.fromRGB(196, 64, 72) or Color3.fromRGB(232, 196, 84)
					b:ball(0.8, V(px + k * 0.9, wy - 1.6, -dd / 2 - 0.65), col, M.SmoothPlastic, { CastShadow = false, CanCollide = false })
				end
			end
		else
			b:window(CF(-w * 0.26, wy, -dd / 2 - 0.1), 2.6, 3.4)
			b:window(CF(w * 0.26, wy, -dd / 2 - 0.1), 2.6, 3.4)
		end
		b:window(CF(0, wy, dd / 2 + 0.1) * ANG(0, math.pi, 0), 2.6, 3.2)
		for _, sx in { -1, 1 } do
			b:window(CF(sx * (ww / 2 + 0.1), wy, 0) * ANG(0, sx * math.pi / 2, 0), 2.4, 3.0)
		end
		y += storyH
	end
	-- gable walls + roof (ridge along Z)
	local dTop = d + (stories == 2 and 1.6 or 0)
	local rise = w * 0.48
	for _, sz in { -1, 1 } do
		b:gableWall(w, rise, 1, V(0, y, sz * (dTop / 2 - 0.5)), plaster, M.Plaster)
		b:box(V(w + 0.6, 0.8, 1.2), V(0, y + 0.4, sz * (dTop / 2 - 0.4)), C.Timber, M.Wood)
		b:box(V(0.8, rise - 1, 1.15), V(0, y + (rise - 1) / 2, sz * (dTop / 2 - 0.35)), C.Timber, M.Wood)
	end
	b:gableRoof(w, dTop, rise, 1.6, V(0, y, 0), roofColor, M.RoofShingles, 0.9)
	-- chimney
	local cs = rng:NextNumber() < 0.5 and -1 or 1
	local chx = cs * w * 0.24
	local chTop = y + rise * 0.9 + 3
	b:box(V(2.4, chTop - 2, 2.4), V(chx, (chTop + 2) / 2, d * 0.18), C.Stone, M.Cobblestone)
	b:box(V(2.9, 0.6, 2.9), V(chx, chTop, d * 0.18), C.StoneDark, M.Slate)
	b:box(V(1.4, 0.2, 1.4), V(chx, chTop + 0.35, d * 0.18), Color3.fromRGB(30, 26, 24), M.Slate)
	-- doorstep + lantern
	b:box(V(5, 0.6, 2.4), V(0, 0.3, -d / 2 - 1.6), C.Stone, M.Slate)
	local lamp = b:box(V(0.9, 1.2, 0.9), V(2.8, 7.6, -d / 2 - 0.9), C.Window, M.Neon, { Transparency = 0.2, CastShadow = false })
	b:box(V(0.3, 0.3, 1.2), V(2.8, 8.4, -d / 2 - 0.5), C.Iron, M.Metal)
	local pl = Instance.new("PointLight")
	pl.Color = Color3.fromRGB(255, 186, 118)
	pl.Range = 16
	pl.Brightness = 1.2
	pl.Parent = lamp
	return b.Model
end

-- ============================================================== signs
local function signBoard(b, at: CFrame, w: number, h: number, text: string)
	local board = b:box(V(w, h, 0.5), at, C.Planks, M.WoodPlanks)
	b:box(V(w + 0.6, 0.4, 0.7), at * CF(0, h / 2 + 0.2, 0), C.Timber, M.Wood)
	b:box(V(w + 0.6, 0.4, 0.7), at * CF(0, -h / 2 - 0.2, 0), C.Timber, M.Wood)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 1
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.Fondamento
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(248, 222, 160)
	label.Text = text
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = Color3.fromRGB(40, 26, 14)
	stroke.Parent = label
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(0.06, 0)
	pad.PaddingRight = UDim.new(0.06, 0)
	pad.PaddingTop = UDim.new(0.12, 0)
	pad.PaddingBottom = UDim.new(0.12, 0)
	pad.Parent = label
	label.Parent = gui
	return board
end
Village.signBoard = signBoard

local function stationPrompt(b, part: BasePart, station: { [string]: any }, id: string)
	local p = b:prompt(part, station.Prompt or "Open", station.Name, { Station = id, Window = station.Window, Tab = station.Tab })
	p.MaxActivationDistance = 18
	p.Name = "StationPrompt"
	return p
end

-- ============================================================== market hall (Shop)
function Village.market(parent: Instance, origin: CFrame, station)
	local b = Kit.new(parent, origin, "DragonMarket")
	local w, d, h = 34, 24, 13
	b:box(V(w + 2, 1.6, d + 2), V(0, 0.8, 0), C.StoneDark, M.Slate)
	b:box(V(w, 0.4, d), V(0, 1.8, 0), C.Cobble, M.Cobblestone)
	-- timber posts (open hall) + stone corner piers
	for ix = -2, 2 do
		for _, sz in { -1, 1 } do
			local x = ix * (w / 4 - 0.5)
			if math.abs(ix) == 2 then
				b:box(V(2.6, h, 2.6), V(x, 2 + h / 2, sz * (d / 2 - 1)), C.Stone, M.Cobblestone)
			else
				b:box(V(1.4, h, 1.4), V(x, 2 + h / 2, sz * (d / 2 - 1)), C.Timber, M.Wood)
				b:beam(V(x, 2 + h - 3.5, sz * (d / 2 - 1)), V(x + 3, 2 + h - 0.6, sz * (d / 2 - 1)), 0.8, C.Timber, M.Wood)
				b:beam(V(x, 2 + h - 3.5, sz * (d / 2 - 1)), V(x - 3, 2 + h - 0.6, sz * (d / 2 - 1)), 0.8, C.Timber, M.Wood)
			end
		end
	end
	-- back wall (stone) with windows
	b:box(V(w - 2, h, 1.2), V(0, 2 + h / 2, d / 2 - 1), C.StoneWarm, M.Cobblestone)
	for _, x in { -10, 0, 10 } do
		b:window(CF(x, 2 + h * 0.6, d / 2 - 1.7) * ANG(0, math.pi, 0), 3, 4)
	end
	b:box(V(w + 1, 1.2, 1.6), V(0, 2 + h + 0.4, -d / 2 + 1), C.Timber, M.Wood)
	b:box(V(w + 1, 1.2, 1.6), V(0, 2 + h + 0.4, d / 2 - 1), C.Timber, M.Wood)
	for _, sx in { -1, 1 } do
		b:box(V(1.6, 1.2, d + 1), V(sx * (w / 2 - 1), 2 + h + 0.4, 0), C.Timber, M.Wood)
	end
	-- big roof: ridge along X (long hall) -> build in a rotated sub-frame
	local roof = b:sub("Roof", CF(0, 2 + h + 1, 0) * ANG(0, math.pi / 2, 0))
	roof:gableRoof(d + 1, w + 1, 10, 2.4, V(0, 0, 0), C.RoofClay, M.ClayRoofTiles, 1.1)
	for _, sz in { -1, 1 } do
		roof:gableWall(d + 1, 10, 1.2, V(0, 0, sz * (w / 2)), C.Plaster, M.Plaster)
	end
	-- dragon weathervane
	b:cyl(5, 0.4, V(0, 2 + h + 13, 0), C.Iron, M.Metal)
	b:wedge(V(0.3, 1.6, 3), CF(0, 2 + h + 15.5, 0) * ANG(0, math.pi / 2, 0), C.Gold, M.Foil)
	-- stalls inside: tables with goods
	local rng = Random.new(42)
	for i, x in { -11, 0, 11 } do
		b:box(V(8, 0.6, 3.6), V(x, 5, -2), C.Planks, M.WoodPlanks)
		for _, sx in { -1, 1 } do
			for _, sz in { -1, 1 } do
				b:box(V(0.5, 3, 0.5), V(x + sx * 3.6, 3.5, -2 + sz * 1.5), C.Timber, M.Wood)
			end
		end
		-- awning
		local col = ({ C.BannerRed, C.BannerBlue, C.BannerGreen })[i]
		b:box(V(9, 0.25, 5), CF(x, 10.2, -3.2) * ANG(math.rad(-16), 0, 0), col, M.Fabric)
		-- goods: dragon eggs on cushions / fruit / crystals
		for k = -1, 1 do
			local px = x + k * 2.4
			if i == 2 then
				b:box(V(1.8, 0.4, 1.8), V(px, 5.5, -2), C.BannerRed, M.Fabric)
				local egg = b:ball(1.6, CF(px, 6.6, -2), Color3.fromHSV(rng:NextNumber(), 0.45, 0.85), M.SmoothPlastic)
				egg.Size = V(1.5, 2.0, 1.5)
			elseif i == 1 then
				b:crate(CF(px, 6.0, -2), 1.6)
			else
				local gem = b:box(V(0.8, 1.6, 0.8), CF(px, 6.2, -2) * ANG(0, math.rad(45), math.rad(12)),
					Color3.fromRGB(110, 200, 255), M.Neon, { Transparency = 0.15 })
				gem.CastShadow = false
			end
		end
	end
	for _, p in { V(-15, 2, 8), V(15, 2, 7.5), V(13, 2, 9) } do
		b:barrel(p, 1)
	end
	b:crate(CF(-13.5, 3.5, 9), 3)
	b:crate(CF(-13.5, 6.5, 9) * ANG(0, 0.4, 0), 2.4)
	-- sign + prompt
	local sign = signBoard(b, CF(0, 2 + h - 1.6, -d / 2 - 0.2), 14, 3.4, station and station.Name or "Dragon Market")
	if station then
		stationPrompt(b, b:box(V(8, 4, 3), V(0, 4, -4), C.Planks, M.WoodPlanks, { Transparency = 1, CanCollide = false }), station, "Shop")
	end
	b:banner(CF(-w / 2 + 1, 2 + h - 4.5, -d / 2 - 0.4), 3.2, 7, C.BannerRed)
	b:banner(CF(w / 2 - 1, 2 + h - 4.5, -d / 2 - 0.4), 3.2, 7, C.BannerRed)
	return b.Model, sign
end

-- ============================================================== forge (Upgrades)
function Village.forge(parent: Instance, origin: CFrame, station)
	local b = Kit.new(parent, origin, "DragonsmithForge")
	local w, d, h = 22, 18, 11
	b:box(V(w + 2, 1.6, d + 2), V(0, 0.8, 0), C.StoneDark, M.Slate)
	-- three stone walls, open front with a big arch beam
	b:box(V(w, h, 1.6), V(0, 1.6 + h / 2, d / 2 - 0.8), C.Stone, M.Cobblestone)
	for _, sx in { -1, 1 } do
		b:box(V(1.6, h, d), V(sx * (w / 2 - 0.8), 1.6 + h / 2, 0), C.Stone, M.Cobblestone)
		b:box(V(2.4, h + 1, 2.4), V(sx * (w / 2 - 0.8), 1.6 + (h + 1) / 2, -d / 2 + 1.2), C.StoneDark, M.Slate)
	end
	b:box(V(w + 1, 2, 2), V(0, 1.6 + h, -d / 2 + 1.2), C.Timber, M.Wood)
	local roof = b:sub("Roof", CF(0, 1.6 + h + 1, 0) * ANG(0, math.pi / 2, 0))
	roof:gableRoof(d, w + 1, 7, 1.8, V(0, 0, 0), C.RoofSlateDark, M.Slate, 1.0)
	for _, sz in { -1, 1 } do
		roof:gableWall(d, 7, 1.2, V(0, 0, sz * (w / 2)), C.Stone, M.Cobblestone)
	end
	-- massive chimney with ember glow
	b:box(V(5, h + 14, 5), V(w / 2 - 3.5, 1.6 + (h + 14) / 2, d / 2 - 3), C.StoneDark, M.Cobblestone)
	b:box(V(6, 1, 6), V(w / 2 - 3.5, 1.6 + h + 14, d / 2 - 3), C.Stone, M.Slate)
	local smokePart = b:box(V(3, 0.3, 3), V(w / 2 - 3.5, 1.6 + h + 14.6, d / 2 - 3), Color3.fromRGB(25, 20, 18), M.Slate)
	local smoke = Instance.new("Smoke")
	smoke.Color = Color3.fromRGB(90, 86, 84)
	smoke.Opacity = 0.12
	smoke.RiseVelocity = 6
	smoke.Size = 4
	smoke.Parent = smokePart
	-- hearth
	b:box(V(8, 4, 4), V(w / 2 - 6, 3.6, d / 2 - 3.2), C.StoneDark, M.Slate)
	local coals = b:box(V(6, 0.6, 2.6), V(w / 2 - 6, 5.8, d / 2 - 3.2), Color3.fromRGB(255, 120, 40), M.Neon, { CastShadow = false })
	local fire = Instance.new("Fire")
	fire.Heat = 6
	fire.Size = 4
	fire.Color = Color3.fromRGB(255, 140, 50)
	fire.SecondaryColor = Color3.fromRGB(255, 220, 120)
	fire.Parent = coals
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 140, 60)
	glow.Range = 26
	glow.Brightness = 2.2
	glow.Parent = coals
	-- anvil + tools
	b:box(V(2.4, 2.6, 2.4), V(-2, 2.9, -1), C.Timber, M.Wood)
	b:box(V(4.2, 1.1, 1.6), V(-2, 4.7, -1), C.Iron, M.Metal)
	b:wedge(V(1.6, 1.1, 1.6), CF(-4.9, 4.7, -1) * ANG(0, math.rad(90), 0), C.Iron, M.Metal)
	b:box(V(0.35, 0.35, 3), CF(-1.2, 5.6, -1) * ANG(0, 0.6, 0), C.Timber, M.Wood)
	b:box(V(1.0, 0.8, 0.8), CF(-0.2, 5.7, -1.6) * ANG(0, 0.6, 0), C.Iron, M.Metal)
	-- weapon rack + armor stand
	for i = -1, 1 do
		b:box(V(0.3, 7, 0.3), CF(-w / 2 + 2.2, 5.5, i * 2.2) * ANG(0, 0, math.rad(8)), Color3.fromRGB(176, 180, 186), M.Metal)
	end
	b:box(V(0.6, 6, 6), V(-w / 2 + 1.8, 5, 0), C.Timber, M.Wood, { Transparency = 0 })
	b:barrel(V(5, 1.6, -5), 1.1)
	b:crate(CF(7.5, 3.1, -5.5), 3)
	local sign = signBoard(b, CF(0, 1.6 + h - 1.2, -d / 2 + 0.1), 12, 3, station and station.Name or "Dragonsmith Forge")
	if station then
		stationPrompt(b, b:box(V(6, 4, 3), V(-2, 4, -3), C.Planks, M.WoodPlanks, { Transparency = 1, CanCollide = false }), station, "Forge")
	end
	return b.Model, sign
end

-- ============================================================== hall of dragons (Index)
function Village.hall(parent: Instance, origin: CFrame, station)
	local b = Kit.new(parent, origin, "HallOfDragons")
	local w, d, h = 30, 26, 18
	local marble = Color3.fromRGB(214, 206, 190)
	-- stepped plinth
	for i = 0, 2 do
		b:box(V(w + 8 - i * 2, 1, d + 8 - i * 2), V(0, 0.5 + i, -i * 0.5), C.Stone, M.Limestone)
	end
	local base = 3
	-- cella walls
	b:box(V(w - 6, h, 1.4), V(0, base + h / 2, d / 2 - 2), marble, M.Limestone)
	for _, sx in { -1, 1 } do
		b:box(V(1.4, h, d - 6), V(sx * (w / 2 - 3), base + h / 2, 1), marble, M.Limestone)
	end
	b:box(V(w - 6, h, 1.4), V(0, base + h / 2, -d / 2 + 4), marble, M.Limestone, { Transparency = 0 })
	-- grand doorway (dark opening + gold frame)
	b:box(V(7, 11, 0.4), V(0, base + 5.5, -d / 2 + 3.25), Color3.fromRGB(28, 22, 20), M.Slate)
	b:box(V(8.2, 0.8, 0.6), V(0, base + 11.3, -d / 2 + 3.1), C.Gold, M.Foil)
	-- portico columns
	for i = -3, 3 do
		local x = i * (w / 6.6)
		b:cyl(h, 2.2, V(x, base + h / 2, -d / 2 + 0.5), marble, M.Marble)
		b:box(V(3, 0.8, 3), V(x, base + 0.4, -d / 2 + 0.5), marble, M.Limestone)
		b:box(V(3, 0.8, 3), V(x, base + h - 0.4, -d / 2 + 0.5), marble, M.Limestone)
	end
	-- entablature + pediment
	b:box(V(w + 2, 2, d + 2), V(0, base + h + 1, 0), marble, M.Limestone)
	b:box(V(w + 2.6, 0.6, d + 2.6), V(0, base + h + 2.3, 0), C.Gold, M.Foil)
	local roof = b:sub("Roof", CF(0, base + h + 2.6, 0))
	roof:gableRoof(w + 2, d + 2, 7, 1.2, V(0, 0, 0), C.RoofSlate, M.Slate, 1.0)
	roof:gableWall(w + 2, 7, 1, V(0, 0, -d / 2 - 0.6), marble, M.Limestone)
	roof:gableWall(w + 2, 7, 1, V(0, 0, d / 2 + 0.6), marble, M.Limestone)
	-- dragon crest disc on the pediment
	b:cylX(0.5, 4.5, CF(0, base + h + 5.4, -d / 2 - 1.2) * ANG(0, math.pi / 2, 0), C.Gold, M.Foil)
	-- banners between columns
	for _, x in { -w / 3.3, w / 3.3 } do
		b:banner(CF(x, base + h - 6, -d / 2 + 3.0), 3.4, 9, C.BannerBlue)
	end
	-- braziers flanking the stairs
	for _, sx in { -1, 1 } do
		local p = V(sx * (w / 2 + 2), 3, -d / 2 - 2)
		b:cyl(4, 1.2, p + V(0, 2, 0), C.Iron, M.Metal)
		local bowl = b:cyl(1.2, 3, p + V(0, 4.6, 0), C.Iron, M.Metal)
		local flame = b:box(V(1.6, 0.4, 1.6), p + V(0, 5.3, 0), Color3.fromRGB(255, 160, 60), M.Neon, { CastShadow = false })
		local f = Instance.new("Fire")
		f.Heat = 8
		f.Size = 3
		f.Parent = flame
		local l = Instance.new("PointLight")
		l.Color = Color3.fromRGB(255, 160, 80)
		l.Range = 18
		l.Brightness = 1.6
		l.Parent = flame
		local _ = bowl
	end
	local sign = signBoard(b, CF(0, base + h - 1.5, -d / 2 - 0.2), 15, 2.6, station and station.Name or "Hall of Dragons")
	if station then
		stationPrompt(b, b:box(V(8, 8, 2), V(0, base + 4, -d / 2 + 2), C.Planks, M.WoodPlanks, { Transparency = 1, CanCollide = false }), station, "Library")
	end
	return b.Model, sign
end

-- ============================================================== elder's tower (Quests)
function Village.elder(parent: Instance, origin: CFrame, station)
	local b = Kit.new(parent, origin, "EldersTower")
	local r = 7
	b:cyl(2, r * 2 + 2, V(0, 1, 2), C.StoneDark, M.Slate)
	b:cyl(16, r * 2, V(0, 10, 2), C.StoneWarm, M.Cobblestone)
	b:cyl(1.2, r * 2 + 1.2, V(0, 18.6, 2), C.Timber, M.Wood)
	-- conical roof from stacked shrinking cylinders
	for i = 0, 6 do
		local k = 1 - i / 7
		b:cyl(1.6, (r * 2 + 3) * k + 0.6, V(0, 19.8 + i * 1.5, 2), C.RoofSlate:Lerp(C.RoofSlateDark, i / 7), M.Slate)
	end
	b:cyl(3, 0.4, V(0, 31.5, 2), C.Gold, M.Metal)
	b:door(CF(0, 5.6, 2 - r - 0.05), 3.4, 7.2)
	b:window(CF(0, 13, 2 - r - 0.1), 2.2, 3.2)
	for _, a in { -1.1, 1.1 } do
		b:window(CF(math.sin(a) * (r + 0.1), 12, 2 - math.cos(a) * (r + 0.1)) * ANG(0, -a, 0), 2, 3)
	end
	-- quest board
	b:box(V(0.6, 7, 0.6), V(-9, 3.5, -4), C.Timber, M.Wood)
	b:box(V(0.6, 7, 0.6), V(-4, 3.5, -4), C.Timber, M.Wood)
	local board = b:box(V(5.6, 3.6, 0.4), V(-6.5, 5.6, -4.1), C.Planks, M.WoodPlanks)
	local rng = Random.new(7)
	for i = 1, 5 do
		b:box(V(1.1, 1.3, 0.1), CF(-8.6 + i * 0.85, 5.4 + rng:NextNumber(-0.8, 0.8), -4.35) * ANG(0, 0, rng:NextNumber(-0.2, 0.2)),
			Color3.fromRGB(236, 222, 190), M.Fabric, { CastShadow = false })
	end
	b:box(V(6.4, 0.5, 1.2), V(-6.5, 7.6, -4.1), C.RoofClay, M.ClayRoofTiles)
	-- the elder (simple robed figure; replaced by a humanoid model at runtime when possible)
	local elder = b:sub("ElderRowan")
	elder:box(V(2.6, 4.6, 1.8), V(4.5, 4.6, -4), Color3.fromRGB(70, 52, 96), M.Fabric)
	elder:box(V(2.9, 1.2, 2.0), V(4.5, 2.6, -4), Color3.fromRGB(60, 44, 84), M.Fabric)
	elder:ball(1.9, V(4.5, 7.8, -4), Color3.fromRGB(226, 186, 150), M.SmoothPlastic)
	elder:wedge(V(1.4, 1.6, 0.6), CF(4.5, 6.8, -4.85) * ANG(0, math.pi, math.pi), Color3.fromRGB(236, 236, 236), M.Fabric)
	elder:box(V(0.3, 8, 0.3), CF(6.2, 5, -4.2) * ANG(0, 0, math.rad(-5)), C.Timber, M.Wood)
	local orb = elder:ball(0.9, V(6.55, 9.1, -4.2), Color3.fromRGB(120, 220, 255), M.Neon, { CastShadow = false })
	local l = Instance.new("PointLight")
	l.Color = Color3.fromRGB(140, 220, 255)
	l.Range = 10
	l.Parent = orb
	local sign = signBoard(b, CF(0, 9.6, 2 - r - 0.4), 8, 1.8, station and station.Name or "Elder Rowan")
	if station then
		stationPrompt(b, board, station, "Quests")
	end
	return b.Model, sign
end

return Village
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
	</Item>
	<Item class="StarterPlayer" referent="RBX000090">
		<Properties>
			<string name="Name">StarterPlayer</string>
			<bool name="EnableMouseLockOption">false</bool>
			<float name="CameraMaxZoomDistance">70.0</float>
			<float name="CameraMinZoomDistance">6.0</float>
			<float name="CharacterWalkSpeed">20.0</float>
		</Properties>
		<Item class="StarterPlayerScripts" referent="RBX000091">
			<Properties>
				<string name="Name">StarterPlayerScripts</string>
			</Properties>
			<Item class="Folder" referent="RBX000092">
				<Properties>
					<string name="Name">Controllers</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX000093">
					<Properties>
						<string name="Name">AnimationController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	AnimationController
	Builds the visual model for every dragon root the client can see
	(companions now, sanctuary dragons later) and runs its procedural
	Animator with distance/visibility LOD.

	Visual models are built locally (DragonVisual.build with the server Root:
	a skinned mesh template when the species has one, otherwise the
	procedural part-built dragon) so the server never replicates visuals per
	dragon, and detail can follow the graphics preset. Builds are queued.

	Each frame (PreSimulation):
	  1. DragonController.preStep(dt)  - local riding / follow AI
	  2. every tracked dragon: params (local exact or estimated from the
	     replicated root), Animator Update/Apply, rider joint + rider pose.

	API: track(model), get(model), setLocal(model, params), play(model, shot)
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Dragons = Shared:WaitForChild("Dragons")
local DragonVisual = require(Dragons:WaitForChild("DragonVisual"))
local Animator = require(Dragons:WaitForChild("Animator"))
local RiderPose = require(Dragons:WaitForChild("RiderPose"))
local MathUtil = require(Shared:WaitForChild("Util"):WaitForChild("MathUtil"))

local AnimationController = {}

local registry
local tracked: { [Model]: any } = {}
local buildQueue: { Model } = {}
local folders: { Instance } = {}
local LocalPlayer = Players.LocalPlayer

local TIERS = {
	{ Distance = 150, Interval = 0, Membranes = 0 },
	{ Distance = 420, Interval = 1 / 30, Membranes = 1 / 30 },
	{ Distance = 800, Interval = 1 / 12, Membranes = 1 / 6 },
}

local function animMode(mode: string?): string
	if mode == "Ground" or mode == nil then
		return "Ground"
	elseif mode == "Air" then
		return "Air"
	elseif mode == "Sleep" then
		return "Sleep"
	elseif mode == "Rest" then
		return "Rest"
	end
	return "Fly"
end

local function detailFor(model: Model): string
	if model:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
		return "High"
	end
	local gc = registry and registry.GraphicsController
	if gc and gc.Preset == "Medium" then
		return "Medium"
	end
	return "High"
end

-- ============================================================== building
local function buildVisual(model: Model)
	local entry = tracked[model]
	if not entry or entry.Visual then
		return
	end
	local root = model:FindFirstChild("Root") :: BasePart?
	local species = model:GetAttribute("SpeciesId")
	if not root or type(species) ~= "string" then
		return
	end
	local displayScale = model:GetAttribute("DisplayScale")
	local visual = DragonVisual.build(species, {
		Root = root,
		Mutation = model:GetAttribute("Mutation") or "None",
		Detail = detailFor(model),
		ScaleOverride = type(displayScale) == "number" and displayScale or nil,
		BondAura = (model:GetAttribute("BondLevel") or 0) >= 50, -- BondConfig Aura perk
	})
	visual.Name = "Visual"
	for _, d in visual:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = "Dragons"
		end
	end
	visual.Parent = model
	local anim = Animator.new(visual)
	anim.Params.RunSpeed = model:GetAttribute("RunSpeed") or 40
	local startMode = model:GetAttribute("Mode")
	if startMode == "Rest" or startMode == "Sleep" then
		anim.Params.Mode = startMode
		anim:Snap(startMode)
	elseif model:GetAttribute("Anchored") or root.Anchored then
		anim:Snap("Idle")
	end
	entry.Visual = visual
	entry.Anim = anim
	entry.BodyMotor = anim.Motors.Body
	local bodyJoint = anim.Joints.Body
	entry.BodyC0 = bodyJoint and bodyJoint.C0 or CFrame.identity
	entry.BodyC0inv = entry.BodyC0:Inverse()
	local audio = registry.AudioController
	anim.OnFootstep = function()
		if entry.Tier == 1 and audio then
			audio.play3D("Footstep", root, 0.12, math.clamp((anim.Params.Speed or 0) / 40, 0.4, 1))
		end
	end
	anim.OnFlap = function()
		if entry.Tier <= 2 and audio then
			audio.play3D("WingFlap", root, 0.1)
		end
	end
end

function AnimationController.track(model: Model)
	if tracked[model] then
		return tracked[model]
	end
	local entry = {
		Model = model,
		Visual = nil,
		Anim = nil,
		Local = nil,
		LastYaw = nil,
		YawRate = 0,
		Accum = 0,
		MemAccum = 0,
		Tier = 1,
		ShotId = model:GetAttribute("ShotId") or 0,
		IdleTime = 0,
		NextIdle = 8 + math.random() * 6,
		RiderChar = nil,
		Perch = model:GetAttribute("Kind") == "Perch",
	}
	tracked[model] = entry
	-- the local player's dragon is built immediately; others are queued
	if model:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
		buildVisual(model)
	else
		table.insert(buildQueue, model)
	end
	model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			AnimationController.untrack(model)
		end
	end)
	-- hot swap (equip switch / mutation): rebuild the visual on the same root
	model:GetAttributeChangedSignal("VisualRev"):Connect(function()
		if tracked[model] ~= entry then
			return
		end
		if entry.RiderChar then
			RiderPose.clear(entry.RiderChar)
			entry.RiderChar = nil
		end
		if entry.Visual then
			entry.Visual:Destroy()
		end
		entry.Visual, entry.Anim, entry.BodyMotor = nil, nil, nil
		buildVisual(model)
	end)
	model:GetAttributeChangedSignal("ShotId"):Connect(function()
		local id = model:GetAttribute("ShotId")
		if entry.Anim and id ~= entry.ShotId and model:GetAttribute("OwnerUserId") ~= LocalPlayer.UserId then
			local shot = model:GetAttribute("Shot")
			if type(shot) == "string" then
				entry.Anim:Play(shot)
			end
		end
		entry.ShotId = id
	end)
	return entry
end

function AnimationController.untrack(model: Model)
	local entry = tracked[model]
	if not entry then
		return
	end
	if entry.RiderChar then
		RiderPose.clear(entry.RiderChar)
	end
	tracked[model] = nil
end

function AnimationController.get(model: Model)
	return tracked[model]
end

-- Exact parameters for the local player's dragon (from Locomotion).
function AnimationController.setLocal(model: Model, params)
	local entry = tracked[model]
	if entry then
		entry.Local = params
	end
end

function AnimationController.play(model: Model, shot: string)
	local entry = tracked[model]
	if entry and entry.Anim then
		entry.Anim:Play(shot)
	end
end

-- Ends a held clip (fire breath) with its fade-out.
function AnimationController.stop(model: Model, shot: string)
	local entry = tracked[model]
	if entry and entry.Anim then
		entry.Anim:Stop(shot)
	end
end

local function watchFolder(folder: Instance)
	table.insert(folders, folder)
	local function consider(child: Instance)
		if child:IsA("Model") then
			task.spawn(function()
				local root = child:WaitForChild("Root", 10)
				if root and child.Parent then
					AnimationController.track(child :: Model)
				end
			end)
		end
	end
	for _, child in folder:GetChildren() do
		consider(child)
	end
	folder.ChildAdded:Connect(consider)
end
AnimationController.watchFolder = watchFolder

-- ============================================================== per-frame
local function estimateParams(entry, root: BasePart, dt: number)
	local model = entry.Model
	local v = root.AssemblyLinearVelocity
	local cf = root.CFrame
	local look = cf.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	if entry.LastYaw then
		local rate = MathUtil.angleDelta(entry.LastYaw, yaw) / math.max(dt, 1 / 240)
		entry.YawRate = MathUtil.expDecay(entry.YawRate, math.clamp(rate, -4, 4), 8, dt)
	end
	entry.LastYaw = yaw
	local mode = model:GetAttribute("Mode")
	local am = animMode(mode)
	local horiz = Vector3.new(v.X, 0, v.Z).Magnitude
	local p = entry.Anim.Params
	p.Speed = am == "Fly" and v.Magnitude or horiz
	p.Vertical = v.Y
	p.TurnRate = entry.YawRate
	p.Bank = math.asin(math.clamp(cf.RightVector.Y, -1, 1))
	p.Mode = am
	p.Boost = model:GetAttribute("Boost") == true
end

local function updateRider(entry, root: BasePart)
	local model = entry.Model
	local riderId = model:GetAttribute("RiderUserId") or 0
	local character = nil
	if riderId ~= 0 then
		local player = Players:GetPlayerByUserId(riderId)
		character = player and player.Character
	end
	if entry.RiderChar and entry.RiderChar ~= character then
		RiderPose.clear(entry.RiderChar)
		entry.RiderChar = nil
	end
	if not character then
		return
	end
	entry.RiderChar = character
	local joint = root:FindFirstChild("RiderJoint") :: Motor6D?
	local anim = entry.Anim
	local bounce = 0
	if joint and entry.BodyMotor then
		-- saddle follows the animated body: T = Cs^-1 * (C0b * Tb * C0b^-1) * Cs
		local tb = entry.BodyMotor.Transform
		local m = entry.BodyC0 * tb * entry.BodyC0inv
		local cs = joint.C0
		joint.Transform = cs:Inverse() * m * cs
		bounce = tb.Position.Y
	end
	local p = anim.Params
	local lean = p.Boost and 1 or math.clamp((p.Speed or 0) / 260, 0, 0.45)
	RiderPose.apply(character, { Lean = lean, Bounce = bounce, Bank = p.Bank or 0 })
end

local function idleBehaviour(entry, dt: number)
	local anim = entry.Anim
	local p = anim.Params
	if p.Mode == "Ground" and (p.Speed or 0) < 1 and #anim.Shots == 0 then
		entry.IdleTime += dt
		local ridden = (entry.Model:GetAttribute("RiderUserId") or 0) ~= 0
		if entry.IdleTime > 75 and not ridden then
			p.Mode = "Sleep"
		elseif entry.IdleTime > entry.NextIdle then
			entry.NextIdle = entry.IdleTime + 9 + math.random() * 8
			anim:Play(math.random() < 0.82 and "IdleVariant" or "Roar")
		end
	else
		entry.IdleTime = 0
		entry.NextIdle = 8 + math.random() * 6
	end
end

-- Sanctuary perch dragons: alternate between resting (lying, head up),
-- dozing and standing up for a stretch or a roar; gentle look-arounds.
local function perchBehaviour(entry, dt: number)
	local anim = entry.Anim
	local p = anim.Params
	p.Speed, p.Vertical, p.TurnRate, p.Bank = 0, 0, 0, 0
	entry.MoodTime = (entry.MoodTime or (6 + math.random() * 10)) - dt
	if entry.MoodTime <= 0 and #anim.Shots == 0 then
		local r = math.random()
		local mood = r < 0.55 and "Rest" or (r < 0.8 and "Sleep" or "Ground")
		if mood == p.Mode then
			mood = "Rest"
		end
		p.Mode = mood
		entry.MoodTime = mood == "Sleep" and (24 + math.random() * 30) or (12 + math.random() * 16)
		entry.NextShot = 2.5 + math.random() * 3
	end
	if p.Mode == "Ground" then
		-- standing: a stretch or a roar now and then
		entry.NextShot = (entry.NextShot or 3) - dt
		if entry.NextShot <= 0 and #anim.Shots == 0 then
			entry.NextShot = 6 + math.random() * 7
			anim:Play(math.random() < 0.75 and "IdleVariant" or "Roar")
		end
	elseif p.Mode == "Rest" then
		-- glance around (additive head look, spring-smoothed by the Animator)
		entry.LookTime = (entry.LookTime or 0) - dt
		if entry.LookTime <= 0 then
			entry.LookTime = 2.5 + math.random() * 4
			p.Look = Vector2.new((math.random() - 0.5) * 0.9, (math.random() - 0.4) * 0.3)
		end
	else
		p.Look = Vector2.zero
	end
end

function AnimationController.stepAll(dt: number)
	local cam = Workspace.CurrentCamera
	local camPos = cam and cam.CFrame.Position or Vector3.zero
	local camLook = cam and cam.CFrame.LookVector or Vector3.zero
	local gc = registry.GraphicsController
	local maxDist = gc and gc.AnimationDistance or 800

	-- a couple of queued builds per frame
	for _ = 1, 2 do
		local m = table.remove(buildQueue, 1)
		if not m then
			break
		end
		if m.Parent and tracked[m] then
			buildVisual(m)
		end
	end

	for model, entry in tracked do
		local anim = entry.Anim
		if not anim then
			continue
		end
		local root = model:FindFirstChild("Root") :: BasePart?
		if not root then
			continue
		end
		local isLocal = entry.Local ~= nil
		local offset = root.Position - camPos
		local dist = offset.Magnitude
		local facing = dist < 1 or offset.Unit:Dot(camLook) > -0.2
		local tier
		if isLocal or dist < TIERS[1].Distance then
			tier = 1
		elseif dist < TIERS[2].Distance and facing then
			tier = 2
		elseif dist < math.min(TIERS[3].Distance, maxDist) and facing then
			tier = 3
		else
			tier = 4
		end
		entry.Tier = tier
		if tier == 4 then
			continue
		end
		entry.Accum += dt
		local interval = tier == 1 and 0 or TIERS[tier].Interval
		if entry.Accum < interval then
			continue
		end
		local step = entry.Accum
		entry.Accum = 0
		if entry.Perch then
			perchBehaviour(entry, step)
		else
			if isLocal then
				anim:SetParams(entry.Local)
			else
				estimateParams(entry, root, step)
			end
			idleBehaviour(entry, step)
		end
		anim:Update(step)
		entry.MemAccum += step
		local memInterval = tier == 1 and 0 or TIERS[tier].Membranes
		local doMembranes = entry.MemAccum >= memInterval
		if doMembranes then
			entry.MemAccum = 0
		end
		anim:Apply(doMembranes)
		if tier <= 2 then
			updateRider(entry, root)
		end
	end
end

function AnimationController.Init(reg)
	registry = reg
end

function AnimationController.Start()
	local dragons = Workspace:WaitForChild("Dragons", 30)
	if dragons then
		watchFolder(dragons)
	end
	RunService.PreSimulation:Connect(function(dt)
		local dc = registry.DragonController
		if dc and dc.preStep then
			dc.preStep(dt)
		end
		AnimationController.stepAll(dt)
	end)
end

return AnimationController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000094">
					<Properties>
						<string name="Name">AnnounceController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	AnnounceController
	Server-wide announcements. When somebody hatches something ultra rare
	(HatchConfig.Announce.MinOdds, "1 in 25,000" or rarer) every player on the server
	sees a banner under the cash row:

	  [ ALICE hatched a SHADOW VOID DRAGON! ]
	  [ 1 in 2,500,000 ]

	From HatchConfig.Announce.Mega on the banner is bigger, stays longer and gets a
	rainbow outline. Banners queue up (at most 3 waiting) and slide in one by one.

	Net signal "RareHatch" { Player, UserId, Species, Mutation, Rarity, Odds, Mega }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Odds = require(Shared:WaitForChild("Odds"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))
local HatchConfig = require(Configs:WaitForChild("HatchConfig"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Theme = require(UI:WaitForChild("Theme"))
local Responsive = require(UI:WaitForChild("Responsive"))
local Kit = require(UI:WaitForChild("Kit"))

local C = Theme.Colors

local AnnounceController = {}

local registry
local holder: Frame? = nil
local queue: { any } = {}
local current: any = nil -- { Frame, Info }
local MAX_WAITING = 3

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
	ColorSequenceKeypoint.new(0.2, Color3.fromRGB(255, 200, 60)),
	ColorSequenceKeypoint.new(0.4, Color3.fromRGB(120, 255, 100)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(80, 200, 255)),
	ColorSequenceKeypoint.new(0.8, Color3.fromRGB(170, 110, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 110, 200)),
})

local function article(word: string): string
	return string.find(string.lower(string.sub(word, 1, 1)), "[aeiou]") and "an" or "a"
end

-- ============================================================== layout
local function layout()
	if not holder then
		return
	end
	local R = Responsive
	local short = math.min(R.Width, R.Height)
	local top, w, h
	if R.Device == "Phone" then
		top = R.TopInset + short * 0.2
		if R.Portrait then
			w = R.Width * 0.94
			h = w * 0.22
		else
			h = short * 0.2
			w = h * 4.6
		end
	else
		top = R.TopInset + short * 0.145
		h = short * 0.115
		w = h * 5.4
	end
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Position = UDim2.new(0.5, 0, 0, math.floor(top))
	holder.Size = UDim2.fromOffset(math.floor(w), math.floor(h))
end

local function getHolder(): Frame?
	if holder and holder.Parent then
		return holder
	end
	local uic = registry and registry.UIController
	local layer = uic and uic.Layers and (uic.Layers.GameNotifications or uic.Layers.GameUI)
	if not layer then
		return nil
	end
	holder = Kit.frame({ Name = "Announcements", Size = UDim2.fromOffset(300, 60), Parent = layer.Root })
	holder.ZIndex = 30
	layout()
	return holder
end

-- ============================================================== banner
local function build(info): Frame
	local parent = holder :: Frame
	local rarity = DragonConfig.Rarities[info.Rarity] or DragonConfig.Rarities.Common
	local color = Odds.color(info.Odds)
	local sp = DragonConfig.Species[info.Species]
	local speciesName = string.upper(sp and sp.Name or tostring(info.Species))
	local mutation = MutationConfig.Mutations[info.Mutation or "None"]
	local what = speciesName
	if mutation and info.Mutation ~= "None" then
		what = string.upper(mutation.Name) .. " " .. speciesName
	end
	local frame = Kit.surface({
		Name = "RareBanner",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, -90),
		Size = UDim2.fromScale(1, 1),
		Color = C.Panel,
		Transparency = 0.04,
		StrokeColor = color,
		StrokeTransparency = 0.05,
		Radius = "Window",
		Parent = parent,
	})
	local outline = frame:FindFirstChildWhichIsA("UIStroke")
	if outline then
		outline.Thickness = info.Mega and 4 or 3
	end
	local pad = Kit.frame({ Name = "Pad", Size = UDim2.fromScale(1, 1), Parent = frame })
	Kit.scalePadding(pad, 0.04, 0.08, 0.04, 0.08)
	local line1 = Kit.text({
		Name = "Headline",
		Text = string.format("%s hatched %s %s!", info.Player, article(what), what),
		Role = "Heading",
		Scaled = true,
		MinTextSize = 10,
		Color = Color3.new(1, 1, 1),
		XAlign = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 0.56),
		Parent = pad,
	})
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(rarity.Glow, rarity.Color)
	grad.Parent = line1
	Kit.text({
		Name = "Odds",
		Text = (info.Mega and "MEGA RARE  -  " or "") .. Odds.format(info.Odds),
		Role = "Title",
		Scaled = true,
		MinTextSize = 9,
		Color = color,
		XAlign = Enum.TextXAlignment.Center,
		Position = UDim2.fromScale(0, 0.6),
		Size = UDim2.fromScale(1, 0.4),
		Parent = pad,
	})
	if info.Mega then
		local stroke = frame:FindFirstChildWhichIsA("UIStroke")
		if stroke then
			local g = Instance.new("UIGradient")
			g.Color = RAINBOW
			g.Parent = stroke
			frame:SetAttribute("Rainbow", true)
		end
	end
	return frame
end

local function advance()
	if current or #queue == 0 then
		return
	end
	if not getHolder() then
		return
	end
	local info = table.remove(queue, 1)
	local frame = build(info)
	current = { Frame = frame, Info = info }
	local audio = registry.AudioController
	if audio then
		audio.playUI(info.Mega and "RareHatch" or "LevelUp")
	end
	local seconds = info.Mega and HatchConfig.Announce.MegaBannerSeconds or HatchConfig.Announce.BannerSeconds
	TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.fromScale(0.5, 0) }):Play()
	task.delay(seconds, function()
		if current and current.Frame == frame then
			TweenService:Create(frame, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Position = UDim2.new(0.5, 0, 0, -120) }):Play()
			task.delay(0.45, function()
				frame:Destroy()
				if current and current.Frame == frame then
					current = nil
				end
				advance()
			end)
		end
	end)
end

-- info: { Player, Species, Mutation, Rarity, Odds, Mega }
function AnnounceController.show(info)
	if type(info) ~= "table" or type(info.Player) ~= "string" or type(info.Species) ~= "string" then
		return
	end
	info.Odds = tonumber(info.Odds) or 0
	if #queue >= MAX_WAITING then
		table.remove(queue, 1)
	end
	table.insert(queue, info)
	advance()
end

function AnnounceController.clear()
	table.clear(queue)
	if current then
		current.Frame:Destroy()
		current = nil
	end
end

-- UILab: a sample banner.
function AnnounceController.preview(mega: boolean?)
	AnnounceController.clear()
	AnnounceController.show({
		Player = "DragonRiderXx",
		Species = "VoidDragon",
		Mutation = "Rainbow",
		Rarity = "Secret",
		Odds = mega and 12500000 or 62500,
		Mega = mega == true,
	})
end

function AnnounceController.isShowing(): boolean
	return current ~= nil
end

function AnnounceController.Init(reg)
	registry = reg
end

function AnnounceController.Start()
	Net.onSignal("RareHatch", AnnounceController.show)
	Responsive.Changed:Connect(layout)
	-- rainbow outline of mega banners
	local t = 0
	RunService.Heartbeat:Connect(function(dt)
		if current and current.Frame:GetAttribute("Rainbow") then
			t += dt
			local stroke = current.Frame:FindFirstChildWhichIsA("UIStroke")
			local g = stroke and stroke:FindFirstChildWhichIsA("UIGradient")
			if g then
				g.Rotation = (t * 120) % 360
			end
		end
	end)
end

return AnnounceController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000095">
					<Properties>
						<string name="Name">AudioController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	AudioController
	- SoundGroups (Music / Ambient / SFX / UI) with player volume settings
	- playUI(key): pooled 2D sounds
	- play3D(key, parent): spatial one-shots on parts/attachments
	- loop(key, parent?): managed looping sound (wind, waterfalls)
	- music crossfades between region tracks
	Keys without an asset id (AudioConfig) are skipped silently.
]]

local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AudioConfig = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("AudioConfig"))

local AudioController = {}

local groups: { [string]: SoundGroup } = {}
local pools: { [string]: { Sound } } = {}
local musicKey: string? = nil
local musicSound: Sound? = nil
local musicVolume = 0.6
local sfxVolume = 0.8

local function def(key: string)
	local d = AudioConfig.Sounds[key]
	if not d or d.Id == nil or d.Id == "" then
		return nil
	end
	return d
end

local function newSound(key: string, d, parent: Instance): Sound
	local s = Instance.new("Sound")
	s.Name = key
	s.SoundId = d.Id
	s.Volume = d.Volume or 0.5
	s.PlaybackSpeed = d.Pitch or 1
	s.Looped = d.Looped == true
	s.SoundGroup = groups[d.Group or "SFX"]
	if d.RollOffMax then
		s.RollOffMaxDistance = d.RollOffMax
		s.RollOffMinDistance = math.min(14, d.RollOffMax * 0.1)
		s.RollOffMode = Enum.RollOffMode.InverseTapered
	end
	s.Parent = parent
	return s
end

function AudioController.playUI(key: string)
	local d = def(key)
	if not d then
		return
	end
	local pool = pools[key]
	if not pool then
		pool = {}
		pools[key] = pool
	end
	for _, s in pool do
		if not s.IsPlaying then
			s.TimePosition = 0
			s:Play()
			return
		end
	end
	if #pool < 4 then
		local s = newSound(key, d, SoundService)
		table.insert(pool, s)
		s:Play()
	end
end
AudioController.play2D = AudioController.playUI

function AudioController.play3D(key: string, parent: Instance, pitchJitter: number?, volumeScale: number?)
	local d = def(key)
	if not d or not parent then
		return nil
	end
	local s = newSound(key, d, parent)
	if pitchJitter then
		s.PlaybackSpeed = (d.Pitch or 1) * (1 + (math.random() * 2 - 1) * pitchJitter)
	end
	if volumeScale then
		s.Volume *= volumeScale
	end
	s:Play()
	s.Ended:Once(function()
		s:Destroy()
	end)
	task.delay(10, function()
		if s.Parent then
			s:Destroy()
		end
	end)
	return s
end

-- Returns a looping Sound (or nil) that the caller can adjust/destroy.
function AudioController.loop(key: string, parent: Instance?)
	local d = def(key)
	if not d then
		return nil
	end
	local s = newSound(key, d, parent or SoundService)
	s.Looped = true
	s:Play()
	return s
end

function AudioController.playMusic(key: string?)
	if key == musicKey then
		return
	end
	musicKey = key
	local old = musicSound
	musicSound = nil
	if old then
		local t = TweenService:Create(old, TweenInfo.new(2.5), { Volume = 0 })
		t:Play()
		t.Completed:Once(function()
			old:Destroy()
		end)
	end
	if not key then
		return
	end
	local d = def(key)
	if not d then
		return
	end
	local s = newSound(key, d, SoundService)
	s.Looped = true
	local target = d.Volume or 0.5
	s.Volume = 0
	s:Play()
	TweenService:Create(s, TweenInfo.new(3), { Volume = target }):Play()
	musicSound = s
end

function AudioController.setVolumes(music: number, sfx: number)
	musicVolume = math.clamp(music, 0, 1)
	sfxVolume = math.clamp(sfx, 0, 1)
	if groups.Music then
		groups.Music.Volume = AudioConfig.Groups.Music.Volume * musicVolume * 2
		groups.Ambient.Volume = AudioConfig.Groups.Ambient.Volume * sfxVolume * 1.25
		groups.SFX.Volume = AudioConfig.Groups.SFX.Volume * sfxVolume * 1.25
		groups.UI.Volume = AudioConfig.Groups.UI.Volume * sfxVolume * 1.25
	end
end

function AudioController.Init()
	for name, g in AudioConfig.Groups do
		local sg = SoundService:FindFirstChild("RAD_" .. name)
		if not sg then
			sg = Instance.new("SoundGroup")
			sg.Name = "RAD_" .. name
			sg.Volume = g.Volume
			sg.Parent = SoundService
		end
		groups[name] = sg :: SoundGroup
	end
	AudioController.setVolumes(musicVolume, sfxVolume)
end

return AudioController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000096">
					<Properties>
						<string name="Name">BondController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	BondController
	Client side of the Dragon Bond (see BondConfig / BondService):

	  * reads the equipped dragon's bond (data.Dragons[uid].BondXP) and exposes it
	    (BondController.info()) for the HUD bond bar
	  * input while riding: Q dash, hold E fire breath, Z sky dance - only the
	    abilities the dragon's bond level has unlocked; cooldowns mirror the server
	    (Great Tree "Quick Feathers" shortens them)
	  * everybody's fire breath: watches the "Breathing" attribute of every dragon
	    model (BreathFX flames + the held FireBreath animation), so other players see
	    your flames too
	  * level-up fanfare on the "BondUp" signal
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local BreathFX = require(Shared:WaitForChild("Dragons"):WaitForChild("BreathFX"))
local BondConfig = require(Configs:WaitForChild("BondConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local BondController = {}

local LocalPlayer = Players.LocalPlayer
local registry
local cooldownEnd = { Dash = 0, Fire = 0, Flourish = 0 }
local cooldownLen = { Dash = 1, Fire = 1, Flourish = 1 }
local firing = false
local fireStart = 0
local lastHint = 0
local watched: { [Model]: boolean } = {}

-- ============================================================== bond state
local function equipped()
	local data = registry.DataController.all()
	local uid = data and data.EquippedDragon
	local record = data and uid and uid ~= "" and data.Dragons[uid] or nil
	return record, uid
end

function BondController.points(): number
	local record = equipped()
	return record and tonumber(record.BondXP) or 0
end

function BondController.level(): number
	return BondConfig.levelFor(BondController.points())
end

function BondController.has(perk: string): boolean
	return BondConfig.has(BondController.points(), perk)
end

local function cooldownScale(): number
	return 1 - math.clamp(TreeConfig.bonus(registry.DataController.all(), "QuickFeathers"), 0, 0.9)
end

-- 0 (ready) .. 1 (just used)
function BondController.cooldown(action: string): number
	local left = cooldownEnd[action] - os.clock()
	if left <= 0 then
		return 0
	end
	return math.clamp(left / math.max(0.1, cooldownLen[action]), 0, 1)
end

-- Everything the HUD bond bar shows.
function BondController.info()
	local record = equipped()
	local points = record and tonumber(record.BondXP) or 0
	local level, into, need = BondConfig.progress(points)
	local nextPerk = BondConfig.nextPerk(level)
	return {
		HasDragon = record ~= nil,
		Name = record and record.Name or "",
		Level = level,
		Into = into,
		Need = need,
		NextPerk = nextPerk,
		Unlocked = {
			Dash = level >= BondConfig.PerkById.Dash.Level,
			Fire = level >= BondConfig.PerkById.Fire.Level,
			Flourish = level >= BondConfig.PerkById.Flourish.Level,
			Aura = level >= BondConfig.PerkById.Aura.Level,
		},
		Cooldown = { Dash = BondController.cooldown("Dash"), Fire = BondController.cooldown("Fire"), Flourish = BondController.cooldown("Flourish") },
		Firing = firing,
	}
end

-- ============================================================== abilities
local function locked(perkId: string)
	local perk = BondConfig.PerkById[perkId]
	if os.clock() - lastHint < 2.5 then
		return
	end
	lastHint = os.clock()
	registry.UIController.Notify("info", string.format("Ride this dragon until Bond Level %d to unlock %s.", perk.Level, perk.Name))
end

local function ready(action: string): boolean
	return os.clock() >= cooldownEnd[action]
end

local function startCooldown(action: string, base: number)
	local len = base * cooldownScale()
	cooldownLen[action] = len
	cooldownEnd[action] = os.clock() + len
end

local function tryDash()
	if not BondController.has("Dash") then
		return locked("Dash")
	end
	if not ready("Dash") then
		return
	end
	local ab = BondConfig.Abilities.Dash
	if registry.DragonController.dash(ab.Duration, ab.Multiplier) then
		startCooldown("Dash", ab.Cooldown)
		Net.fire("BondAction", { Action = "Dash" })
	end
end

local function tryFlourish()
	if not BondController.has("Flourish") then
		return locked("Flourish")
	end
	if not ready("Flourish") then
		return
	end
	local model = registry.DragonController.getModel()
	if not model then
		return
	end
	startCooldown("Flourish", BondConfig.Abilities.Flourish.Cooldown)
	registry.AnimationController.play(model, "Flourish")
	registry.CameraController.shake(0.08)
	Net.fire("BondAction", { Action = "Flourish" })
end

local function startFire()
	if firing then
		return
	end
	if not BondController.has("Fire") then
		return locked("Fire")
	end
	if not ready("Fire") then
		return
	end
	local model = registry.DragonController.getModel()
	if not model then
		return
	end
	firing = true
	fireStart = os.clock()
	BreathFX.start(model)
	registry.AnimationController.play(model, "FireBreath")
	Net.fire("BondAction", { Action = "FireStart" })
end

local function stopFire()
	if not firing then
		return
	end
	firing = false
	startCooldown("Fire", BondConfig.Abilities.Fire.Cooldown)
	local model = registry.DragonController.getModel()
	if model then
		BreathFX.stop(model)
		registry.AnimationController.stop(model, "FireBreath")
	end
	Net.fire("BondAction", { Action = "FireStop" })
end

-- ============================================================== everybody's flames
local function watch(model: Instance)
	if not model:IsA("Model") or watched[model] then
		return
	end
	watched[model] = true
	local function apply()
		local on = model:GetAttribute("Breathing") == true
		local mine = model:GetAttribute("OwnerUserId") == LocalPlayer.UserId
		if mine then
			-- the owner drives their own flames (instant response); the server flag
			-- only ends them if the server refused or timed the breath out
			if not on and firing and os.clock() - fireStart > 0.6 then
				stopFire()
			end
			return
		end
		if on then
			BreathFX.start(model)
			registry.AnimationController.play(model, "FireBreath")
		else
			BreathFX.stop(model)
			registry.AnimationController.stop(model, "FireBreath")
		end
	end
	model:GetAttributeChangedSignal("Breathing"):Connect(apply)
	model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			watched[model] = nil
			BreathFX.stop(model)
		end
	end)
	apply()
end

-- ============================================================== fanfare
local function burstAt(position: Vector3)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.CFrame = CFrame.new(position)
	p.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new(Color3.fromRGB(255, 226, 120), Color3.fromRGB(255, 150, 200))
	e.LightEmission = 1
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.9, 1.6)
	e.Speed = NumberRange.new(14, 30)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, -6, 0)
	e.Drag = 2
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0) })
	e.Parent = p
	e:Emit(70)
	task.delay(2.2, function()
		p:Destroy()
	end)
end

local function onBondUp(payload)
	local model = registry.DragonController.getModel()
	local root = model and model:FindFirstChild("Root") :: BasePart?
	if root then
		burstAt(root.Position + Vector3.new(0, 4, 0))
	end
	registry.AudioController.playUI("LevelUp")
	if registry.DragonController.isRiding() then
		registry.CameraController.shake(0.1)
	end
	local _ = payload
end

-- ============================================================== lifecycle
function BondController.Init(reg)
	registry = reg
end

function BondController.Start()
	registry.InputController.Pressed:Connect(function(action)
		if not registry.DragonController.isRiding() then
			return
		end
		if action == "Dash" then
			tryDash()
		elseif action == "Flourish" then
			tryFlourish()
		elseif action == "Fire" then
			startFire()
		end
	end)
	local hudTimer = 0
	RunService.Heartbeat:Connect(function(dt)
		hudTimer += dt
		if hudTimer >= 0.1 and registry.Hud and registry.DragonController.isRiding() then
			hudTimer = 0
			registry.Hud:SetBond(BondController.info())
		end
		if firing then
			local input = registry.InputController
			local maxSeconds = BondConfig.Abilities.Fire.MaxSeconds
			if not registry.DragonController.isRiding() or not input.isDown("Fire") or os.clock() - fireStart > maxSeconds then
				stopFire()
			end
		end
	end)
	Net.onSignal("BondUp", onBondUp)
	task.spawn(function()
		local folder = Workspace:WaitForChild("Dragons", 30)
		if not folder then
			return
		end
		for _, m in folder:GetChildren() do
			watch(m)
		end
		folder.ChildAdded:Connect(watch)
	end)
	-- ending a ride ends the flames
	registry.DragonController.RidingChanged:Connect(function(riding)
		if not riding then
			stopFire()
		end
	end)
end

return BondController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000097">
					<Properties>
						<string name="Name">CameraController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	CameraController
	Third-person riding camera (active while mounted; the default Roblox
	camera is used on foot).

	- Focus follows the dragon's stable physics root through an analytic
	  critically damped spring (frame-rate independent, never jitters),
	  with a small look-ahead along the flight direction.
	- Orbit yaw/pitch from mouse (locked or right-drag), right stick or touch
	  drag; auto-aligns behind the dragon after a short idle.
	- Zoom (wheel / pinch), speed-based distance, FOV 70 -> 82 on boost.
	- Sphere-cast collision: pulls in fast, eases back out slowly.
	- Subtle bank roll and trauma-based shake (both optional in Settings).
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Spring = require(Shared:WaitForChild("Util"):WaitForChild("Spring"))
local MathUtil = require(Shared:WaitForChild("Util"):WaitForChild("MathUtil"))
local GameConfig = require(Configs:WaitForChild("GameConfig"))

local CameraController = {}
CameraController.Active = false
CameraController.Options = { Sensitivity = 1, Shake = true, SpeedFOV = true, MouseLock = true, InvertY = false }

local CAM = GameConfig.Camera
local BIND_NAME = "RAD_DragonCamera"

local registry
local camera: Camera
local target: BasePart? = nil
local info = { Scale = 1, Mode = "Ground", Speed = 0, Cruise = 77, Boosting = false, Roll = 0, Yaw = 0, Pitch = 0, Velocity = Vector3.zero }

local yaw, pitch = 0, -0.22
local zoom, zoomTarget = 1, 1
local focus = Spring.new(Vector3.zero, CAM.PositionFrequency)
local distSpring = Spring.new(CAM.DistanceGround, CAM.ZoomFrequency)
local collisionDist = math.huge
local fov = CAM.BaseFOV
local roll = 0
local trauma = 0
local lastManual = 0
local stick = Vector2.zero
local touchDrag: InputObject? = nil
local touchLast: Vector3? = nil
local rmbDown = false
local clock = 0

local rayParams = RaycastParams.new()
rayParams.CollisionGroup = "DragonQuery"
rayParams.RespectCanCollide = true
rayParams.IgnoreWater = true

local function cursorFree(): boolean
	local ui = registry and registry.UIController
	if ui and ui.Current then
		return true
	end
	local input = registry and registry.InputController
	return input ~= nil and input.isDown("FreeCursor")
end

local function mouseLocked(): boolean
	return CameraController.Active and CameraController.Options.MouseLock and not UserInputService.TouchEnabled and not cursorFree()
end

function CameraController.setOptions(opts)
	for k, v in opts do
		CameraController.Options[k] = v
	end
end

function CameraController.getYaw(): number
	return yaw
end

function CameraController.getPitch(): number
	return pitch
end

function CameraController.getLook(): Vector3
	return CFrame.fromOrientation(pitch, yaw, 0).LookVector
end

-- amount 0..1 (adds trauma; shake = trauma^2)
function CameraController.shake(amount: number)
	if CameraController.Options.Shake then
		trauma = math.min(1, trauma + amount)
	end
end

function CameraController.setInfo(t)
	for k, v in t do
		info[k] = v
	end
end

local function rotate(dx: number, dy: number)
	local o = CameraController.Options
	local inv = o.InvertY and -1 or 1
	yaw = MathUtil.wrapAngle(yaw - dx)
	pitch = math.clamp(pitch - dy * inv, CAM.PitchMin, CAM.PitchMax)
	lastManual = clock
end

-- Cinematics (hatching, cutscenes) take the camera over temporarily.
local cinematicDepth = 0
function CameraController.beginCinematic()
	cinematicDepth += 1
	if cinematicDepth == 1 then
		if CameraController.Active then
			RunService:UnbindFromRenderStep(BIND_NAME)
		end
		camera.CameraType = Enum.CameraType.Scriptable
	end
end

function CameraController.endCinematic()
	if cinematicDepth == 0 then
		return
	end
	cinematicDepth -= 1
	if cinematicDepth == 0 then
		if CameraController.Active then
			camera.CameraType = Enum.CameraType.Scriptable
			RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, CameraController.update)
		else
			camera.CameraType = Enum.CameraType.Custom
			local character = Players.LocalPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				camera.CameraSubject = humanoid
			end
		end
	end
end

function CameraController.inCinematic(): boolean
	return cinematicDepth > 0
end

-- Activates the riding camera on a dragon root (nil = back to default camera).
function CameraController.setTarget(root: BasePart?, scale: number?)
	target = root
	info.Scale = scale or 1
	if root then
		local wasActive = CameraController.Active
		CameraController.Active = true
		if not wasActive then
			-- start from the current view so the transition is seamless
			local cf = camera.CFrame
			local look = cf.LookVector
			yaw = math.atan2(-look.X, -look.Z)
			pitch = math.clamp(math.asin(math.clamp(look.Y, -1, 1)), CAM.PitchMin, CAM.PitchMax)
			local f = root.Position + Vector3.new(0, CAM.HeightOffset * info.Scale, 0)
			focus:Reset(f)
			local d = (cf.Position - f).Magnitude
			distSpring:Reset(math.clamp(d, 8, 120))
			collisionDist = math.huge
			fov = camera.FieldOfView
			camera.CameraType = Enum.CameraType.Scriptable
			if cinematicDepth == 0 then
				RunService:BindToRenderStep(BIND_NAME, Enum.RenderPriority.Camera.Value + 1, CameraController.update)
			end
		end
	else
		if CameraController.Active then
			CameraController.Active = false
			RunService:UnbindFromRenderStep(BIND_NAME)
			if cinematicDepth > 0 then
				return
			end
			camera.CameraType = Enum.CameraType.Custom
			camera.FieldOfView = CAM.BaseFOV
			local character = Players.LocalPlayer.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				camera.CameraSubject = humanoid
			end
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		end
	end
end

function CameraController.update(dt: number)
	clock += dt
	local root = target
	if not root or not root.Parent then
		return
	end
	local o = CameraController.Options
	local sens = o.Sensitivity or 1
	local scale = info.Scale
	local flying = info.Mode == "Fly" or info.Mode == "Takeoff" or info.Mode == "Landing"

	-- ---------------------------------------------------------------- input
	if mouseLocked() then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
		UserInputService.MouseIconEnabled = false
		local d = UserInputService:GetMouseDelta()
		if d.Magnitude > 0 then
			rotate(d.X * CAM.MouseSensitivity * sens, d.Y * CAM.MouseSensitivity * sens)
		end
	else
		UserInputService.MouseIconEnabled = true
		if rmbDown and not cursorFree() then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			local d = UserInputService:GetMouseDelta()
			if d.Magnitude > 0 then
				rotate(d.X * CAM.MouseSensitivity * sens, d.Y * CAM.MouseSensitivity * sens)
			end
		else
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		end
	end
	if stick.Magnitude > 0.12 then
		local s = (stick.Magnitude - 0.12) / 0.88
		local dir = stick.Unit * s * s
		rotate(dir.X * CAM.GamepadSensitivity * sens * dt, -dir.Y * CAM.GamepadSensitivity * 0.75 * sens * dt)
	end

	-- ---------------------------------------------------------------- auto align
	local vel = info.Velocity
	local hspeed = Vector3.new(vel.X, 0, vel.Z).Magnitude
	if clock - lastManual > CAM.AutoAlignDelay and hspeed > 8 then
		local k = math.clamp((hspeed - 8) / 30, 0, 1)
		yaw = MathUtil.expDecayAngle(yaw, info.Yaw, CAM.AutoAlignRate * k, dt)
		local restPitch = flying and (-0.24 + math.clamp(info.Pitch, -0.6, 0.5) * 0.45) or -0.22
		pitch = MathUtil.expDecay(pitch, restPitch, CAM.AutoAlignRate * 0.6 * k, dt)
	end

	-- ---------------------------------------------------------------- focus
	local cruise = math.max(1, info.Cruise)
	local speed01 = math.clamp(info.Speed / cruise, 0, 1.6)
	local lookAhead = flying and vel * (CAM.LookAheadAir / math.max(30, cruise)) or Vector3.zero
	if lookAhead.Magnitude > CAM.LookAheadAir * 1.6 * scale then
		lookAhead = lookAhead.Unit * CAM.LookAheadAir * 1.6 * scale
	end
	-- a critically damped spring trails a moving target by 2v/omega; lead the
	-- target by most of that so the dragon stays framed at any speed while
	-- the remaining lag still smooths accelerations
	local lead = vel * (2 / focus.Omega) * (CAM.LagCompensation or 0.85)
	focus.Target = root.Position + Vector3.new(0, CAM.HeightOffset * scale, 0) + lookAhead + lead
	local f = focus:Update(dt)

	-- ---------------------------------------------------------------- distance
	zoom = MathUtil.expDecay(zoom, zoomTarget, 10, dt)
	local base = (flying and CAM.DistanceAir or CAM.DistanceGround) * scale
	distSpring.Target = base * zoom + CAM.DistanceSpeedBonus * scale * math.min(speed01, 1.3)
	local desired = distSpring:Update(dt)

	local rot = CFrame.fromOrientation(pitch, yaw, 0)
	local look = rot.LookVector
	-- collision: cast from the focus back toward the camera
	local castDist = desired
	local hit = Workspace:Spherecast(f, CAM.CollisionRadius, -look * (desired + 0.5), rayParams)
	if hit then
		castDist = math.max(2, hit.Distance - 0.4)
	end
	if castDist < collisionDist then
		collisionDist = MathUtil.expDecay(collisionDist, castDist, CAM.CollisionPullIn, dt)
		collisionDist = math.min(collisionDist, castDist + 1.5)
	else
		collisionDist = MathUtil.expDecay(collisionDist, castDist, CAM.CollisionPushOut, dt)
	end
	local dist = math.min(desired, collisionDist)
	local camPos = f - look * dist

	-- ---------------------------------------------------------------- fov / roll / shake
	local fovTarget = CAM.BaseFOV
	if o.SpeedFOV then
		fovTarget += CAM.SpeedFOVBonus * math.min(speed01, 1)
		if info.Boosting then
			fovTarget = CAM.BoostFOV + CAM.SpeedFOVBonus * 0.5
		end
	end
	fov = MathUtil.expDecay(fov, fovTarget, CAM.FOVRate, dt)
	roll = MathUtil.expDecay(roll, flying and info.Roll * CAM.BankRoll or 0, 5, dt)
	trauma = math.max(0, trauma - dt * 1.4)
	local shake = trauma * trauma
	local shakeCF = CFrame.identity
	if shake > 0.001 then
		local t = clock * 22
		shakeCF = CFrame.Angles(
			math.noise(t, 0.3) * 0.035 * shake,
			math.noise(t, 4.1) * 0.035 * shake,
			math.noise(t, 9.7) * 0.05 * shake
		)
	end

	camera.FieldOfView = fov
	camera.CFrame = CFrame.lookAt(camPos, f) * CFrame.Angles(0, 0, roll) * shakeCF
	camera.Focus = CFrame.new(f)
end

function CameraController.Init(reg)
	registry = reg
	camera = Workspace.CurrentCamera
	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		camera = Workspace.CurrentCamera
		if CameraController.Active then
			camera.CameraType = Enum.CameraType.Scriptable
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if input.UserInputType == Enum.UserInputType.MouseButton2 and not processed then
			rmbDown = true
		elseif input.UserInputType == Enum.UserInputType.Touch and not processed and CameraController.Active then
			if not touchDrag then
				touchDrag = input
				touchLast = input.Position
			end
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			rmbDown = false
		elseif input == touchDrag then
			touchDrag = nil
			touchLast = nil
		end
	end)
	UserInputService.InputChanged:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.Thumbstick2 then
			stick = Vector2.new(input.Position.X, input.Position.Y)
		elseif input.UserInputType == Enum.UserInputType.MouseWheel and not processed and CameraController.Active then
			zoomTarget = math.clamp(zoomTarget * (1 - 0.12 * input.Position.Z), CAM.MinZoom, CAM.MaxZoom)
		elseif input == touchDrag and touchLast and CameraController.Active then
			local d = input.Position - touchLast
			touchLast = input.Position
			local sens = CameraController.Options.Sensitivity or 1
			rotate(d.X * CAM.TouchSensitivity * sens, d.Y * CAM.TouchSensitivity * sens)
		end
	end)
	local pinchBase = 1
	UserInputService.TouchPinch:Connect(function(_, scale, _, state, processed)
		if processed or not CameraController.Active then
			return
		end
		if state == Enum.UserInputState.Begin then
			pinchBase = zoomTarget
		elseif state == Enum.UserInputState.Change then
			-- scale is cumulative since the pinch began
			zoomTarget = math.clamp(pinchBase / math.clamp(scale, 0.25, 4), CAM.MinZoom, CAM.MaxZoom)
		end
	end)
end

return CameraController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000098">
					<Properties>
						<string name="Name">DataController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	DataController
	Read-only client mirror of the player's server data.

	Data.get("Cash"), Data.getPath({"Upgrades","Radar"})
	Data.observe("Cash", fn)        -- fires now and on every change of that key
	Data.changed(key) -> Signal     -- (path, value) for any change under key
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)

local DataSync: RemoteEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DataSync")

local DataController = {}
DataController.Ready = false
DataController.ReadySignal = Signal.new()
DataController.AnyChanged = Signal.new() -- (path, value)
DataController.Temporary = false

local data = nil
local keySignals: { [string]: any } = {}

local function signalFor(key: string)
	local s = keySignals[key]
	if not s then
		s = Signal.new()
		keySignals[key] = s
	end
	return s
end

local function applySet(path: { string }, value: any)
	local node = data
	for i = 1, #path - 1 do
		local nxt = node[path[i]]
		if type(nxt) ~= "table" then
			nxt = {}
			node[path[i]] = nxt
		end
		node = nxt
	end
	node[path[#path]] = value
end

function DataController.get(key: string)
	return data and data[key]
end

function DataController.getPath(path: { string })
	local node = data
	for _, k in path do
		if type(node) ~= "table" then
			return nil
		end
		node = node[k]
	end
	return node
end

function DataController.all()
	return data
end

function DataController.changed(key: string)
	return signalFor(key)
end

-- Calls fn(value) immediately (once ready) and whenever `key` changes.
function DataController.observe(key: string, fn: (any) -> ())
	local conn = signalFor(key):Connect(function()
		fn(data[key])
	end)
	if DataController.Ready then
		task.spawn(fn, data[key])
	else
		DataController.ReadySignal:Once(function()
			fn(data[key])
		end)
	end
	return conn
end

function DataController.waitUntilReady()
	if not DataController.Ready then
		DataController.ReadySignal:Wait()
	end
	return data
end

function DataController.Init()
	DataSync.OnClientEvent:Connect(function(kind: string, a: any, b: any)
		if kind == "Init" then
			data = a
			DataController.Temporary = type(b) == "table" and b.Temporary == true
			local first = not DataController.Ready
			DataController.Ready = true
			if first then
				DataController.ReadySignal:Fire(data)
			end
			for key in data do
				signalFor(key):Fire({ key }, data[key])
			end
		elseif kind == "Batch" and data then
			local touched = {}
			for _, change in a do
				local path, value = change[1], change[2]
				applySet(path, value)
				local key = path[1]
				touched[key] = touched[key] or {}
				table.insert(touched[key], change)
			end
			for key, changes in touched do
				for _, change in changes do
					signalFor(key):Fire(change[1], change[2])
					DataController.AnyChanged:Fire(change[1], change[2])
				end
			end
		end
	end)
end

return DataController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000099">
					<Properties>
						<string name="Name">DragonController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	DragonController
	Drives the local player's companion dragon (client network ownership):

	  riding      input -> Locomotion -> LinearVelocity / AlignOrientation
	  on foot     follow AI (walks after the player, flies over gaps and
	              cliffs, teleports beside the player when left far behind)

	No per-frame remotes: only mode/boost/action changes are sent
	(DragonState event) so other clients can animate this dragon.

	API: toggleRide(), isRiding(), getModel(), getState()
	     preStep(dt) is called by AnimationController before animating.
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local Locomotion = require(Shared:WaitForChild("Dragons"):WaitForChild("Locomotion"))
local DragonStats = require(Shared:WaitForChild("DragonStats"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local GameConfig = require(Configs:WaitForChild("GameConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local DragonController = {}
DragonController.RidingChanged = Signal.new() -- (riding)
DragonController.ModelChanged = Signal.new() -- (model?)

local LocalPlayer = Players.LocalPlayer
local R = GameConfig.Riding
local rad, sin, cos, abs, clamp = math.rad, math.sin, math.cos, math.abs, math.clamp

local registry
local model: Model? = nil
local root: BasePart? = nil
local drive: LinearVelocity? = nil
local attitude: AlignOrientation? = nil
local state = nil
local riding = false
local busy = false
local hudTimer = 0
local lastSent = { Mode = "Ground", Boost = false }
local roarCooldown = 0
local flyIntent = 0
local wind: Sound? = nil

-- ============================================================== world queries
local rayParams = RaycastParams.new()
rayParams.CollisionGroup = "DragonQuery"
rayParams.RespectCanCollide = true
rayParams.IgnoreWater = false

local world = {}
function world.ground(pos: Vector3, maxDown: number)
	local r = 0.9
	local hit = Workspace:Spherecast(pos + Vector3.new(0, 2, 0), r, Vector3.new(0, -(maxDown + 2 - r), 0), rayParams)
	if hit then
		return true, hit.Position.Y, hit.Normal, hit.Material == Enum.Material.Water
	end
	return false, 0, Vector3.yAxis, false
end
function world.sweep(origin: Vector3, delta: Vector3, radius: number)
	if delta.Magnitude < 1e-3 then
		return false, 1, Vector3.zero
	end
	local hit = Workspace:Spherecast(origin, radius, delta, rayParams)
	if hit then
		return true, hit.Distance / delta.Magnitude, hit.Normal
	end
	return false, 1, Vector3.zero
end
DragonController.World = world

-- ============================================================== helpers
local function equippedRecord()
	local data = registry.DataController.all()
	if not data then
		return nil
	end
	local uid = data.EquippedDragon
	return uid ~= "" and data.Dragons[uid] or nil
end

local function buildStats()
	local m = model :: Model
	local record = equippedRecord()
	local species = DragonConfig.Species[m:GetAttribute("SpeciesId") or ""] or DragonConfig.Species.GreenDrake
	local handling = species.Handling or {}
	-- Great Tree bonuses (data.Tree replicates; the server applies the same ones)
	local data = registry.DataController.all()
	local tree = function(id: string)
		return TreeConfig.bonus(data, id)
	end
	return {
		RunSpeed = record and DragonStats.runSpeed(record, tree("RunSpeed")) or (m:GetAttribute("RunSpeed") or 40),
		CruiseSpeed = record and DragonStats.cruiseSpeed(record, tree("FlySpeed")) or (m:GetAttribute("CruiseSpeed") or 77),
		BoostLong = 1 + tree("BoostLong"),
		BoostRegen = 1 + tree("BoostRegen"),
		Scale = m:GetAttribute("Scale") or 1,
		HipHeight = m:GetAttribute("HipHeight") or 4.8,
		BodyRadius = m:GetAttribute("BodyRadius") or 4.2,
		Turn = handling.Turn or 1,
		Accel = handling.Accel or 1,
		Agility = handling.Agility or 1,
	}
end

local function character()
	local c = LocalPlayer.Character
	local hrp = c and c:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = c and c:FindFirstChildOfClass("Humanoid")
	return c, hrp, hum
end

local function send(payload)
	Net.fire("DragonState", payload)
end

local function flatYaw(cf: CFrame): number
	local l = cf.LookVector
	return math.atan2(-l.X, -l.Z)
end

-- ============================================================== model binding
local function setRiding(on: boolean)
	if riding == on then
		return
	end
	riding = on
	local input = registry.InputController
	local cam = registry.CameraController
	input.setRiding(on)
	local _, _, hum = character()
	if hum then
		hum.PlatformStand = on
	end
	if on and root and model then
		cam.setTarget(root, model:GetAttribute("Scale") or 1)
	else
		cam.setTarget(nil)
	end
	if registry.Hud then
		registry.Hud:SetRiding(on)
	end
	if wind then
		wind.Volume = 0
	end
	DragonController.RidingChanged:Fire(on)
end

local function unbind()
	if riding then
		setRiding(false)
	end
	model, root, drive, attitude, state = nil, nil, nil, nil, nil
	DragonController.ModelChanged:Fire(nil)
end

local function bind(m: Model)
	if model == m then
		return
	end
	unbind()
	local r = m:WaitForChild("Root", 10) :: BasePart?
	if not r or m.Parent == nil then
		return
	end
	model = m
	root = r
	drive = r:WaitForChild("Drive", 5) :: LinearVelocity?
	attitude = r:WaitForChild("Attitude", 5) :: AlignOrientation?
	state = Locomotion.new(buildStats(), r.Position, flatYaw(r.CFrame))
	lastSent = { Mode = "Ground", Boost = false }
	local anim = registry.AnimationController
	anim.track(m)
	m:GetAttributeChangedSignal("RiderUserId"):Connect(function()
		if model == m then
			setRiding(m:GetAttribute("RiderUserId") == LocalPlayer.UserId)
		end
	end)
	-- equip switch / mutation: the server hot-swaps the dragon on the same root
	m:GetAttributeChangedSignal("VisualRev"):Connect(function()
		if model == m and state then
			Locomotion.setStats(state, buildStats())
			if riding and root then
				registry.CameraController.setTarget(root, m:GetAttribute("Scale") or 1)
			end
		end
	end)
	m.AncestryChanged:Connect(function(_, parent)
		if parent == nil and model == m then
			unbind()
		end
	end)
	setRiding(m:GetAttribute("RiderUserId") == LocalPlayer.UserId)
	DragonController.ModelChanged:Fire(m)
end

-- ============================================================== input
local function rideInput()
	local Input = registry.InputController
	local Cam = registry.CameraController
	local raw = Input.getMoveVector()
	local yaw = Cam.getYaw()
	local camPitch = Cam.getPitch()
	local fwdFlat = Vector3.new(-sin(yaw), 0, -cos(yaw))
	local rightFlat = Vector3.new(cos(yaw), 0, -sin(yaw))
	local fwd, strafe = -raw.Z, raw.X
	local moveFlat = rightFlat * strafe + fwdFlat * fwd

	-- flight pitch from the camera: the default camera (looking slightly
	-- down at the dragon) flies level; a deadzone keeps cruising easy
	local p = camPitch + rad(14)
	if abs(p) < rad(6) then
		p = 0
	else
		p -= math.sign(p) * rad(6)
	end
	p = clamp(p * 1.2, -R.MaxPitch, R.MaxPitch)
	local c = cos(p)
	local fwd3 = Vector3.new(-sin(yaw) * c, sin(p), -cos(yaw) * c)
	local brake = false
	local move
	if fwd < -0.2 and state and state.Mode == "Fly" then
		brake = true
		move = rightFlat * strafe
	else
		move = rightFlat * strafe + fwd3 * fwd
	end
	local jumpHeld = Input.isDown("Jump")
	return {
		Move = move,
		MoveFlat = moveFlat,
		JumpPressed = Input.consume("Jump"),
		JumpHeld = jumpHeld,
		Ascend = jumpHeld,
		Descend = Input.isDown("Descend"),
		Sprint = Input.isDown("Sprint"),
		Brake = brake,
		CamYaw = yaw,
	}
end

local function teleportNear(hrp: BasePart)
	local s = state
	local r = root
	if not s or not r then
		return
	end
	local yaw = flatYaw(hrp.CFrame)
	local back = Vector3.new(sin(yaw), 0, cos(yaw))
	local right = Vector3.new(cos(yaw), 0, -sin(yaw))
	local spot = hrp.Position + back * (s.Stats.BodyRadius + 6) + right * 5
	local ok, gy = world.ground(spot + Vector3.new(0, 30, 0), 120)
	local y = ok and gy + s.Stats.HipHeight or hrp.Position.Y
	r.CFrame = CFrame.new(spot.X, y, spot.Z) * CFrame.Angles(0, yaw, 0)
	r.AssemblyLinearVelocity = Vector3.zero
	s.Position = r.Position
	s.Velocity = Vector3.zero
	s.Speed = 0
	s.Yaw = yaw
	Locomotion.setMode(s, ok and "Ground" or "Fly")
end

-- Companion behaviour while the player is on foot ("escort flight"): the
-- dragon circles above the player like a guardian (no ground path-finding,
-- so it never gets stuck on houses or bumps into the player), and lands
-- beside the player after they stand still for a few seconds.
local escort = { Angle = math.random() * math.pi * 2, Still = 0, Dir = 1 }

local function followInput(dt: number)
	local input = { Move = Vector3.zero, MoveFlat = Vector3.zero, JumpPressed = false, JumpHeld = false }
	local _, hrp, hum = character()
	local s = state
	if not hrp or not hum or hum.Health <= 0 or not s or not root then
		return input
	end
	local myPos = root.Position
	local target = hrp.Position
	local flat = Vector3.new(target.X - myPos.X, 0, target.Z - myPos.Z)
	local d = flat.Magnitude
	local hip = s.Stats.HipHeight
	local br = s.Stats.BodyRadius
	local feetY = target.Y - (hum.HipHeight + hrp.Size.Y * 0.5)
	local dy = feetY - (myPos.Y - hip)
	if d > 320 or abs(dy) > 220 then
		teleportNear(hrp)
		return input
	end
	local pv = hrp.AssemblyLinearVelocity
	local playerSpeed = Vector3.new(pv.X, 0, pv.Z).Magnitude
	local grounded = math.abs(pv.Y) < 3
	if playerSpeed > 3 or not grounded or d > 70 then
		escort.Still = 0
	else
		escort.Still += dt
	end
	local flying = s.Mode == "Fly" or s.Mode == "Takeoff" or s.Mode == "Landing"

	-- fetch: fly to eggs near the player and pick them up (like a loyal pet)
	local eggCtl = registry.EggController
	local fetch = eggCtl and eggCtl.fetchTarget and eggCtl.fetchTarget(Vector3.new(target.X, feetY, target.Z), 75)
	if fetch then
		escort.Still = 0
		if not flying then
			input.FlyToggle = true
			return input
		end
		local goal = fetch + Vector3.new(0, hip * 0.7 + 1.5, 0)
		local to = goal - myPos
		local desired = to * 1.6
		if desired.Magnitude > s.Stats.CruiseSpeed then
			desired = desired.Unit * s.Stats.CruiseSpeed
		end
		if desired.Magnitude > 0.5 then
			input.Move = desired.Unit * clamp(desired.Magnitude / math.max(1, s.Stats.CruiseSpeed), 0.25, 1)
			input.MoveFlat = Vector3.new(to.X, 0, to.Z)
		end
		return input
	end

	-- settle: land beside a player who stands still
	if escort.Still > 4 then
		if not flying then
			return input -- resting on the ground next to the player
		end
		local away = Vector3.new(myPos.X - target.X, 0, myPos.Z - target.Z)
		away = away.Magnitude > 0.1 and away.Unit or Vector3.new(1, 0, 0)
		local spot = Vector3.new(target.X, feetY + hip, target.Z) + away * (9 + br * 1.6)
		local to = spot - myPos
		local flatTo = Vector3.new(to.X, 0, to.Z)
		if flatTo.Magnitude > 5 then
			local desired = flatTo.Unit * math.min(flatTo.Magnitude * 1.2, 40) + Vector3.new(0, math.clamp(to.Y + 6, -12, 12), 0)
			input.Move = desired.Unit * clamp(desired.Magnitude / math.max(1, s.Stats.CruiseSpeed), 0.12, 1)
			input.MoveFlat = flatTo
		else
			input.Descend = true
		end
		return input
	end

	-- escort: take off (resting dragons wait until the player walks away)
	if not flying then
		if d > 18 + br or dy > 14 or playerSpeed > 6 then
			flyIntent += dt
		else
			flyIntent = math.max(0, flyIntent - dt)
		end
		if flyIntent > 0.35 then
			flyIntent = 0
			input.FlyToggle = true
		end
		return input
	end

	-- circle the player: a glide at ~28 studs/s around a centre that leads
	-- the player's motion; height keeps clear of roofs and terrain
	local radius = 20 + br * 2.4
	local omega = 28 / radius
	escort.Angle = (escort.Angle + omega * dt * escort.Dir) % (math.pi * 2)
	local center = Vector3.new(target.X, 0, target.Z) + Vector3.new(pv.X, 0, pv.Z) * 0.5
	local a = escort.Angle
	local height = feetY + 16 + hip * 1.6
	local goal = Vector3.new(center.X + math.cos(a) * radius, height, center.Z + math.sin(a) * radius)
	local ok, gy = world.ground(goal + Vector3.new(0, 60, 0), 160)
	if ok then
		goal = Vector3.new(goal.X, math.max(goal.Y, gy + hip + 10), goal.Z)
	end
	local tangent = Vector3.new(-math.sin(a), 0, math.cos(a)) * (omega * radius * escort.Dir)
	local desired = Vector3.new(pv.X, 0, pv.Z) + tangent + (goal - myPos) * 1.1
	local speed = desired.Magnitude
	if speed > 0.5 then
		input.Move = desired.Unit * clamp(speed / math.max(1, s.Stats.CruiseSpeed), 0.15, 1)
		input.MoveFlat = Vector3.new(desired.X, 0, desired.Z)
		input.Sprint = (goal - myPos).Magnitude > 120
	end
	return input
end

-- ============================================================== events
local function handleEvents(s)
	local anim = registry.AnimationController
	local cam = registry.CameraController
	local audio = registry.AudioController
	local m = model :: Model
	local r = root :: BasePart
	for _, e in s.Events do
		local k = e.Kind
		if k == "Jump" then
			anim.play(m, "Jump")
			send({ Shot = "Jump" })
		elseif k == "Takeoff" then
			anim.play(m, "Takeoff")
			audio.play3D("Takeoff", r, 0.08)
			if riding then
				cam.shake(0.18)
			end
			send({ Shot = "Takeoff" })
		elseif k == "CatchFall" then
			anim.play(m, "Takeoff", 1.3)
		elseif k == "Touchdown" or k == "Land" then
			local impact = tonumber(e.Data) or 0
			if k == "Touchdown" or impact > 25 then
				anim.play(m, "Landing")
				audio.play3D("Landing", r, 0.06, clamp(impact / 50, 0.4, 1))
				if riding then
					cam.shake(clamp(impact / 120, 0.12, 0.45))
				end
				send({ Shot = "Landing" })
			end
		elseif k == "Bump" then
			if riding and (tonumber(e.Data) or 0) > 25 then
				cam.shake(0.12)
			end
		elseif k == "BoostStart" then
			if riding then
				cam.shake(0.12)
			end
		end
	end
	-- low-rate replication of mode / boost
	local mode = s.Mode
	if mode ~= lastSent.Mode or s.Boosting ~= lastSent.Boost then
		lastSent.Mode = mode
		lastSent.Boost = s.Boosting
		send({ Mode = mode, Boost = s.Boosting })
		if registry.Hud then
			registry.Hud:SetRideMode(mode)
		end
	end
end

-- ============================================================== frame
function DragonController.preStep(dt: number)
	local m, r, s = model, root, state
	if not m or not r or not s or not r.Parent then
		return
	end
	s.Position = r.Position
	local input
	if riding then
		input = rideInput()
		roarCooldown = math.max(0, roarCooldown - dt)
		if registry.InputController.consume("Roar") and roarCooldown <= 0 then
			roarCooldown = 2.2
			registry.AnimationController.play(m, "Roar")
			registry.AudioController.play3D("Roar", r, 0.05)
			registry.CameraController.shake(0.1)
			Net.fire("DragonState", { Shot = "Roar" })
		end
	else
		input = followInput(dt)
	end
	Locomotion.step(s, input, dt, world)
	if drive then
		drive.VectorVelocity = s.Velocity
	end
	if attitude then
		attitude.CFrame = Locomotion.orientation(s)
	end
	registry.AnimationController.setLocal(m, Locomotion.animParams(s))
	handleEvents(s)

	local v = s.Velocity
	local speed = v.Magnitude
	if riding then
		registry.CameraController.setInfo({
			Mode = s.Mode,
			Speed = s.Mode == "Fly" and s.Speed or Vector3.new(v.X, 0, v.Z).Magnitude,
			Cruise = s.Stats.CruiseSpeed,
			Boosting = s.Boosting,
			Roll = s.Roll,
			Yaw = s.Yaw,
			Pitch = s.FlightPitch,
			Velocity = v,
		})
		hudTimer += dt
		if hudTimer > 0.1 and registry.Hud then
			hudTimer = 0
			registry.Hud:SetFlightStats(speed, s.Boost, s.Boosting)
		end
		if wind then
			local target = clamp((speed - 35) / 220, 0, 0.75)
			wind.Volume += (target - wind.Volume) * math.min(1, dt * 3)
		end
	end
end

-- ============================================================== public
function DragonController.toggleRide()
	if busy then
		return
	end
	if not equippedRecord() then
		registry.UIController.Notify("info", "Equip a dragon in your collection first.")
		return
	end
	busy = true
	task.spawn(function()
		local res = Net.request("Mount", "Toggle")
		registry.UIController.HandleResult(res)
		busy = false
	end)
end

-- Wind Dash (Dragon Bond): a short surge forward. BondController owns cooldown / unlock.
function DragonController.dash(duration: number, multiplier: number): boolean
	local s, m, r = state, model, root
	if not riding or not s or not m or not r then
		return false
	end
	Locomotion.dash(s, duration, multiplier)
	registry.AnimationController.play(m, "Dash")
	registry.CameraController.shake(0.14)
	return true
end

function DragonController.isRiding(): boolean
	return riding
end

function DragonController.getModel(): Model?
	return model
end

function DragonController.getState()
	return state
end

function DragonController.Init(reg)
	registry = reg
end

function DragonController.Start()
	local input = registry.InputController
	input.Pressed:Connect(function(action)
		if action == "Ride" then
			DragonController.toggleRide()
		elseif action == "MouseLock" and riding then
			local settings = registry.SettingsController
			if settings then
				local on = not (settings.get("MouseLock") ~= false)
				settings.set("MouseLock", on)
				registry.UIController.Notify("info", on and "Mouse steering ON  (hold Alt for the cursor)" or "Mouse steering OFF  (hold right mouse to look)")
			end
		end
	end)
	registry.DataController.observe("Dragons", function()
		if state and model then
			Locomotion.setStats(state, buildStats())
		end
	end)
	-- Great Tree upgrades bought while riding take effect right away
	registry.DataController.observe("Tree", function()
		if state and model then
			Locomotion.setStats(state, buildStats())
		end
	end)
	wind = registry.AudioController.loop("Wind")
	local folder = Workspace:WaitForChild("Dragons", 30)
	if not folder then
		return
	end
	local name = "Dragon_" .. LocalPlayer.UserId
	local function consider(child: Instance)
		if child.Name == name and child:IsA("Model") then
			task.spawn(bind, child)
		end
	end
	for _, c in folder:GetChildren() do
		consider(c)
	end
	folder.ChildAdded:Connect(consider)
	LocalPlayer.CharacterAdded:Connect(function()
		if riding then
			setRiding(false)
		end
	end)
end

return DragonController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000100">
					<Properties>
						<string name="Name">EggController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	EggController
	Shows the local player's personal world eggs (glowing shells with a light
	pillar visible from the air), animates them, and picks them up when the
	player walks or flies through them (server validates range + capacity).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local EggVisual = require(Shared:WaitForChild("EggVisual"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))
local GameConfig = require(Configs:WaitForChild("GameConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local EggController = {}

local registry
local LocalPlayer = Players.LocalPlayer
local folder: Folder? = nil
local eggs: { [string]: any } = {} -- key -> { Key, Type, Position, Model, Pending }
local lastFullWarning = 0
local clock = 0

local function getFolder(): Folder
	if not folder or not folder.Parent then
		local f = Instance.new("Folder")
		f.Name = "MyEggs"
		f.Parent = Workspace
		folder = f
	end
	return folder :: Folder
end

local function removeEgg(key: string, collected: boolean)
	local e = eggs[key]
	if not e then
		return
	end
	eggs[key] = nil
	local model = e.Model
	if not model then
		return
	end
	if collected then
		-- collect burst: shell pops, glow flashes outward, then fades
		local shell = model.PrimaryPart
		local def = EggConfig.Eggs[e.Type] or EggConfig.Eggs.HavenEgg
		local burst = Instance.new("Part")
		burst.Anchored = true
		burst.CanCollide = false
		burst.CanQuery = false
		burst.CanTouch = false
		burst.Shape = Enum.PartType.Ball
		burst.Material = Enum.Material.Neon
		burst.Color = def.Glow
		burst.Size = Vector3.new(2, 2, 2)
		burst.CFrame = shell and shell.CFrame or CFrame.new(e.Position)
		burst.Transparency = 0.2
		burst.CastShadow = false
		burst.Parent = getFolder()
		TweenService:Create(burst, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Size = Vector3.new(14, 14, 14),
			Transparency = 1,
		}):Play()
		task.delay(0.5, function()
			burst:Destroy()
		end)
		local audio = registry.AudioController
		if audio and shell then
			audio.play3D("EggPickup", shell, 0.05)
		end
	end
	model:Destroy()
end

local function addEgg(info)
	if type(info) ~= "table" or type(info.Key) ~= "string" then
		return
	end
	removeEgg(info.Key, false)
	local luck = math.max(1, tonumber(info.Luck) or 1)
	local model = EggVisual.build(info.Type, { Beam = true, Scale = luck >= 50 and 1.25 or (luck >= 10 and 1.12 or 1) })
	model.Name = "Egg_" .. info.Key
	EggVisual.place(model, CFrame.new(info.Position))
	local shell = model.PrimaryPart
	local def = EggConfig.Eggs[info.Type] or EggConfig.Eggs.HavenEgg
	-- floating label: egg name + its luck (big, coloured by how lucky)
	if shell then
		local bb = Instance.new("BillboardGui")
		bb.Name = "LuckLabel"
		bb.Size = UDim2.fromScale(9, 3.2)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 4.6, 0)
		bb.MaxDistance = 220
		bb.LightInfluence = 0
		bb.AlwaysOnTop = luck >= 25
		bb.Parent = shell
		local luckText = Instance.new("TextLabel")
		luckText.Name = "Luck"
		luckText.BackgroundTransparency = 1
		luckText.Size = UDim2.fromScale(1, 0.6)
		luckText.Font = Enum.Font.GothamBlack
		luckText.TextScaled = true
		luckText.Text = "x" .. tostring(luck) .. " LUCK"
		luckText.TextColor3 = EggConfig.luckColor(luck)
		luckText.TextStrokeTransparency = 0.25
		luckText.Parent = bb
		local nameText = Instance.new("TextLabel")
		nameText.Name = "EggName"
		nameText.BackgroundTransparency = 1
		nameText.Position = UDim2.fromScale(0, 0.62)
		nameText.Size = UDim2.fromScale(1, 0.36)
		nameText.Font = Enum.Font.GothamBold
		nameText.TextScaled = true
		nameText.Text = string.upper(def.Name)
		nameText.TextColor3 = def.Glow
		nameText.TextStrokeTransparency = 0.35
		nameText.Parent = bb
		if luck >= 10 then
			-- lucky eggs sparkle in their luck colour (rainbow from x100)
			local pe = Instance.new("ParticleEmitter")
			pe.Name = "LuckSparkles"
			pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
			pe.Color = luck >= 100 and ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
				ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 220, 60)),
				ColorSequenceKeypoint.new(0.66, Color3.fromRGB(90, 220, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 120, 255)),
			}) or ColorSequence.new(EggConfig.luckColor(luck))
			pe.LightEmission = 1
			pe.Rate = luck >= 100 and 26 or 12
			pe.Lifetime = NumberRange.new(0.8, 1.6)
			pe.Speed = NumberRange.new(1, 3)
			pe.SpreadAngle = Vector2.new(180, 180)
			pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.3, 0.6), NumberSequenceKeypoint.new(1, 0) })
			pe.Parent = shell
		end
	end
	model.Parent = getFolder()
	eggs[info.Key] = {
		Key = info.Key,
		Type = info.Type,
		Luck = luck,
		Position = info.Position,
		Model = model,
		Phase = math.random() * math.pi * 2,
		Pending = false,
	}
end

local function myPositions(): ({ Vector3 }, number)
	local out = {}
	local slack = 0
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		table.insert(out, hrp.Position)
	end
	local dragons = Workspace:FindFirstChild("Dragons")
	local model = dragons and dragons:FindFirstChild("Dragon_" .. LocalPlayer.UserId)
	local root = model and model:FindFirstChild("Root") :: BasePart?
	if root then
		-- your dragon picks eggs up too (ridden or flying around you)
		table.insert(out, root.Position)
		slack = ((model :: Model):GetAttribute("BodyRadius") or 0) * 0.5
		if (model :: Model):GetAttribute("RiderUserId") == LocalPlayer.UserId then
			slack += 6 -- swooping over an egg while riding is enough
		end
	end
	return out, slack
end

local function tryPickup(e)
	e.Pending = true
	task.spawn(function()
		local res = Net.request("Egg", "Pickup", { Key = e.Key })
		if res.ok then
			removeEgg(e.Key, true)
			local uic = registry.UIController
			local def = EggConfig.Eggs[res.data.Type]
			-- the egg jumps into your hand (or into the bag when your hand is full)
			local held = registry.HeldEggController
			if held and res.data.Held then
				held.flyIn(res.data.Type, e.Position)
			end
			if uic then
				local luck = tonumber(res.data.Luck) or 1
				local where = res.data.Held and "  -  in your hand" or "  -  in your bag"
				uic.Notify(luck >= 25 and "rare" or "success", "+1 " .. (def and def.Name or "Egg") .. (luck > 1 and ("  (x" .. tostring(luck) .. " LUCK)") or "") .. where)
			end
		else
			e.Pending = false
			if res.err == "EGG_STORAGE_FULL" then
				e.CooldownUntil = clock + 3
				EggController.BagFullAt = clock
				if clock - lastFullWarning > 6 then
					lastFullWarning = clock
					local uic = registry.UIController
					if uic then
						uic.Notify("warning", res.msg or "Your egg bag is full!")
					end
				end
			elseif res.err == "GONE" then
				removeEgg(e.Key, false)
			else
				e.CooldownUntil = clock + 1
			end
		end
	end)
end

local function step(dt: number)
	clock += dt
	local positions, slack = myPositions()
	-- Great Tree "Egg Magnet" widens the pickup range
	local range = GameConfig.Interaction.EggPickupRange * (1 + TreeConfig.bonus(registry.DataController.all(), "EggMagnet")) + slack
	for _, e in eggs do
		local model = e.Model
		if model and model.Parent then
			-- bob + spin
			local t = clock + e.Phase
			EggVisual.place(model, CFrame.new(e.Position + Vector3.new(0, math.sin(t * 2) * 0.35, 0)) * CFrame.Angles(0, t * 0.8, math.sin(t * 1.3) * 0.08))
		end
		if not e.Pending and (not e.CooldownUntil or clock > e.CooldownUntil) then
			for _, p in positions do
				if (p - e.Position).Magnitude <= range then
					tryPickup(e)
					break
				end
			end
		end
	end
end

-- Nearest egg the companion should fly to and pick up (nil when the bag is
-- full or nothing is close to the player).
EggController.BagFullAt = -100
function EggController.fetchTarget(center: Vector3, range: number): Vector3?
	if clock - EggController.BagFullAt < 12 then
		return nil
	end
	local best, bestD = nil, range
	for _, e in eggs do
		if not e.Pending and (not e.CooldownUntil or clock > e.CooldownUntil) then
			local d = (e.Position - center).Magnitude
			if d < bestD then
				best, bestD = e.Position, d
			end
		end
	end
	return best
end

function EggController.count(): number
	local n = 0
	for _ in eggs do
		n += 1
	end
	return n
end

function EggController.list()
	return eggs
end

function EggController.Init(reg)
	registry = reg
end

function EggController.Start()
	Net.onSignal("Eggs", function(payload)
		for key in table.clone(eggs) do
			removeEgg(key, false)
		end
		for _, info in payload and payload.List or {} do
			addEgg(info)
		end
	end)
	Net.onSignal("EggAdded", addEgg)
	Net.onSignal("EggRemoved", function(payload)
		if payload and payload.Key then
			removeEgg(payload.Key, false)
		end
	end)
	RunService.Heartbeat:Connect(step)
	-- resync once in case the initial list arrived before this controller started
	task.delay(4, function()
		if EggController.count() == 0 then
			local res = Net.request("Egg", "Sync", {})
			if res.ok and res.data then
				for _, info in res.data.List or {} do
					addEgg(info)
				end
			end
		end
	end)
end

return EggController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000101">
					<Properties>
						<string name="Name">GraphicsController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	GraphicsController
	Quality presets (MAX default on desktop, HIGH, MEDIUM - no LOW mode).
	Controls post effects, particle density, decoration/LOD distances and the
	soft blur behind open menus. Other systems read the live values:
	  GraphicsController.ParticleScale, .DecorDistance, .DragonDetailDistance
]]

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local CollectionService = game:GetService("CollectionService")
local Workspace = game:GetService("Workspace")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)

local GraphicsController = {}
GraphicsController.Changed = Signal.new()
GraphicsController.Preset = "Max"
GraphicsController.ParticleScale = 1
GraphicsController.DecorDistance = 900
GraphicsController.DragonDetailDistance = 420
GraphicsController.AnimationDistance = 700
GraphicsController.Shadows = true

-- Blur is the size of the optional soft menu blur (Settings > Menu blur, off by default).
local PRESETS = {
	Max = { Particles = 1, Decor = 950, DragonDetail = 460, Anim = 800, Bloom = true, SunRays = true, DOF = true, Shadows = true, Decoration = true, Blur = 8 },
	High = { Particles = 0.7, Decor = 650, DragonDetail = 320, Anim = 550, Bloom = true, SunRays = true, DOF = false, Shadows = true, Decoration = true, Blur = 6 },
	Medium = { Particles = 0.4, Decor = 380, DragonDetail = 200, Anim = 350, Bloom = true, SunRays = false, DOF = false, Shadows = false, Decoration = false, Blur = 0 },
}

GraphicsController.MenuBlurEnabled = false -- opt-in; see Settings > Menu blur

local blur: BlurEffect = nil
local blurTween: Tween? = nil
local uiRef = nil
local particleBase = setmetatable({}, { __mode = "k" }) :: { [ParticleEmitter]: number }

local function applyParticles()
	for _, pe in CollectionService:GetTagged("FX") do
		if pe:IsA("ParticleEmitter") then
			local base = particleBase[pe]
			if base == nil then
				base = pe.Rate
				particleBase[pe] = base
			end
			pe.Rate = base * GraphicsController.ParticleScale
		end
	end
end

function GraphicsController.setPreset(name: string)
	local p = PRESETS[name] or PRESETS.Max
	GraphicsController.Preset = PRESETS[name] and name or "Max"
	GraphicsController.ParticleScale = p.Particles
	GraphicsController.DecorDistance = p.Decor
	GraphicsController.DragonDetailDistance = p.DragonDetail
	GraphicsController.AnimationDistance = p.Anim
	GraphicsController.Shadows = p.Shadows
	GraphicsController.BlurSize = p.Blur
	for _, effect in Lighting:GetChildren() do
		if effect:IsA("BloomEffect") then
			effect.Enabled = p.Bloom
		elseif effect:IsA("SunRaysEffect") then
			effect.Enabled = p.SunRays
		elseif effect:IsA("DepthOfFieldEffect") then
			effect.Enabled = p.DOF
		end
	end
	pcall(function()
		Workspace.Terrain.Decoration = p.Decoration
	end)
	for _, light in CollectionService:GetTagged("ShadowLight") do
		if light:IsA("Light") then
			light.Shadows = p.Shadows
		end
	end
	applyParticles()
	GraphicsController.Changed:Fire(GraphicsController.Preset)
end

-- The blur is opt-in (Settings > Menu blur) and never applied to windows that sit over the
-- 3D world (NoBackdrop, e.g. the Spin Wheel) - the thing you look at must stay sharp.
function GraphicsController.setMenuBlur(on: boolean)
	if not blur then
		return
	end
	if blurTween then
		blurTween:Cancel()
	end
	local size = (on and GraphicsController.MenuBlurEnabled) and (GraphicsController.BlurSize or 0) or 0
	blur.Enabled = size > 0 or blur.Size > 0
	blurTween = TweenService:Create(blur, TweenInfo.new(on and 0.22 or 0.16, Enum.EasingStyle.Quad), { Size = size })
	blurTween:Play()
end

function GraphicsController.setMenuBlurEnabled(on: boolean)
	GraphicsController.MenuBlurEnabled = on
	local ui = uiRef
	local current = ui and ui.Current and ui.Windows[ui.Current] or nil
	GraphicsController.setMenuBlur(current ~= nil and current.NoBackdrop ~= true)
end

function GraphicsController.Init(registry)
	blur = Instance.new("BlurEffect")
	blur.Name = "RAD_MenuBlur"
	blur.Size = 0
	blur.Parent = Lighting
	CollectionService:GetInstanceAddedSignal("FX"):Connect(function(pe)
		if pe:IsA("ParticleEmitter") then
			particleBase[pe] = pe.Rate
			pe.Rate = pe.Rate * GraphicsController.ParticleScale
		end
	end)
	local ui = registry.UIController
	uiRef = ui
	if ui then
		ui.WindowOpened:Connect(function(_name, window)
			GraphicsController.setMenuBlur(not (window and window.NoBackdrop == true))
		end)
		ui.WindowClosed:Connect(function()
			if not ui.Current then
				GraphicsController.setMenuBlur(false)
			end
		end)
	end
	GraphicsController.setPreset("Max")
end

return GraphicsController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000102">
					<Properties>
						<string name="Name">HatchController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	HatchController
	Hatching cinematic + result card.

	Sequence (client-only, the server already decided the result):
	  1. APPROACH  the room darkens, the camera glides to the egg and the egg
	               lifts into a pool of light
	  2. CHARGE    the egg wobbles faster and faster while the RNG roll spins;
	               glowing cracks open one by one (flash, sparks, camera shake)
	  3. BURST     white flash, shell shards, shock ring and a pillar of light
	  4. WALK      the dragon steps out of the light and WALKS TOWARDS THE CAMERA
	  5. ROAR      it stops, rears up and ROARS (camera push-in, shock wave,
	               mutation burst)
	  6. CARD      result card (rarity, name, mutation, NEW, stats, Ride it /
	               Awesome) while the camera slowly orbits the idling dragon
	Rare results (rarity or "1 in N") get a longer charge and more cracks.
	A SKIP button jumps straight to the result card.

	All timing is frame-time based (not wall clock), so the cinematic can be
	driven and tested in the simulator.

	HatchController.Phase: "" | Approach | Charge | Burst | Walk | Roar | Card
	HatchController.Stage / .Dragon: the live stage folder and hatchling (tests, tools)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local EggVisual = require(Shared:WaitForChild("EggVisual"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local DragonVisual = require(Shared:WaitForChild("Dragons"):WaitForChild("DragonVisual"))
local Animator = require(Shared:WaitForChild("Dragons"):WaitForChild("Animator"))
local Species = require(Shared:WaitForChild("Dragons"):WaitForChild("Species"))
local Builder = require(Shared:WaitForChild("Dragons"):WaitForChild("Builder"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))
local HatchConfig = require(Configs:WaitForChild("HatchConfig"))
local Odds = require(Shared:WaitForChild("Odds"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Theme = require(UI:WaitForChild("Theme"))
local Kit = require(UI:WaitForChild("Kit"))
local Responsive = require(UI:WaitForChild("Responsive"))

local C = Theme.Colors

local HatchController = {}
HatchController.Phase = ""
HatchController.Stage = nil :: Folder?
HatchController.Dragon = nil :: any
HatchController.Framing = nil :: any

local registry
local busy = false
local active: { Cleanup: () -> () }? = nil
local LocalPlayer = Players.LocalPlayer

-- ============================================================== helpers
local function ease(t: number): number
	t = math.clamp(t, 0, 1)
	return t * t * (3 - 2 * t)
end

-- One frame of time (a missing dt must never stall the cinematic).
local function frame(): number
	local dt = RunService.RenderStepped:Wait()
	if type(dt) ~= "number" then
		dt = 1 / 60
	end
	return math.min(dt, 0.1)
end

-- Runs fn(a, t, dt) for `duration` seconds (a = 0..1). Returns false when the
-- player skipped the cinematic.
local function run(state, duration: number, fn: (number, number, number) -> ()): boolean
	local t = 0
	while true do
		if state.Skip then
			return false
		end
		local dt = frame()
		t += dt
		local a = math.clamp(t / duration, 0, 1)
		fn(a, t, dt)
		if a >= 1 then
			return true
		end
	end
end

local function tweenCamera(state, camera: Camera, to: CFrame, duration: number)
	local from = camera.CFrame
	if not run(state, duration, function(a)
		camera.CFrame = from:Lerp(to, ease(a))
	end) then
		camera.CFrame = to
	end
end

local function neonBall(color: Color3, size: number, cf: CFrame, parent: Instance): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Ball
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = Vector3.new(size, size, size)
	p.CFrame = cf
	p.Parent = parent
	return p
end

-- Flat neon ring / disc lying on the ground (diameter d).
local function neonDisc(color: Color3, d: number, at: Vector3, parent: Instance, transparency: number): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Cylinder
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Size = Vector3.new(0.15, d, d)
	p.CFrame = CFrame.new(at) * CFrame.Angles(0, 0, math.rad(90))
	p.Transparency = transparency
	p.Parent = parent
	return p
end

local function shards(color: Color3, at: Vector3, parent: Instance)
	for i = 1, 16 do
		local s = Instance.new("Part")
		s.CanCollide = false
		s.CanQuery = false
		s.CanTouch = false
		s.Material = Enum.Material.SmoothPlastic
		s.Color = color
		s.Size = Vector3.new(0.6, 0.15, 0.8) * (0.7 + math.random() * 0.8)
		s.CFrame = CFrame.new(at) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6)
		s.Parent = parent
		local a = i / 16 * math.pi * 2
		s.AssemblyLinearVelocity = Vector3.new(math.cos(a) * 18, 22 + math.random() * 14, math.sin(a) * 18)
		s.AssemblyAngularVelocity = Vector3.new(math.random() * 20, math.random() * 20, math.random() * 20)
		task.delay(2.2, function()
			s:Destroy()
		end)
	end
end

-- One-off burst of sparkles / confetti from a point.
local function confetti(parent: Instance, at: Vector3, colors: { Color3 }, count: number)
	local holder = Instance.new("Part")
	holder.Anchored = true
	holder.CanCollide = false
	holder.CanQuery = false
	holder.CanTouch = false
	holder.Transparency = 1
	holder.Size = Vector3.new(1, 1, 1)
	holder.CFrame = CFrame.new(at)
	holder.Parent = parent
	local keys = {}
	for i, col in colors do
		table.insert(keys, ColorSequenceKeypoint.new((i - 1) / math.max(1, #colors - 1), col))
	end
	if #keys == 1 then
		table.insert(keys, ColorSequenceKeypoint.new(1, colors[1]))
	end
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(keys)
	pe.LightEmission = 1
	pe.Lifetime = NumberRange.new(0.9, 1.7)
	pe.Speed = NumberRange.new(14, 34)
	pe.SpreadAngle = Vector2.new(180, 180)
	pe.Acceleration = Vector3.new(0, -14, 0)
	pe.Rate = 0
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.15, 1.1), NumberSequenceKeypoint.new(1, 0) })
	pe.Parent = holder
	pe:Emit(count)
	task.delay(2.2, function()
		holder:Destroy()
	end)
end

-- ============================================================== cinematic dressing
-- Darkened, cinematic grade + edge vignette + white flash layer. Everything is
-- removed again by Fx.Cleanup().
local function newFx(layer: Instance)
	local fx = { Items = {} }
	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name = "HatchGrade"
	cc.Parent = Lighting
	table.insert(fx.Items, cc)
	local dof = Instance.new("DepthOfFieldEffect")
	dof.Name = "HatchFocus"
	dof.FarIntensity = 0
	dof.NearIntensity = 0
	dof.InFocusRadius = 60
	dof.FocusDistance = 14
	dof.Parent = Lighting
	table.insert(fx.Items, dof)
	fx.Grade, fx.Focus = cc, dof

	local vignette = Instance.new("Frame")
	vignette.Name = "HatchVignette"
	vignette.BackgroundTransparency = 1
	vignette.Size = UDim2.fromScale(1, 1)
	vignette.ZIndex = 0
	vignette.Parent = layer
	table.insert(fx.Items, vignette)
	fx.Edges = {}
	local function edge(anchor: Vector2, pos: UDim2, size: UDim2, rotation: number)
		local f = Instance.new("Frame")
		f.BackgroundColor3 = Color3.new(0, 0, 0)
		f.BackgroundTransparency = 1
		f.BorderSizePixel = 0
		f.AnchorPoint = anchor
		f.Position = pos
		f.Size = size
		local g = Instance.new("UIGradient")
		g.Rotation = rotation
		g.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 1) })
		g.Parent = f
		f.Parent = vignette
		table.insert(fx.Edges, f)
	end
	edge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.24), 90)
	edge(Vector2.new(0, 1), UDim2.fromScale(0, 1), UDim2.fromScale(1, 0.24), 270)
	edge(Vector2.new(0, 0), UDim2.fromScale(0, 0), UDim2.fromScale(0.17, 1), 0)
	edge(Vector2.new(1, 0), UDim2.fromScale(1, 0), UDim2.fromScale(0.17, 1), 180)

	local flash = Instance.new("Frame")
	flash.Name = "HatchFlash"
	flash.BackgroundColor3 = Color3.new(1, 1, 1)
	flash.BackgroundTransparency = 1
	flash.BorderSizePixel = 0
	flash.Size = UDim2.fromScale(1, 1)
	flash.ZIndex = 50
	flash.Parent = layer
	table.insert(fx.Items, flash)
	fx.Flash = flash

	function fx.Darken(on: boolean, seconds: number)
		local info = TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		TweenService:Create(cc, info, {
			Brightness = on and -0.2 or 0,
			Contrast = on and 0.14 or 0,
			Saturation = on and -0.16 or 0,
		}):Play()
		TweenService:Create(dof, info, { FarIntensity = on and 0.5 or 0, NearIntensity = on and 0.2 or 0 }):Play()
		for _, e in fx.Edges do
			TweenService:Create(e, info, { BackgroundTransparency = on and 0 or 1 }):Play()
		end
	end

	-- white flash: 0 -> opaque -> clear
	function fx.Pulse(peak: number, seconds: number)
		flash.BackgroundTransparency = 1 - peak
		TweenService:Create(flash, TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { BackgroundTransparency = 1 }):Play()
	end

	function fx.Cleanup()
		for _, inst in fx.Items do
			inst:Destroy()
		end
		table.clear(fx.Items)
	end
	return fx
end

local function skipButton(layer: Instance, state)
	local btn = Kit.button({
		Name = "HatchSkip",
		Text = "SKIP",
		Style = "Secondary",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -18),
		Size = UDim2.fromScale(0.1, 0.06),
		Parent = layer,
	})
	Responsive.bind(btn.Instance, "Size", function(R)
		if R.Device == "Phone" then
			return R.Portrait and UDim2.fromScale(0.3, 0.07) or UDim2.fromScale(0.16, 0.13)
		end
		return UDim2.fromScale(0.1, 0.06)
	end)
	btn.Instance.Visible = false
	btn.Activated:Connect(function()
		state.Skip = true
	end)
	return btn
end

-- ============================================================== egg cracks
-- A glowing crack on the shell: a short zig-zag of neon bars (rides along with the egg).
local function addCrack(egg: Model, def, index: number, rng: Random)
	local shell = egg.PrimaryPart
	if not shell then
		return Vector3.zero
	end
	local size = shell.Size
	local u = rng:NextNumber(-0.45, 0.72)
	local a = rng:NextNumber(0, math.pi * 2)
	local r = math.sqrt(math.max(0, 1 - u * u))
	local n = Vector3.new(math.cos(a) * r, u, math.sin(a) * r)
	local p = Vector3.new(n.X * size.X / 2, n.Y * size.Y / 2, n.Z * size.Z / 2)
	local base = CFrame.lookAt(p * 1.01, p * 1.01 + n) * CFrame.Angles(0, 0, rng:NextNumber(0, math.pi * 2))
	local color = def.Glow:Lerp(Color3.new(1, 1, 1), 0.55)
	local cf = base
	for seg = 1, 3 do
		local len = rng:NextNumber(0.5, 0.85)
		local bar = Instance.new("Part")
		bar.Name = "Crack" .. index .. "_" .. seg
		bar.Anchored = true
		bar.CanCollide = false
		bar.CanQuery = false
		bar.CanTouch = false
		bar.CastShadow = false
		bar.Material = Enum.Material.Neon
		bar.Color = color
		bar.Size = Vector3.new(0.075, len, 0.075)
		bar.CFrame = shell.CFrame * (cf * CFrame.new(0, len / 2, 0))
		bar.Parent = egg
		cf = cf * CFrame.new(0, len, 0) * CFrame.Angles(0, 0, rng:NextNumber(-0.45, 0.45))
	end
	local att = Instance.new("Attachment")
	att.Name = "CrackSpark" .. index
	att.CFrame = base
	att.Parent = shell
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	pe.Color = ColorSequence.new(color)
	pe.LightEmission = 1
	pe.Lifetime = NumberRange.new(0.4, 0.9)
	pe.Speed = NumberRange.new(4, 11)
	pe.SpreadAngle = Vector2.new(70, 70)
	pe.Rate = 0
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.2, 0.5), NumberSequenceKeypoint.new(1, 0) })
	pe.Parent = att
	pe:Emit(14)
	return shell.CFrame:PointToWorldSpace(p)
end

-- ============================================================== companion
-- The player's own companion dragon would stand in the shot: hide it (client-side only,
-- nothing replicates) until the show is over. Returns the function that brings it back.
local function hideCompanion(): () -> ()
	local dragons = Workspace:FindFirstChild("Dragons")
	local mine = dragons and dragons:FindFirstChild("Dragon_" .. LocalPlayer.UserId)
	if not mine then
		return function() end
	end
	local saved = {}
	for _, d in mine:GetDescendants() do
		if d:IsA("BasePart") then
			saved[d] = d.LocalTransparencyModifier
			d.LocalTransparencyModifier = 1
		elseif d:IsA("ParticleEmitter") or d:IsA("Trail") or d:IsA("Beam") or d:IsA("Light") then
			saved[d] = d.Enabled
			d.Enabled = false
		end
	end
	return function()
		for inst, value in saved do
			if inst.Parent then
				if inst:IsA("BasePart") then
					inst.LocalTransparencyModifier = value
				else
					(inst :: any).Enabled = value
				end
			end
		end
	end
end

-- ============================================================== camera spot
-- The plot has a gate, walls, lamps and a shrine: find a camera spot `dist` away from the
-- nest (and above it) whose whole line of sight - and the slow sway around it during the
-- result card - is clear. The player's side is tried first, then the directions fan out
-- left and right. Returns the direction and how much of the way was clear (1 = all).
local SWAY = 0.3 -- radians the camera may swing to either side while the card is up

local function clearSpot(focus: Vector3, preferred: Vector3, dist: number, ignore: { Instance }): (Vector3, number)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore
	params.RespectCanCollide = true
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = ignore
	-- high enough that the probe sphere never scrapes the plot floor
	local origin = focus + Vector3.new(0, 6, 0)
	local function lineClear(dir: Vector3): number
		local camPos = focus + dir * dist + Vector3.new(0, dist * 0.3, 0)
		local delta = camPos - origin
		local hit = Workspace:Spherecast(origin, 4.5, delta, params)
		local clear = hit and (hit.Position - origin).Magnitude / delta.Magnitude or 1
		if #Workspace:GetPartBoundsInRadius(camPos, 5, overlap) > 0 then
			clear = math.min(clear, 0.5)
		end
		return clear
	end
	local base = math.atan2(preferred.X, preferred.Z)
	local best, bestClear = preferred, -1
	for _, deg in { 0, 30, -30, 60, -60, 90, -90, 120, -120, 150, -150, 180 } do
		local a = base + math.rad(deg)
		local clear = 1
		for _, sway in { 0, SWAY, -SWAY } do
			local dir = Vector3.new(math.sin(a + sway), 0, math.cos(a + sway))
			clear = math.min(clear, lineClear(dir))
		end
		if clear >= 1 then
			return Vector3.new(math.sin(a), 0, math.cos(a)), 1
		end
		if clear > bestClear then
			best, bestClear = Vector3.new(math.sin(a), 0, math.cos(a)), clear
		end
	end
	return best, bestClear
end

-- ============================================================== live hatchling
-- The dragon as a living, animated model (Animator) so it can walk and roar.
local function spawnDragon(record, rootCF: CFrame, parent: Instance)
	local ok, result = pcall(function()
		local holder = Instance.new("Model")
		holder.Name = "Hatchling"
		local root = Builder.makeRoot(record.SpeciesId, nil)
		root.Anchored = true
		root.CFrame = rootCF
		root.Parent = holder
		holder.PrimaryPart = root
		local visual = DragonVisual.build(record.SpeciesId, { Root = root, Mutation = record.Mutation, Detail = "High", Saddle = false })
		visual.Name = "Visual"
		local fade = {}
		for _, d in visual:GetDescendants() do
			if d:IsA("BasePart") then
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
				fade[d] = d.Transparency
			end
		end
		visual.Parent = holder
		holder.Parent = parent
		local anim = Animator.new(visual)
		anim:Snap("Idle")
		return { Model = holder, Root = root, Visual = visual, Anim = anim, Fade = fade }
	end)
	if ok then
		return result
	end
	warn("[Hatch] dragon failed: " .. tostring(result))
	return nil
end

-- Fades the dragon in (0 = invisible, 1 = as built).
local function setReveal(dragon, k: number)
	for part, orig in dragon.Fade do
		if part.Parent then
			part.Transparency = 1 - (1 - orig) * k
		end
	end
end

local function animate(dragon, dt: number)
	if dragon and dragon.Anim then
		dragon.Anim:Update(dt)
		dragon.Anim:Apply(true)
	end
end

-- ============================================================== result card
local function resultCard(record, isNew: boolean, onEquip: () -> (), onContinue: () -> ())
	local uic = registry.UIController
	local layer = uic.Layers.GameModal and uic.Layers.GameModal.Root or uic.Layers.GameUI.Root
	local rarity = DragonConfig.Rarities[record.Rarity] or DragonConfig.Rarities.Common
	local root = Kit.frame({ Name = "HatchResult", Size = UDim2.fromScale(1, 1), Parent = layer })
	local card = Kit.surface({
		Name = "Card",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.fromScale(0.5, 0.95),
		Size = UDim2.fromScale(0.36, 0.34),
		Color = C.Panel,
		Transparency = 0.08,
		StrokeColor = rarity.Color,
		StrokeTransparency = 0.15,
		Radius = "Window",
		Parent = root,
	})
	local aspect = Instance.new("UIAspectRatioConstraint")
	aspect.AspectRatio = 1.7
	aspect.Parent = card
	Responsive.bind(card, "Size", function(R)
		if R.Device == "Phone" then
			return UDim2.fromScale(R.Portrait and 0.94 or 0.56, R.Portrait and 0.36 or 0.62)
		elseif R.Device == "Tablet" then
			return UDim2.fromScale(0.52, 0.36)
		end
		return UDim2.fromScale(0.36, 0.34)
	end)
	local pad = Kit.frame({ Name = "Pad", Size = UDim2.fromScale(1, 1), Parent = card })
	Kit.scalePadding(pad, 0.07, 0.06, 0.07, 0.06)
	-- top row: rarity + badges
	local top = Kit.frame({ Name = "Top", Size = UDim2.fromScale(1, 0.13), Parent = pad })
	Kit.list(top, "H", 8, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	Kit.badge({ Text = string.upper(record.Rarity), Color = rarity.Color, LayoutOrder = 1, Parent = top })
	if record.Mutation and record.Mutation ~= "None" then
		local m = MutationConfig.Mutations[record.Mutation]
		Kit.badge({ Text = string.upper(m and m.Name or record.Mutation), Color = m and m.Color or C.Gold, LayoutOrder = 2, Parent = top })
	end
	if isNew then
		Kit.badge({ Text = "NEW!", Color = C.Accent, LayoutOrder = 3, Parent = top })
	end
	local name = Kit.text({
		Name = "Name",
		Text = string.upper(record.Name),
		Role = "Display",
		Scaled = true,
		XAlign = Enum.TextXAlignment.Center,
		Position = UDim2.fromScale(0, 0.14),
		Size = UDim2.fromScale(1, 0.22),
		Parent = pad,
	})
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(rarity.Glow, rarity.Color)
	grad.Parent = name
	-- RNG title: "1 in 12,500,000"
	local odds = Odds.ofRecord(record)
	local exclusive = Odds.isExclusive(record.SpeciesId)
	local title = Kit.text({
		Name = "OddsTitle",
		Text = Odds.format(odds, exclusive),
		Role = "Title",
		Scaled = true,
		Color = exclusive and rarity.Glow or Odds.color(odds),
		XAlign = Enum.TextXAlignment.Center,
		Position = UDim2.fromScale(0, 0.37),
		Size = UDim2.fromScale(1, 0.12),
		Parent = pad,
	})
	title.TextStrokeTransparency = 0.4
	-- stats
	local stats = Kit.frame({ Name = "Stats", Position = UDim2.fromScale(0.08, 0.5), Size = UDim2.fromScale(0.84, 0.28), Parent = pad })
	Kit.list(stats, "V", 2, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Top)
	Kit.statRow({ Icon = "Speed", Label = "Run speed", Value = Format.abbreviate(record.Speed), Size = UDim2.fromScale(1, 0.32), LayoutOrder = 1, Parent = stats })
	Kit.statRow({ Icon = "Wing", Label = "Flight speed", Value = Format.abbreviate(record.FlightSpeed), Size = UDim2.fromScale(1, 0.32), LayoutOrder = 2, Parent = stats })
	Kit.statRow({ Icon = "Income", Label = "Income", Value = Format.perSecond(record.IncomePerSecond), ValueColor = C.GoldBright, Size = UDim2.fromScale(1, 0.32), LayoutOrder = 3, Parent = stats })
	-- buttons
	local row = Kit.frame({ Name = "Buttons", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 1), Size = UDim2.fromScale(1, 0.18), Parent = pad })
	Kit.list(row, "H", 12, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local equip = Kit.button({ Name = "Equip", Text = "RIDE IT", Icon = "Dragon", Style = "Secondary", Size = UDim2.fromScale(0.42, 1), LayoutOrder = 1, Parent = row })
	local cont = Kit.button({ Name = "Continue", Text = "AWESOME!", Style = "Primary", Size = UDim2.fromScale(0.42, 1), LayoutOrder = 2, Parent = row })
	equip.Activated:Connect(onEquip)
	cont.Activated:Connect(onContinue)
	-- entrance: slide up + fade
	local scale = Instance.new("UIScale")
	scale.Scale = 0.85
	scale.Parent = card
	TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	return root, equip, cont
end

-- ============================================================== RNG roll
-- Center-screen "roll": names and odds flash by, slow down and land on the
-- real result right when the egg bursts.
local function rollStrip(layer: Instance, eggType: string, record)
	local egg = EggConfig.Eggs[eggType] or EggConfig.Eggs.HavenEgg
	local pool, total = {}, 0
	for _, e in egg.Hatch do
		table.insert(pool, e)
		total += e.Weight
	end
	local rng = Random.new()
	local root = Kit.frame({
		Name = "HatchRoll",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.2),
		Size = UDim2.fromScale(0.62, 0.2),
		Parent = layer,
	})
	local header = Kit.text({ Name = "Header", Text = "ROLLING...", Role = "Label", Scaled = true, Color = C.TextMuted, XAlign = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 0.16), Parent = root })
	local tag = Kit.text({ Name = "Tag", Text = "", Role = "Label", Scaled = true, XAlign = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0, 0.16), Size = UDim2.fromScale(1, 0.14), Parent = root })
	local name = Kit.text({ Name = "Name", Text = "", Role = "Display", Scaled = true, XAlign = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0, 0.3), Size = UDim2.fromScale(1, 0.38), Parent = root })
	local title = Kit.text({ Name = "Title", Text = "", Role = "Title", Scaled = true, XAlign = Enum.TextXAlignment.Center, Position = UDim2.fromScale(0, 0.7), Size = UDim2.fromScale(1, 0.3), Parent = root })
	for _, t in { name, title, tag } do
		t.TextStrokeTransparency = 0.25
	end
	local scale = Instance.new("UIScale")
	scale.Parent = root
	local function show(speciesId: string, mutation: string, odds: number)
		local sp = DragonConfig.Species[speciesId]
		local rar = sp and DragonConfig.Rarities[sp.Rarity] or DragonConfig.Rarities.Common
		name.Text = string.upper(sp and sp.Name or speciesId)
		name.TextColor3 = rar.Glow
		title.Text = Odds.format(odds)
		title.TextColor3 = Odds.color(odds)
		local m = MutationConfig.Mutations[mutation]
		tag.Text = (m and mutation ~= "None") and string.upper(m.Name) or ""
		tag.TextColor3 = m and m.Color or C.Text
	end
	local function randomCandidate()
		local r = rng:NextNumber() * total
		local pick = pool[#pool]
		-- flatten the odds so rare names flash by too (that's the fun)
		if rng:NextNumber() < 0.45 then
			pick = pool[rng:NextInteger(1, #pool)]
		else
			for _, e in pool do
				r -= e.Weight
				if r <= 0 then
					pick = e
					break
				end
			end
		end
		local mutation = "None"
		if rng:NextNumber() < 0.22 then
			local order = MutationConfig.Order
			mutation = order[rng:NextInteger(2, math.min(#order - 1, 12))]
		end
		return pick.Id, mutation
	end
	local self = {}
	local nextAt, lastId = 0, nil
	function self.Step(a: number, t: number, audio)
		if t < nextAt then
			return
		end
		local interval = 0.045 + 0.3 * a * a
		nextAt = t + interval
		local id, mutation = randomCandidate()
		if id == lastId and #pool > 1 then
			id, mutation = randomCandidate()
		end
		lastId = id
		show(id, mutation, Odds.fromEgg(eggType, id, mutation))
		scale.Scale = 1.06
		if audio then
			audio.playUI("Click")
		end
	end
	function self.Land()
		local odds = Odds.ofRecord(record)
		show(record.SpeciesId, record.Mutation or "None", odds)
		header.Text = "YOU ROLLED"
		header.TextColor3 = Odds.color(odds)
		scale.Scale = 1.35
		TweenService:Create(scale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
	function self.Settle(dt: number)
		scale.Scale += (1 - scale.Scale) * math.min(1, dt * 14)
	end
	function self.Fade(duration: number)
		for _, t in { header, tag, name, title } do
			TweenService:Create(t, TweenInfo.new(duration), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		end
		task.delay(duration + 0.05, function()
			root:Destroy()
		end)
	end
	function self.Destroy()
		root:Destroy()
	end
	return self
end

-- ============================================================== cinematic
local function play(slot: number, result)
	local camera = Workspace.CurrentCamera
	local cam = registry.CameraController
	local uic = registry.UIController
	local sanct = registry.SanctuaryController
	local audio = registry.AudioController
	local record = result.Dragon
	local eggType = result.Egg
	local slotCF = sanct and sanct.slotCFrame(slot)
	local nestCF = sanct and sanct.nestCFrame()
	if not slotCF or not nestCF then
		uic.Notify("success", "Hatched " .. record.Name .. "!")
		return
	end
	local cfg = HatchConfig.Cinematic
	local rarity = DragonConfig.Rarities[record.Rarity] or DragonConfig.Rarities.Common
	local resultOdds = Odds.ofRecord(record)
	local rare = resultOdds >= HatchConfig.RareOdds or DragonConfig.rarityRank(record.Rarity) >= HatchConfig.RareRank
	local ultra = resultOdds >= HatchConfig.Announce.MinOdds
	local mutated = record.Mutation ~= nil and record.Mutation ~= "None"
	local mutation = mutated and MutationConfig.Mutations[record.Mutation] or nil
	local accent = mutation and mutation.Color or rarity.Color
	local def = EggConfig.Eggs[eggType] or EggConfig.Eggs.HavenEgg
	local rng = Random.new()
	local state = { Skip = false }

	local modal = uic.Layers.GameModal and uic.Layers.GameModal.Root or uic.Layers.GameUI.Root
	local stage = Instance.new("Folder")
	stage.Name = "HatchStage"
	stage.Parent = Workspace
	HatchController.Stage = stage
	local fx = newFx(modal)
	local skip = skipButton(modal, state)
	local roll = nil
	local card = nil
	local conn = nil
	local fov0 = camera.FieldOfView
	local showCompanion = hideCompanion()
	local function cleanup()
		if conn then
			conn:Disconnect()
			conn = nil
		end
		if card then
			card:Destroy()
			card = nil
		end
		if roll then
			roll.Destroy()
			roll = nil
		end
		skip.Instance:Destroy()
		fx.Cleanup()
		showCompanion()
		stage:Destroy()
		camera.FieldOfView = fov0
		HatchController.Phase = ""
		HatchController.Stage = nil
		HatchController.Dragon = nil
		HatchController.Framing = nil
	end
	active = { Cleanup = cleanup }

	if cam then
		cam.beginCinematic()
	end
	uic.SetHudVisible(false)
	task.delay(cfg.SkipAfter, function()
		if skip.Instance.Parent then
			skip.Instance.Visible = true
		end
	end)
	-- hide the nest egg of this slot (data sync will remove it anyway)
	local mySanct = Workspace:FindFirstChild("MySanctuary")
	local nestEgg = mySanct and mySanct:FindFirstChild("NestEgg" .. slot)
	if nestEgg then
		nestEgg:Destroy()
	end
	local egg = EggVisual.build(eggType, { Beam = false, Scale = 1.15 })
	EggVisual.place(egg, slotCF)
	egg.Parent = stage
	local eggPos = slotCF.Position
	local shell = egg.PrimaryPart
	local light = shell and shell:FindFirstChildOfClass("PointLight")

	-- ---- 1) APPROACH: darken, glide to the egg, lift it into a pool of light
	HatchController.Phase = "Approach"
	fx.Darken(true, cfg.Approach)
	local fromDir = (camera.CFrame.Position - eggPos) * Vector3.new(1, 0, 1)
	if fromDir.Magnitude < 1 then
		fromDir = -nestCF.LookVector
	end
	fromDir = fromDir.Unit
	local shot = CFrame.lookAt(eggPos + fromDir * 10.5 + Vector3.new(0, 3.8, 0), eggPos + Vector3.new(0, 1.9, 0))
	local pool = neonDisc(def.Glow, 9, eggPos - Vector3.new(0, 1.55, 0), stage, 0.55)
	local lift = 0
	local from = camera.CFrame
	run(state, cfg.Approach, function(a, t)
		camera.CFrame = from:Lerp(shot, ease(a))
		lift = 1.3 * ease(a)
		EggVisual.place(egg, slotCF * CFrame.new(0, lift, 0) * CFrame.Angles(math.sin(t * 5) * 0.03, 0, 0))
		pool.Transparency = 0.7 - 0.3 * ease(a)
	end)

	-- ---- 2) CHARGE: wobble, the roll spins, cracks open one by one
	HatchController.Phase = "Charge"
	roll = rollStrip(modal, eggType, record)
	local chargeTime = rare and cfg.ChargeRare or cfg.Charge
	local crackCount = rare and cfg.CracksRare or cfg.Cracks
	local crackAt = {}
	for i = 1, crackCount do
		crackAt[i] = 0.2 + 0.72 * (i - 1) / crackCount
	end
	local nextCrack, nextShake, flare = 1, 0, 0
	local lastT = 0
	if not state.Skip then
		run(state, chargeTime, function(a, t, dt)
			roll.Step(a, t, audio)
			roll.Settle(t - lastT)
			lastT = t
			if nextCrack <= crackCount and a >= crackAt[nextCrack] then
				addCrack(egg, def, nextCrack, rng)
				nextCrack += 1
				flare = 1
				if audio and shell then
					audio.play3D("EggCrack", shell, 0.1)
				end
				if cam then
					cam.shake(0.22 + 0.12 * a)
				end
			end
			flare = math.max(0, flare - dt * 3.5)
			local amp = 0.04 + 0.3 * a * a
			local freq = 8 + 18 * a
			EggVisual.place(egg, slotCF * CFrame.new(0, lift + math.sin(t * 3) * 0.08, 0) * CFrame.Angles(math.sin(t * freq) * amp, 0, math.cos(t * freq * 0.83) * amp))
			if light then
				light.Brightness = 1.5 + 6 * a + 5 * flare
				light.Range = 10 + 18 * a
			end
			pool.Transparency = 0.4 - 0.25 * a + 0.15 * math.sin(t * 9)
			pool.Size = Vector3.new(0.15, 9 + 5 * a, 9 + 5 * a)
			if t > nextShake then
				nextShake = t + 0.55 - 0.35 * a
				if audio and shell then
					audio.play3D("EggShake", shell, 0.1)
				end
				if cam then
					cam.shake(0.06 + 0.2 * a)
				end
			end
			camera.CFrame = shot * CFrame.new(0, 0, -1.8 * ease(a)) * CFrame.Angles(0, math.sin(t * 0.9) * 0.02, 0)
		end)
	end

	-- ---- 3) BURST: the roll lands, flash, shards, shock ring, pillar of light
	HatchController.Phase = "Burst"
	local quick = state.Skip
	local burstAt = eggPos + Vector3.new(0, lift, 0)
	if quick then
		-- skipped: no show, just clear the shell away
		roll.Destroy()
		roll = nil
		egg:Destroy()
		pool:Destroy()
	else
		roll.Land()
		local rollRef = roll
		task.delay(2.4, function()
			rollRef.Fade(0.5)
		end)
		roll = nil
		local flash = neonBall(rarity.Glow, 2, CFrame.new(burstAt), stage)
		shards(def.Shell, burstAt, stage)
		egg:Destroy()
		pool:Destroy()
		fx.Pulse(ultra and 1 or (rare and 0.85 or 0.6), ultra and 0.9 or 0.55)
		if audio then
			audio.play3D(DragonConfig.rarityRank(record.Rarity) >= 4 and "RareHatch" or "Hatch", flash, 0)
		end
		local ring = neonDisc(accent, 4, eggPos - Vector3.new(0, 1.2, 0), stage, 0.1)
		local pillar = Instance.new("Part")
		pillar.Anchored = true
		pillar.CanCollide = false
		pillar.CanQuery = false
		pillar.CanTouch = false
		pillar.CastShadow = false
		pillar.Shape = Enum.PartType.Cylinder
		pillar.Material = Enum.Material.Neon
		pillar.Color = accent
		pillar.Size = Vector3.new(220, 6, 6) -- cylinder axis is X (rotated upright below)
		pillar.CFrame = CFrame.new(eggPos + Vector3.new(0, 110, 0)) * CFrame.Angles(0, 0, math.rad(90))
		pillar.Transparency = 0.35
		pillar.Parent = stage
		local burstLight = Instance.new("PointLight")
		burstLight.Color = rarity.Glow
		burstLight.Range = 42
		burstLight.Brightness = 8
		burstLight.Parent = flash
		TweenService:Create(flash, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(26, 26, 26), Transparency = 1 }):Play()
		TweenService:Create(ring, TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.15, 80, 80), Transparency = 1 }):Play()
		TweenService:Create(pillar, TweenInfo.new(1.4, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Size = Vector3.new(220, 0.5, 0.5), Transparency = 1 }):Play()
		TweenService:Create(burstLight, TweenInfo.new(1.4), { Brightness = 0 }):Play()
		confetti(stage, burstAt, { rarity.Glow, accent, Color3.new(1, 1, 1) }, ultra and 120 or (rare and 70 or 36))
		if cam then
			cam.shake(0.9)
		end
	end

	-- ---- 4) WALK: the dragon steps out of the light and walks to the camera
	local sp = Species.get(record.SpeciesId)
	local S = sp.Scale or 1
	local hip = sp.HipHeight * S
	local center = nestCF.Position
	local floorY = center.Y - 2.6
	local focusBase = Vector3.new(center.X, floorY + hip * 0.9, center.Z)
	-- the dragon is built first so its real nose position decides the framing
	local startPos = Vector3.new(center.X, floorY + hip, center.Z)
	local dragon = spawnDragon(record, CFrame.lookAt(startPos, startPos + fromDir), stage)
	HatchController.Dragon = dragon
	-- framing: the camera waits `dist` away from the nest (it pulls back while the flash
	-- hides it) and the dragon walks towards it, stopping with its HEAD still well in front
	-- of the lens (headReach = root to nose, measured on the built model)
	local headReach = ((sp.Body and sp.Body.Length or 7) * 0.5 + (sp.Neck and sp.Neck.Length or 5) + 3) * S
	local mouth = dragon and dragon.Visual:FindFirstChild("Mouth", true)
	if mouth and dragon then
		local rel = dragon.Root.CFrame:PointToObjectSpace((mouth :: any).WorldPosition)
		headReach = math.max(headReach * 0.6, -rel.Z * 1.15 + 2) -- (a roaring head reaches further)
	end
	-- how far the lens must be for the dragon to fill about 70% of the screen width (wings open
	-- for the roar, so a fifth more than the idle pose): works for every species and aspect ratio
	local viewport = camera.ViewportSize
	local aspect = math.clamp(viewport.X / math.max(1, viewport.Y), 0.4, 2.4)
	local frameW = 20
	if dragon then
		animate(dragon, 0.03) -- idle pose first
		local ext = dragon.Visual:GetExtentsSize()
		frameW = math.max(ext.X * 1.2, ext.Y * 1.4)
	end
	local fillDist = frameW / (0.7 * 2 * math.tan(math.rad(fov0 / 2)) * aspect)
	local margin = math.clamp(fillDist, 9, 70) -- nose to lens
	local walkDist = math.clamp(headReach + 4, 8, 22)
	local finalDist = headReach + margin
	local dist = math.max(26, finalDist + walkDist)
	local ignore = {}
	for _, inst in { stage, LocalPlayer.Character, Workspace:FindFirstChild("Dragons"), Workspace:FindFirstChild("MySanctuary"), Workspace:FindFirstChild("MyEggs"), Workspace:FindFirstChild("HeldEggs") } do
		table.insert(ignore, inst)
	end
	local faceDir, clear = clearSpot(focusBase, fromDir, dist, ignore)
	if clear < 1 then
		-- cramped plot: everything shrinks towards the nest, the head keeps its margin
		local k = math.max(0.55, clear * 0.92)
		dist = math.max(16, dist * k)
		finalDist = math.max(headReach + 6, finalDist * k)
		walkDist = math.max(6, dist - finalDist)
	end
	HatchController.Framing = { Dir = faceDir, Dist = dist, Clear = clear, Final = finalDist, HeadReach = headReach }
	if dragon then
		dragon.Root.CFrame = CFrame.lookAt(startPos, startPos + faceDir)
	end
	-- walking pace matches the gait cycle (stride length grows with the dragon)
	local walkTime = math.clamp(walkDist / math.clamp(10 * S, 8, 22), 1.8, cfg.Walk + 0.8)
	local walkSpeed = walkDist / walkTime
	local orbitStart = math.atan2(faceDir.X, faceDir.Z)
	local function orbitCF(angle: number, d: number, focus: Vector3): CFrame
		local dir = Vector3.new(math.sin(angle), 0, math.cos(angle))
		return CFrame.lookAt(focus + dir * d + Vector3.new(0, d * 0.3, 0), focus)
	end
	local walkShot = orbitCF(orbitStart, dist, focusBase)
	camera.CFrame = walkShot
	camera.FieldOfView = fov0
	local footSize = math.clamp(S * 0.4, 0.3, 1)
	if dragon then
		setReveal(dragon, 0)
		dragon.Anim.OnFootstep = function()
			if cam then
				cam.shake(0.05 + 0.1 * footSize)
			end
			if audio then
				audio.play3D("Footstep", dragon.Root, 0.12, 0.5 + 0.5 * footSize)
			end
		end
	end
	HatchController.Phase = "Walk"
	local position = startPos
	local walkDone = run(state, walkTime, function(a, t, dt)
		if dragon then
			position = startPos + faceDir * (walkDist * a)
			dragon.Root.CFrame = CFrame.lookAt(position, position + faceDir)
			dragon.Anim:SetParams({ Mode = "Ground", Speed = a < 0.88 and walkSpeed or walkSpeed * (1 - a) * 8, Look = Vector2.zero })
			setReveal(dragon, math.clamp(a * 4, 0, 1))
			animate(dragon, dt)
		end
		-- the camera holds the shot (a hair of drift), tracking the dragon's head height
		camera.CFrame = walkShot * CFrame.Angles(0, math.sin(t * 0.6) * 0.012, 0)
	end)

	-- ---- 5) ROAR: stop, rear up, shake the world
	HatchController.Phase = "Roar"
	local roarPos = startPos + faceDir * walkDist
	-- the camera looks at the roaring head, not at the hips
	local roarFocus = Vector3.new(roarPos.X, focusBase.Y, roarPos.Z) + faceDir * (headReach * 0.5) + Vector3.new(0, hip * 0.4, 0)
	if dragon then
		dragon.Root.CFrame = CFrame.lookAt(roarPos, roarPos + faceDir)
		setReveal(dragon, 1)
		dragon.Anim:SetParams({ Mode = "Ground", Speed = 0 })
		dragon.Anim:Play("Roar")
	end
	if walkDone then
		local roared = false
		local camBase = walkShot.Position
		run(state, cfg.Roar, function(a, _t, dt)
			animate(dragon, dt)
			if not roared and a >= 0.32 then
				roared = true
				if cam then
					cam.shake(0.85)
				end
				fx.Pulse(mutated and 0.55 or 0.3, 0.5)
				if audio and dragon then
					audio.play3D("Roar", dragon.Root, 0.04)
				end
				local wave = neonDisc(accent, 6, Vector3.new(roarPos.X, floorY + 0.3, roarPos.Z), stage, 0.25)
				TweenService:Create(wave, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(0.15, 120, 120), Transparency = 1 }):Play()
				confetti(stage, roarPos + Vector3.new(0, hip * 1.4, 0), mutated and { accent, Color3.new(1, 1, 1), rarity.Glow } or { rarity.Glow, Color3.new(1, 1, 1) }, mutated and 90 or 40)
			end
			-- slow push-in towards the roaring head, field of view tightens
			camera.FieldOfView = fov0 - 12 * ease(a)
			camera.CFrame = CFrame.lookAt(camBase:Lerp(roarFocus, 0.12 * ease(a)), roarFocus)
		end)
	end
	camera.FieldOfView = fov0
	skip.Instance.Visible = false

	-- ---- 6) CARD: the dragon idles, the camera orbits slowly, the card shows the result
	HatchController.Phase = "Card"
	fx.Darken(false, 0.8)
	if dragon then
		dragon.Root.CFrame = CFrame.lookAt(roarPos, roarPos + faceDir)
		setReveal(dragon, 1)
		dragon.Anim:SetParams({ Mode = "Ground", Speed = 0 })
	end
	local cardDist = (walkShot.Position - roarFocus).Magnitude * 0.95
	local swayT = 0
	tweenCamera({ Skip = false }, camera, orbitCF(orbitStart, cardDist, roarFocus), 0.9)
	local done = false
	local equipped = false
	conn = RunService.RenderStepped:Connect(function(dt)
		-- a slow sway around the clear line of sight (never swings into the walls)
		swayT += dt
		camera.CFrame = orbitCF(orbitStart + SWAY * math.sin(swayT * 0.4), cardDist, roarFocus)
		animate(dragon, dt)
	end)
	card = resultCard(record, result.New == true, function()
		if equipped then
			return
		end
		equipped = true
		task.spawn(function()
			local res = Net.request("Dragon", "Equip", { Id = record.UniqueId })
			if uic.HandleResult(res, record.Name .. " is now your dragon!") then
				done = true
			else
				equipped = false
			end
		end)
	end, function()
		done = true
	end)
	if dragon and rare and audio then
		audio.playUI("LevelUp")
	end
	while not done do
		task.wait()
	end

	-- ---- 7) back to the player
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if conn then
		conn:Disconnect()
		conn = nil
	end
	if card then
		card:Destroy()
		card = nil
	end
	if hrp then
		local back = CFrame.lookAt(hrp.Position - hrp.CFrame.LookVector * 16 + Vector3.new(0, 7, 0), hrp.Position + Vector3.new(0, 2, 0))
		tweenCamera({ Skip = false }, camera, back, 0.6)
	end
	cleanup()
	active = nil
	uic.SetHudVisible(true)
	if cam then
		cam.endCinematic()
	end
end

function HatchController.hatch(slot: number)
	if busy then
		return
	end
	busy = true
	local uic = registry.UIController
	local ok, err = pcall(function()
		local res = Net.request("Egg", "Hatch", { Slot = slot })
		if not res.ok then
			uic.HandleResult(res)
			return
		end
		play(slot, res.data)
	end)
	if not ok then
		warn("[Hatch] " .. tostring(err))
		if active then
			pcall(active.Cleanup)
			active = nil
		end
		local cam = registry.CameraController
		if cam and cam.inCinematic() then
			cam.endCinematic()
		end
		uic.SetHudVisible(true)
	end
	busy = false
end

-- UILab: show the result card with a sample dragon (no cinematic).
local previewCard: Instance? = nil
function HatchController.previewResult()
	HatchController.closePreview()
	local DragonStats = require(Shared:WaitForChild("DragonStats"))
	local record = DragonStats.newRecord("PREVIEW", "InfernoDragon", "Golden", os.time())
	previewCard = resultCard(record, true, function() end, function()
		HatchController.closePreview()
	end)
end

function HatchController.closePreview()
	if previewCard then
		previewCard:Destroy()
		previewCard = nil
	end
end

function HatchController.isBusy(): boolean
	return busy
end

function HatchController.Init(reg)
	registry = reg
end

return HatchController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000103">
					<Properties>
						<string name="Name">HeldEggController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	HeldEggController
	The egg in your hand. A picked-up egg is carried in the character's right hand
	(the arm cradles it) until you put it into a nest spot at your sanctuary - the nest
	prompts live in SanctuaryController, the server (EggService) owns the rules.

	Everybody sees it: the server replicates the hand through the player attributes
	HeldEggId / HeldEggType / HeldEggLuck and every client draws the egg itself for every
	player that holds one (client-only models, nothing is replicated). It is hidden while
	riding a dragon.

	API (local player):
	  HeldEggController.id() / .type() / .luck()   what is in hand (nil = empty)
	  HeldEggController.hold(id) / .holdBest() / .putAway()   ask the server
	  HeldEggController.handPosition(player?)      world position of the held egg
	  HeldEggController.fly(eggType, from, to, duration, onDone)   an egg flying along an arc
	  HeldEggController.flyIn(eggType, from)       a freshly picked egg flies into the hand
	  HeldEggController.burst(position, color)     small light burst
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local EggVisual = require(Shared:WaitForChild("EggVisual"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))

local HeldEggController = {}

local registry
local LocalPlayer = Players.LocalPlayer

local HELD_SCALE = 0.42 -- the egg shell is 2.4 x 3.1 studs at scale 1
local NEST_SCALE = 0.95 -- as drawn by SanctuaryController on the nest
local FLY_IN_TIME = 0.4
-- R15 arm pose that cradles the egg in front of the chest (radians): the elbow bends,
-- the upper arm swings a little forward and tucks in towards the body
local ARM_SHOULDER = math.rad(9)
local ARM_ELBOW = math.rad(102)
local ARM_ADDUCT = math.rad(-19)

local folder: Folder? = nil
local holds: { [Player]: any } = {} -- player -> { Type, Luck, Char, Model, Pose, Phase }
local flights: { any } = {}
local hiddenUntil: { [Player]: number } = {} -- hand visual waits for the fly-in to land
local clock = 0

local function getFolder(): Folder
	if not folder or not folder.Parent then
		local f = Instance.new("Folder")
		f.Name = "HeldEggs"
		f.Parent = Workspace
		folder = f
	end
	return folder :: Folder
end

-- ============================================================== what is in hand
function HeldEggController.id(player: Player?): string?
	local id = (player or LocalPlayer):GetAttribute("HeldEggId")
	return type(id) == "string" and id ~= "" and id or nil
end

function HeldEggController.type(player: Player?): string?
	local t = (player or LocalPlayer):GetAttribute("HeldEggType")
	return type(t) == "string" and EggConfig.Eggs[t] and t or nil
end

function HeldEggController.luck(player: Player?): number
	return math.max(1, tonumber((player or LocalPlayer):GetAttribute("HeldEggLuck")) or 1)
end

-- ============================================================== hand geometry
local function handOf(char: Model): (BasePart?, boolean)
	local hand = char:FindFirstChild("RightHand")
	if hand and hand:IsA("BasePart") then
		return hand, true
	end
	local arm = char:FindFirstChild("Right Arm") -- R6
	if arm and arm:IsA("BasePart") then
		return arm, false
	end
	return nil, false
end

-- Pivot of the egg held by `char`: just beyond the hand, standing upright, facing like the character.
local function holdCFrame(char: Model, t: number): CFrame?
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hand, r15 = handOf(char)
	local base: CFrame
	if hand then
		base = hand.CFrame * (r15 and CFrame.new(0, -0.42, 0) or CFrame.new(0, -1.3, -0.4))
	else
		local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or hrp
		if not (torso and torso:IsA("BasePart")) then
			return nil
		end
		base = torso.CFrame * CFrame.new(0.9, 0.2, -1.2)
	end
	local facing = hrp and hrp:IsA("BasePart") and hrp.CFrame.Rotation or CFrame.identity
	-- a gentle wobble, as if the egg were warm and alive
	local wobble = CFrame.Angles(math.sin(t * 2.3) * 0.05, math.sin(t * 0.7) * 0.2, math.cos(t * 1.9) * 0.05)
	return CFrame.new(base.Position + Vector3.new(0, 0.25, 0)) * facing * wobble
end

-- R15 right arm: raise it forward and bend the elbow so the hand holds the egg in front of the chest.
local function applyPose(st)
	local char = st.Char
	local upper = char:FindFirstChild("RightUpperArm")
	local lower = char:FindFirstChild("RightLowerArm")
	local shoulder = upper and upper:FindFirstChild("RightShoulder")
	local elbow = lower and lower:FindFirstChild("RightElbow")
	if shoulder and shoulder:IsA("Motor6D") and elbow and elbow:IsA("Motor6D") then
		st.Pose = { Shoulder = shoulder, ShoulderC0 = shoulder.C0, Elbow = elbow, ElbowC0 = elbow.C0 }
		shoulder.C0 = shoulder.C0 * CFrame.Angles(ARM_SHOULDER, 0, ARM_ADDUCT)
		elbow.C0 = elbow.C0 * CFrame.Angles(ARM_ELBOW, 0, 0)
	end
end

local function removePose(st)
	local pose = st.Pose
	st.Pose = nil
	if pose then
		if pose.Shoulder.Parent then
			pose.Shoulder.C0 = pose.ShoulderC0
		end
		if pose.Elbow.Parent then
			pose.Elbow.C0 = pose.ElbowC0
		end
	end
end

-- ============================================================== visuals
local function dispose(player: Player)
	local st = holds[player]
	if not st then
		return
	end
	holds[player] = nil
	removePose(st)
	if st.Model then
		st.Model:Destroy()
	end
end

local function build(player: Player, eggType: string, luck: number, char: Model)
	local model = EggVisual.build(eggType, { Beam = false, Scale = HELD_SCALE, Sparkles = luck >= 10 })
	model.Name = "HeldEgg_" .. player.UserId
	local shell = model.PrimaryPart
	local light = shell and shell:FindFirstChildWhichIsA("PointLight")
	if light then
		light.Range = 7
		light.Brightness = 0.7
	end
	local st = { Type = eggType, Luck = luck, Char = char, Model = model, Phase = math.random() * 6.28, Attached = false }
	holds[player] = st
	applyPose(st)
	return st
end

-- Brings the visual in line with the attributes / character / riding state of `player`.
local function refresh(player: Player)
	local eggType = HeldEggController.type(player)
	local char = player.Character
	local want = eggType ~= nil
		and char ~= nil
		and char.Parent ~= nil
		and player:GetAttribute("Riding") ~= true
		and (hiddenUntil[player] or 0) <= clock
	local st = holds[player]
	if st and (not want or st.Type ~= eggType or st.Char ~= char or (st.Attached and not st.Model.Parent)) then
		dispose(player)
		st = nil
	end
	if want and not st then
		build(player, eggType :: string, HeldEggController.luck(player), char :: Model)
	end
end

local function track(player: Player)
	local function update()
		refresh(player)
	end
	player:GetAttributeChangedSignal("HeldEggType"):Connect(update)
	player:GetAttributeChangedSignal("HeldEggLuck"):Connect(update)
	player:GetAttributeChangedSignal("Riding"):Connect(update)
	player.CharacterAdded:Connect(function()
		task.defer(update)
	end)
	player.CharacterRemoving:Connect(function()
		dispose(player)
	end)
	update()
end

-- ============================================================== effects
function HeldEggController.burst(position: Vector3, color: Color3)
	local burst = Instance.new("Part")
	burst.Anchored = true
	burst.CanCollide = false
	burst.CanQuery = false
	burst.CanTouch = false
	burst.Shape = Enum.PartType.Ball
	burst.Material = Enum.Material.Neon
	burst.Color = color
	burst.Size = Vector3.new(1.5, 1.5, 1.5)
	burst.CFrame = CFrame.new(position)
	burst.Transparency = 0.25
	burst.CastShadow = false
	burst.Parent = getFolder()
	TweenService:Create(burst, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(8, 8, 8),
		Transparency = 1,
	}):Play()
	task.delay(0.45, function()
		burst:Destroy()
	end)
end

-- An egg flying from `from` to `to` (a Vector3, or a function returning one) along a
-- high arc, growing from the hand size to the nest size. onDone runs when it lands.
function HeldEggController.fly(eggType: string, from: Vector3, to: any, duration: number, onDone: (() -> ())?, fromScale: number?, toScale: number?)
	local startScale = fromScale or HELD_SCALE
	local endScale = toScale or NEST_SCALE
	local model = EggVisual.build(eggType, { Beam = false, Scale = 1 })
	model:ScaleTo(startScale)
	model.Name = "FlyingEgg"
	model.Parent = getFolder()
	table.insert(flights, {
		Model = model,
		Type = eggType,
		From = from,
		To = to,
		Age = 0,
		Duration = math.max(0.1, duration),
		OnDone = onDone,
		StartScale = startScale,
		EndScale = endScale,
		Spin = (math.random() - 0.5) * 6,
	})
end

-- A freshly picked-up egg jumps from where it lay into the hand; the held visual
-- (already replicated) waits until it has landed.
function HeldEggController.flyIn(eggType: string, from: Vector3)
	hiddenUntil[LocalPlayer] = clock + FLY_IN_TIME
	refresh(LocalPlayer)
	HeldEggController.fly(eggType, from, function()
		return HeldEggController.handPosition(LocalPlayer) or from
	end, FLY_IN_TIME, function()
		hiddenUntil[LocalPlayer] = nil
		refresh(LocalPlayer)
	end, 1, HELD_SCALE)
end

-- World position of the egg in `player`'s hand (nil when the character has no hand yet).
function HeldEggController.handPosition(player: Player?): Vector3?
	local p = player or LocalPlayer
	local char = p.Character
	local cf = char and holdCFrame(char, clock)
	return cf and cf.Position or nil
end

local function stepFlights(dt: number)
	for i = #flights, 1, -1 do
		local f = flights[i]
		f.Age += dt
		local t = math.clamp(f.Age / f.Duration, 0, 1)
		local ease = t * t * (3 - 2 * t)
		local target = type(f.To) == "function" and f.To() or f.To
		local height = math.clamp((target - f.From).Magnitude * 0.3, 1.5, 9)
		local pos = f.From:Lerp(target, ease) + Vector3.new(0, math.sin(t * math.pi) * height, 0)
		if f.Model.Parent then
			f.Model:ScaleTo(f.StartScale + (f.EndScale - f.StartScale) * ease)
			EggVisual.place(f.Model, CFrame.new(pos) * CFrame.Angles(0, f.Spin * f.Age, math.sin(t * math.pi) * 0.4))
		end
		if t >= 1 then
			table.remove(flights, i)
			f.Model:Destroy()
			if f.OnDone then
				task.spawn(f.OnDone)
			end
		end
	end
end

local function step(dt: number)
	clock += dt
	stepFlights(dt)
	for player, st in holds do
		local char = st.Char
		local model = st.Model
		if char.Parent then
			local cf = holdCFrame(char, clock + st.Phase)
			if cf then
				EggVisual.place(model, cf)
				if not st.Attached then
					st.Attached = true
					model.Parent = getFolder()
				end
			end
		else
			task.defer(refresh, player)
		end
	end
	-- a pickup that never landed must not leave the hand empty
	for player, releaseAt in hiddenUntil do
		if releaseAt <= clock then
			hiddenUntil[player] = nil
			refresh(player)
		end
	end
end

-- ============================================================== requests (local player)
local function ask(payload, okText: string?)
	task.spawn(function()
		local res = Net.request("Egg", "Hold", payload)
		local uic = registry and registry.UIController
		if not res.ok and uic then
			uic.HandleResult(res)
		elseif res.ok and okText and uic then
			uic.Notify("info", okText)
		end
	end)
end

function HeldEggController.hold(id: string)
	if HeldEggController.id() == id then
		return
	end
	ask({ Id = id })
end

function HeldEggController.holdBest()
	ask({ Best = true })
end

function HeldEggController.putAway()
	if HeldEggController.id() then
		ask({}, "Egg back in your bag.")
	end
end

-- ============================================================== hud
function HeldEggController.updateHud()
	local hud = registry and registry.Hud
	if not hud or not hud.SetHeldEgg then
		return
	end
	local eggType = HeldEggController.type()
	if not eggType then
		hud:SetHeldEgg(nil)
		return
	end
	local def = EggConfig.Eggs[eggType] or EggConfig.Eggs.HavenEgg
	hud:SetHeldEgg({
		Id = HeldEggController.id(),
		Type = eggType,
		Name = def.Name,
		Luck = HeldEggController.luck(),
		Glow = def.Glow,
	})
end

function HeldEggController.Init(reg)
	registry = reg
end

function HeldEggController.Start()
	for _, player in Players:GetPlayers() do
		track(player)
	end
	Players.PlayerAdded:Connect(track)
	Players.PlayerRemoving:Connect(function(player)
		dispose(player)
		hiddenUntil[player] = nil
	end)
	RunService.Heartbeat:Connect(step)
	for _, attr in { "HeldEggId", "HeldEggType", "HeldEggLuck" } do
		LocalPlayer:GetAttributeChangedSignal(attr):Connect(HeldEggController.updateHud)
	end
	HeldEggController.updateHud()
end

return HeldEggController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000104">
					<Properties>
						<string name="Name">InputController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	InputController
	One place for gameplay input across keyboard/mouse, gamepad and touch.

	Movement uses the PlayerModule's move vector (WASD / left stick / touch
	thumbstick) so every platform behaves the same. Riding actions are bound
	with ContextActionService at high priority while mounted, so Space never
	makes the humanoid jump out of the saddle.

	  InputController.getMoveVector() -> Vector3 (x = right, z = back; local)
	  InputController.isDown(action)  -> boolean   (held)
	  InputController.consume(action) -> boolean   (edge, cleared on read)
	  InputController.setVirtual(action, down)     (mobile buttons)
	  InputController.Pressed: Signal(action)

	Actions: Jump, Descend, Sprint, Roar, Ride, FreeCursor, MouseLock, Dash, Fire, Flourish
	Desktop: Space jump/takeoff/ascend, Ctrl or C descend/land, Shift sprint/
	         boost, R ride, F roar, V mouse steering on/off, hold Alt to free
	         the cursor while riding.
	Dragon Bond: Q dash (B), hold E fire breath (LB), Z sky dance (RB).
	Gamepad: A jump/ascend, LT descend, RT boost, Y ride, X roar.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Signal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"):WaitForChild("Signal"))

local InputController = {}
InputController.Pressed = Signal.new()
InputController.Riding = false
InputController.LastDevice = "KeyboardMouse" -- KeyboardMouse | Gamepad | Touch
InputController.DeviceChanged = Signal.new()

local PRIORITY = 3500

local BINDINGS = {
	Jump = { Enum.KeyCode.Space, Enum.KeyCode.ButtonA },
	Descend = { Enum.KeyCode.LeftControl, Enum.KeyCode.RightControl, Enum.KeyCode.C, Enum.KeyCode.ButtonL2 },
	Sprint = { Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift, Enum.KeyCode.ButtonR2, Enum.KeyCode.ButtonL3 },
	Roar = { Enum.KeyCode.F, Enum.KeyCode.ButtonX },
	-- Dragon Bond abilities (unlocked by bond level, see BondConfig)
	Dash = { Enum.KeyCode.Q, Enum.KeyCode.ButtonB },
	Fire = { Enum.KeyCode.E, Enum.KeyCode.ButtonL1 },
	Flourish = { Enum.KeyCode.Z, Enum.KeyCode.ButtonR1 },
	FreeCursor = { Enum.KeyCode.LeftAlt, Enum.KeyCode.RightAlt },
	MouseLock = { Enum.KeyCode.V },
}
-- always bound (mount from foot too)
local GLOBAL = {
	Ride = { Enum.KeyCode.R, Enum.KeyCode.ButtonY },
}

local held: { [string]: boolean } = {}
local virtual: { [string]: boolean } = {}
local edges: { [string]: boolean } = {}
local controls = nil

local function setHeld(action: string, down: boolean)
	local was = held[action] or virtual[action]
	held[action] = down
	if down and not was then
		edges[action] = true
		InputController.Pressed:Fire(action)
	end
end

local function handler(actionName: string, state: Enum.UserInputState, _input: InputObject)
	local action = string.sub(actionName, 5) -- strip "RAD_"
	if state == Enum.UserInputState.Begin then
		setHeld(action, true)
	elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
		held[action] = false
	end
	return Enum.ContextActionResult.Sink
end

local function textFocused(): boolean
	return UserInputService:GetFocusedTextBox() ~= nil
end

function InputController.setRiding(on: boolean)
	if InputController.Riding == on then
		return
	end
	InputController.Riding = on
	for action, keys in BINDINGS do
		local name = "RAD_" .. action
		if on then
			ContextActionService:BindActionAtPriority(name, handler, false, PRIORITY, table.unpack(keys))
		else
			ContextActionService:UnbindAction(name)
			held[action] = false
		end
	end
	if not on then
		table.clear(edges)
	end
end

function InputController.isDown(action: string): boolean
	if textFocused() then
		return false
	end
	return held[action] == true or virtual[action] == true
end

function InputController.consume(action: string): boolean
	local e = edges[action] == true
	edges[action] = nil
	return e
end

function InputController.setVirtual(action: string, down: boolean)
	local was = held[action] or virtual[action]
	virtual[action] = down
	if down and not was then
		edges[action] = true
		InputController.Pressed:Fire(action)
	end
end

local KEY_FALLBACK = {
	{ Enum.KeyCode.W, Vector3.new(0, 0, -1) },
	{ Enum.KeyCode.Up, Vector3.new(0, 0, -1) },
	{ Enum.KeyCode.S, Vector3.new(0, 0, 1) },
	{ Enum.KeyCode.Down, Vector3.new(0, 0, 1) },
	{ Enum.KeyCode.A, Vector3.new(-1, 0, 0) },
	{ Enum.KeyCode.D, Vector3.new(1, 0, 0) },
}

-- Local move vector: x = right, z = back (-1 = forward). Magnitude <= 1.
function InputController.getMoveVector(): Vector3
	if textFocused() then
		return Vector3.zero
	end
	if controls then
		local ok, v = pcall(function()
			return controls:GetMoveVector()
		end)
		if ok and typeof(v) == "Vector3" then
			if v.Magnitude > 1 then
				v = v.Unit
			end
			return v
		end
	end
	local v = Vector3.zero
	for _, entry in KEY_FALLBACK do
		if UserInputService:IsKeyDown(entry[1]) then
			v += entry[2]
		end
	end
	local pads = UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
	for _, st in pads do
		if st.KeyCode == Enum.KeyCode.Thumbstick1 and st.Position.Magnitude > 0.15 then
			v += Vector3.new(st.Position.X, 0, -st.Position.Y)
		end
	end
	if v.Magnitude > 1 then
		v = v.Unit
	end
	return v
end

local function classify(t: Enum.UserInputType): string?
	if t == Enum.UserInputType.Touch then
		return "Touch"
	elseif t.Name:find("Gamepad") then
		return "Gamepad"
	elseif t == Enum.UserInputType.Keyboard or t.Name:find("Mouse") then
		return "KeyboardMouse"
	end
	return nil
end

function InputController.Init()
	for action, keys in GLOBAL do
		ContextActionService:BindActionAtPriority("RAD_" .. action, function(_, state)
			if textFocused() then
				return Enum.ContextActionResult.Pass
			end
			if state == Enum.UserInputState.Begin then
				setHeld(action, true)
			elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
				held[action] = false
			end
			return Enum.ContextActionResult.Pass
		end, false, PRIORITY - 1, table.unpack(keys))
	end
	UserInputService.LastInputTypeChanged:Connect(function(t)
		local d = classify(t)
		if d and d ~= InputController.LastDevice then
			InputController.LastDevice = d
			InputController.DeviceChanged:Fire(d)
		end
	end)
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		InputController.LastDevice = "Touch"
	end
end

function InputController.Start()
	local player = Players.LocalPlayer
	local ps = player:FindFirstChild("PlayerScripts") or player:WaitForChild("PlayerScripts", 5)
	local module = ps and ps:FindFirstChild("PlayerModule") or (ps and ps:WaitForChild("PlayerModule", 5))
	if module then
		local ok, pm = pcall(require, module)
		if ok and pm and pm.GetControls then
			controls = pm:GetControls()
		end
	end
end

return InputController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000105">
					<Properties>
						<string name="Name">InteractionController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	InteractionController
	World interactions through ProximityPrompts:
	  * station prompts (attributes Window, Tab, Station) open UI windows
	  * prompts are hidden while riding (the dragon keys take over)
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")

local InteractionController = {}

local registry
local LocalPlayer = Players.LocalPlayer

local COMING_SOON = {
	Shop = "The Dragon Market opens soon!",
	Index = "The Hall of Dragons is being prepared.",
	Quests = "Elder Rowan will have tasks for you soon.",
}

local function onTriggered(prompt: ProximityPrompt, player: Player)
	if player ~= LocalPlayer then
		return
	end
	local window = prompt:GetAttribute("Window")
	if type(window) ~= "string" then
		return
	end
	local uic = registry.UIController
	if not uic then
		return
	end
	if (uic.Windows and uic.Windows[window]) or (uic.WindowModules and uic.WindowModules[window]) then
		uic.Open(window, { Tab = prompt:GetAttribute("Tab"), Station = prompt:GetAttribute("Station") })
	else
		uic.Notify("info", COMING_SOON[window] or "Coming soon!")
	end
end

function InteractionController.Init(reg)
	registry = reg
end

function InteractionController.Start()
	ProximityPromptService.PromptTriggered:Connect(onTriggered)
	-- hide world prompts while riding a dragon
	local function update()
		local riding = LocalPlayer:GetAttribute("Riding") == true
		ProximityPromptService.Enabled = not riding
	end
	LocalPlayer:GetAttributeChangedSignal("Riding"):Connect(update)
	update()
end

return InteractionController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000106">
					<Properties>
						<string name="Name">PerchController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	PerchController
	Sanctuary perches for every plot, built locally from the replicated
	ReplicatedStorage.SanctuaryState (see SanctuaryService):

	  * resting display dragons on occupied perches (a client-only model with
	    an anchored Root; the AnimationController builds and animates the
	    visual with its distance LOD and the perch mood cycle), with a small
	    nameplate (name, level, mutation, income)
	  * plots far from the camera are not built at all (graphics preset aware)
	  * on the local player's own plot: perch prompts - View / Take back on an
	    occupied perch, Place on a free perch (opens the collection in place
	    mode), Unlock on the next locked perch - and soft markers for free and
	    purchasable perches.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Builder = require(Shared:WaitForChild("Dragons"):WaitForChild("Builder"))
local DragonStats = require(Shared:WaitForChild("DragonStats"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local WorldConfig = require(Configs:WaitForChild("WorldConfig"))
local GameConfig = require(Configs:WaitForChild("GameConfig"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))
local Odds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Odds"))
local EconomyConfig = require(Configs:WaitForChild("EconomyConfig"))

local PerchController = {}

local registry
local LocalPlayer = Players.LocalPlayer
local S = GameConfig.Sanctuary
local PERCHES = WorldConfig.Sanctuary.PerchCount

local stateFolder: Instance? = nil
local dragonFolder: Folder? = nil
local markerFolder: Folder? = nil
local perches: { [string]: any } = {} -- "plot:slot" -> { Model, Fields, Plate }
local plotVisible: { [number]: boolean } = {}
local myMarkers: { [number]: any } = {} -- slot -> { Instances, State }
local clock = 0
local checkTimer = 0

-- ============================================================== helpers
local function parse(value: any)
	if type(value) ~= "string" or value == "" then
		return nil
	end
	local species, mutation, level, odds, name = string.match(value, "^([^|]*)|([^|]*)|([^|]*)|([^|]*)|(.*)$")
	if not species or not DragonConfig.Species[species] then
		return nil
	end
	return {
		SpeciesId = species,
		Mutation = MutationConfig.Mutations[mutation] and mutation or "None",
		Level = math.clamp(tonumber(level) or 1, 1, DragonConfig.MaxLevel),
		Odds = tonumber(odds) or 0,
		Name = (name ~= "" and name) or DragonConfig.Species[species].Name,
	}
end

local function key(plotId: number, slot: number): string
	return plotId .. ":" .. slot
end

local function viewDistance(): number
	local gc = registry and registry.GraphicsController
	if gc and gc.Preset == "Low" then
		return S.ViewDistanceLow
	end
	return S.ViewDistance
end

local function myPlotId(): number?
	local id = LocalPlayer:GetAttribute("PlotId")
	return type(id) == "number" and id or nil
end

-- ============================================================== nameplate
local function nameplate(root: BasePart, fields, height: number)
	local rarity = DragonConfig.Rarities[DragonConfig.Species[fields.SpeciesId].Rarity] or DragonConfig.Rarities.Common
	local mutation = MutationConfig.Mutations[fields.Mutation]
	local bb = Instance.new("BillboardGui")
	bb.Name = "Nameplate"
	bb.Size = UDim2.fromScale(9, 3.2) -- studs: reads like a sign, never covers the screen
	bb.StudsOffsetWorldSpace = Vector3.new(0, height, 0)
	bb.MaxDistance = S.NameplateDistance
	bb.LightInfluence = 0
	bb.Parent = root
	local name = Instance.new("TextLabel")
	name.Name = "Name"
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromScale(1, 0.36)
	name.Font = Enum.Font.GothamBlack
	name.TextScaled = true
	name.TextColor3 = rarity.Glow
	name.TextStrokeTransparency = 0.45
	name.Text = fields.Name
	name.Parent = bb
	local info = Instance.new("TextLabel")
	info.Name = "Info"
	info.BackgroundTransparency = 1
	info.Position = UDim2.fromScale(0, 0.68)
	info.Size = UDim2.fromScale(1, 0.28)
	info.Font = Enum.Font.GothamBold
	info.TextScaled = true
	info.RichText = true
	info.TextColor3 = Color3.fromRGB(246, 238, 221)
	info.TextStrokeTransparency = 0.5
	info.Parent = bb
	local title = Instance.new("TextLabel")
	title.Name = "Title"
	title.BackgroundTransparency = 1
	title.Position = UDim2.fromScale(0, 0.37)
	title.Size = UDim2.fromScale(1, 0.3)
	title.Font = Enum.Font.GothamBlack
	title.TextScaled = true
	title.TextStrokeTransparency = 0.35
	title.Parent = bb
	local function fill(f)
		local exclusive = Odds.isExclusive(f.SpeciesId)
		local n = (f.Odds and f.Odds > 0) and f.Odds or Odds.base(f.SpeciesId, f.Mutation)
		title.Text = Odds.format(n, exclusive)
		title.TextColor3 = exclusive and DragonConfig.Rarities.Exclusive.Glow or Odds.color(n)
		local stats = DragonStats.compute(f.SpeciesId, f.Level, f.Mutation)
		local mut = (f.Mutation ~= "None" and mutation) and string.format('<font color="#%s">%s</font>  ', mutation.Color:ToHex(), string.upper(mutation.Name)) or ""
		info.Text = string.format('%sLV %d   <font color="#F2D086">%s</font>', mut, f.Level, Format.perSecond(stats.IncomePerSecond))
		name.Text = f.Name
	end
	fill(fields)
	return { Gui = bb, Fill = fill }
end

-- ============================================================== perch dragons
local function destroyPerch(k: string)
	local p = perches[k]
	if p then
		perches[k] = nil
		if p.Model then
			p.Model:Destroy()
		end
	end
end

local function buildPerch(plotId: number, slot: number, fields)
	local k = key(plotId, slot)
	destroyPerch(k)
	local cf = WorldConfig.perchWorld(plotId, slot)
	if not cf or not dragonFolder then
		return
	end
	local scale = S.PerchScale
	local info = Builder.mountInfo(fields.SpeciesId, scale)
	local model = Instance.new("Model")
	model.Name = "Perch_" .. k
	model:SetAttribute("Kind", "Perch")
	model:SetAttribute("SpeciesId", fields.SpeciesId)
	model:SetAttribute("Mutation", fields.Mutation)
	model:SetAttribute("DisplayScale", scale)
	model:SetAttribute("Mode", "Rest")
	model:SetAttribute("Anchored", true)
	model:SetAttribute("PlotId", plotId)
	model:SetAttribute("Slot", slot)
	local root = Builder.makeRoot(fields.SpeciesId, scale)
	root.Anchored = true
	root.CFrame = cf * CFrame.new(0, info.HipHeight, 0)
	root.Parent = model
	model.PrimaryPart = root
	local plate = nameplate(root, fields, info.HipHeight * 0.9 + 3.2)
	model.Parent = dragonFolder
	perches[k] = { Model = model, Fields = fields, Plate = plate, Plot = plotId, Slot = slot }
end

-- Applies one perch attribute value (only rebuilds when the look changes).
local function applyPerch(plotId: number, slot: number)
	local k = key(plotId, slot)
	if not plotVisible[plotId] or not stateFolder then
		destroyPerch(k)
		return
	end
	local state = stateFolder:FindFirstChild("Plot" .. plotId)
	local fields = state and parse(state:GetAttribute("Perch" .. slot))
	local cur = perches[k]
	if not fields then
		destroyPerch(k)
		return
	end
	if cur and cur.Fields.SpeciesId == fields.SpeciesId and cur.Fields.Mutation == fields.Mutation then
		cur.Fields = fields
		cur.Plate.Fill(fields)
		return
	end
	buildPerch(plotId, slot, fields)
end

local function refreshPlot(plotId: number)
	for slot = 1, PERCHES do
		applyPerch(plotId, slot)
	end
end

-- Builds / frees whole plots by camera distance (with hysteresis).
local function updateVisibility()
	local cam = Workspace.CurrentCamera
	if not cam then
		return
	end
	local camPos = cam.CFrame.Position
	local range = viewDistance()
	for id, plot in WorldConfig.Plots do
		local d = (Vector3.new(plot.Center.X, plot.Height, plot.Center.Z) - camPos).Magnitude
		local want
		if plotVisible[id] then
			want = d < range + 80
		else
			want = d < range
		end
		if want ~= (plotVisible[id] == true) then
			plotVisible[id] = want
			refreshPlot(id)
		end
	end
end

-- ============================================================== own plot prompts
local function data()
	local D = registry.DataController
	return D and D.all()
end

local function anchorPart(name: string, cf: CFrame, size: Vector3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = size
	p.CFrame = cf
	p.Parent = markerFolder
	return p
end

local function prompt(parent: Instance, name: string, action: string, object: string, keyCode: Enum.KeyCode, hold: number, fn: () -> ())
	local pp = Instance.new("ProximityPrompt")
	pp.Name = name
	pp.ActionText = action
	pp.ObjectText = object
	pp.KeyboardKeyCode = keyCode
	pp.HoldDuration = hold
	pp.MaxActivationDistance = S.PromptRange
	pp.RequiresLineOfSight = false
	pp.Parent = parent
	pp.Triggered:Connect(fn)
	return pp
end

local function clearMarker(slot: number)
	local m = myMarkers[slot]
	if m then
		for _, inst in m.Instances do
			inst:Destroy()
		end
	end
	myMarkers[slot] = nil
end

local function request(action: string, payload, okText: string?)
	task.spawn(function()
		local res = Net.request("Dragon", action, payload)
		local uic = registry.UIController
		if uic then
			uic.HandleResult(res, okText)
		end
	end)
end

local function buildMarker(plotId: number, slot: number, stateName: string, uid: string?)
	clearMarker(slot)
	local cf = WorldConfig.perchWorld(plotId, slot)
	if not cf or not markerFolder then
		return
	end
	local m = { State = stateName, Uid = uid, Instances = {} }
	myMarkers[slot] = m
	local anchor = anchorPart("PerchAnchor" .. slot, cf * CFrame.new(0, 2.5, 0), Vector3.new(6, 5, 6))
	table.insert(m.Instances, anchor)
	local uic = registry.UIController
	if stateName == "Occupied" then
		local d = data()
		local record = d and uid and d.Dragons[uid]
		local label = record and record.Name or "Dragon"
		prompt(anchor, "ViewPrompt", "View", label, Enum.KeyCode.E, 0, function()
			if uic then
				uic.Open("Inventory", { SelectId = uid, ShowDetails = true })
			end
		end)
		prompt(anchor, "TakeBackPrompt", "Take back", label, Enum.KeyCode.F, 0.6, function()
			request("TakeBack", { Id = uid }, "Back in your collection")
		end)
	elseif stateName == "Free" then
		local ring = Instance.new("Part")
		ring.Name = "FreePerch" .. slot
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanQuery = false
		ring.CanTouch = false
		ring.CastShadow = false
		ring.Shape = Enum.PartType.Cylinder
		ring.Material = Enum.Material.Neon
		ring.Color = Color3.fromRGB(246, 200, 120)
		ring.Transparency = 0.6
		ring.Size = Vector3.new(0.1, 9.8, 9.8)
		ring.CFrame = cf * CFrame.new(0, 0.18, 0) * CFrame.Angles(0, 0, math.rad(90))
		ring.Parent = markerFolder
		table.insert(m.Instances, ring)
		m.Ring = ring
		prompt(anchor, "PlacePrompt", "Place dragon", "Perch " .. slot, Enum.KeyCode.E, 0, function()
			if uic then
				uic.Open("Inventory", { PlaceSlot = slot })
			end
		end)
	elseif stateName == "Buy" then
		local price = EconomyConfig.NestPrices[slot] or 0
		prompt(anchor, "UnlockPrompt", "Unlock (" .. Format.cash(price) .. ")", "Perch " .. slot, Enum.KeyCode.F, 0.5, function()
			request("BuyPerch", {}, "Perch unlocked!")
		end)
		local bb = Instance.new("BillboardGui")
		bb.Name = "LockSign"
		bb.Size = UDim2.fromScale(7, 1.6)
		bb.StudsOffsetWorldSpace = Vector3.new(0, 3.5, 0)
		bb.MaxDistance = 90
		bb.LightInfluence = 0
		bb.Parent = anchor
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.fromScale(1, 1)
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.TextColor3 = Color3.fromRGB(242, 208, 134)
		t.TextStrokeTransparency = 0.45
		t.Text = "LOCKED  " .. Format.cash(price)
		t.Parent = bb
	end
end

local function refreshMine()
	local plotId = myPlotId()
	local d = data()
	if not plotId or not d or not d.Nests then
		for slot in table.clone(myMarkers) do
			clearMarker(slot)
		end
		return
	end
	local unlocked = math.min(d.Nests.Unlocked or 0, PERCHES)
	for slot = 1, PERCHES do
		local uid = d.Nests.Slots and d.Nests.Slots[tostring(slot)]
		local stateName
		if uid and d.Dragons[uid] then
			stateName = "Occupied"
		elseif slot <= unlocked then
			stateName = "Free"
		elseif slot == unlocked + 1 and EconomyConfig.NestPrices[slot] then
			stateName = "Buy"
		else
			stateName = "None"
		end
		local cur = myMarkers[slot]
		if stateName == "None" then
			clearMarker(slot)
		elseif not cur or cur.State ~= stateName or cur.Uid ~= uid then
			buildMarker(plotId, slot, stateName, uid)
		end
	end
end

-- ============================================================== frame
local function step(dt: number)
	clock += dt
	checkTimer -= dt
	if checkTimer <= 0 then
		checkTimer = 0.5
		updateVisibility()
	end
	-- free perch rings breathe softly
	for _, m in myMarkers do
		if m.Ring then
			m.Ring.Transparency = 0.62 + math.sin(clock * 2.2) * 0.12
		end
	end
end

-- ============================================================== public
function PerchController.get(plotId: number, slot: number)
	return perches[key(plotId, slot)]
end

function PerchController.count(): number
	local n = 0
	for _ in perches do
		n += 1
	end
	return n
end

function PerchController.Init(reg)
	registry = reg
end

function PerchController.Start()
	local f = Instance.new("Folder")
	f.Name = "PerchDragons"
	f.Parent = Workspace
	dragonFolder = f
	local mf = Instance.new("Folder")
	mf.Name = "MyPerches"
	mf.Parent = Workspace
	markerFolder = mf
	local anim = registry.AnimationController
	if anim and anim.watchFolder then
		anim.watchFolder(f)
	end

	stateFolder = ReplicatedStorage:WaitForChild("SanctuaryState", 60)
	if stateFolder then
		for _, state in stateFolder:GetChildren() do
			local plotId = state:GetAttribute("PlotId")
			if type(plotId) == "number" then
				state.AttributeChanged:Connect(function(attr: string)
					local slot = tonumber(string.match(attr, "^Perch(%d+)$"))
					if slot then
						applyPerch(plotId, slot)
					end
				end)
			end
		end
	end

	local D = registry.DataController
	if D then
		D.observe("Nests", refreshMine)
		D.observe("Dragons", refreshMine)
	end
	LocalPlayer:GetAttributeChangedSignal("PlotId"):Connect(refreshMine)
	RunService.Heartbeat:Connect(step)
	updateVisibility()
end

return PerchController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000107">
					<Properties>
						<string name="Name">RadarController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	RadarController
	The Egg Radar: the Forge upgrade (250 / 600 / 1200 studs / the whole map), unlimited with
	the Robux boost "Radar" for a while or the Egg Hunter pass for good.

	  * every egg of yours inside the radar range gets a marker that shows through walls and
	    mountains: its luck and how far away it is
	  * a chip under the level badge points an arrow at the best egg around (high luck, not
	    too far), with its luck, distance and what is powering the radar
	It reads the replicated data (Upgrades / Boosts / Flags) and the eggs EggController knows.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local EggReach = require(Shared:WaitForChild("EggReach"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Theme = require(UI:WaitForChild("Theme"))
local Responsive = require(UI:WaitForChild("Responsive"))
local Kit = require(UI:WaitForChild("Kit"))
local Icons = require(UI:WaitForChild("Icons"))

local C = Theme.Colors
local LocalPlayer = Players.LocalPlayer

local RadarController = {}

local registry
local chip: Frame? = nil
local parts: any = nil
local clock = 0
local acc = 0
local active = false
local preview = false
local markers: { [string]: BillboardGui } = {}

-- ============================================================== helpers
local function distText(d: number): string
	if d >= 1000 then
		return string.format("%.1fk studs", d / 1000)
	end
	return string.format("%d studs", math.floor(d))
end

-- What powers the radar right now: boost timer, pass, or the Forge upgrade's range.
local function powerText(data, now: number, range: number): string
	local left = EggReach.radarSeconds(data, now)
	if left == math.huge then
		return "EGG HUNTER"
	elseif left > 0 then
		left = math.floor(left)
		return string.format("EGG RADAR  %d:%02d", left // 60, left % 60)
	end
	return range >= 100000 and "RADAR  WHOLE MAP" or string.format("RADAR  %d studs", range)
end

-- ============================================================== chip
local function layout()
	if not chip then
		return
	end
	local R = Responsive
	local short = math.min(R.Width, R.Height)
	local phone = R.Device == "Phone"
	local margin = math.floor(short * (phone and 0.03 or 0.022) + 0.5)
	local top = R.TopInset + math.floor(short * 0.012)
	local levelH = short * (phone and 0.095 or 0.058)
	chip.AnchorPoint = Vector2.new(0, 0)
	chip.Position = UDim2.new(0, margin, 0, top + math.floor(levelH + short * 0.012))
	chip.SizeConstraint = R.Portrait and Enum.SizeConstraint.RelativeXX or Enum.SizeConstraint.RelativeYY
	chip.Size = phone and UDim2.fromScale(0.36, 0.085) or UDim2.fromScale(0.235, 0.064)
end

local function buildChip()
	if chip and chip.Parent then
		return
	end
	local uic = registry and registry.UIController
	local layer = uic and uic.Layers and uic.Layers.GameHUD
	if not layer then
		return
	end
	chip = Kit.surface({
		Name = "EggRadar",
		Size = UDim2.fromScale(0.235, 0.064),
		Color = Theme.Hud.Panel,
		Transparency = Theme.Hud.Transparency,
		StrokeColor = Theme.Hud.Stroke,
		StrokeTransparency = Theme.Hud.StrokeTransparency,
		Radius = "Window",
		Parent = layer.Root,
	})
	chip.Visible = false
	chip:SetAttribute("QARegion", "HudRadar")
	local disc = Kit.frame({
		Name = "Icon",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0.03, 0.5),
		Size = UDim2.fromScale(0.72, 0.72),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundColor3 = Theme.Hud.Track,
		Parent = chip,
	})
	disc.BackgroundTransparency = 0
	Kit.corner(disc, "pill")
	local iconBox = Kit.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.66, 0.66), Parent = disc })
	Icons.make("Radar", { Color = Theme.Hud.Icon, Accent = C.Accent }).Parent = iconBox
	local texts = Kit.frame({ Name = "Texts", Position = UDim2.fromScale(0.22, 0.1), Size = UDim2.fromScale(0.52, 0.8), Parent = chip })
	local best = Kit.text({
		Name = "Best",
		Text = "",
		Role = "Heading",
		Scaled = true,
		MinTextSize = 9,
		Color = Theme.Hud.Text,
		Size = UDim2.fromScale(1, 0.56),
		Truncate = true,
		Parent = texts,
	})
	local info = Kit.text({
		Name = "Info",
		Text = "",
		Role = "Micro",
		Font = Theme.Fonts.Micro,
		Scaled = true,
		MinTextSize = 8,
		Color = Theme.Hud.TextMuted,
		Position = UDim2.fromScale(0, 0.58),
		Size = UDim2.fromScale(1, 0.38),
		Truncate = true,
		Parent = texts,
	})
	local arrow = Kit.frame({
		Name = "Arrow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.88, 0.5),
		Size = UDim2.fromScale(0.66, 0.66),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		Parent = chip,
	})
	Icons.make("Ascend", { Color = Theme.Hud.Icon, Accent = C.Accent }).Parent = arrow
	parts = { Best = best, Info = info, Arrow = arrow }
	layout()
end

-- ============================================================== markers
local function marker(egg): BillboardGui?
	local shell = egg.Model and egg.Model.PrimaryPart
	if not shell then
		return nil
	end
	local existing = markers[egg.Key]
	if existing and existing.Parent then
		return existing
	end
	local bb = Instance.new("BillboardGui")
	bb.Name = "RadarMarker"
	bb.Size = UDim2.fromOffset(120, 30)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 4.2, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 8000
	bb.LightInfluence = 0
	bb.Parent = shell
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextStrokeTransparency = 0.25
	label.Parent = bb
	markers[egg.Key] = bb
	return bb
end

local function clearMarkers()
	for key, bb in markers do
		bb:Destroy()
		markers[key] = nil
	end
end

-- ============================================================== per-frame
local function origin(): Vector3?
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return hrp and hrp.Position or nil
end

local function update()
	local data = registry.DataController.all()
	local now = Workspace:GetServerTimeNow()
	local range = EggReach.radarRange(data, now)
	local on = preview or range > 0
	if on ~= active then
		active = on
		if not on then
			clearMarkers()
		end
	end
	if not chip then
		if on then
			buildChip()
		else
			return
		end
	end
	if chip then
		chip.Visible = on
	end
	if not on or not chip or not parts then
		return
	end
	local from = origin()
	local eggs = registry.EggController and registry.EggController.list() or {}
	local seen = {}
	local bestEgg, bestScore, bestD = nil, -1, 0
	if from then
		for key, egg in eggs do
			local d = (egg.Position - from).Magnitude
			if d > range and not preview then
				continue
			end
			seen[key] = true
			local bb = marker(egg)
			if bb then
				local text = bb:FindFirstChild("Text") :: TextLabel
				text.Text = string.format("x%d  %s", egg.Luck or 1, distText(d))
				text.TextColor3 = EggConfig.luckColor(egg.Luck or 1)
				bb.Enabled = d > 24
			end
			-- the best target: lucky first, near preferred
			local score = (egg.Luck or 1) / (1 + d / 350)
			if score > bestScore then
				bestEgg, bestScore, bestD = egg, score, d
			end
		end
	end
	for key, bb in markers do
		if not seen[key] then
			bb:Destroy()
			markers[key] = nil
		end
	end
	parts.Info.Text = preview and "EGG RADAR  12:34" or powerText(data, now, range)
	if bestEgg and from then
		parts.Best.Text = string.format("x%d  %s", bestEgg.Luck or 1, distText(bestD))
		parts.Best.TextColor3 = EggConfig.luckColor(bestEgg.Luck or 1)
		local camera = Workspace.CurrentCamera
		if camera then
			local look = camera.CFrame.LookVector
			local forward = Vector3.new(look.X, 0, look.Z)
			local to = Vector3.new(bestEgg.Position.X - from.X, 0, bestEgg.Position.Z - from.Z)
			if forward.Magnitude > 0.01 and to.Magnitude > 0.5 then
				forward, to = forward.Unit, to.Unit
				parts.Arrow.Rotation = math.deg(math.atan2(-forward:Cross(to).Y, forward:Dot(to)))
			end
		end
	else
		parts.Best.Text = preview and "x250  412 studs" or "No egg nearby"
		parts.Best.TextColor3 = Theme.Hud.TextMuted
	end
end

function RadarController.isActive(): boolean
	return active
end

-- UILab: the chip with sample text, whatever the data says.
function RadarController.preview(on: boolean?)
	preview = on ~= false
	if not preview then
		clearMarkers()
	end
	update()
end

function RadarController.Init(reg)
	registry = reg
end

function RadarController.Start()
	Responsive.Changed:Connect(layout)
	RunService.Heartbeat:Connect(function(dt)
		clock += dt
		acc += dt
		if acc >= 0.2 then
			acc = 0
			update()
		end
	end)
end

return RadarController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000108">
					<Properties>
						<string name="Name">SanctuaryController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	SanctuaryController
	The local player's sanctuary: incubating eggs on the nest (with progress
	timers), "Place Egg" / "Hatch" / "Unlock" prompts, and the owner's
	guidance marker. All visuals are local (built from WorldConfig, so they do
	not depend on the plot having streamed in).

	Eggs are carried in your hand (HeldEggController): with an egg in hand every
	free nest spot offers "Place Egg" - stand at the spot you like and the egg flies
	from your hand into it. The nest itself places into the first free spot, or - with
	an empty hand - takes the best egg out of the bag.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local EggVisual = require(Shared:WaitForChild("EggVisual"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))
local WorldConfig = require(Configs:WaitForChild("WorldConfig"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))

local SanctuaryController = {}

local registry
local LocalPlayer = Players.LocalPlayer
local folder: Folder? = nil
local slots: { [number]: any } = {}
local nestPrompt: ProximityPrompt? = nil
local nestAnchor: BasePart? = nil
local plotId: number? = nil
local clock = 0
local pendingSlot: { [number]: boolean } = {} -- nest spots whose egg is still flying in
local placing = false

local SLOT_COUNT = #EggConfig.IncubatorPrices

-- ============================================================== geometry
local function plotFrame(): CFrame?
	local p = plotId and WorldConfig.Plots[plotId]
	if not p then
		return nil
	end
	return CFrame.new(p.Center.X, p.Height, p.Center.Z) * CFrame.Angles(0, p.Facing, 0)
end

function SanctuaryController.nestCFrame(): CFrame?
	local f = plotFrame()
	return f and f * CFrame.new(0, 2.6, -6) or nil
end

local function slotCFrame(i: number): CFrame?
	local nest = SanctuaryController.nestCFrame()
	if not nest then
		return nil
	end
	local a = (i - 1) / SLOT_COUNT * math.pi * 2
	return nest * CFrame.new(math.sin(a) * 4.6, 1.55, math.cos(a) * 4.6)
end
SanctuaryController.slotCFrame = slotCFrame

-- ============================================================== visuals
local function getFolder(): Folder
	if not folder or not folder.Parent then
		local f = Instance.new("Folder")
		f.Name = "MySanctuary"
		f.Parent = Workspace
		folder = f
	end
	return folder :: Folder
end

local function anchorPart(name: string, cf: CFrame, size: Vector3): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = size
	p.CFrame = cf
	p.Parent = getFolder()
	return p
end

local function billboard(parent: Instance, offsetY: number): (BillboardGui, TextLabel, Frame)
	local bb = Instance.new("BillboardGui")
	bb.Name = "Timer"
	-- sized in studs (like a small sign) so neighbouring slot timers never pile up
	bb.Size = UDim2.fromScale(3.3, 1.25)
	bb.StudsOffsetWorldSpace = Vector3.new(0, offsetY, 0)
	bb.AlwaysOnTop = false
	bb.MaxDistance = 70
	bb.LightInfluence = 0
	bb.Parent = parent
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(19, 21, 27)
	bg.BackgroundTransparency = 0.18
	bg.BorderSizePixel = 0
	bg.Parent = bb
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.3, 0)
	corner.Parent = bg
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(206, 170, 98)
	stroke.Transparency = 0.45
	stroke.Parent = bg
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0.66, 0)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(246, 238, 221)
	label.Text = ""
	label.Parent = bg
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0.08, 0)
	pad.PaddingLeft = UDim.new(0.06, 0)
	pad.PaddingRight = UDim.new(0.06, 0)
	pad.Parent = label
	local track = Instance.new("Frame")
	track.AnchorPoint = Vector2.new(0.5, 1)
	track.Position = UDim2.fromScale(0.5, 0.9)
	track.Size = UDim2.fromScale(0.86, 0.14)
	track.BackgroundColor3 = Color3.fromRGB(44, 46, 56)
	track.BorderSizePixel = 0
	track.Parent = bg
	local tc = Instance.new("UICorner")
	tc.CornerRadius = UDim.new(1, 0)
	tc.Parent = track
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.fromScale(0, 1)
	fill.BackgroundColor3 = Color3.fromRGB(246, 144, 44)
	fill.BorderSizePixel = 0
	fill.Parent = track
	local fc = Instance.new("UICorner")
	fc.CornerRadius = UDim.new(1, 0)
	fc.Parent = fill
	return bb, label, fill
end

local function clearSlot(i: number)
	local s = slots[i]
	if s then
		for _, inst in s.Instances do
			inst:Destroy()
		end
	end
	slots[i] = nil
end

local function buildSlot(i: number, state: string, info)
	clearSlot(i)
	local cf = slotCFrame(i)
	if not cf then
		return
	end
	local s = { State = state, Instances = {}, Info = info, Index = i }
	slots[i] = s
	if state == "Egg" then
		local model = EggVisual.build(info.Type, { Beam = false, Scale = 0.95 })
		model.Name = "NestEgg" .. i
		EggVisual.place(model, cf)
		model.Parent = getFolder()
		table.insert(s.Instances, model)
		s.Model = model
		local holder = anchorPart("SlotAnchor" .. i, cf, Vector3.new(2, 3, 2))
		table.insert(s.Instances, holder)
		local bb, label, fill = billboard(holder, 2.9)
		s.Label, s.Fill = label, fill
		local luck = math.max(1, tonumber(info.Luck) or 1)
		if luck > 1 then
			local tag = Instance.new("BillboardGui")
			tag.Name = "LuckTag"
			tag.Size = UDim2.fromScale(3.6, 0.9)
			tag.StudsOffsetWorldSpace = Vector3.new(0, 4.3, 0)
			tag.MaxDistance = 70
			tag.LightInfluence = 0
			tag.Parent = holder
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Size = UDim2.fromScale(1, 1)
			t.Font = Enum.Font.GothamBlack
			t.TextScaled = true
			t.Text = "x" .. tostring(luck) .. " LUCK"
			t.TextColor3 = EggConfig.luckColor(luck)
			t.TextStrokeTransparency = 0.3
			t.Parent = tag
		end
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "HatchPrompt"
		prompt.ActionText = "Hatch"
		prompt.ObjectText = (EggConfig.Eggs[info.Type] or EggConfig.Eggs.HavenEgg).Name
		prompt.HoldDuration = 0.35
		prompt.MaxActivationDistance = 16
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.Enabled = false
		prompt.Parent = holder
		prompt.Triggered:Connect(function()
			local hc = registry.HatchController
			if hc then
				hc.hatch(i)
			end
		end)
		s.Prompt = prompt
		local _ = bb
	elseif state == "Free" then
		local ring = Instance.new("Part")
		ring.Name = "FreeSlot" .. i
		ring.Anchored = true
		ring.CanCollide = false
		ring.CanQuery = false
		ring.CanTouch = false
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(0.12, 2.6, 2.6)
		ring.CFrame = cf * CFrame.new(0, -1.45, 0) * CFrame.Angles(0, 0, math.rad(90))
		ring.Material = Enum.Material.Neon
		ring.Color = Color3.fromRGB(246, 200, 120)
		ring.Transparency = 0.55
		ring.CastShadow = false
		ring.Parent = getFolder()
		table.insert(s.Instances, ring)
		-- "Place Egg" for the egg in hand: stand at the spot you want
		local holder = anchorPart("PlaceSpot" .. i, cf * CFrame.new(0, -0.9, 0), Vector3.new(2.6, 1.4, 2.6))
		table.insert(s.Instances, holder)
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "PlaceHerePrompt"
		prompt.ActionText = "Place Egg"
		prompt.ObjectText = "Nest spot " .. i
		prompt.HoldDuration = 0.15
		prompt.MaxActivationDistance = 6.5
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.E
		prompt.Enabled = SanctuaryController.holding()
		prompt.Parent = holder
		prompt.Triggered:Connect(function()
			SanctuaryController.placeHeld(i)
		end)
		s.PlacePrompt = prompt
	elseif state == "Buy" then
		local holder = anchorPart("BuySlot" .. i, cf, Vector3.new(2, 2, 2))
		table.insert(s.Instances, holder)
		local lock = Instance.new("Part")
		lock.Name = "LockedSlot" .. i
		lock.Anchored = true
		lock.CanCollide = false
		lock.CanQuery = false
		lock.Size = Vector3.new(1.6, 1.6, 1.6)
		lock.Shape = Enum.PartType.Ball
		lock.Material = Enum.Material.Glass
		lock.Color = Color3.fromRGB(120, 120, 130)
		lock.Transparency = 0.4
		lock.CFrame = cf * CFrame.new(0, -0.7, 0)
		lock.Parent = getFolder()
		table.insert(s.Instances, lock)
		local price = EggConfig.IncubatorPrices[i]
		local prompt = Instance.new("ProximityPrompt")
		prompt.Name = "UnlockPrompt"
		prompt.ActionText = "Unlock (" .. Format.cash(price) .. ")"
		prompt.ObjectText = "Nest spot " .. i
		prompt.HoldDuration = 0.5
		prompt.MaxActivationDistance = 14
		prompt.RequiresLineOfSight = false
		prompt.KeyboardKeyCode = Enum.KeyCode.F
		prompt.Parent = holder
		prompt.Triggered:Connect(function()
			local uic = registry.UIController
			task.spawn(function()
				local res = Net.request("Egg", "BuyIncubator", { Slot = i })
				if uic then
					uic.HandleResult(res, "Nest spot unlocked!")
				end
			end)
		end)
	end
end

-- Rebuilds slot visuals from the data mirror.
local function refresh()
	local D = registry.DataController
	local inc = D and D.get("Incubator")
	if not inc or not plotId then
		return
	end
	for i = 1, SLOT_COUNT do
		local info = inc.Slots and inc.Slots[tostring(i)]
		local state
		if info then
			state = "Egg"
		elseif i <= inc.Unlocked then
			state = "Free"
		elseif i == inc.Unlocked + 1 then
			state = "Buy"
		else
			state = "None"
		end
		local cur = slots[i]
		local same = cur and cur.State == state and (state ~= "Egg" or (cur.Info and cur.Info.Ready == info.Ready and cur.Info.Type == info.Type and cur.Info.Luck == info.Luck))
		local inFlight = state == "Egg" and pendingSlot[i] == true -- appears when the egg lands
		if not same and not inFlight then
			if state == "None" then
				clearSlot(i)
			else
				buildSlot(i, state, info)
			end
		end
	end
	SanctuaryController.updatePrompt()
end

-- Is an egg in the player's hand?
function SanctuaryController.holding(): boolean
	local hc = registry and registry.HeldEggController
	return hc ~= nil and hc.id() ~= nil
end

function SanctuaryController.updatePrompt()
	local D = registry.DataController
	local eggs = D and D.get("Eggs") or {}
	local inc = D and D.get("Incubator")
	local free = 0
	if inc then
		for i = 1, inc.Unlocked do
			if not (inc.Slots and inc.Slots[tostring(i)]) then
				free += 1
			end
		end
	end
	local holding = SanctuaryController.holding()
	if nestPrompt then
		nestPrompt.Enabled = (holding or #eggs > 0) and free > 0
		if holding then
			nestPrompt.ActionText = "Place Egg"
			nestPrompt.ObjectText = "Nest  -  first free spot"
		else
			nestPrompt.ActionText = "Take Egg"
			nestPrompt.ObjectText = string.format("Nest  -  %d egg%s in bag", #eggs, #eggs == 1 and "" or "s")
		end
	end
	for _, s in slots do
		if s.PlacePrompt then
			s.PlacePrompt.Enabled = holding
		end
	end
end

-- Puts the egg in hand into a nest spot (nil = first free one). The server checks the
-- range and the spot; on success the egg flies from the hand into the spot.
function SanctuaryController.placeHeld(slot: number?)
	if placing then
		return
	end
	local hc = registry.HeldEggController
	local eggId = hc and hc.id()
	if not eggId then
		return
	end
	placing = true
	local eggType = hc.type()
	local fromPos = hc.handPosition(LocalPlayer)
	task.spawn(function()
		local res = Net.request("Egg", "Place", { Id = eggId, Slot = slot })
		placing = false
		local uic = registry.UIController
		if not res.ok then
			if uic then
				uic.HandleResult(res)
			end
			return
		end
		local landed = res.data.Slot
		local target = slotCFrame(landed)
		local audio = registry.AudioController
		if hc and eggType and fromPos and target then
			pendingSlot[landed] = true
			local def = EggConfig.Eggs[eggType] or EggConfig.Eggs.HavenEgg
			hc.fly(eggType, fromPos, target.Position, 0.5, function()
				pendingSlot[landed] = nil
				refresh()
				hc.burst(target.Position, def.Glow)
				if audio and nestAnchor then
					audio.play3D("EggPlace", nestAnchor, 0.05)
				end
			end, nil, 0.95)
		elseif audio then
			audio.playUI("Click")
		end
		refresh()
	end)
end

local function buildNest()
	local cf = SanctuaryController.nestCFrame()
	if not cf then
		return
	end
	if nestAnchor then
		nestAnchor:Destroy()
	end
	nestAnchor = anchorPart("NestAnchor", cf * CFrame.new(0, 1, 0), Vector3.new(12, 2, 12))
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "PlaceEggPrompt"
	prompt.ActionText = "Place Egg"
	prompt.ObjectText = "Nest"
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = 18
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.Parent = nestAnchor
	prompt.Triggered:Connect(function()
		if SanctuaryController.holding() then
			SanctuaryController.placeHeld(nil)
		else
			local hc = registry.HeldEggController
			if hc then
				hc.holdBest()
			end
		end
	end)
	nestPrompt = prompt
end

local function step(dt: number)
	clock += dt
	local now = Workspace:GetServerTimeNow()
	for _, s in slots do
		if s.State == "Egg" and s.Info then
			local total = math.max(1, s.Info.Ready - s.Info.Start)
			local left = s.Info.Ready - now
			local ready = left <= 0
			if s.Label then
				if ready then
					s.Label.Text = "READY!"
					s.Label.TextColor3 = Color3.fromRGB(150, 255, 150)
				else
					s.Label.Text = Format.duration(math.ceil(left))
					s.Label.TextColor3 = Color3.fromRGB(246, 238, 221)
				end
			end
			if s.Fill then
				s.Fill.Size = UDim2.fromScale(math.clamp(1 - left / total, 0, 1), 1)
				s.Fill.BackgroundColor3 = ready and Color3.fromRGB(108, 200, 116) or Color3.fromRGB(246, 144, 44)
			end
			if s.Prompt then
				s.Prompt.Enabled = ready
			end
			-- wobble while incubating, excited shake when ready
			if s.Model and s.Model.Parent then
				local base = slotCFrame(s.Index)
				if base then
					local amp = ready and 0.12 or 0.03
					local freq = ready and 9 or 2
					EggVisual.place(s.Model, base * CFrame.Angles(math.sin(clock * freq) * amp, 0, math.cos(clock * freq * 0.8) * amp))
				end
			end
		end
	end
end

function SanctuaryController.plotId(): number?
	return plotId
end

function SanctuaryController.Init(reg)
	registry = reg
end

function SanctuaryController.Start()
	local function onPlot()
		local id = LocalPlayer:GetAttribute("PlotId")
		if type(id) == "number" and id ~= plotId then
			plotId = id
			for i in table.clone(slots) do
				clearSlot(i)
			end
			buildNest()
			refresh()
		end
	end
	LocalPlayer:GetAttributeChangedSignal("PlotId"):Connect(onPlot)
	onPlot()
	local D = registry.DataController
	if D then
		D.observe("Incubator", refresh)
		D.observe("Eggs", function()
			SanctuaryController.updatePrompt()
		end)
	end
	LocalPlayer:GetAttributeChangedSignal("HeldEggId"):Connect(function()
		SanctuaryController.updatePrompt()
	end)
	RunService.Heartbeat:Connect(step)
end

return SanctuaryController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000109">
					<Properties>
						<string name="Name">SettingsController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	SettingsController
	Applies settings instantly on the client and syncs them to the server
	(debounced so slider drags don't spam the network).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local SettingsController = {}
SettingsController.Current = {}

local registry = nil
local pendingSend: { [string]: any } = {}
local sendThread = nil

local function applyAll()
	local s = SettingsController.Current
	local R = registry
	if R.GraphicsController and s.Graphics then
		R.GraphicsController.setPreset(s.Graphics)
	end
	if R.GraphicsController and R.GraphicsController.setMenuBlurEnabled then
		R.GraphicsController.setMenuBlurEnabled(s.MenuBlur == true)
	end
	if R.AudioController then
		R.AudioController.setVolumes(s.Music or 0.6, s.SFX or 0.8)
	end
	if R.CameraController and R.CameraController.setOptions then
		R.CameraController.setOptions({
			Sensitivity = s.Sensitivity or 1,
			Shake = s.CameraShake ~= false,
			SpeedFOV = s.SpeedFOV ~= false,
			MouseLock = s.MouseLock == true,
			InvertY = s.InvertY == true,
		})
	end
	if s.UIScale then
		local Responsive = require(script.Parent.Parent:WaitForChild("UI"):WaitForChild("Responsive"))
		if math.abs(Responsive.UserScale - s.UIScale) > 1e-3 then
			Responsive.setUserScale(s.UIScale)
		end
	end
end

function SettingsController.get(key: string)
	return SettingsController.Current[key]
end

function SettingsController.set(key: string, value: any)
	SettingsController.Current[key] = value
	applyAll()
	pendingSend[key] = value
	if sendThread then
		task.cancel(sendThread)
	end
	sendThread = task.delay(0.35, function()
		sendThread = nil
		local batch = pendingSend
		pendingSend = {}
		for k, v in batch do
			Net.request("Settings", "Set", { Key = k, Value = v })
		end
	end)
end

function SettingsController.Init(reg)
	registry = reg
	reg.DataController.observe("Settings", function(settings)
		if type(settings) ~= "table" then
			return
		end
		for k, v in settings do
			if pendingSend[k] == nil then
				SettingsController.Current[k] = v
			end
		end
		applyAll()
	end)
end

return SettingsController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000110">
					<Properties>
						<string name="Name">SpinController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	SpinController
	Builds the Spin Island wheel rotor locally (toy-brick pie slices, rim,
	pegs, hub, prize labels) at SpinConfig.Wheel, idles it slowly while you
	are nearby, and plays the spin cinematic for a server result:
	camera in front of the wheel -> 5 turns easing out -> ticks on every peg
	-> lands on the prize -> flash + confetti + reward toast.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Configs = ReplicatedStorage:WaitForChild("Configs")
local SpinConfig = require(Configs:WaitForChild("SpinConfig"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))
local Primitives = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Dragons"):WaitForChild("Primitives"))

local SpinController = {}

local registry
local rotor: Model? = nil
local parts: { BasePart } = {}
local offsets: { CFrame } = {}
local segParts: { [number]: { BasePart } } = {}
local angle = 0 -- degrees, clockwise as players see it
local spinning = false
local BUILD_RANGE = 700

local V3 = Vector3.new
local WHITE = Color3.fromRGB(242, 243, 242)
local GOLD = Color3.fromRGB(245, 205, 47)
local RED = Color3.fromRGB(196, 40, 27)

local function rotorCF(deg: number): CFrame
	-- rotation about the wheel's local Z: clockwise for players looking at its front
	return SpinConfig.Wheel * CFrame.Angles(0, 0, math.rad(deg))
end

local function add(part: BasePart, localCF: CFrame)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = rotor
	table.insert(parts, part)
	table.insert(offsets, localCF)
	return part
end

-- point on the wheel face: angle clockwise from the top as players see it
local function onFace(deg: number, radius: number, z: number): Vector3
	local a = math.rad(deg)
	return V3(-math.sin(a) * radius, math.cos(a) * radius, z)
end

local function build()
	rotor = Instance.new("Model")
	rotor.Name = "SpinWheelRotor"
	table.clear(parts)
	table.clear(offsets)
	table.clear(segParts)
	local R = SpinConfig.WheelRadius
	local n = #SpinConfig.Segments
	local step = 360 / n
	local thick = 1
	-- pie slices (each slice = 2 wedges, built in rotor-local space)
	for i, seg in SpinConfig.Segments do
		local a0, a1 = (i - 1) * step, i * step
		local p0 = V3(0, 0, 0)
		local p1 = onFace(a0, R, 0)
		local p2 = onFace(a1, R, 0)
		segParts[i] = {}
		for _, w in Primitives.triangle(p0, p1, p2, thick, seg.Color, Enum.Material.SmoothPlastic) do
			local localCF = w.CFrame
			table.insert(segParts[i], add(w, localCF))
		end
		-- divider peg at the slice border (toward the players)
		local pegPos = onFace(a0, R - 0.9, -0.9)
		local peg = Primitives.block(V3(1.2, 0.8, 0.8), CFrame.new(), GOLD)
		peg.Shape = Enum.PartType.Cylinder
		add(peg, CFrame.lookAt(pegPos, pegPos + V3(0, 0, -1)) * CFrame.Angles(0, math.rad(90), 0))
	end
	-- rim
	local rimN = n * 3
	for i = 0, rimN - 1 do
		local a0, a1 = i / rimN * 360, (i + 1) / rimN * 360
		local q0, q1 = onFace(a0, R + 0.5, 0), onFace(a1, R + 0.5, 0)
		local mid = (q0 + q1) / 2
		local len = (q1 - q0).Magnitude * 1.08
		local col = (i % 3 == 0) and GOLD or WHITE
		local b = Primitives.block(V3(1.2, 1.6, len), CFrame.new(), col)
		add(b, CFrame.lookAt(mid, q1, V3(0, 0, -1)))
	end
	-- hub
	local hub = Primitives.block(V3(1.6, 5, 5), CFrame.new(), GOLD)
	hub.Shape = Enum.PartType.Cylinder
	add(hub, CFrame.new(0, 0, -0.6) * CFrame.Angles(0, math.rad(90), 0))
	local cap = Primitives.block(V3(0.6, 3, 3), CFrame.new(), RED)
	cap.Shape = Enum.PartType.Cylinder
	add(cap, CFrame.new(0, 0, -1.5) * CFrame.Angles(0, math.rad(90), 0))
	-- prize labels on a clear plate in front of the slices (rotates with the rotor)
	local plate = Instance.new("Part")
	plate.Name = "LabelPlate"
	plate.Size = V3(R * 2, R * 2, 0.1)
	plate.Transparency = 1
	add(plate, CFrame.new(0, 0, -0.62))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.LightInfluence = 0
	gui.MaxDistance = 600
	gui.Adornee = plate
	gui.Parent = plate
	for i, seg in SpinConfig.Segments do
		local mid = SpinConfig.segmentAngle(i)
		local a = math.rad(mid)
		local t = Instance.new("TextLabel")
		t.Name = "Label" .. i
		t.BackgroundTransparency = 1
		t.AnchorPoint = Vector2.new(0.5, 0.5)
		t.Position = UDim2.fromScale(0.5 + math.sin(a) * 0.31, 0.5 - math.cos(a) * 0.31)
		t.Size = UDim2.fromScale(0.36, 0.1)
		t.Rotation = mid - 90
		t.Font = Enum.Font.GothamBlack
		t.TextScaled = true
		t.Text = seg.Label
		t.TextColor3 = Color3.new(1, 1, 1)
		local st = Instance.new("UIStroke")
		st.Thickness = 2.5
		st.Color = Color3.fromRGB(20, 24, 40)
		st.Parent = t
		t.Parent = gui
	end
	rotor.Parent = Workspace
	SpinController.Apply()
end

function SpinController.Apply()
	if not rotor then
		return
	end
	local base = rotorCF(angle)
	local cfs = table.create(#parts)
	for i, off in offsets do
		cfs[i] = base * off
	end
	local ok = pcall(function()
		Workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	end)
	if not ok then
		for i, p in parts do
			p.CFrame = cfs[i]
		end
	end
end

local function cameraFocus(): Vector3?
	local cam = Workspace.CurrentCamera
	return cam and cam.CFrame.Position or nil
end

-- which segment is under the top pointer for a rotor angle
function SpinController.segmentAt(deg: number): number
	local n = #SpinConfig.Segments
	local step = 360 / n
	local a = (-deg) % 360
	return math.floor(a / step) % n + 1
end

local function easeOutQuint(x: number): number
	return 1 - (1 - x) ^ 5
end

local function flashSegment(i: number)
	local list = segParts[i]
	if not list then
		return
	end
	task.spawn(function()
		for k = 1, 6 do
			for _, p in list do
				p.Material = (k % 2 == 1) and Enum.Material.Neon or Enum.Material.SmoothPlastic
			end
			task.wait(0.18)
		end
	end)
end

local function confetti(at: Vector3, count: number)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = V3(1, 1, 1)
	p.CFrame = CFrame.new(at)
	p.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	e.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
		ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 220, 60)),
		ColorSequenceKeypoint.new(0.66, Color3.fromRGB(90, 220, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 120, 255)),
	})
	e.LightEmission = 1
	e.Rate = 0
	e.Lifetime = NumberRange.new(1, 1.8)
	e.Speed = NumberRange.new(18, 34)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = V3(0, -18, 0)
	e.Drag = 1.5
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) })
	e.Parent = p
	e:Emit(count)
	task.delay(2.5, function()
		p:Destroy()
	end)
end

local viewing = false

local function wheelShot(): CFrame
	local wheel = SpinConfig.Wheel
	return CFrame.lookAt(wheel.Position + wheel.LookVector * 44 + V3(0, 2, 0), wheel.Position + V3(0, -2, 0))
end

local function glideCamera(to: CFrame, duration: number)
	local camera = Workspace.CurrentCamera
	local from = camera.CFrame
	local t0 = os.clock()
	while os.clock() - t0 < duration do
		local a = (os.clock() - t0) / duration
		camera.CFrame = from:Lerp(to, a * a * (3 - 2 * a))
		RunService.RenderStepped:Wait()
	end
	camera.CFrame = to
end

-- Spin panel open: camera frames the wheel (HUD hidden) until exitView.
function SpinController.enterView()
	if viewing then
		return
	end
	viewing = true
	if not rotor then
		build()
	end
	local cam = registry.CameraController
	if cam and not cam.inCinematic() then
		cam.beginCinematic()
	end
	registry.UIController.SetHudVisible(false)
	task.spawn(glideCamera, wheelShot(), 0.7)
end

function SpinController.exitView()
	if not viewing then
		return
	end
	viewing = false
	task.spawn(function()
		while spinning do
			task.wait()
		end
		local cam = registry.CameraController
		local char = Players.LocalPlayer.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if hrp then
			glideCamera(CFrame.lookAt(hrp.Position - hrp.CFrame.LookVector * 16 + V3(0, 7, 0), hrp.Position + V3(0, 2, 0)), 0.5)
		end
		if not viewing then
			registry.UIController.SetHudVisible(true)
			if cam and cam.inCinematic() then
				cam.endCinematic()
			end
		end
	end)
end

function SpinController.isViewing(): boolean
	return viewing
end

-- Plays the spin for a server result; returns when the wheel has landed.
function SpinController.play(result)
	if spinning then
		return
	end
	spinning = true
	if not rotor then
		build()
	end
	local cam = registry.CameraController
	local camera = Workspace.CurrentCamera
	local uic = registry.UIController
	local audio = registry.AudioController
	local wheel = SpinConfig.Wheel
	local ownView = not viewing
	local ok, err = pcall(function()
		if ownView then
			if cam then
				cam.beginCinematic()
			end
			uic.SetHudVisible(false)
			glideCamera(wheelShot(), 0.6)
		else
			camera.CFrame = wheelShot()
		end
		-- target angle: land inside the winning slice (not always dead centre)
		local n = #SpinConfig.Segments
		local step = 360 / n
		local target = -SpinConfig.segmentAngle(result.Index) + (math.random() - 0.5) * step * 0.6
		local start = angle
		local delta = (target - start) % 360
		local total = SpinConfig.Turns * 360 + delta
		local duration = SpinConfig.SpinSeconds
		local lastSeg = SpinController.segmentAt(angle)
		local t0 = os.clock()
		local shot = camera.CFrame
		while true do
			local a = math.clamp((os.clock() - t0) / duration, 0, 1)
			angle = start + total * easeOutQuint(a)
			SpinController.Apply()
			-- slow push-in while the wheel slows down
			camera.CFrame = shot * CFrame.new(0, 0, -6 * a * a)
			local seg = SpinController.segmentAt(angle)
			if seg ~= lastSeg then
				lastSeg = seg
				if audio then
					audio.playUI("Click")
				end
			end
			if a >= 1 then
				break
			end
			RunService.RenderStepped:Wait()
		end
		angle %= 360
		-- landed
		flashSegment(result.Index)
		local seg = SpinConfig.Segments[result.Index]
		confetti(wheel.Position + wheel.LookVector * 2 + V3(0, SpinConfig.WheelRadius, 0), seg.Jackpot and 160 or 80)
		if audio then
			audio.playUI(seg.Jackpot and "LevelUp" or "Collect")
		end
		SpinController.ShowPrize(result)
		task.wait(1.6)
		if not ownView and viewing then
			glideCamera(wheelShot(), 0.4)
		end
	end)
	if not ok then
		warn("[Spin] " .. tostring(err))
	end
	if ownView then
		uic.SetHudVisible(true)
		if cam and cam.inCinematic() then
			cam.endCinematic()
		end
	end
	spinning = false
end

function SpinController.isSpinning(): boolean
	return spinning
end

-- Big "YOU WON" banner + toast.
function SpinController.ShowPrize(result)
	local uic = registry.UIController
	local prize = result.Prize or {}
	local text = prize.Label or "PRIZE"
	if prize.Kind == "Egg" then
		local egg = EggConfig.Eggs[prize.Egg]
		text = string.upper(egg and egg.Name or prize.Egg or "EGG")
		if (prize.Count or 0) == 0 then
			text ..= "  (bag full: +$" .. tostring(prize.Amount or 0) .. ")"
		end
	elseif prize.Kind == "Spin" then
		text = "+" .. tostring(prize.Count or 1) .. " SPIN"
	elseif prize.Kind == "Boost" then
		text = "x2 LUCK  " .. tostring(math.floor((prize.Seconds or 600) / 60)) .. " MIN"
	end
	-- the Spin panel shows a clean result card above its bar; the toast is only the fallback
	local seg = SpinConfig.Segments[result.Index]
	local win = uic.GetWindow and uic.GetWindow("Spin")
	if win and win.ShowPrize and win.Root.Visible then
		win:ShowPrize(text, seg and seg.Color or WHITE, seg and seg.Jackpot)
	else
		uic.Notify("rare", "Spin Wheel: you won " .. text .. "!")
	end
end

function SpinController.Init(reg)
	registry = reg
end

function SpinController.Start()
	-- build/destroy the rotor by distance and idle-rotate it while nearby
	RunService.Heartbeat:Connect(function(dt)
		local pos = cameraFocus()
		local near = pos ~= nil and (pos - SpinConfig.Wheel.Position).Magnitude < BUILD_RANGE
		if near and not rotor then
			build()
		elseif not near and rotor and not spinning then
			rotor:Destroy()
			rotor = nil
		end
		if rotor and not spinning then
			angle = (angle + dt * 8) % 360
			SpinController.Apply()
		end
	end)
end

return SpinController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000111">
					<Properties>
						<string name="Name">TitleController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	TitleController
	RNG-style titles above every player's dragon: name (rarity colour),
	"1 in 12,500,000" (colour by how rare it is) and the mutation.
	Built locally from the companion model's attributes (DisplayName,
	SpeciesId, Rarity, Mutation, Odds, Exclusive), so they cost the server
	nothing. Your own dragon's title hides while you ride it.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Odds = require(Shared:WaitForChild("Odds"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))

local TitleController = {}

local LocalPlayer = Players.LocalPlayer
local titles: { [Model]: { Gui: BillboardGui, Conn: { RBXScriptConnection } } } = {}

local MAX_DISTANCE = 160

local function label(parent: Instance, name: string, y: number, h: number, font: Enum.Font): TextLabel
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundTransparency = 1
	t.Position = UDim2.fromScale(0, y)
	t.Size = UDim2.fromScale(1, h)
	t.Font = font
	t.TextScaled = true
	t.TextColor3 = Color3.new(1, 1, 1)
	t.TextStrokeTransparency = 0.35
	t.Parent = parent
	return t
end

local function fill(model: Model, gui: BillboardGui)
	local speciesId = model:GetAttribute("SpeciesId")
	local species = speciesId and DragonConfig.Species[speciesId]
	if not species then
		gui.Enabled = false
		return
	end
	local rarity = DragonConfig.Rarities[species.Rarity] or DragonConfig.Rarities.Common
	local mutationId = model:GetAttribute("Mutation") or "None"
	local mutation = MutationConfig.Mutations[mutationId]
	local exclusive = model:GetAttribute("Exclusive") == true
	local odds = tonumber(model:GetAttribute("Odds")) or Odds.base(speciesId, mutationId)
	local name = gui:FindFirstChild("Name") :: TextLabel
	local title = gui:FindFirstChild("Title") :: TextLabel
	local tag = gui:FindFirstChild("Tag") :: TextLabel
	name.Text = model:GetAttribute("DisplayName") or species.Name
	name.TextColor3 = rarity.Glow
	title.Text = Odds.format(odds, exclusive)
	title.TextColor3 = exclusive and rarity.Glow or Odds.color(odds)
	local shimmer = title:FindFirstChild("Shimmer") :: UIGradient?
	local top = exclusive or Odds.tier(odds) >= 6
	if top and not shimmer then
		local g = Instance.new("UIGradient")
		g.Name = "Shimmer"
		g.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 230, 150)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)),
		})
		g.Parent = title
	elseif not top and shimmer then
		shimmer:Destroy()
	end
	if mutation and mutationId ~= "None" then
		tag.Visible = true
		tag.Text = string.upper(mutation.Name)
		tag.TextColor3 = mutation.Color
	else
		tag.Visible = false
	end
	gui.Enabled = true
end

local function heightFor(model: Model): number
	local br = tonumber(model:GetAttribute("BodyRadius")) or 4
	local hip = tonumber(model:GetAttribute("HipHeight")) or 5
	return br * 0.9 + hip * 0.55 + 4
end

local function untrack(model: Model)
	local t = titles[model]
	if t then
		titles[model] = nil
		for _, c in t.Conn do
			c:Disconnect()
		end
		t.Gui:Destroy()
	end
end

local function track(model: Instance)
	if not model:IsA("Model") or titles[model] then
		return
	end
	local root = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
	if not root then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "DragonTitle"
	gui.Size = UDim2.fromScale(12, 3.6) -- studs
	gui.StudsOffsetWorldSpace = Vector3.new(0, heightFor(model), 0)
	gui.MaxDistance = MAX_DISTANCE
	gui.LightInfluence = 0
	gui.AlwaysOnTop = false
	gui.ResetOnSpawn = false
	gui.Adornee = root
	label(gui, "Tag", 0, 0.24, Enum.Font.GothamBlack)
	label(gui, "Name", 0.24, 0.32, Enum.Font.GothamBlack)
	label(gui, "Title", 0.56, 0.42, Enum.Font.GothamBlack)
	gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
	local entry = { Gui = gui, Conn = {} }
	titles[model :: Model] = entry
	fill(model :: Model, gui)
	table.insert(entry.Conn, model.AttributeChanged:Connect(function(attr)
		if attr == "Odds" or attr == "Mutation" or attr == "SpeciesId" or attr == "DisplayName" or attr == "Exclusive" then
			fill(model :: Model, gui)
		elseif attr == "BodyRadius" or attr == "HipHeight" then
			gui.StudsOffsetWorldSpace = Vector3.new(0, heightFor(model :: Model), 0)
		end
	end))
	table.insert(entry.Conn, model.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			untrack(model :: Model)
		end
	end))
end

local function ownModel(model: Model): boolean
	return model.Name == "Dragon_" .. LocalPlayer.UserId
end

function TitleController.Start()
	task.spawn(function()
		local folder = Workspace:WaitForChild("Dragons", 60)
		if not folder then
			return
		end
		for _, m in folder:GetChildren() do
			track(m)
		end
		folder.ChildAdded:Connect(function(m)
			task.defer(track, m)
		end)
		folder.ChildRemoved:Connect(function(m)
			if m:IsA("Model") then
				untrack(m)
			end
		end)
		-- hide your own title while riding; retry roots that streamed in late
		RunService.Heartbeat:Connect(function()
			local riding = LocalPlayer:GetAttribute("Riding") == true
			for model, t in titles do
				if ownModel(model) then
					t.Gui.Enabled = not riding and t.Gui:FindFirstChild("Name") ~= nil
				end
			end
		end)
		while true do
			task.wait(2)
			for _, m in folder:GetChildren() do
				track(m)
			end
		end
	end)
end

function TitleController.Init() end

return TitleController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000112">
					<Properties>
						<string name="Name">TreeController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	TreeController
	Keeps the Great Tree in the plaza in sync with the player's upgrades: the five
	pods are the five categories (Luck, Wealth, Flight, Nest, Bond); each has five
	fruit orbs (tagged "TreeOrb", attributes Category / Level 1-5, built by the
	server in World/GreatTree). Orb n glows in the category colour once n/5 of the
	category's levels are bought, and a sparkle burst plays on the orb that just
	lit up. Purely visual and local - the levels live in data.Tree (TreeService).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local TreeConfig = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("TreeConfig"))

local TreeController = {}

local registry
local progress: { [string]: number } = {} -- category id -> bought fraction (0..1)
local lastLit: { [string]: number }? = nil -- category id -> number of lit orbs
local lit: { [BasePart]: { Light: PointLight?, Level: number } } = {}

local OFF_COLOR = Color3.fromRGB(88, 94, 104)
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"

-- number of lit orbs (0-5) for a category progress
local function litCount(fraction: number): number
	return math.min(5, math.floor(fraction * 5 + 1e-6))
end

local function paintOrb(orb: Instance)
	if not orb:IsA("BasePart") then
		return
	end
	local cat = TreeConfig.CategoryById[orb:GetAttribute("Category")]
	local level = orb:GetAttribute("Level")
	if not cat or type(level) ~= "number" then
		return
	end
	local owned = litCount(progress[cat.Id] or 0) >= level
	orb.Material = owned and Enum.Material.Neon or Enum.Material.SmoothPlastic
	orb.Color = owned and cat.Color or OFF_COLOR
	orb.Transparency = owned and 0.05 or 0.4
	local light = orb:FindFirstChildOfClass("PointLight")
	if light then
		light.Enabled = owned
	end
	lit[orb :: BasePart] = owned and { Light = light, Level = level } or nil
end

local function repaintAll()
	for _, orb in CollectionService:GetTagged("TreeOrb") do
		paintOrb(orb)
	end
end

-- Sparkle burst on the orb that just lit up.
local function burst(orb: BasePart, color: Color3)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Transparency = 1
	p.Size = Vector3.new(1, 1, 1)
	p.CFrame = CFrame.new(orb.Position)
	p.Parent = Workspace
	local e = Instance.new("ParticleEmitter")
	e.Texture = SPARKLE
	e.Color = ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.4), color)
	e.LightEmission = 1
	e.Rate = 0
	e.Lifetime = NumberRange.new(0.8, 1.4)
	e.Speed = NumberRange.new(10, 22)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Acceleration = Vector3.new(0, -8, 0)
	e.Drag = 2
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.1), NumberSequenceKeypoint.new(1, 0) })
	e.Parent = p
	e:Emit(46)
	task.delay(2, function()
		p:Destroy()
	end)
end

local function onTree(tree)
	local data = { Tree = type(tree) == "table" and tree or {} }
	local lit = {}
	progress = {}
	for _, cat in TreeConfig.Categories do
		progress[cat.Id] = TreeConfig.categoryProgress(data, cat.Id)
		lit[cat.Id] = litCount(progress[cat.Id])
	end
	repaintAll()
	if lastLit then
		for _, orb in CollectionService:GetTagged("TreeOrb") do
			local id, level = orb:GetAttribute("Category"), orb:GetAttribute("Level")
			if id and level and (lastLit[id] or 0) < level and lit[id] >= level then
				burst(orb :: BasePart, TreeConfig.CategoryById[id].Color)
			end
		end
	end
	lastLit = lit
end

function TreeController.Init(reg)
	registry = reg
end

function TreeController.Start()
	CollectionService:GetInstanceAddedSignal("TreeOrb"):Connect(paintOrb)
	CollectionService:GetInstanceRemovedSignal("TreeOrb"):Connect(function(orb)
		lit[orb :: BasePart] = nil
	end)
	registry.DataController.observe("Tree", onTree)
	-- lit fruit breathes softly
	RunService.Heartbeat:Connect(function()
		local t = os.clock()
		for _, info in lit do
			if info.Light then
				info.Light.Brightness = 1.3 + 0.45 * math.sin(t * 2.2 + info.Level)
			end
		end
	end)
end

-- Fraction (0..1) of a category that is bought (for tests / other UI).
function TreeController.progress(): { [string]: number }
	return progress
end

return TreeController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000113">
					<Properties>
						<string name="Name">UIController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	UIController (master UI controller)
	- Creates the layered ScreenGuis (HUD 10, Tooltip 30, Windows 50,
	  Notifications 70, Modal 100) with a responsive root each
	- Owns the window manager: exactly ONE major window open at a time,
	  centralized open/close transitions (scale 0.96 -> 1 + fade, ~190 ms)
	- Esc / Gamepad B / mobile close button = back/close
	- Keyboard shortcuts for every HUD button
	- Public helpers: Notify, Confirm, SetHudVisible
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")

local player = Players.LocalPlayer
local Scripts = script.Parent.Parent
local UI = Scripts:WaitForChild("UI")

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local Signal = require(Shared.Util.Signal)
local Net = require(Shared.Net)

local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Create = require(UI.Create)
local Kit = require(UI.Kit)
local Fade = require(UI.Fade)

local UIController = {}
UIController.WindowOpened = Signal.new()
UIController.WindowClosed = Signal.new()
UIController.HudVisibilityChanged = Signal.new()
UIController.Layers = {}
UIController.InputBlocked = false
UIController.Current = nil -- name of the open window
UIController.Windows = {} -- name -> window object
UIController.WindowModules = {} -- name -> module (lazy build)
UIController.HudVisible = true

local registry = nil
local transition = nil -- active RenderStepped connection
local backdrop: TextButton = nil

-- Hotkeys -> window names
local HOTKEYS = {
	[Enum.KeyCode.G] = "Inventory",
	[Enum.KeyCode.X] = "Index",
	[Enum.KeyCode.Q] = "Quests",
	[Enum.KeyCode.B] = "Shop",
	[Enum.KeyCode.J] = "Daily",
	[Enum.KeyCode.P] = "Settings",
	[Enum.KeyCode.K] = "EggStorage",
	[Enum.KeyCode.T] = "Teleport",
}
UIController.Hotkeys = HOTKEYS

local function makeLayer(name: string, order: number)
	local gui = Create("ScreenGui", {
		Name = name,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = order,
	})
	pcall(function()
		gui.ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets
	end)
	local root = Create("Frame", {
		Name = "Root",
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Parent = gui,
	})
	local scale = Create("UIScale", { Parent = root })
	Responsive.registerRoot(root, scale)
	gui.Parent = player:WaitForChild("PlayerGui")
	UIController.Layers[name] = { Gui = gui, Root = root }
	return root
end

function UIController.sound(key: string)
	local audio = registry and registry.AudioController
	if audio then
		audio.playUI(key)
	end
end

-- ============================================================== windows
function UIController.RegisterWindow(name: string, module)
	UIController.WindowModules[name] = module
end

local function getWindow(name: string)
	local w = UIController.Windows[name]
	if w then
		return w
	end
	local module = UIController.WindowModules[name]
	if not module then
		warn("[UI] Unknown window " .. name)
		return nil
	end
	w = module.new(UIController, registry)
	w.Root.Visible = false
	w.Root.Parent = UIController.Layers.GameUI.Root:FindFirstChild("Windows")
	w.OnClose = function()
		UIController.Close()
	end
	UIController.Windows[name] = w
	return w
end
UIController.GetWindow = getWindow

local function stopTransition()
	if transition then
		transition:Disconnect()
		transition = nil
	end
end

local function animate(duration: number, step: (number) -> (), done: (() -> ())?)
	stopTransition()
	local start = os.clock()
	step(0)
	transition = RunService.RenderStepped:Connect(function()
		local a = math.clamp((os.clock() - start) / duration, 0, 1)
		step(a)
		if a >= 1 then
			stopTransition()
			if done then
				done()
			end
		end
	end)
end

local fadeState = nil
local closingWindow = nil
local BACKDROP_T = 0.6

local backdropAllowed = true
local function setBackdrop(alpha: number)
	backdrop.BackgroundTransparency = backdropAllowed and (1 - (1 - BACKDROP_T) * alpha) or 1
end

local function finishClose(w)
	if w then
		w.Root.Visible = false
		w.Scale.Scale = 1
	end
	if fadeState then
		Fade.restore(fadeState)
		fadeState = nil
	end
	closingWindow = nil
end

function UIController.IsOpen(name: string?): boolean
	if name then
		return UIController.Current == name
	end
	return UIController.Current ~= nil
end

function UIController.Open(name: string, args: any?)
	if UIController.Current == name then
		local w = UIController.Windows[name]
		if w and w.OnReopen then
			w:OnReopen(args)
		end
		return
	end
	local w = getWindow(name)
	if not w then
		return
	end
	-- close the current one instantly (single-window rule)
	if UIController.Current then
		local old = UIController.Windows[UIController.Current]
		local oldName = UIController.Current
		stopTransition()
		finishClose(old)
		if old and old.OnHidden then
			old:OnHidden()
		end
		UIController.WindowClosed:Fire(oldName)
	elseif closingWindow then
		stopTransition()
		finishClose(closingWindow)
	end
	UIController.Current = name
	UIController.InputBlocked = true
	w:ApplySize()
	if w.OnOpen then
		w:OnOpen(args)
	end
	w.Root.Visible = true
	-- windows that sit over the 3D world (e.g. the Spin Wheel bar) skip the dim backdrop
	backdropAllowed = w.NoBackdrop ~= true
	backdrop.Visible = backdropAllowed
	fadeState = Fade.capture(w.Root)
	UIController.sound("Open")
	UIController.WindowOpened:Fire(name, w)
	animate(Theme.Motion.Open, function(a)
		local e = 1 - (1 - a) ^ 4 -- quart out
		if fadeState then
			Fade.apply(fadeState, e)
		end
		setBackdrop(e)
		w.Scale.Scale = Theme.Motion.StartScale + (1 - Theme.Motion.StartScale) * e
	end, function()
		if fadeState then
			Fade.restore(fadeState)
			fadeState = nil
		end
		setBackdrop(1)
	end)
end

function UIController.Close()
	local name = UIController.Current
	if not name then
		return
	end
	local w = UIController.Windows[name]
	UIController.Current = nil
	UIController.InputBlocked = false
	UIController.sound("Close")
	if w and w.OnHidden then
		w:OnHidden()
	end
	UIController.WindowClosed:Fire(name)
	stopTransition()
	if fadeState then
		Fade.restore(fadeState)
	end
	fadeState = w and Fade.capture(w.Root) or nil
	closingWindow = w
	animate(Theme.Motion.Close, function(a)
		local e = a * a
		if fadeState then
			Fade.apply(fadeState, 1 - e)
		end
		setBackdrop(1 - e)
		if w then
			w.Scale.Scale = 1 - (1 - Theme.Motion.StartScale) * e
		end
	end, function()
		backdrop.Visible = false
		finishClose(w)
	end)
end

function UIController.Toggle(name: string, args: any?)
	if UIController.Current == name then
		UIController.Close()
	else
		UIController.Open(name, args)
	end
end

-- ============================================================== helpers
function UIController.Notify(kind: string, text: string, extra: { [string]: any }?)
	if UIController.Notifications then
		UIController.Notifications:Push(kind, text, extra)
	end
end

function UIController.Confirm(opts: { [string]: any }): boolean
	return UIController.ModalDialog:Confirm(opts)
end

function UIController.SetHudVisible(visible: boolean)
	UIController.HudVisible = visible
	local hud = UIController.Layers.GameHUD
	if hud then
		hud.Gui.Enabled = visible
	end
	UIController.HudVisibilityChanged:Fire(visible)
end

-- Shows a server result error as a toast; returns ok.
function UIController.HandleResult(result, successText: string?): boolean
	if result.ok then
		if successText then
			UIController.Notify("success", successText)
		end
		return true
	end
	if result.msg then
		UIController.Notify("error", result.msg)
	elseif result.err ~= "RATE_LIMITED" then
		UIController.Notify("error", "Action failed")
	end
	return false
end

-- ============================================================== init
function UIController.Init(reg)
	registry = reg
	Responsive.Init()

	makeLayer("GameHUD", Theme.Layers.Hud)
	local tipRoot = makeLayer("GameTooltips", Theme.Layers.Tooltip)
	local winRoot = makeLayer("GameUI", Theme.Layers.Window)
	local notifyRoot = makeLayer("GameNotifications", Theme.Layers.Notification)
	local modalRoot = makeLayer("GameModal", Theme.Layers.Modal)

	backdrop = Create("TextButton", {
		Name = "Backdrop",
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = Theme.Colors.Black,
		BackgroundTransparency = 0.6,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		Parent = winRoot,
	})
	backdrop.Activated:Connect(function()
		if not Responsive.isMobile() then
			UIController.Close()
		end
	end)
	Kit.frame({ Name = "Windows", Size = UDim2.fromScale(1, 1), Parent = winRoot })

	local Tooltip = require(UI.Overlays.Tooltip)
	local Notifications = require(UI.Overlays.Notifications)
	local Modal = require(UI.Overlays.Modal)

	local tooltip = Tooltip.new(tipRoot)
	UIController.Tooltip = tooltip
	UIController.Notifications = Notifications.new(notifyRoot, function(key)
		UIController.sound(key)
	end)
	UIController.ModalDialog = Modal.new(modalRoot)

	Kit.hooks.Click = function()
		UIController.sound("Click")
	end
	Kit.hooks.Hover = function()
		UIController.sound("Hover")
	end
	Kit.hooks.ShowTooltip = function(text, anchor)
		tooltip:Show(text, anchor)
	end
	Kit.hooks.HideTooltip = function()
		tooltip:Hide()
	end

	Net.Notified:Connect(function(kind, text, extra)
		UIController.Notify(kind, text, extra)
	end)

	Responsive.Changed:Connect(function()
		for _, w in UIController.Windows do
			w:ApplySize()
		end
	end)

	-- Back / close inputs
	UserInputService.InputBegan:Connect(function(input, processed)
		if input.KeyCode == Enum.KeyCode.Escape then
			if UIController.ModalDialog:IsOpen() then
				return
			end
			if UIController.Current then
				local w = UIController.Windows[UIController.Current]
				if w and w.OnBack and w.OnBack() then
					return
				end
				UIController.Close()
			end
			return
		end
		if processed or UserInputService:GetFocusedTextBox() then
			return
		end
		local target = HOTKEYS[input.KeyCode]
		if target and not UIController.ModalDialog:IsOpen() then
			if UIController.WindowModules[target] then
				UIController.Toggle(target)
			end
		end
	end)

	ContextActionService:BindActionAtPriority("RAD_UIBack", function(_, state)
		if state ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if UIController.Current and not UIController.ModalDialog:IsOpen() then
			local w = UIController.Windows[UIController.Current]
			if not (w and w.OnBack and w.OnBack()) then
				UIController.Close()
			end
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, 3000, Enum.KeyCode.ButtonB)

	GuiService.MenuOpened:Connect(function()
		if UIController.Current then
			UIController.Close()
		end
	end)
end

return UIController
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000114">
					<Properties>
						<string name="Name">WildEggController</string>
						<ProtectedString name="Source"><![CDATA[--[[
	WildEggController
	Client side of the Lucky Wild Eggs (WildEggService / WildEggConfig):

	  * a headline "A MYTHIC EGG HAS SPAWNED!" for a few seconds, then a compact tracker
	    under the cash row: tier + luck, region / area, a countdown (02:00), an arrow that
	    points at the egg and the distance to it
	  * the egg itself (a server model with a tall pillar of light) bobs and spins and gets
	    a big label that can be read from far away
	  * flying / walking into it asks the server to claim it (first come first served);
	    a win flies the egg into your hand

	Net signals: "WildEggSpawn" info, "WildEggClaimed" { Player, Name, Luck }, "WildEggGone"
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local EggVisual = require(Shared:WaitForChild("EggVisual"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))
local WildEggConfig = require(Configs:WaitForChild("WildEggConfig"))

local UI = script.Parent.Parent:WaitForChild("UI")
local Theme = require(UI:WaitForChild("Theme"))
local Responsive = require(UI:WaitForChild("Responsive"))
local Kit = require(UI:WaitForChild("Kit"))
local Icons = require(UI:WaitForChild("Icons"))

local C = Theme.Colors
local LocalPlayer = Players.LocalPlayer

local WildEggController = {}

local registry
local holder: Frame? = nil
local ui: any = nil -- the tracker's elements
local info: any = nil -- the wild egg that is out right now
local pending = false
local lastClaim = -10
local lastFull = -10
local clock = 0
local labelled: Model? = nil
local preview = false -- UI Lab: no claiming, fake distance

-- ============================================================== layout
local function layout()
	if not holder then
		return
	end
	local R = Responsive
	local short = math.min(R.Width, R.Height)
	local top, w, h
	if R.Device == "Phone" then
		top = R.TopInset + short * 0.2
		if R.Portrait then
			w = R.Width * 0.94
			h = w * 0.2
		else
			h = short * 0.17
			w = h * 4.8
		end
	else
		top = R.TopInset + short * 0.145
		h = short * 0.095
		w = h * 5.6
	end
	holder.AnchorPoint = Vector2.new(0.5, 0)
	holder.Position = UDim2.new(0.5, 0, 0, math.floor(top))
	holder.Size = UDim2.fromOffset(math.floor(w), math.floor(h))
end

local function getHolder(): Frame?
	if holder and holder.Parent then
		return holder
	end
	local uic = registry and registry.UIController
	local layer = uic and uic.Layers and (uic.Layers.GameNotifications or uic.Layers.GameUI)
	if not layer then
		return nil
	end
	holder = Kit.frame({ Name = "WildEgg", Size = UDim2.fromOffset(300, 60), Parent = layer.Root })
	holder.ZIndex = 25
	holder.Visible = false
	layout()
	return holder
end

local function mmss(seconds: number): string
	seconds = math.max(0, math.floor(seconds + 0.5))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- ============================================================== tracker UI
local function build(data)
	local parent = getHolder()
	if not parent then
		return nil
	end
	local color: Color3 = data.Color
	local chip = Kit.surface({
		Name = "Chip",
		Size = UDim2.fromScale(1, 1),
		Color = C.Panel,
		Transparency = 0.06,
		StrokeColor = color,
		StrokeTransparency = 0.05,
		Radius = "Window",
		Parent = parent,
	})
	local stroke = chip:FindFirstChildWhichIsA("UIStroke")
	if stroke then
		stroke.Thickness = 3
	end
	-- egg disc (tier colour)
	local disc = Kit.frame({
		Name = "Disc",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.fromScale(0.025, 0.5),
		Size = UDim2.fromScale(0.74, 0.74),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		BackgroundColor3 = color:Lerp(Color3.new(0, 0, 0), 0.45),
		Parent = chip,
	})
	disc.BackgroundTransparency = 0
	Kit.corner(disc, "pill")
	local iconBox = Kit.frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.66, 0.66), Parent = disc })
	Icons.make("Egg", { Color = Color3.new(1, 1, 1), Accent = color }).Parent = iconBox
	-- title / place
	local texts = Kit.frame({ Name = "Texts", Position = UDim2.fromScale(0.2, 0.08), Size = UDim2.fromScale(0.38, 0.84), Parent = chip })
	local title = Kit.text({
		Name = "Title",
		Text = string.format("%s  x%d", data.Name, data.Luck),
		Role = "Heading",
		Scaled = true,
		MinTextSize = 9,
		Color = color,
		Size = UDim2.fromScale(1, 0.56),
		Truncate = true,
		Parent = texts,
	})
	local where = Kit.text({
		Name = "Where",
		Text = string.format("%s - %s", EggConfig.RegionNames[data.Region] or data.Region or "?", data.Area or "?"),
		Role = "Micro",
		Scaled = true,
		MinTextSize = 8,
		Color = C.TextMuted,
		Position = UDim2.fromScale(0, 0.58),
		Size = UDim2.fromScale(1, 0.4),
		Truncate = true,
		Parent = texts,
	})
	-- arrow (rotates towards the egg)
	local arrowHolder = Kit.frame({
		Name = "Arrow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.655, 0.5),
		Size = UDim2.fromScale(0.62, 0.62),
		SizeConstraint = Enum.SizeConstraint.RelativeYY,
		Parent = chip,
	})
	Icons.make("Ascend", { Color = Color3.new(1, 1, 1), Accent = color }).Parent = arrowHolder
	-- timer + distance
	local timer = Kit.text({
		Name = "Timer",
		Text = mmss(WildEggConfig.Lifetime),
		Role = "Title",
		Scaled = true,
		MinTextSize = 9,
		Color = Color3.new(1, 1, 1),
		XAlign = Enum.TextXAlignment.Center,
		Position = UDim2.fromScale(0.74, 0.08),
		Size = UDim2.fromScale(0.24, 0.5),
		Parent = chip,
	})
	local distance = Kit.text({
		Name = "Distance",
		Text = "",
		Role = "Micro",
		Scaled = true,
		MinTextSize = 8,
		Color = C.TextMuted,
		XAlign = Enum.TextXAlignment.Center,
		Position = UDim2.fromScale(0.74, 0.6),
		Size = UDim2.fromScale(0.24, 0.34),
		Parent = chip,
	})
	-- headline under the chip (first seconds only)
	local headline = Kit.text({
		Name = "Headline",
		Text = string.format("A %s HAS SPAWNED!", data.Name),
		Role = "Display",
		Scaled = true,
		MinTextSize = 12,
		Color = color,
		XAlign = Enum.TextXAlignment.Center,
		Position = UDim2.new(0, 0, 1, 6),
		Size = UDim2.fromScale(1, 0.62),
		Parent = parent,
	})
	headline.TextStrokeTransparency = 0.2
	headline.TextStrokeColor3 = Color3.fromRGB(14, 16, 24)
	local scale = Instance.new("UIScale")
	scale.Scale = 0.6
	scale.Parent = chip
	TweenService:Create(scale, TweenInfo.new(0.45, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(6, function()
		if headline.Parent then
			TweenService:Create(headline, TweenInfo.new(0.6), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
			task.delay(0.7, function()
				headline:Destroy()
			end)
		end
	end)
	return {
		Chip = chip,
		Headline = headline,
		Timer = timer,
		Distance = distance,
		Arrow = arrowHolder,
		Title = title,
		Where = where,
	}
end

local function clearUi()
	if holder then
		for _, c in holder:GetChildren() do
			c:Destroy()
		end
		holder.Visible = false
	end
	ui = nil
end

local function hide()
	info = nil
	pending = false
	labelled = nil
	clearUi()
end

-- ============================================================== the egg in the world
local function findModel(): Model?
	for _, m in CollectionService:GetTagged("WildEgg") do
		if m:IsA("Model") and m.Parent then
			return m
		end
	end
	return nil
end

local function label(model: Model)
	local shell = model.PrimaryPart
	if not shell or not info then
		return
	end
	local color: Color3 = info.Color
	local bb = Instance.new("BillboardGui")
	bb.Name = "WildEggLabel"
	bb.Size = UDim2.fromScale(15, 4.6)
	bb.StudsOffsetWorldSpace = Vector3.new(0, 7.5, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 6000
	bb.LightInfluence = 0
	bb.Parent = shell
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromScale(1, 0.55)
	name.Font = Enum.Font.GothamBlack
	name.TextScaled = true
	name.Text = info.Name
	name.TextColor3 = color
	name.TextStrokeTransparency = 0.2
	name.Parent = bb
	local luck = Instance.new("TextLabel")
	luck.BackgroundTransparency = 1
	luck.Position = UDim2.fromScale(0, 0.55)
	luck.Size = UDim2.fromScale(1, 0.45)
	luck.Font = Enum.Font.GothamBold
	luck.TextScaled = true
	luck.Text = "x" .. tostring(info.Luck) .. " LUCK"
	luck.TextColor3 = EggConfig.luckColor(info.Luck)
	luck.TextStrokeTransparency = 0.3
	luck.Parent = bb
end

local function myPositions(): ({ Vector3 }, number)
	local out = {}
	local slack = 0
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		table.insert(out, hrp.Position)
	end
	local dragons = Workspace:FindFirstChild("Dragons")
	local model = dragons and dragons:FindFirstChild("Dragon_" .. LocalPlayer.UserId)
	local root = model and model:FindFirstChild("Root") :: BasePart?
	if root then
		table.insert(out, root.Position)
		slack = ((model :: Model):GetAttribute("BodyRadius") or 0) * 0.5
		if (model :: Model):GetAttribute("RiderUserId") == LocalPlayer.UserId then
			slack += 6
		end
	end
	return out, slack
end

local function tryClaim()
	pending = true
	lastClaim = clock
	local data = info
	task.spawn(function()
		local res = Net.request("WildEgg", "Claim", {})
		pending = false
		local uic = registry.UIController
		if res.ok then
			hide()
			local held = registry.HeldEggController
			if held and res.data.Held and data then
				held.flyIn(res.data.Type, data.Position)
			end
			if uic then
				uic.Notify("rare", string.format("You got the %s!  (x%d LUCK)%s", res.data.Name or "EGG", res.data.Luck or 1, res.data.Held and "  -  in your hand" or ""))
			end
			local audio = registry.AudioController
			if audio then
				audio.playUI("LevelUp")
			end
		elseif res.err == "GONE" then
			hide()
		elseif res.err == "EGG_STORAGE_FULL" then
			if clock - lastFull > 6 and uic then
				lastFull = clock
				uic.Notify("warning", res.msg or "Your egg bag is full!")
			end
		end
	end)
end

-- ============================================================== per-frame
local function step(dt: number)
	clock += dt
	if not info or not ui then
		return
	end
	local now = Workspace:GetServerTimeNow()
	local left = info.EndsAt - now
	ui.Timer.Text = mmss(left)
	ui.Timer.TextColor3 = left <= 20 and C.Danger or Color3.new(1, 1, 1)
	-- egg model: bob + spin + label
	local model = findModel()
	if model and model.PrimaryPart then
		if labelled ~= model then
			labelled = model
			label(model)
		end
		local t = clock
		EggVisual.place(model, CFrame.new(info.Position + Vector3.new(0, math.sin(t * 2) * 0.7, 0)) * CFrame.Angles(0, t * 0.9, math.sin(t * 1.3) * 0.08))
	end
	-- distance + arrow
	local positions, slack = myPositions()
	local from = positions[1]
	local camera = Workspace.CurrentCamera
	if from then
		local d = (info.Position - from).Magnitude
		ui.Distance.Text = preview and "634 studs" or (d >= 1000 and string.format("%.1fk studs", d / 1000) or string.format("%d studs", math.floor(d)))
		if camera then
			local look = camera.CFrame.LookVector
			local forward = Vector3.new(look.X, 0, look.Z)
			local toEgg = Vector3.new(info.Position.X - from.X, 0, info.Position.Z - from.Z)
			if forward.Magnitude > 0.01 and toEgg.Magnitude > 0.5 then
				forward, toEgg = forward.Unit, toEgg.Unit
				-- clockwise degrees: positive = the egg is to the right
				ui.Arrow.Rotation = math.deg(math.atan2(-forward:Cross(toEgg).Y, forward:Dot(toEgg)))
			end
		end
	end
	-- grabbing it
	if preview or pending or clock - lastClaim < WildEggConfig.ClaimThrottle then
		return
	end
	local range = WildEggConfig.PickupRange * (1 + TreeConfig.bonus(registry.DataController.all(), "EggMagnet")) + slack
	for _, p in positions do
		if (p - info.Position).Magnitude <= range then
			tryClaim()
			break
		end
	end
end

-- ============================================================== events
local function show(data)
	if type(data) ~= "table" or type(data.EndsAt) ~= "number" or typeof(data.Position) ~= "Vector3" then
		return
	end
	hide()
	info = data
	if typeof(info.Color) ~= "Color3" then
		info.Color = Color3.fromRGB(255, 200, 80)
	end
	local parent = getHolder()
	if not parent then
		info = nil
		return
	end
	ui = build(info)
	parent.Visible = true
	local audio = registry.AudioController
	if audio then
		audio.playUI("RareHatch")
	end
end

function WildEggController.current()
	return info
end

-- UILab: a sample tracker (no claiming).
function WildEggController.preview()
	preview = true
	show({
		Id = "W0",
		Tier = "Mythic",
		Name = "MYTHIC EGG",
		Egg = "CelestialEgg",
		Luck = 320,
		Position = Vector3.new(500, 120, -400),
		Region = "Skyreach",
		Area = "Pillar",
		EndsAt = Workspace:GetServerTimeNow() + 102,
		Color = Color3.fromRGB(255, 80, 160),
	})
end

function WildEggController.clear()
	preview = false
	hide()
end

function WildEggController.Init(reg)
	registry = reg
end

function WildEggController.Start()
	Net.onSignal("WildEggSpawn", function(data)
		preview = false
		show(data)
	end)
	Net.onSignal("WildEggClaimed", function(data)
		if type(data) ~= "table" then
			return
		end
		if info and info.Id == data.Id then
			local mine = data.Player == LocalPlayer.DisplayName
			hide()
			local uic = registry.UIController
			if uic and not mine then
				uic.Notify("info", string.format("%s grabbed the %s!", tostring(data.Player), tostring(data.Name)))
			end
		end
	end)
	Net.onSignal("WildEggGone", function(data)
		if info and type(data) == "table" and info.Id == data.Id then
			hide()
			local uic = registry.UIController
			if uic then
				uic.Notify("warning", "The lucky egg vanished...")
			end
		end
	end)
	Responsive.Changed:Connect(layout)
	RunService.Heartbeat:Connect(step)
	-- an egg may already be out when this client starts
	task.spawn(function()
		local res = Net.request("WildEgg", "Sync", {})
		if res.ok and res.data and res.data.Current and not info then
			show(res.data.Current)
		end
	end)
end

return WildEggController
]]></ProtectedString>
					</Properties>
				</Item>
			</Item>
			<Item class="ModuleScript" referent="RBX000115">
				<Properties>
					<string name="Name">Diagnostics</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Diagnostics
	Test-build helper: script errors show up ON SCREEN (Roblox Studio only) so a tester can
	take a screenshot instead of digging in the Output window. Nothing is drawn while there
	is no error, and nothing at all in a live game.

	  Diagnostics.report(stage, name, err)   a failed boot step (Main.client): listed + warn()
	  Diagnostics.start()                    also lists client runtime errors (ScriptContext.Error)
	                                         and the errors the server published
	                                         (ReplicatedStorage attributes ServerBootErrors /
	                                         ServerErrors, written by Main.server)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Diagnostics = {}

local MAX_ROWS = 7
local MAX_LENGTH = 230

local entries: { { Key: string, Text: string, Count: number, Source: string } } = {}
local byKey: { [string]: any } = {}
local gui: ScreenGui? = nil
local body: Frame? = nil
local header: TextLabel? = nil
local dirty = false
local started = false
local hidden = false

local function enabled(): boolean
	return RunService:IsStudio()
end

local function firstLine(text: string): string
	local line = string.match(text, "^[^\n]*") or text
	if #line > MAX_LENGTH then
		line = string.sub(line, 1, MAX_LENGTH) .. "..."
	end
	return line
end

local function add(source: string, text: string)
	local line = firstLine(text)
	local key = source .. "|" .. line
	local found = byKey[key]
	if found then
		found.Count += 1
	else
		found = { Key = key, Text = line, Count = 1, Source = source }
		byKey[key] = found
		table.insert(entries, found)
		if #entries > 40 then
			local old = table.remove(entries, 1)
			byKey[old.Key] = nil
		end
	end
	dirty = true
end

-- ============================================================== panel
local function build()
	if gui and gui.Parent then
		return
	end
	local player = Players.LocalPlayer
	local playerGui = player and player:FindFirstChildOfClass("PlayerGui")
	if not playerGui then
		return
	end
	local screen = Instance.new("ScreenGui")
	screen.Name = "Diagnostics"
	screen.ResetOnSpawn = false
	screen.IgnoreGuiInset = true
	screen.DisplayOrder = 1000
	screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	screen.Parent = playerGui
	local panel = Instance.new("Frame")
	panel.Name = "Panel"
	panel.AnchorPoint = Vector2.new(0, 1)
	panel.Position = UDim2.new(0, 8, 1, -8)
	panel.Size = UDim2.new(0.62, 0, 0, 0)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.BackgroundColor3 = Color3.fromRGB(40, 8, 12)
	panel.BackgroundTransparency = 0.12
	panel.BorderSizePixel = 0
	panel.Parent = screen
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 8)
	corner.Parent = panel
	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(255, 90, 90)
	stroke.Thickness = 2
	stroke.Parent = panel
	local pad = Instance.new("UIPadding")
	pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 6), UDim.new(0, 6)
	pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
	pad.Parent = panel
	local list = Instance.new("UIListLayout")
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Padding = UDim.new(0, 3)
	list.Parent = panel
	local head = Instance.new("TextButton")
	head.Name = "Header"
	head.LayoutOrder = 0
	head.BackgroundTransparency = 1
	head.AutoButtonColor = false
	head.Size = UDim2.new(1, 0, 0, 20)
	head.Font = Enum.Font.GothamBlack
	head.TextSize = 15
	head.TextColor3 = Color3.fromRGB(255, 140, 140)
	head.TextXAlignment = Enum.TextXAlignment.Left
	head.Text = ""
	head.Parent = panel
	head.Activated:Connect(function()
		-- tap the header: clear the list
		table.clear(entries)
		table.clear(byKey)
		dirty = true
	end)
	local rows = Instance.new("Frame")
	rows.Name = "Rows"
	rows.LayoutOrder = 1
	rows.BackgroundTransparency = 1
	rows.Size = UDim2.new(1, 0, 0, 0)
	rows.AutomaticSize = Enum.AutomaticSize.Y
	rows.Parent = panel
	local rowList = Instance.new("UIListLayout")
	rowList.SortOrder = Enum.SortOrder.LayoutOrder
	rowList.Padding = UDim.new(0, 2)
	rowList.Parent = rows
	gui, body, header = screen, rows, head
end

local function refresh()
	dirty = false
	if not enabled() then
		return
	end
	if #entries == 0 then
		if gui then
			gui.Enabled = false
		end
		return
	end
	build()
	if not gui or not body or not header then
		return
	end
	gui.Enabled = not hidden
	local total = 0
	for _, e in entries do
		total += e.Count
	end
	header.Text = string.format("SCRIPT ERRORS (%d) - take a screenshot and send it  |  tap here to clear", total)
	for _, child in body:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	local first = math.max(1, #entries - MAX_ROWS + 1)
	for i = first, #entries do
		local e = entries[i]
		local row = Instance.new("TextLabel")
		row.Name = "Row" .. i
		row.LayoutOrder = i
		row.BackgroundTransparency = 1
		row.Size = UDim2.new(1, 0, 0, 0)
		row.AutomaticSize = Enum.AutomaticSize.Y
		row.Font = Enum.Font.Code
		row.TextSize = 13
		row.TextWrapped = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.TextYAlignment = Enum.TextYAlignment.Top
		row.TextColor3 = e.Source == "server" and Color3.fromRGB(255, 220, 140) or Color3.fromRGB(255, 255, 255)
		row.Text = string.format("[%s]%s %s", e.Source, e.Count > 1 and (" x" .. e.Count) or "", e.Text)
		row.Parent = body
	end
end

-- ============================================================== api
function Diagnostics.report(stage: string, name: string, err: any)
	add("client", string.format("%s %s: %s", stage, name, tostring(err)))
end

-- Errors collected so far (for tests / tools).
function Diagnostics.count(): number
	local n = 0
	for _, e in entries do
		n += e.Count
	end
	return n
end

function Diagnostics.entries()
	return entries
end

function Diagnostics.start()
	if started then
		return
	end
	started = true
	-- client runtime errors
	local ok, scriptContext = pcall(function()
		return game:GetService("ScriptContext")
	end)
	if ok and scriptContext then
		pcall(function()
			scriptContext.Error:Connect(function(message, _trace, source)
				add("client", (source and (source.Name .. ": ") or "") .. tostring(message))
			end)
		end)
	end
	-- what the server reports
	local function readServer()
		for _, attr in { "ServerBootErrors", "ServerErrors" } do
			local text = ReplicatedStorage:GetAttribute(attr)
			if type(text) == "string" and text ~= "" then
				for chunk in string.gmatch(text .. "\n---\n", "(.-)\n%-%-%-\n") do
					if chunk ~= "" then
						local key = "server|" .. firstLine(chunk)
						if not byKey[key] then
							add("server", chunk)
						end
					end
				end
			end
		end
	end
	readServer()
	for _, attr in { "ServerBootErrors", "ServerErrors" } do
		ReplicatedStorage:GetAttributeChangedSignal(attr):Connect(readServer)
	end
	task.spawn(function()
		while true do
			task.wait(0.5)
			if dirty then
				local fine, err = pcall(refresh)
				if not fine then
					warn("[Diagnostics] " .. tostring(err))
				end
			end
		end
	end)
	-- first paint (boot errors reported before start())
	pcall(refresh)
end

return Diagnostics
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX000116">
				<Properties>
					<string name="Name">Main</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Client bootstrap. Requires controllers in dependency order, wires the UI
	(windows + HUD), then starts everything.

	Every step runs in its own protected call: a controller or window that fails is reported
	(Output + the red error panel of Diagnostics in Studio) and everything else keeps working -
	one broken script must never take the whole client down.
]]

local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")

local okDiagnostics, Diagnostics = pcall(function()
	return require(script.Parent:WaitForChild("Diagnostics"))
end)

local function fail(stage: string, name: string, err: any)
	warn(string.format("[Boot] %s %s failed: %s", stage, name, tostring(err)))
	if okDiagnostics then
		pcall(Diagnostics.report, stage, name, err)
	end
end

-- Runs fn(...) protected. Returns ok, first result.
local function try(stage: string, name: string, fn: any, ...: any): (boolean, any)
	local ok, result = xpcall(fn, function(e)
		return tostring(e) .. "\n" .. debug.traceback("", 2)
	end, ...)
	if not ok then
		fail(stage, name, result)
		return false, nil
	end
	return true, result
end

local ORDER = {
	"DataController",
	"AudioController",
	"UIController",
	"GraphicsController",
	"SettingsController",
	"InputController",
	"CameraController",
	"AnimationController",
	"DragonController",
	"BondController",
	"InteractionController",
	"EggController",
	"HeldEggController",
	"SanctuaryController",
	"PerchController",
	"TitleController",
	"SpinController",
	"TreeController",
	"HatchController",
	"AnnounceController",
	"WildEggController",
	"InventoryController",
	"TutorialController",
	"RegionController",
	"StreamingController",
	"WorldFXController",
}

local registry = {}
for _, name in ORDER do
	local module = Controllers:FindFirstChild(name)
	if module then
		local ok, controller = try("require", name, require, module)
		if ok then
			registry[name] = controller
		end
	end
end

for _, name in ORDER do
	local controller = registry[name]
	if controller and controller.Init then
		try("Init", name, controller.Init, registry)
	end
end

-- Windows (built lazily on first open)
local uic = registry.UIController
local Windows = UI:WaitForChild("Windows")
if uic then
	for _, module in Windows:GetChildren() do
		if module:IsA("ModuleScript") then
			local name = string.gsub(module.Name, "Window$", "")
			local ok, window = try("require", module.Name, require, module)
			if ok then
				try("RegisterWindow", module.Name, uic.RegisterWindow, name, window)
			end
		end
	end
end

-- HUD
local okHud, Hud = try("require", "Hud", function()
	return require(UI:WaitForChild("Hud"):WaitForChild("Hud"))
end)
if okHud and Hud and uic then
	local ok, hud = try("new", "Hud", Hud.new, uic, registry)
	if ok then
		registry.Hud = hud
	end
end

-- Developer UI test harness (Studio / owner only)
try("Init", "UILab", function()
	require(UI:WaitForChild("Dev"):WaitForChild("UILab")).Init(uic, registry)
end)

for _, name in ORDER do
	local controller = registry[name]
	if controller and controller.Start then
		task.spawn(try, "Start", name, controller.Start)
	end
end

if okDiagnostics then
	pcall(Diagnostics.start)
end
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX000117">
				<Properties>
					<string name="Name">UI</string>
				</Properties>
				<Item class="Folder" referent="RBX000118">
					<Properties>
						<string name="Name">Components</string>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000119">
					<Properties>
						<string name="Name">Create</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Create
	Declarative Instance builder.

	Create("Frame", {
		Size = UDim2.fromScale(1, 1),
		[Create.Event.Activated] = function() ... end,
		[Create.Changed.AbsoluteSize] = function() ... end,
	}, { child1, child2 })
]]

local Create = {}

local eventKeys = {}
local changedKeys = {}

Create.Event = setmetatable({}, {
	__index = function(_, name)
		local key = eventKeys[name]
		if not key then
			key = { __kind = "event", name = name }
			eventKeys[name] = key
		end
		return key
	end,
})

Create.Changed = setmetatable({}, {
	__index = function(_, name)
		local key = changedKeys[name]
		if not key then
			key = { __kind = "changed", name = name }
			changedKeys[name] = key
		end
		return key
	end,
})

local function build(className: string, props: { [any]: any }?, children: { Instance }?)
	local inst = Instance.new(className)
	local parent = nil
	if props then
		for k, v in props do
			if k == "Parent" then
				parent = v
			elseif type(k) == "table" then
				if k.__kind == "event" then
					(inst :: any)[k.name]:Connect(v)
				elseif k.__kind == "changed" then
					inst:GetPropertyChangedSignal(k.name):Connect(v)
				end
			else
				(inst :: any)[k] = v
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = inst
		end
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

setmetatable(Create, {
	__call = function(_, className, props, children)
		return build(className, props, children)
	end,
})

return Create
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="Folder" referent="RBX000120">
					<Properties>
						<string name="Name">Dev</string>
					</Properties>
					<Item class="ModuleScript" referent="RBX000121">
						<Properties>
							<string name="Name">UIChecks</string>
							<ProtectedString name="Source"><![CDATA[--[[
	UIChecks
	Automated layout QA used by the Dev UI Lab (and the offline test runner).
	Detects: clipped text, off-screen elements, overlapping HUD/QA regions,
	microscopic text, too-small touch targets, oversized/undersized windows.
	All measurements are converted to the (virtual) screen's pixel space.
]]

local UIChecks = {}

local function isVisible(g: GuiObject): boolean
	local node: Instance? = g
	while node do
		if node:IsA("GuiObject") and not (node :: GuiObject).Visible then
			return false
		end
		if node:IsA("LayerCollector") then
			return (node :: LayerCollector).Enabled
		end
		node = node.Parent
	end
	return false
end

local function rectOf(g: GuiObject, origin: Vector2, k: number)
	local p = (g.AbsolutePosition - origin) / k
	local s = g.AbsoluteSize / k
	return p.X, p.Y, s.X, s.Y
end

-- Visible window of `g`: the intersection of EVERY clipping ancestor (nested scroll frames
-- clip each other). nil when nothing clips it; width/height <= 0 when nothing is visible.
local function clipRect(g: GuiObject, origin: Vector2, k: number): (number?, number?, number?, number?)
	local x0, y0, x1, y1 = -math.huge, -math.huge, math.huge, math.huge
	local found = false
	local node = g.Parent
	while node and node:IsA("GuiObject") do
		if node:IsA("ScrollingFrame") or (node :: GuiObject).ClipsDescendants then
			local cx, cy, cw, ch = rectOf(node :: GuiObject, origin, k)
			x0, y0 = math.max(x0, cx), math.max(y0, cy)
			x1, y1 = math.min(x1, cx + cw), math.min(y1, cy + ch)
			found = true
		end
		node = node.Parent
	end
	if not found then
		return nil
	end
	return x0, y0, x1 - x0, y1 - y0
end

local function overlap(a, b): number
	local x0 = math.max(a[1], b[1])
	local y0 = math.max(a[2], b[2])
	local x1 = math.min(a[1] + a[3], b[1] + b[3])
	local y1 = math.min(a[2] + a[4], b[2] + b[4])
	if x1 <= x0 or y1 <= y0 then
		return 0
	end
	return (x1 - x0) * (y1 - y0)
end

-- roots: list of layer Root frames (all share the same screen rect)
-- opts: { Device = "Desktop"|"Tablet"|"Phone", Window = GuiObject? }
function UIChecks.run(roots: { Frame }, opts: { [string]: any })
	local issues = {}
	local function add(kind: string, msg: string)
		table.insert(issues, { Kind = kind, Message = msg })
	end
	local main = roots[1]
	local scale = main:FindFirstChildOfClass("UIScale")
	local k = scale and scale.Scale or 1
	local origin = main.AbsolutePosition
	local W, H = main.AbsoluteSize.X / k, main.AbsoluteSize.Y / k
	local regions = {}

	for _, root in roots do
		for _, d in root:GetDescendants() do
			if not d:IsA("GuiObject") or not isVisible(d) then
				continue
			end
			local x, y, w, h = rectOf(d, origin, k)
			local name = d:GetFullName()
			local cx, cy, cw, ch = clipRect(d, origin, k)
			local clipped = false
			local vx, vy, vw, vh = x, y, w, h
			if cx then
				if cw < 1 or ch < 1 or x + w < cx - 1 or y + h < cy - 1 or x > cx + cw + 1 or y > cy + ch + 1 then
					clipped = true -- intentionally scrolled/clipped out of view
				else
					-- only the part inside the clipping ancestors is visible
					local x0, y0 = math.max(x, cx), math.max(y, cy)
					local x1, y1 = math.min(x + w, cx + cw), math.min(y + h, cy + ch)
					vx, vy, vw, vh = x0, y0, x1 - x0, y1 - y0
				end
			end
			if not clipped and vw > 1 and vh > 1 then
				if vx < -2 or vy < -2 or vx + vw > W + 2 or vy + vh > H + 2 then
					if not d:GetAttribute("QAAllowOffscreen") then
						add("Offscreen", string.format("%s at (%d,%d %dx%d) leaves the %dx%d screen", name, vx, vy, vw, vh, W, H))
					end
				end
			end
			if (d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox")) and not clipped then
				local text = d.Text
				if text ~= "" and w > 0 then
					if not d.TextFits and d.TextTruncate == Enum.TextTruncate.None and not d.TextScaled then
						add("ClippedText", string.format("%s text '%s' does not fit (%dx%d)", name, string.sub(text, 1, 24), w, h))
					end
					local size = d.TextScaled and d.TextBounds.Y or d.TextSize
					if size > 0 and size < 9 then
						add("TinyText", string.format("%s text size %d px", name, size))
					end
				end
			end
			if opts.Device ~= "Desktop" and d:IsA("GuiButton") and not clipped and d.Active then
				if (w < 36 or h < 30) and not d:GetAttribute("QASmallOk") then
					add("TouchTarget", string.format("%s is %dx%d (too small to tap)", name, w, h))
				end
			end
			local region = d:GetAttribute("QARegion")
			if region then
				table.insert(regions, { x, y, w, h, region })
			end
		end
	end
	for i = 1, #regions do
		for j = i + 1, #regions do
			local a, b = regions[i], regions[j]
			local area = overlap(a, b)
			if area > 4 then
				add("Overlap", string.format("%s overlaps %s (%d px^2)", a[5], b[5], area))
			end
		end
	end
	if opts.Window then
		local _, _, w, h = rectOf(opts.Window, origin, k)
		local fw, fh = w / W, h / H
		if opts.Device == "Desktop" then
			if fw > 0.8 or fh > 0.9 then
				add("WindowSize", string.format("window covers %.0f%% x %.0f%% of the screen (too large)", fw * 100, fh * 100))
			elseif fw < 0.25 and fh < 0.3 then
				add("WindowSize", string.format("window covers only %.0f%% x %.0f%% (too small)", fw * 100, fh * 100))
			end
		end
	end
	return issues
end

function UIChecks.format(issues): string
	if #issues == 0 then
		return "PASS"
	end
	local lines = {}
	for _, i in issues do
		table.insert(lines, "[" .. i.Kind .. "] " .. i.Message)
	end
	return table.concat(lines, "\n")
end

return UIChecks
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX000122">
						<Properties>
							<string name="Name">UILab</string>
							<ProtectedString name="Source"><![CDATA[--[[
	UILab (developer UI test harness) - Studio / place owner only.
	Toggle with the ` (backquote) key.

	- Preview the whole UI at any resolution/device (virtual screen, scaled
	  to fit your Studio window): 1280x720 ... 3840x2160, phones, tablet
	- Jump to any screen: HUD, Inventory, Details, Shop, Egg Storage, Hatch
	  Reveal, Index, Settings, Quests, Daily, Confirmation, Notifications
	- RUN CHECKS: automated layout QA on the current view
	- RUN ALL: every resolution x every screen, report printed to Output
	- TEST: Studio-only playtest helpers (+$1M, +5 dragons, fill the egg
	  bag, finish incubation) - served by DevService, absent on live servers
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local UI = script.Parent.Parent
local Responsive = require(UI.Responsive)
local UIChecks = require(script.Parent.UIChecks)

local UILab = {}

UILab.Resolutions = {
	{ "Native", nil },
	{ "1280x720", { 1280, 720 } },
	{ "1366x768", { 1366, 768 } },
	{ "1600x900", { 1600, 900 } },
	{ "1920x1080", { 1920, 1080 } },
	{ "1920x1200", { 1920, 1200 } },
	{ "2560x1440", { 2560, 1440 } },
	{ "2560x1600", { 2560, 1600 } },
	{ "3440x1440", { 3440, 1440 } },
	{ "3840x2160", { 3840, 2160 } },
	{ "Phone L", { 844, 390, "Phone" } },
	{ "Phone P", { 390, 844, "Phone" } },
	{ "Tablet", { 1180, 820, "Tablet" } },
}

UILab.Screens = { "HUD", "HeldEgg", "RareBanner", "WildEgg", "Riding", "Inventory", "Details", "Shop", "Tree", "EggStorage", "Hatch", "Index", "Settings", "Quests", "Daily", "Confirm", "Notifications" }

local ui = nil
local registry = nil
local panel: ScreenGui? = nil
local output: TextLabel? = nil

function UILab.setResolution(spec)
	if spec == nil then
		Responsive.clearVirtual()
	else
		Responsive.setVirtual(spec[1], spec[2], spec[3], spec[3] ~= nil)
	end
end

function UILab.reset()
	if ui.ModalDialog:IsOpen() then
		ui.ModalDialog:_answer(false)
	end
	if ui.Current then
		ui.Close()
	end
	local hatch = registry.HatchController
	if hatch and hatch.closePreview then
		hatch.closePreview()
	end
	ui.Notifications:Clear()
	local hud = registry.Hud
	if hud and hud._labRiding then
		hud._labRiding = false
		hud:SetRiding(false)
	end
	if hud and hud._labHeld then
		hud._labHeld = false
		hud:SetHeldEgg(nil)
	end
	local announce = registry.AnnounceController
	if announce then
		announce.clear()
	end
	local wild = registry.WildEggController
	if wild then
		wild.clear()
	end
end

function UILab.show(screen: string)
	UILab.reset()
	task.wait(0.2)
	if screen == "HUD" then
		return nil
	elseif screen == "HeldEgg" then
		-- HUD with an egg in your hand (chip above the dragon card)
		local hud = registry.Hud
		if hud then
			hud._labHeld = true
			hud:SetHeldEgg({ Id = "E_lab", Type = "GroveEgg", Name = "Grove Egg", Luck = 12, Glow = Color3.fromRGB(120, 220, 120) })
		end
		return nil
	elseif screen == "WildEgg" then
		-- Lucky Wild Egg tracker (headline + countdown + arrow + distance)
		local wild = registry.WildEggController
		if wild then
			wild.preview()
		end
		return nil
	elseif screen == "RareBanner" then
		-- server-wide ultra-rare hatch banner (mega variant: the biggest one)
		local announce = registry.AnnounceController
		if announce then
			announce.preview(true)
		end
		return nil
	elseif screen == "Riding" then
		-- HUD while mounted: ride panel (desktop) / touch cluster (mobile)
		local hud = registry.Hud
		if hud then
			hud._labRiding = true
			hud:SetRiding(true)
			hud:SetRideMode("Fly")
			hud:SetFlightStats(124, 0.62, false)
		end
		return nil
	elseif screen == "Details" then
		ui.Open("Inventory", { SelectFirst = true, ShowDetails = true })
		return "Inventory"
	elseif screen == "Hatch" then
		local hatch = registry.HatchController
		if hatch and hatch.previewResult then
			hatch.previewResult()
		end
		return nil
	elseif screen == "Confirm" then
		task.spawn(function()
			ui.Confirm({ Title = "Release Inferno Dragon?", Body = "This cannot be undone.", ConfirmText = "Release", Danger = true })
		end)
		return nil
	elseif screen == "Notifications" then
		ui.Notify("success", "Dragon equipped")
		ui.Notify("egg", "Egg found: Haven Egg")
		ui.Notify("error", "Not enough cash")
		ui.Notify("rare", "Legendary dragon hatched!")
		return nil
	else
		if ui.WindowModules[screen] then
			ui.Open(screen)
			return screen
		end
	end
	return nil
end

function UILab.check(windowName: string?)
	local roots = {}
	for _, layerName in { "GameHUD", "GameUI", "GameNotifications", "GameModal", "GameTooltips" } do
		local l = ui.Layers[layerName]
		if l then
			table.insert(roots, l.Root)
		end
	end
	local window = windowName and ui.Windows[windowName] and ui.Windows[windowName].Root or nil
	return UIChecks.run(roots, { Device = Responsive.Device, Window = window })
end

function UILab.runAll(screens: { string }?, resolutions: { any }?)
	local report = {}
	local failures = 0
	for _, res in resolutions or UILab.Resolutions do
		if res[2] == nil then
			continue
		end
		UILab.setResolution(res[2])
		task.wait(0.15)
		for _, screen in screens or UILab.Screens do
			local w = UILab.show(screen)
			task.wait(0.45)
			local issues = UILab.check(w)
			if #issues > 0 then
				failures += #issues
				table.insert(report, string.format("%-10s %-14s FAIL\n%s", res[1], screen, UIChecks.format(issues)))
			else
				table.insert(report, string.format("%-10s %-14s PASS", res[1], screen))
			end
		end
	end
	UILab.reset()
	UILab.setResolution(nil)
	local text = table.concat(report, "\n")
	print("===== UI LAB REPORT =====\n" .. text .. "\n===== " .. failures .. " issue(s) =====")
	return failures, text
end

local function enabled(): boolean
	if RunService:IsStudio() then
		return true
	end
	local player = Players.LocalPlayer
	return game.CreatorId ~= 0 and player.UserId == game.CreatorId
end

local function buildPanel()
	local gui = Instance.new("ScreenGui")
	gui.Name = "RAD_UILab"
	gui.ResetOnSpawn = false
	gui.DisplayOrder = 400
	gui.IgnoreGuiInset = true
	gui.Enabled = false
	local frame = Instance.new("Frame")
	frame.Name = "Panel"
	frame.BackgroundColor3 = Color3.fromRGB(14, 16, 20)
	frame.BackgroundTransparency = 0.05
	frame.BorderSizePixel = 0
	frame.Position = UDim2.new(0, 12, 0, 70)
	frame.Size = UDim2.new(0, 330, 0, 640)
	frame.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame
	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 6)
	list.SortOrder = Enum.SortOrder.LayoutOrder
	list.Parent = frame
	local pad = Instance.new("UIPadding")
	pad.PaddingTop = UDim.new(0, 10)
	pad.PaddingLeft = UDim.new(0, 10)
	pad.PaddingRight = UDim.new(0, 10)
	pad.Parent = frame
	local order = 0
	local function label(text: string, h: number)
		order += 1
		local t = Instance.new("TextLabel")
		t.BackgroundTransparency = 1
		t.Size = UDim2.new(1, 0, 0, h)
		t.Font = Enum.Font.GothamBold
		t.TextSize = 13
		t.TextColor3 = Color3.fromRGB(240, 220, 170)
		t.TextXAlignment = Enum.TextXAlignment.Left
		t.Text = text
		t.LayoutOrder = order
		t.Parent = frame
		return t
	end
	local function grid(items, onClick)
		order += 1
		local g = Instance.new("Frame")
		g.BackgroundTransparency = 1
		g.Size = UDim2.new(1, 0, 0, math.ceil(#items / 3) * 30)
		g.LayoutOrder = order
		g.Parent = frame
		local gl = Instance.new("UIGridLayout")
		gl.CellSize = UDim2.new(0.333, -4, 0, 26)
		gl.CellPadding = UDim2.new(0, 4, 0, 4)
		gl.SortOrder = Enum.SortOrder.LayoutOrder
		gl.Parent = g
		for i, item in items do
			local b = Instance.new("TextButton")
			b.Text = item
			b.Font = Enum.Font.GothamMedium
			b.TextSize = 12
			b.TextColor3 = Color3.fromRGB(240, 236, 226)
			b.BackgroundColor3 = Color3.fromRGB(40, 44, 54)
			b.BorderSizePixel = 0
			b.LayoutOrder = i
			b.Parent = g
			b.Activated:Connect(function()
				onClick(i, item)
			end)
		end
	end
	label("UI LAB  (` to hide)", 20)
	label("RESOLUTION", 16)
	local resNames = {}
	for _, r in UILab.Resolutions do
		table.insert(resNames, r[1])
	end
	grid(resNames, function(i)
		UILab.setResolution(UILab.Resolutions[i][2])
	end)
	label("SCREEN", 16)
	grid(UILab.Screens, function(_, screen)
		task.spawn(UILab.show, screen)
	end)
	label("QA", 16)
	grid({ "RUN CHECKS", "RUN ALL", "NATIVE" }, function(i)
		if i == 1 then
			local w = ui.Current
			local issues = UILab.check(w)
			local text = UIChecks.format(issues)
			print("[UI LAB] " .. Responsive.Width .. "x" .. Responsive.Height .. " " .. tostring(w or "HUD") .. ":\n" .. text)
			if output then
				output.Text = (#issues == 0 and "PASS" or (#issues .. " issue(s) - see Output")) .. "\n" .. string.sub(text, 1, 400)
			end
		elseif i == 2 then
			task.spawn(function()
				if output then
					output.Text = "Running all resolutions x screens..."
				end
				local failures = UILab.runAll()
				if output then
					output.Text = failures == 0 and "ALL PASS" or (failures .. " issue(s) - see Output")
				end
			end)
		else
			UILab.setResolution(nil)
		end
	end)
	label("TEST (Studio only)", 16)
	grid({ "+$1M", "ALL 30 DRAGONS", "FILL EGGS", "HATCH NOW", "WILD EGG", "BOND MAX", "MEGA BANNER" }, function(i)
		local actions = { "Cash", "Dragons", "Eggs", "HatchNow", "WildEgg", "BondMax", "Banner" }
		task.spawn(function()
			local Net = require(game:GetService("ReplicatedStorage").Shared.Net)
			local res = Net.request("Dev", actions[i], {})
			ui.HandleResult(res, res.ok and ({ "+$1,000,000", "+5 dragons", "Egg bag filled", "Eggs are ready to hatch", "A wild egg appeared!", "Bond level 50 - try Q / E / Z", "Banner sent" })[i] or nil)
		end)
	end)
	output = label("", 120)
	output.TextWrapped = true
	output.TextYAlignment = Enum.TextYAlignment.Top
	output.Font = Enum.Font.Code
	output.TextSize = 12
	gui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
	return gui
end

function UILab.Init(uiController, reg)
	ui = uiController
	registry = reg
	if not enabled() then
		return
	end
	panel = buildPanel()
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Backquote and panel then
			panel.Enabled = not panel.Enabled
		end
	end)
end

return UILab
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="ModuleScript" referent="RBX000123">
					<Properties>
						<string name="Name">Fade</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Fade
	Opacity fade for a whole GUI subtree without CanvasGroup (CanvasGroups
	cannot host ViewportFrames reliably). Captures each element's own
	transparency values, then drives them by a single alpha.

	local state = Fade.capture(root)
	Fade.apply(state, 0.5)   -- 0 = invisible, 1 = original look
	Fade.restore(state)
]]

local Fade = {}

local PROPS = {
	Frame = { "BackgroundTransparency" },
	TextLabel = { "BackgroundTransparency", "TextTransparency", "TextStrokeTransparency" },
	TextButton = { "BackgroundTransparency", "TextTransparency", "TextStrokeTransparency" },
	TextBox = { "BackgroundTransparency", "TextTransparency" },
	ImageLabel = { "BackgroundTransparency", "ImageTransparency" },
	ImageButton = { "BackgroundTransparency", "ImageTransparency" },
	ViewportFrame = { "BackgroundTransparency", "ImageTransparency" },
	ScrollingFrame = { "BackgroundTransparency", "ScrollBarImageTransparency" },
	UIStroke = { "Transparency" },
}

function Fade.capture(root: Instance)
	local entries = {}
	local function add(inst: Instance)
		local props = PROPS[inst.ClassName]
		if props then
			for _, prop in props do
				local base = (inst :: any)[prop]
				if base < 1 then
					table.insert(entries, { inst, prop, base })
				end
			end
		end
	end
	add(root)
	for _, d in root:GetDescendants() do
		add(d)
	end
	return { entries = entries }
end

function Fade.apply(state, alpha: number)
	alpha = math.clamp(alpha, 0, 1)
	for _, e in state.entries do
		local inst = e[1]
		if inst.Parent then
			(inst :: any)[e[2]] = 1 - (1 - e[3]) * alpha
		end
	end
end

function Fade.restore(state)
	Fade.apply(state, 1)
end

return Fade
]]></ProtectedString>
					</Properties>
