function Hud:SetObjective(text: string?, hint: string?, caption: string?)
	if not text or text == "" then
		self.Objective.Visible = false
		return
	end
	self.Objective.Visible = true
	self.ObjectiveText.Text = text
	self.ObjectiveHint.Text = hint or ""
	self.ObjectiveCaption.Text = caption or "OBJECTIVE"
end

function Hud:SetObjectiveDistance(studs: number?)
	if studs then
		self.ObjectiveDistance.Text = tostring(math.floor(studs * 0.28 + 0.5)) .. " M"
	else
		self.ObjectiveDistance.Text = ""
	end
end

-- ============================================================== layout
function Hud:Layout()
	local R = Responsive
	local S = short()
	local margin = math.floor(S * (R.Device == "Phone" and 0.03 or 0.022) + 0.5)
	local top = R.TopInset + math.floor(S * 0.012)
	local phone = R.Device == "Phone"
	local portrait = R.Portrait

	-- level (top-left, below the Roblox top bar)
	self.LevelRoot.Position = UDim2.new(0, margin, 0, top)
	shortSize(self.LevelRoot, phone and 0.36 or 0.235, phone and 0.095 or 0.058)

	-- cash (top-center)
	self.CashRoot.Position = UDim2.new(0.5, 0, 0, phone and (portrait and top + math.floor(S * 0.12) or math.floor(S * 0.03)) or math.floor(S * 0.022))
	shortSize(self.CashRoot, phone and 0.6 or 0.5, phone and 0.15 or 0.105)

	-- side buttons
	local btnH = phone and 0.15 or 0.074
	local gap = math.floor(S * (phone and 0.02 or 0.012))
	self.LeftList.Padding = UDim.new(0, gap)
	self.RightList.Padding = UDim.new(0, gap)
	for _, b in self.Buttons do
		-- square-ish button filling the column width (column is sized from the short side)
		b.Instance.SizeConstraint = Enum.SizeConstraint.RelativeXX
		b.Instance.Size = UDim2.fromScale(1, 1)
	end
	for _, b in self.MoreButtons do
		b.Instance.SizeConstraint = Enum.SizeConstraint.RelativeYY
		b.Instance.Size = UDim2.fromScale(1, 1)
	end
	if phone then
		-- right edge, upper half: Dragons, Shop, More (hidden while riding:
		-- the thumb area belongs to the riding controls)
		self.LeftColumn.Visible = false
		self.RightColumn.Visible = not self.Riding
		for _, def in LEFT_BUTTONS do
			self.Buttons[def.Id].Instance.Visible = def.Id == "Inventory"
		end
		for _, def in RIGHT_BUTTONS do
			self.Buttons[def.Id].Instance.Visible = def.Id == "Shop"
		end
		for i, id in PHONE_BUTTONS do
			local b = self.Buttons[id].Instance
			b.Parent = self.RightColumn
			b.LayoutOrder = i
			b.Visible = true
		end
		self.RightColumn.AnchorPoint = Vector2.new(1, 0)
		self.RightColumn.Position = UDim2.new(1, -margin, 0, portrait and top + math.floor(S * 0.35) or top + math.floor(S * 0.04))
		self.RightList.VerticalAlignment = Enum.VerticalAlignment.Top
		shortSize(self.RightColumn, btnH * 0.95, btnH * 3 + 0.06)
		-- More popover sits to the left of the column
		self.MorePopover.Position = UDim2.new(1, -(margin + math.floor(S * btnH * 0.92) + gap), 0, self.RightColumn.Position.Y.Offset + math.floor(S * (btnH * 2 + 0.04)))
		shortSize(self.MorePopover, btnH * #MORE_ITEMS + 0.02 * #MORE_ITEMS, btnH + 0.035)
	else
		self.LeftColumn.Visible = true
		self.RightColumn.Visible = true
		for _, def in LEFT_BUTTONS do
			local b = self.Buttons[def.Id].Instance
			b.Parent = self.LeftColumn
			b.Visible = true
		end
		for i, def in RIGHT_BUTTONS do
			local b = self.Buttons[def.Id].Instance
			b.Parent = self.RightColumn
			b.LayoutOrder = i
			b.Visible = true
		end
		self.Buttons.Inventory.Instance.LayoutOrder = 1
		self.Buttons.Shop.Instance.LayoutOrder = 1
		self.Buttons.More.Instance.Visible = false
		self.MorePopover.Visible = false
		self.LeftColumn.AnchorPoint = Vector2.new(0, 0.5)
		self.LeftColumn.Position = UDim2.new(0, margin, 0.5, 0)
		self.RightColumn.AnchorPoint = Vector2.new(1, 0.5)
		self.RightColumn.Position = UDim2.new(1, -margin, 0.5, 0)
		self.RightList.VerticalAlignment = Enum.VerticalAlignment.Center
		shortSize(self.LeftColumn, btnH * 0.95, btnH * #LEFT_BUTTONS + 0.017 * #LEFT_BUTTONS)
		shortSize(self.RightColumn, btnH * 0.95, btnH * 3 + 0.05)
	end

	-- current dragon (bottom-center)
	if phone then
		self.DragonCard.AnchorPoint = Vector2.new(0.5, 0)
		if portrait then
			self.DragonCard.Position = UDim2.new(0.5, 0, 0, top + math.floor(S * 0.27))
		else
			self.DragonCard.Position = UDim2.new(0.5, 0, 0, math.floor(S * 0.03) + math.floor(S * 0.17))
		end
		shortSize(self.DragonCard, 0.62, 0.115)
		self.DragonCard.Visible = not self.Riding
	else
		self.DragonCard.AnchorPoint = Vector2.new(0.5, 1)
		self.DragonCard.Position = UDim2.new(0.5, 0, 1, -margin)
		shortSize(self.DragonCard, 0.44, 0.082)
		-- touch devices ride with the touch cluster bottom-right instead
		self.DragonCard.Visible = not (self.Riding and R.isMobile())
	end

	-- egg in hand: above the dragon card (phones: right below it)
	if phone then
		self.HeldCard.AnchorPoint = Vector2.new(0.5, 0)
		self.HeldCard.Position = UDim2.new(0.5, 0, 0, self.DragonCard.Position.Y.Offset + math.floor(S * 0.115) + math.floor(S * 0.012))
		shortSize(self.HeldCard, 0.62, 0.1)
	else
		self.HeldCard.AnchorPoint = Vector2.new(0.5, 1)
		self.HeldCard.Position = UDim2.new(0.5, 0, 1, -(margin + math.floor(S * 0.082) + math.floor(S * 0.012)))
		shortSize(self.HeldCard, 0.4, 0.07)
	end
	self.HeldCard.Visible = self.HeldInfo ~= nil and not self.Riding

	self.RideKey.Visible = not R.isMobile()
	self.XPText.Visible = not phone
	local iconHolder = self.RideButton.IconHolder
	if iconHolder then
		iconHolder.Visible = R.isMobile()
	end

	-- ride panel (bottom-right)
	self.RidePanel.Position = UDim2.new(1, -margin, 1, -margin)
	shortSize(self.RidePanel, 0.22, 0.105)
	self.RidePanel.Visible = (self.Riding == true) and not R.isMobile()
	-- bond bar: right above the ride panel (desktop)
	self.BondBar.AnchorPoint = Vector2.new(1, 1)
	self.BondBar.Position = UDim2.new(1, -margin, 1, -(margin + math.floor(S * 0.105) + math.floor(S * 0.012)))
	shortSize(self.BondBar, 0.26, 0.092)
	self.BondBar.Visible = (self.Riding == true) and not R.isMobile()
	self.Mobile:Layout()
	self.Mobile:SetVisible(self.Riding == true)

	-- objective tracker
	if phone then
		self.Objective.AnchorPoint = Vector2.new(0, 0)
		self.Objective.Position = UDim2.new(0, margin, 0, top + math.floor(S * (portrait and 0.11 or 0.11)))
		shortSize(self.Objective, portrait and 0.6 or 0.5, 0.13)
	else
		self.Objective.AnchorPoint = Vector2.new(1, 0)
		self.Objective.Position = UDim2.new(1, -margin, 0, top)
		shortSize(self.Objective, 0.33, 0.082)
	end
end

-- ============================================================== data
function Hud:RefreshEquipped()
	local data = self.Data.all()
	if not data then
		return
	end
	local uid = data.EquippedDragon
	local record = uid ~= "" and data.Dragons[uid] or nil
	if record then
		local rarity = DragonConfig.Rarities[record.Rarity]
		self.DragonName.Text = record.Name
		self.DragonLevel.Text = Format.level(record.Level)
		self.DragonSpeed.Text = Format.abbreviate(record.FlightSpeed)
		self.PortraitStroke.Color = rarity and rarity.Color or C.Gold
		self.DragonName.TextColor3 = H.Text
		self.RideButton:SetEnabled(true)
	else
		self.DragonName.Text = "No dragon equipped"
		self.DragonName.TextColor3 = H.TextMuted
		self.DragonLevel.Text = "-"
		self.DragonSpeed.Text = "0"
		self.RideButton:SetEnabled(false)
	end
end

function Hud:RefreshIncome()
	local data = self.Data.all()
	if not data then
		return
	end
	local total = 0
	for _, uid in data.Nests.Slots do
		local record = data.Dragons[uid]
		if record then
			total += record.IncomePerSecond
		end
	end
	self.IncomeText.Text = Format.perSecond(total)
	self.IncomePill.Visible = total > 0
end

function Hud:RefreshEggs()
	local data = self.Data.all()
	if not data then
		return
	end
	local cap = TreeConfig.eggCapacity(data)
	local n = #data.Eggs
	self.EggText.Text = string.format("EGGS %d/%d", n, cap)
	self.EggText.TextColor3 = n >= cap and C.Danger or H.Text
end

function Hud:RefreshLevel()
	local data = self.Data.all()
	if not data then
		return
	end
	local need = EconomyConfig.playerXPToNext(data.Level)
	self.LevelText.Text = tostring(data.Level)
	self.LevelLabel.Text = "LEVEL " .. tostring(data.Level)
	self.XPText.Text = Format.abbreviate(data.XP) .. " / " .. Format.abbreviate(need) .. " XP"
	self.XPBar:SetValue(math.clamp(data.XP / need, 0, 1), true)
end

function Hud:SetCashTarget(value: number, animate: boolean)
	local delta = value - self.TargetCash
	self.TargetCash = value
	if not animate then
		self.DisplayedCash = value
		self.CashText.Text = Format.cash(value)
		return
	end
	if delta > 0 then
		self:PopCash(delta)
		self.CashScale.Scale = 1.06
	end
	if self._cashConn then
		return
	end
	self._cashConn = RunService.RenderStepped:Connect(function(dt)
		self.DisplayedCash = MathUtil.expDecay(self.DisplayedCash, self.TargetCash, 12, dt)
		self.CashScale.Scale = MathUtil.expDecay(self.CashScale.Scale, 1, 10, dt)
		if math.abs(self.DisplayedCash - self.TargetCash) < math.max(0.5, math.abs(self.TargetCash) * 0.0005) then
			self.DisplayedCash = self.TargetCash
			self.CashScale.Scale = 1
			self._cashConn:Disconnect()
			self._cashConn = nil
		end
		self.CashText.Text = Format.cash(self.DisplayedCash)
	end)
end

function Hud:BindData()
	local D = self.Data
	D.observe("Cash", function(cash)
		self:SetCashTarget(cash or 0, self._cashInit == true)
		self._cashInit = true
	end)
	D.observe("Level", function()
		self:RefreshLevel()
	end)
	D.observe("XP", function()
		self:RefreshLevel()
	end)
	D.observe("EquippedDragon", function()
		self:RefreshEquipped()
	end)
	D.observe("Dragons", function()
		self:RefreshEquipped()
		self:RefreshIncome()
	end)
	D.observe("Nests", function()
		self:RefreshIncome()
	end)
	D.observe("Eggs", function()
		self:RefreshEggs()
	end)
	D.observe("Upgrades", function()
		self:RefreshEggs()
	end)
	D.observe("Boosts", function()
		self:RefreshBoosts()
	end)
	D.observe("Flags", function()
		self:RefreshBoosts()
	end)
	task.spawn(function()
		while self.Root and self.Root.Parent do
			pcall(function()
				self:RefreshBoosts()
			end)
			task.wait(1)
		end
	end)
	-- the egg in hand may already exist when the HUD appears
	local held = self.Registry.HeldEggController
	if held and held.updateHud then
		held.updateHud()
	end
end

return Hud
]]></ProtectedString>
						</Properties>
					</Item>
					<Item class="ModuleScript" referent="RBX000126">
						<Properties>
							<string name="Name">MobileControls</string>
							<ProtectedString name="Source"><![CDATA[--[[
	MobileControls
	Touch riding controls (phones and tablets), shown only while mounted:

	  JUMP / FLY / UP   big thumb button (hold: climb while flying)
	  DOWN              descend / land
	  BOOST             sprint on ground, boost in flight; its fill shows
	                    the boost meter (blue, orange while boosting)
	  ROAR              roar
	  DASH / FIRE / DANCE  Dragon Bond abilities (shown once the bond level unlocks
	                    them; the fill shows the cooldown)
	  DISMOUNT          leave the saddle
	  speed readout     km/h above the cluster

	The cluster sits bottom-right, mirroring the thumbstick, sized from the
	short side of the screen so it keeps the same physical size everywhere.
	Buttons drive InputController virtual actions (press = down, release =
	up), so mobile uses exactly the same riding code as keyboard/gamepad.
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = script.Parent.Parent
local Theme = require(UI.Theme)
local Responsive = require(UI.Responsive)
local Create = require(UI.Create)
local Kit = require(UI.Kit)
local Icons = require(UI.Icons)
local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"):WaitForChild("Format"))

local C = Theme.Colors
local H = Theme.Hud

local MobileControls = {}
MobileControls.__index = MobileControls

local BUTTONS = {
	{ Id = "Jump", Action = "Jump", Icon = "Wing", Text = "JUMP", Big = true },
	{ Id = "Boost", Action = "Sprint", Icon = "Wind", Text = "BOOST" },
	{ Id = "Descend", Action = "Descend", Icon = "Descend", Text = "DOWN" },
	{ Id = "Roar", Action = "Roar", Icon = "Roar", Text = "ROAR" },
	{ Id = "Dash", Action = "Dash", Icon = "Wind", Text = "DASH", Perk = "Dash" },
	{ Id = "Fire", Action = "Fire", Icon = "Flame", Text = "FIRE", Perk = "Fire" },
	{ Id = "Dance", Action = "Flourish", Icon = "Star", Text = "DANCE", Perk = "Flourish" },
	{ Id = "Dismount", Action = nil, Icon = "Dismount", Text = "LEAVE" },
}

local function roundButton(def, parent: Instance)
	local root = Create("TextButton", {
		Name = def.Id,
		AutoButtonColor = false,
		Text = "",
		BackgroundColor3 = H.Panel,
		BackgroundTransparency = H.Transparency,
		BorderSizePixel = 0,
		AnchorPoint = Vector2.new(1, 1),
		Selectable = false,
		Parent = parent,
	})
	root:SetAttribute("QARegion", "Mobile" .. def.Id)
	Kit.corner(root, "pill")
	local stroke = Kit.stroke(root, def.Big and C.Accent or H.Stroke, Theme.Stroke.Bold, def.Big and 0.15 or 0.45)
	local scale = Create("UIScale", { Parent = root })
	-- fill (boost meter); clipped to the circle by a rounded holder
	local fillHolder = Create("Frame", {
		Name = "FillHolder",
		BackgroundTransparency = 1,
		ClipsDescendants = true,
		Size = UDim2.fromScale(1, 1),
		Visible = def.Id == "Boost" or def.Perk ~= nil,
		Parent = root,
	})
	Kit.corner(fillHolder, "pill")
	local fill = Create("Frame", {
		Name = "Fill",
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = C.BlueDeep,
		BackgroundTransparency = 0.35,
		BorderSizePixel = 0,
		Parent = fillHolder,
	})
	local iconHolder = Kit.frame({
		Name = "IconHolder",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.42),
		Size = UDim2.fromScale(0.46, 0.46),
		ZIndex = 2,
		Parent = root,
	})
	Kit.aspect(iconHolder, 1)
	local icon = Icons.make(def.Icon, { Color = H.Icon, Accent = def.Big and C.Accent or C.BlueDeep, Ink = H.Panel })
	icon.Parent = iconHolder
	local caption = Kit.text({
		Name = "Caption",
		Text = def.Text,
		Role = "Micro",
		Color = H.TextMuted,
		XAlign = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.fromScale(0.5, 0.68),
		Size = UDim2.fromScale(0.9, 0.2),
		Scaled = true,
		ZIndex = 2,
		Parent = root,
	})
	return { Instance = root, Stroke = stroke, Scale = scale, Fill = fill, Caption = caption, Def = def }
end

function MobileControls.new(parent: Instance, registry)
	local self = setmetatable({}, MobileControls)
	self.Registry = registry
	self.Visible = false
	self.Mode = "Ground"
	local root = Create("Frame", {
		Name = "MobileControls",
		BackgroundTransparency = 1,
		Size = UDim2.fromScale(1, 1),
		Visible = false,
		ZIndex = 5,
		Parent = parent,
	})
	self.Root = root
	self.Buttons = {}
	for _, def in BUTTONS do
		local b = roundButton(def, root)
		self.Buttons[def.Id] = b
		self:_wire(b)
		if def.Perk then
			b.Instance.Visible = false -- until the dragon's bond unlocks it (SetPerks)
			b.Fill.Size = UDim2.fromScale(1, 0)
			b.Fill.BackgroundColor3 = C.Disabled
		end
	end
	-- speed readout: big number with the unit underneath
	local speedBox = Kit.frame({ Name = "SpeedBox", AnchorPoint = Vector2.new(1, 1), Parent = root })
	speedBox:SetAttribute("QARegion", "MobileSpeed")
	self.SpeedBox = speedBox
	self.SpeedText = Kit.text({
		Name = "Speed",
		Text = "0",
		Role = "Title",
		Font = Theme.Fonts.Number,
		Color = H.Text,
		XAlign = Enum.TextXAlignment.Center,
		Size = UDim2.fromScale(1, 0.66),
		Scaled = true,
		MaxRole = "Title",
		Parent = speedBox,
	})
	Kit.text({
		Name = "Unit",
		Text = "KM/H",
		Role = "Micro",
		Color = H.TextMuted,
		XAlign = Enum.TextXAlignment.Center,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.fromScale(0, 1),
		Size = UDim2.fromScale(1, 0.34),
		Scaled = true,
		Parent = speedBox,
	})
	self:Layout()
	return self
end

function MobileControls:_wire(b)
	local def = b.Def
	local input = self.Registry.InputController
	local active: InputObject? = nil
	local function release()
		if active then
			active = nil
			if def.Action and input then
				input.setVirtual(def.Action, false)
			end
			Kit.tween(b.Scale, 0.1, { Scale = 1 }, Enum.EasingStyle.Back)
			b.Stroke.Transparency = def.Big and 0.15 or 0.45
		end
	end
	b.Instance.InputBegan:Connect(function(io)
		if io.UserInputType ~= Enum.UserInputType.Touch and io.UserInputType ~= Enum.UserInputType.MouseButton1 then
			return
		end
		if active then
			return
		end
		active = io
		Kit.tween(b.Scale, Theme.Motion.Press, { Scale = 0.9 })
		b.Stroke.Transparency = 0
		if def.Action and input then
			input.setVirtual(def.Action, true)
		elseif def.Id == "Dismount" then
			local dc = self.Registry.DragonController
			if dc then
				dc.toggleRide()
			end
		end
	end)
	b.Instance.InputEnded:Connect(function(io)
		if io == active then
			release()
		end
	end)
	UserInputService.TouchEnded:Connect(function(io)
		if io == active then
			release()
		end
	end)
	self.Buttons[def.Id].Release = release
end

-- Pure Scale layout: every size/offset is a fraction of the screen's short
-- side (SizeConstraint keeps buttons round), converted to per-axis scale.
--   landscape            portrait
--   [LEAVE]      [DOWN]          [LEAVE]
--   [ROAR][BOOST][ UP ]   [ROAR] [DOWN]
--                         [BOOST][ UP ]
function MobileControls:Layout()
	local R = Responsive
	local W, H = R.Width, R.Height
	local S = math.min(W, H)
	local phone = R.Device == "Phone"
	local big = phone and 0.25 or 0.15
	local small = phone and 0.165 or 0.1
	local gap = phone and 0.025 or 0.016
	local margin = phone and 0.045 or 0.03
	local bottom = margin + (R.Portrait and 0.05 or 0)
	local constraint = R.Portrait and Enum.SizeConstraint.RelativeXX or Enum.SizeConstraint.RelativeYY
	local function place(inst: GuiObject, w: number, h: number, right: number, up: number)
		inst.SizeConstraint = constraint
		inst.Size = UDim2.fromScale(w, h)
		inst.Position = UDim2.fromScale(1 - right * S / W, 1 - up * S / H)
	end
	local B = self.Buttons
	local centerUp = margin + (big - small) * 0.5 -- small button centered on UP's column
	local midRow = bottom + (big - small) * 0.5 -- small button centered on UP's row
	place(B.Jump.Instance, big, big, margin, bottom)
	-- Dragon Bond abilities: one more column to the left
	local perkRight = R.Portrait and (margin + big + small + gap * 2) or (margin + big + small * 2 + gap * 3)
	place(B.Dash.Instance, small, small, perkRight, midRow)
	place(B.Fire.Instance, small, small, perkRight, midRow + small + gap)
	place(B.Dance.Instance, small, small, perkRight, midRow + (small + gap) * 2)
	if R.Portrait then
		place(B.Boost.Instance, small, small, margin + big + gap, midRow)
		place(B.Descend.Instance, small, small, centerUp, bottom + big + gap)
		place(B.Roar.Instance, small, small, margin + big + gap, bottom + big + gap)
		place(B.Dismount.Instance, small, small, centerUp, bottom + big + small + gap * 2)
		place(self.SpeedBox, small, small * 0.62, margin + big + gap, bottom + big + small + gap * 2)
	else
		place(B.Boost.Instance, small, small, margin + big + gap, midRow)
		place(B.Roar.Instance, small, small, margin + big + small + gap * 2, midRow)
		place(B.Descend.Instance, small, small, centerUp, bottom + big + gap)
		place(B.Dismount.Instance, small, small, margin + big + small + gap * 2, midRow + small + gap)
		place(self.SpeedBox, small + gap, small * 0.62, margin + big + gap * 0.5, midRow + small + gap)
	end
end

function MobileControls:SetVisible(on: boolean)
	on = on and Responsive.isMobile()
	if self.Visible == on then
		return
	end
	self.Visible = on
	self.Root.Visible = on
	if not on then
		for _, b in self.Buttons do
			if b.Release then
				b.Release()
			end
		end
	end
	-- hide the default jump button while riding (ours replaces it)
	pcall(function()
		local gui = Players.LocalPlayer:FindFirstChildOfClass("PlayerGui")
		local touch = gui and gui:FindFirstChild("TouchGui")
		local frame = touch and touch:FindFirstChild("TouchControlFrame")
		local jump = frame and frame:FindFirstChild("JumpButton")
		if jump then
			jump.Visible = not on
		end
	end)
end

-- mode: Ground | Air | Takeoff | Fly | Landing
function MobileControls:SetMode(mode: string)
	if mode == self.Mode then
		return
	end
	self.Mode = mode
	local flying = mode == "Fly" or mode == "Takeoff" or mode == "Landing"
	local jump = self.Buttons.Jump
	if flying then
		jump.Caption.Text = "UP"
	elseif mode == "Air" then
		jump.Caption.Text = "FLY"
	else
		jump.Caption.Text = "JUMP"
	end
	self.Buttons.Descend.Instance.Visible = flying
	self.Buttons.Boost.Caption.Text = flying and "BOOST" or "SPRINT"
end

-- Dragon Bond: show the ability buttons the bond level has unlocked, with their cooldown.
-- info = BondController.info()
function MobileControls:SetPerks(info)
	for _, def in BUTTONS do
		if def.Perk then
			local b = self.Buttons[def.Id]
			local unlocked = info and info.Unlocked and info.Unlocked[def.Perk] == true
			b.Instance.Visible = unlocked
			if unlocked then
				b.Fill.Size = UDim2.fromScale(1, math.clamp((info.Cooldown and info.Cooldown[def.Perk]) or 0, 0, 1))
			end
		end
	end
end

function MobileControls:SetStats(speed: number, boost01: number, boosting: boolean)
	if not self.Visible then
		return
	end
	self.SpeedText.Text = tostring(Format.kmh(speed))
	local b = self.Buttons.Boost
	b.Fill.Size = UDim2.fromScale(1, math.clamp(boost01, 0, 1))
	b.Fill.BackgroundColor3 = boosting and C.Accent or C.BlueDeep
end

return MobileControls
]]></ProtectedString>
						</Properties>
					</Item>
				</Item>
				<Item class="ModuleScript" referent="RBX000127">
					<Properties>
						<string name="Name">Icons</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Icons
	Original vector-style icons built from GUI primitives. Every primitive is
	positioned/sized with Scale inside a square box, so icons stay crisp at any
	resolution. Ring strokes scale with the icon's absolute size.

	Icons.make(name, { Color = Color3, Accent = Color3, Ink = Color3 }) -> Frame
]]

local Theme = require(script.Parent:WaitForChild("Theme"))

local Icons = {}

local C = Theme.Colors

local function box(): Frame
	local f = Instance.new("Frame")
	f.Name = "Icon"
	f.BackgroundTransparency = 1
	f.BorderSizePixel = 0
	f.Size = UDim2.fromScale(1, 1)
	local ar = Instance.new("UIAspectRatioConstraint")
	ar.AspectRatio = 1
	ar.Parent = f
	return f
end

-- Primitive: rectangle in icon space (x, y = center; w, h = size; all 0..1).
local function rect(parent: Instance, x: number, y: number, w: number, h: number, color: Color3, radius: number?, rot: number?): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundColor3 = color
	f.AnchorPoint = Vector2.new(0.5, 0.5)
	f.Position = UDim2.fromScale(x, y)
	f.Size = UDim2.fromScale(w, h)
	f.Rotation = rot or 0
	if radius and radius > 0 then
		local c = Instance.new("UICorner")
		c.CornerRadius = UDim.new(radius, 0)
		c.Parent = f
	end
	f.Parent = parent
	return f
end

local function circle(parent: Instance, x: number, y: number, d: number, color: Color3): Frame
	return rect(parent, x, y, d, d, color, 0.5)
end

-- Ring: transparent circle with a stroke whose thickness tracks icon size.
local function ring(parent: Frame, iconRoot: Frame, x: number, y: number, w: number, h: number, thickness: number, color: Color3): Frame
	local f = rect(parent, x, y, w, h, color, 0.5)
	f.BackgroundTransparency = 1
	local s = Instance.new("UIStroke")
	s.Color = color
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = f
	local function update()
		s.Thickness = math.max(1, iconRoot.AbsoluteSize.X * thickness)
	end
	iconRoot:GetPropertyChangedSignal("AbsoluteSize"):Connect(update)
	update()
	return f
end

local builders = {}

builders.Dragon = function(root, col, acc, ink)
	-- dragon eye: almond + iris + slit pupil
	rect(root, 0.5, 0.5, 0.94, 0.5, col, 0.5)
	circle(root, 0.5, 0.5, 0.42, acc)
	rect(root, 0.5, 0.5, 0.09, 0.36, ink, 0.5)
	circle(root, 0.6, 0.4, 0.08, col)
end

builders.Book = function(root, col, acc, ink)
	rect(root, 0.29, 0.5, 0.4, 0.66, col, 0.12, -7)
	rect(root, 0.71, 0.5, 0.4, 0.66, col, 0.12, 7)
	rect(root, 0.5, 0.52, 0.08, 0.7, acc, 0.5)
	rect(root, 0.28, 0.4, 0.22, 0.05, ink, 0.5, -7)
	rect(root, 0.28, 0.54, 0.22, 0.05, ink, 0.5, -7)
	rect(root, 0.72, 0.4, 0.22, 0.05, ink, 0.5, 7)
	rect(root, 0.72, 0.54, 0.22, 0.05, ink, 0.5, 7)
end

builders.Scroll = function(root, col, acc, ink)
	rect(root, 0.5, 0.52, 0.64, 0.8, col, 0.14)
	rect(root, 0.5, 0.14, 0.34, 0.12, acc, 0.4)
	rect(root, 0.46, 0.42, 0.36, 0.07, ink, 0.5)
	rect(root, 0.46, 0.57, 0.36, 0.07, ink, 0.5)
	rect(root, 0.4, 0.72, 0.24, 0.07, ink, 0.5)
	rect(root, 0.66, 0.76, 0.1, 0.06, acc, 0.5, 45)
	rect(root, 0.75, 0.71, 0.2, 0.06, acc, 0.5, -50)
end

builders.Bag = function(root, col, acc, ink)
	ring(root, root, 0.5, 0.33, 0.36, 0.4, 0.07, col)
	rect(root, 0.5, 0.64, 0.74, 0.56, col, 0.18)
	rect(root, 0.5, 0.6, 0.3, 0.08, ink, 0.5)
	circle(root, 0.5, 0.6, 0.14, acc)
end

builders.Gift = function(root, col, acc, ink)
	rect(root, 0.5, 0.66, 0.72, 0.5, col, 0.1)
	rect(root, 0.5, 0.4, 0.86, 0.18, col, 0.12)
	rect(root, 0.5, 0.6, 0.13, 0.62, acc, 0)
	rect(root, 0.38, 0.22, 0.24, 0.16, acc, 0.5, -28)
	rect(root, 0.62, 0.22, 0.24, 0.16, acc, 0.5, 28)
