	<Item class="ReplicatedFirst" referent="RBX000062">
		<Properties>
			<string name="Name">ReplicatedFirst</string>
		</Properties>
		<Item class="LocalScript" referent="RBX000063">
			<Properties>
				<string name="Name">LoadingScreen</string>
				<ProtectedString name="Source"><![CDATA[--[[
	LoadingScreen (ReplicatedFirst)
	Replaces Roblox's default loading screen while the server writes Dragon
	Haven (terrain, village, nature) and the game assets arrive. Shows the
	title, a gold progress bar (Workspace attribute WorldProgress) and tips;
	fades out once the world is ready and the character has spawned.
	Scale-based layout (phones to 4K).
]]

local Players = game:GetService("Players")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")

pcall(function()
	ReplicatedFirst:RemoveDefaultLoadingScreen()
end)

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "LoadingScreen"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.DisplayOrder = 1000
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

local GOLD = Color3.fromRGB(206, 170, 98)
local GOLD_BRIGHT = Color3.fromRGB(242, 208, 134)
local TEXT = Color3.fromRGB(246, 238, 221)
local MUTED = Color3.fromRGB(180, 172, 156)

local bg = Instance.new("Frame")
bg.Name = "Backdrop"
bg.Size = UDim2.fromScale(1, 1)
bg.BackgroundColor3 = Color3.fromRGB(10, 12, 16)
bg.BorderSizePixel = 0
bg.Parent = gui
local grad = Instance.new("UIGradient")
grad.Rotation = 90
grad.Color = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(24, 28, 38)),
	ColorSequenceKeypoint.new(0.6, Color3.fromRGB(12, 14, 20)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(6, 7, 10)),
})
grad.Parent = bg

local center = Instance.new("Frame")
center.Name = "Center"
center.AnchorPoint = Vector2.new(0.5, 0.5)
center.Position = UDim2.fromScale(0.5, 0.5)
center.Size = UDim2.fromScale(0.62, 0.36)
center.BackgroundTransparency = 1
center.Parent = bg
local aspect = Instance.new("UIAspectRatioConstraint")
aspect.AspectRatio = 3.2
aspect.Parent = center

local title = Instance.new("TextLabel")
title.Name = "Title"
title.BackgroundTransparency = 1
title.Size = UDim2.fromScale(1, 0.42)
title.Font = Enum.Font.GothamBlack
title.Text = "RIDE A DRAGON"
title.TextScaled = true
title.TextColor3 = TEXT
title.Parent = center
local tg = Instance.new("UIGradient")
tg.Rotation = 90
tg.Color = ColorSequence.new(GOLD_BRIGHT, GOLD)
tg.Parent = title
local ts = Instance.new("UIStroke")
ts.Thickness = 2
ts.Color = Color3.fromRGB(60, 40, 14)
ts.Transparency = 0.2
ts.Parent = title

local sub = Instance.new("TextLabel")
sub.Name = "Subtitle"
sub.BackgroundTransparency = 1
sub.Position = UDim2.fromScale(0, 0.44)
sub.Size = UDim2.fromScale(1, 0.12)
sub.Font = Enum.Font.GothamMedium
sub.Text = "Entering Dragon Haven"
sub.TextScaled = true
sub.TextColor3 = MUTED
sub.Parent = center

local track = Instance.new("Frame")
track.Name = "Track"
track.AnchorPoint = Vector2.new(0.5, 0)
track.Position = UDim2.fromScale(0.5, 0.66)
track.Size = UDim2.fromScale(0.7, 0.05)
track.BackgroundColor3 = Color3.fromRGB(34, 36, 44)
track.BorderSizePixel = 0
track.Parent = center
local tc = Instance.new("UICorner")
tc.CornerRadius = UDim.new(1, 0)
tc.Parent = track
local tstroke = Instance.new("UIStroke")
tstroke.Color = GOLD
tstroke.Transparency = 0.55
tstroke.Thickness = 1
tstroke.Parent = track
local fill = Instance.new("Frame")
fill.Name = "Fill"
fill.Size = UDim2.fromScale(0.02, 1)
fill.BackgroundColor3 = GOLD
fill.BorderSizePixel = 0
fill.Parent = track
local fc = Instance.new("UICorner")
fc.CornerRadius = UDim.new(1, 0)
fc.Parent = fill
local fg = Instance.new("UIGradient")
fg.Color = ColorSequence.new(GOLD, GOLD_BRIGHT)
fg.Parent = fill

local tip = Instance.new("TextLabel")
tip.Name = "Tip"
tip.BackgroundTransparency = 1
tip.Position = UDim2.fromScale(0, 0.8)
tip.Size = UDim2.fromScale(1, 0.1)
tip.Font = Enum.Font.GothamMedium
tip.TextScaled = true
tip.TextColor3 = MUTED
tip.TextTransparency = 0.15
tip.Parent = center

local TIPS = {
	"Press R near your dragon to ride it.",
	"Hold Space to take off, Shift to boost.",
	"Find dragon eggs all over Dragon Haven.",
	"Your sanctuary earns coins from every dragon you place.",
	"Mutated dragons are rarer and far more valuable.",
}
tip.Text = TIPS[math.random(1, #TIPS)]

gui.Parent = player:WaitForChild("PlayerGui")

local shown = 0
local tipClock = 0
local tipIndex = 1
local conn
conn = RunService.RenderStepped:Connect(function(dt)
	local worldP = Workspace:GetAttribute("WorldProgress") or 0
	local ready = Workspace:GetAttribute("WorldReady") == true
	local target = ready and 1 or math.clamp(0.05 + worldP * 0.9, 0, 0.95)
	shown += (target - shown) * math.min(1, dt * 4)
	fill.Size = UDim2.fromScale(math.max(0.02, shown), 1)
	tipClock += dt
	if tipClock > 4.5 then
		tipClock = 0
		tipIndex = tipIndex % #TIPS + 1
		tip.Text = TIPS[tipIndex]
	end
end)

-- finish: world ready + character present (or a safety timeout)
local t0 = os.clock()
while not (Workspace:GetAttribute("WorldReady") and player.Character) and os.clock() - t0 < 45 do
	task.wait(0.1)
end
task.wait(0.6)
conn:Disconnect()
local info = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
for _, d in gui:GetDescendants() do
	if d:IsA("TextLabel") then
		TweenService:Create(d, info, { TextTransparency = 1 }):Play()
	elseif d:IsA("UIStroke") then
		TweenService:Create(d, info, { Transparency = 1 }):Play()
	elseif d:IsA("Frame") then
		TweenService:Create(d, info, { BackgroundTransparency = 1 }):Play()
	end
end
task.wait(0.65)
gui:Destroy()
]]></ProtectedString>
			</Properties>
		</Item>
	</Item>
	<Item class="ServerScriptService" referent="RBX000064">
		<Properties>
			<string name="Name">ServerScriptService</string>
		</Properties>
		<Item class="ModuleScript" referent="RBX000065">
			<Properties>
				<string name="Name">AdminModule</string>
				<ProtectedString name="Source"><![CDATA[--[[
    AdminModule

    Server-side /give system for Ride A Dragon.

    Examples:
      /give me Cash 10000
      /give PlayerName Spins 25
      /give PlayerName PrinceDragon
      /give PlayerName LuckPotion 5
      /give PlayerName CelestialEgg 3
      /give PlayerName EggHunter

    Potions in this game are timed boosts, not inventory objects. Giving 5 LuckPotions
    therefore applies the normal Luck Potion five times and extends its timer fivefold.

    Everything is granted through the game's existing authoritative services and a save
    is requested immediately after a successful command.

    Ranks: /rank <player|me> <rank|none>, /ranks, /rankhelp are handled by RankService (see
    RankConfig). A CO-OWNER or OWNER rank (RankConfig.GiveLevel) may use /give too.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Configs = ReplicatedStorage:WaitForChild("Configs")
local Shared = ReplicatedStorage:WaitForChild("Shared")

local AdminConfig = require(Configs:WaitForChild("AdminConfig"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))
local MonetizationConfig = require(Configs:WaitForChild("MonetizationConfig"))
local RankConfig = require(Configs:WaitForChild("RankConfig"))
local Net = require(Shared:WaitForChild("Net"))

local AdminModule = {}
local Services = nil

local function normalize(value: any): string
    return string.lower((tostring(value or ""):gsub("[%s_%-]+", "")))
end

local function finitePositiveInteger(value: any, defaultValue: number, maxValue: number): number?
    if value == nil or value == "" then
        return defaultValue
    end
    local n = tonumber(value)
    if not n or n ~= n or n == math.huge or n == -math.huge then
        return nil
    end
    n = math.floor(n)
    if n < 1 then
        return nil
    end
    return math.min(n, maxValue)
end

local function notify(player: Player?, kind: string, text: string)
    if not player or player.Parent ~= Players then
        return
    end
    pcall(function()
        Net.notify(player, kind, text)
    end)
end

-- The real owner: AdminConfig (usernames / user ids / the experience creator) and everybody inside
-- Roblox Studio. Can do everything, including handing out any rank.
function AdminModule.IsOwner(player: Player): boolean
    if RunService:IsStudio() and AdminConfig.AllowEveryoneInStudio then
        return true
    end

    for _, userId in AdminConfig.AdminUserIds or {} do
        if player.UserId == tonumber(userId) then
            return true
        end
    end

    local username = string.lower(player.Name)
    for _, allowedName in AdminConfig.AdminUsernames or {} do
        if username == string.lower(tostring(allowedName)) then
            return true
        end
    end

    if AdminConfig.AllowUserCreator and game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
        return true
    end

    return false
end

-- May use /give: the owner, or somebody with the CO-OWNER / OWNER rank.
function AdminModule.IsAdmin(player: Player): boolean
    if AdminModule.IsOwner(player) then
        return true
    end
    local ranks = Services and Services.RankService
    return ranks ~= nil and ranks.Level(player) >= RankConfig.GiveLevel
end

function AdminModule.FindPlayer(sender: Player, query: string): (Player?, string?)
    local q = string.lower(query or "")
    if q == "me" or q == "@me" then
        return sender, nil
    end

    -- Exact username first, then exact display name.
    for _, player in Players:GetPlayers() do
        if string.lower(player.Name) == q then
            return player, nil
        end
    end
    for _, player in Players:GetPlayers() do
        if string.lower(player.DisplayName) == q then
            return player, nil
        end
    end

    -- Unique prefix of username/display name.
    local matches = {}
    for _, player in Players:GetPlayers() do
        local name = string.lower(player.Name)
        local display = string.lower(player.DisplayName)
        if string.sub(name, 1, #q) == q or string.sub(display, 1, #q) == q then
            table.insert(matches, player)
        end
    end

    if #matches == 1 then
        return matches[1], nil
    elseif #matches > 1 then
        return nil, "More than one player matches '" .. query .. "'. Use the full username."
    end
    return nil, "Player '" .. query .. "' is not in this server."
end

local dragonLookup: { [string]: string } = {}
local eggLookup: { [string]: string } = {}
local productLookup: { [string]: string } = {}
local passLookup: { [string]: string } = {}
local defaultMutation: { [string]: string } = {}

local function buildLookups()
    table.clear(dragonLookup)
    table.clear(eggLookup)
    table.clear(productLookup)
    table.clear(passLookup)
    table.clear(defaultMutation)

    for speciesId, def in DragonConfig.Species do
        dragonLookup[normalize(speciesId)] = speciesId
        dragonLookup[normalize(def.Name)] = speciesId
    end
    -- Friendly spelling without the zero in the internal M0nica species id.
    dragonLookup["monicadragon"] = "M0nicaDragon"
    dragonLookup["monica"] = "M0nicaDragon"
    dragonLookup["m0nica"] = "M0nicaDragon"
    dragonLookup["narcisdragon"] = "N2RC1SDragon"
    dragonLookup["narcis"] = "N2RC1SDragon"

    for eggId, def in EggConfig.Eggs do
        eggLookup[normalize(eggId)] = eggId
        eggLookup[normalize(def.Name)] = eggId
    end

    for itemId, def in MonetizationConfig.Products do
        productLookup[normalize(itemId)] = itemId
        productLookup[normalize(def.Name)] = itemId
    end

    for itemId, def in MonetizationConfig.GamePasses do
        passLookup[normalize(itemId)] = itemId
        passLookup[normalize(def.Name)] = itemId
        if def.Grants then
            defaultMutation[def.Grants] = def.Mutation or "None"
        end
    end
end

buildLookups()

local function giveDragon(target: Player, speciesId: string, count: number): (boolean, string)
    local dragonService = Services and Services.DragonService
    if not dragonService then
        return false, "DragonService is not available."
    end

    local mutation = defaultMutation[speciesId] or "None"
    local added = 0
    for _ = 1, count do
        local record = dragonService.Add(target, speciesId, mutation, "Admin", true)
        if record then
            added += 1
        end
    end

    if added == 0 then
        return false, "Could not add the dragon."
    end
    return true, string.format("%dx %s", added, DragonConfig.Species[speciesId].Name)
end

local function giveEgg(target: Player, eggId: string, count: number): (boolean, string)
    local eggService = Services and Services.EggService
    if not eggService then
        return false, "EggService is not available."
    end

    local added = 0
    for _ = 1, count do
        local ok = eggService.GiveEgg(target, eggId, 1, true)
        if ok then
            added += 1
        end
    end
    if added == 0 then
        return false, "Could not add the egg."
    end
    return true, string.format("%dx %s", added, EggConfig.Eggs[eggId].Name)
end

local function giveProduct(target: Player, itemId: string, count: number): (boolean, string)
    local monetization = Services and Services.MonetizationService
    if not monetization then
        return false, "MonetizationService is not available."
    end

    local granted = 0
    local lastText = nil
    for _ = 1, count do
        local ok, text = monetization.GrantProduct(target, itemId)
        if not ok then
            break
        end
        granted += 1
        lastText = text
    end
    if granted == 0 then
        return false, "Could not grant " .. itemId .. "."
    end
    local def = MonetizationConfig.Products[itemId]
    local label = def and def.Name or itemId
    if count == 1 and lastText then
        return true, lastText
    end
    return true, string.format("%dx %s", granted, label)
end

local function givePass(target: Player, itemId: string): (boolean, string)
    local monetization = Services and Services.MonetizationService
    if not monetization then
        return false, "MonetizationService is not available."
    end
    local ok, text = monetization.GrantPass(target, itemId)
    if not ok then
        return false, "Could not grant " .. itemId .. "."
    end
    local def = MonetizationConfig.GamePasses[itemId]
    return true, text or ((def and def.Name or itemId) .. " unlocked")
end

function AdminModule.Give(sender: Player, target: Player, itemName: string, amountText: any): (boolean, string)
    if not AdminModule.IsAdmin(sender) then
        return false, "You are not allowed to use admin commands."
    end
    if not Services or not Services.PlayerDataService or not Services.PlayerDataService.Get(target) then
        return false, "That player's data is not loaded yet."
    end

    local key = normalize(itemName)

    if key == "cash" or key == "money" or key == "coins" then
        local amount = finitePositiveInteger(amountText, 1, AdminConfig.MaxCash)
        if not amount then
            return false, "Cash amount must be a positive number."
        end
        Services.EconomyService.Earn(target, amount, "Admin")
        Services.PlayerDataService.SaveNow(target)
        return true, "$" .. tostring(amount) .. " cash"
    end

    if key == "spin" or key == "spins" or key == "tickets" then
        local amount = finitePositiveInteger(amountText, 1, AdminConfig.MaxSpins)
        if not amount then
            return false, "Spin amount must be a positive number."
        end
        Services.SpinService.AddTickets(target, amount)
        Services.PlayerDataService.SaveNow(target)
        return true, tostring(amount) .. " spins"
    end

    local count = finitePositiveInteger(amountText, 1, AdminConfig.MaxItemCount)
    if not count then
        return false, "Item count must be between 1 and " .. tostring(AdminConfig.MaxItemCount) .. "."
    end

    local speciesId = dragonLookup[key]
    if speciesId then
        local ok, text = giveDragon(target, speciesId, count)
        if ok then
            Services.PlayerDataService.SaveNow(target)
        end
        return ok, text
    end

    local eggId = eggLookup[key]
    if eggId then
        local ok, text = giveEgg(target, eggId, count)
        if ok then
            Services.PlayerDataService.SaveNow(target)
        end
        return ok, text
    end

    local productId = productLookup[key]
    if productId then
        local ok, text = giveProduct(target, productId, count)
        if ok then
            Services.PlayerDataService.SaveNow(target)
        end
        return ok, text
    end

    local passId = passLookup[key]
    if passId then
        if count ~= 1 then
            return false, "Permanent pass perks can only be granted once."
        end
        local ok, text = givePass(target, passId)
        if ok then
            Services.PlayerDataService.SaveNow(target)
        end
        return ok, text
    end

    return false, "Unknown item '" .. itemName .. "'. Try /givehelp"
end

local HELP = table.concat({
    "ADMIN GIVE COMMANDS:",
    "/give <player|me> Cash <amount>",
    "/give <player|me> Spins <amount>",
    "/give <player|me> PrinceDragon [count]",
    "/give <player|me> LuckPotion [count]",
    "/give <player|me> CelestialEgg [count]",
    "/give <player|me> EggHunter",
}, "  |  ")

function AdminModule.Execute(sender: Player, rawMessage: string): boolean
    if type(rawMessage) ~= "string" then
        return false
    end

    -- /rank, /ranks, /rankhelp
    local ranks = Services and Services.RankService
    if ranks and ranks.Execute(sender, rawMessage) then
        return true
    end

    local trimmed = rawMessage:match("^%s*(.-)%s*$") or rawMessage
    local lower = string.lower(trimmed)

    if lower == "/givehelp" or lower == ";givehelp" then
        if AdminModule.IsAdmin(sender) then
            notify(sender, "rare", HELP)
        end
        return true
    end

    local prefix, targetText, itemText, amountText = trimmed:match("^([/;])give%s+(%S+)%s+(%S+)%s*(%S*)%s*$")
    if not prefix then
        return false
    end

    if not AdminModule.IsAdmin(sender) then
        notify(sender, "error", "You are not allowed to use /give.")
        return true
    end

    local target, targetErr = AdminModule.FindPlayer(sender, targetText)
    if not target then
        notify(sender, "error", targetErr or "Player not found.")
        return true
    end

    local ok, result = AdminModule.Give(sender, target, itemText, amountText ~= "" and amountText or nil)
    if not ok then
        notify(sender, "error", "ADMIN: " .. result)
        return true
    end

    local targetLabel = target == sender and "yourself" or target.Name
    notify(sender, "success", "ADMIN: Gave " .. result .. " to " .. targetLabel .. ".")
    if target ~= sender then
        notify(target, "rare", "ADMIN GIFT: You received " .. result .. ".")
    end
    print(string.format("[Admin] %s gave %s to %s", sender.Name, result, target.Name))
    return true
end

function AdminModule.Init(services)
    Services = services
    buildLookups()
end

-- Compatibility aliases for simple third-party admin scripts that wait for an AdminModule.
AdminModule.Initialize = AdminModule.Init
AdminModule.IsAuthorized = AdminModule.IsAdmin
AdminModule.RunCommand = AdminModule.Execute

return AdminModule
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX000066">
			<Properties>
				<string name="Name">Main</string>
				<ProtectedString name="Source"><![CDATA[--[[
	Server bootstrap. Requires every service in dependency order, runs Init
	(synchronous wiring) for all of them, opens the network layer, then Start
	(loops and listeners).

	Every step runs in its own protected call: a service that fails is reported (Output, and
	in Studio the ReplicatedStorage attributes ServerBootErrors / ServerErrors that the client's
	Diagnostics panel shows) and the other services keep running.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local ServicesFolder = script.Parent:WaitForChild("Services")

local ORDER = {
	"PlayerDataService",
	"SettingsService",
	"PhysicsGroups",
	"WorldService",
	"DragonAssetService",
	"EconomyService",
	"DragonService",
	"MountService",
	"SanctuaryService",
	"TravelService",
	"BoostService",
	"TreeService",
	"BondService",
	"EggService",
	"WildEggService",
	"IslandService",
	"StatueService",
	"CoinService",
	"ShopService",
	"MonetizationService",
	"QuestService",
	"DailyService",
	"IndexService",
	"RegionService",
	"LevelService",
	"LeaderstatsService",
	"LeaderboardService",
	"RaceService",
	"CombatService",
	"DuelService",
	"SpinService",
	"DevService",
	"RankService",
	"AdminCommandService",
}

-- ============================================================== failures
local bootErrors: { string } = {}

local function try(stage: string, name: string, fn: any, ...: any): (boolean, any)
	local ok, result = xpcall(fn, function(e)
		return tostring(e) .. "\n" .. debug.traceback("", 2)
	end, ...)
	if not ok then
		local text = string.format("%s %s: %s", stage, name, tostring(result))
		table.insert(bootErrors, text)
		warn("[Boot] " .. text)
		return false, nil
	end
	return true, result
end

local services = {}
for _, name in ORDER do
	local module = ServicesFolder:FindFirstChild(name)
	if module then
		local ok, service = try("require", name, require, module)
		if ok then
			services[name] = service
		end
	end
end

for _, name in ORDER do
	local service = services[name]
	if service and service.Init then
		try("Init", name, service.Init, services)
	end
end

try("start", "Net", Net.start)

for _, name in ORDER do
	local service = services[name]
	if service and service.Start then
		task.spawn(try, "Start", name, service.Start)
	end
end

-- Studio: publish the errors so the client can show them on screen (see Diagnostics)
if RunService:IsStudio() then
	if #bootErrors > 0 then
		ReplicatedStorage:SetAttribute("ServerBootErrors", table.concat(bootErrors, "\n---\n"))
	end
	local okContext, scriptContext = pcall(function()
		return game:GetService("ScriptContext")
	end)
	if okContext and scriptContext then
		local seen: { [string]: boolean } = {}
		local list: { string } = {}
		local lastPublish = 0
		pcall(function()
			scriptContext.Error:Connect(function(message, _trace, source)
				local text = (source and (source.Name .. ": ") or "") .. tostring(message)
				local key = string.match(text, "^[^\n]*") or text
				if seen[key] then
					return
				end
				seen[key] = true
				table.insert(list, text)
				if #list > 8 then
					table.remove(list, 1)
				end
				if os.clock() - lastPublish > 1 or #list <= 2 then
					lastPublish = os.clock()
					ReplicatedStorage:SetAttribute("ServerErrors", table.concat(list, "\n---\n"))
				end
			end)
		end)
	end
end

ReplicatedStorage:SetAttribute("ServerReady", true)
]]></ProtectedString>
			</Properties>
		</Item>
		<Item class="Folder" referent="RBX000067">
			<Properties>
				<string name="Name">Services</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX000068">
				<Properties>
					<string name="Name">AdminCommandService</string>
					<ProtectedString name="Source"><![CDATA[--[[
    AdminCommandService
    Hooks server-side chat and forwards /give and /givehelp to ServerScriptService.AdminModule.

    Uses Player.Chatted intentionally: the permission check and the grant both happen on the
    server. The command never trusts a client RemoteEvent or a client-provided amount.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))
local AdminModule = require(script.Parent.Parent:WaitForChild("AdminModule"))

local AdminCommandService = {}
local connections: { [Player]: RBXScriptConnection } = {}

local function hook(player: Player)
    if connections[player] then
        return
    end
    connections[player] = player.Chatted:Connect(function(message)
        local ok, err = pcall(AdminModule.Execute, player, message)
        if not ok then
            warn("[Admin] command failed for " .. player.Name .. ": " .. tostring(err))
        end
    end)
end

function AdminCommandService.Init(services)
    AdminModule.Init(services)
    -- With the new chat (TextChatService) the client (ChatController) takes the admin commands out of
    -- the chat so that nobody sees them, and sends the text here. The permission is checked inside
    -- AdminModule.Execute, exactly as for Player.Chatted.
    Net.handle("Admin", "Command", function(player: Player, p)
        if not Net.check.str(p.Text, 200) then
            return false, "BAD_REQUEST"
        end
        local ok, handled = pcall(AdminModule.Execute, player, p.Text)
        if not ok then
            warn("[Admin] command failed for " .. player.Name .. ": " .. tostring(handled))
            return false, "FAILED"
        end
        return true, { Handled = handled == true }
    end, { Burst = 5, PerSecond = 2 })
end

function AdminCommandService.Start()
    Players.PlayerAdded:Connect(hook)
    Players.PlayerRemoving:Connect(function(player)
        local connection = connections[player]
        if connection then
            connection:Disconnect()
            connections[player] = nil
        end
    end)
    for _, player in Players:GetPlayers() do
        hook(player)
    end
end

return AdminCommandService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000069">
				<Properties>
					<string name="Name">BondService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	BondService
	Dragon Bond: riding one dragon raises ITS bond (data.Dragons[uid].BondXP).
	Perks unlock by bond level (BondConfig): Wind Dash (5), Fire Breath (10),
	Sky Dance (20), Bond Aura (50).

	Server authority:
	  * points are only earned while riding AND moving (no AFK farming)
	  * a client can only use an ability its dragon's bond has unlocked, and the
	    cooldowns / breath duration are enforced here
	  * abilities are replicated to everyone through attributes on the dragon's
	    model: Shot (Dash / Flourish, via MountService.PlayShot), Breathing (bool)
	    and BondLevel (aura at level 50)

	Net event "BondAction" { Action = "Dash" | "Flourish" | "FireStart" | "FireStop" }
	Net signal "BondUp"  { Uid, Level, Perks = { id... } }  (level-up fanfare)
	Signals: LevelUp(player, uid, level, perks), Burned(player, instance)

	Burnable things: any instance tagged "Burnable" within the breath cone catches
	fire, burns away and comes back after RespawnSeconds (attribute, default 40).
	Optional attribute Reward = cash paid to the player who burned it.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local BondConfig = require(Configs:WaitForChild("BondConfig"))

local BondService = {}
BondService.LevelUp = Signal.new() -- (player, uid, level, perks)
BondService.Burned = Signal.new() -- (player, instance)

local Data
local Services

-- Great Tree bonuses (0 when the tree service is absent)
local function tree(player: Player, id: string): number
	local t = Services.TreeService
	return t and t.Bonus(player, id) or 0
end

-- cooldown with Quick Feathers applied
local function cooldownFor(player: Player, base: number): number
	return base * (1 - math.clamp(tree(player, "QuickFeathers"), 0, 0.9))
end

local lastPos: { [Player]: Vector3 } = {}
local cooldowns: { [Player]: { [string]: number } } = {}
local breathing: { [Player]: { Token: number, Start: number } } = {}
local tokenCounter = 0

-- ============================================================== queries
local function record(player: Player, uid: string?)
	local data = Data.Get(player)
	return data and uid and data.Dragons[uid] or nil
end

function BondService.Points(player: Player, uid: string?): number
	local r = record(player, uid)
	return r and tonumber(r.BondXP) or 0
end

function BondService.Level(player: Player, uid: string?): number
	return BondConfig.levelFor(BondService.Points(player, uid))
end

-- The dragon the player is riding right now (comp), if any.
local function riding(player: Player)
	local mount = Services.MountService
	local comp = mount and mount.Get(player)
	if comp and comp.Riding and comp.Model.Parent then
		return comp
	end
	return nil
end

-- Does the dragon the player is riding (or has equipped) have this perk?
function BondService.Has(player: Player, perkId: string): boolean
	local comp = riding(player)
	local uid = comp and comp.Uid
	if not uid then
		local data = Data.Get(player)
		uid = data and data.EquippedDragon
	end
	return uid ~= nil and uid ~= "" and BondConfig.has(BondService.Points(player, uid), perkId)
end

-- ============================================================== points
local function refreshModel(player: Player)
	local mount = Services.MountService
	if mount and mount.RefreshStats then
		mount.RefreshStats(player)
	end
end

function BondService.AddPoints(player: Player, uid: string, points: number)
	local r = record(player, uid)
	if not r or points <= 0 then
		return
	end
	local old = tonumber(r.BondXP) or 0
	local cap = BondConfig.threshold(BondConfig.MaxLevel)
	local new = math.floor(math.min(cap, old + points) * 10 + 0.5) / 10
	if new == old then
		return
	end
	Data.Set(player, { "Dragons", uid, "BondXP" }, new)
	local oldLevel, newLevel = BondConfig.levelFor(old), BondConfig.levelFor(new)
	if newLevel > oldLevel then
		local perks = {}
		for _, perk in BondConfig.unlockedBetween(oldLevel, newLevel) do
			table.insert(perks, perk.Id)
		end
		refreshModel(player)
		Net.signal(player, "BondUp", { Uid = uid, Level = newLevel, Perks = perks })
		Net.notify(player, "rare", string.format("%s: Bond Level %d!", r.Name, newLevel))
		for _, perk in BondConfig.unlockedBetween(oldLevel, newLevel) do
			local key = perk.Key and (" (" .. perk.Key .. ")") or ""
			Net.notify(player, "rare", string.format("Unlocked %s%s", perk.Name, key))
		end
		BondService.LevelUp:Fire(player, uid, newLevel, perks)
	end
end

local function tick()
	local cfg = BondConfig
	for _, player in Players:GetPlayers() do
		local comp = riding(player)
		if comp then
			local pos = comp.Root.Position
			local prev = lastPos[player]
			lastPos[player] = pos
			if prev and (pos - prev).Magnitude >= cfg.MinMove then
				local model = comp.Model
				local rate = cfg.Rate.Ground
				if model:GetAttribute("Boost") == true then
					rate = cfg.Rate.Boost
				elseif model:GetAttribute("Mode") == "Fly" then
					rate = cfg.Rate.Fly
				end
				BondService.AddPoints(player, comp.Uid, rate * cfg.TickSeconds * (1 + tree(player, "BondGrowth")))
			end
		else
			lastPos[player] = nil
		end
	end
end

-- ============================================================== burnables
local function ignite(player: Player, inst: Instance)
	if inst:GetAttribute("Burning") then
		return
	end
	inst:SetAttribute("Burning", true)
	local parts = {}
	if inst:IsA("BasePart") then
		table.insert(parts, inst)
	end
	for _, d in inst:GetDescendants() do
		if d:IsA("BasePart") then
			table.insert(parts, d)
		end
	end
	local first = parts[1]
	if not first then
		inst:SetAttribute("Burning", nil)
		return
	end
	local fire = Instance.new("Fire")
	fire.Heat = 8
	fire.Size = math.clamp(first.Size.Magnitude * 0.5, 4, 14)
	fire.Parent = first
	task.delay(1.4, function()
		fire:Destroy()
		local saved = {}
		for _, p in parts do
			saved[p] = { Transparency = p.Transparency, CanCollide = p.CanCollide, CanQuery = p.CanQuery, CanTouch = p.CanTouch }
			p.Transparency = 1
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
		end
		local reward = tonumber(inst:GetAttribute("Reward")) or 0
		if reward > 0 and player.Parent == Players then
			Services.EconomyService.Earn(player, reward, "Burn")
		end
		BondService.Burned:Fire(player, inst)
		task.delay(tonumber(inst:GetAttribute("RespawnSeconds")) or 40, function()
			for p, s in saved do
				if p.Parent then
					p.Transparency = s.Transparency
					p.CanCollide = s.CanCollide
					p.CanQuery = s.CanQuery
					p.CanTouch = s.CanTouch
				end
			end
			inst:SetAttribute("Burning", nil)
		end)
	end)
end

local function instancePosition(inst: Instance): Vector3?
	if inst:IsA("BasePart") then
		return inst.Position
	elseif inst:IsA("Model") then
		return inst:GetPivot().Position
	end
	local part = inst:FindFirstChildWhichIsA("BasePart", true)
	return part and part.Position or nil
end

-- One breath tick: burn Burnable things inside the cone in front of the dragon.
local function breathTick(player: Player, comp)
	local root = comp.Root
	local cfg = BondConfig.Abilities.Fire
	local origin = root.Position + root.CFrame.LookVector * (comp.Info and comp.Info.BodyRadius or 4)
	local look = root.CFrame.LookVector
	local range = cfg.Range * (1 + tree(player, "Dragonfire"))
	for _, inst in CollectionService:GetTagged("Burnable") do
		if not inst:GetAttribute("Burning") then
			local pos = instancePosition(inst)
			if pos then
				local to = pos - origin
				local d = to.Magnitude
				if d <= range + 6 and (d < 6 or to.Unit:Dot(look) > 0.55) then
					ignite(player, inst)
				end
			end
		end
	end
end

local function stopBreath(player: Player, token: number?)
	local b = breathing[player]
	if not b or (token and b.Token ~= token) then
		return
	end
	breathing[player] = nil
	local mount = Services.MountService
	local model = mount and mount.GetModel(player)
	if model then
		model:SetAttribute("Breathing", false)
	end
	local cd = cooldowns[player]
	if cd then
		cd.Fire = os.clock() + cooldownFor(player, BondConfig.Abilities.Fire.Cooldown)
	end
end

local function startBreath(player: Player, comp)
	tokenCounter += 1
	local token = tokenCounter
	breathing[player] = { Token = token, Start = os.clock() }
	comp.Model:SetAttribute("Breathing", true)
	local cfg = BondConfig.Abilities.Fire
	task.spawn(function()
		local elapsed = 0
		while breathing[player] and breathing[player].Token == token and elapsed < cfg.MaxSeconds do
			task.wait(cfg.Tick)
			elapsed += cfg.Tick
			local c = riding(player)
			if not c then
				break
			end
			breathTick(player, c)
		end
		stopBreath(player, token)
	end)
end

-- ============================================================== actions
local function onAction(player: Player, p)
	if not Net.check.str(p.Action, 12) then
		return
	end
	local comp = riding(player)
	if not comp then
		return
	end
	local points = BondService.Points(player, comp.Uid)
	local cd = cooldowns[player]
	if not cd then
		cd = {}
		cooldowns[player] = cd
	end
	local t = os.clock()
	local ab = BondConfig.Abilities
	local mount = Services.MountService
	local action = p.Action
	if action == "Dash" then
		if BondConfig.has(points, "Dash") and t >= (cd.Dash or 0) and not player:GetAttribute("RaceActive") then
			cd.Dash = t + cooldownFor(player, ab.Dash.Cooldown)
			comp.DashUntil = t + ab.Dash.Duration + ab.Dash.Allowance
			mount.PlayShot(player, "Dash")
		end
	elseif action == "Flourish" then
		if BondConfig.has(points, "Flourish") and t >= (cd.Flourish or 0) then
			cd.Flourish = t + cooldownFor(player, ab.Flourish.Cooldown)
			mount.PlayShot(player, "Flourish")
		end
	elseif action == "FireStart" then
		if BondConfig.has(points, "Fire") and t >= (cd.Fire or 0) and not breathing[player] then
			startBreath(player, comp)
		end
	elseif action == "FireStop" then
		stopBreath(player)
	end
end

-- ============================================================== lifecycle
function BondService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.onEvent("BondAction", onAction, { Burst = 12, PerSecond = 5 })
end

function BondService.Start()
	task.spawn(function()
		while true do
			task.wait(BondConfig.TickSeconds)
			pcall(tick)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastPos[player] = nil
		cooldowns[player] = nil
		breathing[player] = nil
	end)
	-- dismounting ends the breath at once
	local mount = Services.MountService
	if mount and mount.Dismounted then
		mount.Dismounted:Connect(function(player)
			stopBreath(player)
		end)
	end
end

return BondService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000070">
				<Properties>
					<string name="Name">BoostService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	BoostService
	Timed boosts (potions) and permanent perks (Owner Dragon pass).

	data.Boosts = { [boostId] = expiresAt (os.time) }   -- replicated to the client
	data.Flags.OwnerPass = true                          -- Owner Dragon pass perk

	LuckMultiplier(player): multiplies every roll's luck (egg hatches,
	mutations, Spin Wheel). Multiplier(player, "Coins"): sanctuary income.
	The player attribute "Luck" mirrors the current luck multiplier for the HUD.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Configs = ReplicatedStorage:WaitForChild("Configs")
local MonetizationConfig = require(Configs:WaitForChild("MonetizationConfig"))

local BoostService = {}

local Data
local Services

local function now(): number
	return os.time()
end

function BoostService.Add(player: Player, boostId: string, seconds: number): boolean
	if not MonetizationConfig.Boosts[boostId] or seconds <= 0 then
		return false
	end
	local data = Data.Get(player)
	if not data then
		return false
	end
	local current = tonumber(data.Boosts and data.Boosts[boostId]) or 0
	local base = math.max(now(), current) -- buying again extends the timer
	Data.Set(player, { "Boosts", boostId }, base + math.floor(seconds))
	BoostService.Refresh(player)
	return true
end

function BoostService.Remaining(player: Player, boostId: string): number
	local data = Data.Get(player)
	local t = data and data.Boosts and tonumber(data.Boosts[boostId]) or 0
	return math.max(0, t - now())
end

function BoostService.HasOwnerPass(player: Player): boolean
	local data = Data.Get(player)
	return data ~= nil and data.Flags ~= nil and data.Flags.OwnerPass == true
end

-- Great Tree branch bonus (0 when the tree service is absent or nothing is bought).
local function treeBonus(player: Player, id: string): number
	local tree = Services and Services.TreeService
	return tree and tree.Bonus(player, id) or 0
end

function BoostService.LuckMultiplier(player: Player): number
	local m = 1
	m *= MonetizationConfig.passLuck(Data.Get(player))
	m *= 1 + treeBonus(player, "RollLuck")
	for id, def in MonetizationConfig.Boosts do
		if def.Luck and BoostService.Remaining(player, id) > 0 then
			m *= def.Luck
		end
	end
	return m
end

-- EconomyService hook: kind "Coins" = sanctuary income multiplier.
function BoostService.Multiplier(player: Player, kind: string): number
	if kind ~= "Coins" then
		return 1
	end
	local m = 1 + treeBonus(player, "Income")
	for id, def in MonetizationConfig.Boosts do
		if def.Cash and BoostService.Remaining(player, id) > 0 then
			m *= def.Cash
		end
	end
	return m
end

function BoostService.Refresh(player: Player)
	player:SetAttribute("Luck", BoostService.LuckMultiplier(player))
	player:SetAttribute("CashBoost", BoostService.Multiplier(player, "Coins"))
end

local function sweep()
	for _, player in Players:GetPlayers() do
		local data = Data.Get(player)
		if data and data.Boosts then
			for id, t in data.Boosts do
				if (tonumber(t) or 0) <= now() then
					Data.Set(player, { "Boosts", id }, nil)
				end
			end
			BoostService.Refresh(player)
		end
	end
end

function BoostService.Init(services)
	Services = services
	Data = services.PlayerDataService
end

function BoostService.Start()
	Data.Loaded:Connect(function(player)
		BoostService.Refresh(player)
	end)
	for _, player in Players:GetPlayers() do
		if Data.Get(player) then
			BoostService.Refresh(player)
		end
	end
	task.spawn(function()
		while true do
			task.wait(5)
			pcall(sweep)
		end
	end)
end

return BoostService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000071">
				<Properties>
					<string name="Name">CoinService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	CoinService
	Coins on the map: copper trails along the roads, gold arcs in the sky, treasure piles at the
	landmarks (CoinConfig / CoinLayout). The list of coins is the same for everybody; whether a
	coin is there is per player (it comes back CoinConfig.Kinds[kind].Respawn seconds after the
	player took it). The server builds the list from the finished world, validates every pickup
	(distance, own cooldown) and pays: the value of a coin is a few seconds of the player's income;
	coins taken in quick succession form a CHAIN that pays more per coin.

	Net (domain "Coins"):
	  Layout {}          -> { Layout = { X, Y, Z, K }, Back = { [id] = seconds left } }
	  Collect { Ids }    -> { Collected = { id... }, Gained, Chain, Mult, Total }
	Ids the server does not take (too far, not back yet) are simply left out of Collected.
	Test hooks: CoinService.List(), CoinService.State(player), CoinService.Build().
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local CoinLayout = require(Shared:WaitForChild("CoinLayout"))
local CoinConfig = require(Configs:WaitForChild("CoinConfig"))

local CoinService = {}

local Data
local Services
local list: { { Kind: string, Position: Vector3 } } = {}
local packed: any = nil
local states: { [Player]: { Back: { [number]: number }, Chain: number, Last: number } } = {}

-- (the simulator's os.clock is wall time; server time is what the rest of the game uses)
local function clock(): number
	return Workspace:GetServerTimeNow()
end

-- ============================================================== layout
local function build()
	local groundParams = RaycastParams.new()
	groundParams.FilterType = Enum.RaycastFilterType.Include
	groundParams.FilterDescendantsInstances = { Workspace.Terrain }
	groundParams.IgnoreWater = false

	local exclude = {}
	local world = Workspace:FindFirstChild("World")
	for _, name in { "Nature", "EggSpots" } do
		local folder = world and world:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	for _, name in { "Dragons", "MyEggs", "HeldEggs" } do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	local surfaceParams = RaycastParams.new()
	surfaceParams.FilterType = Enum.RaycastFilterType.Exclude
	surfaceParams.FilterDescendantsInstances = exclude
	surfaceParams.IgnoreWater = false

	local env = {
		ground = function(x: number, z: number)
			local hit = Workspace:Raycast(Vector3.new(x, 900, z), Vector3.new(0, -1800, 0), groundParams)
			if not hit then
				return nil
			end
			return hit.Position.Y, hit.Normal.Y, hit.Material == Enum.Material.Water
		end,
		surface = function(x: number, z: number)
			local hit = Workspace:Raycast(Vector3.new(x, 900, z), Vector3.new(0, -1800, 0), surfaceParams)
			if not hit or hit.Material == Enum.Material.Water then
				return nil
			end
			return hit.Position.Y
		end,
	}
	list = CoinLayout.generate(env)
	packed = CoinLayout.pack(list)
	return #list
end

function CoinService.Build(): number
	return build()
end

function CoinService.List()
	return list
end

-- ============================================================== players
local function stateOf(player: Player)
	local st = states[player]
	if not st then
		st = { Back = {}, Chain = 0, Last = -math.huge }
		states[player] = st
	end
	return st
end

function CoinService.State(player: Player)
	return stateOf(player)
end

-- ============================================================== net
local function handleLayout(player: Player)
	if not packed then
		return false, "NOT_READY"
	end
	-- coins the player took a short while ago are still gone (a client that restarts must not see them)
	local st = stateOf(player)
	local now = clock()
	local back = {}
	for id, at in st.Back do
		if at > now then
			back[tostring(id)] = math.ceil(at - now)
		end
	end
	return true, { Layout = packed, Back = back }
end

local function handleCollect(player: Player, p)
	local data = Data.Get(player)
	if not data or #list == 0 then
		return false, "NOT_READY"
	end
	local ids = p.Ids
	if type(ids) ~= "table" or #ids == 0 or #ids > CoinConfig.Batch.Size * 2 then
		return false, "BAD_REQUEST"
	end
	local st = stateOf(player)
	local now = clock()
	local income = Services.EconomyService.IncomeRate(player)
	local collected = {}
	local gained, mult = 0, 1
	local seen = {}
	for _, id in ids do
		if Net.check.int(id, 1, #list) and not seen[id] then
			seen[id] = true
			local coin = list[id]
			local kind = CoinConfig.Kinds[coin.Kind]
			if (st.Back[id] or 0) <= now and Services.EggService.DistanceTo(player, coin.Position) <= kind.Radius + CoinConfig.ServerSlack then
				if now - st.Last <= CoinConfig.Chain.Window then
					st.Chain += 1
				else
					st.Chain = 1
				end
				st.Last = now
				mult = CoinConfig.multiplier(st.Chain)
				gained += math.floor(CoinConfig.value(coin.Kind, income) * mult + 0.5)
				st.Back[id] = now + kind.Respawn
				table.insert(collected, id)
			end
		end
	end
	if #collected > 0 then
		Services.EconomyService.Earn(player, gained, "Coins")
		Data.Increment(player, { "Stats", "Coins" }, #collected)
	end
	local stats = data.Stats
	return true, { Collected = collected, Gained = gained, Chain = st.Chain, Mult = mult, Total = stats and stats.Coins or 0 }
end

-- ============================================================== lifecycle
function CoinService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.handle("Coins", "Layout", handleLayout, { Burst = 4, PerSecond = 1 })
	Net.handle("Coins", "Collect", handleCollect, { Burst = 8, PerSecond = 6 })
end

function CoinService.Start()
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
	task.spawn(function()
		while not Workspace:GetAttribute("WorldReady") do
			task.wait(0.5)
		end
		local count = build()
		if count < 100 then
			warn(string.format("[Coins] only %d coins could be placed", count))
		end
	end)
end

return CoinService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000072">
				<Properties>
					<string name="Name">CombatService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	CombatService
	Dragon duels in the arena of the Race Island (CombatConfig). The server decides everything:

	  ZONE     every ZoneSeconds the riders inside the arena cylinder become fighters (player
	           attributes InArena, HP, MaxHP, Downed); flying out, dismounting or racing ends it.
	           Nobody is ever hit outside the arena.
	  STRIKE   a bite and tail slam in a cone in front of the dragon           (event CombatStrike)
	  BLAST    a fireball the server flies step by step, aimed with a direction  (event CombatBlast { Dir })
	  KO       to a respawn pad for RespawnDelay seconds (frozen there), then back with full HP and a
	           few seconds of protection. A knockout pays the killer cash + XP and counts for the
	           Arena Warriors board (Stats.ArenaKills).

	Hit points come from the dragon's level and rarity (CombatConfig.maxHP), so a fresh dragon is
	never helpless against a legend; damage grows the same way.

	Signals to everybody near the arena (spectators too):
	  CombatFx  { Kind = "Strike" | "Blast", Id?, From, Pos, Dir, Speed?, Life? }
	  CombatHit { Target, By, Damage, Crit, Kind, Pos }
	  CombatKO  { Victim, Killer, VictimName, KillerName }
	  CombatBlastEnd { Id, Pos, Hit }
	Signals to the fighter: CombatEnter { MaxHP, Invulnerable }, CombatLeave, CombatDown { Delay, By },
	                        CombatRespawn { Invulnerable }, CombatReward { Cash, XP, Victim }
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local CombatConfig = require(Configs:WaitForChild("CombatConfig"))
local RaceConfig = require(Configs:WaitForChild("RaceConfig"))

local CombatService = {}

local Services
local Data

type Fighter = {
	Player: Player,
	MaxHP: number,
	HP: number,
	Level: number,
	Rank: number,
	Radius: number,
	Invuln: number,
	Dead: boolean,
	RespawnAt: number,
	LastHit: number,
	NextStrike: number,
	NextBlast: number,
}

local dummy = { HP = CombatConfig.Dummy.HP, Down = false, RespawnAt = 0, Model = nil :: Model? }
local fighters: { [Player]: Fighter } = {}
local blasts: { any } = {}
local nextBlastId = 0
local lastKill: { [string]: number } = {} -- "killer:victim" -> time of the last paid knockout

local function now(): number
	return Workspace:GetServerTimeNow()
end

-- ============================================================== helpers
local function ridden(player: Player)
	local mount = Services.MountService
	local comp = mount and mount.Get(player)
	if comp and comp.Riding and comp.Root.Parent then
		return comp
	end
	return nil
end

local function insideArena(position: Vector3, margin: number?): boolean
	local center, radius, height = CombatConfig.arenaWorld()
	local m = margin or 0
	local dx, dz = position.X - center.X, position.Z - center.Z
	local r = radius + m
	return dx * dx + dz * dz <= r * r and position.Y >= center.Y - 8 - m and position.Y <= center.Y + height + m
end

-- Players who should see the fight: fighters and anybody on / near the island.
local function audience(): { Player }
	local center = CombatConfig.arenaWorld()
	local list = {}
	for _, p in Players:GetPlayers() do
		local comp = ridden(p)
		local position = comp and comp.Root.Position
		if not position then
			local character = p.Character
			local hrp = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			position = hrp and hrp.Position
		end
		if fighters[p] or (position and (position - center).Magnitude < 700) then
			table.insert(list, p)
		end
	end
	return list
end

local function toNear(name: string, payload)
	for _, p in audience() do
		Net.signal(p, name, payload)
	end
end

local function setHP(player: Player, f: Fighter)
	player:SetAttribute("HP", math.max(0, math.floor(f.HP + 0.5)))
end

-- ============================================================== zone
local function enter(player: Player, comp)
	local record = comp.Record
	local level = tonumber(record.Level) or 1
	local rank = DragonConfig.rarityRank(record.Rarity)
	local maxHP = CombatConfig.maxHP(level, rank)
	local f: Fighter = {
		Player = player,
		MaxHP = maxHP,
		HP = maxHP,
		Level = level,
		Rank = rank,
		Radius = (comp.Info and comp.Info.BodyRadius) or 4,
		Invuln = now() + CombatConfig.Invulnerable,
		Dead = false,
		RespawnAt = 0,
		LastHit = 0,
		NextStrike = 0,
		NextBlast = 0,
	}
	fighters[player] = f
	player:SetAttribute("MaxHP", maxHP)
	player:SetAttribute("HP", maxHP)
	player:SetAttribute("Downed", nil)
	player:SetAttribute("InArena", true)
	Net.signal(player, "CombatEnter", { MaxHP = maxHP, Invulnerable = CombatConfig.Invulnerable })
end

local function leave(player: Player)
	local f = fighters[player]
	if not f then
		return
	end
	fighters[player] = nil
	player:SetAttribute("InArena", nil)
	player:SetAttribute("HP", nil)
	player:SetAttribute("MaxHP", nil)
	player:SetAttribute("Downed", nil)
	if f.Dead then
		local mount = Services.MountService
		if mount and mount.Freeze then
			mount.Freeze(player, false)
		end
	end
	for i = #blasts, 1, -1 do
		if blasts[i].Owner == player then
			table.remove(blasts, i)
		end
	end
	Net.signal(player, "CombatLeave", {})
end

-- The respawn pad farthest from everybody who is still standing.
local function pickRespawn(victim: Player): Vector3
	local best, bestScore = nil, -1
	for _, pad in CombatConfig.Respawns do
		local world = RaceConfig.toWorld(pad)
		local score = math.huge
		for other, of in fighters do
			if other ~= victim and not of.Dead then
				local comp = ridden(other)
				if comp then
					score = math.min(score, (comp.Root.Position - world).Magnitude)
				end
			end
		end
		if score > bestScore then
			best, bestScore = world, score
		end
	end
	return best or RaceConfig.toWorld(CombatConfig.Respawns[1])
end

local function respawn(player: Player, f: Fighter)
	f.Dead = false
	f.HP = f.MaxHP
	f.Invuln = now() + CombatConfig.Invulnerable
	f.LastHit = 0
	setHP(player, f)
	player:SetAttribute("Downed", nil)
	local mount = Services.MountService
	if mount and mount.Freeze then
		mount.Freeze(player, false)
	end
	Net.signal(player, "CombatRespawn", { Invulnerable = CombatConfig.Invulnerable })
end

local function dummyStep()
	if dummy.Down and now() >= dummy.RespawnAt then
		dummy.Down = false
		dummy.HP = CombatConfig.Dummy.HP
		if dummy.Model then
			dummy.Model:SetAttribute("HP", dummy.HP)
			dummy.Model:SetAttribute("Down", nil)
		end
	end
end

local function zoneStep()
	local t = now()
	dummyStep()
	for _, player in Players:GetPlayers() do
		local comp = ridden(player)
		local raceBusy = player:GetAttribute("RaceActive") == true
		local f = fighters[player]
		local inside = comp ~= nil and not raceBusy and insideArena(comp.Root.Position)
		if inside and not f then
			enter(player, comp)
		elseif f and not inside then
			leave(player)
		elseif f then
			if f.Dead then
				if t >= f.RespawnAt then
					respawn(player, f)
				end
			elseif f.HP < f.MaxHP and t - f.LastHit > CombatConfig.RegenDelay then
				f.HP = math.min(f.MaxHP, f.HP + f.MaxHP * CombatConfig.RegenPerSecond * CombatConfig.ZoneSeconds)
				setHP(player, f)
			end
		end
	end
end

-- ============================================================== damage / knockout
local function pay(killer: Player, victim: Player)
	local key = killer.UserId .. ":" .. victim.UserId
	local t = now()
	local repeated = lastKill[key] and t - lastKill[key] < 45
	lastKill[key] = t
	Data.Increment(killer, { "Stats", "ArenaKills" }, 1)
	if repeated then
		Net.notify(killer, "info", "Knockout! (no reward for the same opponent again so soon)")
		return
	end
	local reward = CombatConfig.KillReward
	local econ = Services.EconomyService
	local rate = econ and econ.IncomeRate(killer) or 0
	local cash = math.max(reward.Min, math.floor(rate * reward.Minutes * 60))
	if econ and cash > 0 then
		econ.Earn(killer, cash, "Arena")
	end
	local level = Services.LevelService
	if level and reward.XP > 0 then
		level.Add(killer, reward.XP, "Arena")
	end
	Net.signal(killer, "CombatReward", { Cash = cash, XP = reward.XP, Victim = victim.DisplayName })
	Net.notify(killer, "success", string.format("KNOCKOUT! %s  +$%s  +%d XP", victim.DisplayName, Format.abbreviate(cash), reward.XP))
end

local function knockOut(victim: Player, vf: Fighter, killer: Player?)
	vf.Dead = true
	vf.HP = 0
	vf.RespawnAt = now() + CombatConfig.RespawnDelay
	victim:SetAttribute("HP", 0)
	victim:SetAttribute("Downed", true)
	Data.Increment(victim, { "Stats", "ArenaDeaths" }, 1)
	-- to a respawn pad (nobody is standing next to it), held there until the delay is over
	local mount = Services.MountService
	local comp = ridden(victim)
	if comp and mount then
		local pad = pickRespawn(victim)
		local hip = comp.Model:GetAttribute("HipHeight") or 5
		local pos = Vector3.new(pad.X, pad.Y + 2 + hip, pad.Z)
		local centre = CombatConfig.arenaWorld()
		mount.MoveTo(victim, CFrame.lookAt(pos, Vector3.new(centre.X, pos.Y, centre.Z)))
		mount.Freeze(victim, true)
	end
	toNear("CombatKO", {
		Victim = victim.UserId,
		Killer = killer and killer.UserId or 0,
		VictimName = victim.DisplayName,
		KillerName = killer and killer.DisplayName or "",
	})
	Net.signal(victim, "CombatDown", { Delay = CombatConfig.RespawnDelay, By = killer and killer.DisplayName or "" })
	if killer and killer ~= victim then
		pay(killer, victim)
	end
end

local function damage(target: Player, amount: number, attacker: Player, kind: string, crit: boolean, at: Vector3): boolean
	local tf = fighters[target]
	if not tf or tf.Dead or now() < tf.Invuln then
		return false
	end
	local dealt = math.max(1, math.floor(amount + 0.5))
	tf.HP = math.max(0, tf.HP - dealt)
	tf.LastHit = now()
	setHP(target, tf)
	toNear("CombatHit", { Target = target.UserId, By = attacker.UserId, Damage = dealt, Crit = crit, Kind = kind, Pos = at })
	local mount = Services.MountService
	if mount and mount.PlayShot then
		mount.PlayShot(target, "Hurt")
	end
	if tf.HP <= 0 then
		knockOut(target, tf, attacker)
	end
	return true
end

-- The dummy is for practice: it only takes hits while nobody else stands in the arena, so in a duel
-- it never gets in the way (strikes and fireballs pass through it).
local function practicing(player: Player): boolean
	for other, f in fighters do
		if other ~= player and not f.Dead then
			return false
		end
	end
	return true
end

-- The training dummy: same damage rules, no reward, it does not hit back.
local function damageDummy(amount: number, attacker: Player, kind: string, crit: boolean, at: Vector3): boolean
	local cfg = CombatConfig.Dummy
	if dummy.Down then
		return false
	end
	local dealt = math.max(1, math.floor(amount + 0.5))
	dummy.HP = math.max(0, dummy.HP - dealt)
	if dummy.Model then
		dummy.Model:SetAttribute("HP", dummy.HP)
	end
	toNear("CombatHit", { Target = 0, By = attacker.UserId, Damage = dealt, Crit = crit, Kind = kind, Pos = at })
	if dummy.HP <= 0 then
		dummy.Down = true
		dummy.RespawnAt = now() + cfg.Respawn
		if dummy.Model then
			dummy.Model:SetAttribute("Down", true)
		end
		toNear("CombatKO", { Victim = 0, Killer = attacker.UserId, VictimName = cfg.Name, KillerName = attacker.DisplayName })
	end
	return true
end

-- ============================================================== attacks
local function attackReady(player: Player, kind: string)
	local f = fighters[player]
	local comp = ridden(player)
	if not f or f.Dead or not comp then
		return nil
	end
	local t = now()
	if kind == "Strike" then
		if t < f.NextStrike then
			return nil
		end
		f.NextStrike = t + CombatConfig.Strike.Cooldown * 0.9 -- a little slack for latency
	else
		if t < f.NextBlast then
			return nil
		end
		f.NextBlast = t + CombatConfig.Blast.Cooldown * 0.9
	end
	return f, comp
end

function CombatService.Strike(player: Player): boolean
	local f, comp = attackReady(player, "Strike")
	if not f then
		return false
	end
	local cfg = CombatConfig.Strike
	local root = comp.Root
	local forward = root.CFrame.LookVector
	local origin = root.Position
	local mount = Services.MountService
	mount.PlayShot(player, "Strike")
	toNear("CombatFx", { Kind = "Strike", From = player.UserId, Pos = origin, Dir = forward })
	local base = CombatConfig.baseDamage(f.Level, f.Rank) * cfg.Multiplier
	local cosLimit = math.cos(math.rad(cfg.Cone))
	for other, of in table.clone(fighters) do
		if other ~= player and not of.Dead then
			local ocomp = ridden(other)
			if ocomp then
				local delta = ocomp.Root.Position - origin
				local dist = delta.Magnitude
				if dist > 0.1 and dist <= cfg.Reach + of.Radius + f.Radius and delta.Unit:Dot(forward) >= cosLimit then
					local crit = math.random() < cfg.Crit
					damage(other, base * (crit and 1.5 or 1), player, "Strike", crit, ocomp.Root.Position)
				end
			end
		end
	end
	-- the dummy
	local target = CombatConfig.dummyWorld()
	local delta = target - origin
	local dist = delta.Magnitude
	if dist > 0.1 and dist <= cfg.Reach + CombatConfig.Dummy.Radius + f.Radius and delta.Unit:Dot(forward) >= cosLimit and practicing(player) then
		local crit = math.random() < cfg.Crit
		damageDummy(base * (crit and 1.5 or 1), player, "Strike", crit, target)
	end
	return true
end

-- The aim the client claims is trusted only within MaxAimSlack degrees of where the dragon points.
local function aimDirection(forward: Vector3, claimed: any): Vector3
	if typeof(claimed) ~= "Vector3" or claimed.Magnitude < 0.1 or claimed.Magnitude ~= claimed.Magnitude then
		return forward
	end
	local want = claimed.Unit
	local angle = math.acos(math.clamp(want:Dot(forward), -1, 1))
	local limit = math.rad(CombatConfig.MaxAimSlack)
	if angle <= limit then
		return want
	end
	local sideways = want - forward * want:Dot(forward)
	if sideways.Magnitude < 1e-3 then
		return forward
	end
	return (forward * math.cos(limit) + sideways.Unit * math.sin(limit)).Unit
end

function CombatService.Blast(player: Player, claimed: any?): boolean
	local f, comp = attackReady(player, "Blast")
	if not f then
		return false
	end
	local cfg = CombatConfig.Blast
	local root = comp.Root
	local dir = aimDirection(root.CFrame.LookVector, claimed)
	local origin = root.Position + dir * (f.Radius + 3)
	nextBlastId += 1
	local b = {
		Id = nextBlastId,
		Owner = player,
		Pos = origin,
		Dir = dir,
		Born = now(),
		Damage = CombatConfig.baseDamage(f.Level, f.Rank) * cfg.Multiplier,
	}
	table.insert(blasts, b)
	Services.MountService.PlayShot(player, "Cast")
	toNear("CombatFx", { Kind = "Blast", Id = b.Id, From = player.UserId, Pos = origin, Dir = dir, Speed = cfg.Speed, Life = cfg.Lifetime })
	return true
end

local function stepBlasts(dt: number)
	local cfg = CombatConfig.Blast
	local t = now()
	for i = #blasts, 1, -1 do
		local b = blasts[i]
		local prev = b.Pos
		local nextPos = prev + b.Dir * (cfg.Speed * dt)
		local seg = nextPos - prev
		local segLen2 = seg:Dot(seg)
		local hitPlayer: Player? = nil
		local hitDummy = false
		local hitAt = nextPos
		local bestT = 2
		do
			local c = CombatConfig.dummyWorld()
			local u = segLen2 > 0 and math.clamp((c - prev):Dot(seg) / segLen2, 0, 1) or 0
			local closest = prev + seg * u
			if not dummy.Down and (closest - c).Magnitude <= cfg.Radius + CombatConfig.Dummy.Radius and practicing(b.Owner) then
				bestT, hitDummy, hitAt = u, true, closest
			end
		end
		for other, of in fighters do
			if other ~= b.Owner and not of.Dead then
				local comp = ridden(other)
				if comp then
					local c = comp.Root.Position
					local u = segLen2 > 0 and math.clamp((c - prev):Dot(seg) / segLen2, 0, 1) or 0
					local closest = prev + seg * u
					if (closest - c).Magnitude <= cfg.Radius + of.Radius and u < bestT then
						bestT, hitPlayer, hitDummy, hitAt = u, other, false, closest
					end
				end
			end
		end
		if hitPlayer or hitDummy then
			table.remove(blasts, i)
			local crit = math.random() < CombatConfig.Strike.Crit
			if hitPlayer then
				damage(hitPlayer, b.Damage * (crit and 1.5 or 1), b.Owner, "Blast", crit, hitAt)
			else
				damageDummy(b.Damage * (crit and 1.5 or 1), b.Owner, "Blast", crit, hitAt)
			end
			toNear("CombatBlastEnd", { Id = b.Id, Pos = hitAt, Hit = true })
		elseif t - b.Born >= cfg.Lifetime or not insideArena(nextPos, 30) then
			table.remove(blasts, i)
			toNear("CombatBlastEnd", { Id = b.Id, Pos = nextPos, Hit = false })
		else
			b.Pos = nextPos
		end
	end
end

-- ============================================================== lifecycle
function CombatService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.onEvent("CombatStrike", function(player)
		CombatService.Strike(player)
	end, { Burst = 4, PerSecond = 2 })
	Net.onEvent("CombatBlast", function(player, p)
		CombatService.Blast(player, p and p.Dir)
	end, { Burst = 3, PerSecond = 1 })
end

-- The fighter record of a player (nil when not in the arena): other services / tests.
function CombatService.Fighter(player: Player): Fighter?
	return fighters[player]
end

function CombatService.Active(player: Player): boolean
	return fighters[player] ~= nil
end

function CombatService._blasts()
	return blasts
end

function CombatService._dummy()
	return dummy
end

function CombatService._zone()
	zoneStep()
end

function CombatService._step(dt: number)
	stepBlasts(dt)
end

function CombatService.Start()
	-- the dummy model is built with the island (RaceService): find it and give it its hit points
	task.spawn(function()
		for _ = 1, 120 do
			local m = Workspace:FindFirstChild("TrainingDummy", true)
			if m and m:IsA("Model") then
				dummy.Model = m
				m:SetAttribute("MaxHP", CombatConfig.Dummy.HP)
				m:SetAttribute("HP", dummy.HP)
				return
			end
			task.wait(1)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		fighters[player] = nil
		for i = #blasts, 1, -1 do
			if blasts[i].Owner == player then
				table.remove(blasts, i)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(CombatConfig.ZoneSeconds)
			local ok, err = pcall(zoneStep)
			if not ok then
				warn("[Combat] zone: " .. tostring(err))
			end
		end
	end)
	task.spawn(function()
		local last = now()
		while true do
			task.wait(CombatConfig.Blast.Step)
			local t = now()
			local dt = math.clamp(t - last, 0.01, 0.2)
			last = t
			if #blasts > 0 then
				local ok, err = pcall(stepBlasts, dt)
				if not ok then
					warn("[Combat] blast: " .. tostring(err))
				end
			end
		end
	end)
end

return CombatService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000073">
				<Properties>
					<string name="Name">DailyService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DailyService
	Daily rewards with a streak (DailyConfig). Data: data.Daily = { LastClaim = unix time, Streak = n }.

	  * a day is a UTC day; a reward can be claimed once per day
	  * claimed yesterday or today = the streak lives; a whole day missed = it starts again at 1
	  * the streak decides which day of the 7-day calendar pays (day = (streak - 1) % 7 + 1)

	Net (domain "Daily"):
	  State {} -> { CanClaim, Streak, Day, ClaimedToday, SecondsLeft, Days = { { Cash, Spins, Boost, Egg, State } x7 } }
	    Day = the calendar day that pays on the next claim (or paid today); Days[i].State = "Done" | "Today" | "Next" | "Later"
	  Claim {} -> { Day, Streak, Cash, Spins, Boost, Egg }
	Signal "DailyReady" {} to a player who joins with a reward waiting.
	Test hook: DailyService.Status(player, now).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local DailyConfig = require(Configs:WaitForChild("DailyConfig"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))

local DailyService = {}

local Data
local Services

local function now(): number
	return os.time()
end

-- Where the player stands: can they claim, which day pays, how long until the next day.
function DailyService.Status(player: Player, t: number?)
	local data = Data.Get(player)
	if not data then
		return nil
	end
	local time = t or now()
	local daily = data.Daily or { LastClaim = 0, Streak = 0 }
	local today = DailyConfig.dayOf(time)
	local last = daily.LastClaim or 0
	local lastDay = last > 0 and DailyConfig.dayOf(last) or -100
	local alive = today - lastDay <= 1
	local streak = alive and (daily.Streak or 0) or 0
	local claimedToday = lastDay == today
	local cycle = DailyConfig.Cycle
	local day
	if claimedToday then
		day = (math.max(1, streak) - 1) % cycle + 1 -- the day that paid today
	else
		day = streak % cycle + 1 -- the day that pays now
	end
	return {
		CanClaim = not claimedToday,
		ClaimedToday = claimedToday,
		Streak = streak,
		Day = day,
		SecondsLeft = claimedToday and ((today + 1) * DailyConfig.SecondsPerDay - time) or 0,
	}
end

local function rewardOf(player: Player, day: number, streak: number)
	local def = DailyConfig.Days[day]
	local income = Services.EconomyService.IncomeRate(player)
	local reward = {}
	if def.Cash then
		reward.Cash = DailyConfig.cash(day, income, streak)
	end
	if def.Spins then
		reward.Spins = def.Spins
	end
	if def.Boost then
		reward.Boost = { Id = def.Boost.Id, Seconds = def.Boost.Seconds }
	end
	if def.Egg then
		reward.Egg = { Type = def.Egg.Type, Luck = def.Egg.Luck }
	end
	return reward
end

local function handleState(player: Player)
	local st = DailyService.Status(player)
	if not st then
		return false, "NOT_LOADED"
	end
	-- the completed streak the day's cash bonus follows (before today's claim)
	local before = math.max(0, st.ClaimedToday and st.Streak - 1 or st.Streak)
	local days = {}
	for i = 1, DailyConfig.Cycle do
		local entry = rewardOf(player, i, before)
		if i < st.Day or (i == st.Day and st.ClaimedToday) then
			entry.State = "Done"
		elseif i == st.Day then
			entry.State = "Today"
		elseif i == st.Day + 1 then
			entry.State = "Next"
		else
			entry.State = "Later"
		end
		days[i] = entry
	end
	return true, {
		CanClaim = st.CanClaim,
		Streak = st.Streak,
		Day = st.Day,
		ClaimedToday = st.ClaimedToday,
		SecondsLeft = st.SecondsLeft,
		Bonus = DailyConfig.bonus(before),
		Days = days,
	}
end

local function handleClaim(player: Player)
	local data = Data.Get(player)
	local st = DailyService.Status(player)
	if not data or not st then
		return false, "NOT_LOADED"
	end
	if not st.CanClaim then
		return false, "ALREADY_CLAIMED", "You already took today's reward. Come back tomorrow!"
	end
	local newStreak = st.Streak + 1
	local day = (newStreak - 1) % DailyConfig.Cycle + 1
	local reward = rewardOf(player, day, st.Streak)
	Data.Set(player, { "Daily" }, { LastClaim = now(), Streak = newStreak })
	local parts = {}
	if reward.Cash then
		Services.EconomyService.Earn(player, reward.Cash, "Daily")
		table.insert(parts, Format.cash(reward.Cash))
	end
	if reward.Spins then
		Services.SpinService.AddTickets(player, reward.Spins)
		table.insert(parts, string.format("%d spin%s", reward.Spins, reward.Spins == 1 and "" or "s"))
	end
	if reward.Boost then
		Services.BoostService.Add(player, reward.Boost.Id, reward.Boost.Seconds)
		table.insert(parts, string.format("%d min boost", reward.Boost.Seconds // 60))
	end
	if reward.Egg then
		local ok = Services.EggService.GiveEgg(player, reward.Egg.Type, reward.Egg.Luck, true)
		local def = EggConfig.Eggs[reward.Egg.Type]
		if ok then
			table.insert(parts, string.format("%s x%d", def and def.Name or "egg", reward.Egg.Luck))
		end
	end
	Net.notify(player, "rare", string.format("DAILY REWARD  day %d  (streak %d):  %s", day, newStreak, table.concat(parts, "  +  ")))
	return true, { Day = day, Streak = newStreak, Cash = reward.Cash, Spins = reward.Spins, Boost = reward.Boost, Egg = reward.Egg }
end

function DailyService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.handle("Daily", "State", handleState, { Burst = 6, PerSecond = 2 })
	Net.handle("Daily", "Claim", handleClaim, { Burst = 3, PerSecond = 1 })
end

function DailyService.Start()
	-- a reward is waiting: the HUD lights the DAILY button
	Data.Loaded:Connect(function(player)
		task.delay(3, function()
			local st = player.Parent and DailyService.Status(player)
			if st and st.CanClaim then
				Net.signal(player, "DailyReady", {})
			end
		end)
	end)
	-- ...and again when the day turns over for players who stay online
	task.spawn(function()
		local lastDay = DailyConfig.dayOf(now())
		while true do
			task.wait(30)
			local today = DailyConfig.dayOf(now())
			if today ~= lastDay then
				lastDay = today
				for _, player in Players:GetPlayers() do
					local st = DailyService.Status(player)
					if st and st.CanClaim then
						Net.signal(player, "DailyReady", {})
					end
				end
			end
		end
	end)
end

return DailyService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000074">
				<Properties>
					<string name="Name">DevService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DevService
	Studio-only test helpers for playtesting (UI Lab "TEST" buttons).
	Nothing is registered on live servers: every handler is behind
	RunService:IsStudio(), so clients can never reach these in a real game.

	Net (domain "Dev"): Cash, Dragons, Eggs, HatchNow, WildEgg, BondMax, Banner, RaceTime, RaceChampion
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))
local EconomyConfig = require(Configs:WaitForChild("EconomyConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local MutationConfig = require(Configs:WaitForChild("MutationConfig"))
local RaceConfig = require(Configs:WaitForChild("RaceConfig"))

local DevService = {}

local RATE = { Burst = 4, PerSecond = 1 }

function DevService.Init(services)
	if not RunService:IsStudio() then
		return
	end
	local Data = services.PlayerDataService
	local rng = Random.new()

	Net.handle("Dev", "Cash", function(player)
		services.EconomyService.Earn(player, 1000000, "Dev")
		return true
	end, RATE)

	Net.handle("Dev", "Dragons", function(player)
		-- one of every species, cycling through every mutation (test kit)
		local data = Data.Get(player)
		if not data then
			return false, "NOT_LOADED"
		end
		local maxLevel = #EconomyConfig.Upgrades.DragonStorage.Levels - 1
		if (data.Upgrades.DragonStorage or 0) < maxLevel then
			Data.Set(player, { "Upgrades", "DragonStorage" }, maxLevel)
		end
		local list = DragonConfig.speciesList()
		local muts = MutationConfig.Order
		local added = 0
		local i = 0
		for _, species in list do
			if not DragonConfig.Species[species].Exclusive then
				i += 1
				local mutation = muts[((i - 1) % #muts) + 1]
				if services.DragonService.Add(player, species, mutation, "Dev") then
					added += 1
				end
			end
		end
		if added == 0 then
			return false, "STORAGE_FULL", "Your dragon storage is full."
		end
		return true, { Added = added }
	end, RATE)

	Net.handle("Dev", "Eggs", function(player)
		local data = Data.Get(player)
		if not data then
			return false, "NOT_LOADED"
		end
		local cap = TreeConfig.eggCapacity(data)
		local types = {}
		for id in EggConfig.Eggs do
			table.insert(types, id)
		end
		table.sort(types)
		local eggs = table.clone(data.Eggs)
		while #eggs < cap do
			local id = Data.NextId(player, "EggSerial", "E")
			local eggType = types[rng:NextInteger(1, #types)]
			table.insert(eggs, { Id = id, Type = eggType, Found = os.time(), Luck = EggConfig.rollLuck(eggType, rng, true) })
		end
		Data.Set(player, { "Eggs" }, eggs)
		return true
	end, RATE)

	Net.handle("Dev", "HatchNow", function(player)
		local data = Data.Get(player)
		if not data then
			return false, "NOT_LOADED"
		end
		local t = os.time()
		for key, slot in data.Incubator.Slots do
			local copy = table.clone(slot)
			copy.Ready = math.min(copy.Ready, t)
			copy.Start = math.min(copy.Start, t - 1)
			Data.Set(player, { "Incubator", "Slots", key }, copy)
		end
		return true
	end, RATE)

	-- a Lucky Wild Egg right now (payload Tier = Lucky | Epic | Mythic | Rainbow, default random)
	Net.handle("Dev", "WildEgg", function(_player, p)
		local wild = services.WildEggService
		if not wild then
			return false, "NO_SERVICE"
		end
		local tier = type(p) == "table" and type(p.Tier) == "string" and p.Tier or nil
		if not wild.Spawn(tier) then
			return false, "BUSY", "A wild egg is already out (or there is no free egg area yet)."
		end
		return true
	end, RATE)

	-- max Dragon Bond on the equipped dragon (try Dash / Fire Breath / Dance / Aura at once)
	Net.handle("Dev", "BondMax", function(player)
		local data = Data.Get(player)
		local uid = data and data.EquippedDragon
		if not uid or uid == "" or not data.Dragons[uid] then
			return false, "NO_DRAGON", "Equip a dragon first."
		end
		services.BondService.AddPoints(player, uid, 1e9)
		return true
	end, RATE)

	-- the server-wide ultra-rare banner, immediately
	Net.handle("Dev", "Banner", function(player)
		Net.broadcast("RareHatch", {
			Player = player.DisplayName,
			UserId = player.UserId,
			Species = "VoidDragon",
			Mutation = "Rainbow",
			Rarity = "Secret",
			Odds = 12500000,
			Mega = true,
		})
		return true
	end, RATE)

	-- Race Island: a fake best time (the boards and the window show it) ...
	Net.handle("Dev", "RaceTime", function(player)
		local ms = 41234 + math.random(0, 3000)
		Data.Set(player, { "Race", "Best" }, ms)
		Data.Set(player, { "Race", "MonthKey" }, RaceConfig.monthKey())
		Data.Set(player, { "Race", "MonthBest" }, ms)
		Data.Increment(player, { "Race", "Runs" }, 1)
		return true
	end, RATE)

	-- ... and the monthly champion ceremony (banner, podium, trophy, reward)
	Net.handle("Dev", "RaceChampion", function(player)
		local race = services.RaceService
		if not race or not race.DevCrown then
			return false, "NO_RACE"
		end
		race.DevCrown(player)
		return true
	end, RATE)

	ReplicatedStorage:SetAttribute("DevTools", true)
end

return DevService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000075">
				<Properties>
					<string name="Name">DragonAssetService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DragonAssetService
	Collects skinned dragon mesh templates (imported .glb models) into
	ReplicatedStorage.DragonModels so every client can clone them.

	Importing in Studio (Avatar/Home > Import 3D) drops the model into
	Workspace under the species id (e.g. "GreenDrake"). Templates may be left
	there or dragged into ReplicatedStorage / ReplicatedStorage.DragonModels;
	at server start they are moved into DragonModels automatically.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Dragons = ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Dragons")
local DragonVisual = require(Dragons:WaitForChild("DragonVisual"))
local Species = require(Dragons:WaitForChild("Species"))
local DragonConfig = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("DragonConfig"))

local DragonAssetService = {}

local function speciesIds(): { string }
	local ids = {}
	local seen = {}
	for id in Species.Defs do
		if not seen[id] then
			seen[id] = true
			table.insert(ids, id)
		end
	end
	for id in DragonConfig.Species or {} do
		if not seen[id] then
			seen[id] = true
			table.insert(ids, id)
		end
	end
	return ids
end

local function adopt(folder: Folder, container: Instance, id: string)
	local m = container:FindFirstChild(id)
	if m and m:IsA("Model") and m.Parent ~= folder and DragonVisual.findRig(m) then
		if folder:FindFirstChild(id) then
			return
		end
		for _, d in m:GetDescendants() do
			if d:IsA("BasePart") then
				d.Anchored = true
				d.CanCollide = false
				d.CanQuery = false
				d.CanTouch = false
			end
		end
		m.Parent = folder
	end
end

function DragonAssetService.Init()
	local folder = ReplicatedStorage:FindFirstChild("DragonModels")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "DragonModels"
		folder.Parent = ReplicatedStorage
	end
	for _, id in speciesIds() do
		adopt(folder :: Folder, Workspace, id)
		adopt(folder :: Folder, ReplicatedStorage, id)
	end
	-- nature props (HavenProps.glb import) -> ReplicatedStorage.WorldProps
	if not ReplicatedStorage:FindFirstChild("WorldProps") then
		for _, container in { Workspace, ReplicatedStorage } do
			local m = container:FindFirstChild("HavenProps")
			if m and m:IsA("Model") and m:FindFirstChildWhichIsA("MeshPart", true) then
				for _, d in m:GetDescendants() do
					if d:IsA("BasePart") then
						d.Anchored = true
					end
				end
				m.Name = "WorldProps"
				m.Parent = ReplicatedStorage
				break
			end
		end
	end
	local count = 0
	for _, t in folder:GetChildren() do
		if DragonVisual.findRig(t) then
			count += 1
		end
	end
	ReplicatedStorage:SetAttribute("MeshDragonTemplates", count)
end

return DragonAssetService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000076">
				<Properties>
					<string name="Name">DragonService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DragonService
	Authoritative dragon inventory. Every dragon is a record with a unique id
	(see DragonStats.newRecord). Clients only send ids (and perch numbers);
	all validation, stats and costs are computed here.

	API (server):
	  DragonService.Add(player, speciesId, mutation?, source?) -> record?, err?
	  DragonService.Remove(player, uid) -> boolean
	  DragonService.Get(player, uid) -> record?
	  DragonService.Count(player), DragonService.Capacity(player)
	  DragonService.Equip(player, uid) -> ok, err
	Signals: Added(player, record), Removed(player, uid),
	         EquippedChanged(player, uid), PlacedChanged(player)

	Net (domain "Dragon"):
	  Equip { Id }            Unequip {}
	  Lock { Id, Locked }     Sell { Id }               -> { Refund }   (Release = old name)
	  SellBulk { Ids }        -> { Sold, Cash, Skipped }
	  Feed { Id }             -> { Levels, Level, Cost }
	  Mutate { Id }           -> { Improved, Mutation, Cost }
	  Place { Id, Slot? }     -> { Slot, Swapped? }     (sanctuary perch)
	  TakeBack { Id }         AutoPlace {}              -> { Placed }
	  BuyPerch {}             -> { Unlocked }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local DragonStats = require(Shared:WaitForChild("DragonStats"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local EconomyConfig = require(Configs:WaitForChild("EconomyConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))
local WorldConfig = require(Configs:WaitForChild("WorldConfig"))

local DragonService = {}
DragonService.Added = Signal.new()
DragonService.Removed = Signal.new()
DragonService.EquippedChanged = Signal.new()
DragonService.PlacedChanged = Signal.new() -- (player) perches changed (place / take back / level / mutation)

local Data -- PlayerDataService
local Services

local STARTER_SPECIES = "GreenDrake"
local rng = Random.new()

local function now(): number
	return os.time()
end

local function maxPerches(): number
	return math.min(#EconomyConfig.NestPrices, WorldConfig.Sanctuary.PerchCount)
end

local function spend(player: Player, amount: number, reason: string): boolean
	return Services.EconomyService.Spend(player, amount, reason)
end

-- Is the player currently riding this dragon?
local function ridingThis(player: Player, uid: string): boolean
	local mount = Services.MountService
	if not mount or not mount.IsRiding(player) then
		return false
	end
	local comp = mount.Get(player)
	return comp ~= nil and comp.Uid == uid
end

function DragonService.Get(player: Player, uid: any)
	if type(uid) ~= "string" then
		return nil
	end
	local data = Data.Get(player)
	return data and data.Dragons[uid] or nil
end

function DragonService.Count(player: Player): number
	local data = Data.Get(player)
	if not data then
		return 0
	end
	local n = 0
	for _ in data.Dragons do
		n += 1
	end
	return n
end

function DragonService.Capacity(player: Player): number
	local data = Data.Get(player)
	local level = data and data.Upgrades.DragonStorage or 0
	return EconomyConfig.upgradeValue("DragonStorage", level)
end

local function discover(player: Player, data, key: string)
	if not data.Index[key] then
		Data.Set(player, { "Index", key }, { First = now(), Count = 1 })
	else
		Data.Update(player, { "Index", key }, function(entry)
			entry = entry or { First = now(), Count = 0 }
			entry.Count = (entry.Count or 0) + 1
			return entry
		end)
	end
end

function DragonService.Add(player: Player, speciesId: string, mutation: string?, source: string?, force: boolean?)
	local data = Data.Get(player)
	if not data then
		return nil, "NOT_LOADED"
	end
	if not DragonConfig.Species[speciesId] then
		return nil, "BAD_SPECIES"
	end
	if not force and DragonService.Count(player) >= DragonService.Capacity(player) then
		return nil, "STORAGE_FULL"
	end
	local uid = Data.NextId(player, "DragonSerial", "D")
	local record = DragonStats.newRecord(uid, speciesId, mutation, now())
	Data.Set(player, { "Dragons", uid }, record)
	-- discovery index (species, and species+mutation)
	discover(player, data, speciesId)
	if mutation and mutation ~= "None" then
		discover(player, data, speciesId .. ":" .. mutation)
	end
	if source == "Hatch" then
		Data.Increment(player, { "Stats", "Hatched" }, 1)
	end
	DragonService.Added:Fire(player, record)
	return record
end

function DragonService.Remove(player: Player, uid: string): boolean
	local data = Data.Get(player)
	if not data or not data.Dragons[uid] then
		return false
	end
	if data.EquippedDragon == uid then
		Data.Set(player, { "EquippedDragon" }, "")
		DragonService.EquippedChanged:Fire(player, "")
	end
	-- free the perch it rested on
	local wasPlaced = false
	for slot, id in data.Nests.Slots do
		if id == uid then
			Data.Set(player, { "Nests", "Slots", slot }, nil)
			wasPlaced = true
		end
	end
	Data.Set(player, { "Dragons", uid }, nil)
	DragonService.Removed:Fire(player, uid)
	if wasPlaced then
		DragonService.PlacedChanged:Fire(player)
	end
	return true
end

function DragonService.Equip(player: Player, uid: string)
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	local record = data.Dragons[uid]
	if not record then
		return false, "NOT_FOUND"
	end
	if record.PlacedNestId ~= "" then
		return false, "PLACED", "This dragon is resting in your sanctuary. Take it back first."
	end
	if data.EquippedDragon == uid then
		return true
	end
	Data.Set(player, { "EquippedDragon" }, uid)
	DragonService.EquippedChanged:Fire(player, uid)
	return true
end

-- ============================================================== starter / equip upkeep
local function grantStarter(player: Player, data)
	if data.Flags.StarterGranted then
		return
	end
	local record = DragonService.Add(player, STARTER_SPECIES, "None", "Starter")
	if record then
		Data.Set(player, { "Flags", "StarterGranted" }, true)
		Data.Set(player, { "EquippedDragon" }, record.UniqueId)
		DragonService.EquippedChanged:Fire(player, record.UniqueId)
	end
end

-- Makes sure the equipped dragon still exists and is free; otherwise equips
-- the best free dragon (none when every dragon rests on a perch). Returns true
-- when the equipped dragon changed.
local function validateEquipped(player: Player, data): boolean
	local before = data.EquippedDragon
	local uid = before
	if uid ~= "" and (not data.Dragons[uid] or data.Dragons[uid].PlacedNestId ~= "") then
		uid = ""
	end
	if uid == "" then
		local best, bestScore = nil, -math.huge
		for id, rec in data.Dragons do
			if rec.PlacedNestId == "" then
				local s = DragonStats.score(rec)
				if s > bestScore then
					best, bestScore = id, s
				end
			end
		end
		uid = best or ""
	end
	if uid ~= before then
		Data.Set(player, { "EquippedDragon" }, uid)
		return true
	end
	return false
end

-- ============================================================== perches
local function setPlaced(player: Player, uid: string, slot: string)
	Data.Set(player, { "Nests", "Slots", slot }, uid)
	Data.Set(player, { "Dragons", uid, "PlacedNestId" }, slot)
end

local function clearPlaced(player: Player, uid: string)
	local data = Data.Get(player)
	local record = data.Dragons[uid]
	if not record or record.PlacedNestId == "" then
		return
	end
	local slot = record.PlacedNestId
	if data.Nests.Slots[slot] == uid then
		Data.Set(player, { "Nests", "Slots", slot }, nil)
	end
	Data.Set(player, { "Dragons", uid, "PlacedNestId" }, "")
end

local function freePerch(data): number?
	for i = 1, math.min(data.Nests.Unlocked, maxPerches()) do
		if data.Nests.Slots[tostring(i)] == nil then
			return i
		end
	end
	return nil
end

-- Places `uid` on perch `slot` (swapping out any dragon already there).
local function placeOn(player: Player, data, uid: string, slot: number): (boolean, string?, string?, any)
	local key = tostring(slot)
	local swapped = nil
	local occupant = data.Nests.Slots[key]
	if occupant and occupant ~= uid then
		clearPlaced(player, occupant)
		swapped = occupant
	end
	clearPlaced(player, uid)
	setPlaced(player, uid, key)
	if validateEquipped(player, data) then
		DragonService.EquippedChanged:Fire(player, data.EquippedDragon)
	end
	DragonService.PlacedChanged:Fire(player)
	return true, nil, nil, { Slot = slot, Swapped = swapped }
end

-- Nobody is out (every dragon rests on a perch): brings the strongest one down and equips it.
-- Returns the equipped uid (nil when there is no dragon at all).
function DragonService.EquipBest(player: Player): string?
	local data = Data.Get(player)
	if not data then
		return nil
	end
	local current = data.EquippedDragon
	if current ~= "" and data.Dragons[current] then
		return current
	end
	local best, bestScore = nil, -math.huge
	for uid, rec in data.Dragons do
		local s = DragonStats.score(rec)
		if s > bestScore then
			best, bestScore = uid, s
		end
	end
	if not best then
		return nil
	end
	if data.Dragons[best].PlacedNestId ~= "" then
		clearPlaced(player, best)
		DragonService.PlacedChanged:Fire(player)
	end
	DragonService.Equip(player, best)
	return best
end

-- ============================================================== net handlers
local function handleEquip(player: Player, p)
	if not Net.check.str(p.Id, 40) then
		return false, "BAD_REQUEST"
	end
	return DragonService.Equip(player, p.Id)
end

local function handleUnequip(player: Player)
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	if data.EquippedDragon ~= "" then
		Data.Set(player, { "EquippedDragon" }, "")
		DragonService.EquippedChanged:Fire(player, "")
	end
	return true
end

local function handleLock(player: Player, p)
	if not Net.check.str(p.Id, 40) or not Net.check.bool(p.Locked) then
		return false, "BAD_REQUEST"
	end
	local record = DragonService.Get(player, p.Id)
	if not record then
		return false, "NOT_FOUND"
	end
	Data.Set(player, { "Dragons", p.Id, "Locked" }, p.Locked)
	return true, { Locked = p.Locked }
end

-- Why a dragon cannot be sold right now (nil = it can): locked, exclusive, ridden.
local function saleBlock(player: Player, record, uid: string): (string?, string?)
	if record.Locked then
		return "LOCKED", "Unlock this dragon before selling it."
	end
	if not DragonStats.canSellSpecies(record.SpeciesId) then
		return "EXCLUSIVE", "Exclusive dragons cannot be sold."
	end
	if ridingThis(player, uid) then
		return "RIDING", "Dismount before selling the dragon you are riding."
	end
	return nil, nil
end

-- Sell { Id } (also: Release, the old name) -> { Refund }
local function handleSell(player: Player, p)
	if not Net.check.str(p.Id, 40) then
		return false, "BAD_REQUEST"
	end
	local data = Data.Get(player)
	local record = DragonService.Get(player, p.Id)
	if not data or not record then
		return false, "NOT_FOUND"
	end
	local code, msg = saleBlock(player, record, p.Id)
	if code then
		return false, code, msg
	end
	if DragonService.Count(player) <= 1 then
		return false, "LAST_DRAGON", "You can't sell your only dragon."
	end
	local refund = DragonStats.sellValue(record, data)
	DragonService.Remove(player, p.Id)
	Data.Increment(player, { "Stats", "Released" }, 1)
	if refund > 0 then
		Services.EconomyService.Earn(player, refund, "Sell")
	end
	if validateEquipped(player, Data.Get(player)) then
		DragonService.EquippedChanged:Fire(player, Data.Get(player).EquippedDragon)
	end
	return true, { Refund = refund }
end

-- SellBulk { Ids = { uid, ... } } -> { Sold, Cash, Skipped }
-- Sells every listed dragon that may be sold: not locked, not exclusive, not ridden, not the equipped
-- one and not resting on a perch (those are kept); one dragon always stays. At most BULK_MAX per call.
local BULK_MAX = 60
local function handleSellBulk(player: Player, p)
	if type(p.Ids) ~= "table" then
		return false, "BAD_REQUEST"
	end
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	local seen, ids = {}, {}
	for _, id in p.Ids do
		if Net.check.str(id, 40) and not seen[id] then
			seen[id] = true
			table.insert(ids, id)
			if #ids >= BULK_MAX then
				break
			end
		end
	end
	if #ids == 0 then
		return false, "BAD_REQUEST"
	end
	local total, sold, skipped = 0, 0, 0
	for _, id in ids do
		local record = DragonService.Get(player, id)
		local ok = record ~= nil
			and saleBlock(player, record, id) == nil
			and record.PlacedNestId == ""
			and data.EquippedDragon ~= id
			and DragonService.Count(player) > 1
		if ok then
			total += DragonStats.sellValue(record, data)
			DragonService.Remove(player, id)
			sold += 1
		else
			skipped += 1
		end
	end
	if sold > 0 then
		Data.Increment(player, { "Stats", "Released" }, sold)
		Services.EconomyService.Earn(player, total, "Sell")
		if validateEquipped(player, Data.Get(player)) then
			DragonService.EquippedChanged:Fire(player, Data.Get(player).EquippedDragon)
		end
	end
	return true, { Sold = sold, Cash = total, Skipped = skipped }
end

local function handleFeed(player: Player, p)
	if not Net.check.str(p.Id, 40) then
		return false, "BAD_REQUEST"
	end
	local data = Data.Get(player)
	local record = DragonService.Get(player, p.Id)
	if not data or not record then
		return false, "NOT_FOUND"
	end
	if record.Level >= DragonConfig.MaxLevel then
		return false, "MAX_LEVEL", "This dragon is fully grown."
	end
	local species = DragonConfig.Species[record.SpeciesId]
	local cost = EconomyConfig.feedCost(species.FeedCost, record.Level)
	if not spend(player, cost, "Feed") then
		return false, "NO_CASH", "Not enough cash to feed."
	end
	local copy = table.clone(record)
	local gained = DragonStats.addXP(copy, EconomyConfig.feedXP(DragonConfig.xpToNext(record.Level)))
	Data.Set(player, { "Dragons", p.Id }, copy)
	Data.Increment(player, { "Stats", "Fed" }, 1)
	if gained > 0 then
		if data.EquippedDragon == p.Id then
			DragonService.EquippedChanged:Fire(player, p.Id)
		end
		if copy.PlacedNestId ~= "" then
			DragonService.PlacedChanged:Fire(player)
		end
	end
	return true, { Levels = gained, Level = copy.Level, Cost = cost }
end

local function rollMutation(): string
	local total = 0
	for _, e in MutationConfig.MutateWeights do
		total += e.Weight
	end
	local r = rng:NextNumber() * total
	for _, e in MutationConfig.MutateWeights do
		r -= e.Weight
		if r <= 0 then
			return e.Id
		end
	end
	return MutationConfig.MutateWeights[1].Id
end

local function handleMutate(player: Player, p)
	if not Net.check.str(p.Id, 40) then
		return false, "BAD_REQUEST"
	end
	local data = Data.Get(player)
	local record = DragonService.Get(player, p.Id)
	if not data or not record then
		return false, "NOT_FOUND"
	end
	local current = record.Mutation or "None"
	if MutationConfig.rank(current) >= MutationConfig.MaxRank then
		return false, "MAX_MUTATION", "This dragon already has the rarest mutation."
	end
	local species = DragonConfig.Species[record.SpeciesId]
	local cost = MutationConfig.cost(species.Income, current)
	if not spend(player, cost, "Mutate") then
		return false, "NO_CASH", "Not enough cash to mutate."
	end
	Data.Increment(player, { "Stats", "MutateTries" }, 1)
	local rolled = rollMutation()
	if MutationConfig.rank(rolled) <= MutationConfig.rank(current) then
		return true, { Improved = false, Mutation = current, Rolled = rolled, Cost = cost }
	end
	local copy = table.clone(record)
	copy.Mutation = rolled
	DragonStats.refresh(copy)
	Data.Set(player, { "Dragons", p.Id }, copy)
	discover(player, data, record.SpeciesId .. ":" .. rolled)
	if data.EquippedDragon == p.Id then
		DragonService.EquippedChanged:Fire(player, p.Id)
	end
	if copy.PlacedNestId ~= "" then
		DragonService.PlacedChanged:Fire(player)
	end
	return true, { Improved = true, Mutation = rolled, Cost = cost }
end

-- Public helpers (potions / rewards) ------------------------------------
local function commitRecord(player: Player, data, uid: string, copy)
	DragonStats.refresh(copy)
	Data.Set(player, { "Dragons", uid }, copy)
	if data.EquippedDragon == uid then
		DragonService.EquippedChanged:Fire(player, uid)
	end
	if copy.PlacedNestId ~= "" then
		DragonService.PlacedChanged:Fire(player)
	end
end

function DragonService.SetMutation(player: Player, uid: string, mutation: string): boolean
	local data = Data.Get(player)
	local record = DragonService.Get(player, uid)
	if not data or not record or not MutationConfig.Mutations[mutation] then
		return false
	end
	local copy = table.clone(record)
	copy.Mutation = mutation
	commitRecord(player, data, uid, copy)
	if mutation ~= "None" then
		discover(player, data, record.SpeciesId .. ":" .. mutation)
	end
	return true
end

function DragonService.AddLevels(player: Player, uid: string, levels: number): number
	local data = Data.Get(player)
	local record = DragonService.Get(player, uid)
	if not data or not record then
		return 0
	end
	local copy = table.clone(record)
	local before = copy.Level
	copy.Level = math.min(DragonConfig.MaxLevel, copy.Level + math.max(0, math.floor(levels)))
	copy.XP = 0
	commitRecord(player, data, uid, copy)
	return copy.Level - before
end

-- The dragon a potion applies to: the equipped one, else the best earner.
function DragonService.PotionTarget(player: Player): string?
	local data = Data.Get(player)
	if not data then
		return nil
	end
	if data.EquippedDragon ~= "" and data.Dragons[data.EquippedDragon] then
		return data.EquippedDragon
	end
	local best, bestIncome = nil, -1
	for uid, r in data.Dragons do
		if r.IncomePerSecond > bestIncome then
			best, bestIncome = uid, r.IncomePerSecond
		end
	end
	return best
end

-- One guaranteed-better mutation roll (Mutation Potion).
function DragonService.UpgradeMutation(player: Player, uid: string): string?
	local record = DragonService.Get(player, uid)
	if not record then
		return nil
	end
	local rank = MutationConfig.rank(record.Mutation)
	if rank >= MutationConfig.MaxRank then
		return nil
	end
	local total = 0
	local pool = {}
	for _, e in MutationConfig.MutateWeights do
		if MutationConfig.rank(e.Id) > rank then
			total += e.Weight
			table.insert(pool, e)
		end
	end
	local r = Random.new():NextNumber() * total
	local pick = pool[#pool].Id
	for _, e in pool do
		r -= e.Weight
		if r <= 0 then
			pick = e.Id
			break
		end
	end
	DragonService.SetMutation(player, uid, pick)
	return pick
end

local function handlePlace(player: Player, p)
	if not Net.check.str(p.Id, 40) or (p.Slot ~= nil and not Net.check.int(p.Slot, 1, maxPerches())) then
		return false, "BAD_REQUEST"
	end
	local data = Data.Get(player)
	local record = DragonService.Get(player, p.Id)
	if not data or not record then
		return false, "NOT_FOUND"
	end
	local sanctuary = Services.SanctuaryService
	if sanctuary and not sanctuary.GetPlotId(player) then
		return false, "NO_PLOT", "You don't have a sanctuary in this server."
	end
	if ridingThis(player, p.Id) then
		return false, "RIDING", "Dismount before sending this dragon to rest."
	end
	local slot = p.Slot
	if slot then
		if slot > data.Nests.Unlocked then
			return false, "PERCH_LOCKED", "Unlock that perch first."
		end
		if record.PlacedNestId == tostring(slot) then
			return true, { Slot = slot }
		end
	else
		if record.PlacedNestId ~= "" then
			return true, { Slot = tonumber(record.PlacedNestId) }
		end
		slot = freePerch(data)
		if not slot then
			return false, "PERCHES_FULL", "All your perches are taken. Unlock more in your sanctuary."
		end
	end
	-- every dragon may rest on a perch, the last free one too: with nobody out, RIDE / EQUIP on a
	-- resting dragon (Inventory) takes it back first
	local ok, err, msg, result = placeOn(player, data, p.Id, slot)
	if not ok then
		return false, err, msg
	end
	return true, result
end

local function handleTakeBack(player: Player, p)
	if not Net.check.str(p.Id, 40) then
		return false, "BAD_REQUEST"
	end
	local record = DragonService.Get(player, p.Id)
	if not record then
		return false, "NOT_FOUND"
	end
	if record.PlacedNestId == "" then
		return true
	end
	clearPlaced(player, p.Id)
	DragonService.PlacedChanged:Fire(player)
	return true
end

-- Fills every free perch with the best free dragons (never the equipped one).
local function handleAutoPlace(player: Player)
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	local sanctuary = Services.SanctuaryService
	if sanctuary and not sanctuary.GetPlotId(player) then
		return false, "NO_PLOT", "You don't have a sanctuary in this server."
	end
	local candidates = {}
	for uid, rec in data.Dragons do
		if rec.PlacedNestId == "" and uid ~= data.EquippedDragon then
			table.insert(candidates, rec)
		end
	end
	table.sort(candidates, function(a, b)
		if a.IncomePerSecond ~= b.IncomePerSecond then
			return a.IncomePerSecond > b.IncomePerSecond
		end
		return a.UniqueId < b.UniqueId
	end)
	local placed = 0
	for _, rec in candidates do
		local slot = freePerch(data)
		if not slot then
			break
		end
		setPlaced(player, rec.UniqueId, tostring(slot))
		placed += 1
	end
	if placed == 0 then
		if not freePerch(data) then
			return false, "PERCHES_FULL", "All your perches are taken."
		end
		return false, "NOTHING", "No other dragons to place."
	end
	DragonService.PlacedChanged:Fire(player)
	return true, { Placed = placed }
end

local function handleBuyPerch(player: Player)
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	local nextSlot = data.Nests.Unlocked + 1
	if nextSlot > maxPerches() then
		return false, "MAXED", "All perches are unlocked."
	end
	local price = EconomyConfig.NestPrices[nextSlot]
	if not spend(player, price, "Perch") then
		return false, "NO_CASH", "You need " .. tostring(price) .. " coins to unlock this perch."
	end
	Data.Set(player, { "Nests", "Unlocked" }, nextSlot)
	DragonService.PlacedChanged:Fire(player)
	return true, { Unlocked = nextSlot }
end

-- ============================================================== lifecycle
function DragonService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.handle("Dragon", "Equip", handleEquip, { Burst = 6, PerSecond = 3 })
	Net.handle("Dragon", "Unequip", handleUnequip, { Burst = 4, PerSecond = 2 })
	Net.handle("Dragon", "Lock", handleLock, { Burst = 8, PerSecond = 4 })
	Net.handle("Dragon", "Sell", handleSell, { Burst = 6, PerSecond = 3 })
	Net.handle("Dragon", "Release", handleSell, { Burst = 6, PerSecond = 3 }) -- (old name of Sell)
	Net.handle("Dragon", "SellBulk", handleSellBulk, { Burst = 6, PerSecond = 2 })
	Net.handle("Dragon", "Feed", handleFeed, { Burst = 8, PerSecond = 5 })
	Net.handle("Dragon", "Mutate", handleMutate, { Burst = 6, PerSecond = 3 })
	Net.handle("Dragon", "Place", handlePlace, { Burst = 6, PerSecond = 3 })
	Net.handle("Dragon", "TakeBack", handleTakeBack, { Burst = 6, PerSecond = 3 })
	Net.handle("Dragon", "AutoPlace", handleAutoPlace, { Burst = 2, PerSecond = 0.5 })
	Net.handle("Dragon", "BuyPerch", handleBuyPerch, { Burst = 3, PerSecond = 1 })
end

function DragonService.Start()
	local function onLoaded(player: Player, data)
		-- refresh stats on load (balance changes / tamper safety); the client
		-- already has the snapshot, so changed records are re-sent
		for uid, rec in table.clone(data.Dragons) do
			local copy = table.clone(rec)
			if not DragonStats.refresh(copy) then
				Data.Set(player, { "Dragons", uid }, nil)
			else
				for k, v in copy do
					if rec[k] ~= v then
						Data.Set(player, { "Dragons", uid }, copy)
						break
					end
				end
			end
		end
		-- perches beyond the current layout (config changes) return to the bag
		for slot, uid in table.clone(data.Nests.Slots) do
			local n = tonumber(slot)
			if not n or n > math.min(data.Nests.Unlocked, maxPerches()) then
				Data.Set(player, { "Nests", "Slots", slot }, nil)
				if data.Dragons[uid] then
					Data.Set(player, { "Dragons", uid, "PlacedNestId" }, "")
				end
			end
		end
		grantStarter(player, data)
		validateEquipped(player, data)
		DragonService.EquippedChanged:Fire(player, data.EquippedDragon)
		DragonService.PlacedChanged:Fire(player)
	end
	Data.Loaded:Connect(onLoaded)
	for _, player in Players:GetPlayers() do
		local data = Data.Get(player)
		if data then
			onLoaded(player, data)
		end
	end
end

-- test hooks
DragonService._validateEquipped = validateEquipped

return DragonService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000077">
				<Properties>
					<string name="Name">DuelService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DuelService
	Turn-based dragon duels (DuelConfig): against an NPC trainer or another player. Server authority:
	the server keeps the match, rolls every hit and pays; the clients (DuelController) play the scene.

	Net (domain "Duel"):
	  Trainers {}            -> { List = { { Id, Name, Title, Level, Species preview..., Reward, Ready } }, Dragon = {..} | nil }
	  Start { Trainer }      -> match view (see view())
	  Challenge { UserId }   -> {} (the other player gets the signal DuelChallenge)
	  Respond { From, Accept } -> match view when accepted
	  Move { Id, Move }      -> { Waiting = true } (the result of the turn arrives as signal DuelTurn)
	  Forfeit { Id }         -> {}
	Signals to the players of a match:
	  DuelStart { match view }       DuelTurn { Id, Turn, Events = { ... }, State = { HP1, HP2, PP... } }
	  DuelEnd { Id, Winner = side, Reward = { Cash, XP }, Forfeit? }
	  DuelChallenge { From, Name, Expires }   DuelChallengeEnd { From, Reason }
	Player attributes: InDuel (true while in a match).

	A turn: both sides choose; GUARD goes first, then the faster dragon; a KO ends the match at once.
	Events of a turn: { Side, Move, Name, Hit, Damage, Crit, Eff, Guarded, Fail, Text, HP1, HP2 }.
	Test hooks: DuelService.Seed(n), DuelService.Match(player), DuelService.Resolve(match, choices).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local DragonStats = require(Shared:WaitForChild("DragonStats"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))
local DuelConfig = require(Configs:WaitForChild("DuelConfig"))

local DuelService = {}

local Data
local Services
local rng = Random.new()
local matches: { [string]: any } = {} -- by id
local byPlayer: { [Player]: any } = {}
local challenges: { [Player]: { From: Player, At: number } } = {} -- by the challenged player
local lastWin: { [Player]: { [string]: number } } = {} -- trainer cooldowns
local pairLast: { [string]: number } = {} -- last player duel of two players
local serial = 0

local function clock(): number
	return Workspace:GetServerTimeNow()
end

function DuelService.Seed(n: number)
	rng = Random.new(n)
end

-- ============================================================== fighters
local function specialOf(record): (string, string)
	if record.Mutation and record.Mutation ~= "None" then
		local m = MutationConfig.Mutations[record.Mutation]
		return "Burst", string.upper((m and m.Name or record.Mutation) .. " BURST")
	end
	return "Roar", "ROAR"
end

-- "Frost Dragon" / "Shiny Green Drake"
local function fullName(record): string
	if record.Mutation and record.Mutation ~= "None" then
		local m = MutationConfig.Mutations[record.Mutation]
		return (m and m.Name or record.Mutation) .. " " .. record.Name
	end
	return record.Name
end

-- A fighter from a dragon record (the player's own, or one made for a trainer); owner = whose it is.
local function makeFighter(player: Player?, owner: string, record)
	local rank = DragonConfig.rarityRank(record.Rarity)
	local special, specialName = specialOf(record)
	local maxHP = DuelConfig.maxHP(record.Level, rank)
	return {
		Player = player,
		Owner = owner,
		Name = fullName(record),
		Species = record.SpeciesId,
		DragonName = record.Name,
		Mutation = record.Mutation or "None",
		Level = record.Level,
		Rarity = record.Rarity,
		Rank = rank,
		Element = DuelConfig.elementOf(record.SpeciesId),
		MaxHP = maxHP,
		HP = maxHP,
		Speed = DragonStats.cruiseSpeed(record),
		Damage = DuelConfig.baseDamage(record.Level, rank),
		Special = special, -- "Burst" | "Roar"
		SpecialName = specialName,
		PP = { Fire = DuelConfig.Moves.Fire.PP, Guard = DuelConfig.Moves.Guard.PP, Special = DuelConfig.Moves[special == "Burst" and "Special" or "Roar"].PP },
		Buff = 1,
		BuffTurns = 0,
		Guarding = false,
		LastMove = "",
	}
end

local function fighterView(f)
	return {
		Name = f.Name,
		Owner = f.Owner,
		Species = f.Species,
		DragonName = f.DragonName,
		Mutation = f.Mutation,
		Level = f.Level,
		Rarity = f.Rarity,
		Element = f.Element,
		MaxHP = f.MaxHP,
		HP = f.HP,
		Special = f.Special,
		SpecialName = f.SpecialName,
		PP = { Fire = f.PP.Fire, Guard = f.PP.Guard, Special = f.PP.Special },
		Buff = f.Buff,
	}
end

-- What the match looks like to the player on `side` (1 or 2): Fighters[1] is always them.
local function view(match, side: number)
	local me, foe = match.Sides[side], match.Sides[3 - side]
	return {
		Id = match.Id,
		Kind = match.Kind,
		Side = side,
		Turn = match.Turn,
		Title = match.Title,
		Color = match.Color,
		Fighters = { fighterView(me), fighterView(foe) },
	}
end

-- The player's equipped dragon (a copy of the record) or nil.
local function equipped(player: Player)
	local data = Data.Get(player)
	local record = data and data.Dragons[data.EquippedDragon]
	return record
end

local function trainerDragon(trainer, level: number)
	local id = trainer.Species[rng:NextInteger(1, #trainer.Species)]
	local mutation = "None"
	for _, m in trainer.Mutations do
		if rng:NextNumber() < m[2] then
			mutation = m[1]
			break
		end
	end
	local record = DragonStats.newRecord("NPC", id, mutation, 0)
	record.Level = level
	DragonStats.refresh(record)
	return record
end

-- ============================================================== resolving a turn
local function actionOf(f, move: string)
	if move == "Special" then
		return f.Special == "Burst" and "Special" or "Roar"
	end
	return move
end

local function usable(f, move: string): boolean
	if move == "Strike" then
		return true
	end
	if move == "Fire" or move == "Guard" then
		return f.PP[move] > 0
	end
	if move == "Special" then
		return f.PP.Special > 0
	end
	return false
end

-- The NPC picks its move.
local function chooseFor(f, foe): string
	local lowHP = f.HP < f.MaxHP * 0.3
	if lowHP and usable(f, "Guard") and f.LastMove ~= "Guard" and rng:NextNumber() < 0.3 then
		return "Guard"
	end
	local pool = { { "Strike", 0.34 } }
	if usable(f, "Fire") then
		table.insert(pool, { "Fire", 0.4 })
	end
	if usable(f, "Special") and (f.Special == "Burst" or f.Buff == 1) then
		table.insert(pool, { "Special", 0.26 })
	end
	local total = 0
	for _, e in pool do
		total += e[2]
	end
	local roll = rng:NextNumber() * total
	for _, e in pool do
		roll -= e[2]
		if roll <= 0 then
			return e[1]
		end
	end
	return "Strike"
end

local function speedOrder(match, choices)
	local order = { 1, 2 }
	local function priority(side)
		return choices[side] == "Guard" and 1 or 0
	end
	table.sort(order, function(a, b)
		if priority(a) ~= priority(b) then
			return priority(a) > priority(b)
		end
		local sa, sb = match.Sides[a].Speed, match.Sides[b].Speed
		if sa ~= sb then
			return sa > sb
		end
		return a < b
	end)
	return order
end

local function eventBase(match, side, move, name)
	return { Side = side, Move = move, Name = name, Hit = false, Damage = 0, Crit = false, Eff = 1, Guarded = false, Fail = false }
end

-- Plays one action; returns the event.
local function act(match, side: number, choice: string)
	local me, foe = match.Sides[side], match.Sides[3 - side]
	local action = actionOf(me, choice)
	local def = DuelConfig.Moves[action]
	local event = eventBase(match, side, action, def.Name)
	if action == "Special" then
		event.Name = me.SpecialName
	end
	-- uses left
	if action == "Fire" or action == "Guard" then
		me.PP[action] -= 1
	elseif action == "Special" or action == "Roar" then
		me.PP.Special -= 1
	end
	if action == "Guard" then
		if me.LastMove == "Guard" then
			event.Fail = true
			event.Text = string.format("%s's guard failed!", me.Name)
		else
			me.Guarding = true
			event.Text = string.format("%s braces itself!", me.Name)
		end
	elseif action == "Roar" then
		me.Buff = def.Buff
		me.BuffTurns = def.BuffTurns
		event.Text = string.format("%s roars! Its attacks grow stronger.", me.Name)
	else
		-- an attack
		event.Text = string.format("%s used %s!", me.Name, event.Name)
		if rng:NextNumber() > def.Accuracy then
			event.Text ..= " It missed!"
		else
			local element = action == "Strike" and "Neutral" or me.Element
			local eff = element == "Neutral" and 1 or DuelConfig.effectiveness(element, foe.Element)
			local crit = not foe.Guarding and rng:NextNumber() < DuelConfig.CritChance
			local amount = me.Damage * def.Power * me.Buff * eff * (crit and DuelConfig.CritMultiplier or 1)
			amount *= rng:NextNumber(DuelConfig.Variance[1], DuelConfig.Variance[2])
			if foe.Guarding then
				amount *= 0.5
				event.Guarded = true
			end
			local dmg = math.max(1, math.floor(amount + 0.5))
			foe.HP = math.max(0, foe.HP - dmg)
			event.Hit = true
			event.Damage = dmg
			event.Crit = crit
			event.Eff = eff
			if crit then
				event.Text ..= " A critical hit!"
			end
			if eff > 1 then
				event.Text ..= " It's super effective!"
			elseif eff < 1 then
				event.Text ..= " It's not very effective..."
			end
			if event.Guarded then
				event.Text ..= string.format(" %s guarded!", foe.Name)
			end
		end
	end
	me.LastMove = choice == "Special" and "Special" or choice
	event.HP1 = match.Sides[1].HP
	event.HP2 = match.Sides[2].HP
	return event
end

-- Resolves a turn with the choices { [1] = move, [2] = move }. Returns the events; match.Over / Winner set.
function DuelService.Resolve(match, choices)
	local events = {}
	for _, side in speedOrder(match, choices) do
		local me = match.Sides[side]
		if me.HP > 0 and match.Sides[3 - side].HP > 0 then
			table.insert(events, act(match, side, choices[side]))
			if match.Sides[3 - side].HP <= 0 then
				match.Over = true
				match.Winner = side
				break
			end
		end
	end
	for _, f in match.Sides do
		f.Guarding = false
		if f.BuffTurns > 0 then
			f.BuffTurns -= 1
			if f.BuffTurns == 0 then
				f.Buff = 1
			end
		end
	end
	match.Turn += 1
	return events
end

-- ============================================================== rewards and ending
local function reward(player: Player, spec, share: number)
	local income = Services.EconomyService.IncomeRate(player)
	local cash = math.floor(math.max(spec.Min, income * spec.Minutes * 60) * share + 0.5)
	local xp = math.floor(spec.XP * share + 0.5)
	Services.EconomyService.Earn(player, cash, "Duel")
	Services.LevelService.Add(player, xp, "Duel")
	return { Cash = cash, XP = xp }
end

local function finish(match, winner: number?, forfeit: boolean?)
	if match.Closed then
		return
	end
	match.Closed = true
	match.Over = true
	match.Winner = winner
	matches[match.Id] = nil
	for side = 1, 2 do
		local player = match.Players[side]
		if player then
			byPlayer[player] = nil
			player:SetAttribute("InDuel", nil)
			local rewardOut = nil
			local data = Data.Get(player)
			if winner == side then
				if match.Kind == "NPC" then
					lastWin[player] = lastWin[player] or {}
					local last = lastWin[player][match.Trainer.Id] or -math.huge
					local fresh = clock() - last >= DuelConfig.TrainerCooldown
					rewardOut = reward(player, match.Trainer.Reward, fresh and 1 or DuelConfig.RematchShare)
					rewardOut.Rematch = not fresh
					lastWin[player][match.Trainer.Id] = clock()
				else
					-- a player duel pays only when it was a real fight (a few turns) and not a rematch of the same
					-- two players within PairCooldown seconds
					local other = match.Players[3 - side]
					local key = other and (math.min(player.UserId, other.UserId) .. ":" .. math.max(player.UserId, other.UserId)) or ""
					local fresh = clock() - (pairLast[key] or -math.huge) >= DuelConfig.PairCooldown
					local share = (match.Turn >= DuelConfig.MinTurnsForReward and not forfeit) and (fresh and 1 or DuelConfig.RematchShare) or 0
					if share > 0 then
						rewardOut = reward(player, DuelConfig.PlayerWin, share)
					else
						rewardOut = { Cash = 0, XP = 0, Rematch = true }
					end
					pairLast[key] = clock()
				end
				if data then
					Data.Increment(player, { "Stats", "DuelsWon" }, 1)
				end
			elseif winner then
				if data then
					Data.Increment(player, { "Stats", "DuelsLost" }, 1)
				end
				rewardOut = { Cash = 0, XP = DuelConfig.LoserXP }
				Services.LevelService.Add(player, DuelConfig.LoserXP, "Duel")
			end
			Net.signal(player, "DuelEnd", { Id = match.Id, Winner = winner, Side = side, Reward = rewardOut, Forfeit = forfeit == true, HP1 = match.Sides[side].HP, HP2 = match.Sides[3 - side].HP })
		end
	end
end

-- ============================================================== starting
-- Why this player cannot duel right now (nil = can).
local function blocked(player: Player): (string?, string?)
	if byPlayer[player] then
		return "IN_DUEL", "You are already in a duel."
	end
	local data = Data.Get(player)
	if not data then
		return "NOT_LOADED"
	end
	if not equipped(player) then
		return "NO_DRAGON", "Equip a dragon first (DRAGONS)."
	end
	if player:GetAttribute("RaceState") or player:GetAttribute("RaceActive") then
		return "RACING", "Finish your race first."
	end
	local combat = Services.CombatService
	if combat and combat.Fighter and combat.Fighter(player) then
		return "IN_ARENA", "Leave the arena first."
	end
	return nil
end

local function newId(): string
	serial += 1
	return "M" .. tostring(serial)
end

local function open(match)
	matches[match.Id] = match
	for side = 1, 2 do
		local player = match.Players[side]
		if player then
			byPlayer[player] = match
			player:SetAttribute("InDuel", true)
			-- stand down from the dragon: the scene shows the dragons on its own stage
			local mount = Services.MountService
			if mount and mount.IsRiding(player) then
				mount.Dismount(player)
			end
		end
	end
	match.Deadline = clock() + DuelConfig.TurnSeconds
	match.LastAct = clock()
end

local function startNPC(player: Player, trainer)
	local record = equipped(player)
	local me = makeFighter(player, player.DisplayName, record)
	local foeRecord = trainerDragon(trainer, math.clamp(record.Level + trainer.LevelDelta, 1, DragonConfig.MaxLevel))
	local foe = makeFighter(nil, trainer.Name, foeRecord)
	local match = {
		Id = newId(),
		Kind = "NPC",
		Trainer = trainer,
		Title = trainer.Title,
		Color = trainer.Color,
		Sides = { me, foe },
		Players = { player, nil },
		Turn = 1,
		Choices = {},
	}
	open(match)
	return match
end

local function startPlayers(a: Player, b: Player)
	local fa = makeFighter(a, a.DisplayName, equipped(a))
	local fb = makeFighter(b, b.DisplayName, equipped(b))
	local match = {
		Id = newId(),
		Kind = "PVP",
		Title = "Duel",
		Color = Color3.fromRGB(255, 80, 70),
		Sides = { fa, fb },
		Players = { a, b },
		Turn = 1,
		Choices = {},
	}
	open(match)
	return match
end

function DuelService.Match(player: Player)
	return byPlayer[player]
end

-- ============================================================== net handlers
local function handleTrainers(player: Player)
	local record = equipped(player)
	local list = {}
	local income = Services.EconomyService.IncomeRate(player)
	for _, t in DuelConfig.Trainers do
		local level = record and math.clamp(record.Level + t.LevelDelta, 1, DragonConfig.MaxLevel) or 0
		local last = lastWin[player] and lastWin[player][t.Id] or -math.huge
		table.insert(list, {
			Id = t.Id,
			Name = t.Name,
			Title = t.Title,
			Level = level,
			Cash = math.floor(math.max(t.Reward.Min, income * t.Reward.Minutes * 60) + 0.5),
			XP = t.Reward.XP,
			Cooldown = math.max(0, math.ceil(DuelConfig.TrainerCooldown - (clock() - last))),
		})
	end
	local dragon = nil
	if record then
		dragon = { Name = record.Name, Species = record.SpeciesId, Mutation = record.Mutation, Level = record.Level, Rarity = record.Rarity, Element = DuelConfig.elementOf(record.SpeciesId) }
	end
	return true, { List = list, Dragon = dragon }
end

local function handleStart(player: Player, p)
	local trainer = type(p.Trainer) == "string" and DuelConfig.trainer(p.Trainer) or nil
	if not trainer then
		return false, "BAD_REQUEST"
	end
	local code, msg = blocked(player)
	if code then
		return false, code, msg
	end
	local match = startNPC(player, trainer)
	return true, view(match, 1)
end

local function endChallenge(target: Player, reason: string)
	local c = challenges[target]
	if c then
		challenges[target] = nil
		Net.signal(c.From, "DuelChallengeEnd", { From = c.From.UserId, Reason = reason, Name = target.DisplayName })
		Net.signal(target, "DuelChallengeEnd", { From = c.From.UserId, Reason = reason, Name = c.From.DisplayName })
	end
end

local function handleChallenge(player: Player, p)
	if not Net.check.int(p.UserId, 1, 1e13) then
		return false, "BAD_REQUEST"
	end
	local target = Players:GetPlayerByUserId(p.UserId)
	if not target or target == player then
		return false, "NO_PLAYER", "That player is not here."
	end
	local code, msg = blocked(player)
	if code then
		return false, code, msg
	end
	local code2 = blocked(target)
	if code2 then
		return false, "BUSY", target.DisplayName .. " cannot duel right now."
	end
	if challenges[target] then
		return false, "BUSY", target.DisplayName .. " has a challenge waiting already."
	end
	challenges[target] = { From = player, At = clock() }
	Net.signal(target, "DuelChallenge", { From = player.UserId, Name = player.DisplayName, Expires = DuelConfig.ChallengeSeconds })
	task.delay(DuelConfig.ChallengeSeconds, function()
		local c = challenges[target]
		if c and c.From == player and clock() - c.At >= DuelConfig.ChallengeSeconds - 0.5 then
			endChallenge(target, "Expired")
		end
	end)
	return true, {}
end

local function handleRespond(player: Player, p)
	local c = challenges[player]
	if not c or not Net.check.int(p.From, 1, 1e13) or c.From.UserId ~= p.From then
		return false, "NO_CHALLENGE", "That challenge is over."
	end
	if p.Accept ~= true then
		endChallenge(player, "Declined")
		return true, {}
	end
	local from = c.From
	challenges[player] = nil
	if from.Parent == nil then
		return false, "NO_PLAYER"
	end
	local code, msg = blocked(player)
	if code then
		return false, code, msg
	end
	if blocked(from) then
		return false, "BUSY", from.DisplayName .. " cannot duel any more."
	end
	local match = startPlayers(from, player)
	Net.signal(from, "DuelStart", view(match, 1))
	return true, view(match, 2)
end

local function sideOf(match, player: Player): number?
	if match.Players[1] == player then
		return 1
	elseif match.Players[2] == player then
		return 2
	end
	return nil
end

local function playTurn(match)
	local choices = { match.Choices[1], match.Choices[2] }
	if match.Kind == "NPC" then
		choices[2] = chooseFor(match.Sides[2], match.Sides[1])
	end
	match.Choices = {}
	local events = DuelService.Resolve(match, choices)
	local state = {
		Turn = match.Turn,
		Fighters = { fighterView(match.Sides[1]), fighterView(match.Sides[2]) },
	}
	match.Deadline = clock() + DuelConfig.TurnSeconds
	for side = 1, 2 do
		local player = match.Players[side]
		if player then
			-- (a player on side 2 sees the match from their own side: they are "1" for themselves)
			local mine = {}
			for i, e in events do
				mine[i] = table.clone(e)
				if side == 2 then
					mine[i].Side = 3 - e.Side
					mine[i].HP1, mine[i].HP2 = e.HP2, e.HP1
				end
			end
			local st = side == 1 and state or { Turn = state.Turn, Fighters = { state.Fighters[2], state.Fighters[1] } }
			Net.signal(player, "DuelTurn", { Id = match.Id, Turn = match.Turn, Events = mine, State = st })
		end
	end
	if match.Over then
		-- (the clients play the turn first; the end follows when they are done or after a pause)
		task.delay(0.5, function()
			finish(match, match.Winner)
		end)
	end
end

local function handleMove(player: Player, p)
	local match = byPlayer[player]
	if not match or match.Closed or match.Id ~= p.Id then
		return false, "NO_MATCH"
	end
	if type(p.Move) ~= "string" or not table.find(DuelConfig.MoveOrder, p.Move) then
		return false, "BAD_REQUEST"
	end
	local side = sideOf(match, player)
	if not side or match.Over then
		return false, "NO_MATCH"
	end
	if match.Choices[side] then
		return false, "ALREADY_CHOSEN"
	end
	local me = match.Sides[side]
	if not usable(me, p.Move) then
		return false, "NO_PP", "No uses left for that move."
	end
	match.Choices[side] = p.Move
	match.LastAct = clock()
	local ready = match.Choices[1] and (match.Kind == "NPC" or match.Choices[2])
	if ready then
		playTurn(match)
		return true, { Played = true }
	end
	return true, { Waiting = true }
end

local function handleForfeit(player: Player, p)
	local match = byPlayer[player]
	if not match or match.Id ~= p.Id then
		return false, "NO_MATCH"
	end
	local side = sideOf(match, player)
	finish(match, 3 - side, true)
	return true, {}
end

-- ============================================================== lifecycle
function DuelService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.handle("Duel", "Trainers", handleTrainers, { Burst = 6, PerSecond = 2 })
	Net.handle("Duel", "Start", handleStart, { Burst = 3, PerSecond = 1 })
	Net.handle("Duel", "Challenge", handleChallenge, { Burst = 3, PerSecond = 1 })
	Net.handle("Duel", "Respond", handleRespond, { Burst = 3, PerSecond = 1 })
	Net.handle("Duel", "Move", handleMove, { Burst = 6, PerSecond = 3 })
	Net.handle("Duel", "Forfeit", handleForfeit, { Burst = 3, PerSecond = 1 })
end

function DuelService.Start()
	Players.PlayerRemoving:Connect(function(player)
		local match = byPlayer[player]
		if match and not match.Closed then
			local side = sideOf(match, player)
			finish(match, side and 3 - side or nil, true)
		end
		challenges[player] = nil
		for target, c in challenges do
			if c.From == player then
				endChallenge(target, "Left")
			end
		end
		lastWin[player] = nil
	end)
	-- a player who does not choose in time uses STRIKE (player duels)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, match in matches do
				if not match.Closed and match.Kind == "NPC" and clock() - match.LastAct > DuelConfig.IdleSeconds then
					finish(match, 2, true) -- the player went away: the trainer wins, nobody is paid
				elseif not match.Closed and match.Kind == "PVP" and clock() > match.Deadline then
					for side = 1, 2 do
						if not match.Choices[side] then
							match.Choices[side] = "Strike"
						end
					end
					playTurn(match)
				end
			end
		end
	end)
end

return DuelService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000078">
				<Properties>
					<string name="Name">EconomyService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	EconomyService
	The only place cash changes hands. Every price is read from configs on the
	server; clients never send amounts.

	Passive income: every dragon resting on a sanctuary perch earns its
	IncomePerSecond. Online income is paid into cash once per second; while
	the player is away, a share of it accumulates (capped) and is paid with a
	"welcome back" message on the next join.

	API (server):
	  EconomyService.CanAfford(player, amount) -> boolean
	  EconomyService.Spend(player, amount, reason) -> boolean
	  EconomyService.Earn(player, amount, reason)
	  EconomyService.IncomeRate(player) -> number (per second, boosts included)
	  EconomyService.Multiplier(player) -> number (income multiplier)
	Signals: Spent(player, amount, reason), Earned(player, amount, reason)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local Net = require(Shared:WaitForChild("Net"))
local EconomyConfig = require(Configs:WaitForChild("EconomyConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local EconomyService = {}
EconomyService.Spent = Signal.new()
EconomyService.Earned = Signal.new()

local Data
local Services
local carry: { [Player]: number } = {} -- fractional income not yet paid

local function valid(amount: any): boolean
	return type(amount) == "number" and amount == amount and amount >= 0 and amount < math.huge
end

function EconomyService.CanAfford(player: Player, amount: number): boolean
	local data = Data.Get(player)
	return data ~= nil and valid(amount) and data.Cash >= amount
end

function EconomyService.Spend(player: Player, amount: number, reason: string?): boolean
	if not valid(amount) then
		return false
	end
	amount = math.floor(amount + 0.5)
	local data = Data.Get(player)
	if not data or data.Cash < amount then
		return false
	end
	if amount > 0 then
		Data.Increment(player, { "Cash" }, -amount)
		EconomyService.Spent:Fire(player, amount, reason or "")
	end
	return true
end

function EconomyService.Earn(player: Player, amount: number, reason: string?)
	if not valid(amount) then
		return
	end
	amount = math.floor(amount + 0.5)
	if amount <= 0 or not Data.Get(player) then
		return
	end
	Data.Increment(player, { "Cash" }, amount)
	Data.Increment(player, { "TotalEarned" }, amount)
	EconomyService.Earned:Fire(player, amount, reason or "")
end

-- Income multiplier from active boosts (Coins potion etc.).
function EconomyService.Multiplier(player: Player): number
	local boosts = Services.BoostService
	if boosts and boosts.Multiplier then
		return boosts.Multiplier(player, "Coins")
	end
	return 1
end

-- Base income per second of every dragon resting on a perch.
local function baseRate(data): number
	local total = 0
	for _, uid in data.Nests.Slots do
		local record = data.Dragons[uid]
		if record then
			total += record.IncomePerSecond
		end
	end
	return total
end

function EconomyService.IncomeRate(player: Player): number
	local data = Data.Get(player)
	if not data then
		return 0
	end
	return baseRate(data) * EconomyService.Multiplier(player)
end

local function payTick(dt: number)
	for _, player in Players:GetPlayers() do
		local data = Data.Get(player)
		if data then
			local amount = (carry[player] or 0) + baseRate(data) * EconomyService.Multiplier(player) * dt
			local whole = math.floor(amount)
			if whole >= 1 then
				EconomyService.Earn(player, whole, "Income")
				Data.Increment(player, { "Stats", "Collected" }, whole)
			end
			carry[player] = amount - whole
		end
	end
end

-- Offline earnings: a share of the perch income since the last session.
local function onLoaded(player: Player, data)
	local last = tonumber(data.LastLogout) or 0
	if last <= 0 or Data.IsTemporary() then
		return
	end
	-- Great Tree "Dream Dens": longer cap and a better rate while you are away
	local dens = TreeConfig.bonus(data, "Offline")
	local away = math.clamp(os.time() - last, 0, EconomyConfig.OfflineCapSeconds * (1 + dens))
	if away < 60 then
		return
	end
	local amount = math.floor(baseRate(data) * away * math.min(1, EconomyConfig.OfflineRate * (1 + dens)))
	if amount > 0 then
		EconomyService.Earn(player, amount, "Offline")
		task.delay(4, function()
			if player.Parent == Players then
				Net.notify(player, "rare", string.format("Welcome back! Your dragons earned %s while you were away.", Format.cash(amount)))
			end
		end)
	end
end

function EconomyService.Init(services)
	Services = services
	Data = services.PlayerDataService
end

function EconomyService.Start()
	Data.Loaded:Connect(onLoaded)
	Players.PlayerRemoving:Connect(function(player)
		carry[player] = nil
	end)
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= 1 then
			local step = math.min(acc, 5)
			acc = 0
			payTick(step)
		end
	end)
end

return EconomyService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000079">
				<Properties>
					<string name="Name">EggService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	EggService
	Personal dragon eggs: every player has their own eggs scattered around
	the world's egg areas (Workspace.World.EggSpots). Picking one up stores it
	in the player's egg bag (data.Eggs, capacity = Egg Storage upgrade).
	Eggs are incubated in the sanctuary nest (data.Incubator slots, timed) and
	hatched there into dragons (luck-weighted roll + mutation roll).

	Server authority: spawn positions, pickup range, capacity, incubation
	timers, hatch results and prices are all decided here.

	The egg you pick up is carried IN YOUR HAND (one at a time, the rest stay in the
	bag): player attributes HeldEggId / HeldEggType / HeldEggLuck replicate it so every
	client can draw it in the character's hand. You walk to your nest and put it in the
	nest spot you like - the server only checks range, slot and ownership.

	Net (domain "Egg"):
	  Pickup { Key }            -> { Id, Type, Luck, Held }
	  Hold   { Id? | Best? }    -> { Id }   (Id: take that egg in hand, Best: the best egg,
	                                         neither: put the egg back in the bag)
	  Place  { Id?, Slot? }     -> { Slot, Ready, Next }  (Id defaults to the egg in hand)
	  Hatch  { Slot }           -> { Dragon = record, New = bool, Egg = type }
	  BuyIncubator { Slot }     -> { Unlocked }
	Signals to the owner: "Eggs" { List }, "EggAdded" egg, "EggRemoved" { Key }

	Robux items use EggService.GiveEgg(.., force) (the bag may overflow - paid eggs are never
	lost) and EggService.SpawnBonusEggs (Lucky Egg Call: lucky eggs near the player for a while).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))
local EconomyConfig = require(Configs:WaitForChild("EconomyConfig"))
local GameConfig = require(Configs:WaitForChild("GameConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))
local HatchConfig = require(Configs:WaitForChild("HatchConfig"))
local WildEggConfig = require(Configs:WaitForChild("WildEggConfig"))
local EggReach = require(Shared:WaitForChild("EggReach"))

local EggService = {}
EggService.PickedUp = Signal.new() -- (player, eggType)
EggService.Hatched = Signal.new() -- (player, record, eggType)

local Data
local Services
local areas: { any } = {} -- { Name, Position, Region, Label?, Radius?, Island? }
local extraAreas: { any } = {} -- areas added by other services (sky islands): they survive a reload
local areasLoaded = false -- the fixed areas of the world are in (eggs are only spawned after that)
local states: { [Player]: any } = {}
local rng = Random.new()

local function now(): number
	return os.time()
end

-- ============================================================== spawn areas
local function loadAreas()
	local world = Workspace:WaitForChild("World", 120)
	local folder = world and world:WaitForChild("EggSpots", 120)
	if not folder then
		warn("[Eggs] no EggSpots in the world")
		return
	end
	table.clear(areas)
	for _, p in folder:GetChildren() do
		if p:IsA("BasePart") then
			local name = p:GetAttribute("Area") or "Area"
			local region = p:GetAttribute("Region") or EggConfig.AreaRegion[name] or "Haven"
			table.insert(areas, { Name = name, Position = p.Position, Region = region })
		end
	end
	for _, a in extraAreas do
		table.insert(areas, a)
	end
	areasLoaded = true
end

-- Eggs rest on the terrain (not in water) or on a part marked EggSurface (the plate of a sky island).
local function eggGround(hit): boolean
	if not hit or hit.Normal.Y <= 0.6 then
		return false
	end
	if hit.Instance == Workspace.Terrain then
		return hit.Material ~= Enum.Material.Water
	end
	return hit.Instance:GetAttribute("EggSurface") == true
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = false

-- Finds a resting spot near an area centre (on terrain, not water/buildings).
local function findSpot(area): Vector3?
	local exclude = {}
	local world = Workspace:FindFirstChild("World")
	local nature = world and world:FindFirstChild("Nature")
	if nature then
		table.insert(exclude, nature)
	end
	local eggSpots = world and world:FindFirstChild("EggSpots")
	if eggSpots then
		table.insert(exclude, eggSpots)
	end
	local dragons = Workspace:FindFirstChild("Dragons")
	if dragons then
		table.insert(exclude, dragons)
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = exclude
	local radius = area.Radius or (area.Name == "Pillar" and 8 or EggConfig.Spawning.ScatterRadius)
	for _ = 1, 8 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = math.sqrt(rng:NextNumber()) * radius
		local x = area.Position.X + math.cos(a) * r
		local z = area.Position.Z + math.sin(a) * r
		local origin = Vector3.new(x, area.Position.Y + 160, z)
		local hit = Workspace:Raycast(origin, Vector3.new(0, -400, 0), rayParams)
		if eggGround(hit) then
			return hit.Position + Vector3.new(0, 2.6, 0)
		end
	end
	return nil
end

-- A completely random resting spot on the land (not near any fixed area). Returns the spot and an
-- "area" record named after the nearest real area (it gives the label and the region of the egg).
-- `avoid` = a point the spot must keep RoamMinSeparation away from.
local function randomSpot(avoid: Vector3?): (Vector3?, any?)
	if #areas == 0 then
		return nil, nil
	end
	-- a share of the roaming eggs lands on a sky island (its own area: rare luck, its region's eggs)
	local islands = {}
	for _, a in areas do
		if a.Island then
			table.insert(islands, a)
		end
	end
	if #islands > 0 and rng:NextNumber() < EggConfig.Spawning.IslandShare then
		for _ = 1, 8 do
			local isle = islands[rng:NextInteger(1, #islands)]
			local spot = findSpot({ Name = isle.Name, Position = isle.Position, Radius = isle.Radius * EggConfig.Spawning.IslandInset / 0.78 })
			if spot and (not avoid or (Vector2.new(spot.X, spot.Z) - Vector2.new(avoid.X, avoid.Z)).Magnitude >= 40) then
				return spot, isle
			end
		end
	end
	local box = EggConfig.Spawning.WorldBox
	local skip = {}
	for _, n in EggConfig.Spawning.RoamAvoid do
		skip[n] = true
	end
	local exclude = {}
	local world = Workspace:FindFirstChild("World")
	for _, name in { "Nature", "EggSpots" } do
		local folder = world and world:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	for _, name in { "Dragons", "MyEggs", "HeldEggs" } do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = exclude
	for _ = 1, 24 do
		local x = rng:NextNumber(box.MinX, box.MaxX)
		local z = rng:NextNumber(box.MinZ, box.MaxZ)
		if not avoid or (Vector2.new(x, z) - Vector2.new(avoid.X, avoid.Z)).Magnitude >= EggConfig.Spawning.RoamMinSeparation then
			local hit = Workspace:Raycast(Vector3.new(x, 520, z), Vector3.new(0, -900, 0), rayParams)
			if eggGround(hit) then
				local nearest, best = nil, math.huge
				for _, a in areas do
					if not skip[a.Name] then
						local d = (Vector2.new(a.Position.X, a.Position.Z) - Vector2.new(x, z)).Magnitude
						if d < best then
							nearest, best = a, d
						end
					end
				end
				if nearest then
					return hit.Position + Vector3.new(0, 2.6, 0), { Name = nearest.Name, Position = hit.Position, Region = nearest.Region, Roaming = true }
				end
			end
		end
	end
	return nil, nil
end

local function eggTypeFor(area): string
	return EggConfig.rollEgg(area.Region or "Haven", rng)
end

local function serialize(egg)
	return { Key = egg.Key, Type = egg.Type, Position = egg.Position, Area = egg.Area, Luck = egg.Luck }
end

local function spawnOne(player: Player): boolean
	local st = states[player]
	if not st or #areas == 0 then
		return false
	end
	local area, pos
	if rng:NextNumber() < EggConfig.Spawning.RoamingShare then
		-- a random place anywhere on the land
		pos, area = randomSpot()
	end
	if not pos then
		-- around a named area; prefer areas without an active egg of this player
		local used = {}
		for _, e in st.Active do
			used[e.Area] = (used[e.Area] or 0) + 1
		end
		local candidates = {}
		for _, a in areas do
			if (used[a.Name] or 0) == 0 then
				table.insert(candidates, a)
			end
		end
		if #candidates == 0 then
			candidates = areas
		end
		area = candidates[rng:NextInteger(1, #candidates)]
		pos = findSpot(area)
	end
	if not pos or not area then
		return false
	end
	st.Serial += 1
	local eggType = eggTypeFor(area)
	local luck = EggConfig.rollLuck(eggType, rng, EggConfig.RareAreas[area.Name] == true and not area.Roaming)
	-- Great Tree "Lucky Finds": eggs you find carry more luck
	luck = math.max(1, math.floor(luck * (1 + TreeConfig.bonus(Data.Get(player), "FindLuck")) + 0.5))
	local egg = { Key = "k" .. st.Serial, Type = eggType, Position = pos, Area = area.Name, Luck = luck }
	st.Active[egg.Key] = egg
	Net.signal(player, "EggAdded", serialize(egg))
	return true
end

-- Eggs of the normal respawn cycle (bonus eggs from Robux items do not count).
local function activeCount(st): number
	local n = 0
	for _, e in st.Active do
		if not e.Bonus then
			n += 1
		end
	end
	return n
end

local function fillEggs(player: Player)
	local st = states[player]
	if not st then
		return
	end
	local tries = 0
	while activeCount(st) < EggConfig.Spawning.MaxActive and tries < 40 do
		tries += 1
		spawnOne(player)
	end
end

local function scheduleRespawn(player: Player)
	local delayS = rng:NextNumber(EggConfig.Spawning.RespawnMin, EggConfig.Spawning.RespawnMax)
	-- Great Tree "Fertile Soil": new eggs appear sooner
	delayS *= 1 - math.clamp(TreeConfig.bonus(Data.Get(player), "EggRespawn"), 0, 0.9)
	task.delay(delayS, function()
		if states[player] then
			fillEggs(player)
		end
	end)
end

-- ============================================================== announcements
-- An ultra-rare hatch ("1 in 25,000" or rarer) is announced to the whole server once the
-- hatcher's reveal is over (client banner, AnnounceController).
function EggService.announceHatch(player: Player, record, odds: number)
	local cfg = HatchConfig.Announce
	if odds < cfg.MinOdds then
		return false
	end
	local payload = {
		Player = player.DisplayName,
		UserId = player.UserId,
		Species = record.SpeciesId,
		Mutation = record.Mutation or "None",
		Rarity = record.Rarity,
		Odds = odds,
		Mega = odds >= cfg.Mega,
	}
	task.delay(cfg.Delay, function()
		Net.broadcast("RareHatch", payload)
	end)
	return true
end

-- ============================================================== helpers
local function capacity(data): number
	return TreeConfig.eggCapacity(data)
end

-- Player position for range checks: the ridden dragon root, else the HRP.
local function playerPositions(player: Player): { Vector3 }
	local out = {}
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if hrp then
		table.insert(out, hrp.Position)
	end
	local dragons = Workspace:FindFirstChild("Dragons")
	local model = dragons and dragons:FindFirstChild("Dragon_" .. player.UserId)
	local root = model and model:FindFirstChild("Root") :: BasePart?
	if root then
		table.insert(out, root.Position)
	end
	return out
end

local function nearestDistance(player: Player, target: Vector3): number
	local best = math.huge
	for _, p in playerPositions(player) do
		best = math.min(best, (p - target).Magnitude)
	end
	return best
end

local function nestPart(player: Player): BasePart?
	local sanct = Services.SanctuaryService
	local plot = sanct and sanct.GetPlot(player)
	local nest = plot and plot:FindFirstChild("Nest", true)
	return nest and nest:IsA("BasePart") and nest or nil
end

local function rollSpecies(eggType: string, luck: number): string
	local odds = EggConfig.oddsFor(eggType, luck, function(id)
		local sp = DragonConfig.Species[id]
		return sp and DragonConfig.rarityRank(sp.Rarity) or 0
	end)
	local r = rng:NextNumber()
	local acc = 0
	for _, e in odds do
		acc += e.P
		if r <= acc then
			return e.Id
		end
	end
	return odds[#odds].Id
end

local function rollMutation(luckMult: number?): string
	-- rarest first so a lucky roll keeps the best mutation
	local k = math.max(1, luckMult or 1)
	for i = #MutationConfig.Order, 2, -1 do
		local id = MutationConfig.Order[i]
		local m = MutationConfig.Mutations[id]
		if m and m.HatchChance > 0 and rng:NextNumber() < m.HatchChance * k then
			return id
		end
	end
	return "None"
end

local function rankOf(id: string): number
	local sp = DragonConfig.Species[id]
	return sp and DragonConfig.rarityRank(sp.Rarity) or 0
end

-- Probability of this exact result ("1 in N" title of the hatched dragon).
local function resultOdds(eggType: string, luck: number, luckMult: number, species: string, mutation: string): number
	local pSpecies = 0
	for _, e in EggConfig.oddsFor(eggType, luck, rankOf) do
		if e.Id == species then
			pSpecies = e.P
		end
	end
	local k = math.max(1, luckMult)
	local pMutation
	if mutation == "None" then
		local miss = 1
		for i = 2, #MutationConfig.Order do
			local m = MutationConfig.Mutations[MutationConfig.Order[i]]
			miss *= 1 - math.min(1, (m.HatchChance or 0) * k)
		end
		pMutation = miss
	else
		local m = MutationConfig.Mutations[mutation]
		pMutation = math.min(1, (m and m.HatchChance or 1) * k)
	end
	local p = pSpecies * pMutation
	if p <= 0 then
		return 0
	end
	return math.max(1, math.floor(1 / p + 0.5))
end
EggService.resultOdds = resultOdds

-- ============================================================== held egg
-- Best carried egg = highest tier, then highest luck.
local function bestIndex(data): number?
	local index, bestScore = nil, -1
	for i, e in data.Eggs do
		local tier = EggConfig.Eggs[e.Type] and EggConfig.Eggs[e.Type].Tier or 0
		local score = tier * 100000 + math.min(99999, tonumber(e.Luck) or 1)
		if score > bestScore then
			index, bestScore = i, score
		end
	end
	return index
end

-- Id of the egg in the player's hand (nil = empty hand).
function EggService.Held(player: Player): string?
	local id = player:GetAttribute("HeldEggId")
	return type(id) == "string" and id ~= "" and id or nil
end

local function clearHeld(player: Player)
	player:SetAttribute("HeldEggId", nil)
	player:SetAttribute("HeldEggType", nil)
	player:SetAttribute("HeldEggLuck", nil)
end

-- id = nil puts the egg back in the bag. false when that egg is not in the bag.
function EggService.SetHeld(player: Player, id: string?): boolean
	if not id then
		clearHeld(player)
		return true
	end
	local data = Data.Get(player)
	for _, e in data and data.Eggs or {} do
		if e.Id == id then
			player:SetAttribute("HeldEggId", e.Id)
			player:SetAttribute("HeldEggType", e.Type)
			player:SetAttribute("HeldEggLuck", math.max(1, tonumber(e.Luck) or 1))
			return true
		end
	end
	return false
end

-- Drops a held egg that left the bag some other way (spent, traded, reset...).
local function reconcileHeld(player: Player)
	local id = EggService.Held(player)
	if not id then
		return
	end
	local data = Data.Get(player)
	for _, e in data and data.Eggs or {} do
		if e.Id == id then
			return
		end
	end
	clearHeld(player)
end

-- ============================================================== giving eggs
-- Puts a new egg in the player's bag (capacity checked) and - when the hand is free - in
-- the hand. Used by pickups and by world events (Lucky Wild Eggs).
-- `force` (paid items) lets the bag overflow instead of refusing.
-- Returns ok, id | errorCode, inHand
function EggService.GiveEgg(player: Player, eggType: string, luck: number?, force: boolean?): (boolean, string, boolean?)
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	if not EggConfig.Eggs[eggType] then
		return false, "BAD_EGG"
	end
	if #data.Eggs >= capacity(data) and not force then
		return false, "EGG_STORAGE_FULL"
	end
	local id = Data.NextId(player, "EggSerial", "E")
	local list = table.clone(data.Eggs)
	table.insert(list, { Id = id, Type = eggType, Found = now(), Luck = math.max(1, math.floor(tonumber(luck) or 1)) })
	Data.Set(player, { "Eggs" }, list)
	Data.Increment(player, { "Stats", "EggsFound" }, 1)
	EggService.PickedUp:Fire(player, eggType)
	-- hands free: the egg goes straight into your hand (otherwise into the bag)
	local inHand = EggService.Held(player) == nil
	if inHand then
		EggService.SetHeld(player, id)
	end
	return true, id, inHand
end

-- Distance from the player (character or ridden dragon, whichever is closer) to a point.
function EggService.DistanceTo(player: Player, position: Vector3): number
	return nearestDistance(player, position)
end

-- World egg areas (positions + regions) and a resting spot inside one - for events.
function EggService.Areas()
	return areas
end

function EggService.FindSpot(area): Vector3?
	return findSpot(area)
end

-- Adds an egg area from another service (a sky island): { Name, Label?, Position, Region, Radius?, Island? }.
-- Kept across a reload of the world areas, so the order of the services does not matter.
function EggService.AddArea(area)
	table.insert(extraAreas, area)
	if areasLoaded then
		table.insert(areas, area)
	end
end

-- A completely random spot on the land + an area record for it (see randomSpot).
function EggService.RandomSpot(avoid: Vector3?): (Vector3?, any?)
	return randomSpot(avoid)
end

-- Resting spot on the terrain around a point (for eggs that appear next to the player).
local function findSpotNear(center: Vector3, minRadius: number, maxRadius: number): Vector3?
	local exclude = {}
	local world = Workspace:FindFirstChild("World")
	for _, name in { "Nature", "EggSpots" } do
		local folder = world and world:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	for _, name in { "Dragons", "MyEggs", "HeldEggs" } do
		local folder = Workspace:FindFirstChild(name)
		if folder then
			table.insert(exclude, folder)
		end
	end
	for _, p in Players:GetPlayers() do
		if p.Character then
			table.insert(exclude, p.Character)
		end
	end
	rayParams.FilterDescendantsInstances = exclude
	for _ = 1, 14 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(minRadius, maxRadius)
		local x = center.X + math.cos(a) * r
		local z = center.Z + math.sin(a) * r
		local hit = Workspace:Raycast(Vector3.new(x, center.Y + 180, z), Vector3.new(0, -600, 0), rayParams)
		if hit and hit.Instance == Workspace.Terrain and hit.Material ~= Enum.Material.Water and hit.Normal.Y > 0.6 then
			return hit.Position + Vector3.new(0, 2.6, 0)
		end
	end
	return nil
end

-- Lucky Egg Call (Robux): `count` very lucky eggs appear around the player - only they can see and
-- take them - and vanish after `lifetime` seconds. luckRange = { min, max }. Returns how many appeared.
function EggService.SpawnBonusEggs(player: Player, count: number, luckRange: { number }?, lifetime: number?): number
	local st = states[player]
	if not st then
		return 0
	end
	local positions = playerPositions(player)
	local center = positions[1]
	if not center then
		return 0
	end
	local epic = WildEggConfig.ById.Epic
	local range = luckRange or { 25, 100 }
	local spawned = 0
	local stay = lifetime or 300
	for _ = 1, count do
		local pos = findSpotNear(center, 22, 70)
		if pos then
			st.Serial += 1
			local egg = {
				Key = "b" .. st.Serial,
				Type = epic.Eggs[rng:NextInteger(1, #epic.Eggs)],
				Position = pos,
				Area = "Lucky Call",
				Luck = rng:NextInteger(math.floor(range[1]), math.floor(range[2])),
				Bonus = true,
			}
			st.Active[egg.Key] = egg
			Net.signal(player, "EggAdded", serialize(egg))
			spawned += 1
			local key = egg.Key
			task.delay(stay, function()
				if states[player] == st and st.Active[key] then
					st.Active[key] = nil
					Net.signal(player, "EggRemoved", { Key = key })
				end
			end)
		end
	end
	return spawned
end

-- ============================================================== handlers
local function handlePickup(player: Player, p)
	if not Net.check.str(p.Key, 16) then
		return false, "BAD_REQUEST"
	end
	local st = states[player]
	local data = Data.Get(player)
	if not st or not data then
		return false, "NOT_LOADED"
	end
	local egg = st.Active[p.Key]
	if not egg then
		return false, "GONE"
	end
	local slack = 0
	local dragons = Workspace:FindFirstChild("Dragons")
	local model = dragons and dragons:FindFirstChild("Dragon_" .. player.UserId)
	if model then
		slack = (model:GetAttribute("BodyRadius") or 0) * 0.5
	end
	local reach = EggReach.range(data, GameConfig.Interaction.EggPickupServerRange)
	if nearestDistance(player, egg.Position) > reach + slack then
		return false, "TOO_FAR"
	end
	if #data.Eggs >= capacity(data) then
		return false, "EGG_STORAGE_FULL", "Your egg bag is full! Hatch eggs at your sanctuary nest or upgrade Egg Storage."
	end
	st.Active[p.Key] = nil
	Net.signal(player, "EggRemoved", { Key = p.Key })
	local ok, id, inHand = EggService.GiveEgg(player, egg.Type, egg.Luck or 1)
	if not ok then
		return false, id
	end
	scheduleRespawn(player)
	return true, { Id = id, Type = egg.Type, Luck = egg.Luck or 1, Held = inHand }
end

local function freeSlot(data): number?
	for i = 1, data.Incubator.Unlocked do
		if data.Incubator.Slots[tostring(i)] == nil then
			return i
		end
	end
	return nil
end

local function handlePlace(player: Player, p)
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	local nest = nestPart(player)
	if not nest then
		return false, "NO_SANCTUARY"
	end
	if nearestDistance(player, nest.Position) > GameConfig.Interaction.NestServerRange + 20 then
		return false, "TOO_FAR", "Go to your sanctuary nest to incubate eggs."
	end
	if #data.Eggs == 0 then
		return false, "NO_EGGS", "You have no eggs. Find them around Dragon Haven!"
	end
	-- egg: the requested id, else the one in hand, else the best carried egg
	local index = nil
	local wantId = p.Id
	if wantId ~= nil and not Net.check.str(wantId, 20) then
		return false, "BAD_REQUEST"
	end
	if wantId == nil then
		wantId = EggService.Held(player)
	end
	if wantId ~= nil then
		for i, e in data.Eggs do
			if e.Id == wantId then
				index = i
				break
			end
		end
	end
	if not index and p.Id == nil then
		index = bestIndex(data)
	end
	if not index then
		return false, "NOT_FOUND"
	end
	local slot = nil
	if p.Slot ~= nil then
		if not Net.check.int(p.Slot, 1, #EggConfig.IncubatorPrices) then
			return false, "BAD_REQUEST"
		end
		if p.Slot > data.Incubator.Unlocked or data.Incubator.Slots[tostring(p.Slot)] then
			return false, "SLOT_BUSY", "That nest spot is not free."
		end
		slot = p.Slot
	else
		slot = freeSlot(data)
	end
	if not slot then
		return false, "NEST_FULL", "Your nest is full. Hatch the ready eggs first!"
	end
	local egg = data.Eggs[index]
	local def = EggConfig.Eggs[egg.Type]
	if not def then
		return false, "BAD_EGG"
	end
	local list = table.clone(data.Eggs)
	table.remove(list, index)
	Data.Set(player, { "Eggs" }, list)
	local t = now()
	local hatchTime = def.HatchTime
	local tree = Services.TreeService
	if tree and tree.Bonus then
		hatchTime = hatchTime * (1 - tree.Bonus(player, "HatchSpeed"))
	end
	-- Fast Hatch potion: the nest works faster while it runs
	hatchTime = math.max(3, math.floor(hatchTime * EggReach.hatchFactor(data, now()) + 0.5))
	Data.Set(player, { "Incubator", "Slots", tostring(slot) }, { Type = egg.Type, Start = t, Ready = t + hatchTime, Id = egg.Id, Luck = egg.Luck or 1 })
	-- the hand is empty now; while nest spots remain, the next egg of the bag is taken
	-- in hand so several eggs can be placed one after another
	local nextId = nil
	if EggService.Held(player) == egg.Id then
		clearHeld(player)
		local nextIndex = freeSlot(data) and bestIndex(data)
		if nextIndex then
			nextId = data.Eggs[nextIndex].Id
			EggService.SetHeld(player, nextId)
		end
	end
	return true, { Slot = slot, Ready = t + hatchTime, Next = nextId }
end

local function handleHold(player: Player, p)
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	if p.Id ~= nil then
		if not Net.check.str(p.Id, 20) then
			return false, "BAD_REQUEST"
		end
		if not EggService.SetHeld(player, p.Id) then
			return false, "NOT_FOUND"
		end
		return true, { Id = p.Id }
	end
	if p.Best == true then
		local index = bestIndex(data)
		if not index then
			return false, "NO_EGGS", "You have no eggs. Find them around Dragon Haven!"
		end
		EggService.SetHeld(player, data.Eggs[index].Id)
		return true, { Id = data.Eggs[index].Id }
	end
	clearHeld(player)
	return true, {}
end

local function handleHatch(player: Player, p)
	if not Net.check.int(p.Slot, 1, #EggConfig.IncubatorPrices) then
		return false, "BAD_REQUEST"
	end
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	local key = tostring(p.Slot)
	local slot = data.Incubator.Slots[key]
	if not slot then
		return false, "EMPTY"
	end
	if now() < slot.Ready then
		return false, "NOT_READY", "This egg is still warming up."
	end
	local nest = nestPart(player)
	if nest and nearestDistance(player, nest.Position) > GameConfig.Interaction.NestServerRange + 40 then
		return false, "TOO_FAR", "Go to your sanctuary to hatch it."
	end
	local services = Services
	local dragonService = services.DragonService
	-- luck: Forge upgrade (+%), multiplied by potions / Owner Dragon pass
	local boosts = services.BoostService
	local eggLuck = math.max(1, tonumber(slot.Luck) or 1)
	local luckMult = (boosts and boosts.LuckMultiplier(player) or 1) * eggLuck
	local mutationMult = luckMult
	local tree = services.TreeService
	if tree and tree.Bonus then
		mutationMult *= 1 + tree.Bonus(player, "MutationLuck")
	end
	local luck = (1 + EconomyConfig.upgradeValue("HatchLuck", data.Upgrades.HatchLuck or 0)) * luckMult - 1
	local species = rollSpecies(slot.Type, luck)
	local mutation = rollMutation(mutationMult)
	local eggDef = EggConfig.Eggs[slot.Type]
	if mutation == "None" and eggDef and eggDef.GuaranteedMutation then
		-- Rainbow eggs always hatch mutated (weighted like the Mutate action)
		local total = 0
		for _, e in MutationConfig.MutateWeights do
			total += e.Weight
		end
		local r = rng:NextNumber() * total
		for _, e in MutationConfig.MutateWeights do
			r -= e.Weight
			if r <= 0 then
				mutation = e.Id
				break
			end
		end
	end
	local isNew = data.Index[species] == nil
	local record, err = dragonService.Add(player, species, mutation, "Hatch")
	if not record then
		if err == "STORAGE_FULL" then
			return false, err, "Your dragon storage is full! Release a dragon or upgrade Dragon Storage."
		end
		return false, err or "FAILED"
	end
	-- "1 in N" title: the result's base odds from this egg (luck makes it likelier, not less rare)
	local odds = resultOdds(slot.Type, 0, 1, species, mutation)
	if odds > 0 then
		record = table.clone(record)
		record.Odds = odds
		Data.Set(player, { "Dragons", record.UniqueId, "Odds" }, odds)
	end
	Data.Set(player, { "Incubator", "Slots", key }, nil)
	EggService.Hatched:Fire(player, record, slot.Type)
	EggService.announceHatch(player, record, odds)
	return true, { Dragon = record, New = isNew, Egg = slot.Type, Luck = eggLuck }
end

local function handleBuyIncubator(player: Player, p)
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	local slot = data.Incubator.Unlocked + 1
	if p.Slot ~= nil and p.Slot ~= slot then
		return false, "BAD_REQUEST"
	end
	local price = EggConfig.IncubatorPrices[slot]
	if not price then
		return false, "MAXED", "Your nest is fully expanded."
	end
	if not Services.EconomyService.Spend(player, price, "Incubator") then
		return false, "NOT_ENOUGH_CASH", "You need more coins."
	end
	Data.Set(player, { "Incubator", "Unlocked" }, slot)
	return true, { Unlocked = slot }
end

-- ============================================================== lifecycle
local function onLoaded(player: Player)
	if states[player] then
		return
	end
	states[player] = { Active = {}, Serial = 0 }
	task.spawn(function()
		while not areasLoaded and player.Parent == Players do
			task.wait(0.5)
		end
		fillEggs(player)
		local list = {}
		for _, e in states[player] and states[player].Active or {} do
			table.insert(list, serialize(e))
		end
		Net.signal(player, "Eggs", { List = list })
	end)
end

function EggService.GetActive(player: Player)
	local st = states[player]
	return st and st.Active or {}
end

-- Client asks for a full resync (e.g. after its controller restarts).
local function handleSync(player: Player)
	local st = states[player]
	if not st then
		return false, "NOT_LOADED"
	end
	local list = {}
	for _, e in st.Active do
		table.insert(list, serialize(e))
	end
	return true, { List = list }
end

function EggService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.handle("Egg", "Pickup", handlePickup, { Burst = 10, PerSecond = 6 })
	Net.handle("Egg", "Place", handlePlace, { Burst = 6, PerSecond = 3 })
	Net.handle("Egg", "Hold", handleHold, { Burst = 8, PerSecond = 4 })
	Net.handle("Egg", "Hatch", handleHatch, { Burst = 4, PerSecond = 2 })
	Net.handle("Egg", "BuyIncubator", handleBuyIncubator, { Burst = 3, PerSecond = 1 })
	Net.handle("Egg", "Sync", handleSync, { Burst = 3, PerSecond = 1 })
end

function EggService.Start()
	task.spawn(function()
		while not Workspace:GetAttribute("WorldReady") do
			task.wait(0.25)
		end
		loadAreas()
	end)
	Data.Loaded:Connect(function(player)
		onLoaded(player)
	end)
	for _, player in Players:GetPlayers() do
		if Data.IsLoaded(player) then
			onLoaded(player)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in Players:GetPlayers() do
				pcall(reconcileHeld, player)
			end
		end
	end)
end

return EggService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000080">
				<Properties>
					<string name="Name">IndexService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	IndexService
	Pays the Dragon Index milestones (IndexConfig): 5, 10, 15, 20, 25 and all 30 species found.

	Net (domain "Index"):
	  Claim { Count } -> { Count, Cash?, Spins?, Boost?, Egg? }
	Errors: BAD_REQUEST, NOT_LOADED, NO_SUCH_MILESTONE, NOT_ENOUGH, ALREADY_CLAIMED
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local IndexConfig = require(Configs:WaitForChild("IndexConfig"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))

local IndexService = {}

local Data
local Services

local function handleClaim(player: Player, p)
	if not Net.check.int(p.Count, 1, 1000) then
		return false, "BAD_REQUEST"
	end
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	local milestone
	for _, m in IndexConfig.milestones() do
		if m.Count == p.Count then
			milestone = m
		end
	end
	if not milestone then
		return false, "NO_SUCH_MILESTONE"
	end
	if IndexConfig.found(data.Index) < milestone.Count then
		return false, "NOT_ENOUGH", "Find more dragons first."
	end
	local key = tostring(milestone.Count)
	if data.IndexClaims and data.IndexClaims[key] then
		return false, "ALREADY_CLAIMED", "You already took this reward."
	end
	Data.Set(player, { "IndexClaims", key }, true)
	local out = { Count = milestone.Count }
	local parts = {}
	if milestone.Cash then
		local income = Services.EconomyService.IncomeRate(player)
		out.Cash = math.floor(math.max(milestone.Cash.Min, income * milestone.Cash.Seconds) + 0.5)
		Services.EconomyService.Earn(player, out.Cash, "Index")
		table.insert(parts, Format.cash(out.Cash))
	end
	if milestone.Spins then
		Services.SpinService.AddTickets(player, milestone.Spins)
		out.Spins = milestone.Spins
		table.insert(parts, string.format("%d spins", milestone.Spins))
	end
	if milestone.Boost then
		Services.BoostService.Add(player, milestone.Boost.Id, milestone.Boost.Seconds)
		out.Boost = milestone.Boost
		table.insert(parts, string.format("%d min boost", milestone.Boost.Seconds // 60))
	end
	if milestone.Egg then
		local ok = Services.EggService.GiveEgg(player, milestone.Egg.Type, milestone.Egg.Luck, true)
		local def = EggConfig.Eggs[milestone.Egg.Type]
		if ok then
			out.Egg = milestone.Egg
			table.insert(parts, string.format("%s x%d", def and def.Name or "egg", milestone.Egg.Luck))
		end
	end
	Net.notify(player, "rare", string.format("COLLECTION %d DRAGONS!  %s", milestone.Count, table.concat(parts, "  +  ")))
	return true, out
end

function IndexService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.handle("Index", "Claim", handleClaim, { Burst = 4, PerSecond = 1 })
end

return IndexService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000081">
				<Properties>
					<string name="Name">IslandService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	IslandService
	Builds the floating sky islands (WorldConfig.SkyIslands, World/SkyIslands) into Workspace.World and
	registers an egg area for each with EggService (a rare area: its luck rolls twice). Eggs then grow on
	the islands like anywhere else: the personal egg cycle picks island areas, a share of the roaming
	eggs and every other wild egg may appear on one (EggConfig.Spawning.IslandShare).

	API: IslandService.Ready (bool), IslandService.Models() -> { [id] = Model }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local WorldConfig = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("WorldConfig"))

local IslandService = {}
IslandService.Ready = false

local Services
local models: { [string]: Model } = {}

function IslandService.Models()
	return models
end

function IslandService.Init(services)
	Services = services
end

function IslandService.Start()
	task.spawn(function()
		local world = Workspace:WaitForChild("World", 180)
		if not world then
			warn("[Islands] no World folder: the sky islands are not built")
			return
		end
		local ok, SkyIslands = pcall(function()
			return require(ServerScriptService:WaitForChild("World"):WaitForChild("SkyIslands"))
		end)
		if not ok then
			warn("[Islands] SkyIslands module failed: " .. tostring(SkyIslands))
			return
		end
		local folder = Instance.new("Folder")
		folder.Name = "SkyIslands"
		folder.Parent = world
		local eggs = Services and Services.EggService
		for _, def in WorldConfig.SkyIslands do
			local built, model = pcall(SkyIslands.build, folder, def)
			if built then
				models[def.Id] = model
				if eggs and eggs.AddArea then
					eggs.AddArea({
						Name = def.Id,
						Label = def.Name,
						Position = def.Center + Vector3.new(0, 2.5, 0),
						Region = def.Region,
						Radius = def.Radius * 0.78,
						Island = true,
					})
				end
			else
				warn("[Islands] " .. def.Id .. " failed: " .. tostring(model))
			end
		end
		IslandService.Ready = true
	end)
end

return IslandService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000082">
				<Properties>
					<string name="Name">LeaderboardService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	LeaderboardService
	Global top-10 boards in the hub plaza (server-built SurfaceGuis, so they
	replicate and stream like any other part).

	* Every WriteSeconds each player's values are written to one
	  OrderedDataStore per board (and once more when they leave).
	* Every RefreshSeconds the top entries are read back, merged with the
	  live values of everyone in this server (so the boards react at once),
	  and the board rows are updated.
	* Without DataStore access (Studio without API access, outages) the
	  boards simply rank the players in this server.
	* Also counts play time (data.Stats.PlayTime, seconds).
	* Hub boards stand on the plaza ring, Race boards (monthly race, fastest racers, arena warriors)
	  on the Race Island plaza. Race times are stored as scores (RaceConfig.timeScore) so that the
	  stores' "highest first" order means "fastest first".

	API: Top(boardId), TopNamed(boardId), TopOfStore(storeName, count), NameOf(userId),
	     WriteNow(player), RefreshNow(), ArrivalCFrame()
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local LeaderboardConfig = require(Configs:WaitForChild("LeaderboardConfig"))
local WorldConfig = require(Configs:WaitForChild("WorldConfig"))
local RaceConfig = require(Configs:WaitForChild("RaceConfig"))

local LeaderboardService = {}

local Services
local Data
local stores: { [string]: OrderedDataStore } = {}
local storeFailed = false
local nameCache: { [number]: string } = {}
local boards: { [string]: { Rows: { any }, Status: TextLabel, Subtitle: TextLabel? } } = {}
local lastWrite: { [Player]: number } = {}
local tops: { [string]: { { UserId: number, Value: number } } } = {}
local globals: { [string]: { { UserId: number, Value: number } }? } = {} -- last read of the global tops
local MONTHS = { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" }

local V3 = Vector3.new
local FONT_TITLE = Enum.Font.GothamBlack
local FONT_BODY = Enum.Font.GothamBold
local WHITE = Color3.new(1, 1, 1)
local MEDALS = { Color3.fromRGB(255, 205, 60), Color3.fromRGB(205, 214, 224), Color3.fromRGB(222, 140, 80) }

-- ============================================================== values
local function valueOf(player: Player, stat: string): number
	local data = Data.Get(player)
	if not data then
		return 0
	end
	if stat == "Earned" then
		return tonumber(data.TotalEarned) or 0
	elseif stat == "Hatched" then
		return tonumber(data.Stats and data.Stats.Hatched) or 0
	elseif stat == "PlayTime" then
		return tonumber(data.Stats and data.Stats.PlayTime) or 0
	elseif stat == "Income" then
		local econ = Services.EconomyService
		return econ and econ.IncomeRate(player) or 0
	elseif stat == "DragonPower" or stat == "DragonLevel" then
		local best = 0
		for _, rec in data.Dragons do
			local v = stat == "DragonPower" and (tonumber(rec.IncomePerSecond) or 0) or (tonumber(rec.Level) or 0)
			if v > best then
				best = v
			end
		end
		return best
	elseif stat == "RaceBest" then
		local ms = tonumber(data.Race and data.Race.Best) or 0
		return ms > 0 and RaceConfig.timeScore(ms) or 0
	elseif stat == "RaceMonthly" then
		local race = data.Race
		local ms = (race and race.MonthKey == RaceConfig.monthKey()) and tonumber(race.MonthBest) or 0
		return ms > 0 and RaceConfig.timeScore(ms) or 0
	elseif stat == "ArenaKills" then
		return tonumber(data.Stats and data.Stats.ArenaKills) or 0
	end
	return 0
end
LeaderboardService.valueOf = valueOf

local function formatValue(fmt: string, v: number): string
	if fmt == "Cash" then
		return "$" .. Format.abbreviate(v)
	elseif fmt == "PerSecond" then
		return "$" .. Format.abbreviate(v) .. "/s"
	elseif fmt == "Time" then
		local h = math.floor(v / 3600)
		local m = math.floor(v % 3600 / 60)
		if h >= 24 then
			return string.format("%dd %dh", math.floor(h / 24), h % 24)
		elseif h > 0 then
			return string.format("%dh %02dm", h, m)
		end
		return string.format("%dm", m)
	elseif fmt == "Level" then
		return "LV " .. tostring(math.floor(v))
	elseif fmt == "RaceTime" then
		return RaceConfig.formatTime(RaceConfig.scoreTime(v))
	end
	return Format.abbreviate(v)
end
LeaderboardService.formatValue = formatValue

local function storeValue(v: number): number
	return math.clamp(math.floor(v), 0, 9e18)
end

local function nameFor(userId: number): string
	local online = Players:GetPlayerByUserId(userId)
	if online then
		nameCache[userId] = online.Name
		return online.Name
	end
	if nameCache[userId] then
		return nameCache[userId]
	end
	if userId <= 0 then
		return "Player" .. tostring(-userId)
	end
	local ok, name = pcall(function()
		return Players:GetNameFromUserIdAsync(userId)
	end)
	local result = ok and name or ("User" .. tostring(userId))
	nameCache[userId] = result
	return result
end

-- ============================================================== datastore
local function storeName(board): string
	local s = board.Store
	return type(s) == "function" and s() or s
end

local function storeByName(name: string): OrderedDataStore?
	if storeFailed then
		return nil
	end
	if stores[name] then
		return stores[name]
	end
	local ok, store = pcall(function()
		return DataStoreService:GetOrderedDataStore(name)
	end)
	if ok and store then
		stores[name] = store
		return store
	end
	storeFailed = true
	return nil
end

local function storeFor(board): OrderedDataStore?
	return storeByName(storeName(board))
end

local function writePlayer(player: Player)
	if storeFailed or player.UserId <= 0 or not Data.Get(player) then
		return
	end
	lastWrite[player] = os.clock()
	for _, board in LeaderboardConfig.Boards do
		local store = storeFor(board)
		if not store then
			return
		end
		local raw = valueOf(player, board.Stat)
		local ok = true
		if not (board.SkipZero and raw <= 0) then
			local value = storeValue(raw)
			ok = pcall(function()
				store:SetAsync(tostring(player.UserId), value)
			end)
		end
		if not ok then
			storeFailed = RunService:IsStudio() -- no API access in Studio: stop trying
			if storeFailed then
				return
			end
		end
	end
end

local function readTop(board): { { UserId: number, Value: number } }?
	local store = storeFor(board)
	if not store then
		return nil
	end
	local ok, page = pcall(function()
		return store:GetSortedAsync(false, LeaderboardConfig.TopCount):GetCurrentPage()
	end)
	if not ok or type(page) ~= "table" then
		if RunService:IsStudio() then
			storeFailed = true
		end
		return nil
	end
	local out = {}
	for _, entry in page do
		local id = tonumber(entry.key)
		if id then
			table.insert(out, { UserId = id, Value = tonumber(entry.value) or 0 })
		end
	end
	return out
end

-- Global entries + live values of the players in this server.
local function merged(board, global: { { UserId: number, Value: number } }?)
	local byId: { [number]: number } = {}
	for _, e in global or {} do
		byId[e.UserId] = e.Value
	end
	for _, player in Players:GetPlayers() do
		if Data.Get(player) then
			local v = valueOf(player, board.Stat)
			local id = player.UserId -- (Studio test players have negative ids)
			if v > (byId[id] or -1) then
				byId[id] = v
			end
		end
	end
	local list = {}
	for id, v in byId do
		if not board.SkipZero or v > 0 then
			table.insert(list, { UserId = id, Value = v })
		end
	end
	table.sort(list, function(a, b)
		if a.Value ~= b.Value then
			return a.Value > b.Value
		end
		return a.UserId < b.UserId
	end)
	while #list > LeaderboardConfig.TopCount do
		table.remove(list)
	end
	return list
end

-- ============================================================== boards (world)
local function part(props): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = true
	p.CastShadow = true
	p.Material = Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		(p :: any)[k] = v
	end
	return p
end

local function label(props): TextLabel
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.TextColor3 = WHITE
	t.Font = FONT_BODY
	t.TextScaled = true
	t.TextXAlignment = Enum.TextXAlignment.Left
	for k, v in props do
		(t :: any)[k] = v
	end
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(20, 24, 40)
	stroke.Transparency = 0.25
	stroke.Parent = t
	return t
end

local function corner(parent: Instance, scale: number)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(scale, 0)
	c.Parent = parent
end

local W, H = 16, 21 -- screen size (studs)

local function buildBoard(parent: Instance, board, cf: CFrame)
	local model = Instance.new("Model")
	model.Name = "Leaderboard_" .. board.Id
	-- toy-brick frame: two posts, a base, a header block with studs
	local frameCol = Color3.fromRGB(58, 64, 92)
	for _, sx in { -1, 1 } do
		part({ Name = "Post", Size = V3(1.6, H + 6, 1.6), CFrame = cf * CFrame.new(sx * (W / 2 + 0.6), (H + 6) / 2, 0.4), Color = frameCol, Parent = model })
		part({ Name = "Foot", Size = V3(3.2, 1.2, 4), CFrame = cf * CFrame.new(sx * (W / 2 + 0.6), 0.6, 0.4), Color = board.Dark, Parent = model })
	end
	part({ Name = "Back", Size = V3(W + 1.2, H + 1.2, 0.6), CFrame = cf * CFrame.new(0, 4 + H / 2, 0.9), Color = frameCol, Parent = model })
	local header = part({ Name = "Header", Size = V3(W + 3.2, 3.2, 2.2), CFrame = cf * CFrame.new(0, 4 + H + 2.2, 0.4), Color = board.Color, Parent = model })
	for i = -3, 3 do
		local stud = part({ Name = "Stud", Shape = Enum.PartType.Cylinder, Size = V3(0.5, 1.1, 1.1), Color = board.Color, CanCollide = false, Parent = model })
		stud.CFrame = cf * CFrame.new(i * 2.4, 4 + H + 2.2 + 1.85, 0.4) * CFrame.Angles(0, 0, math.rad(90))
	end
	-- the screen
	local screen = part({
		Name = "Screen",
		Size = V3(W, H, 0.4),
		CFrame = cf * CFrame.new(0, 4 + H / 2, 0.4),
		Color = Color3.fromRGB(26, 30, 52),
		CanCollide = false,
		Parent = model,
	})
	local headerGui = Instance.new("SurfaceGui")
	headerGui.Name = "Title"
	headerGui.Face = Enum.NormalId.Front
	headerGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	headerGui.PixelsPerStud = 40
	headerGui.LightInfluence = 0
	headerGui.MaxDistance = 400
	headerGui.Adornee = header
	headerGui.Parent = header
	label({ Text = board.Title, Font = FONT_TITLE, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(0.94, 0.78), Position = UDim2.fromScale(0.03, 0.11), Parent = headerGui })

	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.MaxDistance = 300
	gui.Adornee = screen
	gui.Parent = screen
	local bg = Instance.new("Frame")
	bg.Size = UDim2.fromScale(1, 1)
	bg.BackgroundColor3 = Color3.fromRGB(26, 30, 52)
	bg.BorderSizePixel = 0
	bg.Parent = gui
	local grad = Instance.new("UIGradient")
	grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.fromRGB(44, 50, 86), Color3.fromRGB(18, 20, 36))
	grad.Parent = bg
	local subtitle = label({ Text = string.upper(board.Subtitle), TextColor3 = board.Color, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(0.9, 0.055), Position = UDim2.fromScale(0.05, 0.02), Parent = bg })

	local rows = {}
	local top, rowH = 0.095, 0.083
	for i = 1, LeaderboardConfig.TopCount do
		local row = Instance.new("Frame")
		row.Name = "Row" .. i
		row.Position = UDim2.fromScale(0.03, top + (i - 1) * rowH)
		row.Size = UDim2.fromScale(0.94, rowH * 0.9)
		row.BackgroundColor3 = i <= 3 and MEDALS[i] or Color3.fromRGB(255, 255, 255)
		row.BackgroundTransparency = i <= 3 and 0.72 or (i % 2 == 0 and 0.94 or 0.9)
		row.BorderSizePixel = 0
		row.Parent = bg
		corner(row, 0.25)
		local rank = Instance.new("Frame")
		rank.Size = UDim2.fromScale(0.11, 0.8)
		rank.Position = UDim2.fromScale(0.015, 0.1)
		rank.BackgroundColor3 = i <= 3 and MEDALS[i] or Color3.fromRGB(70, 78, 120)
		rank.BorderSizePixel = 0
		rank.Parent = row
		corner(rank, 0.5)
		label({ Text = tostring(i), Font = FONT_TITLE, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 0.8), Position = UDim2.fromScale(0, 0.1), Parent = rank })
		local avatar = Instance.new("ImageLabel")
		avatar.Name = "Avatar"
		avatar.BackgroundColor3 = Color3.fromRGB(60, 66, 104)
		avatar.BorderSizePixel = 0
		avatar.Size = UDim2.fromScale(0.11, 0.86)
		avatar.Position = UDim2.fromScale(0.14, 0.07)
		avatar.Image = ""
		avatar.Parent = row
		corner(avatar, 0.5)
		local name = label({ Name = "PlayerName", Text = "---", Size = UDim2.fromScale(0.44, 0.62), Position = UDim2.fromScale(0.27, 0.19), Parent = row })
		local value = label({
			Name = "Value",
			Text = "",
			Font = FONT_TITLE,
			TextColor3 = i <= 3 and MEDALS[i] or board.Color,
			TextXAlignment = Enum.TextXAlignment.Right,
			Size = UDim2.fromScale(0.27, 0.62),
			Position = UDim2.fromScale(0.71, 0.19),
			Parent = row,
		})
		rows[i] = { Name = name, Value = value, Avatar = avatar }
	end
	local status = label({
		Name = "Status",
		Text = "Updating...",
		TextColor3 = Color3.fromRGB(160, 168, 200),
		TextXAlignment = Enum.TextXAlignment.Center,
		Font = FONT_BODY,
		Size = UDim2.fromScale(0.9, 0.04),
		Position = UDim2.fromScale(0.05, 0.94),
		Parent = bg,
	})
	model.PrimaryPart = screen
	model.Parent = parent
	boards[board.Id] = { Rows = rows, Status = status, Subtitle = subtitle }
	return model
end

local function groundAt(x: number, z: number): number
	local ground = Services.WorldService and Services.WorldService.Ground
	if ground then
		local ok, y = pcall(ground, x, z)
		if ok and type(y) == "number" then
			return y
		end
	end
	return WorldConfig.Hub.Height
end

local function buildAll()
	local world = Workspace:FindFirstChild("World")
	local folder = Instance.new("Folder")
	folder.Name = "Leaderboards"
	folder.Parent = world or Workspace
	local center = WorldConfig.Hub.Center
	local hubIndex = 0
	for _, board in LeaderboardConfig.Boards do
		if board.Where == "Race" then
			-- on the Race Island plaza, turned towards the spot where players arrive
			local arrival = RaceConfig.toWorld(RaceConfig.Arrival)
			for _, spot in RaceConfig.Boards do
				if spot.Id == board.Id then
					local at = RaceConfig.toWorld(spot.Position)
					buildBoard(folder, board, CFrame.lookAt(at, V3(arrival.X, at.Y, arrival.Z)))
				end
			end
		else
			hubIndex += 1
			local a = math.rad(LeaderboardConfig.Angles[hubIndex] or (180 + (hubIndex - 2.5) * 26))
			local x = center.X + math.sin(a) * LeaderboardConfig.Ring
			local z = center.Z - math.cos(a) * LeaderboardConfig.Ring
			local y = groundAt(x, z)
			-- front (-Z of the frame) faces the plaza centre
			local cf = CFrame.lookAt(V3(x, y, z), V3(center.X, y, center.Z))
			buildBoard(folder, board, cf)
		end
	end
end

-- Where the Teleport menu's "Spawn" puts the player (looking at the boards).
function LeaderboardService.ArrivalCFrame(): CFrame
	local c = WorldConfig.Hub.Center
	local a = LeaderboardConfig.Arrival
	local x, z = c.X + a.X, c.Z + a.Z
	local y = groundAt(x, z) + 3.4
	return CFrame.lookAt(V3(x, y, z), V3(x, y, z + 10))
end

-- ============================================================== refresh
local function render(board, list)
	local ui = boards[board.Id]
	if not ui then
		return
	end
	for i, rowUi in ui.Rows do
		local e = list[i]
		if e then
			rowUi.Name.Text = nameFor(e.UserId)
			rowUi.Value.Text = formatValue(board.Format, e.Value)
			rowUi.Avatar.Image = e.UserId > 0 and string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", e.UserId) or ""
		else
			rowUi.Name.Text = "---"
			rowUi.Value.Text = ""
			rowUi.Avatar.Image = ""
		end
	end
	ui.Status.Text = storeFailed and "Live ranking of this server" or "Global top 10  -  updates every minute"
	if board.Monthly and ui.Subtitle then
		local d = os.date("!*t")
		ui.Subtitle.Text = string.upper(string.format("%s %d  -  %s", MONTHS[d.month] or "", d.year, RaceConfig.Monthly.PrizeText))
	end
end

local function refresh()
	for _, board in LeaderboardConfig.Boards do
		local global = readTop(board)
		globals[board.Id] = global
		local list = merged(board, global)
		tops[board.Id] = list
		render(board, list)
	end
end

function LeaderboardService.Top(boardId: string)
	return tops[boardId] or {}
end

local function boardById(boardId: string)
	for _, board in LeaderboardConfig.Boards do
		if board.Id == boardId then
			return board
		end
	end
	return nil
end

-- A board as text rows (the Race window): live values of this server merged into the last global read.
function LeaderboardService.TopNamed(boardId: string)
	local board = boardById(boardId)
	if not board then
		return {}
	end
	local out = {}
	for i, e in merged(board, globals[boardId]) do
		out[i] = { Rank = i, Name = nameFor(e.UserId), UserId = e.UserId, Value = e.Value, Text = formatValue(board.Format, e.Value) }
	end
	return out
end

function LeaderboardService.NameOf(userId: number): string
	return nameFor(userId)
end

-- Top entries of any ordered store (monthly winner lookup). nil without DataStore access.
function LeaderboardService.TopOfStore(name: string, count: number?): { { UserId: number, Value: number } }?
	local store = storeByName(name)
	if not store then
		return nil
	end
	local ok, page = pcall(function()
		return store:GetSortedAsync(false, count or 1):GetCurrentPage()
	end)
	if not ok or type(page) ~= "table" then
		return nil
	end
	local out = {}
	for _, entry in page do
		local id = tonumber(entry.key)
		if id then
			table.insert(out, { UserId = id, Value = tonumber(entry.value) or 0 })
		end
	end
	return out
end

-- Writes one player's values to the stores right away (after a new race record).
function LeaderboardService.WriteNow(player: Player)
	writePlayer(player)
end

function LeaderboardService.RefreshNow()
	refresh()
end

function LeaderboardService.Init(services)
	Services = services
	Data = services.PlayerDataService
end

function LeaderboardService.Start()
	while not (Services.WorldService and Services.WorldService.Ready) do
		task.wait(0.25)
	end
	buildAll()
	Players.PlayerRemoving:Connect(function(player)
		task.spawn(writePlayer, player)
		lastWrite[player] = nil
	end)
	-- play time + periodic writes
	task.spawn(function()
		while true do
			task.wait(LeaderboardConfig.PlayTimeTick)
			for _, player in Players:GetPlayers() do
				if Data.Get(player) then
					Data.Increment(player, { "Stats", "PlayTime" }, LeaderboardConfig.PlayTimeTick)
					if os.clock() - (lastWrite[player] or 0) >= LeaderboardConfig.WriteSeconds then
						task.spawn(writePlayer, player)
					end
				end
			end
		end
	end)
	-- refresh loop (first pass shortly after start so the boards fill in)
	task.spawn(function()
		task.wait(3)
		while true do
			local ok, err = pcall(refresh)
			if not ok then
				warn("[Leaderboard] " .. tostring(err))
			end
			task.wait(storeFailed and 10 or LeaderboardConfig.RefreshSeconds)
		end
	end)
end

return LeaderboardService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000083">
				<Properties>
					<string name="Name">LeaderstatsService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	LeaderstatsService
	Roblox player-list leaderboard (leaderstats): Cash (abbreviated), Dragons,
	Hatched. Updated from the data mirror, at most a few times per second.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Format = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"):WaitForChild("Format"))

local LeaderstatsService = {}

local Data
local stats: { [Player]: { [string]: ValueBase } } = {}

local function build(player: Player)
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Value = "$0"
	cash.Parent = folder
	local dragons = Instance.new("IntValue")
	dragons.Name = "Dragons"
	dragons.Parent = folder
	local hatched = Instance.new("IntValue")
	hatched.Name = "Hatched"
	hatched.Parent = folder
	folder.Parent = player
	stats[player] = { Cash = cash, Dragons = dragons, Hatched = hatched }
end

local function refresh(player: Player)
	local s = stats[player]
	local data = Data.Get(player)
	if not s or not data then
		return
	end
	local cash = Format.cash(data.Cash or 0)
	if (s.Cash :: StringValue).Value ~= cash then
		(s.Cash :: StringValue).Value = cash
	end
	local n = 0
	for _ in data.Dragons do
		n += 1
	end
	(s.Dragons :: IntValue).Value = n;
	(s.Hatched :: IntValue).Value = data.Stats and data.Stats.Hatched or 0
end

function LeaderstatsService.Init(services)
	Data = services.PlayerDataService
end

function LeaderstatsService.Start()
	Data.Loaded:Connect(function(player)
		if not stats[player] then
			build(player)
		end
		refresh(player)
	end)
	for _, player in Players:GetPlayers() do
		if Data.Get(player) and not stats[player] then
			build(player)
			refresh(player)
		end
	end
	Players.PlayerRemoving:Connect(function(player)
		stats[player] = nil
	end)
	task.spawn(function()
		while true do
			task.wait(0.5)
			for player in stats do
				if player.Parent == Players then
					refresh(player)
				end
			end
		end
	end)
end

return LeaderstatsService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000084">
				<Properties>
					<string name="Name">LevelService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	LevelService
	The player level (data.Level / data.XP, shown in the HUD). Awards XP for what
	players actually do and pays a reward on every level up:

	  egg picked up            EconomyConfig.XP.EggFound
	  dragon hatched           DragonConfig.Rarities[rarity].HatchXP (+ mutation bonus)
	  new species discovered   EconomyConfig.XP.FirstPlace
	  distance flown           EconomyConfig.XP.FlyPer1000 per 1000 studs (server-measured)
	  dragon bond level up     EconomyConfig.XP.BondLevel + 4 per level
	  Great Tree level bought  EconomyConfig.XP.TreeLevel + 5 per level
	  anything else            LevelService.Add(player, amount, reason)

	The Great Tree branch "Ancient Wisdom" multiplies all XP. Reaching level N
	needs EconomyConfig.playerXPToNext(N - 1) XP; the cap is MaxPlayerLevel.
	Regions (RegionConfig.RequiredLevel) unlock by level.

	Net signal "LevelUp" { Level, Cash, Spins, Unlocks = { region names } }
	Signal: LevelUp(player, level)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local EconomyConfig = require(Configs:WaitForChild("EconomyConfig"))
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))
local RegionConfig = require(Configs:WaitForChild("RegionConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local LevelService = {}
LevelService.LevelUp = Signal.new() -- (player, level)

local Data
local Services

local lastFlyPos: { [Player]: Vector3 } = {}
local flyCarry: { [Player]: number } = {} -- distance not yet turned into XP

local FLY_TICK = 2

function LevelService.Level(player: Player): number
	local data = Data.Get(player)
	return data and data.Level or 1
end

local function levelUpRewards(player: Player, level: number)
	local cash, spins = EconomyConfig.levelReward(level)
	if cash > 0 then
		Services.EconomyService.Earn(player, cash, "LevelUp")
	end
	if spins > 0 and Services.SpinService and Services.SpinService.AddTickets then
		Services.SpinService.AddTickets(player, spins)
	end
	local unlocks = {}
	for _, id in RegionConfig.Order do
		local region = RegionConfig.Regions[id]
		if region.RequiredLevel == level and level > 1 then
			table.insert(unlocks, region.Name)
		end
	end
	Net.signal(player, "LevelUp", { Level = level, Cash = cash, Spins = spins, Unlocks = unlocks })
	local text = string.format("LEVEL UP! You reached level %d  (+$%d)", level, cash)
	if spins > 0 then
		text ..= string.format(" +%d spins", spins)
	end
	Net.notify(player, "rare", text)
	for _, name in unlocks do
		Net.notify(player, "success", name .. " is now open to you!")
	end
end

-- Adds player XP (Ancient Wisdom applies). Returns the number of levels gained.
function LevelService.Add(player: Player, amount: number, reason: string?): number
	local data = Data.Get(player)
	if not data or type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	local gain = math.max(1, math.floor(amount * (1 + TreeConfig.bonus(data, "Wisdom")) + 0.5))
	local level = math.clamp(math.floor(tonumber(data.Level) or 1), 1, EconomyConfig.MaxPlayerLevel)
	local xp = math.max(0, math.floor(tonumber(data.XP) or 0)) + gain
	local gained = 0
	while level < EconomyConfig.MaxPlayerLevel do
		local need = EconomyConfig.playerXPToNext(level)
		if xp < need then
			break
		end
		xp -= need
		level += 1
		gained += 1
	end
	if level >= EconomyConfig.MaxPlayerLevel then
		xp = math.min(xp, EconomyConfig.playerXPToNext(level) - 1)
	end
	Data.Set(player, { "XP" }, xp)
	if gained > 0 then
		local first = data.Level + 1
		Data.Set(player, { "Level" }, level)
		for lv = first, level do
			levelUpRewards(player, lv)
		end
		LevelService.LevelUp:Fire(player, level)
	end
	local _ = reason
	return gained
end

-- ============================================================== sources
local function onHatched(player: Player, record, _eggType)
	local rarity = DragonConfig.Rarities[record.Rarity]
	local xp = rarity and rarity.HatchXP or 0
	xp *= 1 + MutationConfig.rank(record.Mutation) * EconomyConfig.XP.MutationRank
	local data = Data.Get(player)
	local entry = data and data.Index and data.Index[record.SpeciesId]
	if entry and (tonumber(entry.Count) or 0) <= 1 then
		xp += EconomyConfig.XP.FirstPlace
	end
	LevelService.Add(player, xp, "Hatch")
end

local function flyTick()
	local mount = Services.MountService
	for _, player in Players:GetPlayers() do
		local comp = mount and mount.Get(player)
		if comp and comp.Riding and comp.Model.Parent and comp.Model:GetAttribute("Mode") == "Fly" then
			local pos = comp.Root.Position
			local prev = lastFlyPos[player]
			lastFlyPos[player] = pos
			if prev then
				local moved = math.min((pos - prev).Magnitude, 900) -- teleports/snap-backs do not count
				if moved > 1 then
					Data.Increment(player, { "Stats", "DistanceFlown" }, moved)
					local carry = (flyCarry[player] or 0) + moved
					local per = 1000 / EconomyConfig.XP.FlyPer1000
					local xp = math.floor(carry / per)
					flyCarry[player] = carry - xp * per
					if xp > 0 then
						LevelService.Add(player, xp, "Flight")
					end
				end
			end
		else
			lastFlyPos[player] = nil
		end
	end
end

function LevelService.Init(services)
	Services = services
	Data = services.PlayerDataService
end

function LevelService.Start()
	Services.EggService.PickedUp:Connect(function(player)
		LevelService.Add(player, EconomyConfig.XP.EggFound, "Egg")
	end)
	Services.EggService.Hatched:Connect(onHatched)
	local bond = Services.BondService
	if bond and bond.LevelUp then
		bond.LevelUp:Connect(function(player, _uid, level)
			LevelService.Add(player, EconomyConfig.XP.BondLevel + level * 4, "Bond")
		end)
	end
	local tree = Services.TreeService
	if tree and tree.Bought then
		tree.Bought:Connect(function(player, _id, level)
			LevelService.Add(player, EconomyConfig.XP.TreeLevel + level * 5, "Tree")
		end)
	end
	task.spawn(function()
		while true do
			task.wait(FLY_TICK)
			pcall(flyTick)
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastFlyPos[player] = nil
		flyCarry[player] = nil
	end)
end

return LevelService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000085">
				<Properties>
					<string name="Name">MonetizationService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	MonetizationService
	Robux purchases: developer products (ProcessReceipt, idempotent by
	PurchaseId) and game passes (ownership checked on join + purchase
	finished). Grants are applied server-side only, then saved right away.

	Studio: items whose Id is still 0 can be "bought" with Net
	Shop.TestBuy { Item } (free test purchase, Studio only).

	Net (domain "Shop"): TestBuy { Item } -> { Item, Text }
]]

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local MonetizationConfig = require(Configs:WaitForChild("MonetizationConfig"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))

local MonetizationService = {}

local Services
local Data
local MAX_RECEIPTS = 100

-- ============================================================== grants
local function ownsSpecies(data, speciesId: string): boolean
	for _, r in data.Dragons do
		if r.SpeciesId == speciesId then
			return true
		end
	end
	return false
end

-- Game pass perks (idempotent: safe to call on every join).
function MonetizationService.GrantPass(player: Player, itemId: string): (boolean, string?)
	local pass = MonetizationConfig.GamePasses[itemId]
	local data = Data.Get(player)
	if not pass or not data then
		return false, nil
	end
	local fresh = not MonetizationConfig.ownsPass(data, itemId)
	if type(data.Flags.Passes) ~= "table" then
		Data.Set(player, { "Flags", "Passes" }, {})
	end
	Data.Set(player, { "Flags", "Passes", itemId }, true)
	if itemId == "OwnerDragon" then
		Data.Set(player, { "Flags", "OwnerPass" }, true)
	end
	if pass.Grants and not ownsSpecies(data, pass.Grants) then
		local record = Services.DragonService.Add(player, pass.Grants, pass.Mutation or "None", "Purchase", true)
		if record and data.EquippedDragon == "" then
			Services.DragonService.Equip(player, record.UniqueId)
		end
	end
	if Services.BoostService then
		Services.BoostService.Refresh(player)
	end
	local text
	if fresh then
		text = pass.UnlockText or string.format("%s unlocked! x%s LUCK on every roll, forever.", string.upper(pass.Name), tostring(pass.Luck or 1))
	end
	return true, text
end

-- Consumables. Returns ok, toast text.
function MonetizationService.GrantProduct(player: Player, itemId: string): (boolean, string?)
	local product = MonetizationConfig.Products[itemId]
	local data = Data.Get(player)
	if not product or not data then
		return false, nil
	end
	local kind = product.Kind
	if kind == "Boost" then
		Services.BoostService.Add(player, product.Boost, product.Seconds)
		return true, string.format("%s active for %d minutes!", MonetizationConfig.Boosts[product.Boost].Name, math.floor(product.Seconds / 60))
	elseif kind == "Cash" then
		local rate = Services.EconomyService.IncomeRate(player)
		local amount = math.max(product.Minimum or 0, math.floor(rate * (product.IncomeSeconds or 0)))
		Services.EconomyService.Earn(player, amount, "Purchase")
		return true, "+" .. Format.cash(amount) .. "!"
	elseif kind == "Spins" then
		if Services.SpinService then
			Services.SpinService.AddTickets(player, product.Count or 1)
		end
		return true, string.format("+%d spins! Use them on Spin Island.", product.Count or 1)
	elseif kind == "DragonLevel" then
		local uid = Services.DragonService.PotionTarget(player)
		if not uid then
			Services.EconomyService.Earn(player, 5000, "Purchase")
			return true, "No dragon to level up - you got $5K instead."
		end
		local gained = Services.DragonService.AddLevels(player, uid, product.Levels or 5)
		local record = data.Dragons[uid]
		if gained <= 0 then
			Services.BoostService.Add(player, "Luck", 15 * 60)
			return true, "Your dragon is max level - you got a Luck Potion instead!"
		end
		return true, string.format("%s gained %d levels!", record and record.Name or "Your dragon", gained)
	elseif kind == "LuckyEggs" then
		-- eggs with big luck appear around the player (only for them), for a few minutes
		local n = Services.EggService.SpawnBonusEggs(player, product.Count or 3, product.Luck, product.Lifetime or 300)
		if n <= 0 then
			Services.EconomyService.Earn(player, 25000, "Purchase")
			return true, "No room for the eggs right now - you got $25K instead."
		end
		return true, string.format("%d lucky eggs appeared around you! Find them before they vanish.", n)
	elseif kind == "Eggs" then
		-- eggs straight into the bag (it may overflow: paid eggs are never lost)
		local given, lost = 0, 0
		for _ = 1, product.Count or 1 do
			local ok = Services.EggService.GiveEgg(player, product.Egg, product.Luck or 1, true)
			if ok then
				given += 1
			else
				lost += 1
			end
		end
		local def = EggConfig.Eggs[product.Egg]
		local text = string.format("+%d %s with x%d luck in your bag!", given, def and def.Name or "Egg", product.Luck or 1)
		if lost > 0 then
			-- cannot happen with a valid egg id; pay the rest out instead of losing it
			local cash = 100000 * lost
			Services.EconomyService.Earn(player, cash, "Purchase")
			text ..= string.format(" %d eggs could not be added and were paid out as %s.", lost, Format.cash(cash))
		end
		return true, text
	elseif kind == "DragonMutation" then
		local uid = Services.DragonService.PotionTarget(player)
		local mutation = uid and Services.DragonService.UpgradeMutation(player, uid)
		if not mutation then
			Services.BoostService.Add(player, "SuperLuck", 30 * 60)
			return true, "Already the best mutation - you got a Super Luck Potion instead!"
		end
		local m = MutationConfig.Mutations[mutation]
		local record = data.Dragons[uid]
		return true, string.format("%s is now %s!", record and record.Name or "Your dragon", string.upper(m and m.Name or mutation))
	end
	return false, nil
end

local function grant(player: Player, itemId: string, robux: number?): (boolean, string?)
	local def, kind = MonetizationConfig.find(itemId)
	if not def then
		return false, nil
	end
	local ok, text
	if kind == "Pass" then
		ok, text = MonetizationService.GrantPass(player, itemId)
	else
		ok, text = MonetizationService.GrantProduct(player, itemId)
	end
	if ok then
		Data.Increment(player, { "Purchases", "Robux" }, robux or def.Price or 0)
		Data.SaveNow(player)
	end
	return ok, text
end

-- ============================================================== receipts
local function processReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = Data.Get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local receipts = data.Purchases.Receipts
	if table.find(receipts, receipt.PurchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	local itemId = MonetizationConfig.byProductId(receipt.ProductId)
	if not itemId then
		warn("[Monetization] unknown product " .. tostring(receipt.ProductId))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local ok, text = pcall(grant, player, itemId, receipt.CurrencySpent)
	if not ok then
		warn("[Monetization] grant failed: " .. tostring(text))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local list = table.clone(receipts)
	table.insert(list, receipt.PurchaseId)
	while #list > MAX_RECEIPTS do
		table.remove(list, 1)
	end
	Data.Set(player, { "Purchases", "Receipts" }, list)
	Data.SaveNow(player)
	Net.notify(player, "rare", text or "Purchase complete!")
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function checkPasses(player: Player)
	for itemId, pass in MonetizationConfig.GamePasses do
		if pass.Id ~= 0 then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, pass.Id)
			end)
			if ok and owns then
				MonetizationService.GrantPass(player, itemId)
			end
		end
	end
	-- perks already granted earlier (e.g. Studio test purchase) stay applied
	local data = Data.Get(player)
	for itemId in MonetizationConfig.GamePasses do
		if data and MonetizationConfig.ownsPass(data, itemId) then
			MonetizationService.GrantPass(player, itemId)
		end
	end
end

-- ============================================================== net
local function testBuy(player: Player, p)
	if not RunService:IsStudio() then
		return false, "NOT_ALLOWED"
	end
	if not Net.check.str(p.Item, 40) then
		return false, "BAD_REQUEST"
	end
	local def = MonetizationConfig.find(p.Item)
	if not def then
		return false, "BAD_ITEM"
	end
	local ok, text = grant(player, p.Item, 0)
	if not ok then
		return false, "FAILED"
	end
	return true, { Item = p.Item, Text = text or ((def.Name or p.Item) .. " (test purchase)") }
end

function MonetizationService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.handle("Shop", "TestBuy", testBuy, { Burst = 4, PerSecond = 1 })
end

function MonetizationService.Start()
	MarketplaceService.ProcessReceipt = processReceipt
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local itemId = MonetizationConfig.byPassId(passId)
		if itemId then
			local ok, text = grant(player, itemId)
			if ok then
				Net.notify(player, "rare", text or "Purchase complete!")
			end
		end
	end)
	Data.Loaded:Connect(function(player)
		task.spawn(checkPasses, player)
	end)
	for _, player in Players:GetPlayers() do
		if Data.Get(player) then
			task.spawn(checkPasses, player)
		end
	end
	if RunService:IsStudio() then
		ReplicatedStorage:SetAttribute("TestPurchases", true)
	end
end

return MonetizationService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000086">
				<Properties>
					<string name="Name">MountService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	MountService
	Owns each player's companion dragon on the server. The server only creates
	the invisible physics Root (+ LinearVelocity / AlignOrientation) and the
	identity attributes; every client builds the visual model locally.

	The owner's client simulates the root (network ownership) - riding input
	or the follow AI - and sends only low-frequency state changes (mode,
	boost, one-shot actions). The server validates speed/altitude and snaps
	the dragon back on violations.

	Mounting joints the character's HumanoidRootPart to the root with a
	Motor6D ("RiderJoint"); clients animate its Transform so the rider moves
	with the dragon's body.

	Net: Mount.Toggle, Mount.Ride, Mount.Dismount, Mount.Recall
	     event DragonState { Mode, Boost, Shot }
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local DragonStats = require(Shared:WaitForChild("DragonStats"))
local Odds = require(Shared:WaitForChild("Odds"))
local Builder = require(Shared:WaitForChild("Dragons"):WaitForChild("Builder"))
local GameConfig = require(Configs:WaitForChild("GameConfig"))
local BondConfig = require(Configs:WaitForChild("BondConfig"))
local RaceConfig = require(Configs:WaitForChild("RaceConfig"))

local MountService = {}
MountService.Mounted = Signal.new() -- (player, model)
MountService.Dismounted = Signal.new() -- (player, model)

local Data
local DragonService
local PhysicsGroups
local TreeService

local folder: Folder
local companions: { [Player]: any } = {}

local MODES = { Ground = true, Air = true, Takeoff = true, Fly = true, Landing = true }
local SHOTS = { Jump = true, Takeoff = true, Landing = true, Roar = true, Cheer = true, Loop = true, Howl = true }
local VALIDATE_INTERVAL = 0.25

local rayParams = RaycastParams.new()
rayParams.CollisionGroup = "DragonQuery"
rayParams.RespectCanCollide = true
rayParams.IgnoreWater = false

local function groundBelow(pos: Vector3, depth: number): number?
	local hit = Workspace:Raycast(pos + Vector3.new(0, 4, 0), Vector3.new(0, -(depth + 4), 0), rayParams)
	return hit and hit.Position.Y or nil
end

local function characterParts(player: Player)
	local character = player.Character
	if not character then
		return nil
	end
	local hrp = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character, hrp, humanoid
end

local function yawOnly(cf: CFrame): CFrame
	local look = cf.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude < 1e-3 then
		flat = Vector3.new(0, 0, -1)
	end
	return CFrame.lookAt(Vector3.zero, flat.Unit)
end

-- ============================================================== spawning
function MountService.Get(player: Player)
	return companions[player]
end

function MountService.GetModel(player: Player): Model?
	local c = companions[player]
	return c and c.Model or nil
end

local function despawn(player: Player)
	local comp = companions[player]
	if not comp then
		return
	end
	companions[player] = nil
	if comp.Riding then
		local character, hrp, humanoid = characterParts(player)
		if character and hrp and humanoid then
			humanoid.PlatformStand = false
			character:SetAttribute("Mounted", nil)
			PhysicsGroups.setGroup(character, "Characters")
		end
	end
	if comp.Model then
		comp.Model:Destroy()
	end
end

-- Great Tree bonus of the owner (fraction): FlySpeed "Wind Wings", RunSpeed "Swift Paws".
local function treeBonus(player: Player?, id: string): number
	return player and TreeService and TreeService.Bonus(player, id) or 0
end

-- Identity + stat attributes of the companion model for a dragon record.
local function writeRecordAttributes(model: Model, record, info, player: Player?)
	model:SetAttribute("DragonUid", record.UniqueId)
	model:SetAttribute("SpeciesId", record.SpeciesId)
	model:SetAttribute("Mutation", record.Mutation)
	model:SetAttribute("DisplayName", record.Name)
	model:SetAttribute("Level", record.Level)
	model:SetAttribute("Rarity", record.Rarity)
	model:SetAttribute("HipHeight", info.HipHeight)
	model:SetAttribute("BodyRadius", info.BodyRadius)
	model:SetAttribute("Scale", info.Scale)
	model:SetAttribute("RunSpeed", DragonStats.runSpeed(record, treeBonus(player, "RunSpeed")))
	model:SetAttribute("CruiseSpeed", DragonStats.cruiseSpeed(record, treeBonus(player, "FlySpeed")))
	model:SetAttribute("BondLevel", BondConfig.levelFor(record.BondXP))
	model:SetAttribute("Odds", Odds.ofRecord(record))
	model:SetAttribute("Exclusive", Odds.isExclusive(record.SpeciesId))
end

local function spawnFor(player: Player)
	despawn(player)
	-- developer switch (UI test harness): no companions at all
	if ReplicatedStorage:GetAttribute("DevDisableCompanions") then
		return nil
	end
	local data = Data.Get(player)
	if not data then
		return nil
	end
	local uid = data.EquippedDragon
	local record = uid ~= "" and data.Dragons[uid] or nil
	if not record then
		return nil
	end
	local character, hrp = characterParts(player)
	if not character or not hrp then
		return nil
	end
	local info = Builder.mountInfo(record.SpeciesId)

	-- beside and slightly behind the player, on the ground
	local base = yawOnly(hrp.CFrame) + hrp.Position
	local spot = (base * CFrame.new(info.BodyRadius + 4, 0, info.BodyRadius * 0.6)).Position
	local gy = groundBelow(spot + Vector3.new(0, 20, 0), 80) or (hrp.Position.Y - 3)
	local cf = CFrame.new(spot.X, gy + info.HipHeight, spot.Z) * yawOnly(hrp.CFrame)

	local model = Instance.new("Model")
	model.Name = "Dragon_" .. player.UserId
	model:SetAttribute("OwnerUserId", player.UserId)
	writeRecordAttributes(model, record, info, player)
	model:SetAttribute("Mode", "Ground")
	model:SetAttribute("Boost", false)
	model:SetAttribute("Breathing", false)
	model:SetAttribute("RiderUserId", 0)
	model:SetAttribute("ShotId", 0)
	model:SetAttribute("Kind", "Companion")
	model:SetAttribute("VisualRev", 0)

	local root = Builder.makeRoot(record.SpeciesId)
	root.CFrame = cf
	root.Parent = model
	model.PrimaryPart = root
	local att = root:FindFirstChild("RootAttachment") :: Attachment

	local lv = Instance.new("LinearVelocity")
	lv.Name = "Drive"
	lv.Attachment0 = att
	lv.RelativeTo = Enum.ActuatorRelativeTo.World
	lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
	lv.MaxForce = math.huge
	lv.VectorVelocity = Vector3.zero
	lv.Parent = root

	local ao = Instance.new("AlignOrientation")
	ao.Name = "Attitude"
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.Attachment0 = att
	ao.RigidityEnabled = true
	ao.MaxTorque = math.huge
	ao.Responsiveness = 200
	ao.CFrame = cf.Rotation
	ao.Parent = root

	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.PersistentPerPlayer
	end)
	PhysicsGroups.setGroup(model, "Dragons")
	model.Parent = folder
	pcall(function()
		model:AddPersistentPlayer(player)
	end)
	pcall(function()
		root:SetNetworkOwner(player)
	end)

	local comp = {
		Player = player,
		Model = model,
		Root = root,
		Uid = uid,
		Record = record,
		Info = info,
		Riding = false,
		Joint = nil,
		LastPos = root.Position,
		LastGood = cf,
		LastT = os.clock(),
		Violations = 0,
		ShotId = 0,
	}
	companions[player] = comp
	return comp
end
MountService.Spawn = spawnFor

-- Hot-swaps the companion to another dragon record without despawning: the
-- physics root keeps flying, a rider stays seated, and clients rebuild only
-- the visual (VisualRev changes). Used for equip switches and mutations.
local function swapRecord(comp, record)
	local info = Builder.mountInfo(record.SpeciesId)
	local model = comp.Model
	writeRecordAttributes(model, record, info, comp.Player)
	comp.Root.Size = info.RootSize
	comp.Uid = record.UniqueId
	comp.Record = record
	comp.Info = info
	if comp.Joint then
		comp.Joint.C0 = info.Saddle
	end
	model:SetAttribute("VisualRev", (model:GetAttribute("VisualRev") or 0) + 1)
end

-- ============================================================== mount / dismount
local function mount(player: Player)
	-- nobody out (every dragon rests on a perch): the strongest one comes down and is ridden
	local data = Data.Get(player)
	if data and data.EquippedDragon == "" then
		local uid = DragonService.EquipBest(player)
		local record = uid and data.Dragons[uid]
		if record then
			Net.notify(player, "info", record.Name .. " came down from its perch.")
		end
	end
	local comp = companions[player] or spawnFor(player)
	if not comp then
		return false, "NO_DRAGON", "No dragon is out. Open your dragons and press RIDE on one - it comes down from its perch."
	end
	if comp.Riding then
		return true
	end
	local character, hrp, humanoid = characterParts(player)
	if not character or not hrp or not humanoid then
		return false, "NO_CHARACTER"
	end
	local root = comp.Root
	-- far away (e.g. after a teleport): bring the dragon to the rider first
	if (root.Position - hrp.Position).Magnitude > 90 then
		comp = spawnFor(player)
		if not comp then
			return false, "NO_DRAGON"
		end
		root = comp.Root
	end
	local joint = Instance.new("Motor6D")
	joint.Name = "RiderJoint"
	joint.Part0 = root
	joint.Part1 = hrp
	joint.C0 = comp.Info.Saddle
	joint.C1 = CFrame.new(0, -(hrp.Size.Y * 0.5 + 0.12), 0)
	character:SetAttribute("Mounted", true)
	PhysicsGroups.setGroup(character, "Riders")
	humanoid.PlatformStand = true
	humanoid.Sit = false
	joint.Parent = root
	comp.Joint = joint
	comp.Riding = true
	comp.Model:SetAttribute("RiderUserId", player.UserId)
	player:SetAttribute("Riding", true)
	pcall(function()
		root:SetNetworkOwner(player)
	end)
	MountService.Mounted:Fire(player, comp.Model)
	return true
end

local function dismount(player: Player)
	local comp = companions[player]
	if not comp or not comp.Riding then
		return true
	end
	comp.Riding = false
	if comp.Joint then
		comp.Joint:Destroy()
		comp.Joint = nil
	end
	comp.Model:SetAttribute("RiderUserId", 0)
	player:SetAttribute("Riding", false)
	local character, hrp, humanoid = characterParts(player)
	if character and hrp and humanoid then
		character:SetAttribute("Mounted", nil)
		PhysicsGroups.setGroup(character, "Characters")
		humanoid.PlatformStand = false
		-- step off on the dragon's left side, upright
		local root = comp.Root
		local side = (yawOnly(root.CFrame) + root.Position) * CFrame.new(-(comp.Info.RootSize.X * 0.5 + 3), 0, 0)
		local pos = side.Position
		local gy = groundBelow(pos + Vector3.new(0, 6, 0), comp.Info.HipHeight + 30)
		local y = gy and (gy + humanoid.HipHeight + hrp.Size.Y * 0.5 + 0.2) or pos.Y
		hrp.CFrame = CFrame.new(pos.X, y, pos.Z) * yawOnly(root.CFrame)
		hrp.AssemblyLinearVelocity = Vector3.zero
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	pcall(function()
		comp.Root:SetNetworkOwner(player)
	end)
	MountService.Dismounted:Fire(player, comp.Model)
	return true
end
MountService.Mount = mount
MountService.Dismount = dismount

-- Re-reads stat attributes after something changed them (Great Tree bonuses, bond level).
-- The visual is rebuilt when the Bond Aura (bond level 50) appears.
function MountService.RefreshStats(player: Player)
	local comp = companions[player]
	if comp and comp.Model.Parent then
		local data = Data.Get(player)
		local record = data and data.Dragons[comp.Uid] or comp.Record
		comp.Record = record
		local hadAura = (comp.Model:GetAttribute("BondLevel") or 0) >= BondConfig.PerkById.Aura.Level
		writeRecordAttributes(comp.Model, record, comp.Info, player)
		local hasAura = (comp.Model:GetAttribute("BondLevel") or 0) >= BondConfig.PerkById.Aura.Level
		if hadAura ~= hasAura then
			comp.Model:SetAttribute("VisualRev", (comp.Model:GetAttribute("VisualRev") or 0) + 1)
		end
	end
end

-- Server-validated one-shot animation for everybody else (BondService: Dash, Flourish).
function MountService.PlayShot(player: Player, shot: string)
	local comp = companions[player]
	if not comp or not comp.Model.Parent then
		return
	end
	comp.ShotId = (comp.ShotId + 1) % 10000
	comp.Model:SetAttribute("Shot", shot)
	comp.Model:SetAttribute("ShotId", comp.ShotId)
end

function MountService.IsRiding(player: Player): boolean
	local comp = companions[player]
	return comp ~= nil and comp.Riding
end

-- Holds the dragon in place (race start grid): anchored, nobody steers it. Releasing gives the
-- rider the physics back.
function MountService.Freeze(player: Player, on: boolean): boolean
	local comp = companions[player]
	if not comp or not comp.Root.Parent then
		return false
	end
	local root = comp.Root
	if on then
		pcall(function()
			root:SetNetworkOwner(nil)
		end)
		root.AssemblyLinearVelocity = Vector3.zero
		root.Anchored = true
	else
		root.Anchored = false
		pcall(function()
			root:SetNetworkOwner(player)
		end)
	end
	comp.Frozen = on
	comp.LastPos = root.Position
	comp.LastT = os.clock()
	comp.Violations = 0
	return true
end

-- Server teleport of the companion (fast travel while riding): moves the
-- physics root (the rider follows through the joint) and resets the
-- movement validation so the jump is not treated as a speed violation.
function MountService.MoveTo(player: Player, cf: CFrame)
	local comp = companions[player]
	if not comp or not comp.Root.Parent then
		return false
	end
	local root = comp.Root
	local target = CFrame.new(cf.Position) * yawOnly(cf)
	root.CFrame = target
	root.AssemblyLinearVelocity = Vector3.zero
	comp.LastPos = target.Position
	comp.LastGood = target
	comp.LastT = os.clock()
	comp.Violations = 0
	return true
end

-- ============================================================== validation
local function maxSpeedFor(comp): number
	local cruise = DragonStats.cruiseSpeed(comp.Record, treeBonus(comp.Player, "FlySpeed"))
	if comp.Player:GetAttribute("RaceActive") then
		cruise = math.max(cruise, RaceConfig.Standard.Cruise) -- everybody flies the standard dragon in a race
	end
	local run = DragonStats.runSpeed(comp.Record, treeBonus(comp.Player, "RunSpeed"))
	local m = GameConfig.Movement
	-- boost + dive bonus + generous slack for latency (+ the Wind Dash window)
	local limit = math.max(cruise * m.BoostMultiplier * 1.75, run * 1.6) + 60
	if comp.DashUntil and os.clock() < comp.DashUntil then
		limit *= 1.6
	end
	return limit
end

local function snapBack(player: Player, comp)
	local root = comp.Root
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	root.CFrame = comp.LastGood
	root.AssemblyLinearVelocity = Vector3.zero
	task.delay(0.4, function()
		if companions[player] == comp and root.Parent then
			pcall(function()
				root:SetNetworkOwner(player)
			end)
		end
	end)
end

local function validate()
	local t = os.clock()
	for player, comp in companions do
		local root = comp.Root
		if not root.Parent then
			continue
		end
		local dt = t - comp.LastT
		if dt < VALIDATE_INTERVAL then
			continue
		end
		local pos = root.Position
		local dist = (pos - comp.LastPos).Magnitude
		local allowed = maxSpeedFor(comp) * dt + 25
		local ok = dist <= allowed
		if not ok then
			-- follow catch-up teleports to the owner are allowed
			local _, hrp = characterParts(player)
			if hrp and not comp.Riding and (pos - hrp.Position).Magnitude < 60 then
				ok = true
			end
		end
		if pos.Y > GameConfig.Riding.Ceiling + 120 or pos.Y < Workspace.FallenPartsDestroyHeight + 50 then
			ok = false
		end
		if ok then
			comp.Violations = math.max(0, comp.Violations - 0.5)
			comp.LastGood = root.CFrame
		else
			comp.Violations += 1
			if comp.Violations >= 3 then
				comp.Violations = 0
				snapBack(player, comp)
				pos = comp.LastGood.Position
			end
		end
		comp.LastPos = pos
		comp.LastT = t
	end
end

-- ============================================================== state relay
local function onDragonState(player: Player, p)
	local comp = companions[player]
	if not comp then
		return
	end
	local model = comp.Model
	if type(p.Mode) == "string" and MODES[p.Mode] then
		model:SetAttribute("Mode", p.Mode)
	end
	if type(p.Boost) == "boolean" then
		model:SetAttribute("Boost", p.Boost)
	end
	if type(p.Shot) == "string" and SHOTS[p.Shot] then
		comp.ShotId = (comp.ShotId + 1) % 10000
		model:SetAttribute("Shot", p.Shot)
		model:SetAttribute("ShotId", comp.ShotId)
	end
end

-- ============================================================== lifecycle
function MountService.Init(services)
	Data = services.PlayerDataService
	DragonService = services.DragonService
	PhysicsGroups = services.PhysicsGroups
	TreeService = services.TreeService

	folder = Workspace:FindFirstChild("Dragons") :: Folder
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Dragons"
		folder.Parent = Workspace
	end

	Net.handle("Mount", "Ride", function(player)
		return mount(player)
	end, { Burst = 4, PerSecond = 1.5 })
	Net.handle("Mount", "Dismount", function(player)
		return dismount(player)
	end, { Burst = 4, PerSecond = 1.5 })
	Net.handle("Mount", "Toggle", function(player)
		local comp = companions[player]
		if comp and comp.Riding then
			local ok = dismount(player)
			return ok, { Riding = false }
		end
		local ok, err, msg = mount(player)
		if ok then
			return true, { Riding = true }
		end
		return false, err, msg
	end, { Burst = 4, PerSecond = 1.5 })
	Net.handle("Mount", "Recall", function(player)
		local riding = MountService.IsRiding(player)
		if riding then
			return false, "RIDING"
		end
		return spawnFor(player) ~= nil
	end, { Burst = 2, PerSecond = 0.2 })
	Net.onEvent("DragonState", onDragonState, { Burst = 12, PerSecond = 8 })
end

function MountService.Start()
	DragonService.EquippedChanged:Connect(function(player: Player, uid: string)
		local comp = companions[player]
		local data = Data.Get(player)
		local record = data and uid ~= "" and data.Dragons[uid] or nil
		if comp and comp.Model.Parent and record then
			if comp.Uid == uid and comp.Record.Mutation == record.Mutation then
				-- same dragon (fed / levelled): refresh stats and labels
				comp.Record = record
				writeRecordAttributes(comp.Model, record, comp.Info, player)
			else
				-- another dragon or a new mutation: hot swap in place
				swapRecord(comp, record)
			end
			return
		end
		if comp and comp.Riding then
			dismount(player)
		end
		despawn(player)
		if record then
			spawnFor(player)
		end
	end)

	local function onCharacter(player: Player, character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if not humanoid then
			return
		end
		character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.2)
		if player.Parent ~= Players or player.Character ~= character then
			return
		end
		if Data.Get(player) then
			spawnFor(player)
		end
		humanoid.Died:Connect(function()
			local comp = companions[player]
			if comp and comp.Riding then
				comp.Riding = false
				if comp.Joint then
					comp.Joint:Destroy()
					comp.Joint = nil
				end
				comp.Model:SetAttribute("RiderUserId", 0)
				player:SetAttribute("Riding", false)
			end
		end)
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
	Players.PlayerAdded:Connect(onPlayer)
	Players.PlayerRemoving:Connect(despawn)
	Data.Loaded:Connect(function(player)
		if player.Character and not companions[player] then
			spawnFor(player)
		end
	end)

	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc >= VALIDATE_INTERVAL then
			acc = 0
			validate()
		end
	end)
end

return MountService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000087">
				<Properties>
					<string name="Name">PhysicsGroups</string>
					<ProtectedString name="Source"><![CDATA[--[[
	PhysicsGroups
	Collision groups:
	  Dragons      dragon physics roots + visuals (never collide with anything)
	  Characters   player characters on foot
	  Riders       characters while mounted (collide with nothing, so a rider
	               can never snag the dragon on geometry)
	  Eggs         pickup eggs
	  DragonQuery  raycast group used by movement/camera queries: ignores
	               dragons, characters, riders and eggs
]]

local PhysicsService = game:GetService("PhysicsService")
local Players = game:GetService("Players")

local PhysicsGroups = {}

local GROUPS = { "Dragons", "Characters", "Riders", "Eggs", "DragonQuery" }

local function register(name: string)
	if not PhysicsService:IsCollisionGroupRegistered(name) then
		PhysicsService:RegisterCollisionGroup(name)
	end
end

local function setGroup(model: Instance, group: string)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.CollisionGroup = group
		end
	end
end
PhysicsGroups.setGroup = setGroup

function PhysicsGroups.Init()
	for _, g in GROUPS do
		register(g)
	end
	local function off(a: string, b: string)
		PhysicsService:CollisionGroupSetCollidable(a, b, false)
	end
	off("Dragons", "Dragons")
	off("Dragons", "Characters")
	off("Dragons", "Riders")
	off("Dragons", "Default")
	off("Dragons", "Eggs")
	off("Riders", "Default")
	off("Riders", "Characters")
	off("Riders", "Riders")
	off("Riders", "Eggs")
	off("DragonQuery", "Dragons")
	off("DragonQuery", "Characters")
	off("DragonQuery", "Riders")
	off("DragonQuery", "Eggs")
end

local function watchCharacter(character: Model)
	local group = character:GetAttribute("Mounted") and "Riders" or "Characters"
	setGroup(character, group)
	character.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then
			d.CollisionGroup = character:GetAttribute("Mounted") and "Riders" or "Characters"
		end
	end)
end

function PhysicsGroups.Start()
	local function onPlayer(player: Player)
		if player.Character then
			watchCharacter(player.Character)
		end
		player.CharacterAdded:Connect(watchCharacter)
	end
	for _, p in Players:GetPlayers() do
		onPlayer(p)
	end
	Players.PlayerAdded:Connect(onPlayer)
end

return PhysicsGroups
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000088">
				<Properties>
					<string name="Name">PlayerDataService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	PlayerDataService
	Owns every player's saved data.

	- Loads with UpdateAsync + session lock (prevents duplication across servers)
	- Retries with backoff; never hands out a blank profile when the store fails
	  (the player is kicked with a friendly message instead, protecting saves)
	- Studio without API access: runs on an in-memory profile and warns
	- Autosave, save on leave, BindToClose flush
	- All writes go through Set/Increment/Update so the client mirror stays in
	  sync (batched to one DataSync message per player per frame)
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Signal = require(Shared.Util.Signal)
local TableUtil = require(Shared.Util.TableUtil)
local DragonStats = require(Shared.DragonStats)
local GameConfig = require(Configs.GameConfig)
local EconomyConfig = require(Configs.EconomyConfig)
local TreeConfig = require(Configs.TreeConfig)

local DataSync: RemoteEvent = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DataSync")

local PlayerDataService = {}
PlayerDataService.Loaded = Signal.new() -- (player, data)
PlayerDataService.Releasing = Signal.new() -- (player, data) fired before final save

local CURRENT_VERSION = 1
local LOAD_ATTEMPTS = 6
local SAVE_ATTEMPTS = 4

local TEMPLATE = {
	Version = CURRENT_VERSION,
	Cash = GameConfig.StarterCash,
	TotalEarned = 0,
	Level = 1,
	XP = 0,
	Dragons = {},
	DragonSerial = 0,
	EquippedDragon = "",
	Eggs = {},
	EggSerial = 0,
	Nests = { Unlocked = EconomyConfig.StartingNests, Slots = {} },
	Incubator = { Unlocked = 2, Slots = {} },
	PendingIncome = 0,
	Upgrades = { EggStorage = 0, DragonStorage = 0, HatchLuck = 0, Radar = 0 },
	Tree = {}, -- Great Tree levels { [branchId] = level }, see TreeConfig
	Index = {},
	IndexClaims = {}, -- Dragon Index milestones already paid, see IndexConfig
	Regions = { Haven = true },
	Quests = { Active = {}, Completed = 0, Serial = 0 },
	Tutorial = { Step = 1, Done = false },
	Daily = { LastClaim = 0, Streak = 0 },
	Settings = {
		Graphics = "Max",
		Music = 0.6,
		SFX = 0.8,
		CameraShake = true,
		SpeedFOV = true,
		MouseLock = true,
		Sensitivity = 1,
		InvertY = false,
		UIScale = 1,
		MenuBlur = false,
	},
	Stats = {
		EggsFound = 0,
		Hatched = 0,
		DistanceFlown = 0,
		PlayTime = 0,
		Collected = 0,
		Fed = 0,
		BoostSeconds = 0,
		Released = 0,
		MutateTries = 0,
		Spins = 0,
		ArenaKills = 0,
		ArenaDeaths = 0,
		Coins = 0,
		DuelsWon = 0,
		DuelsLost = 0,
	},
	Flags = { StarterGranted = false, OwnerPass = false, Passes = {} },
	Boosts = {},
	Spin = { NextFree = 0, Tickets = 3 },
	Race = { Best = 0, Runs = 0, Wins = 0, MonthKey = "", MonthBest = 0, Crowns = {} }, -- see RaceService
	Purchases = { Receipts = {}, Robux = 0 },
	Rank = 0, -- 0 = none, 1..5 = RankConfig.Ranks (set by the owner with /rank, see RankService)
	CreatedAt = 0,
	LastLogin = 0,
	LastLogout = 0,
}
PlayerDataService.Template = TEMPLATE

local store: DataStore? = nil
local profiles: { [Player]: any } = {}
local pending: { [Player]: { any } } = {}
local saving: { [Player]: boolean } = {}
local temporaryMode = false
local shuttingDown = false

-- ============================================================== helpers
local function keyFor(userId: number): string
	return "u_" .. tostring(userId)
end

local function now(): number
	return os.time()
end

local function sanitize(data)
	-- Deep copy without server-only fields.
	local copy = TableUtil.deepCopy(data)
	copy.Session = nil
	return copy
end

local function migrate(data)
	data.Version = tonumber(data.Version) or 0
	-- v0 -> v1: (initial schema) nothing to transform yet.
	if data.Version < 1 then
		data.Version = 1
	end
	TableUtil.reconcile(data, TEMPLATE)
	-- Validate dragons and drop anything corrupt.
	for uid, record in data.Dragons do
		if type(record) ~= "table" or type(uid) ~= "string" or not DragonStats.refresh(record) then
			data.Dragons[uid] = nil
		else
			record.UniqueId = uid
		end
	end
	if data.EquippedDragon ~= "" and data.Dragons[data.EquippedDragon] == nil then
		data.EquippedDragon = ""
	end
	-- Nest slots must point to dragons that agree they are placed there.
	for nestId, uid in data.Nests.Slots do
		local record = data.Dragons[uid]
		if not record or record.PlacedNestId ~= nestId then
			data.Nests.Slots[nestId] = nil
		end
	end
	for _, record in data.Dragons do
		if record.PlacedNestId ~= "" and data.Nests.Slots[record.PlacedNestId] ~= record.UniqueId then
			record.PlacedNestId = ""
		end
	end
	data.Nests.Unlocked = math.clamp(math.floor(tonumber(data.Nests.Unlocked) or 2), EconomyConfig.StartingNests, #EconomyConfig.NestPrices)
	data.Cash = math.max(0, tonumber(data.Cash) or 0)
	-- Great Tree: only known branches, levels inside their range
	for id, level in data.Tree do
		local branch = TreeConfig.ById[id]
		if not branch then
			data.Tree[id] = nil
		else
			data.Tree[id] = math.clamp(math.floor(tonumber(level) or 0), 0, #branch.Levels)
		end
	end
	return data
end

local function isStudioAccessError(err: string): boolean
	err = string.lower(err)
	return string.find(err, "studio", 1, true) ~= nil or string.find(err, "api services", 1, true) ~= nil
		or string.find(err, "not allowed", 1, true) ~= nil
end

-- ============================================================== replication
local function queue(player: Player, path: { string }, value: any)
	local list = pending[player]
	if not list then
		list = {}
		pending[player] = list
	end
	table.insert(list, { path, TableUtil.deepCopy(value) })
end

local function flush()
	for player, list in pending do
		pending[player] = nil
		if player.Parent == Players and profiles[player] then
			DataSync:FireClient(player, "Batch", list)
		end
	end
end

-- ============================================================== public API
function PlayerDataService.Get(player: Player)
	return profiles[player] and profiles[player].Data or nil
end

function PlayerDataService.IsLoaded(player: Player): boolean
	return profiles[player] ~= nil
end

function PlayerDataService.IsTemporary(): boolean
	return temporaryMode
end

local function resolve(data, path: { string })
	local node = data
	for i = 1, #path - 1 do
		local nxt = node[path[i]]
		if type(nxt) ~= "table" then
			nxt = {}
			node[path[i]] = nxt
		end
		node = nxt
	end
	return node, path[#path]
end

function PlayerDataService.Set(player: Player, path: { string }, value: any)
	local profile = profiles[player]
	if not profile then
		return
	end
	local node, key = resolve(profile.Data, path)
	node[key] = value
	profile.Dirty = true
	queue(player, path, value)
end

function PlayerDataService.Increment(player: Player, path: { string }, delta: number): number
	local profile = profiles[player]
	if not profile then
		return 0
	end
	local node, key = resolve(profile.Data, path)
	local v = (tonumber(node[key]) or 0) + delta
	node[key] = v
	profile.Dirty = true
	queue(player, path, v)
	return v
end

-- Mutates the value at path through fn(current) -> new, then replicates it.
function PlayerDataService.Update(player: Player, path: { string }, fn)
	local profile = profiles[player]
	if not profile then
		return nil
	end
	local node, key = resolve(profile.Data, path)
	local nv = fn(node[key])
	node[key] = nv
	profile.Dirty = true
	queue(player, path, nv)
	return nv
end

function PlayerDataService.NextId(player: Player, counterKey: string, prefix: string): string
	local n = PlayerDataService.Increment(player, { counterKey }, 1)
	return string.format("%s%d_%d", prefix, player.UserId, n)
end

-- ============================================================== load / save
local function newProfile(player: Player)
	local data = TableUtil.deepCopy(TEMPLATE)
	data.CreatedAt = now()
	return data
end

local function loadData(player: Player)
	if temporaryMode or not store then
		return newProfile(player), true
	end
	local key = keyFor(player.UserId)
	local jobId = game.JobId ~= "" and game.JobId or "studio"
	for attempt = 1, LOAD_ATTEMPTS do
		local lockedBy = nil
		local ok, result = pcall(function()
			return (store :: DataStore):UpdateAsync(key, function(old)
				old = old or newProfile(player)
				local session = old.Session
				if session and session.JobId ~= jobId and now() - (tonumber(session.Time) or 0) < GameConfig.SessionLockTimeout then
					-- Locked by another live server; steal only on the final attempt
					-- if the lock is old enough (crashed server).
					if attempt < LOAD_ATTEMPTS or now() - (tonumber(session.Time) or 0) < 120 then
						lockedBy = session.JobId
						return nil
					end
				end
				old.Session = { JobId = jobId, Time = now() }
				return old
			end)
		end)
		if ok and result ~= nil and lockedBy == nil then
			return result, false
		end
		if not ok then
			local err = tostring(result)
			if isStudioAccessError(err) then
				warn("[PlayerData] DataStore unavailable in Studio (enable 'Studio Access to API Services' to test saving). Using a temporary profile.")
				temporaryMode = true
				return newProfile(player), true
			end
			warn(string.format("[PlayerData] Load attempt %d failed for %s: %s", attempt, player.Name, err))
		end
		if player.Parent ~= Players then
			return nil, false
		end
		task.wait(math.min(2 ^ attempt, 8))
	end
	return nil, false
end

local function saveData(player: Player, releasing: boolean): boolean
	local profile = profiles[player]
	if not profile or profile.Temporary or not store then
		return true
	end
	if saving[player] and not releasing then
		return false
	end
	saving[player] = true
	local data = profile.Data
	local key = keyFor(player.UserId)
	local jobId = game.JobId ~= "" and game.JobId or "studio"
	data.LastLogout = releasing and now() or data.LastLogout
	local success = false
	for attempt = 1, SAVE_ATTEMPTS do
		local stolen = false
		local ok, err = pcall(function()
			(store :: DataStore):UpdateAsync(key, function(old)
				if old and old.Session and old.Session.JobId ~= jobId then
					-- Another server owns this profile now; never overwrite it.
					stolen = true
					return nil
				end
				local copy = TableUtil.deepCopy(data)
				copy.Session = (not releasing) and { JobId = jobId, Time = now() } or nil
				return copy
			end)
		end)
		if ok then
			if stolen then
				warn("[PlayerData] Session for " .. player.Name .. " was taken by another server; save skipped.")
			end
			success = true
			profile.Dirty = false
			profile.LastSave = os.clock()
			break
		end
		warn(string.format("[PlayerData] Save attempt %d failed for %s: %s", attempt, player.Name, tostring(err)))
		task.wait(attempt)
	end
	saving[player] = nil
	return success
end

PlayerDataService.SaveNow = function(player: Player)
	local profile = profiles[player]
	if profile and os.clock() - (profile.LastSave or 0) > 6 then
		task.spawn(saveData, player, false)
	elseif profile then
		profile.SaveSoon = true
	end
end

local function onPlayerAdded(player: Player)
	local data, temporary = loadData(player)
	if player.Parent ~= Players then
		if data and not temporary then
			-- Player left during load: release the lock we just took.
			profiles[player] = { Data = data, Temporary = false, Dirty = false }
			saveData(player, true)
			profiles[player] = nil
		end
		return
	end
	if not data then
		player:Kick("We couldn't load your dragons right now (data servers are busy). Please rejoin in a moment - your progress is safe.")
		return
	end
	data = migrate(data)
	data.LastLogin = now()
	profiles[player] = { Data = data, Temporary = temporary, Dirty = false, LastSave = os.clock() }
	player:SetAttribute("DataLoaded", true)
	DataSync:FireClient(player, "Init", sanitize(data), { Temporary = temporary })
	PlayerDataService.Loaded:Fire(player, data)
end

local function onPlayerRemoving(player: Player)
	local profile = profiles[player]
	if not profile then
		return
	end
	PlayerDataService.Releasing:Fire(player, profile.Data)
	-- give services a moment to write final state (e.g. playtime) synchronously
	saveData(player, true)
	profiles[player] = nil
	pending[player] = nil
end

function PlayerDataService.Init()
	local ok, ds = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok then
		store = ds
	else
		warn("[PlayerData] GetDataStore failed: " .. tostring(ds) .. " (temporary profiles will be used)")
		temporaryMode = true
	end
end

function PlayerDataService.Start()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	RunService.Heartbeat:Connect(flush)

	-- Autosave loop (staggered so all players do not save in the same frame).
	task.spawn(function()
		while not shuttingDown do
			task.wait(5)
			local t = os.clock()
			for player, profile in profiles do
				if (profile.Dirty and t - (profile.LastSave or 0) >= GameConfig.AutosaveInterval) or (profile.SaveSoon and t - (profile.LastSave or 0) > 6) then
					profile.SaveSoon = false
					task.spawn(saveData, player, false)
					task.wait(0.5)
				end
			end
		end
	end)

	game:BindToClose(function()
		shuttingDown = true
		local remaining = 0
		for player in profiles do
			remaining += 1
			task.spawn(function()
				PlayerDataService.Releasing:Fire(player, profiles[player] and profiles[player].Data)
				saveData(player, true)
				remaining -= 1
			end)
		end
		local deadline = os.clock() + 25
		while remaining > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

-- Saves right away (after Robux purchases), without blocking the caller.
function PlayerDataService.SaveNow(player: Player)
	if profiles[player] then
		task.spawn(saveData, player, false)
	end
end

-- Test hook: force a save (used by QA harness).
PlayerDataService._saveForTests = saveData

return PlayerDataService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000089">
				<Properties>
					<string name="Name">RaceService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	RaceService
	The sky circuit of the Race & Battle Island (RaceConfig). The server decides everything:

	  Lobby      Race.Join (from the Race window / the join pad). The lobby stays open for
	             LobbySeconds (shorter when it is full); a lone racer can start at once.
	  Countdown  everybody is mounted, put on the start grid and frozen; 3-2-1.
	  Running    the server samples every racer's dragon 10 times a second: the next ring gate must
	             be crossed forward inside its radius, in order. Teleporting, flying faster than
	             anything legal, dismounting or leaving the course ends the run (DNF / disqualified).
	  Finish     lap count reached: time (server clock, interpolated inside the sample), place,
	             rewards, best times (all-time + monthly) and the leaderboards.

	Everybody races with the SAME standard dragon stats (player attribute RaceActive: the client
	and the movement validation switch to RaceConfig.Standard), so skill decides, not purchases.

	Monthly prize: on the first day of a month the fastest racer of the previous month is read from
	the monthly leaderboard store and written to the winners history (DataStore RaceWinners_v1, also
	shown on the podium of the island). The winner gets a trophy, a title and a reward in the game and
	the whole server is told. The real-money prize is paid by the game's owner from that record.

	Net (domain "Race"):
	  Join {}      -> { State, Queued? }       Leave {}      StartNow {}
	  State {}     -> snapshot for the window  Top { Board } -> { List }
	Signals to racers: RaceLobby, RaceCount { N }, RaceGo, RaceProgress, RaceFinish, RaceEnd
	Player attributes: RaceState (Lobby | Countdown | Running | Finished), RaceActive, RaceStart, RacePass
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local RaceConfig = require(Configs:WaitForChild("RaceConfig"))

local RaceService = {}
RaceService.Finished = Signal.new() -- (player, ms, place, newBest)

local Services
local Data
local island: Model? = nil
local race: any = nil -- the current race (lobby / countdown / running / done)
local waiting: { Player } = {} -- joined while a race was running: they open the next lobby
local winners: { any } = {} -- monthly champions, newest first
local winnersStore: DataStore? = nil

-- One clock for the whole race: the same server time the clients get as RaceStart, so the
-- lobby timer, the countdown and the finish times can never drift apart.
local function clock(): number
	return Workspace:GetServerTimeNow()
end

-- ============================================================== helpers
local function racerOf(player: Player)
	return race and race.Racers[player] or nil
end

-- The ridden dragon's root, else the character: what the race measures.
local function positionOf(player: Player): Vector3?
	local mount = Services.MountService
	local comp = mount and mount.Get(player)
	if comp and comp.Riding and comp.Root.Parent then
		return comp.Root.Position
	end
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	return hrp and hrp.Position or nil
end

local function onIsland(position: Vector3?): boolean
	return position ~= nil and (position - RaceConfig.Island.Center).Magnitude <= RaceConfig.JoinDistance
end

local function setState(player: Player, state: string?)
	player:SetAttribute("RaceState", state)
end

-- Sends the lobby picture to everyone in it.
local function lobbySignal()
	if not race then
		return
	end
	local list = {}
	for _, p in race.Players do
		table.insert(list, { Name = p.DisplayName, UserId = p.UserId })
	end
	local left = race.State == "Lobby" and math.max(0, race.LobbyEnds - clock()) or 0
	for _, p in race.Players do
		Net.signal(p, "RaceLobby", { Racers = list, Left = left, State = race.State, Laps = RaceConfig.Laps, Gates = RaceConfig.GateCount })
	end
end

local function removeFrom(list: { Player }, player: Player)
	local i = table.find(list, player)
	if i then
		table.remove(list, i)
	end
end

-- ============================================================== results / rewards
local function reward(player: Player, spec, label: string)
	local econ = Services.EconomyService
	local rate = econ and econ.IncomeRate(player) or 0
	local cash = math.max(spec.Min or 0, math.floor(rate * (spec.Minutes or 0) * 60))
	if cash > 0 and econ then
		econ.Earn(player, cash, "Race")
	end
	local level = Services.LevelService
	if level and (spec.XP or 0) > 0 then
		level.Add(player, spec.XP, "Race")
	end
	return { Label = label, Cash = cash, XP = spec.XP or 0 }
end

local function updateBests(player: Player, ms: number): (boolean, boolean)
	local data = Data.Get(player)
	if not data then
		return false, false
	end
	local key = RaceConfig.monthKey()
	local best = tonumber(data.Race.Best) or 0
	local newBest = best <= 0 or ms < best
	if newBest then
		Data.Set(player, { "Race", "Best" }, ms)
	end
	if data.Race.MonthKey ~= key then
		Data.Set(player, { "Race", "MonthKey" }, key)
		Data.Set(player, { "Race", "MonthBest" }, 0)
	end
	local monthBest = tonumber(data.Race.MonthBest) or 0
	local newMonth = monthBest <= 0 or ms < monthBest
	if newMonth then
		Data.Set(player, { "Race", "MonthBest" }, ms)
	end
	Data.Increment(player, { "Race", "Runs" }, 1)
	return newBest, newMonth
end

local function results(r): { any }
	local list = {}
	for _, p in r.Order do
		local rc = r.Racers[p]
		table.insert(list, { Name = p.DisplayName, UserId = p.UserId, Ms = rc.FinishMs, Place = rc.Place })
	end
	for _, p in r.Players do
		local rc = r.Racers[p]
		if rc and rc.Status ~= "Finished" then
			table.insert(list, { Name = p.DisplayName, UserId = p.UserId, Ms = 0, Place = 0, Reason = rc.Reason })
		end
	end
	return list
end

local function finishRacer(r, player: Player, rc, ms: number)
	rc.Status = "Finished"
	rc.FinishMs = ms
	table.insert(r.Order, player)
	rc.Place = #r.Order
	if not r.FirstFinish then
		r.FirstFinish = clock()
	end
	local newBest, newMonth = updateBests(player, ms)
	local rewards = {}
	local multi = r.Started > 1
	if multi and RaceConfig.Rewards.Places[rc.Place] then
		table.insert(rewards, reward(player, RaceConfig.Rewards.Places[rc.Place], "PLACE " .. rc.Place))
	else
		table.insert(rewards, reward(player, RaceConfig.Rewards.Finish, "FINISHED"))
	end
	if newBest then
		table.insert(rewards, reward(player, RaceConfig.Rewards.PersonalBest, "NEW BEST"))
	end
	if multi and rc.Place == 1 then
		Data.Increment(player, { "Race", "Wins" }, 1)
	end
	setState(player, "Finished")
	player:SetAttribute("RaceActive", nil) -- the finisher is free: own dragon again, may travel
	player:SetAttribute("RacePass", nil)
	local data = Data.Get(player)
	Net.signal(player, "RaceFinish", {
		Place = rc.Place,
		Racers = r.Started,
		Ms = ms,
		NewBest = newBest,
		NewMonthBest = newMonth,
		Best = data and data.Race.Best or ms,
		MonthBest = data and data.Race.MonthBest or ms,
		Rewards = rewards,
	})
	local lb = Services.LeaderboardService
	if lb and (newBest or newMonth) and lb.WriteNow then
		task.spawn(lb.WriteNow, player)
	end
	RaceService.Finished:Fire(player, ms, rc.Place, newBest)
end

-- Ends a racer without a result.
local function dnf(r, player: Player, reason: string)
	local rc = r.Racers[player]
	if not rc or rc.Status ~= "Racing" then
		return
	end
	rc.Status = "DNF"
	rc.Reason = reason
	setState(player, nil)
	player:SetAttribute("RaceActive", nil)
	Net.signal(player, "RaceEnd", { Reason = reason })
end

local function releaseRacer(player: Player)
	player:SetAttribute("RaceActive", nil)
	player:SetAttribute("RacePass", nil)
	player:SetAttribute("RaceStart", nil)
	player:SetAttribute("RaceState", nil)
	local mount = Services.MountService
	if mount and mount.Freeze then
		mount.Freeze(player, false)
	end
end

-- ============================================================== race flow
local function newRace()
	return {
		State = "Lobby",
		Players = {},
		Racers = {},
		Order = {},
		Started = 0,
		LobbyEnds = clock() + RaceConfig.LobbySeconds,
	}
end

local function closeRace()
	if not race then
		return
	end
	for _, p in race.Players do
		releaseRacer(p)
	end
	race = nil
	if #waiting > 0 then
		race = newRace()
		for _, p in waiting do
			if p.Parent == Players then
				table.insert(race.Players, p)
				setState(p, "Lobby")
			end
		end
		table.clear(waiting)
		if #race.Players == 0 then
			race = nil
		else
			lobbySignal()
		end
	end
end

local function ready(player: Player): boolean
	return player.Parent == Players and Data.Get(player) ~= nil and onIsland(positionOf(player))
end

local function padCFrame(slot: number, hip: number): CFrame
	local world = RaceConfig.toWorld(RaceConfig.Pads[slot])
	local pos = Vector3.new(world.X, world.Y + 2 + hip, world.Z)
	return CFrame.lookAt(pos, pos + Vector3.new(0, 0, -1))
end

local function beginCountdown()
	local r = race
	if not r or r.State ~= "Lobby" then
		return
	end
	local mount = Services.MountService
	local list = {}
	for _, p in r.Players do
		if ready(p) then
			table.insert(list, p)
		else
			Net.notify(p, "warning", "You left the island - the race started without you.")
			releaseRacer(p)
		end
	end
	r.Players = {}
	local slot = 0
	for _, p in list do
		if slot >= RaceConfig.MaxRacers then
			break
		end
		-- onto a dragon (the strongest comes down from its perch when nobody is out)
		local ok = mount.Mount(p)
		local comp = ok and mount.Get(p)
		if ok and comp and comp.Riding then
			slot += 1
			table.insert(r.Players, p)
			local hip = comp.Model:GetAttribute("HipHeight") or 5
			mount.MoveTo(p, padCFrame(slot, hip))
			mount.Freeze(p, true)
			p:SetAttribute("RaceActive", true)
			p:SetAttribute("RacePass", 0)
			p:SetAttribute("RaceStart", nil)
			setState(p, "Countdown")
			r.Racers[p] = { Slot = slot, Pass = 0, Status = "Waiting", Over = 0 }
		else
			Net.notify(p, "warning", "You need a dragon to race - hatch an egg first!")
			releaseRacer(p)
		end
	end
	r.Started = #r.Players
	if r.Started == 0 then
		race = nil
		return
	end
	r.State = "Countdown"
	r.CountEnds = clock() + RaceConfig.CountdownSeconds
	r.Counted = RaceConfig.CountdownSeconds + 1
	lobbySignal()
end

local function go()
	local r = race
	if not r then
		return
	end
	r.State = "Running"
	r.StartClock = clock()
	r.StartTime = Workspace:GetServerTimeNow()
	local mount = Services.MountService
	for _, p in r.Players do
		local rc = r.Racers[p]
		mount.Freeze(p, false)
		rc.Status = "Racing"
		rc.Pass = 1
		rc.LastPos = positionOf(p)
		rc.LastT = clock()
		p:SetAttribute("RacePass", 1)
		p:SetAttribute("RaceStart", r.StartTime)
		setState(p, "Running")
		Net.signal(p, "RaceGo", { Start = r.StartTime })
	end
end

-- One 0.1 s step of a racing player: validate movement, check the next gate.
local function sample(r, player: Player, rc, now: number)
	local position = positionOf(player)
	local mount = Services.MountService
	local comp = mount.Get(player)
	if not position or not comp or not comp.Riding then
		return dnf(r, player, "You left your dragon.")
	end
	if (position - RaceConfig.Island.Center).Magnitude > RaceConfig.CourseLeave then
		return dnf(r, player, "You left the course.")
	end
	local dt = math.max(now - rc.LastT, 1e-3)
	local last = rc.LastPos or position
	-- speed over a short window (replication makes single samples noisy); teleports and hacked
	-- speed stay over the limit for several samples in a row
	local history = rc.History
	if not history then
		history = {}
		rc.History = history
	end
	table.insert(history, { T = now, P = position })
	while #history > 1 and now - history[1].T > RaceConfig.SpeedWindow do
		table.remove(history, 1)
	end
	local span = now - history[1].T
	if span >= 0.3 then
		local windowed = (position - history[1].P).Magnitude / span
		if windowed > RaceConfig.MaxSpeed then
			rc.Over = (rc.Over or 0) + 1
			if rc.Over >= RaceConfig.MaxOverSamples then
				return dnf(r, player, "Disqualified: moving too fast.")
			end
		else
			rc.Over = math.max(0, (rc.Over or 0) - 1)
		end
	end
	-- a ring only counts for honest movement: a jump through it never does
	local honest = (position - last).Magnitude <= math.max(40, RaceConfig.MaxSpeed * dt * 1.15)
	local total = RaceConfig.totalPasses()
	local gate = RaceConfig.gateForPass(rc.Pass)
	local f = (function()
		-- segment vs the gate's disc (forward crossings only)
		local c = RaceConfig.toWorld(gate.Position)
		local n = gate.Direction
		local s0 = (last - c):Dot(n)
		local s1 = (position - c):Dot(n)
		if honest and s0 <= 0 and s1 > 0 then
			local frac = (0 - s0) / (s1 - s0)
			local hit = last:Lerp(position, frac)
			if (hit - c).Magnitude <= RaceConfig.GateRadius + RaceConfig.GateSlack then
				return frac
			end
		end
		return nil
	end)()
	if f then
		local crossed = rc.LastT + f * dt
		rc.PassTimes = rc.PassTimes or {}
		rc.PassTimes[rc.Pass] = crossed - r.StartClock
		if rc.Pass >= total then
			finishRacer(r, player, rc, math.floor((crossed - r.StartClock) * 1000 + 0.5))
		else
			rc.Pass += 1
			player:SetAttribute("RacePass", rc.Pass)
			Net.signal(player, "RaceProgress", {
				Pass = rc.Pass,
				Total = total,
				Lap = RaceConfig.lapOfPass(rc.Pass),
				Ms = math.floor((crossed - r.StartClock) * 1000),
			})
		end
	end
	rc.LastPos = position
	rc.LastT = now
end

local function endRace()
	local r = race
	if not r then
		return
	end
	r.State = "Done"
	r.DoneAt = clock()
	local list = results(r)
	for _, p in r.Players do
		Net.signal(p, "RaceEnd", { Results = list, Racers = r.Started })
		setState(p, nil)
		p:SetAttribute("RaceActive", nil)
		p:SetAttribute("RacePass", nil)
		p:SetAttribute("RaceStart", nil)
	end
	-- a short pause, then the lobby opens for the people who were waiting
	task.delay(4, function()
		if race == r then
			closeRace()
		end
	end)
end

-- Race order for the HUD ("2ND of 4"): finished racers by place, the others by gates passed and
-- the distance left to the next one.
local function sendPositions(r)
	local score: { [Player]: number } = {}
	local order = {}
	for _, p in r.Players do
		local rc = r.Racers[p]
		if rc and (rc.Status == "Racing" or rc.Status == "Finished") then
			if rc.Status == "Finished" then
				score[p] = 1e9 - rc.Place
			else
				local position = positionOf(p)
				local gate = RaceConfig.gateForPass(rc.Pass)
				local left = position and (position - RaceConfig.toWorld(gate.Position)).Magnitude or 1e4
				score[p] = rc.Pass * 1e4 - math.min(left, 9999)
			end
			table.insert(order, p)
		end
	end
	table.sort(order, function(a, b)
		return score[a] > score[b]
	end)
	for i, p in order do
		if r.Racers[p].Status == "Racing" then
			Net.signal(p, "RacePos", { Place = i, Of = #order })
		end
	end
end

local function step()
	local r = race
	if not r then
		return
	end
	local now = clock()
	if r.State == "Lobby" then
		for i = #r.Players, 1, -1 do
			local p = r.Players[i]
			if p.Parent ~= Players then
				table.remove(r.Players, i)
			end
		end
		if #r.Players == 0 then
			race = nil
			return
		end
		r.Tick = (r.Tick or 0) + 1
		if r.Tick % 5 == 0 then
			lobbySignal() -- the countdown label refreshes twice a second
		end
		if now >= r.LobbyEnds then
			beginCountdown()
		end
	elseif r.State == "Countdown" then
		local left = r.CountEnds - now
		local n = math.ceil(left)
		if n < r.Counted and n >= 1 then
			r.Counted = n
			for _, p in r.Players do
				Net.signal(p, "RaceCount", { N = n })
			end
		end
		if left <= 0 then
			go()
		end
	elseif r.State == "Running" then
		local racing = 0
		for _, p in table.clone(r.Players) do
			local rc = r.Racers[p]
			if rc and rc.Status == "Racing" then
				if p.Parent ~= Players then
					rc.Status = "DNF"
					rc.Reason = "Left the game."
				else
					sample(r, p, rc, now)
				end
				if rc.Status == "Racing" then
					racing += 1
				end
			end
		end
		r.PosTick = (r.PosTick or 0) + 1
		if r.PosTick % 5 == 0 and r.Started > 1 then
			sendPositions(r)
		end
		local timeout = now - r.StartClock > RaceConfig.MaxRaceSeconds
		local grace = r.FirstFinish and (now - r.FirstFinish > RaceConfig.FinishGraceSeconds)
		if racing == 0 or timeout or grace then
			for _, p in r.Players do
				local rc = r.Racers[p]
				if rc and rc.Status == "Racing" then
					dnf(r, p, timeout and "Time is up." or "Too slow.")
				end
			end
			endRace()
		end
	end
end

-- A boost ring was flown through (the client starts the dash at once): the movement check is
-- relaxed for the length of the dash, but only when the racer really is at that ring.
local function onBoost(player: Player, p)
	local rc = racerOf(player)
	if not rc or rc.Status ~= "Racing" or not Net.check.int(p.Index, 1, #RaceConfig.Boosts) then
		return
	end
	local ring = RaceConfig.Boosts[p.Index]
	local position = positionOf(player)
	if not position or (position - RaceConfig.toWorld(ring.Position)).Magnitude > RaceConfig.Boost.Radius * 3 + 60 then
		return
	end
	local mount = Services.MountService
	local comp = mount and mount.Get(player)
	if comp then
		comp.DashUntil = os.clock() + RaceConfig.Boost.Duration + 0.8
	end
end

-- ============================================================== requests
local function snapshot(player: Player)
	local data = Data.Get(player)
	local mine = racerOf(player)
	local list = {}
	if race then
		for _, p in race.Players do
			table.insert(list, { Name = p.DisplayName, UserId = p.UserId })
		end
	end
	local key = RaceConfig.monthKey()
	local rd = data and data.Race
	return {
		State = race and race.State or "Idle",
		Racers = list,
		Left = (race and race.State == "Lobby") and math.max(0, race.LobbyEnds - clock()) or 0,
		Joined = (race and table.find(race.Players, player) ~= nil) or table.find(waiting, player) ~= nil,
		Queued = table.find(waiting, player) ~= nil,
		Running = race ~= nil and (race.State == "Running" or race.State == "Countdown"),
		Mine = mine and { Slot = mine.Slot, Pass = mine.Pass } or nil,
		Best = rd and rd.Best or 0,
		MonthBest = (rd and rd.MonthKey == key) and rd.MonthBest or 0,
		Runs = rd and rd.Runs or 0,
		Wins = rd and rd.Wins or 0,
		Month = key,
		MonthLeft = RaceConfig.secondsLeftInMonth(),
		Prize = RaceConfig.Monthly.PrizeText,
		Headline = RaceConfig.Monthly.Headline,
		OnIsland = onIsland(positionOf(player)),
		Winners = winners,
		Laps = RaceConfig.Laps,
		Gates = RaceConfig.GateCount,
		Max = RaceConfig.MaxRacers,
	}
end

local function handleJoin(player: Player)
	if not Data.Get(player) then
		return false, "NOT_LOADED"
	end
	if not onIsland(positionOf(player)) then
		return false, "NOT_ON_ISLAND", "Fly to Race Island first (Teleport menu)."
	end
	if player:GetAttribute("InArena") then
		return false, "IN_ARENA", "Leave the arena before you race."
	end
	local mine = racerOf(player)
	if mine and (mine.Status == "Racing" or mine.Status == "Waiting") and race.State ~= "Done" then
		return true, snapshot(player)
	end
	if race and table.find(waiting, player) then
		return true, snapshot(player)
	end
	if not race or race.State == "Done" then
		race = newRace()
	end
	if race.State == "Lobby" then
		if #race.Players >= RaceConfig.MaxRacers then
			return false, "FULL", "The lobby is full - wait for the next race."
		end
		if not table.find(race.Players, player) then
			table.insert(race.Players, player)
		end
		setState(player, "Lobby")
		if #race.Players >= RaceConfig.MaxRacers then
			race.LobbyEnds = math.min(race.LobbyEnds, clock() + RaceConfig.FullLobbySeconds)
		end
		lobbySignal()
		return true, snapshot(player)
	end
	-- a race is under way: you open the next lobby
	table.insert(waiting, player)
	return true, snapshot(player)
end

local function handleLeave(player: Player)
	removeFrom(waiting, player)
	if race then
		if race.State == "Lobby" then
			removeFrom(race.Players, player)
			releaseRacer(player)
			if #race.Players == 0 then
				race = nil
			else
				lobbySignal()
			end
		elseif race.Racers[player] and race.Racers[player].Status == "Racing" then
			dnf(race, player, "You left the race.")
		end
	end
	return true, snapshot(player)
end

local function handleStartNow(player: Player)
	if not race or race.State ~= "Lobby" or not table.find(race.Players, player) then
		return false, "NOT_IN_LOBBY"
	end
	if #race.Players ~= 1 then
		return false, "NOT_ALONE", "Other racers are waiting - the race starts when the lobby timer ends."
	end
	race.LobbyEnds = math.min(race.LobbyEnds, clock() + RaceConfig.SoloStartSeconds)
	lobbySignal()
	return true, snapshot(player)
end

local function handleTop(player: Player, p)
	if not Net.check.str(p.Board, 24) then
		return false, "BAD_REQUEST"
	end
	local lb = Services.LeaderboardService
	if not lb or not lb.TopNamed then
		return false, "NO_BOARD"
	end
	return true, { List = lb.TopNamed(p.Board) }
end

-- ============================================================== monthly champions
local function loadWinners()
	if not winnersStore then
		local ok, store = pcall(function()
			return DataStoreService:GetDataStore("RaceWinners_v1")
		end)
		winnersStore = ok and store or nil
	end
	if winnersStore then
		local ok, value = pcall(function()
			return (winnersStore :: DataStore):GetAsync("history")
		end)
		if ok and type(value) == "table" then
			winners = value
		end
	end
end

local function saveWinners(entry)
	for _, w in winners do
		if w.Month == entry.Month then
			return false
		end
	end
	-- another server may have crowned the same month a moment ago: the stored history decides
	local added = true
	if winnersStore then
		local ok = pcall(function()
			(winnersStore :: DataStore):UpdateAsync("history", function(old)
				local list = type(old) == "table" and old or {}
				for _, w in list do
					if w.Month == entry.Month then
						added = false
						return nil
					end
				end
				table.insert(list, 1, entry)
				while #list > 24 do
					table.remove(list)
				end
				return list
			end)
		end)
		if ok and not added then
			loadWinners() -- take over the other server's record, no second announcement
			return false
		end
	end
	table.insert(winners, 1, entry)
	while #winners > 24 do
		table.remove(winners)
	end
	return true
end

local function showWinners()
	if island then
		local ok, RaceIsland = pcall(function()
			return require(ServerScriptService:WaitForChild("World"):WaitForChild("RaceIsland"))
		end)
		if ok then
			RaceIsland.setWinners(island, winners)
		end
	end
end

local MONTHS = { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" }

-- The champion of `monthKey` is rewarded once, as soon as they are in a server.
local function crown(player: Player, entry)
	local data = Data.Get(player)
	if not data or (data.Race.Crowns or {})[entry.Month] then
		return
	end
	Data.Set(player, { "Race", "Crowns", entry.Month }, true)
	Data.Set(player, { "Flags", "RaceChampion" }, entry.Month)
	player:SetAttribute("RaceChampion", entry.Month)
	local given = reward(player, RaceConfig.Monthly.Winner, "RACE CHAMPION")
	Net.notify(player, "rare", string.format("You are the RACE CHAMPION of %s!  +$%d", MONTHS[tonumber(string.sub(entry.Month, 5, 6)) or 1] or entry.Month, given.Cash))
end

local function announce(entry)
	local month = MONTHS[tonumber(string.sub(entry.Month, 5, 6)) or 1] or entry.Month
	Net.broadcast("RareHatch", {
		Player = entry.Name,
		UserId = entry.UserId,
		Species = "",
		Mutation = "None",
		Rarity = "Exclusive",
		Odds = 0,
		Mega = true,
		Text = string.format("%s is the RACE CHAMPION of %s!", entry.Name, month),
		Sub = string.format("%s  -  %s", RaceConfig.formatTime(entry.Ms), RaceConfig.Monthly.PrizeText),
	})
end

local function rollover()
	local lb = Services.LeaderboardService
	if not lb or not lb.TopOfStore then
		return
	end
	local prev = RaceConfig.previousMonthKey()
	for _, w in winners do
		if w.Month == prev then
			return
		end
	end
	local top = lb.TopOfStore("LB_RaceMonthly_" .. prev .. "_v1", 1)
	local first = top and top[1]
	if not first or first.Value <= 0 then
		return
	end
	local entry = {
		Month = prev,
		UserId = first.UserId,
		Name = lb.NameOf(first.UserId),
		Ms = RaceConfig.scoreTime(first.Value),
	}
	if saveWinners(entry) then
		warn(string.format("[Race] MONTHLY WINNER %s: %s (id %d) in %s - %s", entry.Month, entry.Name, entry.UserId, RaceConfig.formatTime(entry.Ms), RaceConfig.Monthly.PrizeText))
		announce(entry)
		showWinners()
		local online = Players:GetPlayerByUserId(entry.UserId)
		if online then
			crown(online, entry)
		end
	end
end

-- ============================================================== lifecycle
function RaceService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.handle("Race", "Join", handleJoin, { Burst = 4, PerSecond = 1.5 })
	Net.handle("Race", "Leave", handleLeave, { Burst = 4, PerSecond = 1.5 })
	Net.handle("Race", "StartNow", handleStartNow, { Burst = 3, PerSecond = 1 })
	Net.handle("Race", "State", function(player)
		return true, snapshot(player)
	end, { Burst = 6, PerSecond = 2 })
	Net.handle("Race", "Top", handleTop, { Burst = 4, PerSecond = 1.5 })
	Net.onEvent("RaceBoost", onBoost, { Burst = 6, PerSecond = 2 })
end

-- The race the player is in (nil when none): used by other services (travel, arena).
function RaceService.Active(player: Player): boolean
	local rc = racerOf(player)
	return rc ~= nil and (rc.Status == "Racing" or rc.Status == "Waiting")
end

function RaceService.Winners()
	return winners
end

function RaceService.Island(): Model?
	return island
end

-- Studio only (UI Lab, via DevService): crowns the player as last month's champion without any
-- DataStore round trip - banner, podium, trophy flag and reward, as on the first of a month.
function RaceService.DevCrown(player: Player)
	local data = Data.Get(player)
	if not data then
		return
	end
	local ms = tonumber(data.Race.Best) or 0
	local entry = {
		Month = RaceConfig.previousMonthKey(),
		UserId = player.UserId,
		Name = player.DisplayName,
		Ms = ms > 0 and ms or 41234,
	}
	for i = #winners, 1, -1 do
		if winners[i].Month == entry.Month then
			table.remove(winners, i)
		end
	end
	table.insert(winners, 1, entry)
	Data.Set(player, { "Race", "Crowns", entry.Month }, nil)
	announce(entry)
	showWinners()
	crown(player, entry)
end

-- tests / dev: current race table, the monthly check, the lobby / waiting lists
function RaceService._race()
	return race
end
function RaceService._rollover()
	rollover()
end
function RaceService._waiting()
	return waiting
end

function RaceService.Start()
	while not (Services.WorldService and Services.WorldService.Ready) do
		task.wait(0.25)
	end
	local worldFolder = Workspace:FindFirstChild("World") or Workspace
	local okBuild, built = pcall(function()
		local RaceIsland = require(ServerScriptService:WaitForChild("World"):WaitForChild("RaceIsland"))
		return RaceIsland.build(worldFolder)
	end)
	if okBuild then
		island = built
	else
		warn("[Race] island build failed: " .. tostring(built))
	end
	task.spawn(function()
		loadWinners()
		showWinners()
		while true do
			local ok, err = pcall(rollover)
			if not ok then
				warn("[Race] rollover: " .. tostring(err))
			end
			task.wait(RaceConfig.Monthly.CheckSeconds)
		end
	end)
	-- the champion of last month is crowned when they join
	Data.Loaded:Connect(function(player)
		-- the crown stays on for the month after the win
		local data = Data.Get(player)
		local mark = data and data.Flags and data.Flags.RaceChampion
		if mark == RaceConfig.previousMonthKey() or mark == RaceConfig.monthKey() then
			player:SetAttribute("RaceChampion", mark)
		end
		for _, w in winners do
			if w.UserId == player.UserId and w.Month == RaceConfig.previousMonthKey() then
				crown(player, w)
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		removeFrom(waiting, player)
		if race and race.Racers[player] and race.Racers[player].Status == "Racing" then
			race.Racers[player].Status = "DNF"
			race.Racers[player].Reason = "Left the game."
		end
	end)
	task.spawn(function()
		while true do
			task.wait(RaceConfig.SampleSeconds)
			local ok, err = pcall(step)
			if not ok then
				warn("[Race] step: " .. tostring(err))
			end
		end
	end)
end

return RaceService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000090">
				<Properties>
					<string name="Name">RankService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	RankService
	Five ranks (RankConfig): VIP, MOD, ADMIN, CO-OWNER, OWNER. A rank is a title: a coloured tag over the
	character, a coloured [TITLE] in chat (ChatController) and the player attributes RankLevel /
	RankTitle that every client can read.

	The owner hands ranks out with chat commands (parsed here, forwarded by AdminModule):
	  /rank <player|me|UserId> <rank|none>     rank = vip / mod / admin / coowner / owner / 1-5 / none
	  /ranks                                    the ranks and who has one in this server
	  /rankhelp
	Who may: the real owner (AdminModule.IsOwner: AdminConfig, the creator, anybody inside Studio) can
	set any rank, also for players who are not in the server (they get it when they join); a CO-OWNER can
	hand out ranks up to ADMIN to players below CO-OWNER; everybody else is refused.

	Stored in the player data (Rank). A grant for a player who is not here waits in the DataStore
	"RankGrants_v1" until they join.

	API: RankService.Level(player) -> 0..5, RankService.Set(player, level, by?) -> ok,
	     RankService.Execute(sender, text) -> boolean (true = it was a rank command)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local RankConfig = require(Configs:WaitForChild("RankConfig"))
local AdminModule = require(script.Parent.Parent:WaitForChild("AdminModule"))

local RankService = {}

local Data
local grants: any = nil

local function notify(player: Player?, kind: string, text: string)
	if player and player.Parent == Players then
		pcall(Net.notify, player, kind, text)
	end
end

-- ============================================================== level / visuals
function RankService.Level(player: Player): number
	local data = Data and Data.Get(player)
	local n = data and tonumber(data.Rank) or 0
	return math.clamp(math.floor(n or 0), 0, RankConfig.MaxLevel)
end

-- 5 for the real owner, otherwise the rank of the player
local function authority(player: Player): number
	if AdminModule.IsOwner(player) then
		return RankConfig.MaxLevel
	end
	return RankService.Level(player)
end

local function label(parent: Instance, name: string, text: string, color: Color3, position: UDim2, size: UDim2, font: Enum.Font)
	local t = Instance.new("TextLabel")
	t.Name = name
	t.BackgroundTransparency = 1
	t.Position = position
	t.Size = size
	t.Font = font
	t.Text = text
	t.TextScaled = true
	t.TextColor3 = color
	t.Parent = parent
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(18, 20, 34)
	stroke.Parent = t
	return t
end

-- The tag above the character: TITLE in the rank colour, the epithet under it.
local function buildTag(player: Player, character: Model?)
	if not character then
		return
	end
	local old = character:FindFirstChild("RankTag", true)
	if old then
		old:Destroy()
	end
	local def = RankConfig.ByLevel[RankService.Level(player)]
	if not def then
		return
	end
	local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "RankTag"
	gui.Adornee = head :: any
	gui.Size = UDim2.fromOffset(260, 56)
	gui.StudsOffset = Vector3.new(0, 3.4, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 150
	gui.LightInfluence = 0
	local star = def.Level >= 4 and "★ " or ""
	local starEnd = def.Level >= 4 and " ★" or ""
	label(gui, "Title", star .. def.Title .. starEnd, def.Color, UDim2.fromScale(0, 0), UDim2.fromScale(1, 0.62), Enum.Font.GothamBlack)
	label(gui, "Epithet", def.Epithet, Color3.fromRGB(235, 238, 250), UDim2.fromScale(0.1, 0.62), UDim2.fromScale(0.8, 0.36), Enum.Font.GothamMedium)
	gui.Parent = head
end

local function applyVisuals(player: Player)
	local lvl = RankService.Level(player)
	local def = RankConfig.ByLevel[lvl]
	player:SetAttribute("RankLevel", lvl)
	player:SetAttribute("RankTitle", def and def.Title or "")
	buildTag(player, player.Character)
end

-- ============================================================== setting a rank
function RankService.Set(player: Player, level: number, by: string?): boolean
	if not Data or not Data.Get(player) then
		return false
	end
	level = math.clamp(math.floor(tonumber(level) or 0), 0, RankConfig.MaxLevel)
	Data.Set(player, { "Rank" }, level)
	applyVisuals(player)
	if Data.SaveNow then
		Data.SaveNow(player)
	end
	local def = RankConfig.ByLevel[level]
	print(string.format("[Rank] %s is now %s%s", player.Name, def and def.Title or "no rank", by and (" (by " .. by .. ")") or ""))
	return true
end

-- A grant waiting for a player who was not in the server.
local function storeGrant(userId: number, level: number): (boolean, string?)
	if not grants then
		return false, "The rank store is not available."
	end
	local ok, err = pcall(function()
		grants:SetAsync(tostring(userId), level)
	end)
	if not ok then
		return false, tostring(err)
	end
	return true, nil
end

local function claimGrant(player: Player)
	if not grants then
		return
	end
	local ok, level = pcall(function()
		return grants:GetAsync(tostring(player.UserId))
	end)
	if ok and type(level) == "number" and level >= 0 and level <= RankConfig.MaxLevel then
		pcall(function()
			grants:RemoveAsync(tostring(player.UserId))
		end)
		if player.Parent == Players and Data.Get(player) then
			RankService.Set(player, level, "pending grant")
			local def = RankConfig.ByLevel[level]
			if def then
				notify(player, "rare", string.format("You are now %s - %s!", def.Title, def.Epithet))
			end
		end
	end
end

-- ============================================================== commands
local function helpText(): string
	local parts = {}
	for _, r in RankConfig.Ranks do
		table.insert(parts, string.format("%d %s", r.Level, r.Title))
	end
	return "RANKS:  " .. table.concat(parts, "  |  ") .. "   -   /rank <player|me> <rank|none>   /ranks"
end

local function listText(): string
	local people = {}
	for _, p in Players:GetPlayers() do
		local def = RankConfig.ByLevel[RankService.Level(p)]
		if def then
			table.insert(people, string.format("%s [%s]", p.Name, def.Title))
		end
	end
	return helpText() .. "   -   Here: " .. (#people > 0 and table.concat(people, ", ") or "nobody has a rank yet")
end

function RankService.Execute(sender: Player, raw: string): boolean
	if type(raw) ~= "string" then
		return false
	end
	local text = raw:match("^%s*(.-)%s*$") or raw
	local lower = string.lower(text)
	if lower == "/ranks" or lower == ";ranks" then
		notify(sender, "info", listText())
		return true
	end
	if lower == "/rankhelp" or lower == ";rankhelp" or lower == "/rank" or lower == ";rank" then
		notify(sender, "info", helpText())
		return true
	end
	local targetText, rankText = text:match("^[/;][Rr][Aa][Nn][Kk]%s+(%S+)%s+(.+)$")
	if not targetText then
		return false
	end

	local mine = authority(sender)
	if mine < RankConfig.CommandLevel then
		notify(sender, "error", "You are not allowed to use /rank.")
		return true
	end
	local def, isNone = RankConfig.parse(rankText)
	if not def and not isNone then
		notify(sender, "error", "Unknown rank '" .. rankText .. "'.  " .. helpText())
		return true
	end
	local newLevel = def and def.Level or 0
	-- a CO-OWNER hands out ranks below their own
	if mine < RankConfig.MaxLevel and newLevel >= mine then
		notify(sender, "error", "You can only give ranks below your own.")
		return true
	end

	local target, err = AdminModule.FindPlayer(sender, targetText)
	if target then
		if mine < RankConfig.MaxLevel and authority(target) >= mine and target ~= sender then
			notify(sender, "error", "You cannot change the rank of somebody who ranks as high as you.")
			return true
		end
		if not RankService.Set(target, newLevel, sender.Name) then
			notify(sender, "error", "That player's data is not loaded yet.")
			return true
		end
		local title = def and string.format("%s - %s", def.Title, def.Epithet) or "no rank"
		notify(sender, "success", string.format("RANK: %s is now %s.", target == sender and "you" or target.Name, title))
		if def then
			if target ~= sender then
				notify(target, "rare", string.format("You are now %s - %s!", def.Title, def.Epithet))
			end
			pcall(Net.notifyAll, "info", string.format("RANK UP: %s is now %s!", target.DisplayName, def.Title))
		elseif target ~= sender then
			notify(target, "info", "Your rank was removed.")
		end
		return true
	end

	-- not in this server: only the real owner can leave a grant for the next visit
	if not (err and string.find(err, "not in this server", 1, true)) then
		notify(sender, "error", err or "Player not found.")
		return true
	end
	if mine < RankConfig.MaxLevel then
		notify(sender, "error", err)
		return true
	end
	local userId = tonumber(targetText)
	if not userId then
		local ok, id = pcall(function()
			return Players:GetUserIdFromNameAsync(targetText)
		end)
		userId = ok and id or nil
	end
	if not userId then
		notify(sender, "error", "There is no Roblox player called '" .. targetText .. "'.")
		return true
	end
	local ok, storeErr = storeGrant(userId, newLevel)
	if ok then
		notify(sender, "success", string.format("RANK: %s gets %s the next time they join.", targetText, def and def.Title or "no rank"))
	else
		notify(sender, "error", "Could not save the rank: " .. tostring(storeErr))
	end
	return true
end

-- ============================================================== lifecycle
function RankService.Init(services)
	Data = services.PlayerDataService
end

function RankService.Start()
	local okStore, store = pcall(function()
		return DataStoreService:GetDataStore("RankGrants_v1")
	end)
	grants = okStore and store or nil

	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			task.defer(buildTag, player, character)
		end)
		if player.Character then
			task.defer(buildTag, player, player.Character)
		end
	end
	Data.Loaded:Connect(function(player)
		applyVisuals(player)
		task.spawn(claimGrant, player)
	end)
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
		if Data.Get(player) then
			applyVisuals(player)
		end
	end
end

return RankService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000091">
				<Properties>
					<string name="Name">SanctuaryService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	SanctuaryService
	Assigns each player one of the personal sanctuary plots (first free plot),
	shows their name and colour on the gate, and frees it when they leave.
	Plot models live in Workspace.World.Sanctuaries (built by WorldService).

	Perches: the owner's placed dragons are replicated to every client through
	ReplicatedStorage.SanctuaryState.Plot<i> (a Configuration, so it never
	streams out) and everyone sees each other's resting dragons (clients build
	the visuals locally - see PerchController):
	  OwnerUserId, OwnerName, PerchesUnlocked = n
	  Perch<i> = "SpeciesId|Mutation|Level|Name"   ("" = empty perch)
	Unlocked perch crystals glow (server-side, visible to all).

	API: GetPlot(player) -> Model?, GetPlotId(player) -> number?
	Replicated state: SanctuaryState (above), plot model attributes
	OwnerUserId / OwnerName, player attribute "PlotId".
]]

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")

local WorldConfig = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("WorldConfig"))
local Odds = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Odds"))

local SanctuaryService = {}

local Sanctuaries -- World/Sanctuaries module (visual helpers)
local Data
local Services
local owners: { [number]: Player } = {} -- plotId -> player
local byPlayer: { [Player]: number } = {}
local stateFolder: Folder

local COLORS = {
	Color3.fromRGB(150, 36, 46),
	Color3.fromRGB(38, 70, 150),
	Color3.fromRGB(40, 120, 70),
	Color3.fromRGB(170, 110, 30),
	Color3.fromRGB(110, 50, 150),
	Color3.fromRGB(30, 130, 140),
	Color3.fromRGB(150, 60, 110),
	Color3.fromRGB(90, 90, 100),
}

local function plotsFolder(): Instance?
	local world = Workspace:FindFirstChild("World")
	return world and world:FindFirstChild("Sanctuaries")
end

local function plotModel(id: number): Model?
	local f = plotsFolder()
	return f and f:FindFirstChild("Plot" .. id) :: Model?
end

local function plotState(id: number): Configuration
	return stateFolder:FindFirstChild("Plot" .. id) :: Configuration
end

-- Encodes a placed dragon for the perch attribute.
local function encode(record): string
	return string.format("%s|%s|%d|%d|%s", record.SpeciesId, record.Mutation or "None", record.Level or 1, Odds.ofRecord(record), record.Name or "")
end

local function setGems(model: Model, unlocked: number)
	if not Sanctuaries then
		return
	end
	for i = 1, WorldConfig.Sanctuary.PerchCount do
		Sanctuaries.setPerchGem(model, i, i <= unlocked)
	end
end

-- Publishes the owner's perch state (SanctuaryState.Plot<id>) and lights the unlocked perch crystals.
local function syncPerches(player: Player)
	local id = byPlayer[player]
	local data = Data and Data.Get(player)
	if not id or not data then
		return
	end
	local state = plotState(id)
	local unlocked = math.min(data.Nests.Unlocked or 0, WorldConfig.Sanctuary.PerchCount)
	if state:GetAttribute("PerchesUnlocked") ~= unlocked then
		state:SetAttribute("PerchesUnlocked", unlocked)
		local model = plotModel(id)
		if model then
			setGems(model, unlocked)
		end
	end
	for i = 1, WorldConfig.Sanctuary.PerchCount do
		local uid = data.Nests.Slots[tostring(i)]
		local record = uid and data.Dragons[uid]
		local value = record and encode(record) or ""
		if state:GetAttribute("Perch" .. i) ~= value then
			state:SetAttribute("Perch" .. i, value)
		end
	end
end
SanctuaryService.SyncPerches = syncPerches

local function clearState(id: number)
	local state = plotState(id)
	state:SetAttribute("OwnerUserId", 0)
	state:SetAttribute("OwnerName", "")
	state:SetAttribute("PerchesUnlocked", 0)
	for i = 1, WorldConfig.Sanctuary.PerchCount do
		state:SetAttribute("Perch" .. i, "")
	end
	local model = plotModel(id)
	if model then
		setGems(model, 0)
	end
end

-- Where a player appears: on their terrace between the gate and the nest,
-- facing the nest and the resting dragons.
function SanctuaryService.SpawnCFrame(id: number): CFrame?
	local f = WorldConfig.plotFrame(id)
	return f and f * CFrame.new(0, 3.4, -27) * CFrame.Angles(0, math.pi, 0) or nil
end

local function placeCharacter(player: Player, character: Model)
	local id = byPlayer[player]
	if not id then
		return
	end
	local hrp = character:WaitForChild("HumanoidRootPart", 10)
	if not hrp or player.Character ~= character then
		return
	end
	local cf = SanctuaryService.SpawnCFrame(id) :: CFrame
	pcall(function()
		player:RequestStreamAroundAsync(cf.Position, 5)
	end)
	if player.Character ~= character or not character.Parent then
		return
	end
	character:PivotTo(cf)
	-- bring the companion dragon along
	local mount = Services and Services.MountService
	if mount and mount.Spawn then
		mount.Spawn(player)
	end
end
SanctuaryService.PlaceCharacter = placeCharacter

local function assign(player: Player)
	if byPlayer[player] then
		return
	end
	-- wait for the world
	local t = 0
	while not plotsFolder() and t < 60 do
		t += task.wait(0.25)
	end
	if player.Parent ~= Players then
		return
	end
	for id = 1, WorldConfig.MaxPlots do
		if not owners[id] and plotModel(id) then
			owners[id] = player
			byPlayer[player] = id
			local model = plotModel(id) :: Model
			model:SetAttribute("OwnerUserId", player.UserId)
			model:SetAttribute("OwnerName", player.DisplayName)
			if Sanctuaries then
				Sanctuaries.setOwner(model, player.DisplayName, COLORS[id])
			end
			local state = plotState(id)
			state:SetAttribute("OwnerUserId", player.UserId)
			state:SetAttribute("OwnerName", player.DisplayName)
			player:SetAttribute("PlotId", id)
			syncPerches(player)
			-- spawn (and respawn) at the sanctuary
			player.CharacterAdded:Connect(function(character)
				task.spawn(placeCharacter, player, character)
			end)
			if player.Character then
				task.spawn(placeCharacter, player, player.Character)
			end
			return
		end
	end
	warn("[Sanctuary] no free plot for " .. player.Name)
end

local function release(player: Player)
	local id = byPlayer[player]
	if not id then
		return
	end
	byPlayer[player] = nil
	owners[id] = nil
	clearState(id)
	local model = plotModel(id)
	if model then
		model:SetAttribute("OwnerUserId", 0)
		model:SetAttribute("OwnerName", nil)
		if Sanctuaries then
			Sanctuaries.setOwner(model, nil, nil)
		end
	end
end

function SanctuaryService.GetPlotId(player: Player): number?
	return byPlayer[player]
end

function SanctuaryService.GetPlot(player: Player): Model?
	local id = byPlayer[player]
	return id and plotModel(id) or nil
end

function SanctuaryService.Init(services)
	Services = services
	Data = services.PlayerDataService
	local world = ServerScriptService:FindFirstChild("World")
	local mod = world and world:FindFirstChild("Sanctuaries")
	if mod then
		Sanctuaries = require(mod)
	end
	-- streaming-proof replicated perch state (one Configuration per plot)
	stateFolder = Instance.new("Folder")
	stateFolder.Name = "SanctuaryState"
	for id = 1, WorldConfig.MaxPlots do
		local c = Instance.new("Configuration")
		c.Name = "Plot" .. id
		c:SetAttribute("PlotId", id)
		c.Parent = stateFolder
	end
	stateFolder.Parent = ReplicatedStorage
	for id = 1, WorldConfig.MaxPlots do
		clearState(id)
	end
end

function SanctuaryService.Start()
	for _, p in Players:GetPlayers() do
		task.spawn(assign, p)
	end
	Players.PlayerAdded:Connect(function(p)
		task.spawn(assign, p)
	end)
	Players.PlayerRemoving:Connect(release)
	local dragons = Services.DragonService
	if dragons then
		dragons.PlacedChanged:Connect(syncPerches)
	end
	Data.Loaded:Connect(function(player)
		syncPerches(player)
	end)
end

return SanctuaryService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000092">
				<Properties>
					<string name="Name">SettingsService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	SettingsService
	Validates and saves player settings. Every key has an explicit schema;
	unknown keys or out-of-range values are rejected.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local SettingsService = {}
local Data

local SCHEMA = {
	Graphics = function(v)
		return v == "Max" or v == "High" or v == "Medium"
	end,
	Music = function(v)
		return Net.check.num(v, 0, 1)
	end,
	SFX = function(v)
		return Net.check.num(v, 0, 1)
	end,
	Sensitivity = function(v)
		return Net.check.num(v, 0.3, 2.5)
	end,
	CameraShake = Net.check.bool,
	SpeedFOV = Net.check.bool,
	MouseLock = Net.check.bool,
	InvertY = Net.check.bool,
	MenuBlur = Net.check.bool,
	UIScale = function(v)
		return Net.check.num(v, 0.8, 1.25)
	end,
}

function SettingsService.Init(services)
	Data = services.PlayerDataService
	Net.handle("Settings", "Set", function(player, payload)
		local key, value = payload.Key, payload.Value
		local validate = type(key) == "string" and SCHEMA[key]
		if not validate or not validate(value) then
			return false, "INVALID_SETTING"
		end
		if not Data.Get(player) then
			return false, "NOT_LOADED"
		end
		Data.Set(player, { "Settings", key }, value)
		return true
	end, { Burst = 20, PerSecond = 8 })
end

return SettingsService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000093">
				<Properties>
					<string name="Name">ShopService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	ShopService
	Cash upgrades (Forge / Shop "Upgrades" tab): Egg Storage, Dragon Storage,
	Hatch Luck, Egg Radar. Prices come only from EconomyConfig.

	Net (domain "Shop"): BuyUpgrade { Id } -> { Id, Level }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local EconomyConfig = require(Configs:WaitForChild("EconomyConfig"))

local ShopService = {}

local Services
local Data

local function buyUpgrade(player: Player, p)
	if not Net.check.str(p.Id, 32) then
		return false, "BAD_REQUEST"
	end
	local def = EconomyConfig.Upgrades[p.Id]
	local data = Data.Get(player)
	if not def or not data then
		return false, "BAD_UPGRADE"
	end
	local level = tonumber(data.Upgrades[p.Id]) or 0
	local nextEntry = def.Levels[level + 2]
	if not nextEntry then
		return false, "MAXED", def.Name .. " is fully upgraded."
	end
	if not Services.EconomyService.Spend(player, nextEntry.Price, "Upgrade") then
		return false, "NO_CASH", "Not enough cash."
	end
	Data.Set(player, { "Upgrades", p.Id }, level + 1)
	return true, { Id = p.Id, Level = level + 1 }
end

function ShopService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.handle("Shop", "BuyUpgrade", buyUpgrade, { Burst = 6, PerSecond = 3 })
end

return ShopService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000094">
				<Properties>
					<string name="Name">SpinService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	SpinService
	Spin Island: builds the floating toy island (stand, podium + prompt,
	trees, clouds; the wheel rotor itself is built by each client) and runs
	the server-authoritative spins.

	data.Spin = { NextFree = os.time when the free spin is ready, Tickets = n }

	Net (domain "Spin"): Roll {} -> { Index, Prize = { Kind, Label, Amount?, Egg?, Count? }, Free, Tickets, NextFree }
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Format = require(Shared:WaitForChild("Util"):WaitForChild("Format"))
local SpinConfig = require(Configs:WaitForChild("SpinConfig"))
local EggConfig = require(Configs:WaitForChild("EggConfig"))
local MonetizationConfig = require(Configs:WaitForChild("MonetizationConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local SpinService = {}

local Services
local Data
local rng = Random.new()

local V3 = Vector3.new
local CF = CFrame.new

local function now(): number
	return os.time()
end

-- ============================================================== island (world)
local GRASS = Color3.fromRGB(75, 151, 74)
local DIRT = Color3.fromRGB(124, 80, 46)
local ROCK = Color3.fromRGB(163, 162, 165)
local ROCK_DARK = Color3.fromRGB(99, 95, 98)
local RED = Color3.fromRGB(196, 40, 27)
local YELLOW = Color3.fromRGB(245, 205, 47)
local WHITE = Color3.fromRGB(242, 243, 242)
local BLUE = Color3.fromRGB(13, 105, 172)

local function buildIsland()
	local Kit = require(ServerScriptService:WaitForChild("World"):WaitForChild("Kit"))
	local world = Workspace:FindFirstChild("World") or Workspace
	local center = SpinConfig.Island.Center
	local r = SpinConfig.Island.Radius
	local b = Kit.new(world, CF(center), "SpinIsland")
	pcall(function()
		(b.Model :: any).ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end)
	-- floating base: grass plate, dirt layer, stacked rock cone underneath
	b:cyl(3, r * 2, V3(0, -1.5, 0), GRASS)
	b:cyl(3, r * 2 - 2, V3(0, -4.5, 0), DIRT)
	local y = -6
	for i, d in { r * 1.7, r * 1.35, r * 1.0, r * 0.68, r * 0.38, r * 0.16 } do
		local h = 6 + i
		b:cyl(h, d, V3(0, y - h / 2, 0), i % 2 == 0 and ROCK_DARK or ROCK)
		y -= h
	end
	-- toy studs around the rim
	for i = 0, 23 do
		local a = i / 24 * math.pi * 2
		b:cyl(0.6, 2.2, V3(math.sin(a) * (r - 2.5), 0.3, math.cos(a) * (r - 2.5)), GRASS)
	end
	-- wheel stand (the rotor is built by the clients at SpinConfig.Wheel)
	local wheel = SpinConfig.Wheel
	local wr = SpinConfig.WheelRadius
	local stand = Kit.new(b.Model, wheel, "WheelStand")
	-- (stand-local frame = rotor frame: -Z faces the players, ground at y = -groundDrop)
	local groundDrop = wheel.Position.Y - center.Y
	local top = wr + 2.6
	local postH = top + groundDrop
	for _, sx in { -1, 1 } do
		stand:box(V3(2.4, postH, 2.4), V3(sx * (wr + 2.4), (top - groundDrop) / 2, 1.6), RED)
		stand:box(V3(4, 1.6, 6), V3(sx * (wr + 2.4), -groundDrop + 0.8, 1.6), YELLOW)
	end
	stand:box(V3(wr * 2 + 7.2, 2.4, 2.4), V3(0, top, 1.6), RED)
	-- axle behind the rotor + a strut up to the crossbar
	stand:box(V3(2, 2, 3.4), V3(0, 0, 1.9), ROCK_DARK)
	stand:box(V3(2.4, top, 2.4), V3(0, top / 2, 3.2), RED)
	-- pointer: two mirrored wedges forming a downward triangle in front of the rim
	local ph, pd = 3, 1.5
	local py = wr + 0.3 + ph / 2
	stand:wedge(V3(0.8, ph, pd), CFrame.fromMatrix(V3(-pd / 2, py, -1.7), V3(0, 0, 1), V3(0, -1, 0), V3(1, 0, 0)), YELLOW).Name = "Pointer"
	stand:wedge(V3(0.8, ph, pd), CFrame.fromMatrix(V3(pd / 2, py, -1.7), V3(0, 0, -1), V3(0, -1, 0), V3(-1, 0, 0)), YELLOW).Name = "Pointer"
	-- sign above
	local sign = stand:box(V3(18, 4, 1), V3(0, top + 3.4, 1.6), BLUE)
	sign.Name = "Sign"
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = sign
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.GothamBlack
	t.Text = "SPIN TO WIN EGGS!"
	t.TextScaled = true
	t.TextColor3 = YELLOW
	t.Parent = gui
	local st = Instance.new("UIStroke")
	st.Thickness = 3
	st.Color = Color3.fromRGB(20, 24, 40)
	st.Parent = t
	-- podium with the prompt, between the arrival point and the wheel
	local podiumPos = wheel.Position + wheel.LookVector * 16
	local podium = Kit.new(b.Model, CF(V3(podiumPos.X, center.Y, podiumPos.Z)), "Podium")
	podium:cyl(1.2, 10, V3(0, 0.6, 0), YELLOW)
	podium:cyl(0.6, 8, V3(0, 1.5, 0), RED)
	local pad = podium:cyl(0.4, 6, V3(0, 2, 0), WHITE, Enum.Material.Neon)
	pad.Name = "SpinPad"
	podium:prompt(pad, "Spin the Wheel", "Spin Island", { Window = "Spin" })
	-- brick trees, flowers and a couple of lamp posts
	for i, p in { V3(-24, 0, -6), V3(25, 0, -10), V3(-20, 0, 18), V3(22, 0, 16), V3(-8, 0, -26), V3(10, 0, -27) } do
		local h = 5 + (i % 3)
		b:box(V3(1.6, h, 1.6), V3(p.X, h / 2, p.Z), DIRT)
		b:box(V3(6, 4, 6), V3(p.X, h + 1.6, p.Z), Color3.fromRGB(39, 112, 62))
		b:box(V3(4, 3, 4), V3(p.X, h + 5, p.Z), GRASS)
	end
	for i = 0, 15 do
		local a = i / 16 * math.pi * 2 + 0.2
		local rr = r - 6 - (i % 3) * 3
		local col = ({ RED, YELLOW, WHITE, Color3.fromRGB(228, 160, 200) })[i % 4 + 1]
		b:cyl(0.4, 1.4, V3(math.sin(a) * rr, 0.2, math.cos(a) * rr), col)
	end
	-- clouds hugging the underside
	for i, p in { V3(-30, -14, 8), V3(28, -18, -6), V3(4, -24, 30), V3(-12, -20, -30) } do
		local cl = Kit.new(b.Model, CF(center + p), "Cloud" .. i)
		cl:box(V3(14, 4, 8), V3(0, 0, 0), WHITE, nil, { CanCollide = false, CastShadow = false })
		cl:box(V3(8, 4, 6), V3(-3, 2.5, 0), WHITE, nil, { CanCollide = false, CastShadow = false })
		cl:box(V3(6, 3, 6), V3(4, 2, 1), WHITE, nil, { CanCollide = false, CastShadow = false })
	end
	return b.Model
end

-- ============================================================== spins
local function spinState(data)
	local s = data.Spin
	if type(s) ~= "table" then
		s = { NextFree = 0, Tickets = SpinConfig.StartTickets }
	end
	return s
end

local function nearWheel(player: Player): boolean
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return false
	end
	local dragons = Workspace:FindFirstChild("Dragons")
	local model = dragons and dragons:FindFirstChild("Dragon_" .. player.UserId)
	local positions = { (hrp :: BasePart).Position }
	if model and model.PrimaryPart then
		table.insert(positions, model.PrimaryPart.Position)
	end
	for _, p in positions do
		if (p - SpinConfig.Wheel.Position).Magnitude <= SpinConfig.MaxDistance then
			return true
		end
	end
	return false
end

local function pick(luck: number): number
	local odds = SpinConfig.odds(luck)
	local r = rng:NextNumber()
	for i, p in odds do
		r -= p
		if r <= 0 then
			return i
		end
	end
	return #odds
end

local function giveEggs(player: Player, eggType: string, count: number): number
	local data = Data.Get(player)
	if not data then
		return 0
	end
	local cap = TreeConfig.eggCapacity(data)
	local list = table.clone(data.Eggs)
	local given = 0
	for _ = 1, count do
		if #list >= cap + 20 then
			break
		end
		table.insert(list, { Id = Data.NextId(player, "EggSerial", "E"), Type = eggType, Found = now(), Luck = EggConfig.rollLuck(eggType, rng, true) })
		given += 1
	end
	Data.Set(player, { "Eggs" }, list)
	return given
end

local function grantPrize(player: Player, seg): { [string]: any }
	local prize = { Kind = seg.Kind, Label = seg.Label }
	if seg.Kind == "Cash" then
		local rate = Services.EconomyService.IncomeRate(player)
		local amount = math.max(seg.Min or 0, math.floor(rate * 60 * (seg.Minutes or 1)))
		Services.EconomyService.Earn(player, amount, "Spin")
		prize.Amount = amount
		prize.Label = Format.cash(amount)
	elseif seg.Kind == "Egg" then
		local given = giveEggs(player, seg.Egg, seg.Count or 1)
		prize.Egg = seg.Egg
		prize.Count = given
		if given < (seg.Count or 1) then
			-- bag overflowing: pay the egg out in cash instead
			local amount = 5000 * (EggConfig.Eggs[seg.Egg] and EggConfig.Eggs[seg.Egg].Tier or 1)
			Services.EconomyService.Earn(player, amount, "Spin")
			prize.Amount = amount
		end
	elseif seg.Kind == "Spin" then
		Data.Increment(player, { "Spin", "Tickets" }, seg.Count or 1)
		prize.Count = seg.Count or 1
	elseif seg.Kind == "Boost" then
		Services.BoostService.Add(player, seg.Boost, seg.Seconds or 600)
		prize.Boost = seg.Boost
		prize.Seconds = seg.Seconds
	end
	return prize
end

local function roll(player: Player)
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	if not nearWheel(player) then
		return false, "TOO_FAR", "Go to Spin Island to spin the wheel."
	end
	local s = spinState(data)
	if data.Spin ~= s then
		Data.Set(player, { "Spin" }, s)
	end
	local free = now() >= (tonumber(s.NextFree) or 0)
	if free then
		-- Great Tree "Quick Spin": the free spin comes back sooner
		local wait = SpinConfig.FreeSpinSeconds * (1 - math.clamp(TreeConfig.bonus(data, "SpinSpeed"), 0, 0.9))
		Data.Set(player, { "Spin", "NextFree" }, now() + math.floor(wait))
	elseif (tonumber(s.Tickets) or 0) > 0 then
		Data.Increment(player, { "Spin", "Tickets" }, -1)
	else
		return false, "NO_SPINS", "No spins left. Your free spin is coming soon!"
	end
	local luck = Services.BoostService and Services.BoostService.LuckMultiplier(player) or 1
	luck *= 1 + TreeConfig.bonus(data, "SpinLuck") -- Great Tree "Lucky Wheel"
	local index = pick(luck)
	local prize = grantPrize(player, SpinConfig.Segments[index])
	Data.Increment(player, { "Stats", "Spins" }, 1)
	local after = Data.Get(player).Spin
	return true, { Index = index, Prize = prize, Free = free, Tickets = after.Tickets, NextFree = after.NextFree }
end

-- Robux spin packs (MonetizationService calls this for Kind = "Spins").
function SpinService.AddTickets(player: Player, count: number)
	local data = Data.Get(player)
	if not data then
		return
	end
	if type(data.Spin) ~= "table" then
		Data.Set(player, { "Spin" }, { NextFree = 0, Tickets = SpinConfig.StartTickets })
	end
	Data.Increment(player, { "Spin", "Tickets" }, count)
end

function SpinService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.handle("Spin", "Roll", roll, { Burst = 2, PerSecond = 0.5 })
	local _ = MonetizationConfig
end

function SpinService.Start()
	while not (Services.WorldService and Services.WorldService.Ready) do
		task.wait(0.25)
	end
	local ok, err = pcall(buildIsland)
	if not ok then
		warn("[Spin] island build failed: " .. tostring(err))
	end
end

return SpinService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000095">
				<Properties>
					<string name="Name">StatueService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	StatueService
	The statue in the middle of the plaza is the OWNER: it stands on the plinth of the fountain instead of
	the stone dragon. It is built from the owner's real Roblox avatar (WorldConfig.PlazaStatue.Username /
	UserId): Players:GetHumanoidDescriptionFromUserId + CreateHumanoidModelFromDescription, scaled up,
	posed (right fist raised, standing tall), anchored. If the avatar cannot be loaded (no web access, the
	name is wrong) a marble-and-gold "Dragon King" built from parts stands there instead. A plaque on the
	plinth and a floating title ("OWNER - Dragon King", the rank colours of RankConfig) say whose it is.

	Change who it is in WorldConfig > PlazaStatue ({ Username, UserId?, Scale }).

	API: StatueService.Ready (bool), StatueService.Kind ("Avatar" | "Fallback")
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerScriptService = game:GetService("ServerScriptService")
local Workspace = game:GetService("Workspace")

local Configs = ReplicatedStorage:WaitForChild("Configs")
local WorldConfig = require(Configs:WaitForChild("WorldConfig"))
local RankConfig = require(Configs:WaitForChild("RankConfig"))

local StatueService = {}
StatueService.Ready = false
StatueService.Kind = ""

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles

-- ============================================================== the avatar
local function ownerUserId(def): number?
	if def.UserId and def.UserId > 0 then
		return def.UserId
	end
	local ok, id = pcall(function()
		return Players:GetUserIdFromNameAsync(def.Username)
	end)
	return ok and tonumber(id) or nil
end

local function loadAvatar(userId: number): Model?
	local ok, model = pcall(function()
		local description = Players:GetHumanoidDescriptionFromUserId(userId)
		return Players:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)
	if ok and typeof(model) == "Instance" and model:IsA("Model") then
		return model
	end
	return nil
end

-- Swings a whole limb about its joint so that it points along `direction` (given in the model's own
-- frame: x right, y up, -z forward). It works from where the limb IS, so it does not matter how the rig
-- rests (T-pose or arms down). Only the joint's C0 changes: the engine moves the limb with everything
-- that hangs on it (forearm, hand, gloves, accessories) because they are joined to it.
local function aim(model: Model, jointName: string, tipName: string, direction: Vector3, frame: CFrame)
	local joint = nil
	for _, d in model:GetDescendants() do
		if d.Name == jointName and d:IsA("Motor6D") then
			joint = d
			break
		end
	end
	local tip = model:FindFirstChild(tipName, true)
	if not joint or not joint.Part0 or not joint.Part1 or not tip then
		return
	end
	local part0 = joint.Part0.CFrame
	local pivot = (part0 * joint.C0).Position
	local current = tip.Position - pivot
	local target = frame:VectorToWorldSpace(direction)
	if current.Magnitude < 0.05 or target.Magnitude < 0.05 then
		return
	end
	local axis = current.Unit:Cross(target.Unit)
	if axis.Magnitude < 1e-4 then
		return
	end
	local angle = math.acos(math.clamp(current.Unit:Dot(target.Unit), -1, 1))
	local swing = CF(pivot) * CFrame.fromAxisAngle(axis.Unit, angle) * CF(-pivot)
	-- Part1 = Part0 * C0 * C1^-1 must become swing * (the old Part1)
	joint.C0 = part0:Inverse() * swing * part0 * joint.C0
end

-- Right fist raised, left arm by the side, feet a little apart.
local function pose(model: Model, frame: CFrame)
	aim(model, "RightShoulder", "RightHand", V(0.22, 0.95, -0.2), frame)
	aim(model, "LeftShoulder", "LeftHand", V(-0.16, -1, -0.04), frame)
	aim(model, "RightHip", "RightFoot", V(0.12, -1, 0), frame)
	aim(model, "LeftHip", "LeftFoot", V(-0.12, -1, 0), frame)
end

-- Takes out the scripts and the humanoid; only the root stays anchored (the limbs hang on it through their
-- joints, so the pose holds and nothing falls); nothing collides.
local function freeze(model: Model)
	local root = model:FindFirstChild("HumanoidRootPart")
	for _, d in model:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") then
			d:Destroy()
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			d.Anchored = (d == root)
			d.CanCollide = false
			d.CanTouch = false
			d.CastShadow = true
		end
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid:Destroy()
	end
end

-- After the engine has moved the posed limbs: put the lowest foot exactly on the plate.
local function settle(model: Model, feetY: number)
	task.wait(0.3)
	local lowest = math.huge
	for _, name in { "LeftFoot", "RightFoot" } do
		local foot = model:FindFirstChild(name, true)
		if foot and foot:IsA("BasePart") then
			lowest = math.min(lowest, foot.Position.Y - foot.Size.Y / 2)
		end
	end
	if lowest < math.huge then
		model:PivotTo(model:GetPivot() + V(0, feetY - lowest, 0))
	end
end

-- ============================================================== the fallback king (marble and gold)
local function fallbackKing(parent: Instance, base: CFrame, scale: number): Model
	local Kit = require(ServerScriptService:WaitForChild("World"):WaitForChild("Kit"))
	local b = Kit.new(parent, base, "OwnerStatue")
	local s = scale
	local marble = Color3.fromRGB(226, 220, 206)
	local gold = Color3.fromRGB(236, 190, 70)
	local cape = Color3.fromRGB(170, 40, 50)
	local M = Kit.M
	local props = { CanCollide = false, CanTouch = false }
	for _, sx in { -1, 1 } do
		b:box(V(1.05 * s, 2.2 * s, 1.1 * s), V(sx * 0.62 * s, 1.1 * s, 0), marble, M.Marble, props)
		b:box(V(1.15 * s, 0.4 * s, 1.8 * s), V(sx * 0.62 * s, 0.2 * s, -0.3 * s), marble, M.Marble, props)
	end
	b:box(V(2.5 * s, 2.3 * s, 1.3 * s), V(0, 3.35 * s, 0), marble, M.Marble, props)
	b:box(V(2.6 * s, 0.35 * s, 1.4 * s), V(0, 2.3 * s, 0), gold, M.Foil, props)
	b:box(V(2.7 * s, 2.7 * s, 0.35 * s), V(0, 3.2 * s, 0.85 * s), cape, M.Fabric, props)
	-- left arm by the side, right arm raised
	b:box(V(0.85 * s, 2.3 * s, 0.9 * s), CF(-1.75 * s, 3.3 * s, 0) * ANG(0, 0, 0.1), marble, M.Marble, props)
	b:box(V(0.85 * s, 2.5 * s, 0.9 * s), CF(1.95 * s, 4.7 * s, -0.2 * s) * ANG(0.2, 0, -0.32), marble, M.Marble, props)
	b:ball(1.1 * s, V(2.5 * s, 6.1 * s, -0.5 * s), marble, M.Marble, props)
	-- head and crown
	b:ball(1.5 * s, V(0, 5.15 * s, 0), marble, M.Marble, props)
	b:cyl(0.45 * s, 1.55 * s, V(0, 5.95 * s, 0), gold, M.Foil, props)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		b:box(V(0.22 * s, 0.6 * s, 0.22 * s), V(math.cos(a) * 0.6 * s, 6.35 * s, math.sin(a) * 0.6 * s), gold, M.Foil, props)
	end
	return b.Model
end

-- ============================================================== plaque + floating title
local function plaque(statueModel: Model, base: Vector3, facing: Vector3, def)
	local rank = RankConfig.ByLevel[RankConfig.MaxLevel]
	-- the plinth is a square block: put the plaque on the face that looks at the spawn
	local out = math.abs(facing.X) > math.abs(facing.Z) and V(facing.X > 0 and 1 or -1, 0, 0) or V(0, 0, facing.Z > 0 and 1 or -1)
	local at = base + V(0, 9.5, 0) + out * 5.62
	local part = Instance.new("Part")
	part.Name = "OwnerPlaque"
	part.Anchored = true
	part.CanCollide = false
	part.Size = V(8.6, 3, 0.4)
	part.Color = Color3.fromRGB(46, 40, 34)
	part.Material = Enum.Material.Slate
	part.CFrame = CFrame.lookAt(at, at + out)
	part.Parent = statueModel
	local gui = Instance.new("SurfaceGui")
	gui.Name = "PlaqueGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 0
	gui.Parent = part
	local function line(name: string, text: string, color: Color3, y: number, h: number)
		local t = Instance.new("TextLabel")
		t.Name = name
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromScale(0.04, y)
		t.Size = UDim2.fromScale(0.92, h)
		t.Font = Enum.Font.GothamBlack
		t.Text = text
		t.TextScaled = true
		t.TextColor3 = color
		t.Parent = gui
	end
	line("Owner", string.upper(def.Username), Color3.fromRGB(255, 226, 150), 0.06, 0.52)
	line("Rank", string.format("%s  -  %s", rank.Title, string.upper(rank.Epithet)), rank.Color, 0.6, 0.32)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 150)
	light.Range = 22
	light.Brightness = 1.4
	light.Parent = part
end

local function titleSign(statueModel: Model, top: Vector3, height: number, def)
	local rank = RankConfig.ByLevel[RankConfig.MaxLevel]
	local anchor = Instance.new("Part")
	anchor.Name = "TitleAnchor"
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = V(1, 1, 1)
	anchor.Position = top + V(0, height + 4, 0)
	anchor.Parent = statueModel
	local gui = Instance.new("BillboardGui")
	gui.Name = "TitleGui"
	gui.Size = UDim2.fromOffset(300, 76)
	gui.MaxDistance = 260
	gui.LightInfluence = 0
	gui.Adornee = anchor
	gui.Parent = anchor
	local function line(name: string, text: string, color: Color3, y: number, h: number, font: Enum.Font)
		local t = Instance.new("TextLabel")
		t.Name = name
		t.BackgroundTransparency = 1
		t.Position = UDim2.fromScale(0, y)
		t.Size = UDim2.fromScale(1, h)
		t.Font = font
		t.Text = text
		t.TextScaled = true
		t.TextColor3 = color
		t.Parent = gui
		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 2.5
		stroke.Color = Color3.fromRGB(18, 20, 34)
		stroke.Parent = t
	end
	line("Title", "★ " .. rank.Title .. " ★", rank.Color, 0, 0.6, Enum.Font.GothamBlack)
	line("Epithet", rank.Epithet .. "  -  " .. def.Username, Color3.fromRGB(235, 238, 250), 0.62, 0.36, Enum.Font.GothamMedium)
end

-- ============================================================== build
local function build()
	local def = WorldConfig.PlazaStatue
	local hub = Workspace:WaitForChild("World", 180):WaitForChild("Hub", 180)
	local plinth = hub and hub:WaitForChild("DragonStatue", 180)
	if not plinth then
		warn("[Statue] no plaza statue to replace")
		return
	end
	local base = V(0, WorldConfig.Hub.Height, 0)
	local top = base + V(0, 14, 0) -- the gold plate of the plinth
	local spawn = WorldConfig.Spawn.Position
	local facing = V(spawn.X - base.X, 0, spawn.Z - base.Z)
	if facing.Magnitude < 1 then
		facing = V(0, 0, 1)
	end
	local frame = CFrame.lookAt(top, top + facing)
	local height = 5.4 * def.Scale

	local avatar = nil
	local userId = ownerUserId(def)
	if userId then
		avatar = loadAvatar(userId)
	end
	local model: Model
	if avatar then
		model = avatar
		model.Name = "OwnerStatue"
		pcall(function()
			model:ScaleTo(def.Scale)
		end)
		model:PivotTo(frame * CF(0, 6 * def.Scale, 0))
		local okPose, err = pcall(pose, model, frame)
		if not okPose then
			warn("[Statue] pose failed: " .. tostring(err))
		end
		freeze(model)
		model.Parent = plinth
		StatueService.Kind = "Avatar"
		pcall(settle, model, top.Y)
	else
		model = fallbackKing(plinth, frame, def.Scale * 0.9)
		StatueService.Kind = "Fallback"
		height = 6.6 * def.Scale * 0.9
	end
	-- the stone dragon makes room for the owner
	local dragon = plinth:FindFirstChild("StatueDragon")
	if dragon then
		dragon:Destroy()
	end
	plaque(plinth, base, facing, def)
	titleSign(plinth, top, height, def)
	model:SetAttribute("Owner", def.Username)
	StatueService.Ready = true
end

-- (exposed for the tests: the posing runs on a rig built by hand)
StatueService._test = { pose = pose, freeze = freeze, settle = settle }

function StatueService.Init(_services) end

function StatueService.Start()
	task.spawn(function()
		local ok, err = pcall(build)
		if not ok then
			warn("[Statue] failed: " .. tostring(err))
		end
	end)
end

return StatueService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000096">
				<Properties>
					<string name="Name">TravelService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	TravelService
	Fast travel (HUD "Teleport" menu): the player's sanctuary and every hub
	station. Server-validated destinations only (clients send a name), with a
	short cooldown. Riding players travel with their dragon (the physics root
	moves, the rider stays seated); on foot, the companion is brought along.

	Net (domain "Travel"): To { Place } -> { Place }
	Places: Sanctuary, Spawn (leaderboards), SpinIsland, RaceIsland, the sky islands (WorldConfig.SkyIslands),
	        Shop, Forge, Quests, Library
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local WorldConfig = require(Configs:WaitForChild("WorldConfig"))
local SpinConfig = require(Configs:WaitForChild("SpinConfig"))
local RaceConfig = require(Configs:WaitForChild("RaceConfig"))

local TravelService = {}

local Services
local COOLDOWN = 2.5
local lastTravel: { [Player]: number } = {}

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundY(pos: Vector3, fallback: number): number
	local dragons = Workspace:FindFirstChild("Dragons")
	rayParams.FilterDescendantsInstances = dragons and { dragons } or {}
	local hit = Workspace:Raycast(pos + Vector3.new(0, 60, 0), Vector3.new(0, -160, 0), rayParams)
	return hit and hit.Position.Y or fallback
end

-- Where a destination puts the player (standing, facing the place).
function TravelService.Destination(player: Player, place: string): CFrame?
	if place == "SpinIsland" then
		return SpinConfig.arrival()
	end
	if place == "RaceIsland" then
		local at = RaceConfig.toWorld(RaceConfig.Arrival)
		return CFrame.lookAt(at, at + Vector3.new(0, 0, -10))
	end
	local isle = WorldConfig.SkyIslandById[place]
	if isle then
		return WorldConfig.islandArrival(isle)
	end
	if place == "Spawn" then
		local lb = Services.LeaderboardService
		return lb and lb.ArrivalCFrame() or nil
	end
	if place == "Sanctuary" then
		local sanctuary = Services.SanctuaryService
		local id = sanctuary and sanctuary.GetPlotId(player)
		return id and sanctuary.SpawnCFrame(id) or nil
	end
	local station = WorldConfig.Stations[place]
	if not station then
		return nil
	end
	local base = CFrame.new(station.Position) * CFrame.Angles(0, station.Facing, 0)
	local front = (base * CFrame.new(0, 0, -((station.Radius or 20) + 6))).Position
	local y = groundY(front, station.Position.Y) + 3.4
	local stand = Vector3.new(front.X, y, front.Z)
	return CFrame.lookAt(stand, Vector3.new(station.Position.X, y, station.Position.Z))
end

local function travel(player: Player, p)
	if not Net.check.str(p.Place, 20) then
		return false, "BAD_REQUEST"
	end
	if player:GetAttribute("RaceActive") then
		return false, "RACING", "You can't travel during a race."
	end
	local now = os.clock()
	if now - (lastTravel[player] or -100) < COOLDOWN then
		return false, "COOLDOWN", "Wait a moment before traveling again."
	end
	local cf = TravelService.Destination(player, p.Place)
	if not cf then
		return false, "BAD_PLACE"
	end
	local character = player.Character
	local hrp = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid or humanoid.Health <= 0 then
		return false, "NO_CHARACTER"
	end
	lastTravel[player] = now
	pcall(function()
		player:RequestStreamAroundAsync(cf.Position, 5)
	end)
	local mount = Services.MountService
	if mount and mount.IsRiding(player) and mount.MoveTo then
		-- arrive hovering above the spot, still mounted
		mount.MoveTo(player, cf + Vector3.new(0, 14, 0))
	else
		character:PivotTo(cf)
		if mount and mount.Spawn then
			mount.Spawn(player)
		end
	end
	return true, { Place = p.Place }
end

function TravelService.Init(services)
	Services = services
	Net.handle("Travel", "To", travel, { Burst = 3, PerSecond = 1 })
end

function TravelService.Start()
	Players.PlayerRemoving:Connect(function(player)
		lastTravel[player] = nil
	end)
end

return TravelService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000097">
				<Properties>
					<string name="Name">TreeService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	TreeService
	The Great Tree: permanent upgrades bought with cash (TreeConfig).
	Five branches (RollLuck, MutationLuck, Income, FlySpeed, HatchSpeed), five
	levels each, bought strictly in order. Server authority: the price, the
	level order and every bonus come from TreeConfig - the client only asks to
	buy "the next level" of a branch.

	data.Tree = { [branchId] = level }  (replicated to the client)

	API:
	  TreeService.Bonus(player, id) -> total bonus of that branch (0 if not bought)
	Net (domain "Tree"):
	  Buy { Id } -> { Id, Level, Bonus }
	Clients read data.Tree (replicated) through TreeConfig.bonus; the server applies
	the bonuses where they matter (see the TreeConfig header).
	Signal: Bought(player, id, level)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local TreeService = {}
TreeService.Bought = Signal.new() -- (player, branchId, level)

local Data
local Services

function TreeService.Bonus(player: Player, id: string): number
	return TreeConfig.bonus(Data.Get(player), id)
end

function TreeService.Level(player: Player, id: string): number
	return TreeConfig.level(Data.Get(player), id)
end

-- Re-reads everything derived from the tree (luck attribute, companion stats).
function TreeService.Refresh(player: Player)
	local boosts = Services.BoostService
	if boosts then
		boosts.Refresh(player)
	end
	local mount = Services.MountService
	if mount and mount.RefreshStats then
		mount.RefreshStats(player)
	end
end

-- Eggs already warming up get faster the moment Warm Nest is upgraded.
local function speedUpIncubator(player: Player, oldBonus: number, newBonus: number)
	local data = Data.Get(player)
	if not data or newBonus <= oldBonus then
		return
	end
	local t = os.time()
	local ratio = (1 - newBonus) / (1 - oldBonus)
	for key, slot in data.Incubator.Slots do
		local ready = tonumber(slot.Ready) or 0
		if ready > t then
			local newReady = t + math.max(1, math.floor((ready - t) * ratio + 0.5))
			Data.Set(player, { "Incubator", "Slots", key, "Ready" }, newReady)
		end
	end
end

local function handleBuy(player: Player, p)
	if not Net.check.str(p.Id, 24) then
		return false, "BAD_REQUEST"
	end
	local branch = TreeConfig.ById[p.Id]
	local data = Data.Get(player)
	if not branch or not data then
		return false, "BAD_BRANCH"
	end
	local level = TreeConfig.level(data, p.Id)
	local entry = branch.Levels[level + 1]
	if not entry then
		return false, "MAXED", branch.Name .. " is fully grown."
	end
	local oldBonus = TreeConfig.bonus(data, p.Id)
	if not Services.EconomyService.Spend(player, entry.Price, "Tree") then
		return false, "NO_CASH", "Not enough cash."
	end
	Data.Set(player, { "Tree", p.Id }, level + 1)
	if p.Id == "HatchSpeed" then
		speedUpIncubator(player, oldBonus, entry.Bonus)
	end
	TreeService.Refresh(player)
	TreeService.Bought:Fire(player, p.Id, level + 1)
	return true, { Id = p.Id, Level = level + 1, Bonus = entry.Bonus }
end

function TreeService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.handle("Tree", "Buy", handleBuy, { Burst = 6, PerSecond = 3 })
end

function TreeService.Start()
	Data.Loaded:Connect(function(player)
		TreeService.Refresh(player)
	end)
	for _, player in Players:GetPlayers() do
		if Data.Get(player) then
			TreeService.Refresh(player)
		end
	end
end

return TreeService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000098">
				<Properties>
					<string name="Name">WildEggService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	WildEggService
	Lucky Wild Eggs (WildEggConfig): every few minutes one special egg appears at a
	random egg area for the WHOLE server. A pillar of light marks it from afar. The first
	player (or ridden dragon) to reach it takes it - into their hand, with its big luck.
	After WildEggConfig.Lifetime seconds an unclaimed egg vanishes.

	Server authority: spawn time/place/tier/luck, pickup range, bag capacity and "first
	come first served" are all decided here.

	Net (domain "WildEgg"):   Claim {}  -> { Id, Type, Luck, Held, Name }
	                          Sync {}   -> { Current = info | nil }
	Net signals (to everyone): "WildEggSpawn" { Id, Tier, Name, Egg, Luck, Position, Region,
	                           Area, EndsAt, Color }, "WildEggClaimed" { Id, Player, Name, Luck },
	                           "WildEggGone" { Id }
	Signals: Spawned(info), Claimed(player, info), Expired(info)
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local Net = require(Shared:WaitForChild("Net"))
local Signal = require(Shared:WaitForChild("Util"):WaitForChild("Signal"))
local EggVisual = require(Shared:WaitForChild("EggVisual"))
local EggReach = require(Shared:WaitForChild("EggReach"))
local WildEggConfig = require(Configs:WaitForChild("WildEggConfig"))

local WildEggService = {}
WildEggService.Spawned = Signal.new() -- (info)
WildEggService.Claimed = Signal.new() -- (player, info)
WildEggService.Expired = Signal.new() -- (info)

local Services
local Data
local rng = Random.new()
local serial = 0
local current: any = nil -- { Id, Tier, Egg, Luck, Position, Area, Region, EndsAt, Model, Claimed }
local lastPosition: Vector3? = nil -- where the previous wild egg was (the next one keeps away from it)

local function payloadOf(egg)
	return {
		Id = egg.Id,
		Tier = egg.Tier.Id,
		Name = egg.Tier.Name,
		Egg = egg.Egg,
		Luck = egg.Luck,
		Position = egg.Position,
		Region = egg.Region,
		Area = egg.Area,
		EndsAt = egg.EndsAt,
		Color = egg.Tier.Color,
	}
end

function WildEggService.Current()
	return current
end

-- ============================================================== the egg in the world
local function buildModel(egg)
	local model = EggVisual.build(egg.Egg, { Beam = true, Scale = 2.4 })
	model.Name = "WildEgg"
	model:SetAttribute("Tier", egg.Tier.Id)
	model:SetAttribute("Luck", egg.Luck)
	model:SetAttribute("EndsAt", egg.EndsAt)
	-- a tall, wide pillar in the tier colour: visible from the far end of the map
	local shell = model.PrimaryPart
	local pillar = shell and shell:FindFirstChild("Pillar")
	if pillar and pillar:IsA("Beam") then
		pillar.Color = ColorSequence.new(egg.Tier.Color)
		pillar.Width0 = 7
		pillar.Width1 = 1.5
		pillar.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.3),
			NumberSequenceKeypoint.new(0.4, 0.55),
			NumberSequenceKeypoint.new(1, 1),
		})
		local top = shell:FindFirstChild("BeamTop")
		if top and top:IsA("Attachment") then
			top.Position = Vector3.new(0, 320, 0)
		end
	end
	EggVisual.place(model, CFrame.new(egg.Position))
	-- (stays streamed in for everybody, so the pillar is visible from anywhere)
	local anyModel: any = model
	anyModel.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	CollectionService:AddTag(model, "WildEgg")
	local world = Workspace:FindFirstChild("World")
	model.Parent = world or Workspace
	return model
end

local function remove(egg, reason: string)
	if current ~= egg then
		return
	end
	current = nil
	if egg.Model then
		egg.Model:Destroy()
	end
	if reason == "expired" then
		Net.broadcast("WildEggGone", { Id = egg.Id })
		WildEggService.Expired:Fire(egg)
	end
end

-- Spawns a wild egg now (optionally of a given tier). Returns the info table or nil.
function WildEggService.Spawn(tierId: string?)
	if current then
		return nil
	end
	local eggService = Services.EggService
	local areas = eggService and eggService.Areas()
	if not areas or #areas == 0 then
		return nil
	end
	-- a completely random place of the land (not one of the fixed areas), away from the last wild egg
	local position, area = eggService.RandomSpot(lastPosition)
	if not position then
		-- (no free land found: a random area with a good resting spot)
		area = nil
	end
	for _ = 1, 8 do
		if area and position then
			break
		end
		local candidate = areas[rng:NextInteger(1, #areas)]
		local spot = eggService.FindSpot(candidate)
		if spot then
			area, position = candidate, spot
			break
		end
	end
	if not area or not position then
		return nil
	end
	local tier, eggType, luck = WildEggConfig.roll(rng, tierId)
	serial += 1
	local egg = {
		Id = "W" .. serial,
		Tier = tier,
		Egg = eggType,
		Luck = luck,
		Position = position + Vector3.new(0, 2.2, 0),
		Area = area.Label or area.Name,
		Region = area.Region,
		EndsAt = Workspace:GetServerTimeNow() + WildEggConfig.Lifetime,
		Claimed = false,
	}
	egg.Model = buildModel(egg)
	current = egg
	lastPosition = position
	Net.broadcast("WildEggSpawn", payloadOf(egg))
	WildEggService.Spawned:Fire(egg)
	task.delay(WildEggConfig.Lifetime, function()
		if current == egg and not egg.Claimed then
			remove(egg, "expired")
		end
	end)
	return egg
end

-- ============================================================== claiming
local function handleClaim(player: Player)
	local egg = current
	if not egg or egg.Claimed then
		return false, "GONE", "The lucky egg is gone."
	end
	local data = Data.Get(player)
	if not data then
		return false, "NOT_LOADED"
	end
	local slack = 0
	local dragons = Workspace:FindFirstChild("Dragons")
	local model = dragons and dragons:FindFirstChild("Dragon_" .. player.UserId)
	if model then
		slack = (model:GetAttribute("BodyRadius") or 0) * 0.5
	end
	local reach = EggReach.range(data, WildEggConfig.PickupRange) + slack
	if Services.EggService.DistanceTo(player, egg.Position) > reach then
		return false, "TOO_FAR"
	end
	local ok, id, inHand = Services.EggService.GiveEgg(player, egg.Egg, egg.Luck)
	if not ok then
		if id == "EGG_STORAGE_FULL" then
			return false, id, "Your egg bag is full! Make room - the lucky egg is waiting."
		end
		return false, id
	end
	egg.Claimed = true
	Net.broadcast("WildEggClaimed", { Id = egg.Id, Player = player.DisplayName, Name = egg.Tier.Name, Luck = egg.Luck })
	WildEggService.Claimed:Fire(player, egg)
	remove(egg, "claimed")
	return true, { Id = id, Type = egg.Egg, Luck = egg.Luck, Held = inHand, Name = egg.Tier.Name }
end

-- A client that starts late (or restarts its controller) asks what is going on.
local function handleSync()
	if current and not current.Claimed then
		return true, { Current = payloadOf(current) }
	end
	return true, {}
end

-- ============================================================== lifecycle
function WildEggService.Init(services)
	Services = services
	Data = services.PlayerDataService
	Net.handle("WildEgg", "Claim", handleClaim, { Burst = 4, PerSecond = 2 })
	Net.handle("WildEgg", "Sync", handleSync, { Burst = 3, PerSecond = 1 })
end

function WildEggService.Start()
	-- players who join while an egg is out get the announcement too
	Data.Loaded:Connect(function(player)
		if current and not current.Claimed then
			Net.signal(player, "WildEggSpawn", payloadOf(current))
		end
	end)
	task.spawn(function()
		while not Workspace:GetAttribute("WorldReady") do
			task.wait(0.5)
		end
		local d = WildEggConfig.FirstDelay
		task.wait(rng:NextNumber(d.Min, d.Max))
		while true do
			-- (tests and tools can switch the automatic spawns off)
			if #Players:GetPlayers() > 0 and not ReplicatedStorage:GetAttribute("DevDisableWildEggs") then
				pcall(WildEggService.Spawn)
			end
			local i = WildEggConfig.Interval
			task.wait(rng:NextNumber(i.Min, i.Max))
		end
	end)
end

return WildEggService
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000099">
				<Properties>
					<string name="Name">WorldService</string>
					<ProtectedString name="Source"><![CDATA[--[[
	WorldService
	Builds the world at server start from code (deterministic, seeded), so the
	whole map lives in source control. Each region module exposes
	build(context) and returns its spawn/landmark data.

	Also owns the lighting/post-processing stack (GraphicsController toggles
	the effects per quality preset on each client).

	Developer: in Studio's command bar you can bake the current world into
	the place (run the server once, then copy Workspace.World from the
	server view) if you prefer editing it by hand.
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ServerScriptService = game:GetService("ServerScriptService")

local WorldService = {}
WorldService.Spawn = CFrame.new(0, 8, 0)
WorldService.Landmarks = {}
WorldService.Ready = false

local function ensure(className: string, name: string, parent: Instance, props: { [string]: any })
	local inst = parent:FindFirstChild(name)
	if not inst then
		inst = Instance.new(className)
		inst.Name = name
		inst.Parent = parent
	end
	for k, v in props do
		(inst :: any)[k] = v
	end
	return inst
end

-- Premium-but-readable daylight: warm sun, soft blue ambient, light haze.
local function setupLighting()
	-- short grass: the tall default hides characters' legs and small eggs
	pcall(function()
		(Workspace.Terrain :: any).GrassLength = 0.35
	end)
	Lighting.Ambient = Color3.fromRGB(70, 74, 88)
	Lighting.OutdoorAmbient = Color3.fromRGB(128, 132, 146)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 242, 222)
	Lighting.ColorShift_Bottom = Color3.fromRGB(0, 0, 0)
	Lighting.ShadowSoftness = 0.25
	Lighting.ExposureCompensation = 0.1
	ensure("Atmosphere", "Atmosphere", Lighting, {
		Density = 0.32,
		Offset = 0.22,
		Color = Color3.fromRGB(199, 214, 232),
		Decay = Color3.fromRGB(106, 112, 125),
		Glare = 0.25,
		Haze = 1.35,
	})
	ensure("Sky", "Sky", Lighting, {
		SunAngularSize = 14,
		MoonAngularSize = 9,
		StarCount = 2500,
		CelestialBodiesShown = true,
	})
	ensure("BloomEffect", "Bloom", Lighting, { Intensity = 0.55, Size = 28, Threshold = 1.15 })
	ensure("SunRaysEffect", "SunRays", Lighting, { Intensity = 0.045, Spread = 0.72 })
	ensure("ColorCorrectionEffect", "Grade", Lighting, {
		Brightness = 0.02,
		Contrast = 0.08,
		Saturation = 0.12,
		TintColor = Color3.fromRGB(255, 250, 244),
	})
	ensure("DepthOfFieldEffect", "DepthOfField", Lighting, {
		FarIntensity = 0.12,
		FocusDistance = 260,
		InFocusRadius = 240,
		NearIntensity = 0,
		Enabled = true,
	})
end

-- Characters spawn only once the world exists (never into the void).
local function spawnLoop(player: Player)
	while not WorldService.Ready and player.Parent == Players do
		task.wait(0.1)
	end
	if player.Parent == Players and not player.Character then
		player:LoadCharacter()
	end
end

local function onPlayer(player: Player)
	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
		if humanoid then
			humanoid.Died:Connect(function()
				task.delay(Players.RespawnTime, function()
					if player.Parent == Players and player.Character == character then
						player:LoadCharacter()
					end
				end)
			end)
		end
	end)
	task.spawn(spawnLoop, player)
end

function WorldService.Init()
	Players.CharacterAutoLoads = false
	setupLighting()
end

function WorldService.Start()
	local worldFolder = Workspace:FindFirstChild("World")
	if not worldFolder then
		worldFolder = Instance.new("Folder")
		worldFolder.Name = "World"
		worldFolder.Parent = Workspace
	end
	local regions = ServerScriptService:FindFirstChild("World")
	local builder = regions and regions:FindFirstChild("Haven")
	if builder and not worldFolder:GetAttribute("Built") then
		local t0 = os.clock()
		local ok, result = pcall(function()
			return require(builder).build({
				Folder = worldFolder,
				Terrain = Workspace.Terrain,
				Progress = function(f: number)
					Workspace:SetAttribute("WorldProgress", f)
				end,
			})
		end)
		if ok and type(result) == "table" then
			WorldService.Spawn = result.Spawn or WorldService.Spawn
			WorldService.Landmarks = result.Landmarks or {}
			WorldService.Ground = result.Ground
		elseif not ok then
			warn("[World] build failed: " .. tostring(result))
		end
		worldFolder:SetAttribute("Built", true)
		worldFolder:SetAttribute("BuildSeconds", math.floor((os.clock() - t0) * 10) / 10)
	end
	WorldService.Ready = true
	Workspace:SetAttribute("WorldReady", true)
	for _, p in Players:GetPlayers() do
		task.spawn(onPlayer, p)
	end
	Players.PlayerAdded:Connect(onPlayer)
end

return WorldService
]]></ProtectedString>
				</Properties>
			</Item>
		</Item>
		<Item class="Folder" referent="RBX000100">
			<Properties>
				<string name="Name">World</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX000101">
				<Properties>
					<string name="Name">GreatTree</string>
					<ProtectedString name="Source"><![CDATA[--[[
	GreatTree - the giant LEGO-style tree in the plaza (skill tree station).

	A stepped stone base, a trunk of stacked round bricks, a tiered studded crown
	and five limbs, one per TreeConfig category (Luck, Wealth, Flight, Nest,
	Bond). Every limb ends in a pod with five fruit orbs; an orb lights up for
	every fifth of the category's levels the player has bought. The orbs are
	tagged "TreeOrb" with attributes Category / Level (1-5): the client lights
	them (TreeController), so the tree itself shows your progress.

	Local frame: origin on the ground in the middle of the base, local -Z faces
	the plaza (where the prompt and the sign are).
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Kit = require(script.Parent:WaitForChild("Kit"))
local Village = require(script.Parent:WaitForChild("Village"))
local TreeConfig = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("TreeConfig"))

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles
local C = Kit.C
local M = Kit.M

local GreatTree = {}

local BARK = { Color3.fromRGB(122, 78, 48), Color3.fromRGB(104, 66, 42) }
local LEAF = {
	Color3.fromRGB(52, 140, 60),
	Color3.fromRGB(68, 160, 70),
	Color3.fromRGB(88, 180, 80),
	Color3.fromRGB(112, 200, 94),
	Color3.fromRGB(140, 220, 108),
}
local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local ORB_OFF = Color3.fromRGB(88, 94, 104)

GreatTree.CrownTop = 28.8 + 5 * 3.4 -- height of the crown top above the base

-- World position (plaza, north-east of the statue) from TreeConfig.
function GreatTree.position(ground: (number, number) -> number): (Vector3, number)
	local a = math.rad(TreeConfig.WorldAngle)
	local x, z = math.sin(a) * TreeConfig.WorldRing, -math.cos(a) * TreeConfig.WorldRing
	local yaw = math.atan2(x, z) -- local -Z looks back at the plaza centre
	return V(x, ground(x, z), z), yaw
end

local function label(parent: BasePart, text: string, color: Color3, offset: Vector3)
	local gui = Instance.new("BillboardGui")
	gui.Name = "BranchLabel"
	gui.Size = UDim2.fromOffset(180, 34)
	gui.StudsOffsetWorldSpace = offset
	gui.AlwaysOnTop = false
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.Adornee = parent
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1
	t.Size = UDim2.fromScale(1, 1)
	t.Font = Enum.Font.GothamBlack
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color:Lerp(Color3.new(1, 1, 1), 0.35)
	local st = Instance.new("UIStroke")
	st.Thickness = 2
	st.Color = Color3.fromRGB(22, 30, 22)
	st.Parent = t
	t.Parent = gui
	gui.Parent = parent
end

function GreatTree.build(parent: Instance, at: Vector3, yaw: number)
	local b = Kit.new(parent, CF(at) * ANG(0, yaw, 0), "GreatTree")
	b.Model:SetAttribute("Station", "Tree")
	local rng = Random.new(2026)

	-- ---- stepped stone base (each step is at most 1.4 studs: walkable)
	b:cyl(1.4, 32, V(0, 0.7, 0), C.StoneDark, M.Cobblestone)
	b:cyl(1.0, 26, V(0, 1.9, 0), C.Stone, M.Slate)
	b:roundBrick(0.8, 22, V(0, 2.8, 0), LEAF[1], { Studs = "Ring", RingRadius = 9.4 })
	-- toy flower bricks around the edge
	local flowers = { Color3.fromRGB(226, 70, 70), Color3.fromRGB(252, 206, 60), Color3.fromRGB(246, 150, 60), Color3.fromRGB(150, 110, 230) }
	for i = 1, 12 do
		local a = i / 12 * math.pi * 2 + 0.2
		if math.abs(math.sin(a) + 1) > 0.35 then -- keep the front (local -Z) clear for the sign
			local br = b:brick(V(2.4, 2.4, 2.4), CF(math.cos(a) * 12.6, 3.4, math.sin(a) * 12.6) * ANG(0, -a, 0), flowers[(i % #flowers) + 1], { NoStuds = true })
			br.CanCollide = false
			b:roundBrick(1, 1.6, V(math.cos(a) * 12.6, 4.9, math.sin(a) * 12.6), LEAF[3], { Studs = "None", Props = { CanCollide = false } })
		end
	end

	-- ---- trunk: stacked round bricks, slightly tapering
	local y0 = 3.2
	for i = 0, 7 do
		b:roundBrick(3.2, 9.6 - i * 0.35, V(0, y0 + i * 3.2 + 1.6, 0), BARK[i % 2 + 1], { Studs = "None" })
	end
	-- roots
	for k = 0, 4 do
		local a = math.rad(k * 72 + 36)
		b:beam(V(math.cos(a) * 3.6, 6.2, math.sin(a) * 3.6), V(math.cos(a) * 11.5, 3.1, math.sin(a) * 11.5), 3, BARK[1], M.SmoothPlastic)
	end

	-- ---- crown: tiered studded layers
	local crownBase = y0 + 8 * 3.2 -- 28.8
	local dia = { 34, 27, 20, 13.5, 7 }
	local crownTop
	for i = 1, 5 do
		local d = dia[i]
		local y = crownBase + (i - 1) * 3.4 + 1.7
		local opts
		if i < 5 then
			opts = { Studs = "Ring", RingRadius = (d / 2 + dia[i + 1] / 2) / 2 }
		else
			opts = { Studs = "Top" }
		end
		local layer = b:roundBrick(3.4, d, V(0, y, 0), LEAF[i], opts)
		layer.Name = "Crown" .. i
		crownTop = layer
	end
	-- leaf puffs around the lower rim
	for i = 1, 11 do
		local a = i / 11 * math.pi * 2 + rng:NextNumber(-0.12, 0.12)
		local r = 17.2 + rng:NextNumber(-0.8, 1.2)
		b:roundBrick(3.4, rng:NextNumber(5.5, 7.5), V(math.cos(a) * r, crownBase + (i % 2 == 0 and 1.7 or 0.3), math.sin(a) * r), LEAF[(i % 3) + 1], { Studs = "Top" })
	end
	local pl = Instance.new("PointLight")
	pl.Color = Color3.fromRGB(190, 255, 160)
	pl.Range = 38
	pl.Brightness = 0.9
	pl.Shadows = false
	pl.Parent = crownTop
	-- drifting sparkles over the crown
	local fx = b:box(V(30, 1, 30), V(0, crownBase + 17.5, 0), C.Leaf, M.SmoothPlastic, { Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false })
	fx.Name = "CrownFX"
	local pe = Instance.new("ParticleEmitter")
	pe.Texture = SPARKLE
	pe.Color = ColorSequence.new(Color3.fromRGB(190, 255, 150), Color3.fromRGB(255, 240, 150))
	pe.LightEmission = 0.6
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
	pe.Lifetime = NumberRange.new(4, 6)
	pe.Rate = 5
	pe.Speed = NumberRange.new(1, 3)
	pe.Acceleration = V(0, -2.5, 0)
	pe.SpreadAngle = Vector2.new(60, 60)
	pe.EmissionDirection = Enum.NormalId.Bottom
	pe.Parent = fx
	CollectionService:AddTag(pe, "FX")

	-- ---- five limbs: one per category, each ending in a pod with five fruit orbs
	local limbY = { 13, 11, 15, 12, 14 }
	for idx, cat in TreeConfig.Categories do
		local a = math.rad((idx - 1) * 72 + 18)
		local radial = V(math.cos(a), 0, math.sin(a))
		local tangent = V(-math.sin(a), 0, math.cos(a))
		local pod = radial * 13.5 + V(0, limbY[idx] + 3, 0)
		b:beam(radial * 3.8 + V(0, limbY[idx], 0), pod, 2.2, BARK[2], M.SmoothPlastic)
		b:roundBrick(3.6, 11, pod, LEAF[2], { Studs = "None" })
		local top = b:roundBrick(2.4, 7.5, pod + V(0, 3, 0), cat.Color, { Studs = "Top" })
		top.Name = "Pod_" .. cat.Id
		label(top, string.upper(cat.Name), cat.Color, V(0, 10, 0))
		for level = 1, 5 do
			local p = pod + V(0, 7.4, 0) + tangent * ((level - 3) * 3.4)
			local orb = b:ball(2.4, p, ORB_OFF, M.SmoothPlastic, { Transparency = 0.35, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false })
			orb.Name = string.format("Orb_%s_%d", cat.Id, level)
			orb:SetAttribute("Category", cat.Id)
			orb:SetAttribute("Level", level)
			CollectionService:AddTag(orb, "TreeOrb")
			local light = Instance.new("PointLight")
			light.Color = cat.Color
			light.Range = 9
			light.Brightness = 1.4
			light.Shadows = false
			light.Enabled = false
			light.Parent = orb
		end
	end

	-- ---- sign + interaction
	for _, sx in { -1, 1 } do
		b:box(V(0.9, 6.4, 0.9), V(sx * 7.2, 6, -13.2), C.Timber, M.Wood)
	end
	Village.signBoard(b, CF(0, 7.4, -13.2), 14, 3, "THE GREAT TREE")
	local trigger = b:box(V(12, 8, 7), V(0, 7, -9.5), C.Planks, M.WoodPlanks, { Transparency = 1, CanCollide = false, CanQuery = false, CastShadow = false })
	trigger.Name = "TreeTrigger"
	local prompt = b:prompt(trigger, "Upgrade", "Great Tree", { Station = "Tree", Window = "Tree" })
	prompt.MaxActivationDistance = 24
	prompt.Name = "StationPrompt"
	return b.Model
end

return GreatTree
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000102">
				<Properties>
					<string name="Name">Haven</string>
					<ProtectedString name="Source"><![CDATA[--[[
	Haven - builds Dragon Haven: terrain (from generated data), the hub village
	and stations, statue, sanctuary plots, bridges, landmarks, nature props,
	spawn and egg spots. Returns spawn + landmark data for WorldService.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local TerrainWriter = require(script.Parent:WaitForChild("TerrainWriter"))
local Village = require(script.Parent:WaitForChild("Village"))
local Sanctuaries = require(script.Parent:WaitForChild("Sanctuaries"))
local Landmarks = require(script.Parent:WaitForChild("Landmarks"))
local GreatTree = require(script.Parent:WaitForChild("GreatTree"))
local Props = require(script.Parent:WaitForChild("Props"))
local Kit = require(script.Parent:WaitForChild("Kit"))
local WorldConfig = require(ReplicatedStorage:WaitForChild("Configs"):WaitForChild("WorldConfig"))

local Haven = {}

local V = Vector3.new
local CF = CFrame.new
local ANG = CFrame.Angles

local function folder(parent: Instance, name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = parent
	return f
end

function Haven.build(ctx)
	local root: Instance = ctx.Folder
	local terrain: Terrain = ctx.Terrain or Workspace.Terrain
	local log = ctx.Log or function(_: string) end
	local t0 = os.clock()
	local data = require(script.Parent:WaitForChild("HavenTerrainData"))
	local layout = require(script.Parent:WaitForChild("HavenLayout"))
	local map = TerrainWriter.load(data)
	TerrainWriter.applyLook(terrain, data)
	if terrain:GetAttribute("Prebuilt") == nil then
		TerrainWriter.write(terrain, map, { Progress = ctx.Progress })
		terrain:SetAttribute("Prebuilt", "Haven")
	end
	log(("terrain %.1fs"):format(os.clock() - t0))
	local function ground(x: number, z: number): number
		return TerrainWriter.heightAt(map, x, z)
	end

	-- hub: statue, stations, cottages, lamps
	local hub = folder(root, "Hub")
	local statue = Landmarks.statue(hub, V(0, WorldConfig.Hub.Height, 0))
	local stations = {}
	for _, b in layout.Buildings do
		local cf = CF(b.X, b.Y, b.Z) * ANG(0, b.Yaw, 0)
		if b.Kind == "cottage" then
			Village.cottage(hub, cf, { Seed = b.Seed, W = b.w, D = b.d, Stories = b.stories })
		else
			local station = WorldConfig.Stations[b.Station]
			local recipe = (Village :: any)[b.Kind]
			if recipe then
				local model = recipe(hub, cf, station)
				model:SetAttribute("Station", b.Station)
				stations[b.Station] = model
			end
		end
	end
	-- the Battle Hall (duels): not part of the generated layout
	local duelStation = WorldConfig.Stations.Duel
	if duelStation then
		local at = duelStation.Position
		local cf = CF(at.X, ground(at.X, at.Z), at.Z) * ANG(0, duelStation.Facing, 0)
		local model = Village.duel(hub, cf, duelStation)
		model:SetAttribute("Station", "Duel")
		stations.Duel = model
	end
	-- the Great Tree (skill tree station) north-east of the statue
	local treePos, treeYaw = GreatTree.position(ground)
	stations.Tree = GreatTree.build(hub, treePos, treeYaw)
	local lamps = Kit.new(hub, CFrame.identity, "Lamps")
	for _, l in layout.Lamps do
		lamps:lampPost(V(l[1], l[2] - 0.2, l[3]), 10)
	end
	log(("hub %.1fs"):format(os.clock() - t0))

	-- sanctuary plots
	local plots = folder(root, "Sanctuaries")
	local plotModels = {}
	for _, p in WorldConfig.Plots do
		plotModels[p.Id] = Sanctuaries.build(plots, p)
	end

	-- bridges
	local bridges = folder(root, "Bridges")
	for _, b in layout.Bridges do
		Landmarks.bridge(bridges, b)
	end

	-- landmarks
	local lm = folder(root, "Landmarks")
	local rc = WorldConfig.Ruins.Center
	Landmarks.ruins(lm, V(rc.X, ground(rc.X, rc.Z), rc.Z), ground)
	local wf = WorldConfig.Waterfall
	Landmarks.waterfall(lm, wf.Top, wf.Bottom, wf.Width)
	local cavePath = {}
	for i, c in data.Carves do
		table.insert(cavePath, V(c[1], c[2], c[3]))
		if i == #data.Carves then
			table.insert(cavePath, V(c[4], c[5], c[6]))
		end
	end
	Landmarks.caveDecor(lm, cavePath)
	local sp = WorldConfig.SkyPillar.Center
	local pillarTop = ground(sp.X, sp.Z)
	for _, off in { V(10, 0, 0), V(-10, 0, 0), V(0, 0, 10), V(0, 0, -10) } do
		pillarTop = math.max(pillarTop, ground(sp.X + off.X, sp.Z + off.Z))
	end
	Landmarks.skyIslands(lm, terrain, V(sp.X, 0, sp.Z), pillarTop)
	log(("landmarks %.1fs"):format(os.clock() - t0))

	-- nature
	Props.build(root, layout)
	log(("props %.1fs"):format(os.clock() - t0))

	-- spawn (plaza, facing the statue)
	local spawnPos = WorldConfig.Spawn.Position
	local spawnY = ground(spawnPos.X, spawnPos.Z)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "HavenSpawn"
	spawn.Anchored = true
	spawn.Size = V(10, 0.6, 10)
	spawn.CFrame = CFrame.lookAt(V(spawnPos.X, spawnY + 0.3, spawnPos.Z), V(0, spawnY + 0.3, 0))
	spawn.Material = Enum.Material.Slate
	spawn.Color = Color3.fromRGB(150, 142, 128)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Neutral = true
	spawn.Parent = root

	-- egg spots (EggService)
	local eggs = folder(root, "EggSpots")
	for i, e in layout.EggSpots do
		local p = Instance.new("Part")
		p.Name = "EggSpot" .. i
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Transparency = 1
		p.Size = V(4, 4, 4)
		local y = e.Y
		if e.Name == "Pillar" then
			y = pillarTop
		end
		p.CFrame = CF(e.X, y + 2.5, e.Z)
		p:SetAttribute("Area", e.Name)
		p.Parent = eggs
	end

	return {
		Spawn = spawn.CFrame + V(0, 3, 0),
		Landmarks = { Statue = statue, Stations = stations, Plots = plotModels },
		Map = map,
		Ground = ground,
	}
end

return Haven
]]></ProtectedString>
				</Properties>
			</Item>
