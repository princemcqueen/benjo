<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<External>null</External>
	<External>nil</External>
	<Item class="ReplicatedStorage" referent="RBX000001">
		<Properties>
			<string name="Name">ReplicatedStorage</string>
		</Properties>
		<Item class="Folder" referent="RBX000002">
			<Properties>
				<string name="Name">Shared</string>
			</Properties>
			<Item class="ModuleScript" referent="RBX000003">
				<Properties>
					<string name="Name">CoinLayout</string>
					<ProtectedString name="Source"><![CDATA[--[[
	CoinLayout
	Where the coins are. A pure function of the world layout (WorldConfig) and a few height
	queries, so the server (validation) and the tests build exactly the same list; clients get
	the list from CoinService once.

	  CoinLayout.generate(env) -> { { Kind = "Copper" | "Gold" | "Gem", Position = Vector3 } }
	    env.ground(x, z)  -> height, normalY, isWater   terrain only (nil when there is none)
	    env.surface(x, z) -> height | nil               the highest thing of any kind (rooftops,
	                                                    the top of the sky pillar...)

	Copper: trails along every road (swinging a little left and right of it)
	Gold:   arcs above the roads and a ring above the village
	Gem:    treasure piles at the landmarks and the ends of the roads
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local WorldConfig = require(Configs:WaitForChild("WorldConfig"))
local CoinConfig = require(Configs:WaitForChild("CoinConfig"))

local CoinLayout = {}

-- fixed order (dictionaries have no order and the layout must be the same every time)
local ROAD_ORDER = { "North", "East", "South", "West", "Ruins", "Falls" }

local function lengthOf(points: { Vector2 }): number
	local total = 0
	for i = 2, #points do
		total += (points[i] - points[i - 1]).Magnitude
	end
	return total
end

-- Point and direction at distance s along a polyline.
local function pointAt(points: { Vector2 }, s: number): (Vector2, Vector2)
	local left = s
	for i = 2, #points do
		local seg = points[i] - points[i - 1]
		local len = seg.Magnitude
		if left <= len or i == #points then
			local dir = seg / math.max(len, 1e-6)
			return points[i - 1] + dir * math.min(left, len), dir
		end
		left -= len
	end
	return points[#points], Vector2.new(1, 0)
end

-- Landmarks that get a treasure pile: { x, z } (the height comes from env.surface)
local function pileSpots(): { { number } }
	local spots = {}
	local function add(x: number, z: number)
		table.insert(spots, { x, z })
	end
	local ruins = WorldConfig.Ruins
	for i = 0, 2 do
		local a = math.rad(30 + i * 120)
		add(ruins.Center.X + math.cos(a) * ruins.Radius * 0.45, ruins.Center.Z + math.sin(a) * ruins.Radius * 0.45)
	end
	local fall = WorldConfig.Waterfall
	add(fall.Top.X - 46, fall.Top.Z - 70) -- on the plateau above the falls
	add(fall.Bottom.X - 52, fall.Bottom.Z + 26) -- by the pool below
	local caves = WorldConfig.Caves
	add(caves.Mouth.X + math.sin(caves.Facing) * -34, caves.Mouth.Z + math.cos(caves.Facing) * -34)
	add(WorldConfig.SkyPillar.Center.X, WorldConfig.SkyPillar.Center.Z) -- the very top of the pillar
	add(WorldConfig.Lake.Island.Center.X, WorldConfig.Lake.Island.Center.Y)
	for _, forest in WorldConfig.Forests do
		add(forest.Center.X, forest.Center.Y)
	end
	-- the far ends of the roads: where the next regions begin
	for _, name in { "North", "East", "West", "South" } do
		local road = WorldConfig.Roads[name]
		local last = road[#road]
		add(last.X, last.Y)
	end
	return spots
end

function CoinLayout.generate(env): { { Kind: string, Position: Vector3 } }
	local L = CoinConfig.Layout
	local out = {}
	local hub = WorldConfig.Hub.Center
	local hubXZ = Vector2.new(hub.X, hub.Z)
	local function add(kind: string, pos: Vector3)
		table.insert(out, { Kind = kind, Position = pos })
	end

	-- 1) trails of copper coins along the roads
	for _, name in ROAD_ORDER do
		local road = WorldConfig.Roads[name]
		local total = lengthOf(road)
		local s = 0
		while s <= total do
			local p, dir = pointAt(road, s)
			local side = Vector2.new(-dir.Y, dir.X) * (math.sin(s * 0.045) * L.Weave)
			local q = p + side
			if (q - hubXZ).Magnitude >= L.FromHub then
				local y, ny, water = env.ground(q.X, q.Y)
				if y and not water and (ny or 1) >= L.MaxSlope then
					add("Copper", Vector3.new(q.X, y + L.Lift, q.Y))
				end
			end
			s += L.Spacing
		end
	end

	-- 2) a ring of sky coins above the village (the first thing a new rider sees)
	local ringCount = 14
	for i = 0, ringCount - 1 do
		local a = i / ringCount * math.pi * 2
		local x = hub.X + math.cos(a) * 150
		local z = hub.Z + math.sin(a) * 150
		local y = env.ground(x, z)
		if y then
			add("Gold", Vector3.new(x, y + 82 + math.sin(a * 3) * 12, z))
		end
	end

	-- 3) arcs of sky coins above the roads
	for _, name in ROAD_ORDER do
		local road = WorldConfig.Roads[name]
		local total = lengthOf(road)
		local arcLength = L.ArcSpacing * (L.ArcCoins - 1)
		local start = 260
		while start + arcLength < total do
			for i = 0, L.ArcCoins - 1 do
				local p = pointAt(road, start + i * L.ArcSpacing)
				local y = env.ground(p.X, p.Y)
				if y then
					local t = math.sin(math.pi * i / (L.ArcCoins - 1))
					add("Gold", Vector3.new(p.X, y + L.ArcLift[1] + (L.ArcLift[2] - L.ArcLift[1]) * t, p.Y))
				end
			end
			start += L.ArcEvery
		end
	end

	-- 4) treasure piles
	for _, spot in pileSpots() do
		local y = env.surface(spot[1], spot[2])
		if y then
			add("Gem", Vector3.new(spot[1], y + 2.8, spot[2]))
		end
	end
	return out
end

-- The layout as three strings of integers plus the kind codes (compact to send to clients).
function CoinLayout.pack(list: { { Kind: string, Position: Vector3 } }): { X: { number }, Y: { number }, Z: { number }, K: string }
	local X, Y, Z, K = {}, {}, {}, {}
	for i, coin in list do
		X[i] = math.floor(coin.Position.X + 0.5)
		Y[i] = math.floor(coin.Position.Y + 0.5)
		Z[i] = math.floor(coin.Position.Z + 0.5)
		K[i] = CoinConfig.Kinds[coin.Kind].Code
	end
	return { X = X, Y = Y, Z = Z, K = table.concat(K) }
end

function CoinLayout.unpack(packed): { { Kind: string, Position: Vector3 } }
	local out = {}
	for i = 1, #packed.X do
		local code = string.sub(packed.K, i, i)
		out[i] = { Kind = CoinConfig.KindOfCode[code] or "Copper", Position = Vector3.new(packed.X[i], packed.Y[i], packed.Z[i]) }
	end
	return out
end

return CoinLayout
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000004">
				<Properties>
					<string name="Name">DragonStats</string>
					<ProtectedString name="Source"><![CDATA[--[[
	DragonStats
	Pure stat math shared by server (authoritative) and client (previews).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))
local GameConfig = require(Configs:WaitForChild("GameConfig"))
local TreeConfig = require(Configs:WaitForChild("TreeConfig"))

local DragonStats = {}

function DragonStats.compute(speciesId: string, level: number, mutation: string?)
	local species = DragonConfig.Species[speciesId]
	assert(species, "Unknown species " .. tostring(speciesId))
	local lm = DragonConfig.levelMultiplier(level)
	local mm = MutationConfig.multiplier(mutation)
	return {
		Speed = math.floor(species.Speed * lm * mm + 0.5),
		FlightSpeed = math.floor(species.FlightSpeed * lm * mm + 0.5),
		IncomePerSecond = math.floor(species.Income * lm * mm * 100 + 0.5) / 100,
	}
end

-- What a dragon sells for: EconomyConfig.SellSeconds (+ the Gentle Goodbye tree bonus) of its BASE
-- income - species income x mutation, NOT the level. Feeding therefore never raises the price and
-- feed + sell can never make money. `data` = the seller's player data (for the tree bonus), may be nil.
function DragonStats.sellValue(record, data): number
	local species = DragonConfig.Species[record.SpeciesId]
	local base = species and species.Income or record.IncomePerSecond or 0
	local seconds = TreeConfig.refundSeconds(data or {})
	return math.max(1, math.floor(base * MutationConfig.multiplier(record.Mutation) * seconds + 0.5))
end

-- Exclusive (Robux) dragons are not for sale.
function DragonStats.canSellSpecies(speciesId: string): boolean
	local species = DragonConfig.Species[speciesId]
	return species ~= nil and species.Exclusive ~= true and species.Rarity ~= "Exclusive"
end

function DragonStats.newRecord(uid: string, speciesId: string, mutation: string?, now: number)
	local species = DragonConfig.Species[speciesId]
	local stats = DragonStats.compute(speciesId, 1, mutation)
	return {
		UniqueId = uid,
		SpeciesId = speciesId,
		Name = species.Name,
		Rarity = species.Rarity,
		Level = 1,
		XP = 0,
		Mutation = mutation or "None",
		Speed = stats.Speed,
		FlightSpeed = stats.FlightSpeed,
		IncomePerSecond = stats.IncomePerSecond,
		Locked = false,
		PlacedNestId = "",
		CreatedAt = now,
	}
end

-- Recomputes derived fields from species/level/mutation (keeps saves in sync
-- with balance changes and prevents stale or tampered stats).
function DragonStats.refresh(record)
	local species = DragonConfig.Species[record.SpeciesId]
	if not species then
		return false
	end
	record.Level = math.clamp(math.floor(tonumber(record.Level) or 1), 1, DragonConfig.MaxLevel)
	record.XP = math.max(0, math.floor(tonumber(record.XP) or 0))
	if record.Mutation == nil or MutationConfig.Mutations[record.Mutation] == nil then
		record.Mutation = "None"
	end
	local stats = DragonStats.compute(record.SpeciesId, record.Level, record.Mutation)
	record.Rarity = species.Rarity
	record.Speed = stats.Speed
	record.FlightSpeed = stats.FlightSpeed
	record.IncomePerSecond = stats.IncomePerSecond
	if type(record.Name) ~= "string" or #record.Name == 0 or #record.Name > 40 then
		record.Name = species.Name
	end
	record.Locked = record.Locked == true
	if type(record.PlacedNestId) ~= "string" then
		record.PlacedNestId = ""
	end
	if type(record.CreatedAt) ~= "number" then
		record.CreatedAt = 0
	end
	return true
end

-- "BEST" ranking: income dominates, flight speed breaks ties, rarity as backup.
function DragonStats.score(record): number
	return record.IncomePerSecond * 1000 + record.FlightSpeed * 0.01 + DragonConfig.rarityRank(record.Rarity)
end

-- flyBonus: Great Tree "Wind Wings" (fraction, 0.1 = +10% cruise speed)
function DragonStats.cruiseSpeed(record, flyBonus: number?): number
	return GameConfig.flightCruiseSpeed(record.FlightSpeed) * (1 + math.max(0, flyBonus or 0))
end

-- runBonus: Great Tree "Swift Paws" (fraction, 0.1 = +10% run speed)
function DragonStats.runSpeed(record, runBonus: number?): number
	return GameConfig.groundRunSpeed(record.Speed) * (1 + math.max(0, runBonus or 0))
end

-- Applies XP and returns number of levels gained.
function DragonStats.addXP(record, amount: number): number
	local gained = 0
	record.XP += math.max(0, math.floor(amount))
	while record.Level < DragonConfig.MaxLevel do
		local need = DragonConfig.xpToNext(record.Level)
		if record.XP < need then
			break
		end
		record.XP -= need
		record.Level += 1
		gained += 1
	end
	if record.Level >= DragonConfig.MaxLevel then
		record.XP = 0
	end
	DragonStats.refresh(record)
	return gained
end

return DragonStats
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="Folder" referent="RBX000005">
				<Properties>
					<string name="Name">Dragons</string>
				</Properties>
				<Item class="ModuleScript" referent="RBX000006">
					<Properties>
						<string name="Name">Animator</string>
						<ProtectedString name="Source"><![CDATA[--[[
	Dragon Animator (procedural, blended)

	Base locomotion states (crossfaded by weight, never snapped):
	  Idle, Walk, Run, Fall, Hover, Fly, FastFly, Dive, Ascend, Descend, Sleep,
	  Rest (lying down awake - sanctuary perches)
	One-shot actions (with fade in/out envelopes):
	  Jump, Takeoff, Landing, Roar, Eat, IdleVariant
	  Life on the ground: Yawn, Stretch (play bow), TailSwish, Sniff, Shake, Twirl, Bow, Howl
	  Joy: Cheer (a happy hop on the ground), Loop (a somersault in the air)
	  Dragon Bond: Dash, FireBreath (held until Stop), Flourish (Sky Dance)
	Additive layers:
	  wing banking, breathing, head look, spring-driven tail/neck motion.

	Joint rotations are authored in each joint's model-aligned rest frame
	(CFrame.Angles(rx, ry, rz)). Sign conventions:
	  Body / Chest / Head / Neck rx > 0 : nose up
	  Tail rx > 0                       : tail lowers
	  Limb rx > 0                       : limb swings forward
	  Wing (left) rz < 0                : wing rises; ry > 0 sweeps back
	Right-side joints are mirrored automatically (ry, rz and px negated).

	Wings: the folded pose is solved per model from target bone directions,
	so every wing shape folds tightly. Membranes are re-stretched between
	bone anchors after each pose (Membranes.luau) using forward kinematics,
	so they never lag a frame behind the bones.
]]

local Membranes = require(script.Parent:WaitForChild("Membranes"))

local Animator = {}
Animator.__index = Animator

local TAU = math.pi * 2
local sin, cos, rad, exp, clamp, max = math.sin, math.cos, math.rad, math.exp, math.clamp, math.max

local BASE_STATES = { "Idle", "Walk", "Run", "Fall", "Hover", "Fly", "FastFly", "Dive", "Ascend", "Descend", "Sleep", "Rest" }
Animator.States = BASE_STATES

local ONESHOTS = {
	Jump = { Duration = 0.55, FadeIn = 0.06, FadeOut = 0.2 },
	Takeoff = { Duration = 0.75, FadeIn = 0.1, FadeOut = 0.25 },
	Landing = { Duration = 0.55, FadeIn = 0.08, FadeOut = 0.22 },
	Roar = { Duration = 1.7, FadeIn = 0.18, FadeOut = 0.35 },
	Eat = { Duration = 2.4, FadeIn = 0.25, FadeOut = 0.35 },
	IdleVariant = { Duration = 2.6, FadeIn = 0.4, FadeOut = 0.5 },
	-- Dragon Bond abilities
	Dash = { Duration = 0.55, FadeIn = 0.05, FadeOut = 0.22 },
	-- Hold: the clip sustains at that time until Stop() (or MaxHold seconds)
	FireBreath = { Duration = 4.6, FadeIn = 0.18, FadeOut = 0.35, Hold = 0.45, MaxHold = 3.9 },
	Flourish = { Duration = 1.8, FadeIn = 0.12, FadeOut = 0.3 },
	-- everyday behaviour (perches, companions) and reactions
	Yawn = { Duration = 2.8, FadeIn = 0.35, FadeOut = 0.5 },
	Stretch = { Duration = 3.0, FadeIn = 0.4, FadeOut = 0.5 },
	TailSwish = { Duration = 2.2, FadeIn = 0.3, FadeOut = 0.4 },
	Sniff = { Duration = 2.6, FadeIn = 0.35, FadeOut = 0.45 },
	Shake = { Duration = 1.5, FadeIn = 0.1, FadeOut = 0.3 },
	Twirl = { Duration = 1.8, FadeIn = 0.1, FadeOut = 0.3 },
	Bow = { Duration = 2.2, FadeIn = 0.3, FadeOut = 0.45 },
	Howl = { Duration = 3.2, FadeIn = 0.35, FadeOut = 0.5 },
	Cheer = { Duration = 1.5, FadeIn = 0.08, FadeOut = 0.3 },
	Loop = { Duration = 2.0, FadeIn = 0.12, FadeOut = 0.35 },
	-- arena duels
	Strike = { Duration = 0.6, FadeIn = 0.04, FadeOut = 0.2 },
	Cast = { Duration = 0.9, FadeIn = 0.06, FadeOut = 0.26 },
	Hurt = { Duration = 0.5, FadeIn = 0.03, FadeOut = 0.2 },
}
Animator.OneShots = ONESHOTS

-- Folded wing: target directions (model space, left wing; outward = -X).
-- The fingers fan down the flank so the folded membrane drapes like a cape.
local FOLD_AIMS = {
	Vector3.new(-0.16, -0.22, 0.96), -- humerus: back and a little down along the flank
	Vector3.new(-0.08, 0.16, -0.98), -- forearm: folds forward, wrist beside the shoulder
	Vector3.new(-0.05, 0.0, 1.0), -- main finger: straight back along the upper flank
	Vector3.new(-0.05, -0.3, 0.95), -- finger 2: back and down
	Vector3.new(-0.04, -0.55, 0.83), -- finger 3: down the flank
}
local FOLD_NORMAL = Vector3.new(-1, 0.15, 0) -- membrane faces outward when folded
local WING_JOINTS = { "WingL1", "WingL2", "WingL3", "WingL4", "WingL5", "WingR1", "WingR2", "WingR3", "WingR4", "WingR5" }
local FOLD_PARENT = { 0, 1, 2, 3, 3 } -- parent index in the wing chain (0 = chest)

-- ============================================================== math helpers
local function wrapAngle(a: number): number
	return (a + math.pi) % TAU - math.pi
end

-- Euler XYZ decomposition choosing the solution with the smallest rotation
-- amounts (so blending from rest moves joints along the natural path).
local function eulerMin(cf: CFrame): (number, number, number)
	local rx, ry, rz = cf:ToEulerAnglesXYZ()
	local ax, ay, az = wrapAngle(rx + math.pi), wrapAngle(math.pi - ry), wrapAngle(rz + math.pi)
	if math.abs(ax) + math.abs(ay) + math.abs(az) < math.abs(rx) + math.abs(ry) + math.abs(rz) then
		return ax, ay, az
	end
	return rx, ry, rz
end

-- Canonical rotation vector (axis * angle, angle in [0, pi]).
local function rotVec(cf: CFrame): Vector3
	local axis, angle = cf:ToAxisAngle()
	if angle ~= angle or axis.Magnitude < 1e-6 then
		return Vector3.zero
	end
	angle = angle % (2 * math.pi)
	if angle > math.pi then
		angle = 2 * math.pi - angle
		axis = -axis
	end
	return axis.Unit * angle
end

local function fromRotVec(v: Vector3): CFrame
	local m = v.Magnitude
	if m < 1e-6 then
		return CFrame.identity
	end
	return CFrame.fromAxisAngle(v / m, m)
end

local function aimFrame(aim: Vector3, normalHint: Vector3): CFrame
	local a = aim.Unit
	local n = normalHint - a * normalHint:Dot(a)
	if n.Magnitude < 1e-4 then
		n = Vector3.zAxis - a * a.Z
	end
	n = n.Unit
	return CFrame.fromMatrix(Vector3.zero, a, n, a:Cross(n))
end

-- ============================================================== construction
-- Rig joint names (sockets such as FootFL, WingTipL, MemF1L, Mouth are not joints).
local JOINT_PATTERNS = {
	"^Body$", "^Chest$", "^Pelvis$", "^Head$", "^Jaw$", "^Neck%d+$", "^Tail%d+$",
	"^Arm[LR]%d$", "^Leg[LR]%d$", "^Hand[LR]$", "^Foot[LR]$", "^Wing[LR]%d$",
}
local function isJointName(name: string): boolean
	for _, p in JOINT_PATTERNS do
		if string.match(name, p) then
			return true
		end
	end
	return false
end
Animator.isJointName = isJointName

function Animator.new(model: Model)
	local self = setmetatable({}, Animator)
	self.Model = model
	-- Motors: joint name -> Motor6D (part-built dragons) or Bone (skinned mesh
	-- dragons); both expose .Transform with the same model-aligned convention.
	-- Joints: name -> { Parent, C0, C1inv } for forward kinematics.
	self.Motors = {}
	self.Joints = {}
	self.MeshRig = model:GetAttribute("MeshRig") == true
	for _, d in model:GetDescendants() do
		if d:IsA("Motor6D") and d.Name ~= "MemJoint" then
			self.Motors[d.Name] = d
			if d.Part0 then
				self.Joints[d.Name] = { Parent = d.Part0.Name, C0 = d.C0, C1inv = d.C1:Inverse() }
			end
		elseif d:IsA("Bone") and isJointName(d.Name) then
			self.Motors[d.Name] = d
			local p = d.Parent
			self.Joints[d.Name] = {
				Parent = (p and p:IsA("Bone")) and p.Name or "Root",
				C0 = d.CFrame,
				C1inv = CFrame.identity,
			}
		end
	end
	local m = self.Motors
	self.HasFront = m.ArmL1 ~= nil
	self.HasBack = m.LegL1 ~= nil
	self.HasWings = m.WingL1 ~= nil
	self.Neck = {}
	for i = 1, 8 do
		if m["Neck" .. i] then
			table.insert(self.Neck, "Neck" .. i)
		end
	end
	self.Tail = {}
	for i = 1, 16 do
		if m["Tail" .. i] then
			table.insert(self.Tail, "Tail" .. i)
		end
	end
	self.Rig = model:GetAttribute("Rig") or "Quadruped"
	self.Scale = model:GetAttribute("Scale") or 1
	self.Weights = {}
	for _, s in BASE_STATES do
		self.Weights[s] = 0
	end
	self.Weights.Idle = 1
	self.Target = "Idle"
	self.Gait = 0
	self.Flap = 0
	self.Breath = math.random()
	self.Time = math.random() * 10
	self.Shots = {}
	self.Acc = {}
	for name in m do
		self.Acc[name] = { 0, 0, 0, 0, 0, 0 }
	end
	self.SpreadW = 0 -- total weight of spread-wing contributions this frame
	self.FoldW = 0 -- total weight of the folded-wing pose this frame
	self.WingBank = 0
	self.Params = {
		Speed = 0, -- horizontal speed (studs/s)
		RunSpeed = 40,
		WalkSpeed = 16,
		Vertical = 0, -- vertical speed
		TurnRate = 0, -- yaw rate rad/s
		Bank = 0, -- radians, + = right bank
		Pitch = 0, -- flight pitch (radians, + = nose up)
		Mode = "Ground", -- Ground | Air | Fly | Sleep
		Boost = false,
		Look = Vector2.zero, -- head look (yaw, pitch) radians
	}
	self.TailSpring = { 0, 0 }
	self.TailPitch = { 0, 0 }
	self.NeckSpring = { 0, 0 }
	self.BankSmoothed = 0
	self.OnFootstep = nil -- fn(side)
	self.OnFlap = nil -- fn()
	self.Paused = false
	self:_buildSkeleton()
	self:_solveFold()
	self.Membranes = Membranes.new(model)
	self.MembranesEnabled = self.Membranes.Valid
	self.Transforms = {}
	self.BoneCF = { Root = CFrame.identity }
	self.LastWingSig = nil
	return self
end

-- Joint tree (parent-first order) for forward kinematics.
function Animator:_buildSkeleton()
	local byParent: { [string]: { any } } = {}
	for name, j in self.Joints do
		byParent[j.Parent] = byParent[j.Parent] or {}
		table.insert(byParent[j.Parent], { Name = name, Parent = j.Parent, C0 = j.C0, C1inv = j.C1inv })
	end
	local order = {}
	local queue = { "Root" }
	local seen = { Root = true }
	while #queue > 0 do
		local parent = table.remove(queue, 1)
		for _, j in byParent[parent] or {} do
			if not seen[j.Name] then
				seen[j.Name] = true
				table.insert(order, j)
				table.insert(queue, j.Name)
			end
		end
	end
	self.Chain = order
	-- rest pose (root space)
	local rest = { Root = CFrame.identity }
	for _, j in order do
		local pcf = rest[j.Parent]
		if pcf then
			rest[j.Name] = pcf * j.C0 * j.C1inv
		end
	end
	self.Rest = rest
end

-- Solves the folded wing rotations for this model's wing geometry.
function Animator:_solveFold()
	if not self.HasWings or not self.Motors.WingL5 then
		self.Fold = nil
		return
	end
	local rest = self.Rest
	local function pivot(name: string): Vector3
		local j = self.Joints[name]
		return (rest[j.Parent] * j.C0).Position
	end
	local function attachPos(name: string): Vector3?
		local att = self.Model:FindFirstChild(name, true)
		if att and att:IsA("Attachment") and att.Parent then
			-- part-built: attachment on a bone part (rest = part frame);
			-- mesh: socket Bone under a joint Bone (rest = joint frame)
			local base = rest[att.Parent.Name]
			if att.Parent:IsA("Bone") and att.Parent.Name == "Root" then
				base = CFrame.identity
			end
			if base then
				return base * att.Position
			end
		end
		return nil
	end
	local S, E, W = pivot("WingL1"), pivot("WingL2"), pivot("WingL3")
	local F1 = attachPos("MemF1L") or W + Vector3.new(-3, 0, 1)
	local F2 = attachPos("MemF2L") or W + Vector3.new(-1.5, 0, 3)
	local F3 = attachPos("MemF3L") or W + Vector3.new(1, 0, 4)
	local restAims = { E - S, W - E, F1 - W, F2 - W, F3 - W }
	local D = {}
	for i = 1, 5 do
		local rf = aimFrame(restAims[i], Vector3.yAxis)
		local tf = aimFrame(FOLD_AIMS[i], FOLD_NORMAL)
		D[i] = tf * rf:Inverse()
	end
	local fold = {}
	local foldCF = {}
	local foldRV = {}
	for i = 1, 5 do
		local parentIdx = FOLD_PARENT[i]
		local local_ = parentIdx == 0 and D[i] or D[parentIdx]:Inverse() * D[i]
		local rx, ry, rz = eulerMin(local_)
		fold[i] = { rx, ry, rz }
		foldCF["WingL" .. i] = CFrame.Angles(rx, ry, rz)
		foldCF["WingR" .. i] = CFrame.Angles(rx, -ry, -rz)
		foldRV["WingL" .. i] = rotVec(foldCF["WingL" .. i])
		foldRV["WingR" .. i] = rotVec(foldCF["WingR" .. i])
	end
	self.Fold = fold
	self.FoldCF = foldCF
	self.FoldRV = foldRV
end

-- ============================================================== control
function Animator:SetParams(p: { [string]: any })
	for k, v in p do
		self.Params[k] = v
	end
end

function Animator:Play(name: string, speed: number?)
	local def = ONESHOTS[name]
	if not def then
		return
	end
	for i = #self.Shots, 1, -1 do
		if self.Shots[i].Name == name then
			table.remove(self.Shots, i)
		end
	end
	-- StartFold lets a shot begin from the wing state it interrupts (e.g. a
	-- takeoff from a jump starts with open wings, from the ground folded)
	table.insert(self.Shots, { Name = name, T = 0, Speed = speed or 1, Def = def, StartFold = self.LastFoldW or 1 })
end

function Animator:IsPlaying(name: string): boolean
	for _, s in self.Shots do
		if s.Name == name then
			return true
		end
	end
	return false
end

function Animator:Stop(name: string)
	for _, s in self.Shots do
		if s.Name == name then
			s.Released = true
			if s.T < s.Def.Duration - s.Def.FadeOut then
				s.T = s.Def.Duration - s.Def.FadeOut
			end
		end
	end
end

-- Instantly snaps to a state (no crossfade); used when spawning.
function Animator:Snap(state: string)
	for _, s in BASE_STATES do
		self.Weights[s] = s == state and 1 or 0
	end
	self.Target = state
end

local function chooseTarget(p): string
	local mode = p.Mode
	if mode == "Sleep" then
		return "Sleep"
	elseif mode == "Rest" then
		return "Rest"
	elseif mode == "Ground" then
		if p.Speed < 1.2 then
			return "Idle"
		elseif p.Speed < (p.WalkSpeed + p.RunSpeed) * 0.5 then
			return "Walk"
		end
		return "Run"
	elseif mode == "Air" then
		return "Fall"
	end
	-- flying
	if p.Vertical < -p.Speed * 0.7 and p.Speed > 25 then
		return "Dive"
	end
	if p.Boost then
		return "FastFly"
	end
	if p.Speed < 14 then
		if p.Vertical > 8 then
			return "Ascend"
		elseif p.Vertical < -8 then
			return "Descend"
		end
		return "Hover"
	end
	if p.Vertical > p.Speed * 0.45 then
		return "Ascend"
	end
	return "Fly"
end
Animator.chooseTarget = chooseTarget

-- ============================================================== pose helpers
local function add(acc, joint: string, w: number, rx: number, ry: number, rz: number, px: number?, py: number?, pz: number?)
	local a = acc[joint]
	if not a then
		return
	end
	a[1] += rx * w
	a[2] += ry * w
	a[3] += rz * w
	if px then
		a[4] += px * w
		a[5] += (py or 0) * w
		a[6] += (pz or 0) * w
	end
end

-- Left joint gets (rx, ry, rz); right mirror gets (rx, -ry, -rz).
local function sym(acc, base: string, w: number, rx: number, ry: number, rz: number, px: number?, py: number?, pz: number?)
	add(acc, (base:gsub("%%", "L")), w, rx, ry, rz, px and -px or nil, py, pz)
	add(acc, (base:gsub("%%", "R")), w, rx, -ry, -rz, px, py, pz)
end

local function side(acc, base: string, s: string, w: number, rx: number, ry: number, rz: number)
	if s == "L" then
		add(acc, (base:gsub("%%", "L")), w, rx, ry, rz)
	else
		add(acc, (base:gsub("%%", "R")), w, rx, -ry, -rz)
	end
end

local function wave(phase: number, offset: number?): number
	return sin((phase + (offset or 0)) * TAU)
end

-- Wing beat curve: fast downstroke, slower upstroke. Returns -1..1 (+ = up).
local function beat(phase: number): number
	local p = phase % 1
	if p < 0.42 then
		return cos(p / 0.42 * math.pi)
	end
	return -cos((p - 0.42) / 0.58 * math.pi)
end
Animator.beat = beat

local function neck(self, acc, w: number, rx: number, ry: number?)
	local n = #self.Neck
	for _, j in self.Neck do
		add(acc, j, w, rx / n, (ry or 0) / n, 0)
	end
end

local function tail(self, acc, w: number, rx: number, ry: number?, waveAmp: number?, wavePhase: number?)
	local n = #self.Tail
	for i, j in self.Tail do
		local k = i / n
		local wv = waveAmp and wave(wavePhase or 0, -i * 0.11) * waveAmp * (0.5 + k) or 0
		add(acc, j, w, rx / n, (ry or 0) / n + wv, 0)
	end
end

-- ============================================================== wing poses
-- Wings blend between a spread pose (Euler accumulation, weighted) and the
-- solved folded pose by quaternion slerp, so folding follows the natural
-- shortest rotation of each joint instead of an Euler-blend path.
local function wingsFolded(self, acc, w: number)
	if w > 0 then
		self.FoldW += w
	end
end

-- Spread wing. b: flap position (-1 down .. 1 up); lag: delayed flap for the
-- outer wing; sweep: 0 open .. 1 swept back; close: fingers closing 0..1.
local function wingsSpread(self, acc, w: number, b: number, lag: number, sweep: number, close: number?)
	if w <= 0 then
		return
	end
	self.SpreadW += w
	local up = b > 0 and b * rad(50) or b * rad(40)
	sym(acc, "Wing%1", w, rad(3) - b * rad(5), rad(4) + sweep * rad(30), -up + rad(4))
	sym(acc, "Wing%2", w, 0, rad(3) - sweep * rad(24), -lag * rad(18) - sweep * rad(8))
	sym(acc, "Wing%3", w, 0, sweep * rad(26) - b * rad(4), -lag * rad(12) + sweep * rad(10))
	local cl = (close or 0) + max(0, lag) * 0.22 + sweep * 0.3
	sym(acc, "Wing%4", w, 0, -0.42 * cl, 0)
	sym(acc, "Wing%5", w, 0, -0.85 * cl, 0)
end

-- ============================================================== leg poses
local function legCycle(self, acc, w: number, phase: number, stride: number, lift: number, bound: number)
	local fOff = { L = 0, R = 0.5 }
	local bOff = { L = 0.5, R = 0.0 }
	if bound > 0.5 then
		fOff = { L = 0, R = 0.08 }
		bOff = { L = 0.5, R = 0.58 }
	end
	for _, s in { "L", "R" } do
		if self.HasFront then
			local ph = phase + fOff[s]
			local swing = wave(ph) * stride
			local up = max(0, wave(ph, 0.25)) * lift
			side(acc, "Arm%1", s, w, swing, 0, 0)
			side(acc, "Arm%2", s, w, -up * 1.1, 0, 0)
			side(acc, "Hand%", s, w, -swing + up * 0.9, 0, 0)
		end
		if self.HasBack then
			local ph = phase + bOff[s]
			local swing = wave(ph) * stride * 0.9
			local up = max(0, wave(ph, 0.25)) * lift
			side(acc, "Leg%1", s, w, swing + up * 0.25, 0, 0)
			side(acc, "Leg%2", s, w, -up * 0.85, 0, 0)
			side(acc, "Foot%", s, w, -swing + up * 0.55, 0, 0)
		end
	end
end

local function tuckLegs(self, acc, w: number, amount: number)
	if self.HasFront then
		sym(acc, "Arm%1", w, -0.75 * amount, 0, 0.05)
		sym(acc, "Arm%2", w, 1.25 * amount, 0, 0)
		sym(acc, "Hand%", w, 0.55 * amount, 0, 0)
	end
	if self.HasBack then
		sym(acc, "Leg%1", w, -0.85 * amount, 0, 0)
		sym(acc, "Leg%2", w, -0.5 * amount, 0, 0)
		sym(acc, "Foot%", w, 1.2 * amount, 0, 0)
	end
end

-- ============================================================== base states
local States = {}

States.Idle = function(self, acc, w)
	local br = wave(self.Breath)
	local t = self.Time
	add(acc, "Chest", w, br * 0.02, 0, 0, 0, br * 0.05 * self.Scale, 0)
	add(acc, "Body", w, 0, 0, 0, 0, br * 0.035 * self.Scale, 0)
	neck(self, acc, w, -0.1 + sin(t * 0.7) * 0.04, sin(t * 0.33) * 0.12)
	add(acc, "Head", w, 0.12 + sin(t * 0.9) * 0.03, sin(t * 0.41) * 0.12, 0)
	tail(self, acc, w, 0.12, 0, 0.06, t * 0.13)
	wingsFolded(self, acc, w)
	add(acc, "Jaw", w, 0.02 + max(0, br) * 0.02, 0, 0)
end

States.Walk = function(self, acc, w)
	local ph = self.Gait
	legCycle(self, acc, w, ph, 0.38, 0.5, 0)
	local bob = cos(ph * TAU * 2)
	add(acc, "Body", w, 0, wave(ph) * 0.03, wave(ph) * 0.025, 0, bob * 0.1 * self.Scale, 0)
	neck(self, acc, w, -0.18 - bob * 0.03, -wave(ph) * 0.06)
	add(acc, "Head", w, 0.16 + bob * 0.03, wave(ph) * 0.04, 0)
	tail(self, acc, w, 0.06, 0, 0.09, ph)
	wingsFolded(self, acc, w)
end

States.Run = function(self, acc, w)
	local ph = self.Gait
	legCycle(self, acc, w, ph, 0.7, 0.85, 1)
	local bob = cos(ph * TAU)
	add(acc, "Body", w, 0, 0, 0, 0, bob * 0.22 * self.Scale - 0.08 * self.Scale, 0)
	add(acc, "Chest", w, bob * 0.06, 0, 0)
	add(acc, "Pelvis", w, -bob * 0.08, 0, 0)
	neck(self, acc, w, -0.42 - bob * 0.06, 0)
	add(acc, "Head", w, 0.34 + bob * 0.05, 0, 0)
	tail(self, acc, w, -0.12 + bob * 0.05, 0, 0.05, ph)
	wingsFolded(self, acc, w)
end

States.Fall = function(self, acc, w)
	local t = self.Time
	wingsSpread(self, acc, w, 0.4 + sin(t * 3) * 0.1, 0.3, 0.2, 0.2)
	if self.HasFront then
		sym(acc, "Arm%1", w, 0.35, 0, 0)
		sym(acc, "Arm%2", w, -0.4, 0, 0)
	end
	if self.HasBack then
		sym(acc, "Leg%1", w, 0.25, 0, 0)
		sym(acc, "Leg%2", w, -0.3, 0, 0)
	end
	neck(self, acc, w, 0.1)
	tail(self, acc, w, -0.15)
end

States.Hover = function(self, acc, w)
	local b = beat(self.Flap)
	local lag = beat(self.Flap - 0.12)
	wingsSpread(self, acc, w, b * 0.95, lag * 0.95, 0, 0)
	-- upright posture; body rises on each downstroke
	add(acc, "Body", w, 0.22, 0, 0, 0, -b * 0.25 * self.Scale, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, 0.2, 0, 0.04)
		sym(acc, "Arm%2", w, 0.7, 0, 0)
		sym(acc, "Hand%", w, 0.5, 0, 0)
	end
	if self.HasBack then
		sym(acc, "Leg%1", w, -0.15, 0, 0)
		sym(acc, "Leg%2", w, -0.2, 0, 0)
		sym(acc, "Foot%", w, 0.6, 0, 0)
	end
	neck(self, acc, w, -0.24 + b * 0.05)
	add(acc, "Head", w, 0.02, 0, 0)
	tail(self, acc, w, 0.45, 0, 0.06, self.Flap)
end

States.Fly = function(self, acc, w)
	local b = beat(self.Flap) * 0.6
	local lag = beat(self.Flap - 0.13) * 0.6
	wingsSpread(self, acc, w, b, lag, 0.08, 0)
	add(acc, "Body", w, 0, 0, 0, 0, -b * 0.15 * self.Scale, 0)
	tuckLegs(self, acc, w, 0.85)
	neck(self, acc, w, -0.38)
	add(acc, "Head", w, 0.3, 0, 0)
	tail(self, acc, w, -0.18, 0, 0.04, self.Flap * 0.5)
end

States.FastFly = function(self, acc, w)
	local b = beat(self.Flap) * 0.3
	wingsSpread(self, acc, w, b - 0.08, b * 0.6, 0.85, 0.2)
	tuckLegs(self, acc, w, 1)
	neck(self, acc, w, -0.5)
	add(acc, "Head", w, 0.4, 0, 0)
	tail(self, acc, w, -0.24, 0, 0.03, self.Time * 1.8)
end

States.Dive = function(self, acc, w)
	-- wings tucked and swept back, fingers closed, body streamlined
	wingsSpread(self, acc, w, 0.18, 0.05, 1, 0.85)
	sym(acc, "Wing%1", w, 0, rad(24), rad(-8))
	sym(acc, "Wing%2", w, 0, rad(-16), rad(4))
	sym(acc, "Wing%3", w, 0, rad(30), 0)
	tuckLegs(self, acc, w, 1)
	neck(self, acc, w, -0.45)
	add(acc, "Head", w, 0.42, 0, 0)
	tail(self, acc, w, -0.25)
end

States.Ascend = function(self, acc, w)
	local b = beat(self.Flap)
	local lag = beat(self.Flap - 0.1)
	wingsSpread(self, acc, w, b, lag, 0, 0)
	add(acc, "Body", w, 0.12, 0, 0, 0, -b * 0.22 * self.Scale, 0)
	tuckLegs(self, acc, w, 0.55)
	neck(self, acc, w, -0.1)
	add(acc, "Head", w, 0.1, 0, 0)
	tail(self, acc, w, 0.2)
end

States.Descend = function(self, acc, w)
	local b = beat(self.Flap) * 0.4 + 0.3
	wingsSpread(self, acc, w, b, b * 0.8, 0.1, 0)
	tuckLegs(self, acc, w, 0.25)
	if self.HasFront then
		sym(acc, "Arm%1", w, 0.3, 0, 0)
	end
	neck(self, acc, w, -0.15)
	add(acc, "Head", w, 0.2, 0, 0)
	tail(self, acc, w, 0.3)
end

States.Sleep = function(self, acc, w)
	local br = wave(self.Breath * 0.6)
	local s = self.Scale
	add(acc, "Body", w, 0, 0, 0, 0, -1.9 * s + br * 0.05 * s, 0)
	add(acc, "Chest", w, br * 0.015, 0, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, 1.3, 0, 0.1)
		sym(acc, "Arm%2", w, -1.5, 0, 0)
		sym(acc, "Hand%", w, 0.25, 0, 0)
	end
	if self.HasBack then
		sym(acc, "Leg%1", w, 1.05, 0, -0.08)
		sym(acc, "Leg%2", w, -1.1, 0, 0)
		sym(acc, "Foot%", w, 0.1, 0, 0)
	end
	-- head lowered and curled toward the tail
	neck(self, acc, w, -0.9, 0.95)
	add(acc, "Head", w, 0.55, 0.35, 0.15)
	tail(self, acc, w, 0.2, -0.95)
	wingsFolded(self, acc, w)
end

-- Lying down but awake (sanctuary perches): belly on the ground, forelegs
-- folded, head up and slowly looking around, tail curled beside the body.
States.Rest = function(self, acc, w)
	local br = wave(self.Breath)
	local s = self.Scale
	local t = self.Time
	add(acc, "Body", w, 0.03, 0, 0, 0, -1.8 * s + br * 0.04 * s, 0)
	add(acc, "Chest", w, 0.06 + br * 0.02, 0, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, 1.25, 0, 0.08)
		sym(acc, "Arm%2", w, -1.45, 0, 0)
		sym(acc, "Hand%", w, 0.3, 0, 0)
	end
	if self.HasBack then
		sym(acc, "Leg%1", w, 1.0, 0, -0.1)
		sym(acc, "Leg%2", w, -1.05, 0, 0)
		sym(acc, "Foot%", w, 0.12, 0, 0)
	end
	neck(self, acc, w, 0.1 + sin(t * 0.5) * 0.03, sin(t * 0.23) * 0.28)
	add(acc, "Head", w, -0.02 + sin(t * 0.7) * 0.04, sin(t * 0.31) * 0.22, 0)
	tail(self, acc, w, 0.22, -0.85, 0.035, t * 0.1)
	wingsFolded(self, acc, w)
	add(acc, "Jaw", w, 0.015 + max(0, br) * 0.015, 0, 0)
end

-- ============================================================== one-shots
local Shots = {}

Shots.Jump = function(self, acc, w, t)
	local crouch = t < 0.12 and t / 0.12 or max(0, 1 - (t - 0.12) / 0.1)
	add(acc, "Body", w, 0, 0, 0, 0, -crouch * 0.7 * self.Scale, 0)
	tuckLegs(self, acc, w, clamp((t - 0.15) / 0.2, 0, 1) * 0.5)
	local open = clamp(t / 0.25, 0, 1)
	wingsSpread(self, acc, w * open, 0.55, 0.45, 0.2, 0.2)
	wingsFolded(self, acc, w * (1 - open))
end

local function smooth(e0: number, e1: number, x: number): number
	local t = clamp((x - e0) / (e1 - e0), 0, 1)
	return t * t * (3 - 2 * t)
end

-- Takeoff flap curve: raise during the crouch, one powerful downstroke on
-- the leap, then continuous climbing beats (C0-continuous everywhere).
local function takeoffBeat(u: number): number
	if u < 0.18 then
		return 0.4 + 0.55 * smooth(0, 0.18, u)
	elseif u < 0.38 then
		return 0.95 - 1.9 * smooth(0.18, 0.38, u)
	end
	return beat(0.42 + (u - 0.38) * 2.3) * 0.95
end

Shots.Takeoff = function(self, acc, w, t, shot)
	-- crouch (0-0.18), leap + downstroke (0.18-0.38), climbing beats.
	-- Every term is a smooth curve of t, so there are no pose jumps.
	local s = self.Scale
	local crouch = smooth(0, 0.18, t) * (1 - smooth(0.18, 0.32, t))
	local lift = smooth(0.16, 0.36, t)
	local settle = smooth(0.38, 0.75, t)
	local startFold = shot and shot.StartFold or 1
	local open = 1 - startFold * (1 - smooth(0, 0.16, t))
	add(acc, "Body", w, -0.06 * crouch + 0.2 * lift * (1 - settle), 0, 0, 0, -0.9 * s * crouch, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, -0.35 * crouch, 0, 0)
		sym(acc, "Arm%2", w, 0.55 * crouch, 0, 0)
	end
	if self.HasBack then
		sym(acc, "Leg%1", w, 0.45 * crouch, 0, 0)
		sym(acc, "Leg%2", w, -0.55 * crouch, 0, 0)
		sym(acc, "Foot%", w, 0.3 * crouch, 0, 0)
	end
	tuckLegs(self, acc, w, 0.6 * lift)
	wingsSpread(self, acc, w * open, takeoffBeat(t), takeoffBeat(t - 0.05), 0, 0.25 * (1 - open))
	wingsFolded(self, acc, w * (1 - open))
	neck(self, acc, w, -0.3 * crouch + 0.05 * lift - 0.15 * settle)
	add(acc, "Head", w, 0.25 * crouch + 0.15 * lift, 0, 0)
end

Shots.Landing = function(self, acc, w, t)
	-- flare (wings spread, nose up), touchdown absorb, wings fold away
	local s = self.Scale
	local flare = 1 - smooth(0.06, 0.3, t)
	local absorb = sin(clamp((t - 0.06) / 0.45, 0, 1) * math.pi)
	local fold = smooth(0.12, 0.5, t)
	add(acc, "Body", w, 0.18 * flare - 0.03 * absorb, 0, 0, 0, -0.75 * s * absorb, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, 0.35 * flare - 0.3 * absorb, 0, 0)
		sym(acc, "Arm%2", w, 0.45 * absorb, 0, 0)
	end
	if self.HasBack then
		sym(acc, "Leg%1", w, 0.4 * absorb, 0, 0)
		sym(acc, "Leg%2", w, -0.5 * absorb, 0, 0)
		sym(acc, "Foot%", w, 0.15 * absorb, 0, 0)
	end
	wingsSpread(self, acc, w * (1 - fold), 0.8 * flare + 0.55 * (1 - flare), 0.6 * flare + 0.4 * (1 - flare), 0.25 * (1 - flare), 0.4 * (1 - flare))
	wingsFolded(self, acc, w * fold)
	neck(self, acc, w, -0.2 * absorb)
	add(acc, "Head", w, 0.15 * absorb, 0, 0)
end

Shots.Roar = function(self, acc, w, t)
	local rise = clamp(t / 0.35, 0, 1)
	local thrust = clamp((t - 0.35) / 0.25, 0, 1)
	local hold = (t > 0.6 and t < 1.35) and 1 or 0
	local shake = hold * sin(t * 70) * 0.025
	add(acc, "Chest", w, 0.12 * rise - 0.08 * thrust, 0, 0, 0, 0.12 * self.Scale * rise, 0)
	neck(self, acc, w, 0.55 * rise - 1.05 * thrust, shake * 3)
	add(acc, "Head", w, -0.25 * rise + 0.6 * thrust, 0, shake)
	add(acc, "Jaw", w, (0.12 * rise + 0.5 * thrust) * (t < 1.4 and 1 or 0), 0, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, -0.15 * rise + 0.15 * thrust, 0, 0)
	end
	local open = rise * 0.9
	wingsSpread(self, acc, w * open, 0.5 + shake * 4, 0.4, 0, 0)
	wingsFolded(self, acc, w * (1 - open))
	tail(self, acc, w, -0.2 * rise, 0, 0.05 * hold, t * 3)
end

-- Wind Dash: a streamlined lunge - body pitched forward, neck stretched, legs tucked,
-- wings swept back.
Shots.Dash = function(self, acc, w, t)
	local s = self.Scale
	local k = sin(clamp(t / 0.55, 0, 1) * math.pi)
	add(acc, "Body", w, -0.2 * k, 0, 0, 0, -0.25 * s * k, 0)
	neck(self, acc, w, -0.4 * k)
	add(acc, "Head", w, 0.25 * k, 0, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, -0.7 * k, 0, 0)
		sym(acc, "Arm%2", w, -0.5 * k, 0, 0)
	end
	tuckLegs(self, acc, w, 0.85 * k)
	wingsSpread(self, acc, w, 0.25 * k, 0.3, 0.3 * k, 0.3 * k)
	tail(self, acc, w, 0.3 * k, 0, 0.02, t * 8)
end

-- Fire Breath (held): a real wind-up. The dragon inhales (the head rears back and up, the chest
-- swells, the wings open), lunges forward with the jaw wide open and then holds the blast: the
-- chest pumps, the head trembles, the tail whips until Stop().
Shots.FireBreath = function(self, acc, w, t, shot)
	local s = self.Scale
	local rear = smooth(0, 0.24, t)
	local lunge = smooth(0.2, 0.42, t)
	local hold = shot and shot.HoldTime or 0
	local held = clamp(hold / 0.12, 0, 1)
	local pump = held * (0.5 + 0.5 * sin((t + hold) * 17))
	local shake = held * sin((t + hold) * 48) * 0.03
	-- body: swell while inhaling, recoil on the lunge, lean into the blast
	add(acc, "Chest", w, 0.22 * rear - 0.3 * lunge + pump * 0.05, 0, 0, 0, (0.22 * rear - 0.1 * lunge) * s, 0)
	add(acc, "Body", w, 0.1 * rear - 0.04 * lunge, shake, shake * 0.8, 0, (0.14 * rear - 0.12 * lunge) * s, 0)
	-- neck and head: rear back and up, then thrust forward
	neck(self, acc, w, 0.95 * rear - 1.55 * lunge, shake * 4)
	add(acc, "Head", w, 0.55 * rear - 0.4 * lunge + shake, 0, shake * 2)
	add(acc, "Jaw", w, 0.12 * rear + 0.65 * lunge + pump * 0.1, 0, 0)
	-- legs brace against the blast
	if self.HasFront then
		sym(acc, "Arm%1", w, -0.1 * rear + 0.32 * lunge, 0, 0)
		sym(acc, "Arm%2", w, -0.12 * lunge, 0, 0)
	end
	if self.HasBack then
		sym(acc, "Leg%1", w, -0.18 * lunge, 0, 0)
		sym(acc, "Foot%", w, 0.1 * lunge, 0, 0)
	end
	if self.Params.Mode == "Fly" or self.Params.Mode == "Air" then
		tuckLegs(self, acc, w, 0.5)
	end
	-- wings flare wide and tremble
	local open = smooth(0, 0.3, t)
	wingsSpread(self, acc, w * open, 0.6 + shake * 9 + pump * 0.1, 0.45, 0, 0)
	wingsFolded(self, acc, w * (1 - open))
	tail(self, acc, w, -0.3 * lunge, 0, 0.05 + 0.05 * held, t * 4 + hold * 4)
end

-- The quick combat clips do not move the wings: they hold the pose of the moment (folded on the
-- ground, half open in the air) so the wing animation of the state does not snap while they blend in.
local function keepWings(self, acc, w: number)
	local mode = self.Params.Mode
	if mode == "Fly" or mode == "Air" or mode == "Takeoff" then
		wingsSpread(self, acc, w, 0.3, 0.25, 0.1, 0.05)
	else
		wingsFolded(self, acc, w)
	end
end

-- Strike (arena): a quick bite and tail slam - the head snaps forward and the jaw closes on
-- the target while the body lunges and the tail whips round.
Shots.Strike = function(self, acc, w, t)
	local s = self.Scale
	local wind = smooth(0, 0.12, t) * (1 - smooth(0.12, 0.2, t))
	local snap = smooth(0.1, 0.22, t) * (1 - smooth(0.3, 0.55, t))
	local bite = sin(clamp((t - 0.16) / 0.22, 0, 1) * math.pi)
	local swing = sin(clamp((t - 0.08) / 0.4, 0, 1) * math.pi)
	add(acc, "Body", w, -0.12 * snap + 0.06 * wind, 0, 0, 0, -0.1 * s * snap, 0)
	add(acc, "Chest", w, 0.1 * wind - 0.18 * snap, 0, 0)
	neck(self, acc, w, 0.45 * wind - 1.2 * snap)
	add(acc, "Head", w, 0.3 * wind - 0.35 * snap, 0, 0)
	add(acc, "Jaw", w, 0.75 * bite, 0, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, -0.5 * snap, 0, 0)
		sym(acc, "Arm%2", w, -0.4 * snap, 0, 0)
	end
	local air = self.Params.Mode == "Fly" or self.Params.Mode == "Air"
	if air then
		tuckLegs(self, acc, w, 0.5)
	end
	keepWings(self, acc, w)
	tail(self, acc, w, 0.15 * swing, 0.7 * swing, 0.1 * swing, t * 8)
end

-- Cast (arena fireball): rear back and inhale, thrust the head forward and let it go.
Shots.Cast = function(self, acc, w, t)
	local s = self.Scale
	local rear = smooth(0, 0.2, t) * (1 - smooth(0.28, 0.36, t))
	local lunge = smooth(0.24, 0.38, t) * (1 - smooth(0.5, 0.85, t))
	add(acc, "Chest", w, 0.22 * rear - 0.28 * lunge, 0, 0, 0, (0.2 * rear - 0.08 * lunge) * s, 0)
	add(acc, "Body", w, 0.08 * rear - 0.04 * lunge, 0, 0, 0, (0.12 * rear - 0.1 * lunge) * s, 0)
	neck(self, acc, w, 0.9 * rear - 1.4 * lunge)
	add(acc, "Head", w, 0.5 * rear - 0.4 * lunge, 0, 0)
	add(acc, "Jaw", w, 0.12 * rear + 0.6 * lunge, 0, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, -0.1 * rear + 0.3 * lunge, 0, 0)
	end
	local air = self.Params.Mode == "Fly" or self.Params.Mode == "Air"
	if air then
		tuckLegs(self, acc, w, 0.5)
		keepWings(self, acc, w)
	else
		local open = smooth(0, 0.25, t) * (1 - smooth(0.6, 0.85, t))
		wingsSpread(self, acc, w * open, 0.55, 0.4, 0, 0)
		wingsFolded(self, acc, w * (1 - open))
	end
	tail(self, acc, w, -0.25 * lunge, 0, 0.06, t * 4)
end

-- Hurt (arena): the flinch of a dragon that was hit - head thrown back, body jolted, tail flicks.
Shots.Hurt = function(self, acc, w, t)
	local s = self.Scale
	local hit = smooth(0, 0.06, t) * (1 - smooth(0.08, 0.4, t))
	local shiver = sin(t * 40) * hit
	add(acc, "Body", w, 0.14 * hit, 0, shiver * 0.05, 0, 0.12 * s * hit, 0)
	add(acc, "Chest", w, 0.2 * hit, 0, 0)
	neck(self, acc, w, 0.55 * hit, shiver * 0.15)
	add(acc, "Head", w, -0.3 * hit, 0, 0)
	add(acc, "Jaw", w, 0.3 * hit, 0, 0)
	keepWings(self, acc, w)
	tail(self, acc, w, 0.1 * hit, 0, 0.3 * hit, t * 11)
end

-- Sky Dance (bond level 20): a full barrel roll with strong wing beats in the air, a
-- proud rear-up with a roar on the ground.
Shots.Flourish = function(self, acc, w, t)
	local mode = self.Params.Mode
	local air = mode == "Fly" or mode == "Air" or mode == "Takeoff"
	local s = self.Scale
	if air then
		local roll = (TAU * smooth(0.08, 1.35, t)) % TAU
		local arch = sin(clamp(t / 1.6, 0, 1) * math.pi)
		add(acc, "Body", w, 0.1 * arch, 0, roll)
		neck(self, acc, w, 0.35 * arch)
		add(acc, "Head", w, 0.2 * arch, 0, 0)
		add(acc, "Jaw", w, 0.25 * arch, 0, 0)
		tuckLegs(self, acc, w, 0.7)
		wingsSpread(self, acc, w, sin(t * 11) * 0.9, sin(t * 11 - 0.6) * 0.8, 0, 0)
		tail(self, acc, w, 0.1, 0, 0.12, t * 6)
	else
		local up = smooth(0, 0.4, t) * (1 - smooth(1.35, 1.8, t))
		local bellow = (t > 0.45 and t < 1.3) and 1 or 0
		local shake = bellow * sin(t * 60) * 0.02
		add(acc, "Body", w, 0.55 * up, 0, 0, 0, 0.6 * s * up, 0)
		add(acc, "Chest", w, 0.15 * up, 0, 0)
		neck(self, acc, w, 0.35 * up, shake * 3)
		add(acc, "Head", w, 0.15 * up, 0, shake)
		add(acc, "Jaw", w, 0.45 * bellow, 0, 0)
		if self.HasFront then
			sym(acc, "Arm%1", w, 0.95 * up, 0, 0)
			sym(acc, "Arm%2", w, 0.6 * up, 0, 0)
		end
		if self.HasBack then
			sym(acc, "Leg%1", w, -0.25 * up, 0, 0)
			sym(acc, "Leg%2", w, 0.2 * up, 0, 0)
		end
		wingsSpread(self, acc, w * up, 0.6 + sin(t * 7) * 0.35 * up, 0.5, 0.1, 0)
		wingsFolded(self, acc, w * (1 - up))
		tail(self, acc, w, -0.1 * up, 0, 0.12 * up, t * 4)
	end
end

Shots.Eat = function(self, acc, w, t)
	local down = clamp(t / 0.5, 0, 1) * clamp((2.4 - t) / 0.5, 0, 1)
	local chew = (t > 0.55 and t < 1.9) and max(0, sin(t * 14)) or 0
	neck(self, acc, w, -1.25 * down)
	add(acc, "Head", w, -0.15 * down - chew * 0.05, 0, 0)
	add(acc, "Jaw", w, chew * 0.32, 0, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, -0.15 * down, 0, 0)
	end
	wingsFolded(self, acc, w)
end

Shots.IdleVariant = function(self, acc, w, t)
	-- look around, then a wing stretch
	local a = clamp(t / 0.6, 0, 1) * clamp((2.6 - t) / 0.6, 0, 1)
	local look = sin(t * 2.2) * 0.45
	add(acc, "Head", w, 0.1 * a, look * a, 0)
	neck(self, acc, w, 0.15 * a, look * 0.6 * a)
	local stretch = clamp((t - 0.6) / 0.5, 0, 1) * clamp((2.0 - t) / 0.5, 0, 1)
	wingsFolded(self, acc, w * (1 - stretch * 0.8))
	wingsSpread(self, acc, w * stretch * 0.8, 0.7, 0.5, 0.25, 0.2)
end

-- ---------------------------------------------------------------------------------------
-- Everyday behaviour. Full turns are written modulo 2*pi so the envelope fading the clip out
-- never spins the body backwards.

-- Yawn: the head rears back, the jaw opens wide and trembles, the wings lift a little.
Shots.Yawn = function(self, acc, w, t)
	local up = smooth(0, 0.7, t) * (1 - smooth(2.0, 2.7, t))
	local open = smooth(0.5, 1.0, t) * (1 - smooth(1.9, 2.4, t))
	local shiver = open * sin(t * 26) * 0.015
	add(acc, "Chest", w, 0.12 * up, 0, 0, 0, 0.1 * self.Scale * up, 0)
	neck(self, acc, w, 0.5 * up, shiver * 3)
	add(acc, "Head", w, 0.45 * up + shiver, 0, 0)
	add(acc, "Jaw", w, 0.75 * open, 0, 0)
	local lift = smooth(0.4, 1.1, t) * (1 - smooth(1.9, 2.5, t))
	wingsFolded(self, acc, w * (1 - lift * 0.55))
	wingsSpread(self, acc, w * lift * 0.55, 0.4, 0.25, 0.3, 0.3)
end

-- Stretch: the "play bow" - chest down, rear up, tail high and wagging, wings opening wide.
Shots.Stretch = function(self, acc, w, t)
	local s = self.Scale
	local bow = smooth(0, 0.65, t) * (1 - smooth(2.0, 2.8, t))
	local open = smooth(0.6, 1.1, t) * (1 - smooth(1.9, 2.5, t))
	add(acc, "Body", w, -0.3 * bow, 0, 0, 0, -0.4 * s * bow, 0)
	add(acc, "Chest", w, -0.12 * bow, 0, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, 0.7 * bow, 0, 0)
		sym(acc, "Arm%2", w, -0.5 * bow, 0, 0)
		sym(acc, "Hand%", w, 0.25 * bow, 0, 0)
	end
	if self.HasBack then
		sym(acc, "Leg%1", w, -0.28 * bow, 0, 0)
		sym(acc, "Leg%2", w, 0.2 * bow, 0, 0)
	end
	neck(self, acc, w, 0.6 * bow)
	add(acc, "Head", w, 0.05 * bow, 0, 0)
	add(acc, "Jaw", w, 0.22 * open, 0, 0)
	tail(self, acc, w, -0.6 * bow, 0, 0.1 * bow, t * 5)
	wingsFolded(self, acc, w * (1 - open))
	wingsSpread(self, acc, w * open, 0.5 + sin(t * 5) * 0.12, 0.35, 0.05, 0.05)
end

-- TailSwish: a happy wag - the tail sweeps from side to side, the head follows it a little.
Shots.TailSwish = function(self, acc, w, t)
	local a = smooth(0, 0.35, t) * (1 - smooth(1.7, 2.2, t))
	local ph = t * 1.7
	local sw = sin(ph * TAU)
	tail(self, acc, w, -0.15 * a, 0, 0.14 * a, ph)
	add(acc, "Body", w, 0, -sw * 0.05 * a, 0)
	add(acc, "Chest", w, 0, sw * 0.04 * a, 0)
	neck(self, acc, w, 0.05 * a, -sw * 0.12 * a)
	add(acc, "Head", w, 0.06 * a, sw * 0.12 * a, 0)
	wingsFolded(self, acc, w)
end

-- Sniff: the head drops to the ground, sniffing in short pulls, nose sweeping left and right.
Shots.Sniff = function(self, acc, w, t)
	local s = self.Scale
	local down = smooth(0, 0.55, t) * (1 - smooth(2.0, 2.5, t))
	local pull = down * max(0, sin(t * 10))
	add(acc, "Body", w, -0.1 * down, 0, 0, 0, -0.18 * s * down, 0)
	neck(self, acc, w, -0.95 * down - pull * 0.05, sin(t * 2.6) * 0.4 * down)
	add(acc, "Head", w, -0.3 * down - pull * 0.08, 0, 0)
	add(acc, "Jaw", w, pull * 0.1, 0, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, 0.18 * down, 0, 0)
	end
	tail(self, acc, w, 0.1, 0, 0.08 * down, t * 2.5)
	wingsFolded(self, acc, w)
end

-- Shake: a quick shiver from nose to tail, like a dog coming out of the lake.
Shots.Shake = function(self, acc, w, t)
	local a = smooth(0, 0.15, t) * (1 - smooth(1.1, 1.5, t))
	local f = sin(t * 40)
	add(acc, "Body", w, 0, f * 0.07 * a, f * 0.04 * a)
	add(acc, "Chest", w, 0, -f * 0.1 * a, 0)
	neck(self, acc, w, 0, f * 0.14 * a)
	add(acc, "Head", w, 0.05 * a, f * 0.16 * a, 0)
	tail(self, acc, w, 0, 0, 0.2 * a, t * 6)
	local flutter = a * 0.8
	wingsFolded(self, acc, w * (1 - flutter))
	wingsSpread(self, acc, w * flutter, f * 0.35, f * 0.3, 0.45, 0.4)
end

-- Twirl: one graceful turn on the spot, the tail swinging out behind it.
Shots.Twirl = function(self, acc, w, t)
	local spin = (TAU * smooth(0.12, 1.5, t)) % TAU
	local k = sin(clamp(t / 1.6, 0, 1) * math.pi)
	add(acc, "Body", w, 0, spin, 0, 0, 0.1 * self.Scale * k, 0)
	add(acc, "Head", w, 0.1 * k, 0, 0)
	tail(self, acc, w, -0.1 * k, 0, 0.1 * k, t * 3)
	wingsFolded(self, acc, w * (1 - k * 0.5))
	wingsSpread(self, acc, w * k * 0.5, 0.45, 0.3, 0.15, 0.1)
end

-- Bow: a greeting - the forelegs bend, the head dips, a moment's pause, then up again.
Shots.Bow = function(self, acc, w, t)
	local s = self.Scale
	local dip = smooth(0, 0.55, t) * (1 - smooth(1.5, 2.1, t))
	add(acc, "Body", w, -0.1 * dip, 0, 0, 0, -0.55 * s * dip, 0)
	neck(self, acc, w, -0.55 * dip)
	add(acc, "Head", w, -0.15 * dip, 0, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, 0.45 * dip, 0, 0)
		sym(acc, "Arm%2", w, -0.95 * dip, 0, 0)
		sym(acc, "Hand%", w, 0.5 * dip, 0, 0)
	end
	tail(self, acc, w, -0.25 * dip, 0, 0.05 * dip, t * 2)
	wingsFolded(self, acc, w)
end

-- Howl: the head thrown back at the sky for a long call, wings half open and trembling.
Shots.Howl = function(self, acc, w, t)
	local s = self.Scale
	local up = smooth(0, 0.7, t) * (1 - smooth(2.5, 3.1, t))
	local call = smooth(0.6, 0.9, t) * (1 - smooth(2.4, 2.8, t))
	local shake = call * sin(t * 34) * 0.02
	add(acc, "Chest", w, 0.25 * up, 0, 0, 0, 0.16 * s * up, 0)
	neck(self, acc, w, 0.8 * up, shake * 3)
	add(acc, "Head", w, 0.5 * up + shake, 0, 0)
	add(acc, "Jaw", w, 0.5 * call, 0, 0)
	if self.HasFront then
		sym(acc, "Arm%1", w, -0.1 * up, 0, 0)
	end
	local open = smooth(0.2, 0.9, t) * (1 - smooth(2.4, 3.0, t))
	wingsFolded(self, acc, w * (1 - open * 0.7))
	wingsSpread(self, acc, w * open * 0.7, 0.55 + shake * 6, 0.4, 0.15, 0.1)
	tail(self, acc, w, -0.12 * up, 0, 0.03 * call, t * 3)
end

-- Cheer: a happy hop - crouch, spring up with the wings beating, mouth open, tail high.
Shots.Cheer = function(self, acc, w, t)
	local s = self.Scale
	local crouch = smooth(0, 0.16, t) * (1 - smooth(0.16, 0.3, t))
	local air = sin(clamp((t - 0.18) / 0.8, 0, 1) * math.pi)
	add(acc, "Body", w, -0.08 * crouch + 0.2 * air, 0, 0, 0, -0.6 * s * crouch + 1.0 * s * air, 0)
	tuckLegs(self, acc, w, 0.55 * air)
	neck(self, acc, w, 0.35 * air)
	add(acc, "Head", w, 0.35 * air, 0, 0)
	add(acc, "Jaw", w, 0.45 * air, 0, 0)
	local open = smooth(0.12, 0.35, t) * (1 - smooth(1.1, 1.4, t))
	wingsSpread(self, acc, w * open, beat(t * 1.8) * 0.9, beat(t * 1.8 - 0.1) * 0.9, 0.1, 0.1)
	wingsFolded(self, acc, w * (1 - open))
	tail(self, acc, w, -0.3 * air, 0, 0.14 * air, t * 4)
end

-- Loop: a somersault in the air (nose up, over the top), legs tucked, wings swept back.
Shots.Loop = function(self, acc, w, t)
	local turn = (TAU * smooth(0.15, 1.65, t)) % TAU
	local k = sin(clamp((t - 0.1) / 1.7, 0, 1) * math.pi)
	add(acc, "Body", w, turn, 0, 0)
	neck(self, acc, w, -0.3 * k)
	tuckLegs(self, acc, w, 0.8 * k)
	wingsSpread(self, acc, w, 0.1, 0.1, 0.55 * k, 0.4 * k)
	tail(self, acc, w, 0.2 * k, 0, 0.04, t * 5)
end

-- ============================================================== update
local function spring(state, target: number, freq: number, damping: number, dt: number)
	-- semi-implicit damped spring with fixed substeps (frame-rate independent)
	local steps = math.max(1, math.ceil(dt / (1 / 120)))
	local h = dt / steps
	local w = TAU * freq
	for _ = 1, steps do
		local a = -w * w * (state[1] - target) - 2 * damping * w * state[2]
		state[2] += a * h
		state[1] += state[2] * h
	end
	return state[1]
end

function Animator:Update(dt: number)
	if self.Paused then
		return
	end
	dt = math.min(dt, 0.1)
	local p = self.Params
	self.Time += dt
	self.Breath = (self.Breath + dt * 0.28) % 1

	-- state weights (exponential crossfade, normalized)
	local target = chooseTarget(p)
	self.Target = target
	local blendRate = (target == "Dive" or target == "FastFly") and 5 or 7
	local a = 1 - exp(-blendRate * dt)
	local total = 0
	for _, s in BASE_STATES do
		local tw = (s == target) and 1 or 0
		local w = self.Weights[s] + (tw - self.Weights[s]) * a
		if w < 0.002 then
			w = 0
		end
		self.Weights[s] = w
		total += w
	end

	-- gait phase (stride length scales with the dragon)
	if p.Mode == "Ground" then
		local running = p.Speed > (p.WalkSpeed + p.RunSpeed) * 0.5
		local strideLen = (running and 21 or 9.5) * self.Scale
		local freq = clamp(p.Speed / strideLen, 0.35, 3.4)
		local prev = self.Gait
		self.Gait = (self.Gait + dt * freq) % 1
		if self.OnFootstep and p.Speed > 1 then
			if self.Gait < prev then
				self.OnFootstep("L")
			elseif prev < 0.5 and self.Gait >= 0.5 then
				self.OnFootstep("R")
			end
		end
	end
	-- flap phase
	local flapFreq
	if target == "Hover" or target == "Ascend" then
		flapFreq = 1.9
	elseif target == "Fly" then
		flapFreq = 1.2 + clamp(p.Speed / 250, 0, 0.5)
	elseif target == "FastFly" then
		flapFreq = 2.4
	elseif target == "Descend" then
		flapFreq = 1.0
	else
		flapFreq = 1.4
	end
	if self:IsPlaying("Takeoff") then
		flapFreq = 2.3
	end
	flapFreq /= math.sqrt(self.Scale)
	local prevFlap = self.Flap
	self.Flap = (self.Flap + dt * flapFreq) % 1
	if self.OnFlap and p.Mode == "Fly" and target ~= "Dive" and target ~= "FastFly" then
		-- fire at the start of each downstroke
		if self.Flap < prevFlap then
			self.OnFlap()
		end
	end

	-- clear accumulators
	local acc = self.Acc
	for _, v in acc do
		v[1], v[2], v[3], v[4], v[5], v[6] = 0, 0, 0, 0, 0, 0
	end
	self.FoldW, self.SpreadW = 0, 0

	-- base layer
	if total > 0 then
		for _, s in BASE_STATES do
			local w = self.Weights[s]
			if w > 0 then
				States[s](self, acc, w / total)
			end
		end
	end

	-- one-shots override proportionally to their envelope
	for i = #self.Shots, 1, -1 do
		local shot = self.Shots[i]
		local def = shot.Def
		local advance = dt * shot.Speed
		if def.Hold and not shot.Released and shot.T + advance >= def.Hold then
			-- held clip (fire breath): sustain until Stop() or MaxHold
			shot.T = def.Hold
			shot.HoldTime = (shot.HoldTime or 0) + dt
			if shot.HoldTime >= (def.MaxHold or 4) then
				shot.Released = true
			end
		else
			shot.T += advance
		end
		if shot.T >= def.Duration then
			table.remove(self.Shots, i)
		else
			local env = clamp(shot.T / def.FadeIn, 0, 1) * clamp((def.Duration - shot.T) / def.FadeOut, 0, 1)
			env = env * env * (3 - 2 * env)
			if env > 0 then
				for _, v in acc do
					for k = 1, 6 do
						v[k] *= (1 - env)
					end
				end
				self.FoldW *= (1 - env)
				self.SpreadW *= (1 - env)
				Shots[shot.Name](self, acc, env, shot.T, shot)
			end
		end
	end

	self.LastFoldW = clamp(self.FoldW, 0, 1)

	-- additive: banking (outer wing lowers, inner rises)
	self.BankSmoothed += (p.Bank - self.BankSmoothed) * (1 - exp(-6 * dt))
	local bank = self.BankSmoothed
	self.WingBank = (self.HasWings and (p.Mode == "Fly" or p.Mode == "Air")) and bank or 0
	-- tail: lags behind turns with a little overshoot; follows vertical speed
	local tailTarget = -clamp(p.TurnRate, -2.5, 2.5) * (p.Mode == "Ground" and 0.12 or 0.09)
	local tailVal = spring(self.TailSpring, tailTarget, 1.6, 0.45, dt)
	local tailPitchTarget = clamp(p.Vertical / 60, -0.6, 0.6) * 0.18
	local tailPitch = spring(self.TailPitch, tailPitchTarget, 1.4, 0.5, dt)
	local nT = #self.Tail
	for i, j in self.Tail do
		local k = i / nT
		add(acc, j, 1, tailPitch * (0.5 + k), tailVal * (0.6 + k * 0.9), 0)
	end
	-- neck/head lead into turns and toward the requested look direction
	local neckTarget = clamp(p.TurnRate, -2.5, 2.5) * 0.08 + (p.Look and p.Look.X or 0) * 0.6
	local neckVal = spring(self.NeckSpring, neckTarget, 2.2, 0.8, dt)
	local nN = math.max(1, #self.Neck)
	for _, j in self.Neck do
		add(acc, j, 1, 0, neckVal / nN, 0)
	end
	add(acc, "Head", 1, (p.Look and p.Look.Y or 0) * 0.4, neckVal * 0.5, 0)
end

-- Computes transforms from the accumulators (no instance writes).
function Animator:_buildTransforms()
	local CFnew, CFangles = CFrame.new, CFrame.Angles
	local T = self.Transforms
	local acc = self.Acc
	for name, v in acc do
		T[name] = CFnew(v[4], v[5], v[6]) * CFangles(v[1], v[2], v[3])
	end
	if self.HasWings then
		-- wings: normalized spread pose, banked, then blended toward the fold
		-- in rotation-vector space (continuous even for ~180 degree folds,
		-- where a shortest-path slerp would flip sides)
		local fw = clamp(self.FoldW, 0, 1)
		local sw = self.SpreadW
		local inv = sw > 1e-4 and 1 / sw or 0
		local bank = self.WingBank
		local foldRV = self.FoldRV
		for _, name in WING_JOINTS do
			local v = acc[name]
			if v then
				local bz = 0
				if bank ~= 0 then
					-- inner wing rises, outer wing lowers (same sign on both sides
					-- because the right side's roll axis is mirrored)
					local seg = string.sub(name, -1)
					bz = seg == "1" and bank * 0.3 or (seg == "2" and bank * 0.1 or 0)
				end
				local spread = CFangles(v[1] * inv, v[2] * inv, v[3] * inv + bz)
				if fw > 0.999 and foldRV then
					T[name] = self.FoldCF[name]
				elseif fw > 0.001 and foldRV then
					T[name] = fromRotVec(rotVec(spread) * (1 - fw) + foldRV[name] * fw)
				else
					T[name] = spread
				end
			end
		end
	end
	return T
end

-- Forward kinematics in Root space for the current transforms.
function Animator:_forwardKinematics()
	local T = self.Transforms
	local out = self.BoneCF
	for _, j in self.Chain do
		local pcf = out[j.Parent]
		if pcf then
			out[j.Name] = pcf * j.C0 * (T[j.Name] or CFrame.identity) * j.C1inv
		end
	end
	return out
end

-- Cheap signature of the wing pose; membranes only re-solve when it moves.
function Animator:_wingSignature(): number
	local s = self.FoldW * 5.3 + self.SpreadW * 1.7 + self.WingBank * 2.9
	for i, name in { "WingL1", "WingL2", "WingL3", "WingR1", "WingR2", "WingR3", "Body", "Chest", "WingL4", "WingL5" } do
		local v = self.Acc[name]
		if v then
			s += (v[1] * 1.3 + v[2] * 2.1 + v[3] * 3.7 + v[5] * 0.7) * i
		end
	end
	return s
end

-- Writes the pose to the Motor6Ds and re-stretches the membranes.
-- membranes: false skips the membrane solve (LOD).
function Animator:Apply(membranes: boolean?)
	local T = self:_buildTransforms()
	for name, motor in self.Motors do
		local tr = T[name]
		if tr then
			motor.Transform = tr
		end
	end
	if self.MembranesEnabled and membranes ~= false then
		local sig = self:_wingSignature()
		if self.LastWingSig == nil or math.abs(sig - self.LastWingSig) > 1e-4 then
			self.LastWingSig = sig
			self.Membranes:Solve(self:_forwardKinematics())
		end
	end
end

-- Fills the accumulators with a single state/shot at time t (previews).
function Animator:Sample(state: string, t: number?)
	local acc = self.Acc
	for _, v in acc do
		v[1], v[2], v[3], v[4], v[5], v[6] = 0, 0, 0, 0, 0, 0
	end
	self.Time = t or 0
	self.Flap = (t or 0) % 1
	self.Gait = (t or 0) % 1
	self.Breath = 0
	self.FoldW, self.SpreadW, self.WingBank = 0, 0, 0
	if States[state] then
		States[state](self, acc, 1)
	elseif Shots[state] then
		Shots[state](self, acc, 1, t or 0)
	end
	self.LastWingSig = nil
end

-- Static pose sample: returns { [joint] = CFrame } (for Builder.pose).
function Animator.samplePose(model: Model, state: string, t: number?, params: { [string]: any }?)
	local anim = Animator.new(model)
	if params then
		anim:SetParams(params)
	end
	anim:Sample(state, t)
	local out = {}
	for name, tr in anim:_buildTransforms() do
		out[name] = tr
	end
	return out
end

return Animator
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000007">
					<Properties>
						<string name="Name">BreathFX</string>
						<ProtectedString name="Source"><![CDATA[--[[
	BreathFX
	Fire breath visuals for a dragon model (everybody sees them: BondController
	starts/stops them from the model's "Breathing" attribute, the owner starts
	them instantly on key press).

	The flames shoot out of the model's "Mouth" attachment (made by BrickBuilder
	on the jaw): a bright core, sparks, a smoke trail and a flickering light. The
	colours follow the dragon's mutation (frost breath, toxic breath, hellfire,
	lightning, holy light, rainbow...), see THEMES.

	The breath has a wind-up that matches the Animator's FireBreath (the dragon inhales for
	~0.2 s): a glowing ball gathers at the mouth, then it pops and the flames burst out.

	BreathFX.start(model, scale?) / BreathFX.stop(model) / BreathFX.isOn(model)
]]

local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local BreathFX = {}

local TEX = {
	Fire = "rbxasset://textures/particles/fire_main.dds",
	Smoke = "rbxasset://textures/particles/smoke_main.dds",
	Sparkle = "rbxasset://textures/particles/sparkles_main.dds",
}

local WINDUP = 0.2 -- seconds of inhaling before the flames come out

local active: { [Model]: { Folder: Instance, Light: PointLight?, Conn: RBXScriptConnection? } } = {}

-- Breath colours: Flame = core / middle / edge, Sparks = from / to, Smoke, Light.
local C3 = Color3.fromRGB
local function theme(core, mid, edge, spark1, spark2, smoke, light)
	return { Core = core, Mid = mid, Edge = edge, Spark1 = spark1, Spark2 = spark2, Smoke = smoke, Light = light }
end
local FIRE = theme(C3(255, 244, 190), C3(255, 170, 50), C3(220, 50, 20), C3(255, 220, 120), C3(255, 120, 40), C3(70, 56, 52), C3(255, 150, 60))
local HELL = theme(C3(255, 230, 160), C3(255, 100, 20), C3(140, 10, 10), C3(255, 190, 80), C3(255, 60, 20), C3(36, 18, 18), C3(255, 90, 30))
local ICE = theme(C3(240, 252, 255), C3(140, 210, 255), C3(60, 120, 230), C3(210, 240, 255), C3(120, 190, 255), C3(190, 210, 230), C3(150, 210, 255))
local VENOM = theme(C3(235, 255, 175), C3(130, 255, 60), C3(40, 140, 30), C3(200, 255, 120), C3(90, 220, 40), C3(40, 90, 30), C3(140, 255, 70))
local DARK = theme(C3(240, 205, 255), C3(150, 60, 255), C3(50, 10, 110), C3(220, 160, 255), C3(110, 40, 200), C3(28, 10, 48), C3(170, 90, 255))
local NEON = theme(C3(255, 255, 255), C3(80, 255, 230), C3(255, 70, 210), C3(150, 255, 240), C3(255, 110, 225), C3(70, 40, 110), C3(100, 255, 230))
local BOLT = theme(C3(255, 255, 255), C3(255, 240, 90), C3(90, 140, 255), C3(255, 250, 170), C3(130, 190, 255), C3(70, 80, 120), C3(255, 240, 120))
local HOLY = theme(C3(255, 255, 255), C3(255, 232, 150), C3(255, 190, 60), C3(255, 250, 215), C3(255, 215, 110), C3(235, 235, 245), C3(255, 235, 170))
local PRISM = theme(C3(255, 255, 255), C3(200, 160, 255), C3(110, 255, 225), C3(235, 215, 255), C3(140, 255, 235), C3(150, 130, 190), C3(200, 170, 255))
local RAINBOW = theme(C3(255, 255, 255), C3(255, 120, 200), C3(80, 200, 255), C3(255, 235, 140), C3(180, 120, 255), C3(110, 90, 140), C3(255, 170, 230))
BreathFX.Themes = {
	None = FIRE, Shiny = HOLY, Neon = NEON, Golden = HOLY, Frost = ICE, Toxic = VENOM, Lava = HELL, Infernal = HELL,
	Shadow = DARK, Corrupted = DARK, Diamond = PRISM, Crystal = PRISM, Lightning = BOLT, Angelic = HOLY,
	Galaxy = DARK, Rainbow = RAINBOW, Void = DARK, Omni = RAINBOW,
}

local function seq(points: { { number } }): NumberSequence
	local kps = {}
	for _, p in points do
		table.insert(kps, NumberSequenceKeypoint.new(p[1], p[2]))
	end
	return NumberSequence.new(kps)
end

local function mouthOf(model: Model): Instance?
	local visual = model:FindFirstChild("Visual")
	return visual and visual:FindFirstChild("Mouth", true) or model:FindFirstChild("Mouth", true)
end

function BreathFX.isOn(model: Model): boolean
	return active[model] ~= nil
end

function BreathFX.start(model: Model, scale: number?)
	if active[model] then
		return
	end
	local mouth = mouthOf(model)
	if not mouth then
		return
	end
	local S = scale or model:GetAttribute("Scale") or 1
	local th = BreathFX.Themes[model:GetAttribute("Mutation") or "None"] or FIRE
	local folder = Instance.new("Folder")
	folder.Name = "BreathFX"
	folder.Parent = mouth

	local function emitter(name: string, props: { [string]: any })
		local e = Instance.new("ParticleEmitter")
		e.Name = name
		e.Enabled = false -- switched on when the wind-up is over
		e.EmissionDirection = Enum.NormalId.Front
		e.LightInfluence = 0
		e.Rotation = NumberRange.new(0, 360)
		e.RotSpeed = NumberRange.new(-90, 90)
		for k, v in props do
			(e :: any)[k] = v
		end
		e.Parent = folder
		CollectionService:AddTag(e, "FX")
		return e
	end

	emitter("Flame", {
		Texture = TEX.Fire,
		Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, th.Core),
			ColorSequenceKeypoint.new(0.35, th.Mid),
			ColorSequenceKeypoint.new(1, th.Edge),
		}),
		LightEmission = 1,
		Rate = 110,
		Lifetime = NumberRange.new(0.5, 0.8),
		Speed = NumberRange.new(55 * S, 75 * S),
		SpreadAngle = Vector2.new(9, 9),
		Acceleration = Vector3.new(0, 5, 0),
		Size = seq({ { 0, 1.4 * S }, { 0.5, 4.5 * S }, { 1, 7.5 * S } }),
		Transparency = seq({ { 0, 0.1 }, { 0.7, 0.35 }, { 1, 1 } }),
	})
	emitter("Sparks", {
		Texture = TEX.Sparkle,
		Color = ColorSequence.new(th.Spark1, th.Spark2),
		LightEmission = 1,
		Rate = 45,
		Lifetime = NumberRange.new(0.6, 1.1),
		Speed = NumberRange.new(70 * S, 100 * S),
		SpreadAngle = Vector2.new(16, 16),
		Acceleration = Vector3.new(0, -14, 0),
		Size = seq({ { 0, 0.9 * S }, { 1, 0 } }),
	})
	emitter("Smoke", {
		Texture = TEX.Smoke,
		Color = ColorSequence.new(th.Smoke),
		LightEmission = 0,
		Rate = 22,
		Lifetime = NumberRange.new(1.0, 1.6),
		Speed = NumberRange.new(30 * S, 45 * S),
		SpreadAngle = Vector2.new(14, 14),
		Acceleration = Vector3.new(0, 7, 0),
		Size = seq({ { 0, 2 * S }, { 1, 7 * S } }),
		Transparency = seq({ { 0, 0.5 }, { 1, 1 } }),
	})

	local light = Instance.new("PointLight")
	light.Name = "BreathLight"
	light.Color = th.Light
	light.Range = 26 * math.max(1, S * 0.6)
	light.Brightness = 2.2
	light.Shadows = false
	local host = mouth.Parent
	light.Parent = host and host:IsA("BasePart") and host or folder.Parent
	light.Enabled = false
	local entry = { Folder = folder, Light = light, Conn = nil }
	entry.Conn = RunService.Heartbeat:Connect(function()
		if light.Parent then
			light.Brightness = 2 + math.sin(os.clock() * 37) * 0.6 + math.random() * 0.4
		end
	end)
	active[model] = entry
	-- wind-up: a glowing ball gathers at the mouth (follows the jaw), then the flames burst out
	local ball: Part? = nil
	if host and host:IsA("BasePart") and mouth:IsA("Attachment") then
		ball = Instance.new("Part")
		local b = ball :: Part
		b.Name = "BreathCharge"
		b.Shape = Enum.PartType.Ball
		b.Material = Enum.Material.Neon
		b.Color = th.Core
		b.Size = Vector3.one * 0.3 * S
		b.Transparency = 0.15
		b.CanCollide = false
		b.CanQuery = false
		b.CanTouch = false
		b.CastShadow = false
		b.Massless = true
		b.CFrame = CFrame.new(mouth.WorldPosition)
		b.Parent = folder
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = host
		weld.Part1 = b
		weld.Parent = b
		TweenService:Create(b, TweenInfo.new(WINDUP, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
			Size = Vector3.one * 3.2 * S,
			Transparency = 0.35,
		}):Play()
		light.Enabled = true
		light.Brightness = 3
	end
	task.delay(WINDUP, function()
		if active[model] ~= entry then
			if ball then
				ball:Destroy()
			end
			return
		end
		light.Enabled = true
		for _, d in folder:GetChildren() do
			if d:IsA("ParticleEmitter") then
				d.Enabled = true
				if d.Name == "Flame" then
					d:Emit(16)
				end
			end
		end
		if ball then
			local b = ball :: Part
			local pop = TweenService:Create(b, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Size = Vector3.one * 6 * S,
				Transparency = 1,
			})
			pop:Play()
			task.delay(0.25, function()
				b:Destroy()
			end)
		end
	end)
	model.AncestryChanged:Once(function(_, parent)
		if parent == nil then
			BreathFX.stop(model)
		end
	end)
end

function BreathFX.stop(model: Model)
	local entry = active[model]
	if not entry then
		return
	end
	active[model] = nil
	if entry.Conn then
		entry.Conn:Disconnect()
	end
	for _, d in entry.Folder:GetChildren() do
		if d:IsA("ParticleEmitter") then
			d.Enabled = false
		end
	end
	if entry.Light then
		entry.Light:Destroy()
	end
	task.delay(1.8, function()
		entry.Folder:Destroy()
	end)
end

return BreathFX
]]></ProtectedString>
					</Properties>
				</Item>
				<Item class="ModuleScript" referent="RBX000008">
					<Properties>
						<string name="Name">BrickBuilder</string>
						<ProtectedString name="Source"><![CDATA[--[[
	BrickBuilder
	Toy-brick dragons: chunky bricks, slopes, round bricks, studs, printed
	eyes and glossy plastic colours, built directly from Roblox parts (no
	imported assets). Uses exactly the same Motor6D skeleton, pivots and
	attachments as Builder (Body, Chest, Pelvis, Neck1..n, Head, Jaw,
	Tail1..n, Arm/Hand, Leg/Foot, Wing1..5 + membrane anchors), so the
	procedural Animator, riding, Builder.mountInfo / pose / freeze all work
	unchanged.

	build(speciesId, { Mutation, Detail = "High"|"Medium"|"Low", Root, ScaleOverride,
	                   Statue, Saddle = false }) -> Model

	Geometry is authored in species units (Species def, scale 1) and
	multiplied by the species Scale like Builder; brick dimensions are rounded
	to whole studs where they show on top so the toy look stays crisp.
]]

local Primitives = require(script.Parent:WaitForChild("Primitives"))
local Species = require(script.Parent:WaitForChild("Species"))
local Membranes = require(script.Parent:WaitForChild("Membranes"))

local BrickBuilder = {}

local V3 = Vector3.new
local CF = CFrame.new
local rad = math.rad

local PLASTIC = Enum.Material.SmoothPlastic

-- ============================================================== context
local Ctx = {}
Ctx.__index = Ctx

local function newCtx(def, opts)
	local self = setmetatable({}, Ctx)
	self.Def = def
	self.S = (def.Scale or 1) * (opts.ScaleOverride or 1)
	self.ScaleOverride = opts.ScaleOverride or 1
	self.SpeciesId = opts.SpeciesId or "GreenDrake"
	self.Detail = opts.Detail or "High"
	self.Statue = opts.Statue == true
	self.BondAura = opts.BondAura == true
	self.Palette = def.Palette
	self.Brick = def.Brick or {}
	self.Model = Instance.new("Model")
	self.Bones = {}
	self.Build = {}
	self.PartCount = 0
	self.Features = {}
	for _, f in def.Features or {} do
		self.Features[f] = true
	end
	return self
end

function Ctx:v(x: number, y: number, z: number): Vector3
	return V3(x * self.S, y * self.S, z * self.S)
end

function Ctx:sc(v: Vector3): Vector3
	return v * self.S
end

function Ctx:color(key: string | Color3): Color3
	if typeof(key) == "Color3" then
		return key
	end
	return self.Palette[key] or self.Palette.Main
end

function Ctx:detail(minLevel: string): boolean
	local order = { Low = 1, Medium = 2, High = 3 }
	return order[self.Detail] >= order[minLevel]
end

function Ctx:add(part: BasePart, name: string?): BasePart
	part.Name = name or part.Name
	if self.Build[part] == nil then
		self.Build[part] = part.CFrame
	end
	part.Parent = self.Model
	self.PartCount += 1
	return part
end

function Ctx:bone(name: string, part: BasePart, parentName: string, pivot: Vector3)
	self:add(part, name)
	self.Bones[name] = part
	local parent = self.Bones[parentName]
	assert(parent, "missing parent bone " .. parentName)
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = parent
	m.Part1 = part
	local pivotCF = CFrame.new(pivot)
	m.C0 = self.Build[parent]:ToObjectSpace(pivotCF)
	m.C1 = self.Build[part]:ToObjectSpace(pivotCF)
	m.Parent = part
	return part
end

function Ctx:deco(boneName: string, part: BasePart, name: string?): BasePart
	self:add(part, name or "Deco")
	local bone = self.Bones[boneName]
	local w = Instance.new("Weld")
	w.Name = "Weld"
	w.Part0 = bone
	w.Part1 = part
	w.C0 = self.Build[bone]:ToObjectSpace(self.Build[part])
	w.Parent = part
	return part
end

function Ctx:attach(boneName: string, name: string, worldPos: Vector3)
	local bone = self.Bones[boneName]
	local a = Instance.new("Attachment")
	a.Name = name
	a.CFrame = self.Build[bone]:ToObjectSpace(CFrame.new(worldPos))
	a.Parent = bone
	return a
end

-- ============================================================== brick factories
local function plastic(p: BasePart)
	p.Material = PLASTIC
	p.Reflectance = 0.02
	return p
end

-- Rounds a size to whole studs on the visible top (x, z) when it is big
-- enough to read as a brick; keeps small accents exact.
local function studRound(n: number): number
	if n < 1.4 then
		return n
	end
	return math.max(1, math.floor(n + 0.5))
end

local function brick(size: Vector3, cf: CFrame, color: Color3): BasePart
	return plastic(Primitives.block(size, cf, color))
end

-- Wedge whose slope faces `outward` (any horizontal-ish direction in the
-- frame given by `up`): full height on the inner side, zero at the outer edge.
local function slope(center: Vector3, outward: Vector3, up: Vector3, length: number, height: number, depth: number, color: Color3): BasePart
	local z = -outward.Unit
	local x = up:Cross(z).Unit
	local y = z:Cross(x).Unit
	return plastic(Primitives.wedge(V3(length, height, depth), CFrame.fromMatrix(center, x, y, z), color))
end

-- Round brick / cylinder whose axis is `axis`.
local function round(center: Vector3, axis: Vector3, length: number, diameter: number, color: Color3, material: Enum.Material?): BasePart
	local a = axis.Unit
	local helper = math.abs(a:Dot(Vector3.yAxis)) > 0.95 and Vector3.xAxis or Vector3.yAxis
	local y = helper:Cross(a).Unit
	local z = a:Cross(y).Unit
	local p = Primitives.block(V3(length, diameter, diameter), CFrame.fromMatrix(center, a, y, z), color, material)
	;(p :: Part).Shape = Enum.PartType.Cylinder
	if not material then
		plastic(p)
	end
	return p
end

-- Cone made of stacked round bricks (a toy "cone" / horn piece).
local function coneStack(c, boneName: string, a: Vector3, b: Vector3, d0: number, d1: number, color: Color3, steps: number, name: string)
	local dir = b - a
	for i = 0, steps - 1 do
		local t0, t1 = i / steps, (i + 1) / steps
		local p0, p1 = a + dir * t0, a + dir * t1
		local d = d0 + (d1 - d0) * (t0 + t1) * 0.5
		c:deco(boneName, round((p0 + p1) / 2, dir, (p1 - p0).Magnitude * 1.04, d, color), name)
	end
end

-- Grid of studs on a top face. frame: CFrame whose Y is the face normal,
-- centred on the face; nx x nz studs at `pitch` spacing.
local function studs(c, boneName: string, frame: CFrame, nx: number, nz: number, pitch: number, color: Color3)
	if not c:detail("High") then
		return
	end
	local d = pitch * 0.62
	local h = pitch * 0.2
	for ix = 0, nx - 1 do
		for iz = 0, nz - 1 do
			local x = (ix - (nx - 1) / 2) * pitch
			local z = (iz - (nz - 1) / 2) * pitch
			local p = frame * CF(x, h / 2, z)
			c:deco(boneName, round(p.Position, frame.UpVector, h, d, color), "Stud")
		end
	end
end

-- Printed toy eye: white disc, coloured iris, black pupil, white glint.
local function printedEye(c, boneName: string, center: Vector3, normal: Vector3, up: Vector3, d: number, iris: Color3, pupil: Color3)
	local n = normal.Unit
	local layer = d * 0.08
	c:deco(boneName, round(center, n, layer * 2, d, Color3.fromRGB(250, 250, 248)), "Eye")
	local r = up - n * up:Dot(n)
	r = r.Magnitude > 1e-3 and r.Unit or Vector3.yAxis
	c:deco(boneName, round(center + n * layer * 1.2, n, layer, d * 0.72, iris), "Iris")
	if c:detail("Medium") then
		c:deco(boneName, round(center + n * layer * 1.9 - r * d * 0.02, n, layer, d * 0.4, pupil), "Pupil")
		c:deco(boneName, round(center + n * layer * 2.5 + r * d * 0.17 + n:Cross(r) * d * 0.1, n, layer, d * 0.16, Color3.new(1, 1, 1)), "Glint")
	end
end

-- Frame along a segment a->b (forward = toward b) with a stable up.
local function segFrame(a: Vector3, b: Vector3, upHint: Vector3?): CFrame
	local f = (b - a).Unit
	local up = upHint or Vector3.yAxis
	if math.abs(f:Dot(up)) > 0.97 then
		up = Vector3.zAxis
	end
	return CFrame.lookAt((a + b) / 2, b, up)
end

-- ============================================================== torso
local function buildTorso(c)
	local d = c.Def.Body
	local L, W, H = d.Length, d.Width, d.Height
	local cs, hs = d.ChestScale or 1.05, d.HipScale or 0.9
	local S = c.S
	local main, dark, belly, accent = c:color("Main"), c:color("Dark"), c:color("Belly"), c:color("Accent")
	-- body core (pivot as Builder)
	local bw, bh, bl = studRound(W * S), H * 0.86 * S, studRound(L * 0.62 * S)
	local bodyC = c:v(0, 0.05, 0.4)
	c:bone("Body", brick(V3(bw, bh, bl), CF(bodyC), main), "Root", c:v(0, 0.1, 0.4))
	-- chest block (wider, front of the body)
	local cw, ch, cl = studRound(W * cs * S), H * cs * 0.9 * S, studRound(L * 0.42 * S)
	local chestC = c:v(0, 0.25, -L * 0.36)
	c:bone("Chest", brick(V3(cw, ch, cl), CF(chestC), main), "Body", c:v(0, 0.3, -L * 0.2))
	-- pelvis block (narrower, back)
	local pw, ph, pl = studRound(W * hs * S), H * hs * 0.88 * S, studRound(L * 0.36 * S)
	local pelC = c:v(0, 0.15, L * 0.43)
	c:bone("Pelvis", brick(V3(pw, ph, pl), CF(pelC), main), "Body", c:v(0, 0.2, L * 0.3))
	-- roof slopes along the back edges (rounded toy silhouette)
	local function roof(bone: string, center: Vector3, w: number, h: number, l: number)
		local sw = math.max(0.8 * S, w * 0.3)
		local sh = h * 0.28
		for _, side in { -1, 1 } do
			c:deco(bone, slope(center + V3(side * (w / 2 - sw / 2), h / 2 + sh / 2, 0), V3(side, 0, 0), Vector3.yAxis, l, sh, sw, main), "Roof")
		end
		-- flat dorsal tile between the slopes
		c:deco(bone, brick(V3(math.max(0.4 * S, w - sw * 2), sh * 0.55, l), CF(center + V3(0, h / 2 + sh * 0.275, 0)), main), "Ridge")
		-- belly plate underneath (lighter, wraps up the lower flanks)
		c:deco(bone, brick(V3(w * 0.9, h * 0.34, l * 0.96), CF(center + V3(0, -h / 2 + h * 0.08, 0)), belly), "Belly")
	end
	roof("Body", bodyC, bw, bh, bl)
	roof("Chest", chestC, cw, ch, cl)
	roof("Pelvis", pelC, pw, ph, pl)
	-- chest front slope toward the neck, pelvis back slope toward the tail
	c:deco("Chest", slope(chestC + V3(0, ch * 0.18, -cl / 2 - 0.45 * S), V3(0, 0, -1), Vector3.yAxis, cw * 0.84, ch * 0.62, 0.9 * S, main), "ChestSlope")
	c:deco("Chest", brick(V3(cw * 0.7, ch * 0.42, 0.9 * S), CF(chestC + V3(0, -ch * 0.22, -cl / 2 - 0.45 * S)), belly), "ChestPlate")
	c:deco("Pelvis", slope(pelC + V3(0, ph * 0.16, pl / 2 + 0.4 * S), V3(0, 0, 1), Vector3.yAxis, pw * 0.82, ph * 0.56, 0.8 * S, main), "HipSlope")
	c.Boxes = {
		Body = { C = bodyC, Size = V3(bw, bh, bl) },
		Chest = { C = chestC, Size = V3(cw, ch, cl) },
		Pelvis = { C = pelC, Size = V3(pw, ph, pl) },
	}
	-- round shoulder tiles (toy armour discs)
	if c:detail("Medium") then
		for _, side in { -1, 1 } do
			c:deco("Chest", round(chestC + V3(side * (cw / 2 + 0.06 * S), ch * 0.12, 0), V3(1, 0, 0), 0.14 * S, ch * 0.62, accent), "ShoulderDisc")
		end
	end
	-- studs on the shoulders and hips
	local top = CFrame.new(chestC + V3(0, ch / 2 + ch * 0.28 * 0.55 + 0.001, 0))
	local _ = top
	studs(c, "Chest", CF(chestC + V3(0, ch / 2, cl * 0.18)), 2, 1, S, dark)
	studs(c, "Pelvis", CF(pelC + V3(0, ph / 2, 0)), 2, 1, S, dark)
end

-- ============================================================== neck
local function neckPoints(c)
	local d = c.Def.Neck
	local pts = {}
	local L = c.Def.Body.Length
	local p = V3(0, 0.9 + (d.BaseRaise or 0), -L * 0.56)
	pts[1] = p
	local n = d.Segments
	local segLen = d.Length / n
	for i = 1, n do
		local a = rad(d.Rise + (i - 1) * (d.Curve or 8))
		local dir = V3(0, math.sin(a), -math.cos(a))
		p = p + dir * segLen
		pts[i + 1] = p
	end
	return pts
end
BrickBuilder.neckPoints = neckPoints

local function buildNeck(c)
	local d = c.Def.Neck
	local pts = neckPoints(c)
	local parent = "Chest"
	local S = c.S
	local main, belly, dark = c:color("Main"), c:color("Belly"), c:color("Dark")
	for i = 1, d.Segments do
		local t = (i - 1) / math.max(1, d.Segments - 1)
		local th = d.Thickness * (1 - (1 - (d.Taper or 0.75)) * t) * S
		local a, b = c:sc(pts[i]), c:sc(pts[i + 1])
		local len = (b - a).Magnitude
		local f = segFrame(a, b)
		local name = "Neck" .. i
		c:bone(name, brick(V3(th, th * 0.9, len * 1.08), f, main), parent, a)
		-- hinge (round brick across the joint)
		c:deco(name, round(a, f.RightVector, th * 1.02, th * 0.92, dark), "NeckJoint")
		-- throat plate
		c:deco(name, brick(V3(th * 0.8, th * 0.34, len * 1.02), f * CF(0, -th * 0.4, 0), belly), "Throat")
		-- back ridge tile
		if c:detail("Medium") then
			c:deco(name, slope((f * CF(0, th * 0.45 + th * 0.12, 0)).Position, -f.LookVector, f.UpVector, th * 0.36, th * 0.24, len * 0.8, c:color("Accent")), "NeckFin")
		end
		parent = name
	end
	return pts[#pts]
end

-- ============================================================== head
local function buildHead(c, neckEnd: Vector3)
	local d = c.Def.Head
	local hs = (d.Size or 1) * (c.Brick.HeadScale or 1.12)
	local S = c.S
	local main, dark, belly = c:color("Main"), c:color("Dark"), c:color("Belly")
	local base = neckEnd * S
	local tilt = rad(d.Tilt or -8)
	local fwd = V3(0, math.sin(tilt), -math.cos(tilt))
	local up = V3(0, math.cos(tilt), math.sin(tilt))
	local right = fwd:Cross(up).Unit
	local skullC = base + fwd * (0.95 * hs * S) + up * (0.25 * hs * S)
	local frame = CFrame.fromMatrix(skullC, right, up, -fwd)
	local u = hs * S
	local skull = V3(2.6 * u, 2.2 * u, 2.6 * u)
	c:bone("Head", brick(skull, frame, main), "Neck" .. c.Def.Neck.Segments, base)
	-- forehead slope + brow
	c:deco("Head", slope((frame * CF(0, skull.Y / 2 + 0.22 * u, -0.35 * u)).Position, fwd, up, skull.X * 0.92, 0.44 * u, 1.2 * u, main), "Forehead")
	-- snout: box + nose slope on top + cheek plates
	local sn = (d.Snout or 1) * 1.9 * u
	local snoutF = frame * CF(0, -0.3 * u, -skull.Z / 2 - sn / 2 + 0.1 * u)
	local snoutSize = V3(skull.X * 0.74 * (d.SnoutWidth or 1), 1.15 * u, sn)
	c:deco("Head", brick(snoutSize, snoutF, main), "Snout")
	c:deco("Head", slope((snoutF * CF(0, snoutSize.Y / 2 + 0.28 * u, 0.25 * u)).Position, fwd, up, snoutSize.X * 0.8, 0.56 * u, sn * 0.62, main), "NoseSlope")
	-- nostrils (dark round tiles on the nose front)
	if c:detail("Medium") then
		for _, side in { -1, 1 } do
			local np = (snoutF * CF(side * snoutSize.X * 0.24, snoutSize.Y * 0.28, -sn / 2 - 0.02 * u)).Position
			c:deco("Head", round(np, fwd, 0.08 * u, 0.32 * u, Color3.fromRGB(27, 42, 52)), "Nostril")
		end
	end
	-- jaw (bone): lighter lower jaw with fangs
	local hinge = skullC + up * (-0.6 * u) + fwd * (-0.1 * u)
	local jawF = frame * CF(0, -skull.Y / 2 + 0.05 * u, -skull.Z / 2 - sn * 0.42 + 0.35 * u)
	c:bone("Jaw", brick(V3(snoutSize.X * 0.92, 0.6 * u, sn * 0.9 + 0.9 * u), jawF, belly), "Head", hinge)
	if c:detail("Medium") then
		for _, side in { -1, 1 } do
			local tp = (snoutF * CF(side * snoutSize.X * 0.34, -snoutSize.Y / 2 - 0.16 * u, -sn * 0.28)).Position
			c:deco("Head", plastic(Primitives.spike(tp + up * 0.12 * u, tp - up * 0.34 * u, 0.26 * u, 0.2 * u, Color3.fromRGB(250, 250, 246))), "Tooth")
		end
	end
	-- cheek / jaw-hinge round bricks
	for _, side in { -1, 1 } do
		c:deco("Head", round((frame * CF(side * skull.X * 0.5, -0.45 * u, 0.25 * u)).Position, right, 0.3 * u, 1.05 * u, dark), "Cheek")
	end
	-- printed eyes on the skull sides, looking forward-out
	local eyeD = (d.EyeSize or 1) * (c.Brick.EyeScale or 1.2) * u
	for _, side in { -1, 1 } do
		local out = (right * side * 0.7 + fwd * 0.72).Unit
		local ec = (frame * CF(side * skull.X * 0.5, 0.28 * u, -skull.Z * 0.22)).Position + out * 0.04 * u
		printedEye(c, "Head", ec, out, up, eyeD, c:color("Eye"), c:color("Pupil"))
		-- angled brow slope (expression)
		local bc = ec + up * (eyeD * 0.62) - fwd * 0.05 * u
		c:deco("Head", slope(bc, (out + up * 0.2).Unit, up, eyeD * 1.05, 0.3 * u, 0.5 * u, dark), "Brow")
	end
	-- studs on top of the skull
	studs(c, "Head", frame * CF(0, skull.Y / 2, 0.55 * u), 2, 1, math.max(0.9 * u, S * 0.9), dark)
	return { Skull = skullC, Fwd = fwd, Up = up, Right = right, Hs = hs, Frame = frame, SkullSize = skull, U = u, Snout = snoutF, SnoutSize = snoutSize }
end

-- ============================================================== horns / frills
local function buildHorns(c, head)
	local d = c.Def.Head
	local style = c.Features.Antlers and "None" or (d.Horns or "Swept")
	local S, hs, u = c.S, head.Hs, head.U
	local fwd, up = head.Fwd, head.Up
	local frame = head.Frame
	local horn = c:color("Horn")
	local tipCol = c:color(c.Brick.HornTip or "Horn")
	local hornSides = if style == "None" then {} else { -1, 1 }
	for _, side in hornSides do
		local root = (frame * CF(side * head.SkullSize.X * 0.34, head.SkullSize.Y / 2, 0.5 * u)).Position
		local segs
		if style == "Swept" then
			segs = { V3(side * 0.25, 0.55, 1.15), V3(side * 0.12, 0.35, 1.0) }
		elseif style == "Long" then
			segs = { V3(side * 0.2, 0.7, 1.3), V3(side * 0.15, 0.45, 1.4), V3(side * 0.05, 0.2, 1.1) }
		elseif style == "Ram" then
			segs = { V3(side * 0.6, 0.45, 0.6), V3(side * 0.35, -0.6, 0.55), V3(side * -0.1, -0.5, -0.4) }
		elseif style == "Crown" then
			segs = { V3(side * 0.35, 1.0, 0.35), V3(side * 0.25, 0.9, 0.5) }
		else
			segs = { V3(side * 0.25, 0.55, 1.15), V3(side * 0.12, 0.35, 1.0) }
		end
		local p = root
		local thick = (d.HornThickness or 0.55) * hs * S * (c.Brick.HornScale or 1.6)
		for i, seg in segs do
			local dv = (fwd * -seg.Z + up * seg.Y + V3(seg.X, 0, 0)) * hs * S * (d.HornLength or 1)
			local q = p + dv
			local last = i == #segs
			coneStack(c, "Head", p, q, thick, thick * 0.66, last and tipCol or horn, 2, "Horn")
			thick *= 0.62
			p = q
		end
		-- tip
		local dir = (p - root).Unit
		c:deco("Head", plastic(Primitives.spike(p - dir * thick * 0.2, p + dir * thick * 2.2, thick, thick, tipCol)), "HornTip")
	end
	-- ear fins (toy wing plates on the back of the head)
	if c:detail("Medium") and d.Frills ~= false and not c.Features.BigEars then
		for _, side in { -1, 1 } do
			local fc = (frame * CF(side * head.SkullSize.X * 0.52, 0.15 * u, 0.55 * u)).Position
			local tip = fc + V3(side * 0.85 * u, 0.25 * u, 0) - fwd * (0.95 * u)
			c:deco("Head", plastic(Primitives.spike(fc, tip, 0.85 * u, 0.14 * u, c:color("Accent"))), "Frill")
		end
	end
end

-- ============================================================== tail
local function tailPoints(c)
	local d = c.Def.Tail
	local L = c.Def.Body.Length
	local pts = { V3(0, 0.25, L * 0.62) }
	local n = d.Segments
	local segLen = d.Length / n
	local p = pts[1]
	for i = 1, n do
		local t = (i - 1) / math.max(1, n - 1)
		local droop = rad((d.Droop or 8) * (1 - t) + (d.Lift or 0) * t)
		local dir = V3(0, -math.sin(droop), math.cos(droop))
		p = p + dir * segLen
		pts[i + 1] = p
	end
	return pts
end
BrickBuilder.tailPoints = tailPoints

local function buildTail(c)
	local d = c.Def.Tail
	local pts = tailPoints(c)
	local parent = "Pelvis"
	local n = d.Segments
	local S = c.S
	local main, dark, belly, accent = c:color("Main"), c:color("Dark"), c:color("Belly"), c:color("Accent")
	for i = 1, n do
		local t = (i - 1) / math.max(1, n - 1)
		local th = d.Thickness * (1 - (1 - (d.Taper or 0.3)) * t) * S
		local a, b = c:sc(pts[i]), c:sc(pts[i + 1])
		local len = (b - a).Magnitude
		local f = segFrame(a, b)
		local name = "Tail" .. i
		c:bone(name, brick(V3(th, th * 0.86, len * 1.06), f, main), parent, a)
		if i > 1 then
			c:deco(name, round(a, f.RightVector, th * 1.02, th * 0.88, dark), "TailJoint")
		end
		if c:detail("Medium") then
			c:deco(name, brick(V3(th * 0.7, th * 0.2, len * 0.98), f * CF(0, -th * 0.48, 0), belly), "TailBelly")
			-- dorsal tooth plates
			c:deco(name, plastic(Primitives.spike((f * CF(0, th * 0.43, len * 0.1)).Position, (f * CF(0, th * 0.43 + th * 0.55, len * 0.32)).Position, len * 0.45, th * 0.18, accent)), "TailSpike")
		end
		parent = name
	end
	-- tip
	local last = "Tail" .. n
	local e = c:sc(pts[n + 1])
	local tip = d.Tip or "Spade"
	local tipCol = c:color(c.Brick.TailTip or "Accent")
	if tip == "Spade" or tip == "Leaf" then
		local back = e + V3(0, 0, 2.1 * S)
		local l = e + V3(-1.0 * S, 0, 0.45 * S)
		local r = e + V3(1.0 * S, 0, 0.45 * S)
		local f = e + V3(0, 0, -0.55 * S)
		for _, p in Primitives.triangle(f, l, back, 0.28 * S, tipCol, PLASTIC) do
			c:deco(last, plastic(p), "TailTip")
		end
		for _, p in Primitives.triangle(f, r, back, 0.28 * S, tipCol, PLASTIC) do
			c:deco(last, plastic(p), "TailTip")
		end
	elseif tip == "Club" then
		c:deco(last, brick(V3(1.6, 1.4, 2.0) * S, CF(e + V3(0, 0, 0.6 * S)), c:color("Horn")), "TailClub")
		for _, ang in { 0, 120, 240 } do
			local o = V3(math.cos(rad(ang)) * 0.6, math.sin(rad(ang)) * 0.6 + 0.2, 0.5) * S
			c:deco(last, plastic(Primitives.spike(e + o, e + o * 2.1 + V3(0, 0, 0.4 * S), 0.45 * S, 0.35 * S, c:color("Horn"))), "TailSpike")
		end
	elseif tip == "Fin" or tip == "Plume" then
		for _, sgn in { 1, -1 } do
			for _, p in Primitives.triangle(e + V3(0, 0, -0.6 * S), e + V3(0, sgn * 1.5 * S, 0.6 * S), e + V3(0, 0, 2.2 * S), 0.22 * S, tipCol, PLASTIC) do
				c:deco(last, plastic(p), "TailFin")
			end
		end
	elseif tip == "Crystal" then
		for i, o in { V3(0, 0.3, 0.8), V3(-0.5, 0.1, 0.5), V3(0.5, 0.1, 0.5) } do
			local bp = e + o * S
			local spike = Primitives.spike(bp, bp + V3(o.X * 1.2, 1.2 + (i == 1 and 0.6 or 0), 0.9) * S, 0.55 * S, 0.5 * S, c:color("Crystal"), Enum.Material.Glass)
			spike.Transparency = 0.25
			c:deco(last, spike, "Crystal")
		end
	elseif tip == "Flame" then
		local fl = brick(V3(1.0, 1.0, 1.6) * S, CF(e + V3(0, 0, 0.5 * S)), c:color("Glow"))
		fl.Material = Enum.Material.Neon
		c:deco(last, fl, "TailFlame")
	end
	return pts
end

-- ============================================================== legs
local function buildLegs(c)
	local d = c.Def.Legs
	local L = c.Def.Body.Length
	local hip = c.Def.HipHeight
	local thick = d.Thickness or 1
	local groundY = -hip
	local S = c.S
	local main, dark = c:color("Main"), c:color("Dark")
	local function foot(boneName, parentName, pivot: Vector3, center: Vector3, size: Vector3, sideName: string)
		c:bone(boneName, brick(c:sc(size), CF(c:sc(center)), dark), parentName, c:sc(pivot))
		if c:detail("Medium") then
			for i = -1, 1 do
				local cp = c:sc(center + V3(i * size.X * 0.32, -size.Y * 0.22, -size.Z * 0.5))
				c:deco(boneName, plastic(Primitives.spike(cp, cp + c:sc(V3(i * 0.05, -0.12, -0.5)), 0.26 * S, 0.24 * S, c:color("Claw"))), "Claw")
			end
		end
		studs(c, boneName, CF(c:sc(center + V3(0, size.Y / 2, 0.15))), 2, 1, 0.75 * S, dark)
		c:attach(boneName, "Foot" .. sideName, c:sc(center + V3(0, -size.Y * 0.5, 0)))
	end
	for _, side in { -1, 1 } do
		local sn = side < 0 and "L" or "R"
		if d.Front then
			local sh = V3(side * c.Def.Body.Width * 0.4, -0.2, -L * 0.36)
			local el = sh + V3(side * 0.15, -(hip * 0.45), 0.25)
			local wr = el + V3(0, -(hip * 0.4), -0.15)
			local fc = V3(wr.X, groundY + 0.35, wr.Z - 0.35)
			local a1, b1 = c:sc(sh), c:sc(el)
			c:bone("Arm" .. sn .. "1", brick(V3(1.35 * thick * S, 1.35 * thick * S, (b1 - a1).Magnitude * 1.12), segFrame(a1, b1, Vector3.zAxis), main), "Chest", c:sc(sh))
			local a2, b2 = c:sc(el), c:sc(wr)
			c:bone("Arm" .. sn .. "2", brick(V3(1.05 * thick * S, 1.05 * thick * S, (b2 - a2).Magnitude * 1.1), segFrame(a2, b2, Vector3.zAxis), main), "Arm" .. sn .. "1", c:sc(el))
			c:deco("Arm" .. sn .. "2", round(c:sc(el), Vector3.xAxis, 1.2 * thick * S, 1.15 * thick * S, dark), "Elbow")
			c:deco("Arm" .. sn .. "1", round(c:sc(sh + V3(side * 0.1, -0.25, 0)), Vector3.xAxis, 1.7 * thick * S, 1.9 * thick * S, main), "Shoulder")
			foot("Hand" .. sn, "Arm" .. sn .. "2", wr, fc, V3(1.4 * thick, 0.7, 1.9 * thick), "F" .. sn)
		end
		if d.Back then
			local hp = V3(side * c.Def.Body.Width * 0.38, 0.1, L * 0.4)
			local kn = hp + V3(side * 0.25, -(hip * 0.4), -0.65)
			local an = kn + V3(0, -(hip * 0.45), 1.0)
			local fc = V3(an.X, groundY + 0.35, an.Z - 0.45)
			local thighC = (hp + kn) / 2 + V3(0, 0.2, 0.25)
			c:bone("Leg" .. sn .. "1", brick(c:sc(V3(2.0 * thick, hip * 0.62, 2.4 * thick)), CF(c:sc(thighC)) * CFrame.Angles(rad(-14), 0, 0), main), "Pelvis", c:sc(hp))
			c:deco("Leg" .. sn .. "1", slope(c:sc(thighC + V3(0, hip * 0.31 + 0.25, 0)), V3(side, 0, 0), Vector3.yAxis, 2.2 * thick * S, 0.5 * S, 1.0 * thick * S, main), "Haunch")
			local a2, b2 = c:sc(kn), c:sc(an)
			c:bone("Leg" .. sn .. "2", brick(V3(1.08 * thick * S, 1.08 * thick * S, (b2 - a2).Magnitude * 1.1), segFrame(a2, b2, Vector3.zAxis), main), "Leg" .. sn .. "1", c:sc(kn))
			c:deco("Leg" .. sn .. "2", round(c:sc(kn), Vector3.xAxis, 1.25 * thick * S, 1.2 * thick * S, dark), "Knee")
			foot("Foot" .. sn, "Leg" .. sn .. "2", an, fc, V3(1.5 * thick, 0.72, 2.1 * thick), "B" .. sn)
		end
	end
end

-- ============================================================== wings
local function buildWings(c)
	local d = c.Def.Wings
	if not d or d.Type == "None" then
		return
	end
	local span = d.Span or 13
	local chord = d.Chord or 5.5
	local L = c.Def.Body.Length
	local W = c.Def.Body.Width
	local S = c.S
	local k = span / 13
	local kc = chord / 5.5
	local boneCol = c:color(d.BoneColor or "Dark")
	local memColor = c:color("Membrane")
	local depth = d.Type == "Tattered" and 0.42 or (d.Scallop or 0.2)
	local thickness = 0.22 * S
	c.Model:SetAttribute("WingType", d.Type or "Bat")
	c.Model:SetAttribute("MembraneScallop", depth)
	c.Model:SetAttribute("MembraneThickness", thickness)
	for _, side in { -1, 1 } do
		local sn = side < 0 and "L" or "R"
		local function m(x, y, z)
			return V3(side * x, y, z)
		end
		local sh = m(W * 0.36, 1.6, -L * 0.27)
		local el = sh + m(4.0 * k, 0.8 * k, 0.5 * k)
		local wr = el + m(4.2 * k, 0.5 * k, 1.2 * k)
		local f1 = wr + m(3.6 * k, -0.2 * k, 1.3 * kc)
		local f2 = wr + m(1.8 * k, -0.6 * k, 4.0 * kc)
		local f3 = wr + m(-1.6 * k, -0.9 * k, 5.3 * kc)
		local bodyAttach = m(W * 0.36, 1.0, L * 0.36)
		local n = "Wing" .. sn
		local function rod(a: Vector3, b: Vector3, w: number)
			local A, B = c:sc(a), c:sc(b)
			return brick(V3(w, w, (B - A).Magnitude * 1.06), segFrame(A, B), boneCol)
		end
		c:bone(n .. "1", rod(sh, el, 0.75 * S), "Chest", c:sc(sh))
		c:bone(n .. "2", rod(el, wr, 0.6 * S), n .. "1", c:sc(el))
		c:bone(n .. "3", rod(wr, f1, 0.4 * S), n .. "2", c:sc(wr))
		c:bone(n .. "4", rod(wr, f2, 0.36 * S), n .. "3", c:sc(wr))
		c:bone(n .. "5", rod(wr, f3, 0.34 * S), n .. "3", c:sc(wr))
		c:deco(n .. "2", round(c:sc(el), V3(0, 1, 0), 0.8 * S, 0.9 * S, c:color("Accent")), "Knuckle")
		c:deco(n .. "3", round(c:sc(wr), V3(0, 1, 0), 0.7 * S, 0.8 * S, c:color("Accent")), "Knuckle")
		if c:detail("Medium") then
			c:deco(n .. "2", plastic(Primitives.spike(c:sc(wr), c:sc(wr + m(0.25, 0.35, -0.85)), 0.3 * S, 0.24 * S, c:color("Claw"))), "WingClaw")
			-- finger tip caps
			for i, f in { f1, f2, f3 } do
				c:deco(n .. tostring(2 + i), round(c:sc(f), V3(0, 1, 0), 0.4 * S, 0.5 * S, c:color("Accent")), "FingerTip")
			end
		end
		if d.Glow then
			local function glow(bone: string, a: Vector3, b: Vector3)
				local p = brick(V3(0.16 * S, 0.16 * S, (c:sc(b) - c:sc(a)).Magnitude), segFrame(c:sc(a), c:sc(b)), c:color("Glow"))
				p.Material = Enum.Material.Neon
				c:deco(bone, p, "Glow")
			end
			glow(n .. "3", wr, f1)
			glow(n .. "4", wr, f2)
			glow(n .. "5", wr, f3)
		end
		c:attach(n .. "1", "MemS" .. sn, c:sc(sh + m(-0.1, -0.15, 0.25)))
		c:attach(n .. "2", "MemE" .. sn, c:sc(el))
		c:attach(n .. "3", "MemW" .. sn, c:sc(wr))
		c:attach(n .. "3", "MemF1" .. sn, c:sc(f1))
		c:attach(n .. "4", "MemF2" .. sn, c:sc(f2))
		c:attach(n .. "5", "MemF3" .. sn, c:sc(f3))
		c:attach("Body", "MemB" .. sn, c:sc(bodyAttach))
		c:attach(n .. "3", "WingTip" .. sn, c:sc(f1))
		c:attach(n .. "3", "WingTipInner" .. sn, c:sc(f1 + (wr - f1) * 0.18))
		local P = {
			S = c:sc(sh + m(-0.1, -0.15, 0.25)),
			E = c:sc(el),
			W = c:sc(wr),
			F1 = c:sc(f1),
			F2 = c:sc(f2),
			F3 = c:sc(f3),
			B = c:sc(bodyAttach),
		}
		Membranes.buildPieces(c.Bones.Root, sn, P, thickness, depth, memColor, PLASTIC, function(part)
			part.Reflectance = 0.02
			c:add(part, "Membrane")
		end)
	end
end

-- ============================================================== back spikes
local function buildSpines(c)
	local d = c.Def.Spines
	if not d or d.Style == "None" or not c:detail("Medium") then
		return
	end
	local S = c.S
	local L = c.Def.Body.Length
	local H = c.Def.Body.Height
	local col = c:color(c.Brick.SpineColor or "Accent")
	for _, z in { -L * 0.32, L * 0.12, L * 0.38 } do
		if not (c.Def.Saddle ~= false and z > -L * 0.3 and z < L * 0.05) then
			local bone = z < -L * 0.2 and "Chest" or (z > L * 0.3 and "Pelvis" or "Body")
			local base = c:sc(V3(0, H * 0.43 + 0.55, z))
			c:deco(bone, plastic(Primitives.spike(base, base + V3(0, (d.Height or 0.9) * 1.1 * S, 0.55 * S), 1.1 * S, 0.3 * S, col)), "Spine")
		end
	end
end

-- ============================================================== saddle
local function buildSaddle(c)
	if c.Def.Saddle == false then
		return
	end
	local H = c.Def.Body.Height
	local L = c.Def.Body.Length
	local S = c.S
	local y = H * 0.5 + 0.05
	local z = -L * 0.16
	local leather = Color3.fromRGB(124, 80, 46)
	local cloth = c.Palette.Saddle or Color3.fromRGB(196, 40, 27)
	local gold = Color3.fromRGB(245, 205, 47)
	local W = math.floor(c.Def.Body.Width * S + 0.5)
	c:deco("Body", brick(V3(W + 0.2 * S, 0.24 * S, 3.0 * S), CF(c:sc(V3(0, y - 0.12, z))), cloth), "SaddleCloth")
	for _, dz in { -1.45, 1.45 } do
		c:deco("Body", brick(V3(W + 0.3 * S, 0.3 * S, 0.24 * S), CF(c:sc(V3(0, y - 0.1, z + dz))), gold), "SaddleTrim")
	end
	c:deco("Body", brick(c:sc(V3(2.2, 0.5, 2.6)), CF(c:sc(V3(0, y + 0.22, z))), leather), "Saddle")
	c:deco("Body", brick(c:sc(V3(1.0, 0.8, 0.5)), CF(c:sc(V3(0, y + 0.55, z - 1.15))), leather), "Pommel")
	c:deco("Body", brick(c:sc(V3(1.9, 0.7, 0.45)), CF(c:sc(V3(0, y + 0.5, z + 1.2))), leather), "Cantle")
	c:attach("Body", "SaddlePoint", c:sc(V3(0, y + 0.2, z)))
end

-- ============================================================== features
-- Unique per-species pieces (Species def.Features), all toy bricks.
local GOLD = Color3.fromRGB(245, 205, 47)
local GEM = Color3.fromRGB(196, 40, 27)
local FLOWER_MID = Color3.fromRGB(245, 205, 47)

local function rod(a: Vector3, b: Vector3, w: number, color: Color3): BasePart
	return brick(V3(w, w, (b - a).Magnitude * 1.04), segFrame(a, b), color)
end

local function neon(p: BasePart): BasePart
	p.Material = Enum.Material.Neon
	p.Reflectance = 0
	return p
end

local function glassy(p: BasePart, transparency: number?): BasePart
	p.Material = Enum.Material.Glass
	p.Transparency = transparency or 0.2
	p.Reflectance = 0.1
	return p
end

-- frame of one neck segment (same maths as buildNeck)
local function neckSegments(c)
	local d = c.Def.Neck
	local pts = neckPoints(c)
	local out = {}
	for i = 1, d.Segments do
		local t = (i - 1) / math.max(1, d.Segments - 1)
		local th = d.Thickness * (1 - (1 - (d.Taper or 0.75)) * t) * c.S
		local a, b = c:sc(pts[i]), c:sc(pts[i + 1])
		out[i] = { Bone = "Neck" .. i, F = segFrame(a, b), Th = th, Len = (b - a).Magnitude }
	end
	return out
end

local function tailSegments(c)
	local d = c.Def.Tail
	local pts = tailPoints(c)
	local out = {}
	for i = 1, d.Segments do
		local t = (i - 1) / math.max(1, d.Segments - 1)
		local th = d.Thickness * (1 - (1 - (d.Taper or 0.3)) * t) * c.S
		local a, b = c:sc(pts[i]), c:sc(pts[i + 1])
		out[i] = { Bone = "Tail" .. i, F = segFrame(a, b), Th = th, Len = (b - a).Magnitude }
	end
	return out
end

-- back positions that stay clear of the saddle
local function backSpots(c, list: { number })
	local L = c.Def.Body.Length
	local out = {}
	for _, fz in list do
		local z = L * fz
		if not (c.Def.Saddle ~= false and z > -L * 0.3 and z < L * 0.05) then
			local bone = z < -L * 0.2 and "Chest" or (z > L * 0.3 and "Pelvis" or "Body")
			local box = c.Boxes[bone]
			table.insert(out, { Bone = bone, Pos = V3(0, box.C.Y + box.Size.Y / 2 + box.Size.Y * 0.2, z * c.S) })
		end
	end
	return out
end

local function flower(c, bone: string, center: Vector3, normal: Vector3, size: number, petal: Color3)
	local n = normal.Unit
	local helper = math.abs(n:Dot(Vector3.xAxis)) > 0.9 and Vector3.zAxis or Vector3.xAxis
	local e1 = n:Cross(helper).Unit
	local e2 = n:Cross(e1).Unit
	local count = c:detail("High") and 5 or 4
	for i = 0, count - 1 do
		local a = i / count * math.pi * 2
		local pp = center + (e1 * math.cos(a) + e2 * math.sin(a)) * size * 0.4
		c:deco(bone, round(pp, n, size * 0.16, size * 0.52, petal), "Petal")
	end
	c:deco(bone, round(center + n * size * 0.07, n, size * 0.22, size * 0.36, FLOWER_MID), "FlowerMid")
end

local FEATURES = {}

-- long drooping whiskers from the snout (serpent dragons)
function FEATURES.Whiskers(c, head)
	local u = head.U
	local col = c:color("Mane")
	local sn = head.SnoutSize
	for _, side in { -1, 1 } do
		local r = head.Right * side
		local base = (head.Snout * CF(side * sn.X * 0.5, sn.Y * 0.1, -sn.Z * 0.25)).Position
		local p1 = base + r * 0.9 * u - head.Up * 0.3 * u + head.Fwd * 0.2 * u
		local p2 = p1 + r * 0.6 * u - head.Up * 0.9 * u - head.Fwd * 0.5 * u
		local p3 = p2 + r * 0.2 * u - head.Up * 0.8 * u - head.Fwd * 0.8 * u
		c:deco("Head", rod(base, p1, 0.26 * u, col), "Whisker")
		c:deco("Head", rod(p1, p2, 0.22 * u, col), "Whisker")
		c:deco("Head", rod(p2, p3, 0.18 * u, col), "Whisker")
		c:deco("Head", round(p3, (p3 - p2).Unit, 0.3 * u, 0.34 * u, c:color("Accent")), "WhiskerTip")
	end
end

-- fluffy crest along the neck and behind the head
function FEATURES.Mane(c, head)
	local col = c:color("Mane")
	for _, seg in neckSegments(c) do
		local f, th = seg.F, seg.Th
		local base = (f * CF(0, th * 0.42, 0)).Position
		local tip = base - f.LookVector * th * 0.95 + f.UpVector * th * 0.8
		c:deco(seg.Bone, plastic(Primitives.spike(base, tip, th * 0.95, th * 0.36, col)), "Mane")
		if c:detail("Medium") then
			for _, side in { -1, 1 } do
				local sb = (f * CF(side * th * 0.4, th * 0.2, 0)).Position
				local st = sb + f.RightVector * side * th * 0.55 - f.LookVector * th * 0.6 + f.UpVector * th * 0.3
				c:deco(seg.Bone, plastic(Primitives.spike(sb, st, th * 0.7, th * 0.24, col)), "Mane")
			end
		end
	end
	local u = head.U
	for _, side in { -1, 0, 1 } do
		local hb = (head.Frame * CF(side * head.SkullSize.X * 0.32, head.SkullSize.Y * 0.15, head.SkullSize.Z * 0.42)).Position
		local ht = hb - head.Fwd * 1.6 * u + head.Up * 0.8 * u + head.Right * side * 0.7 * u
		c:deco("Head", plastic(Primitives.spike(hb, ht, 1.1 * u, 0.32 * u, col)), "Mane")
	end
end

-- glowing ring above the head
function FEATURES.Halo(c, head)
	local u = head.U
	local n = c:detail("High") and 16 or (c:detail("Medium") and 12 or 8)
	local center = head.Skull + head.Up * (head.SkullSize.Y * 0.5 + 2.4 * u) - head.Fwd * 0.6 * u
	local normal = (head.Up - head.Fwd * 0.3).Unit
	local e1 = head.Right
	local e2 = normal:Cross(e1).Unit
	local R = 1.9 * u
	local col = c:color("Glow")
	for i = 0, n - 1 do
		local a0, a1 = (i / n) * math.pi * 2, ((i + 1) / n) * math.pi * 2
		local p0 = center + (e1 * math.cos(a0) + e2 * math.sin(a0)) * R
		local p1 = center + (e1 * math.cos(a1) + e2 * math.sin(a1)) * R
		c:deco("Head", neon(brick(V3(0.34 * u, 0.34 * u, (p1 - p0).Magnitude * 1.1), CFrame.lookAt((p0 + p1) / 2, p1, normal), col)), "Halo")
	end
end

-- golden crown with red gems
function FEATURES.Crown(c, head)
	local u = head.U
	local fr = head.Frame * CF(0, head.SkullSize.Y / 2 + 0.3 * u, 0.2 * u)
	local w = head.SkullSize.X * 0.5
	local h = 0.6 * u
	local t = 0.28 * u
	c:deco("Head", brick(V3(w, h, t), fr * CF(0, 0, -w / 2 + t / 2), GOLD), "Crown")
	c:deco("Head", brick(V3(w, h, t), fr * CF(0, 0, w / 2 - t / 2), GOLD), "Crown")
	c:deco("Head", brick(V3(t, h, w - 2 * t), fr * CF(-w / 2 + t / 2, 0, 0), GOLD), "Crown")
	c:deco("Head", brick(V3(t, h, w - 2 * t), fr * CF(w / 2 - t / 2, 0, 0), GOLD), "Crown")
	for _, o in { { -1, -1, 0.8 }, { 1, -1, 0.8 }, { -1, 1, 0.7 }, { 1, 1, 0.7 }, { 0, -1, 1.15 } } do
		local bp = (fr * CF(o[1] * (w / 2 - t / 2), h / 2, o[2] * (w / 2 - t / 2))).Position
		c:deco("Head", plastic(Primitives.spike(bp, bp + head.Up * o[3] * u, 0.42 * u, 0.26 * u, GOLD)), "CrownPoint")
	end
	if c:detail("Medium") then
		c:deco("Head", round((fr * CF(0, 0, -w / 2 - 0.03 * u)).Position, head.Fwd, 0.12 * u, 0.4 * u, GEM), "Gem")
		for _, side in { -1, 1 } do
			c:deco("Head", round((fr * CF(side * (w / 2 + 0.03 * u), 0, 0)).Position, head.Right, 0.12 * u, 0.34 * u, GEM), "Gem")
		end
	end
end

-- neon flames along the back (replace the spines)
function FEATURES.BackFlames(c)
	local S = c.S
	local outer, inner = c:color("Glow"), Color3.fromRGB(255, 226, 90)
	for i, spot in backSpots(c, { -0.4, -0.32, 0.12, 0.28, 0.44 }) do
		local k = (i % 2 == 0) and 0.8 or 1
		local base = spot.Pos
		c:deco(spot.Bone, neon(Primitives.spike(base, base + V3(0, 1.7 * k * S, 0.8 * S), 1.4 * k * S, 0.36 * S, outer)), "Flame")
		c:deco(spot.Bone, neon(Primitives.spike(base + V3(0, 0, 0.12 * S), base + V3(0, 1.05 * k * S, 0.55 * S), 0.85 * k * S, 0.42 * S, inner)), "Flame")
	end
	if c:detail("Medium") then
		for _, seg in tailSegments(c) do
			local i = tonumber(seg.Bone:sub(5))
			if i and i <= 3 then
				local base = (seg.F * CF(0, seg.Th * 0.45, 0)).Position
				c:deco(seg.Bone, neon(Primitives.spike(base, base + seg.F.UpVector * seg.Th * 0.9 + seg.F.LookVector * seg.Th * 0.5, seg.Len * 0.5, seg.Th * 0.22, outer)), "Flame")
			end
		end
	end
end

-- small glowing star tiles over the body, neck and tail
function FEATURES.Stars(c, _head, color: Color3?)
	local col = color or c:color("Glow")
	local S = c.S
	local spots = {
		{ "Chest", 1, 0.15, -0.3, 0.42 }, { "Chest", -1, -0.1, 0.2, 0.32 }, { "Body", 1, 0.1, 0.25, 0.3 },
		{ "Body", -1, 0.2, -0.2, 0.44 }, { "Pelvis", 1, -0.05, 0.1, 0.34 }, { "Pelvis", -1, 0.12, -0.25, 0.28 },
	}
	for _, sp in spots do
		local box = c.Boxes[sp[1]]
		local p = box.C + V3(sp[2] * (box.Size.X / 2 + 0.04 * S), sp[3] * box.Size.Y, sp[4] * box.Size.Z)
		c:deco(sp[1], neon(round(p, Vector3.xAxis, 0.1 * S, sp[5] * 1.6 * S, col)), "Star")
	end
	if c:detail("Medium") then
		for _, seg in tailSegments(c) do
			local i = tonumber(seg.Bone:sub(5)) or 0
			if i % 2 == 0 then
				local side = (i % 4 == 0) and 1 or -1
				c:deco(seg.Bone, neon(round((seg.F * CF(side * seg.Th * 0.47, 0, 0)).Position, seg.F.RightVector, 0.08 * S, seg.Th * 0.32, col)), "Star")
			end
		end
		for i, seg in neckSegments(c) do
			if i % 2 == 1 then
				c:deco(seg.Bone, neon(round((seg.F * CF(-seg.Th * 0.47, 0.1 * seg.Th, 0)).Position, seg.F.RightVector, 0.08 * S, seg.Th * 0.3, col)), "Star")
			end
		end
	end
end

-- glass crystal clusters on the back (replace the spines) and head
function FEATURES.Crystals(c, head)
	local col = c:color("Crystal")
	local S = c.S
	local function cluster(bone: string, base: Vector3, size: number)
		local dirs = { V3(0, 1, 0.2), V3(-0.55, 0.8, 0.3), V3(0.55, 0.8, 0.3) }
		for i, dv in dirs do
			if i == 1 or c:detail("Medium") then
				local d = dv.Unit
				local h = size * (i == 1 and 1.7 or 1.15)
				local b = base + V3(dv.X * size * 0.32, 0, 0)
				c:deco(bone, glassy(Primitives.spike(b, b + d * h, size * 0.62, size * 0.55, col)), "Crystal")
			end
		end
	end
	for i, spot in backSpots(c, { -0.36, 0.14, 0.4 }) do
		cluster(spot.Bone, spot.Pos - V3(0, 0.2 * S, 0), (i == 2 and 1.0 or 1.25) * S)
	end
	local u = head.U
	cluster("Head", (head.Frame * CF(0, head.SkullSize.Y / 2, 0.6 * u)).Position, 0.75 * u)
end

-- flowers on the head, back and tail
function FEATURES.Flowers(c, head)
	local u = head.U
	local S = c.S
	local petal = c:color("Accent")
	flower(c, "Head", (head.Frame * CF(head.SkullSize.X * 0.22, head.SkullSize.Y / 2 + 0.05 * u, -0.25 * u)).Position, head.Up, 1.0 * u, petal)
	for i, spot in backSpots(c, { -0.38, 0.16, 0.42 }) do
		local side = (i % 2 == 0) and -1 or 1
		local box = c.Boxes[spot.Bone]
		local p = V3(side * box.Size.X * 0.28, box.C.Y + box.Size.Y / 2 + box.Size.Y * 0.16, spot.Pos.Z)
		flower(c, spot.Bone, p, Vector3.yAxis, 1.15 * S, petal)
	end
	if c:detail("Medium") then
		local segs = tailSegments(c)
		local seg = segs[math.max(1, math.floor(#segs * 0.5))]
		flower(c, seg.Bone, (seg.F * CF(seg.Th * 0.3, seg.Th * 0.46, 0)).Position, seg.F.UpVector, seg.Th * 0.75, petal)
	end
end

-- branching antlers (replace the horns)
function FEATURES.Antlers(c, head)
	local u = head.U
	local col = c:color("Horn")
	local fwd, up = head.Fwd, head.Up
	for _, side in { -1, 1 } do
		local r = head.Right * side
		local root = (head.Frame * CF(side * head.SkullSize.X * 0.3, head.SkullSize.Y / 2 - 0.1 * u, 0.4 * u)).Position
		local p1 = root + up * 1.3 * u + r * 0.5 * u - fwd * 0.4 * u
		local p2 = p1 + up * 1.2 * u + r * 0.8 * u - fwd * 0.6 * u
		local p3 = p2 + up * 1.0 * u + r * 0.5 * u - fwd * 0.8 * u
		c:deco("Head", rod(root, p1, 0.55 * u, col), "Antler")
		c:deco("Head", rod(p1, p2, 0.46 * u, col), "Antler")
		c:deco("Head", rod(p2, p3, 0.4 * u, col), "Antler")
		c:deco("Head", rod(p1, p1 + up * 1.0 * u + fwd * 0.7 * u, 0.34 * u, col), "Antler")
		c:deco("Head", rod(p2, p2 + up * 0.9 * u + fwd * 0.6 * u + r * 0.2 * u, 0.32 * u, col), "Antler")
		c:deco("Head", rod(p3, p3 + up * 0.7 * u + r * 0.6 * u - fwd * 0.2 * u, 0.28 * u, col), "Antler")
		if c:detail("Medium") then
			c:deco("Head", round(p1, r, 0.6 * u, 0.62 * u, col), "AntlerKnob")
			c:deco("Head", round(p2, r, 0.5 * u, 0.52 * u, col), "AntlerKnob")
			-- little leaves (it's a forest dragon)
			c:deco("Head", plastic(Primitives.spike(p2, p2 + r * 0.9 * u + up * 0.3 * u, 0.6 * u, 0.12 * u, c:color("Membrane"))), "Leaf")
		end
	end
end

-- rows of sharp thorns on the flanks and tail
function FEATURES.Thorns(c)
	local S = c.S
	local col = c:color("Horn")
	for _, name in { "Chest", "Body", "Pelvis" } do
		local box = c.Boxes[name]
		for _, side in { -1, 1 } do
			for _, fz in (name == "Body" and { 0 } or { -0.25, 0.25 }) do
				local base = box.C + V3(side * box.Size.X / 2, box.Size.Y * 0.18, fz * box.Size.Z)
				local tip = base + V3(side * 1.0 * S, 0.45 * S, 0.35 * S)
				c:deco(name, plastic(Primitives.spike(base, tip, 0.7 * S, 0.5 * S, col)), "Thorn")
			end
		end
	end
	if c:detail("Medium") then
		for _, seg in tailSegments(c) do
			local i = tonumber(seg.Bone:sub(5)) or 0
			if i % 2 == 1 and i < c.Def.Tail.Segments then
				for _, side in { -1, 1 } do
					local base = (seg.F * CF(side * seg.Th * 0.48, 0, 0)).Position
					local tip = base + seg.F.RightVector * side * seg.Th * 0.7 + seg.F.LookVector * seg.Th * 0.3
					c:deco(seg.Bone, plastic(Primitives.spike(base, tip, seg.Th * 0.5, seg.Th * 0.35, col)), "Thorn")
				end
			end
		end
	end
end

-- big bat ears (replace the frills)
function FEATURES.BigEars(c, head)
	local u = head.U
	local k = c.Brick.EarScale or 1.5
	local outer, inner = c:color("Main"), c:color("Accent")
	for _, side in { -1, 1 } do
		local r = head.Right * side
		local a = (head.Frame * CF(side * head.SkullSize.X * 0.4, head.SkullSize.Y * 0.42, -0.1 * u)).Position
		local b = (head.Frame * CF(side * head.SkullSize.X * 0.42, head.SkullSize.Y * 0.2, 1.0 * u)).Position
		local tip = a + r * 1.0 * k * u + head.Up * 1.9 * k * u - head.Fwd * 0.9 * k * u
		for _, p in Primitives.triangle(a, b, tip, 0.24 * u, outer, PLASTIC) do
			c:deco("Head", plastic(p), "Ear")
		end
		if c:detail("Medium") then
			local n = (b - a):Cross(tip - a).Unit
			if n:Dot(head.Fwd + r * 0.5) < 0 then
				n = -n
			end
			local mid = (a + b + tip) / 3
			local function shrink(p: Vector3)
				return mid + (p - mid) * 0.62 + n * 0.16 * u
			end
			for _, p in Primitives.triangle(shrink(a), shrink(b), shrink(tip), 0.12 * u, inner, PLASTIC) do
				c:deco("Head", plastic(p), "EarInner")
			end
		end
	end
end

-- ============================================================== aura (exclusive dragons)
local AURA_SPECS = {
	{ Kind = "Sparkle", Color = Color3.fromRGB(255, 205, 60) },
	{ Kind = "Sparkle", Color = Color3.fromRGB(255, 70, 50) },
}

-- Dragon Bond level 50: golden-white sparkles and a warm glow around the dragon
local BOND_AURA_SPECS = {
	{ Kind = "Sparkle", Color = Color3.fromRGB(255, 226, 120) },
	{ Kind = "Sparkle", Color = Color3.fromRGB(255, 255, 255) },
	{ Kind = "Sparkle", Color = Color3.fromRGB(255, 160, 210) },
}

-- ============================================================== mutation fx
-- Part roles from names (palette slot each piece was built from).
local NAME_ROLE = {
	Body = "Main", Chest = "Main", Pelvis = "Main", Head = "Main", Roof = "Main", Ridge = "Main", ChestSlope = "Main",
	HipSlope = "Main", Forehead = "Main", Snout = "Main", NoseSlope = "Main", Shoulder = "Main", Haunch = "Main", Ear = "Main",
	NeckJoint = "Dark", TailJoint = "Dark", Cheek = "Dark", Brow = "Dark", Stud = "Dark", Elbow = "Dark", Knee = "Dark",
	Belly = "Belly", ChestPlate = "Belly", Throat = "Belly", Jaw = "Belly", TailBelly = "Belly",
	ShoulderDisc = "Accent", NeckFin = "Accent", TailSpike = "Accent", Spine = "Accent", Frill = "Accent", Knuckle = "Accent",
	FingerTip = "Accent", TailTip = "Accent", TailFin = "Accent", EarInner = "Accent", WhiskerTip = "Accent", Petal = "Accent",
	Horn = "Horn", HornTip = "Horn", TailClub = "Horn", Thorn = "Horn", Antler = "Horn", AntlerKnob = "Horn",
	Membrane = "Membrane", Claw = "Claw", WingClaw = "Claw", Tooth = "Claw",
	Glow = "Glow", TailFlame = "Glow", Flame = "Glow", Halo = "Glow", Star = "Glow",
	Crystal = "Crystal", Mane = "Mane", Whisker = "Mane",
}

local function roleOf(name: string): string?
	local r = NAME_ROLE[name]
	if r then
		return r
	end
	if name:match("^Neck%d") or name:match("^Tail%d") or name:match("^Arm") or name:match("^Leg") then
		return "Main"
	end
	if name:match("^Hand") or name:match("^Foot") or name:match("^Wing") then
		return "Dark"
	end
	return nil
end
BrickBuilder.roleOf = roleOf

