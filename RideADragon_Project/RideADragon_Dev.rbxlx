-- Incubator (sanctuary nest) slots: index -> unlock price.
EggConfig.IncubatorPrices = { 0, 0, 1500, 20000, 250000, 3000000 }
EggConfig.IncubatorStart = 2

-- Spawn areas that roll their luck twice (keep the best).
EggConfig.RareAreas = { Ruins = true, Cave = true, Pillar = true, Island = true, Falls = true, Plateau = true, Pass = true, CrystalIsle = true, BloomIsle = true, EmberIsle = true, FrostIsle = true }

-- Which egg types spawn in each region (weights).
EggConfig.Regions = {
	Haven = { { Id = "HavenEgg", Weight = 62 }, { Id = "GroveEgg", Weight = 24 }, { Id = "BloomEgg", Weight = 14 } },
	Frostpeak = { { Id = "FrostEgg", Weight = 58 }, { Id = "GlacierEgg", Weight = 28 }, { Id = "AuroraEgg", Weight = 14 } },
	EmberCaldera = { { Id = "EmberEgg", Weight = 58 }, { Id = "MagmaEgg", Weight = 28 }, { Id = "InfernoEgg", Weight = 14 } },
	Skyreach = { { Id = "SkyEgg", Weight = 58 }, { Id = "StormEgg", Weight = 28 }, { Id = "CelestialEgg", Weight = 14 } },
}
EggConfig.RegionNames = { Haven = "Dragon Haven", Frostpeak = "Frostpeak", EmberCaldera = "Ember Caldera", Skyreach = "Skyreach" }

-- Region of an egg spot without a "Region" attribute (landmarks of the valley).
EggConfig.AreaRegion = { Plateau = "Frostpeak", Pass = "Frostpeak", Falls = "Frostpeak", Cave = "EmberCaldera", Ruins = "EmberCaldera", Pillar = "Skyreach", Island = "Skyreach" }

-- Special eggs that can replace any spawn.
EggConfig.Specials = { { Id = "RainbowEgg", Chance = 0.003 }, { Id = "GoldenEgg", Chance = 0.015 } }

-- Every world egg rolls its own luck (shown above it, applied when it hatches).
EggConfig.LuckRolls = {
	{ Luck = 1, Weight = 50 },
	{ Luck = 2, Weight = 22 },
	{ Luck = 3, Weight = 11 },
	{ Luck = 5, Weight = 7.5 },
	{ Luck = 10, Weight = 4.8 },
	{ Luck = 25, Weight = 2.5 },
	{ Luck = 50, Weight = 1.3 },
	{ Luck = 100, Weight = 0.6 },
	{ Luck = 250, Weight = 0.22 },
	{ Luck = 1000, Weight = 0.08 },
}

-- Personal egg spawning (each player has their own eggs in the world).
EggConfig.Spawning = {
	MaxActive = 24,
	MaxActivePerRegion = 18, -- (legacy name)
	ScatterRadius = 70, -- eggs appear around a spawn area, not on one exact spot
	-- Roaming eggs: this share of every egg appears at a completely random place of the land (the
	-- rest scatter around the named areas, where the rare finds are). Wild eggs always roam.
	RoamingShare = 0.5,
	IslandShare = 0.3, -- of the roaming eggs: this share appears on a sky island (WorldConfig.SkyIslands)
	IslandInset = 0.8, -- eggs stay this far inside the island's plate (share of its radius)
	WorldBox = { MinX = -980, MaxX = 860, MinZ = -960, MaxZ = 900 },
	RoamAvoid = { "Pillar", "Island" }, -- areas that never name a roaming egg (sky / island spots)
	RoamMinSeparation = 260, -- a roaming wild egg appears at least this far from the previous one
	RespawnMin = 12,
	RespawnMax = 30,
}

local function weighted(list, rng: Random)
	local total = 0
	for _, e in list do
		total += e.Weight
	end
	local r = rng:NextNumber() * total
	for _, e in list do
		r -= e.Weight
		if r <= 0 then
			return e
		end
	end
	return list[#list]
end

-- Egg type for a spawn in a region (specials can appear anywhere).
function EggConfig.rollEgg(region: string, rng: Random): string
	for _, sp in EggConfig.Specials do
		if rng:NextNumber() < sp.Chance then
			return sp.Id
		end
	end
	local list = EggConfig.Regions[region] or EggConfig.Regions.Haven
	return weighted(list, rng).Id
end

-- Luck multiplier of a freshly spawned egg.
function EggConfig.rollLuck(eggType: string, rng: Random, rareSpot: boolean?): number
	local luck = weighted(EggConfig.LuckRolls, rng).Luck
	if rareSpot then
		luck = math.max(luck, weighted(EggConfig.LuckRolls, rng).Luck)
	end
	local def = EggConfig.Eggs[eggType]
	return math.max(luck, def and def.MinLuck or 1)
end

-- Display colour for a luck multiplier.
function EggConfig.luckColor(luck: number): Color3
	if luck >= 1000 then
		return Color3.fromRGB(80, 255, 230)
	elseif luck >= 250 then
		return Color3.fromRGB(255, 70, 70)
	elseif luck >= 100 then
		return Color3.fromRGB(255, 100, 190)
	elseif luck >= 50 then
		return Color3.fromRGB(255, 170, 50)
	elseif luck >= 25 then
		return Color3.fromRGB(190, 120, 255)
	elseif luck >= 10 then
		return Color3.fromRGB(90, 180, 255)
	elseif luck >= 3 then
		return Color3.fromRGB(110, 220, 100)
	end
	return Color3.fromRGB(235, 235, 235)
end

-- Luck applies to results whose rarity rank is >= this.
EggConfig.LuckMinRank = 3

-- Returns a list of { Id, Weight, P } with luck applied and probabilities.
function EggConfig.oddsFor(eggId: string, luck: number, rarityRankOf: (string) -> number)
	local egg = EggConfig.Eggs[eggId]
	local out = {}
	local total = 0
	for _, entry in egg.Hatch do
		local w = entry.Weight
		local rank = rarityRankOf(entry.Id)
		if rank >= EggConfig.LuckMinRank then
			w *= (1 + math.max(0, luck))
		elseif rank == EggConfig.LuckMinRank - 1 then
			w *= math.sqrt(1 + math.max(0, luck))
		end
		total += w
		table.insert(out, { Id = entry.Id, Weight = w, P = 0 })
	end
	for _, e in out do
		e.P = e.Weight / total
	end
	return out
end

return table.freeze(EggConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000042">
				<Properties>
					<string name="Name">GameConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	GameConfig
	Global tuning: movement curves, riding physics, camera, ranges, saving.
	All riding/camera numbers live here so feel can be tuned in one place.
]]

local GameConfig = {}

GameConfig.Version = "1.0.0"
GameConfig.DataStoreName = "RideADragon_PlayerData_v1"
GameConfig.AutosaveInterval = 90
GameConfig.SessionLockTimeout = 30 * 60

-- Movement speed curves (studs/second) from the UI power stats.
GameConfig.Movement = {
	WalkSpeed = 17,
	RunBase = 34,
	RunPerLog = 10,
	RunCap = 110,
	FlightBase = 60,
	FlightPerLog = 32,
	FlightCap = 300,
	BoostMultiplier = 1.6,
}

function GameConfig.groundRunSpeed(speedStat: number): number
	local m = GameConfig.Movement
	return math.min(m.RunCap, m.RunBase + m.RunPerLog * math.log10(1 + math.max(0, speedStat) / 40))
end

function GameConfig.flightCruiseSpeed(flightStat: number): number
	local m = GameConfig.Movement
	return math.min(m.FlightCap, m.FlightBase + m.FlightPerLog * math.log10(1 + math.max(0, flightStat) / 60))
end

-- Riding physics. Distances are for scale 1 (Green Drake) and are multiplied
-- by the species Scale where it makes sense (hip height, clearances).
GameConfig.Riding = {
	Gravity = 115,
	JumpVelocity = 44,
	CrouchTime = 0.16,
	TakeoffHoldTime = 0.2,
	TakeoffLiftVelocity = 58,
	TakeoffDuration = 0.65,

	GroundAccel = 55,
	GroundDecel = 70,
	GroundTurnRate = 3.4, -- rad/s at low speed
	GroundTurnRateFast = 2.1, -- rad/s at full run
	GroundTurnResponse = 9, -- how quickly turn rate itself ramps (damping)
	SlopeAlignRate = 7,
	HoverHeightOverWater = 0.5,

	AirAccel = 42,
	AirBrake = 70,
	AirTurnResponse = 3.2, -- heading follows desired heading (exp rate)
	AirMaxYawRate = 1.9, -- rad/s
	VerticalSpeed = 38, -- ascend/descend studs/s
	VerticalAccel = 6, -- response rate
	HoverDrag = 2.2,
	DiveAccel = 60,
	ClimbPenalty = 0.35,
	MaxPitch = math.rad(55),
	MaxBank = math.rad(48),
	BankResponse = 5.5,
	PitchResponse = 5,
	Ceiling = 1500,
	SoftCeilingBand = 120,

	BoostDuration = 5,
	BoostRegenPerSecond = 0.22, -- fraction of full meter per second when not boosting
	BoostMinToStart = 0.15,

	LandingStartHeight = 16,
	TouchdownHeight = 1.2,
	LandingDuration = 0.42,
	AutoLandMaxSpeed = 70,
}

GameConfig.Camera = {
	BaseFOV = 70,
	BoostFOV = 82,
	SpeedFOVBonus = 4, -- extra FOV at max cruise (without boost)
	FOVRate = 4,
	DistanceGround = 24, -- at scale 1
	DistanceAir = 28,
	DistanceSpeedBonus = 5,
	MinZoom = 0.55,
	MaxZoom = 1.9,
	HeightOffset = 7.5,
	LookAheadAir = 3.5,
	LagCompensation = 0.85, -- fraction of the focus spring's steady-state lag removed
	PositionFrequency = 5.2, -- spring Hz for the focus point
	ZoomFrequency = 2.6,
	CollisionPullIn = 22, -- fast when pulling in (avoid clipping)
	CollisionPushOut = 3.5, -- slow when easing back out
	CollisionRadius = 1.4,
	MouseSensitivity = 0.0042,
	GamepadSensitivity = 3.2,
	TouchSensitivity = 0.0065,
	PitchMin = math.rad(-70),
	PitchMax = math.rad(60),
	AutoAlignDelay = 1.4,
	AutoAlignRate = 1.6,
	BankRoll = 0.14, -- fraction of dragon bank applied to the camera
}

GameConfig.Interaction = {
	EggPickupRange = 18, -- client prompt range (studs)
	EggPickupServerRange = 34, -- server validation range (includes dragon size slack)
	NestRange = 22,
	NestServerRange = 40,
	CollectorRange = 16,
}

-- Sanctuary display dragons (resting on perches)
GameConfig.Sanctuary = {
	PerchScale = 0.62, -- display size relative to the riding size
	ViewDistance = 620, -- perch dragons are built within this camera distance
	ViewDistanceLow = 260, -- on the Low graphics preset
	NameplateDistance = 110,
	PromptRange = 16,
}

GameConfig.StarterCash = 250

return table.freeze(GameConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000043">
				<Properties>
					<string name="Name">HatchConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	HatchConfig
	Timing of the hatching cinematic and the server-wide announcements for
	ultra-rare hatches. The result itself is always decided by the server
	(EggService); the cinematic only plays it.
]]

local HatchConfig = {}

-- A hatch whose "1 in N" odds reach MinOdds is announced to every player on the
-- server; from Mega on the banner is bigger and louder.
HatchConfig.Announce = {
	MinOdds = 25000,
	Mega = 1000000,
	BannerSeconds = 7,
	MegaBannerSeconds = 10,
	-- the banner waits for the hatcher's reveal (the cinematic runs ~9 s) so nobody is spoiled
	Delay = 8.5,
}

-- Cinematic beats in seconds. Rare results (high rarity or rare "1 in N") get a
-- longer charge and extra cracks - the same egg always feels the same, the reveal
-- grows with what is inside.
HatchConfig.Cinematic = {
	Approach = 0.8, -- camera glides to the egg
	Charge = 2.3, -- cracks appear, the roll strip spins
	ChargeRare = 3.4,
	Cracks = 4,
	CracksRare = 6,
	Walk = 2.6, -- the dragon walks towards the camera
	Roar = 1.7,
	SkipAfter = 0.5, -- the SKIP button appears after this long
}

-- A result is "rare" for the cinematic when the dragon's rarity rank is at least
-- RareRank (Epic) or its odds reach RareOdds.
HatchConfig.RareRank = 4
HatchConfig.RareOdds = 2500

return table.freeze(HatchConfig)
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000044">
				<Properties>
					<string name="Name">IndexConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	IndexConfig
	The Dragon Index (collection book): which species a player has found (data.Index, filled by
	DragonService when a dragon is added) and the rewards for collecting them (IndexService).

	data.Index = { [speciesId] = { First, Count }, ["speciesId:Mutation"] = { First, Count } }
	data.IndexClaims = { [tostring(count)] = true }   milestones already paid

	Robux exclusives (DragonConfig Exclusive = true) are shown in the book but not counted: the
	book can be completed by hatching alone.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Configs = ReplicatedStorage:WaitForChild("Configs")
local DragonConfig = require(Configs:WaitForChild("DragonConfig"))
local MutationConfig = require(Configs:WaitForChild("MutationConfig"))

local IndexConfig = {}

-- Count = species found; a reward is any of Cash { Seconds, Min }, Spins, Boost { Id, Seconds }, Egg { Type, Luck }.
IndexConfig.Milestones = {
	{ Count = 5, Cash = { Seconds = 300, Min = 5000 } },
	{ Count = 10, Spins = 5 },
	{ Count = 15, Cash = { Seconds = 900, Min = 25000 }, Boost = { Id = "Luck", Seconds = 900 } },
	{ Count = 20, Egg = { Type = "GoldenEgg", Luck = 10 } },
	{ Count = 25, Cash = { Seconds = 3600, Min = 100000 }, Spins = 10 },
	{ Count = 30, Cash = { Seconds = 14400, Min = 500000 }, Egg = { Type = "RainbowEgg", Luck = 50 } },
}

-- Species that count for the collection, in book order.
function IndexConfig.collectable(): { string }
	local list = {}
	for _, id in DragonConfig.speciesList() do
		if not DragonConfig.Species[id].Exclusive then
			table.insert(list, id)
		end
	end
	return list
end

-- Exclusives, shown after the collection.
function IndexConfig.exclusives(): { string }
	local list = {}
	for _, id in DragonConfig.speciesList() do
		if DragonConfig.Species[id].Exclusive then
			table.insert(list, id)
		end
	end
	return list
end

-- Mutations that can be collected per species (everything except "None"; Omni is Robux-only).
function IndexConfig.mutations(): { string }
	local list = {}
	for _, id in MutationConfig.Order do
		if id ~= "None" and id ~= "Omni" then
			table.insert(list, id)
		end
	end
	return list
end

-- How many collectable species the index holds.
function IndexConfig.found(index): number
	local n = 0
	for _, id in IndexConfig.collectable() do
		if index and index[id] then
			n += 1
		end
	end
	return n
end

-- Mutations found for one species.
function IndexConfig.mutationsFound(index, speciesId: string): number
	local n = 0
	for _, m in IndexConfig.mutations() do
		if index and index[speciesId .. ":" .. m] then
			n += 1
		end
	end
	return n
end

-- All different mutated dragons found.
function IndexConfig.totalMutations(index): number
	local n = 0
	for _, id in IndexConfig.collectable() do
		n += IndexConfig.mutationsFound(index, id)
	end
	return n
end

-- The milestone table with the last one tied to the real size of the collection.
function IndexConfig.milestones()
	local total = #IndexConfig.collectable()
	local list = {}
	for _, m in IndexConfig.Milestones do
		if m.Count <= total then
			table.insert(list, m)
		end
	end
	return list
end

return IndexConfig
]]></ProtectedString>
				</Properties>
			</Item>
			<Item class="ModuleScript" referent="RBX000045">
				<Properties>
					<string name="Name">LeaderboardConfig</string>
					<ProtectedString name="Source"><![CDATA[--[[
	LeaderboardConfig
	Global top-10 boards shown in the hub plaza (and the Teleport menu's
	"Spawn" destination looks straight at them).

	Board.Stat: which player value is ranked
	  Earned   - lifetime cash earned (data.TotalEarned)
	  Hatched  - eggs hatched (data.Stats.Hatched)
	  Income   - current sanctuary income per second (live)
	  PlayTime - seconds played (data.Stats.PlayTime)
	  DragonPower - the best income per second of any dragon the player owns
	  DragonLevel - the highest dragon level
	  RaceBest / RaceMonthly - best race time ever / this month (score = RaceConfig.timeScore)
	  ArenaKills  - duel knockouts in the arena
	Board.Format: how values are printed (Cash, Count, PerSecond, Time, Level, RaceTime)
	Board.Where:  "Hub" (plaza ring) or "Race" (the Race Island plaza, RaceConfig.Boards)
	Board.Store:  OrderedDataStore name (a function for names that change, like the month)
	Board.SkipZero: players without a value are not listed (no race time yet...)
]]

local RaceConfig = require(script.Parent:WaitForChild("RaceConfig"))

local LeaderboardConfig = {}

LeaderboardConfig.Boards = {
	{
		Id = "Earned",
		Title = "TOP EARNERS",
		Subtitle = "Total cash earned",
		Stat = "Earned",
		Format = "Cash",
		Color = Color3.fromRGB(255, 196, 48),
		Dark = Color3.fromRGB(150, 96, 10),
		Store = "LB_Earned_v1",
		Where = "Hub",
	},
	{
		Id = "Hatched",
		Title = "TOP HATCHERS",
		Subtitle = "Eggs hatched",
		Stat = "Hatched",
		Format = "Count",
		Color = Color3.fromRGB(110, 208, 104),
		Dark = Color3.fromRGB(32, 110, 46),
		Store = "LB_Hatched_v1",
		Where = "Hub",
	},
	{
		Id = "Income",
		Title = "RICHEST SANCTUARIES",
		Subtitle = "Income per second",
		Stat = "Income",
		Format = "PerSecond",
		Color = Color3.fromRGB(77, 163, 255),
		Dark = Color3.fromRGB(20, 70, 150),
		Store = "LB_Income_v1",
		Where = "Hub",
	},
	{
		Id = "PlayTime",
		Title = "MOST DEDICATED",
		Subtitle = "Time played",
		Stat = "PlayTime",
		Format = "Time",
		Color = Color3.fromRGB(190, 120, 255),
		Dark = Color3.fromRGB(86, 40, 150),
		Store = "LB_PlayTime_v1",
		Where = "Hub",
	},
	{
		Id = "StrongDragon",
		Title = "STRONGEST DRAGON",
		Subtitle = "Dragon income per second",
		Stat = "DragonPower",
		Format = "PerSecond",
		Color = Color3.fromRGB(255, 130, 80),
		Dark = Color3.fromRGB(150, 54, 20),
		Store = "LB_DragonPower_v1",
		Where = "Hub",
		SkipZero = true,
	},
	{
		Id = "HighLevel",
		Title = "HIGHEST LEVEL DRAGON",
		Subtitle = "Dragon level",
		Stat = "DragonLevel",
		Format = "Level",
		Color = Color3.fromRGB(64, 236, 214),
		Dark = Color3.fromRGB(20, 110, 100),
		Store = "LB_DragonLevel_v1",
		Where = "Hub",
		SkipZero = true,
	},
	{
		Id = "RaceMonthly",
		Title = "MONTHLY RACE",
		Subtitle = "Fastest race this month",
		Stat = "RaceMonthly",
		Format = "RaceTime",
		Color = Color3.fromRGB(255, 215, 70),
		Dark = Color3.fromRGB(150, 100, 10),
		Store = function()
			return "LB_RaceMonthly_" .. RaceConfig.monthKey() .. "_v1"
		end,
		Where = "Race",
		SkipZero = true,
		Monthly = true,
	},
	{
		Id = "RaceBest",
		Title = "FASTEST RACERS",
		Subtitle = "Best race time ever",
		Stat = "RaceBest",
		Format = "RaceTime",
		Color = Color3.fromRGB(255, 96, 84),
		Dark = Color3.fromRGB(140, 30, 30),
		Store = "LB_RaceBest_v1",
		Where = "Race",
		SkipZero = true,
	},
	{
		Id = "ArenaKills",
		Title = "ARENA WARRIORS",
		Subtitle = "Duel knockouts",
		Stat = "ArenaKills",
		Format = "Count",
		Color = Color3.fromRGB(255, 72, 150),
		Dark = Color3.fromRGB(130, 20, 80),
		Store = "LB_ArenaKills_v1",
		Where = "Race",
		SkipZero = true,
	},
}

LeaderboardConfig.TopCount = 10
LeaderboardConfig.RefreshSeconds = 60 -- read the global tops
LeaderboardConfig.WriteSeconds = 120 -- write each player's values
LeaderboardConfig.PlayTimeTick = 30 -- seconds added to PlayTime per tick

-- Plaza placement: angles (degrees, 0 = north/-Z, 90 = east) on a ring
-- around the hub centre; each board faces the centre. The south road
-- (between 160 and 200 degrees) stays open.
LeaderboardConfig.Ring = 54
LeaderboardConfig.Angles = { 222, 196, 164, 138, 112, 248 }
-- Teleport "Spawn" arrival: south of the statue, looking at the boards.
LeaderboardConfig.Arrival = Vector3.new(0, 0, 28)

return table.freeze(LeaderboardConfig)
]]></ProtectedString>
