		{ Kind = "cottage", X = -131.03, Y = 30.45, Z = 91.09, Yaw = -0.8905, Seed = 135, w = 16, d = 14, stories = 2 },
		{ Kind = "cottage", X = -153.94, Y = 30.29, Z = -14, Yaw = -1.5547, Seed = 136, w = 12, d = 13, stories = 2 },
		{ Kind = "cottage", X = -149.61, Y = 30.1, Z = -40.64, Yaw = -1.7983, Seed = 137, w = 16, d = 12, stories = 2 },
		{ Kind = "cottage", X = -90.45, Y = 30.74, Z = -130.12, Yaw = -2.5948, Seed = 138, w = 13, d = 11, stories = 2 },
