	rect(root, 0.5, 0.5, 0.92, 0.16, col, 0.5)
	rect(root, 0.5, 0.5, 0.12, 0.5, acc, 0.5, 45)
	rect(root, 0.5, 0.5, 0.12, 0.5, acc, 0.5, -45)
