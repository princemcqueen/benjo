	},
	SpinPackBig = {
		Id = 3716498584,
		Price = 199,
		Name = "25 Spins",
		Description = "+25 spins for the wheel on Spin Island.",
		Icon = "Gift",
		Kind = "Spins",
		Count = 25,
		Color = Color3.fromRGB(255, 70, 150),
	},
	CashPackSmall = {
		Id = 3716498676,
		Price = 25,
		Name = "Pouch of Cash",
		Description = "30 minutes of your income (at least $5K).",
		Icon = "Coin",
		Kind = "Cash",
		IncomeSeconds = 30 * 60,
		Minimum = 5000,
		Color = Color3.fromRGB(255, 196, 48),
	},
	CashPackMedium = {
		Id = 3716498963,
		Price = 299,
		Name = "Chest of Cash",
		Description = "3 hours of your income (at least $50K).",
		Icon = "Chest",
		Kind = "Cash",
		IncomeSeconds = 3 * 3600,
		Minimum = 50000,
		Color = Color3.fromRGB(255, 160, 40),
